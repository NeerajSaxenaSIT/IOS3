        <binding name="XmlProvisionServiceSoap" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://10.244.98.161:81/xmlprovisionservice.asmx" binding="basicHttpBinding" bindingConfiguration="XmlProvisionServiceSoap" contract="XmlServRef.XmlProvisionServiceSoap" name="XmlProvisionServiceSoap" />
