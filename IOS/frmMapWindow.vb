                        '' End If
                    ElseIf cmbNBFilter.Text.Contains("NB_") And Me.btnNBArrows.Text <> "Arrows" Then
                        Dim enumerator3 As IEnumerator = Nothing

                        Dim th As New MapInfo.Mapping.Thematics.RangedTheme(layer4, Me.cmbNBFilter.Text, Me.cmbNBFilter.Text, 6, 0)

                        th.ApplyStylePart = 15
                        th.SpreadBy = 0
                        Dim num12 As Integer = -1000
                        Dim num13 As Integer = &H3E8
                        Try
                            enumerator3 = dt.Rows.GetEnumerator
                            Do While enumerator3.MoveNext
                                Dim row2 As DataRow = DirectCast(enumerator3.Current, DataRow)
                                If (row2.Item(Me.cmbNBFilter.Text).ToString <> "") Then
                                    num12 = Math.Max(Convert.ToInt32(row2.Item(Me.cmbNBFilter.Text)), num12)
                                    num13 = Math.Min(Convert.ToInt32(row2.Item(Me.cmbNBFilter.Text)), num13)
                                End If
                            Loop
                        Finally
                            If TypeOf enumerator3 Is IDisposable Then
                                TryCast(enumerator3, IDisposable).Dispose()
                            End If
                        End Try
                        Dim num11 As Double = (CDbl((num12 - num13)) / 6)
                        Dim num14 As Integer = (th.Bins.Count - 1)
                        index = 0
                        Try
                            Do While (index <= num14)
                                th.Bins.Item(index).Min = Math.Round(CDbl((num13 + (num11 * index))), 1)
                                th.Bins.Item(index).Max = Math.Round(CDbl((num13 + (num11 * (index + 1)))), 1)
                                Dim style10 As SimpleLineStyle = th.Bins.Item(index).Style.LineStyle
                                Dim color2 As Color = Color.FromArgb(&HAF, CInt(Math.Round(CDbl((255 * (CDbl(index) / 5))))), 0, 0)
                                th.Bins(index).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(5, MapInfo.Styles.LineWidthUnit.Pixel), 2, color2), New MapInfo.Styles.SimpleInterior(2, color2, color2, True)))

                                index += 1
                            Loop

                            th.Recompute()
                            layer4.Modifiers.Clear()
                            layer4.Modifiers.Append(th)
                            Me.Legend_CreateThematic(th, "Neighbors", " ", layer4)
                            Me.legend_ac.Refresh()
                            Me.legend_ac.Visible = tlb_Legend.Checked
                        Catch ex As Exception
                            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                        End Try
                        '' End If
                    Else
                        Dim thm As Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, Me.cmbNBFilter.Text, Me.cmbNBFilter.Text)
                        thm.ApplyStylePart = Thematics.StylePart.All

                        'This line changes the style of the first bin for region layer
                        Dim i As Integer = 0
                        For i = 0 To thm.Bins.Count - 1
                            'Console.WriteLine(thm.Bins(i).Value)
                            'Dim dr As DataRow() = distinctDT.Select(param & "=" & Chr(39) & thm.Bins(i).Value & Chr(39))
                            Dim j As Integer = dt.Rows.IndexOf(dt.Select(Me.cmbNBFilter.Text & "=" & Chr(39) & thm.Bins(i).Value & Chr(39))(0))

                            Dim rnd As Random = New Random(j + 1)
                            Dim cl As Color = Color.FromArgb(rnd.Next(255), rnd.Next(255), rnd.Next(255))
                            thm.Bins(i).Style = New MapInfo.Styles.CompositeStyle(New SimpleLineStyle(New LineWidth(5, 0), num3, cl, False))

                        Next
                        lyr.Modifiers.Append(thm)
                        Me.Legend_CreateThematic(thm, "Neighbors", Me.cmbNBFilter.Text, lyr)
                        Me.legend_ac.Refresh()
                        Me.legend_ac.Visible = tlb_Legend.Checked
                    End If
                End If

                If Me.CheckLabelLayer("Labels_NB_Lines") Then
                    Me.MapControl1.Map.Layers.Remove("Labels_NB_Lines")
                End If
                Dim layer As New MapInfo.Mapping.LabelLayer
                layer.Alias = "Labels_NB_Lines"
