    Public Sub AddTempTabletoMap(ByVal mapTableName As String, ByVal feature As Feature)
        Dim tblTemp As MapInfo.Data.Table = Session.Current.Catalog.GetTable(mapTableName)
        If Not (tblTemp Is Nothing) Then
            tblTemp.Close()
        End If
        Dim layerTemp As FeatureLayer = New FeatureLayer(Session.Current.Catalog.CreateTable(TableInfoFactory.CreateTemp(mapTableName), New TableSessionInfo()))
