    Public Sub MapGridTable_DoubleClick(ByVal sender As Object, ByVal e As EventArgs)
        Dim tempGrid As GridView = TryCast(sender, GridView)
        Dim tempGridCtrl As GridControl = tempGrid.GridControl
        Dim dt As DataTable = CType(tempGridCtrl.DataSource, DataTable)
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Dim iRowSelected As Integer = tempGrid.GetSelectedRows()(0)
        Dim cellid As String = Nothing
        Dim lac As String = Nothing
        Dim tech As String = Nothing
        Dim ticket As String = Nothing
        Dim maptag(1) As String
        maptag(0) = ""
        If Not tempGrid Is Nothing Then
            Try
                maptag = tempGrid.Tag
            Catch ex As Exception

            End Try
        End If
        Try
            If maptag(0) <> "" Then
                Cells_SearchAndDisplay(maptag(1), tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns(maptag(0))))
            ElseIf GridView_Map_Col2Index(tempGrid, "IOS_CELL_GID") <> -1 Then
                Cells_SearchAndDisplay("IOS_CELL_GID", tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("IOS_CELL_GID")))
            ElseIf GridView_Map_Col2Index(tempGrid, "CELLNAME") <> -1 Then
                Cells_SearchAndDisplay("CELLNAME", tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("CELLNAME")))
            Else
                If GridView_Map_Col2Index(tempGrid, "TCELLID") <> -1 And GridView_Map_Col2Index(tempGrid, "TLAC") <> -1 Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("TCELLID"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("TLAC"))
                ElseIf GridView_Map_Col2Index(tempGrid, "CELLID") <> -1 And GridView_Map_Col2Index(tempGrid, "LAC") <> -1 Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("CELLID"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("LAC"))
                ElseIf Not dt.Columns("CELL_ID") Is Nothing And Not dt.Columns("LAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("CELL_ID"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("LAC"))
                ElseIf Not dt.Columns("CELL_ID") Is Nothing And Not dt.Columns("TAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("CELL_ID"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("TAC"))
                ElseIf Not dt.Columns("eCELLID") Is Nothing And Not dt.Columns("TAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("eCELLID"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("TAC"))
                ElseIf Not dt.Columns("SCELL") Is Nothing And Not dt.Columns("SLAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("SCELL"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("SLAC"))
                ElseIf Not dt.Columns("WCEL_ID") Is Nothing And Not dt.Columns("LAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("WCEL_ID"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("LAC"))
                ElseIf Not dt.Columns("WCEL_ID") Is Nothing And Not dt.Columns("WCEL_LAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("WCEL_ID"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("WCEL_LAC"))
                ElseIf Not dt.Columns("CELL") Is Nothing And Not dt.Columns("TECH") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("CELL"))
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("TECH"))
                ElseIf Not dt.Columns("TICKET") Is Nothing Then
                    ticket = dt(iRowSelected)("TICKET").ToString
                ElseIf Not dt.Columns("SITECODE") Is Nothing Then
                    Cell_SearchAndDisplay(tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns("SITECODE")), "", "SITECODE")
                End If

                If Not cellid Is Nothing And Not lac Is Nothing And cellid <> "" And lac <> "" Then
                    Cell_LAC_SearchAndDisplay(cellid, lac)
                ElseIf Not cellid Is Nothing And Not tech Is Nothing And cellid <> "" And tech <> "" Then
                ElseIf Not ticket Is Nothing Then
                    frmTicketDetail.Show()
                    frmTicketDetail.FetchTicket(ticket.Substring(3))
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Public Sub InfoTool_ReturnInfo(ByVal e As MapInfo.Tools.ToolUsedEventArgs)
        'clear the items in the listBox
        Try
            dlgMappingSelection.tlvSelection.Nodes.Clear()
            dlgMappingSelection.tlvSelection.Columns.Clear()
            dlgMappingSelection.tlvDetail.ContextMenuStrip = dlgMappingSelection.cm_TLV

            Dim tlvc1 As TreeListViewColumn = New TreeListViewColumn("Key", "")
            tlvc1.Width = 0
            tlvc1.Visible = False
            Dim tlvc2 As TreeListViewColumn = New TreeListViewColumn("First Column", "")
            tlvc1.Width = 0
            Dim tlvc3 As TreeListViewColumn = New TreeListViewColumn("SourceTable", "")
            tlvc1.Width = 0

            dlgMappingSelection.tlvSelection.Columns.Add(tlvc1)
            dlgMappingSelection.tlvSelection.Columns.Add(tlvc2)
            'frm_IOS_Mapping_Selection.lvSelection.Columns.Add("Column 2", 60, HorizontalAlignment.Left)
            dlgMappingSelection.tlvSelection.Columns.Add(tlvc3)
            dlgMappingSelection.tlvDetail.Nodes.Clear()
            dlgMappingSelection.tlvDetail.Columns.Clear()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            Exit Sub
        End Try

        Dim connection As New MapInfo.Data.MIConnection
        connection.Open()

        'this is the point at which the user clicked on the map
        Dim pt As New MapInfo.Geometry.Point(MapControl1.Map.GetDisplayCoordSys, e.MapCoordinate.x, e.MapCoordinate.y)

        Dim i As Int16 = 0
        'Dim mfc As MultiResultSetFeatureCollection = New MultiResultSetFeatureCollection()
        'If MapToolBar1.Buttons("tlb_SelInfo").Pushed = False Then
        '    frm_IOS_Mapping_Selection.Show()
        'End If
        If Not tlb_SelInfo.Checked Then
            frmMDI.OpenFormAsDockPanel("Selection Info")
        End If
        While i < Me.MapControl1.Map.Layers.Count
            Try
                If Me.MapControl1.Map.Layers(i).Type = LayerType.Normal Then
                    Dim fl As FeatureLayer = Me.MapControl1.Map.Layers(i)
                    If fl.Enabled = True Then
                        If fl.VisibleRangeEnabled = True And fl.VisibleRange.Within(Me.MapControl1.Map.Zoom) Or fl.VisibleRangeEnabled = False Then
                            'if the layer is visible within the current map

                            Dim command As MapInfo.Data.MICommand = connection.CreateCommand()
                            command.CommandText = "Select * from " & fl.Table.Alias & " where @pt intersects Obj"

                            Dim geoCol As MapInfo.Data.GeometryColumn = fl.Table.TableInfo.Columns(GetGeoColIndexOfFeatureLayer(fl))

                            If geoCol.PredominantGeometryType.ToString() = "MultiCurve" Or geoCol.PredominantGeometryType.ToString() = "Curve" Then
                                'Checks to see if the table is a table of MultiCurves or Curves. We will use a buffer to search for these features
                                command.Parameters.Add("@pt", pt.Buffer(Me.MapControl1.Map.Zoom.Value / 500, MapInfo.Geometry.DistanceUnit.Mile, 99))
                            ElseIf geoCol.PredominantGeometryType.ToString() = "Point" Or geoCol.PredominantGeometryType.ToString() = "MultiPoint" Then
                                'Checks to see if the table is a table of Points or MultiPoints. This buffer will be used for these features as 'well.
                                command.Parameters.Add("@pt", pt.Buffer(Me.MapControl1.Map.Zoom.Value / 200, MapInfo.Geometry.DistanceUnit.Mile, 99))
                            Else
                                command.Parameters.Add("@pt", pt)
                            End If

                            Dim irfc As MapInfo.Data.IResultSetFeatureCollection = command.ExecuteFeatureCollection()

                            For Each f As MapInfo.Data.Feature In irfc
                                Dim lvitem As TreeListViewNode = New TreeListViewNode(f.Key.ToString)
                                lvitem.SubItems.Add(New TreeListViewSubItem(f.Key.ToString))
                                lvitem.SubItems.Add(New TreeListViewSubItem(f.Columns(1).Alias & ": " & f(1).ToString.Trim))
                                lvitem.SubItems.Add(New TreeListViewSubItem(irfc.BaseTable.Alias.Trim))

                                dlgMappingSelection.tlvSelection.Nodes.Add(lvitem)
                            Next

                            'mfc.Add(irfc)
                            command.Dispose()
                            irfc.Close()
                            'Console.WriteLine(mfc.Item(0).Alias)
                        End If
                    End If
                End If
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try
            i = i + 1
        End While
        connection.Close()
        If dlgMappingSelection.tlvSelection.Nodes.Count > 0 Then
            dlgMappingSelection.tlvSelection.Nodes(0).Selected = True
            dlgMappingSelection.lvSelection_SubItemSelectionChanged(Nothing, Nothing)
        End If
        dlgMappingSelection.ListView_ColumnResize()
    End Sub

    Public Sub ToolUsed(ByVal sender As Object, ByVal e As MapInfo.Tools.ToolUsedEventArgs)
        'Dim dateMenuItem As ToolStripMenuItem = TryCast(, ToolStripMenuItem)
        'If e.ToolName = "InfoTool" And e.ToolStatus = ToolStatus.Start Then
        '    InfoTool_ReturnInfo(e)
        '    Map_StatusStrip.Visible = False
