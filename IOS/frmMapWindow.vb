    Public Sub Polygon_TopX_Map(ByVal kpi As String, ByVal dt As DataTable, ByVal targettable As String, ByVal targetcolumn As String)
        Dim connection As New MIConnection
        Try
            connection.Open()
            Dim topxtbl As String = targettable & "_" & kpi
            If Not String.IsNullOrEmpty(PrevKpiTable) Then
                connection.Catalog.CloseTable(PrevKpiTable)
            End If
            If Not String.IsNullOrEmpty(PrevLayerName) Then
                connection.Catalog.CloseTable(PrevLayerName)
            End If
            connection.Catalog.CloseTable(kpi)
            PrevKpiTable = kpi
            connection.Catalog.CloseTable(topxtbl & "_Map")
            PrevLayerName = topxtbl & "_Map"

            'constructing select string
            Dim sql_select As String = "SELECT "
            Dim sql_from As String = "FROM "
            Dim sql_where As String = "WHERE "

            For Each dcol As DataColumn In dt.Columns
                sql_select = sql_select + kpi + "." + dcol.ColumnName.ToString & ", "
            Next

            Dim cellsearch As String = ""

            Dim ti As TableInfoAdoNet = New TableInfoAdoNet(kpi)
            ti.ReadOnly = True
            ti.DataTable = dt
            Dim table As Table = connection.Catalog.OpenTable(ti)

            Dim tbl As MapInfo.Data.Table = Nothing
            Dim tbl_map As MapInfo.Data.Table = Nothing

            Dim sql_select_final As String = ""
            Dim sql_from_final As String = ""
            Dim sql_where_final As String = ""
            Dim sql_total As String = ""

            tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(targettable)

            sql_select_final = sql_select + " " + tbl.Alias + ".obj "

            sql_from_final = sql_from + kpi & ", " + tbl.Alias + " "

            sql_where_final = sql_where + "upper(" + kpi & "." + dt.Columns(0).ColumnName + ") = upper(" + targettable + "." & targetcolumn & ")"

            sql_total = sql_select_final + sql_from_final + sql_where_final

            Dim command As MICommand = connection.CreateCommand()
            Dim irfc As IResultSetFeatureCollection
            command.CommandText = sql_total
            irfc = command.ExecuteFeatureCollection()

            If irfc.Count <> 0 Then
                If connection.Catalog.GetTable(topxtbl & "_Map") Is Nothing Then
                    Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(topxtbl & "_Map", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                    tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                    tbl_map.InsertFeatures(irfc)
                Else
                    tbl_map = Session.Current.Catalog.GetTable(topxtbl & "_Map")
                    tbl_map.InsertFeatures(irfc)
                End If
                command.Dispose()
            End If

            If tbl_map Is Nothing Then
                connection.Close()
                Exit Sub
            End If

            'Map the query
            If CountRowsInTable(tbl_map, False) > 0 Then
                Dim lyr As New FeatureLayer(tbl_map)
                MapControl1.Map.Layers.Add(lyr)

                Dim thm2 As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, kpi, dt.TableName, 8, Thematics.DistributionMethod.EqualRangeSize)
                thm2.RoundBy = 0.01

                'starting color
                thm2.Bins(0).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, Color.DarkBlue, False)
                thm2.Bins(0).Style.AreaStyle.Interior = New SimpleInterior(2, Color.DarkBlue)

                thm2.InflectionColor = Color.Yellow
                thm2.InflectionIndex = 3
                thm2.Inflected = True

                thm2.Recompute()

                For i = 0 To thm2.Bins.Count - 1
                    Dim si As SimpleInterior = thm2.Bins(i).Style.AreaStyle.Interior
                    Dim frcolor As Color = Color.FromArgb(128, si.ForeColor)
                    Dim frcolorbrdr As Color = Color.FromArgb(255, si.ForeColor)

                    thm2.Bins(i).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, frcolorbrdr, False)
                    thm2.Bins(i).Style.AreaStyle.Interior = New SimpleInterior(si.Pattern, frcolor)
                Next
                thm2.Bins(thm2.InflectionIndex).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, thm2.InflectionColor, False)
                thm2.Bins(thm2.InflectionIndex).Style.AreaStyle.Interior = New SimpleInterior(2, thm2.InflectionColor)

                lyr.Modifiers.Append(thm2)
                MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)

                Legend_CreateThematic(thm2, kpi, lyr)
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus("Cell_TopX_Mapping: Problem during mapping of TopX" & Chr(13) & ex.Message)
        Finally
            connection.Close()
            RefreshQuickThemeControl()
        End Try
    End Sub

    Public Sub Layer_View(ByVal layername As String, ByVal state As Boolean)
        Dim lyr As FeatureLayer = CType(MapControl1.Map.Layers(layername), FeatureLayer)
        Dim labellyr As MapInfo.Mapping.LabelLayer = MapControl1.Map.Layers("Labels_" + layername)

        If Not IsNothing(lyr) Then
            Dim item As ToolStripButton = CType(Me.map_ToolStrip.Items("Network_Status"), ToolStripButton)
            If layername.Contains("_Status") Then
                lyr.Enabled = ((CShort((CShort(-(state > False)) * CShort(-(item.Checked > False)))) > 0))
            ElseIf layername.Contains("_Tickets") Then
                lyr.Enabled = ((CShort((CShort(-(state > False)) * CShort(-(item.Checked > False)))) > 0))
            Else
                lyr.Enabled = state
                For Each t As ObjectThemeLayer In MapControl1.Map.Layers.GetMapLayerEnumerator(New FilterByLayerType(LayerType.ObjectTheme))
                    If t.Name.Contains(lyr.Name) Then
                        t.Enabled = state
                    End If
                Next
            End If
            ShowHideLegandsWithLayer(GetLayerFilterType())
        End If
        If Not IsNothing(labellyr) Then
            labellyr.Enabled = state
        End If
        RefreshQuickThemeControl()
    End Sub

    Public Sub CreateGridFromFeatures(ByVal values As GeoAggregationData)
        Try
            'Create the Interpolator 
            SetStatus("Generating Heatmap for:  " & values.TableName)
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName & "_Grid")
            Dim currentzoom As Distance
            currentzoom = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)
            Dim zoomlevel As Double = currentzoom.Value / 30

            Dim idw As New MapInfo.Raster.Interpolators.InverseDistanceWeightedInterpolator()
            ' Set the values 
            idw.SearchRadius = 50
            ' in pixels 
            idw.Exponent = 8
            idw.MinPoints = 1
            idw.MaxPoints = 1000

            _logger.SetInfo("Start Heatmap: Interpolator Created")

            ' Create a GridCreator and pass in the table to use for input, the column holding the data, the interpolator. 
            'Pop_1990 
            Dim tbl As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.GetTable(values.TableName)
            Dim cg As MapInfo.Raster.GridCreatorFromFeatures = New MapInfo.Raster.GridCreatorFromFeatures(tbl, values.KPI, idw, GetUserDataPath() & "\data\" & values.TableName & "_Grid")

            _logger.SetInfo("Start Heatmap: DestinationPath:" & GetUserDataPath() & "\data\" & values.TableName & "_Grid")
            cg.CellWidth = New Distance(Math.Max(zoomlevel / 10, 0.1), DistanceUnit.Kilometer)

            'HERE WE NEED TO CALCULATE MIN AND MAX VALUES OF KPI, AND INTERPOLATE IN INFLECTION (0,100,200. etc need to be replaced
            Dim min As Double = 100000000
            Dim max As Double = -100000000

            For Each ftr As Feature In tbl
                Dim val As Double = ftr(values.KPI)
                If val > max Then
                    max = ftr(values.KPI)
                End If
                If val < min Then
                    min = ftr(values.KPI)
                End If
            Next

            Dim infl As Inflection() = New Inflection(5) {}
            infl(0) = New Inflection(min, Color.Blue)
            infl(1) = New Inflection(min + (max - min) / 5, Color.Aquamarine)
            infl(2) = New Inflection(min + 2 * (max - min) / 5, Color.Green)
            infl(3) = New Inflection(min + 3 * (max - min) / 5, Color.Yellow)
            infl(4) = New Inflection(min + 4 * (max - min) / 5, Color.Orange)
            infl(5) = New Inflection(max, Color.Red)

            '' Create a grid Stlye to use and pass in the onflection points. 
            cg.GridStyle = New GridStyle(False, 100, 50, 50, infl, True, Color.White, True)

            Dim bd As DRect = cg.Envelope.Bounds
            bd.x1 = bd.x1 - 1
            bd.y1 = bd.y1 - 1
            bd.x2 = bd.x2 + 1
            bd.y2 = bd.y2 + 1
            cg.Envelope = New Envelope(csysWGS84, bd)

            cg.ClippingGeometry = Nothing

            ' Create the grid file. 
            cg.CreateGrid()

            MapControl1.Map.RasterReprojectionMethod = ReprojectionMethod.Always
            MapControl1.Map.DrawingAttributes.RasterReprojectionResamplingMethod = ReprojectionResamplingMethod.CubicConvolution

            Dim newtbl As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.OpenTable(GetUserDataPath() & "\data\" & values.TableName & "_Grid.tab")
            Dim lyr As New FeatureLayer(newtbl)
            lyr.Enabled = False
            MapControl1.Map.Layers.Add(lyr)

            Dim vs As MapInfo.Styles.GridStyle = New GridStyle(False, 100, 50, 50, infl, True, Color.White, True)
            Dim cs As MapInfo.Styles.CompositeStyle = New CompositeStyle(vs)
            Dim fsm As FeatureOverrideStyleModifier = New FeatureOverrideStyleModifier("Grid_Style", "Grid_Style", cs)

            lyr.Modifiers.Append(fsm)
            lyr.Enabled = True
            SetStatus("Heatmap Completed:  " & values.TableName)


            Dim layers = MapControl1.Map.Layers
            Dim owner = MapControl1.Controls.Owner


            Dim strHillshadeFilename As String = MapInfo.Raster.GridRead.DefaultHillshadeFilename(cg.GridFileName)
            Dim gridread As MapInfo.Raster.GridRead = New MapInfo.Raster.GridRead(cg.GridFileName, strHillshadeFilename)
            CreateKMLForHeatmap(gridread.GridInfo, gridread.GridStyle, tbl, newtbl.TableInfo.TablePath.Replace(".tab", ".kml"))


        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus("Heatmap Generating fail for :  " & values.TableName)
        Finally
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Public Sub MapInfo_Raster_GridReadStartRead(ByVal _gridread As GridRead, ByVal strGridFilename As String, filePath As String)
        filePath = filePath & ".kml"
        Dim strHillshadeFilename As String = GridRead.DefaultHillshadeFilename(strGridFilename)
        If _gridread.StartRead() Then

            Dim lstCoordinateColor As New List(Of Coordinates)

            Dim index_X As Integer = 0
            Dim index_Y As Integer = 0

            Dim Real_X1 As Double = 0
            Dim Real_Y1 As Double = 0
            Dim Real_X2 As Double = 0
            Dim Real_Y2 As Double = 0
            '(x1,y1) will be bottom left corner of  found cell of grid
            '(x2,y2) will be top right corner of  found cell of grid

            'Real_Color holds the color that should be applied to the found cell of the grid
            Dim Real_Color As Color = Nothing


            Dim Real_X_Start As Double = _gridread.GridInfo.RealWorldControlPoints(0).x
            Dim Real_Y_Start As Double = _gridread.GridInfo.RealWorldControlPoints(0).y
            Dim Real_X_Width As Double = (_gridread.GridInfo.RealWorldControlPoints(1).x - Real_X_Start) / _gridread.GridInfo.Width
            Dim Real_Y_Width As Double = (_gridread.GridInfo.RealWorldControlPoints(2).y - Real_Y_Start) / _gridread.GridInfo.Height

            Dim lstOfStyles As New List(Of String)
            For Each _infl As Inflection In _gridread.GridStyle.Inflections
                Dim kmlcolor = "0F" + String.Format("{0:X2}{1:X2}{2:X2}", _infl.Color.B, _infl.Color.G, _infl.Color.R)
                lstOfStyles.Add(kmlcolor)
            Next

            For index_X = 0 To _gridread.GridInfo.RasterControlPoints(1).x

                For index_Y = 0 To _gridread.GridInfo.RasterControlPoints(2).y
                    Dim bIsNull As Boolean
                    Dim dValue As Double
                    If _gridread.GetValue(index_X, index_Y, bIsNull, dValue) Then
                        If Not bIsNull Then

                            Dim objCrd As New Coordinates

                            ' read a non-null cell, with value == dValue
                            Real_X1 = Real_X_Start + index_X * Real_X_Width
                            Real_X2 = Real_X1 + Real_X_Width
                            Real_Y1 = Real_Y_Start + index_Y * Real_Y_Width
                            Real_Y2 = Real_Y1 + Real_Y_Width

                            objCrd.Real_X1 = Real_X1
                            objCrd.Real_X2 = Real_X2
                            objCrd.Real_Y1 = Real_Y1
                            objCrd.Real_Y2 = Real_Y2

                            'lookup color from inflection range
                            Dim PreviousInflectionValue As Double = -10000000
                            For Each _infl As Inflection In _gridread.GridStyle.Inflections
                                If dValue >= PreviousInflectionValue And dValue < _infl.Value Then
                                    Real_Color = _infl.Color
                                    objCrd.Real_Color = Real_Color
                                    objCrd.string_Color = "0F" + String.Format("{0:X2}{1:X2}{2:X2}", _infl.Color.B, _infl.Color.G, _infl.Color.R)
                                    Exit For
                                Else
                                    PreviousInflectionValue = _infl.Value
                                End If

                            Next
                            lstCoordinateColor.Add(objCrd)
                        End If
                    End If
                Next
            Next



            _gridread.EndRead()
            CreateKMLForHeatmap(lstCoordinateColor, lstOfStyles, filePath)
        End If
    End Sub

    Private Structure Coordinates
        Public Real_X1 As Double
        Public Real_X2 As Double
        Public Real_Y1 As Double
        Public Real_Y2 As Double
        Public Real_Color As Color
        Public string_Color As String
    End Structure

    Private Sub CreateKMLForHeatmap(lstCoordinates As List(Of Coordinates), lstStyles As List(Of String), filePath As String)

        Dim kmlout As New System.Xml.XmlTextWriter(filePath, System.Text.Encoding.UTF8)
        kmlout.WriteStartDocument()
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteStartElement("kml")
        kmlout.WriteAttributeString("xmlns", "http://www.opengis.net/kml/2.2")
        kmlout.WriteWhitespace(vbCrLf)


        kmlout.WriteStartElement("Document")

        For Each strColor As String In lstStyles
            kmlout.WriteStartElement("Style")
            kmlout.WriteAttributeString("id", "s_" + strColor)
            kmlout.WriteStartElement("PolyStyle")
            kmlout.WriteElementString("color", strColor)
            kmlout.WriteElementString("colorMode", "normal")
            kmlout.WriteElementString("fill", "1")
            kmlout.WriteElementString("outline", "0")
            kmlout.WriteEndElement()
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
        Next


        Dim ix As Int16 = 0

        For Each cord As Coordinates In lstCoordinates
            kmlout.WriteStartElement("Placemark")
            kmlout.WriteElementString("name", "PM_" + ix.ToString)
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("styleUrl", "#" + "s_" + cord.string_Color)
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("Polygon")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("extrude", "1")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("altitudeMode", "clampToGround")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("outerBoundaryIs")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("LinearRing")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("extrude", "0")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("tessellate", "1")
            kmlout.WriteWhitespace(vbCrLf)

            Dim sbCoorinate As New System.Text.StringBuilder()

            sbCoorinate.Append(Environment.NewLine)
            sbCoorinate.Append($"{cord.Real_X1},{cord.Real_Y1},0")
            sbCoorinate.Append(Environment.NewLine)
            sbCoorinate.Append($"{cord.Real_X2},{cord.Real_Y1},0")
            sbCoorinate.Append(Environment.NewLine)
            sbCoorinate.Append($"{cord.Real_X2},{cord.Real_Y2},0")
            sbCoorinate.Append(Environment.NewLine)
            sbCoorinate.Append($"{cord.Real_X1},{cord.Real_Y2},0")
            sbCoorinate.Append(Environment.NewLine)
            sbCoorinate.Append($"{cord.Real_X1},{cord.Real_Y1},0")
            sbCoorinate.Append(Environment.NewLine)
            kmlout.WriteElementString("coordinates", sbCoorinate.ToString)
            sbCoorinate.Clear()
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            ix = ix + 1
        Next

        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteEndElement()
        kmlout.WriteEndElement()

        kmlout.WriteEndDocument()
        kmlout.Flush()

    End Sub

    Private Sub CreateKMLForHeatmap(gridInfo As GridInfo, gridStyle As GridStyle, tbl As MapInfo.Data.Table, filePath As String)

        Dim kmlout As New System.Xml.XmlTextWriter(filePath, System.Text.Encoding.UTF8)
        kmlout.WriteStartDocument()
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteStartElement("kml")
        kmlout.WriteAttributeString("xmlns", "http://www.opengis.net/kml/2.2")
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteStartElement("Document")
        kmlout.WriteWhitespace(vbCrLf)

        ' To create a lootAt point
        For Each feature As Feature In tbl

            kmlout.WriteStartElement("Placemark")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("name", "Testing name Heatmap")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("description", "Heatmap Description")
            kmlout.WriteWhitespace(vbCrLf)

            kmlout.WriteStartElement("Style")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("IconStyle")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("Icon")
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)

            kmlout.WriteStartElement("LineStyle")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("color", "ff0000ff")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("width", "2")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)

            kmlout.WriteStartElement("LineString")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("tessellate", "1")
            kmlout.WriteWhitespace(vbCrLf)

            Dim dataPoint(1) As MapInfo.Geometry.DPoint
            dataPoint(1) = TransformPointWGS84ToDisplay(feature.Geometry.Centroid)
            Dim lat = dataPoint(1).y
            Dim lng = dataPoint(1).x

            'Dim R = 10 'radius of circle 
            'Dim C = rand(lat, lng) 'center Of circle 
            'Dim th = linspace(0, 2 * Math.PI)
            'Dim x = C(1) + R * Math.Cos(th)
            'Dim y = C(2) + R * Math.Sin(th)

            Dim EARTH_RADIUS_NM As Double = 3437.670013352

            Dim latitude = (lat * Math.PI) / 180
            Dim longitude = (lng * Math.PI) / 180
            Dim data = 10 / EARTH_RADIUS_NM

            Dim sbCoorinate As New System.Text.StringBuilder()
            ' To create a coordinate for draw a circle
            For x As Integer = 0 To 360
                Dim brng As Double = (x * Math.PI) / 180
                Dim latRadians = Math.Asin(Math.Sin(lat) * Math.Cos(data) + Math.Cos(lat) * Math.Sin(data) * Math.Cos(brng))
                Dim lngRadians = lng + Math.Atan2(Math.Sin(brng) * Math.Sin(data) * Math.Cos(lat), Math.Cos(data) - Math.Sin(lat) * Math.Sin(latRadians))

                sbCoorinate.Append($",{latRadians},{lngRadians}")
            Next

            kmlout.WriteElementString("coordinates", sbCoorinate.ToString.Remove(0, 1))
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)

            kmlout.WriteStartElement("Placemark")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("visibility", "0")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("Style")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("IconStyle")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("Icon")
            kmlout.WriteElementString("href", "http://maps.google.com/mapfiles/kml/shapes/cross-hairs_highlight.png")
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("Point")
            kmlout.WriteElementString("coordinates", $"{lat},{lng}")

            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement()
            kmlout.WriteWhitespace(vbCrLf)
        Next

        kmlout.WriteEndElement()
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteEndElement()
        kmlout.WriteWhitespace(vbCrLf)

        kmlout.WriteEndDocument()
        kmlout.Flush()

    End Sub

