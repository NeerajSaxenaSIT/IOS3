                For Each drow As DataRow In dt_Map_Configuration.Rows
                    Dim sql_select_final As String = ""
                    Dim sql_from_final As String = ""
                    Dim sql_where_final As String = ""
                    Dim sql_total As String = ""
                    If MapToVoronoi = True Then
                        tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim & "_Voronoi")
                    Else
                        tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim)
