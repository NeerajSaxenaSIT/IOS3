    Private Sub SetSelectedDate(ByRef dt1 As DataTable, ByVal IsFirtTime As Boolean)
        If (Not (dt1 Is Nothing)) And dt1.Rows.Count > 0 Then
            If (IsFirtTime) Then
                Dim dateMenuItem As ToolStripMenuItem = TryCast(bCellFootPrint.DropDownItems(4), ToolStripMenuItem)
                Try
                    Dim sdate As DateTime = Convert.ToDateTime(dt1.Rows(0)("CampaignStart"))
                    DTPickerStart.Text = sdate.ToString("dd/MM/yyyy")
                    DTPickerStart.EditValue = sdate
                Catch ex As Exception
                    _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                    SetStatus(ex.Message)
                End Try
                Try
                    Dim edate As DateTime = Convert.ToDateTime(dt1.Rows(0)("CampaignStop"))
                    DTPickerStop.Text = edate.ToString("dd/MM/yyyy")
                    DTPickerStop.EditValue = edate
                Catch ex As Exception
                    _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                    SetStatus(ex.Message)
                End Try
            Else
                Dim stDate As New List(Of DateTime)
                Dim endDate As New List(Of DateTime)
                For Each row As DataRow In dt1.Rows
                    Try
                        Dim sdate As DateTime = Convert.ToDateTime(row("CampaignStart"))
                        stDate.Add(sdate)
                    Catch ex As Exception
                        _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                        SetStatus(ex.Message)
                    End Try
                    Try
                        Dim edate As DateTime = Convert.ToDateTime(row("CampaignStop"))
                        endDate.Add(edate)

                    Catch ex As Exception
                        _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                        SetStatus(ex.Message)
                    End Try
                Next
                Try
                    If (stDate.Count > 0) Then
                        stDate.Sort()
                        DTPickerStart.Text = stDate(0).ToString("dd/MM/yyyy")
                        DTPickerStart.EditValue = stDate(0)
                    End If
                Catch ex As Exception
                    _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                End Try
                Try
                    If (endDate.Count > 0) Then
                        endDate.Sort()
                        DTPickerStop.Text = endDate(endDate.Count - 1).ToString("dd/MM/yyyy")
                        DTPickerStop.EditValue = endDate(endDate.Count - 1)
                    End If
                Catch ex As Exception
                    _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                End Try
            End If
        End If
    End Sub

