    Private Sub btnNetworkStatus2_Click(sender As Object, e As EventArgs) Handles btnNetworkStatus2.Click
        GetNetworkState()
    End Sub

    Private Sub GetNetworkState()
        'check if mapinfo tables are live
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            'validate
            Dim networkarea As String = NetworkArea_GetSelection(True)
            If networkarea = "" Then
                SetStatus("Set Network Area in Network Selection!")
                Exit Sub
            End If

            Dim parray()() As String = Nothing

            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            'construct query
            Dim connstring As String = GetSQL(1022, Nothing)(0)
            Dim sql_networkstate_alarms As String = GetSQL(1022, Nothing)(1)
            Dim sql_networkstate_tickets As String = GetSQL(1023, Nothing)(1)

            Dim AlarmState As String = Nothing
            Dim AlarmSeverity As String = Nothing
            Dim AlarmFilter As String = Nothing

            Dim startdate_string As String = Chr(39) & CDate(vdtp_networkstatus_start.DateTime).ToString("yyyy-MM-dd") & Chr(39)
            Dim enddate_string As String = Chr(39) & CDate(vdtp_networkstatus_end.DateTime).ToString("yyyy-MM-dd") & Chr(39)

            'launching alarms data
            If ceNetworkStatusAlarms.Checked = True Then
                lblNwSttsProgress.Text = "Fetching Network Status Alarms Data"
                Application.DoEvents()

                If cmbNSAlarmState.Text.ToUpper = "ACTIVE" Then
                    AlarmState = Chr(39) & "ACTIVE" & Chr(39)
                ElseIf cmbNSAlarmState.Text.ToUpper = "ALL" Then
                    AlarmState = Chr(39) & "ALL" & Chr(39)
                End If

                If cmbNSAlarmSeverity.Text.ToUpper = "CRITICAL" Then
                    AlarmSeverity = Chr(39) + "1" + Chr(39)
                ElseIf cmbNSAlarmSeverity.Text.ToUpper = "MAJOR OR WORSE" Then
                    AlarmSeverity = Chr(39) + "2" + Chr(39)
                Else
                    AlarmSeverity = Chr(39) + "3" + Chr(39)
                End If

                If cmbNSAlarmFilter.Properties.GetCheckedItems.ToString = "" Then
                    AlarmFilter = Chr(39) & "''''" & Chr(39)
                Else
                    AlarmFilter = Chr(39) & Chr(39) & Chr(39) & cmbNSAlarmFilter.Properties.GetCheckedItems.ToString.Replace(", ", "'',''") & Chr(39) & Chr(39) & Chr(39)
                End If

                parray = Nothing
                parray = {
                    New String() {"@StartDate", startdate_string},
                    New String() {"@EndDate", enddate_string},
                    New String() {"@Severity", AlarmSeverity},
                    New String() {"@ActiveOrAll", AlarmState},
                    New String() {"@AlarmFilter", AlarmFilter}
                }

                Dim dt_Network_State_alarms As DataTable = DataAccessorODBC.GetDataTable(GetSQL(1022, parray)(0), GetSQL(1022, parray)(1), iQryTimeOut)
                If dt_Network_State_alarms Is Nothing Or dt_Network_State_alarms.Rows.Count = 0 Then
                    lblNwSttsProgress.Text = "No Alarms Network State Information Found"
                    Application.DoEvents()
                ElseIf dt_Network_State_alarms.Rows.Count > 5000 Then
                    lblNwSttsProgress.Text = "No Mapping Over 5000 Alarms. Apply Filters."
                    Application.DoEvents()

                    Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData("NetworkStatus_Alarms")
                    IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridCtrl_Map.MainView, dt_Network_State_alarms, "ALL")
                Else
                    lblNwSttsProgress.Text = "Mapping Network Status Alarms Data"
                    Application.DoEvents()
                    AlarmState_Map(dt_Network_State_alarms)

                    'map result
                    lblNwSttsProgress.Text = "Finished!"
                End If
            End If

            'launching tickets data
            If ceNetworkStatusTickets.Checked = True Then
                Dim TicketState As String = Nothing
                If cmbNSTicketState.Text.ToUpper = "OPEN" Then
                    TicketState = Chr(39) + "1" + Chr(39)
                Else
                    TicketState = Chr(39) + "%" + Chr(39)
                End If

                lblNwSttsProgress.Text = "Fetching Network Status Tickets Data"
                Application.DoEvents()

                parray = Nothing
                parray = {
                    New String() {"@area", "IN(" + networkarea.TrimEnd(",") + ")"},
                    New String() {"@open", TicketState},
                    New String() {"@startdate", startdate_string},
                    New String() {"@enddate", enddate_string}
                }

                connstring = GetSQL(1023, parray)(0)
                If connstring.ToUpper.StartsWith("DSN") Then
                    Dim dt_Network_State_Tickets As DataTable = DataAccessorODBC.GetDataTable(GetSQL(1023, parray)(0), GetSQL(1023, parray)(1), iQryTimeOut)
                    If dt_Network_State_Tickets Is Nothing Then
                        SetStatus("No Tickets Network State Information Found On OSS")
                    Else
                        lblNwSttsProgress.Text = "Mapping Network Status Tickets Data"
                        Application.DoEvents()
                        TicketState_Map(dt_Network_State_Tickets)
                    End If
                ElseIf connstring.ToUpper.StartsWith("API") Then
                    lblNwSttsProgress.Text = "Fetching Live Status Data...Tickets"
                    Application.DoEvents()
                    LoadTicketsDataFromWebAPI(sql_networkstate_tickets)

                    'map result
                    lblNwSttsProgress.Text = "Finished!"
                End If
            End If

            'launching availability data
            If ceNetworkStatusAvailability.Checked = True Then
                lblNwSttsProgress.Text = "Fetching Network Status Availability Data"
                Application.DoEvents()

                parray = Nothing
                parray = {
                    New String() {"@availability", CInt(trkBarNSAvailability.EditValue)},
                    New String() {"@availFilter", Chr(39) & cmbNSAvailabilityFilter.SelectedItem.ToString & Chr(39)}
                }

                Dim dt_Network_State_availability As DataTable = DataAccessorODBC.GetDataTable(GetSQL(1008, parray)(0), GetSQL(1008, parray)(1), iQryTimeOut)
                If dt_Network_State_availability Is Nothing Then
                    lblNwSttsProgress.Text = "No Availability Network State information found"
                    Application.DoEvents()
                Else
                    lblNwSttsProgress.Text = "Mapping Network Status Availability Data"
                    Application.DoEvents()
                    dt_Network_State_availability.TableName = "AvailabilityState_Map"
                    AvailabilityState_Map(dt_Network_State_availability)

                    'map result
                    lblNwSttsProgress.Text = "Finished!"
                End If
            End If

            Dim item As ToolStripButton = CType(Me.map_ToolStrip.Items("Network_Status"), ToolStripButton)
            item.Checked = True
            Dim ts As System.Windows.Forms.ToolStripItemClickedEventArgs = New System.Windows.Forms.ToolStripItemClickedEventArgs(item)
            map_ToolStrip_ItemClicked(Nothing, ts)
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Private Async Sub LoadTicketsDataFromWebAPI(ByVal apiConfigXml As String)
        Try
            'Calling service now api to fetch live tickets data and load on map
            Dim dsTicketsConfig As DataSet = Nothing

            Using sr As New System.IO.StringReader(apiConfigXml)
                dsTicketsConfig = New DataSet
                dsTicketsConfig.ReadXml(sr)
            End Using

            If configMgr.User.LicenseCompany.ToUpper = "ODIDO" Then

                Dim dtAuth As DataTable = dsTicketsConfig.Tables(0)
                Dim authTokenUrl As String = dtAuth.Rows(0)("AuthTokenUrl")
                Dim apiBaseUrl As String = dtAuth.Rows(0)("APIBaseUrl")
                Dim userName As String = dtAuth.Rows(0)("UserName")
                Dim pswd As String = dtAuth.Rows(0)("Password")
                Dim clientID As String = dtAuth.Rows(0)("ClientID")
                Dim clientSecret As String = dtAuth.Rows(0)("ClientSecret")
                Dim methodType As String = dtAuth.Rows(0)("MethodType")
                Dim methodParams() As String = dtAuth.Rows(0)("MethodParams").ToString.Split("|")
                Dim cols() As String = dtAuth.Rows(0)("ColumnName").ToString.Split("|")
                Dim replaceCols() As String = dtAuth.Rows(0)("ReplacedColumn").ToString.Split("|")
                Dim colsOrdinal() As String = dtAuth.Rows(0)("ColumnOrdinal").ToString.Split("|")

                Dim priority As String = Nothing

                priority = "2%2C3%2C4%2C5%2C6%2C7%2C8"

                Dim actualUrl As String = Nothing
                Dim location As String = "%22MBTS%22%2C%22BBU%22"
                Dim startDate As String = Nothing
                Dim endDate As String = Nothing
                Dim accessToken As String = Nothing
                Dim refreshToken As String = Nothing

                Using client As New HttpClient()

                    'POST request to get access token/refresh token
                    client.BaseAddress = New Uri(authTokenUrl)
                    client.DefaultRequestHeaders.Accept.Clear()
                    client.DefaultRequestHeaders.Accept.Add(New MediaTypeWithQualityHeaderValue("application/x-www-form-urlencoded"))
                    ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12
                    Dim reqBodyContent = New FormUrlEncodedContent(
                    {
                        New KeyValuePair(Of String, String)("grant_type", "password"),
                        New KeyValuePair(Of String, String)("client_id", clientID),
                        New KeyValuePair(Of String, String)("client_secret", clientSecret),
                        New KeyValuePair(Of String, String)("username", userName),
                        New KeyValuePair(Of String, String)("password", pswd)
                    })
                    Dim token = Await client.PostAsync(client.BaseAddress, reqBodyContent)
                    If token.StatusCode = HttpStatusCode.OK Then
                        Dim tokenContent = token.Content.ReadAsStringAsync()
                        Dim jTokenData As JObject = TryCast(JsonConvert.DeserializeObject(tokenContent.Result.ToString), JObject)
                        accessToken = jTokenData.GetValue("access_token").ToString
                        refreshToken = jTokenData.GetValue("refresh_token").ToString
                    End If
                    '****************************************************************************

                    'POST subsequent request to get access token/refresh token
                    client.DefaultRequestHeaders.Accept.Clear()
                    client.DefaultRequestHeaders.Accept.Add(New MediaTypeWithQualityHeaderValue("application/x-www-form-urlencoded"))
                    ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12
                    Dim subReqBodyContent = New FormUrlEncodedContent(
                    {
                        New KeyValuePair(Of String, String)("grant_type", "refresh_token"),
                        New KeyValuePair(Of String, String)("client_id", clientID),
                        New KeyValuePair(Of String, String)("client_secret", clientSecret),
                        New KeyValuePair(Of String, String)("refresh_token", refreshToken)
                    })
                    Dim subToken = Await client.PostAsync(client.BaseAddress, subReqBodyContent)
                    If subToken.StatusCode = HttpStatusCode.OK Then
                        Dim subTokenContent = subToken.Content.ReadAsStringAsync()
                        Dim jTokenData As JObject = TryCast(JsonConvert.DeserializeObject(subTokenContent.Result.ToString), JObject)
                        accessToken = jTokenData.GetValue("access_token").ToString
                        refreshToken = jTokenData.GetValue("refresh_token").ToString
                    End If
                    '****************************************************************************
                End Using

                Using client As New HttpClient()

                    startDate = CDate(vdtp_networkstatus_start.EditValue).ToString("yyyy-MM-dd")
                    endDate = CDate(vdtp_networkstatus_end.EditValue).ToString("yyyy-MM-dd")

                    actualUrl = apiBaseUrl & methodType & "?" & methodParams(0) & "=" & location & "&" & methodParams(1) & "=" & startDate & "&" & methodParams(2) & "=" & endDate & "&" & methodParams(3) & "=" & priority

                    'GET request to get access tickets data
                    client.BaseAddress = New Uri(apiBaseUrl)
                    client.DefaultRequestHeaders.Accept.Clear()
                    client.DefaultRequestHeaders.Authorization = New AuthenticationHeaderValue("Bearer", accessToken)
                    client.DefaultRequestHeaders.Add("cis", location)
                    client.DefaultRequestHeaders.Add("start_date", startDate)
                    client.DefaultRequestHeaders.Add("end_date", endDate)
                    client.DefaultRequestHeaders.Add("priority", priority)
                    client.DefaultRequestHeaders.Accept.Add(New MediaTypeWithQualityHeaderValue("application/xml"))
                    ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12

                    Dim response = Await client.GetAsync(actualUrl)
                    If response.StatusCode = HttpStatusCode.OK Then
                        Dim tickesData = Await response.Content.ReadAsStringAsync()
                        Dim taskResponse As String = Await client.GetStringAsync(actualUrl)
                        Dim ds As DataSet = XMLToDataSet(tickesData, "")
                        If ds IsNot Nothing AndAlso ds.Tables.Count <> 0 Then
                            dt_Network_State_Tickets = ds.Tables(0)
                            For iCntr = 0 To replaceCols.Count - 1
                                dt_Network_State_Tickets.Columns(iCntr).ColumnName = CStr(replaceCols(iCntr))
                                dt_Network_State_Tickets.AcceptChanges()
                            Next

                            If cmbNSTicketState.Text.ToUpper = "OPEN" Then
                                Dim dtOpenTickets = dt_Network_State_Tickets.AsEnumerable().Where(Function(x) x.Field(Of String)("state") <> "Closed" Or x.Field(Of String)("state") <> "closed").CopyToDataTable()
                                TicketState_Map(dtOpenTickets, replaceCols, colsOrdinal)
                            Else
                                TicketState_Map(dt_Network_State_Tickets, replaceCols, colsOrdinal)
                            End If
                        End If
                    End If
                End Using

            ElseIf configMgr.User.LicenseCompany.ToUpper = "TDC" Then

                Dim dtAuth As DataTable = dsTicketsConfig.Tables(0)
                Dim authTokenUrl As String = dtAuth.Rows(0)("AuthTokenUrl")
                Dim apiBaseUrl As String = dtAuth.Rows(0)("APIBaseUrl")
                Dim userName As String = dtAuth.Rows(0)("UserName")
                Dim pswd As String = dtAuth.Rows(0)("Password")
                Dim clientID As String = dtAuth.Rows(0)("ClientID")
                Dim clientSecret As String = dtAuth.Rows(0)("ClientSecret")
                Dim methodType As String = dtAuth.Rows(0)("MethodType")
                Dim methodParams() As String = dtAuth.Rows(0)("MethodParams").ToString.Split("|")
                Dim sysParamFields As String = dtAuth.Rows(0)("ColumnName").ToString
                Dim replaceCols() As String = dtAuth.Rows(0)("ReplacedColumn").ToString.Split("|")
                Dim colsOrdinal() As String = dtAuth.Rows(0)("ColumnOrdinal").ToString.Split("|")
                Dim sysParamQuery As String = dtAuth.Rows(0)("SysParamQuery").ToString
                Dim ticketURL As String = dtAuth.Rows(0)("TicketURL").ToString

                Dim actualUrl As String = Nothing
                Dim startDate As String = Nothing
                Dim endDate As String = Nothing
                Dim accessToken As String = Nothing
                Dim refreshToken As String = Nothing
                Dim tokenFilePath As String = GetUserDataPath() & "\Data\ServiceNowApiToken.dat"

                Using client As New HttpClient()

                    If File.Exists(tokenFilePath) Then

                        Dim fileContent = File.ReadAllText(tokenFilePath)
                        refreshToken = fileContent.Split(":")(1)

                        'POST request to get access token from refresh token
                        client.BaseAddress = New Uri(authTokenUrl)
                        client.DefaultRequestHeaders.Accept.Clear()
                        client.DefaultRequestHeaders.Accept.Add(New MediaTypeWithQualityHeaderValue("application/x-www-form-urlencoded"))
                        ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12
                        Dim fileBodyContent = New FormUrlEncodedContent(
                        {
                            New KeyValuePair(Of String, String)("grant_type", "refresh_token"),
                            New KeyValuePair(Of String, String)("client_id", clientID),
                            New KeyValuePair(Of String, String)("client_secret", clientSecret),
                            New KeyValuePair(Of String, String)("refresh_token", refreshToken)
                        })
                        Dim newToken = Await client.PostAsync(client.BaseAddress, fileBodyContent)
                        If newToken.StatusCode = HttpStatusCode.OK Then
                            Dim tokenContent = newToken.Content.ReadAsStringAsync()
                            Dim jTokenData As JObject = TryCast(JsonConvert.DeserializeObject(tokenContent.Result.ToString), JObject)
                            accessToken = jTokenData.GetValue("access_token").ToString
                            refreshToken = jTokenData.GetValue("refresh_token").ToString
                        Else
                            Dim reqBodyContent = New FormUrlEncodedContent(
                            {
                                New KeyValuePair(Of String, String)("grant_type", "password"),
                                New KeyValuePair(Of String, String)("client_id", clientID),
                                New KeyValuePair(Of String, String)("client_secret", clientSecret),
                                New KeyValuePair(Of String, String)("username", userName),
                                New KeyValuePair(Of String, String)("password", pswd)
                            })
                            Dim token = Await client.PostAsync(client.BaseAddress, reqBodyContent)
                            If token.StatusCode = HttpStatusCode.OK Then
                                Dim tokenContent = token.Content.ReadAsStringAsync()
                                Dim jTokenData As JObject = TryCast(JsonConvert.DeserializeObject(tokenContent.Result.ToString), JObject)
                                accessToken = jTokenData.GetValue("access_token").ToString
                                refreshToken = jTokenData.GetValue("refresh_token").ToString
                            End If

                            File.Delete(tokenFilePath)
                            Dim writeContent As String = "RefreshToken:" & refreshToken
                            File.WriteAllText(tokenFilePath, writeContent, System.Text.Encoding.UTF8)
                            File.SetAttributes(tokenFilePath, FileAttributes.Hidden)
                        End If

                    Else

                        'POST request to get access token/refresh token
                        client.BaseAddress = New Uri(authTokenUrl)
                        client.DefaultRequestHeaders.Accept.Clear()
                        client.DefaultRequestHeaders.Accept.Add(New MediaTypeWithQualityHeaderValue("application/x-www-form-urlencoded"))
                        ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12
                        Dim reqBodyContent = New FormUrlEncodedContent(
                        {
                            New KeyValuePair(Of String, String)("grant_type", "password"),
                            New KeyValuePair(Of String, String)("client_id", clientID),
                            New KeyValuePair(Of String, String)("client_secret", clientSecret),
                            New KeyValuePair(Of String, String)("username", userName),
                            New KeyValuePair(Of String, String)("password", pswd)
                        })
                        Dim token = Await client.PostAsync(client.BaseAddress, reqBodyContent)
                        If token.StatusCode = HttpStatusCode.OK Then
                            Dim tokenContent = token.Content.ReadAsStringAsync()
                            Dim jTokenData As JObject = TryCast(JsonConvert.DeserializeObject(tokenContent.Result.ToString), JObject)
                            accessToken = jTokenData.GetValue("access_token").ToString
                            refreshToken = jTokenData.GetValue("refresh_token").ToString
                        End If

                        Dim filecontent As String = "RefreshToken:" & refreshToken
                        File.WriteAllText(tokenFilePath, filecontent, System.Text.Encoding.UTF8)
                        File.SetAttributes(tokenFilePath, FileAttributes.Hidden)

                    End If

                    'POST subsequent request to get access token/refresh token
                    client.DefaultRequestHeaders.Accept.Clear()
                    client.DefaultRequestHeaders.Accept.Add(New MediaTypeWithQualityHeaderValue("application/x-www-form-urlencoded"))
                    ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12
                    Dim subReqBodyContent = New FormUrlEncodedContent(
                    {
                        New KeyValuePair(Of String, String)("grant_type", "refresh_token"),
                        New KeyValuePair(Of String, String)("client_id", clientID),
                        New KeyValuePair(Of String, String)("client_secret", clientSecret),
                        New KeyValuePair(Of String, String)("refresh_token", refreshToken)
                    })
                    Dim subToken = Await client.PostAsync(client.BaseAddress, subReqBodyContent)
                    If subToken.StatusCode = HttpStatusCode.OK Then
                        Dim subTokenContent = subToken.Content.ReadAsStringAsync()
                        Dim jTokenData As JObject = TryCast(JsonConvert.DeserializeObject(subTokenContent.Result.ToString), JObject)
                        accessToken = jTokenData.GetValue("access_token").ToString
                        refreshToken = jTokenData.GetValue("refresh_token").ToString
                    End If
                    '****************************************************************************
                End Using

                Using client As New HttpClient()

                    startDate = CDate(vdtp_networkstatus_start.EditValue).ToString("yyyy-MM-dd")
                    endDate = CDate(vdtp_networkstatus_end.EditValue).ToString("yyyy-MM-dd")

                    sysParamQuery = sysParamQuery & "^opened_at>" & startDate & "^opened_at<" & endDate

                    actualUrl = apiBaseUrl & "?" & methodParams(0) & "=" & sysParamFields & "&" & methodParams(1) & "=" & 100 & "&" & methodParams(2) & "=" & sysParamQuery & "&" & methodParams(3) & "=true" & "&" & methodParams(4) & "=true"

                    'GET request to get access tickets data
                    client.BaseAddress = New Uri(apiBaseUrl)
                    client.DefaultRequestHeaders.Accept.Clear()
                    client.DefaultRequestHeaders.Authorization = New AuthenticationHeaderValue("Bearer", accessToken)
                    client.DefaultRequestHeaders.Accept.Add(New MediaTypeWithQualityHeaderValue("application/xml"))
                    ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12

                    Dim response = Await client.GetAsync(actualUrl)
                    If response.StatusCode = HttpStatusCode.OK Then
                        Dim tickesData = Await response.Content.ReadAsStringAsync()
                        Dim taskResponse As String = Await client.GetStringAsync(actualUrl)
                        Dim ds As DataSet = XMLToDataSet(tickesData, "")
                        If ds IsNot Nothing AndAlso ds.Tables.Count <> 0 Then
                            dt_Network_State_Tickets = ds.Tables(0)
                            For iCntr = 0 To replaceCols.Count - 1
                                dt_Network_State_Tickets.Columns(iCntr).ColumnName = CStr(replaceCols(iCntr))
                                dt_Network_State_Tickets.AcceptChanges()
                            Next

                            If cmbNSTicketState.Text.ToUpper = "OPEN" Then
                                Dim dtOpenTickets = dt_Network_State_Tickets.AsEnumerable().Where(Function(x) x.Field(Of String)("state") <> "Closed" And x.Field(Of String)("state") <> "closed").CopyToDataTable()
                                For Each dr As DataRow In dtOpenTickets.Rows
                                    dr("sys_id") = ticketURL & dr("sys_id")
                                Next
                                TicketState_Map(dtOpenTickets, replaceCols, colsOrdinal)
                            Else
                                TicketState_Map(dt_Network_State_Tickets, replaceCols, colsOrdinal)
                            End If
                        End If
                    End If
                End Using

            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
