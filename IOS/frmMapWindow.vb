    Private Sub DT_AllRoutes()
        Try
            ToolStripProgressBar1.Value = 30
            sql = "select MIN(parcelid) as parcelid,MIN(px) as px,MIN(py) as py,MAX(timestamp) as timestamp from dbo.DT_AllRoutes where timestamp >= ? and TimeSTamp < GETDATE() group by parcelid order by parcelid"
            If MapControl1.Map.Legends.Count > 0 Then
                MapControl1.Map.Legends(0).Format.AutoSizeLegend = False
            End If
            Dim dStyle As Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.FontPointStyle(33, New MapInfo.Styles.Font("MapInfo Symbols", 6), 0, Color.Black, 6))

            Dim truncatedDateTime As DateTime = New DateTime(FinalDate.Ticks - (FinalDate.Ticks Mod TimeSpan.TicksPerSecond), FinalDate.Kind)

            Dim objAdoNetTableInfo As New IOSTableInfoAdoNet("DT_AllRoutes", conn_IOSDriveTestModule, sql, dStyle, "PX", "PY")
            objMapHelper.ProgressBar = ToolStripProgressBar1
            Dim list As New List(Of System.Data.Odbc.OdbcParameter)
            Dim parameter As New System.Data.Odbc.OdbcParameter("d", Odbc.OdbcType.DateTime)
            parameter.Value = truncatedDateTime
            list.Add(parameter)
            objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoNetTableInfo, list, 30, 90)
            ToolStripProgressBar1.Value = 95
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

    Private Sub DT_AllEvents()
        Try
            objMapHelper.RemoveLayer("DT_Events_GetEvents")
            objMapHelper.CloseTable("DT_Events_GetEvents")
            objMapHelper.RemoveLayer("Lines_SourceCells_Events")
            Dim dStyle As Style = IOSStyleHelper.GetSytle(TableNames.DT_Events)
            Dim layerName As String = "DT_Events"
            Dim q As String = "Select * from dbo.DT_Events where TimeStamp between ? and GETDATE()"
            ''If (ceAllOpenEventOfLastXdays.Checked) Then
            q = q & " and EventStatus <> 'Closed'"
            layerName = "DT_Events_Open"
            objMapHelper.RemoveLayer("DT_Events")
            objMapHelper.CloseTable("DT_Events")
            ''Else
            objMapHelper.RemoveLayer("DT_Events_Open")
            objMapHelper.CloseTable("DT_Events_Open")
            ''End If

            Dim truncatedDateTime As DateTime = New DateTime(FinalDate.Ticks - (FinalDate.Ticks Mod TimeSpan.TicksPerSecond), FinalDate.Kind)

            Dim parameters As New List(Of System.Data.Odbc.OdbcParameter)
            Dim parameterFinaldate As New System.Data.Odbc.OdbcParameter("@finalDate", System.Data.Odbc.OdbcType.DateTime)
            parameterFinaldate.Value = truncatedDateTime
            parameters.Add(parameterFinaldate)
            Dim objAdoNetTableInfo As New IOSTableInfoAdoNet(layerName, conn_IOSDriveTestModule, q, dStyle, "x", "y")
            objMapHelper.ProgressBar = ToolStripProgressBar1
            objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoNetTableInfo, parameters, 50, 70)
            If (objAdoNetTableInfo.OutData.Rows.Count > 0) Then
                dtEventFailurData = objAdoNetTableInfo.OutData
                frmEvent.SetFailurData(dtEventFailurData)
                If (ApplyHavingSettings(objAdoNetTableInfo.OutLayer)) Then
                    Dim thm As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(objAdoNetTableInfo.OutLayer, "ProblemEventType", "ProblemEventType")
                    thm.ApplyStylePart = Thematics.StylePart.All
                    Dim mtb2 As Thematics.ModifierThemeBin
                    For i = 0 To thm.Bins.Count - 1
                        mtb2 = thm.Bins.Item(i)
                        mtb2.Style.SymbolStyle.PointSize = CType(dStyle, MapInfo.Styles.CompositeStyle).SymbolStyle.PointSize
                    Next
                    thm.RecomputeBins()
                    objAdoNetTableInfo.OutLayer.Modifiers.Append(thm)
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message.ToString)
        End Try
    End Sub

