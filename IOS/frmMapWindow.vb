    Private Sub tsmi_SendICM_Click(sender As Object, e As EventArgs) Handles tsmi_SendICM.Click
        If (Not frmICM.Visible) Then
            Exit Sub
            'frm_IOS_MDI.Manager_IcmToolStripMenuItem_Click(Nothing, Nothing)
        End If
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Try
            frmICM.SetIsFromSendToICM(True)
        Catch ex As Exception

        End Try

        Dim tbl As MapInfo.Data.Table
        Dim selected_tech As String = Nothing
        Dim tech_processed As New List(Of String)
        Dim flags As New IOS.Library.SelectionToTreeFlags()
        Dim tech As String = "3G"
        Dim vendor As String = "HUAWEI"
        Dim obj As String = "UCELL"
        Dim LayerTech As String = Nothing
        Dim isValue As String = False
        Dim IsNeedToBindDropDown As Boolean = True
        Dim listOfSelectedCells As New List(Of String)
        Try
            For Each tbl In MapInfo.Engine.Session.Current.Catalog
                Dim fc As IResultSetFeatureCollection = Session.Current.Selections.DefaultSelection(tbl)

                Try
                    If (Not fc Is Nothing AndAlso fc.Count <> 0) And Layer_InMapConfiguration(tbl.Alias) Then
                        For Each drow As DataRow In dt_Map_Configuration.Rows
                            If drow.Item("LayerName").ToString = tbl.Alias Then
                                tech = drow.Item("LayerTechnology").ToString
                                LayerTech = drow.Item("LayerTech").ToString
                                vendor = drow.Item("LayerVendor").ToString
                                isValue = True
                                Exit For
                            End If
                        Next
                        obj = GetCellObjectFromConsole(LayerTech)

                        If (obj Is Nothing) Then
                            Continue For
                        End If

                        If (isValue AndAlso IsNeedToBindDropDown) Then

                            frmICM.SetComboValue(tech, frmICM.cmbTechnology)
                            frmICM.SetComboValue(vendor, frmICM.cmbVendor)
                            frmICM.SetComboValue(obj, frmICM.cmbTargetObject, True)
                            IsNeedToBindDropDown = False
                        End If
                        'TODO: Uncomment below method as currently it is giving error becuase of invalid column in database
                        Dim field2tree As String = Layer_Column2Tree(tbl.Alias)
                        If field2tree = Nothing Then
                            field2tree = "CELLID"
                        End If
                        For Each ftr As Feature In fc
                            Dim cellid = ftr.Item(field2tree).ToString()
                            listOfSelectedCells.Add(cellid)
                            frmICM.SelectTreeNode(cellid, True)
                        Next
                    End If
                Catch ex As Exception
                    _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                End Try
            Next
        Finally
            frmICM.SetIsFromSendToICM(False)
            If (listOfSelectedCells.Count > 0) Then
                frmICM.Reload()
                If (listOfSelectedCells.Count = 1) Then
                    frmICM.BindCellChartGrid(listOfSelectedCells(0), True)
                End If
            End If
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
        End Try

        'If Not selected_tech Is Nothing Then
        '    selected_tech = selected_tech.TrimEnd(",")
        'End If
    End Sub

