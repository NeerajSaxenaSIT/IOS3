    Public Sub Legend_CreateThematic(ByVal th As Thematics.ITheme, ByVal title As String, ByVal subtitle As String, ByRef lyr As FeatureLayer)
        Try
            Dim legend As MapInfo.Mapping.Legends.Legend = Nothing

            If MapControl1.Map.Legends.Count = 0 Then
                Dim legendFactory As MapInfo.Mapping.Legends.LegendFactory = MapControl1.Map.Legends

                Dim iSize As Integer = 200
                If lyr IsNot Nothing Then
                    Dim textSize As Size = TextRenderer.MeasureText(lyr.Name.ToString, New System.Drawing.Font("Arial", 10, GraphicsUnit.Point))
                    iSize = textSize.Width + 25
                End If
                legend = legendFactory.CreateLegend(New System.Drawing.Size(200, 200))
                legend.Border = True
                legend.BorderPen = New Pen(Color.Gray, 2.0!)
                legend.Format = New MapInfo.Mapping.Legends.LegendFormat
                legend.Format.AutoPositionFrames = True
                legend.Format.AutoSizeLegend = True
                legend.Format.FrameAlignment = MapInfo.Mapping.Legends.LegendFrameAlignment.Vertical
                legend.Format.FramesPerRow = 1
                legend.Format.FramesPerColumn = 5
                legend.Format.HorizontalFramePadding = 1
                legend.Format.VerticalFramePadding = 1
                legend.BackgroundBrush = New SolidBrush(Color.White)
                legend.Alias = "MainLegend"
                legend_ac = New MapInfo.Windows.Controls.LegendAdornmentControl(legend, MapControl1.Map)
                legend_ac.Visible = False
                MapControl1.AddAdornment(legend, legend_ac)
            Else
                legend = MapControl1.Map.Legends(0)
            End If

            If Not legend Is Nothing Then
                ' Add theme legend frame to legend's Frames collection.
                legend.Format.AutoSizeLegend = True
                Dim themeFrame As ThemeLegendFrame = LegendFrameFactory.CreateThemeLegendFrame(th)
                legend.Frames.Append(themeFrame)
                themeFrame.ShowCount = True
                themeFrame.Border = LegendFrameBorder.On
                themeFrame.TitleStyle = New MapInfo.Styles.Font("Arial", 10)
                themeFrame.SubTitleStyle = New MapInfo.Styles.Font("Arial", 8)
                themeFrame.RowTextStyle = New MapInfo.Styles.Font("Arial", 8)
                themeFrame.Title = title
                themeFrame.SubTitle = subtitle

                For Each frame As MapInfo.Mapping.Legends.ThemeLegendFrame In legend.Frames
                    If (frame.SubTitle = "RSCP_Delta" Or frame.SubTitle = "EcNo_Delta" Or frame.SubTitle = "RxLevAvg_Delta") Then
                        If (frame.Rows.Count = 3) Then
                            frame.Rows.Item(0).Text = "<-3"
                            frame.Rows.Item(2).Text = ">3"
                        End If
                    End If
                Next

                If Not lyr Is Nothing Then
                    themeFrame.Alias = lyr.Alias & "_Thm"
                    themeFrame.Visible = lyr.Enabled
                Else
                    themeFrame.Visible = True
                End If
                themeFrame.ShowEmptyRanges = True
                'make all rows visible
                'For i = 0 To themeFrame.Rows.Count - 1
