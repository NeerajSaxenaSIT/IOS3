                        oldFont = New Font("Arial Narrow", 10)
                        oldFont.FontWeight = FontWeight.Bold
                        oldFont.ForeColor = Color.Black
                        source.DefaultLabelProperties.Style.Font = oldFont
                        source.DefaultLabelProperties.Style.Font.ForeColor = Color.Black
                    Else
                        source.DefaultLabelProperties.Style.Font = New Font("Arial Narrow", 10)
                        source.DefaultLabelProperties.Style.Font.TextEffect = TextEffect.Halo
                        source.DefaultLabelProperties.Style.Font.FontWeight = FontWeight.Bold
                        Dim rnd As Random = New Random()
                        Dim labelcolor As Color = Color.Black   'FromArgb(rnd.Next(255), rnd.Next(255), rnd.Next(255))

