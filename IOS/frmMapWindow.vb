    Private Sub tsmi_SelCopy_Click(sender As Object, e As EventArgs) Handles tsmi_SelCopy.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Clipboard.Clear()
        Dim dataTab As DataTable = New DataTable

        For Each tbl In MapInfo.Engine.Session.Current.Catalog
            Dim fc As IResultSetFeatureCollection = Session.Current.Selections.DefaultSelection(tbl)
            Dim dt_temp As DataTable = New DataTable
            Try
                If Not fc Is Nothing Then
                    If fc.Count <> 0 Then
                        Dim f As MapInfo.Data.Feature
                        Dim j As Integer = 0

                        If dt_temp.Columns.Count = 0 Then
                            For i = 0 To tbl.TableInfo.Columns.Count - 1
                                If tbl.TableInfo.Columns(i).DataType <> MapInfo.Data.MIDbType.FeatureGeometry And tbl.TableInfo.Columns(i).DataType <> MapInfo.Data.MIDbType.Style Then
                                    Dim dc As System.Data.DataColumn = dt_temp.Columns.Add(tbl.TableInfo.Columns(i).Alias)
                                End If
                            Next
                        End If

                        For Each f In fc
                            j = 0
                            Dim dr As System.Data.DataRow = dt_temp.NewRow()
                            For i = 0 To tbl.TableInfo.Columns.Count - 1
                                If tbl.TableInfo.Columns(i).DataType <> MapInfo.Data.MIDbType.FeatureGeometry And tbl.TableInfo.Columns(i).DataType <> MapInfo.Data.MIDbType.Style Then
                                    dr(j) = f(i).ToString()
                                    j = j + 1
                                End If
                            Next
                            dt_temp.Rows.Add(dr)
                        Next
                    End If
                    dataTab.Merge(dt_temp)
                End If
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try
        Next

        Try
            Dim ClipText As String = String.Empty
            Dim ClipRow As String = String.Empty

            'Header row
            For Each Col As DataColumn In dataTab.Columns
                If Not String.IsNullOrEmpty(ClipRow) Then
                    ClipRow += ControlChars.Tab
                End If
                ClipRow += Col.ColumnName
            Next

            ClipText += ClipRow + ControlChars.NewLine
            'Data rows
            For Each row As DataRow In dataTab.Rows
                ClipRow = String.Empty
                For Each col As DataColumn In dataTab.Columns
                    If Not String.IsNullOrEmpty(ClipRow) Then
                        ClipRow += ControlChars.Tab
                    End If
                    ClipRow += row(col.ColumnName)
                Next
                ClipText += ClipRow + ControlChars.NewLine
            Next
            Clipboard.SetText(ClipText)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

