                'style
                'Dim MyStyle1 As MapInfo.Styles.CompositeStyle = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.FontPointStyle(34, New MapInfo.Styles.Font("MapInfo 3.0 Compatible", 40), 0, Color.Red, 30))
