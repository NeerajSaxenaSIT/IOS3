    Private Sub tglBtnNSRefresh_ChangeToggleState(sender As Object, e As EventArgs)
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Try
            tglBtnNSRefresh.ChangeToggleState()
            If tglBtnNSRefresh.ToggleState = CheckState.Checked Then
                timerCountdown.Enabled = True
                tglBtnNSRefresh.Text = "Stop"
                timeMonitor = TimeSerial(0, CInt(SpinEditNSRefreshMode.Value), 0)
                timerCountdown.Start()
            Else
                timeMonitor = TimeSerial(0, 0, 0)
                tglBtnNSRefresh.Text = "Start"
                timerCountdown.Stop()
                timerCountdown.Enabled = False
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub timerCountdown_Tick(sender As Object, e As EventArgs) Handles timerCountdown.Tick
        Try
            If timeMonitor.Hour + timeMonitor.Minute + timeMonitor.Second > 0 Then
                timeMonitor = DateAdd(DateInterval.Second, -1, timeMonitor)
                tglBtnNSRefresh.Text = timeMonitor.ToString("HH:mm:ss")
            Else
                timeMonitor = TimeSerial(0, CInt(SpinEditNSRefreshMode.Value), 0)
                tglBtnNSRefresh.Text = "REFRESHING"
                Application.DoEvents()
                GetNetworkState()
            End If
        Catch
        End Try
    End Sub

