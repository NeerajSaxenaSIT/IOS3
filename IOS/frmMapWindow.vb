    Private Sub LoadKpiCounterMappingData()
        Dim objFilter As String = Nothing
        For Each obj As String In kpiInfo_Selected_Cells
            objFilter = objFilter & "''" & obj & "'',"
        Next
        objFilter = objFilter.TrimEnd(",")

        Dim kpiCounter As String = IIf(rdoKpSelKpi.Checked, "KPI", "Counter")
        Dim tech As String = tlKpiSelection.GetAllCheckedNodes().Where(Function(nd) nd.Level = 3)(0).Tag
        Dim kpiCounterID As String = tlKpiSelection.GetAllCheckedNodes().Where(Function(nd) nd.Level = 3)(0)("ObjectID")
        kpiCounterName = tlKpiSelection.GetAllCheckedNodes().Where(Function(nd) nd.Level = 3)(0)("ObjectName")
        Dim objectType As String = tlKpiSelection.GetAllCheckedNodes().Where(Function(nd) nd.Level = 3)(0)("ObjectType")
        Dim kpiFilter As String = ""

        For iCntr = 0 To gvKpiSelFilter.RowCount - 1
            kpiFilter = kpiFilter & " And " & gvKpiSelFilter.GetRowCellValue(iCntr, "Dimension") & " " & gvKpiSelFilter.GetRowCellValue(iCntr, "Operator") & " " & gvKpiSelFilter.GetRowCellValue(iCntr, "Value") & " And "
        Next
        If kpiFilter <> "" Then
            kpiFilter = kpiFilter.Substring(0, kpiFilter.Length - 4)
        End If

        Dim strConnection As String = Nothing
        Dim sqlParam As String = Nothing
        Dim parray()() As String = {
            New String() {"@KPIorCounter", Chr(39) & kpiCounter & Chr(39)},
            New String() {"@KPIID", kpiCounterID},
            New String() {"@Interval", Chr(39) & IIf(chkEditKpiSelHour.Checked, "HOUR", "DAY") & Chr(39)},
            New String() {"@startdate", Chr(39) & CalendarKpiSelection.SelectionStart.ToString("yyyyMMdd") & Chr(39)},
            New String() {"@ObjectFilter", Chr(39) & objFilter & Chr(39)},
            New String() {"@KPIFilter", IIf(kpiFilter = "", "NULL", Chr(39) & kpiFilter & Chr(39))}
        }

        strConnection = GetSQL(7102, parray)(0)
        sqlParam = GetSQL(7102, parray)(1)
        dtKpiInfoData = DataAccessorODBC.GetDataTable(strConnection, sqlParam, iQryTimeOut)

        If dtKpiInfoData IsNot Nothing Then
            If kpiCounter = "KPI" Then
                dtKpiInfoData.TableName = "KPIMap_" & kpiCounterName
            Else
                dtKpiInfoData.TableName = "CounterMap_" & kpiCounterName
            End If

            MapKPICounterForDayHour(tech, objectType, kpiCounterName)
            Session.Current.Selections.DefaultSelection.Clear()
        Else
            SetStatus("No data found to map...")
        End If
    End Sub

