    Private Sub SetDriveTestFilterDataOptions(_dtId As String)
        Dim sbQuery As New System.Text.StringBuilder()

        sbQuery.AppendLine("Select SUM(a.SumScanner) As SumScanner,  SUM(a.SumUE) As SumUE, SUM(a.SumScanUE2G) As SumScanUE2G, SUM(a.SumScanUE3G) As SumScanUE3G, SUM(a.SumScanUE4G) As SumScanUE4G, SUM(a.SumEvents) As SumEvents, ")
        sbQuery.AppendLine("MIN(a.CampaignStart) as CampaignStart, MAX(a.CampaignStop) as CampaignStop From( ")
        sbQuery.AppendLine("Select 1 As GrpCol, (ISNULL([Samples_Scanner2G], 0) + ISNULL([Samples_Scanner3G], 0) + ISNULL([Samples_Scanner4G], 0)) As SumScanner, ")
        sbQuery.AppendLine("(ISNULL([Samples_UE2G],0) + ISNULL([Samples_UE3G],0) + ISNULL([Samples_UE4G],0)) As SumUE, ")
        sbQuery.AppendLine("(ISNULL([Samples_Scanner2G],0) + ISNULL([Samples_UE2G],0)) As SumScanUE2G, ")
        sbQuery.AppendLine("(ISNULL([Samples_Scanner3G],0) + ISNULL([Samples_UE3G],0)) As SumScanUE3G, ")
        sbQuery.AppendLine("(ISNULL([Samples_Scanner4G],0) + ISNULL([Samples_UE4G],0)) As SumScanUE4G, ")
        sbQuery.AppendLine("ISNULL([Samples_Events], 0) As SumEvents, CampaignStart, CampaignStop From IOS_DT.dbo.DT_List Where Dtid In (" & _dtId & ")) a Group By a.GrpCol ")

        Dim dt As DataTable = DataAccessorODBC.GetDataTable(conn_IOSDriveTestModule, sbQuery.ToString())
        If dt IsNot Nothing Then
            If dt.Rows.Count > 0 Then
                If dt.Rows(0)("SumScanner") > 0 Then
                    rbScanner.Enabled = True
                    rbScanner.Checked = True
                Else
                    rbScanner.Enabled = False
                    rbScanner.Checked = False
                End If

                If dt.Rows(0)("SumUE") > 0 Then
                    rbUE.Enabled = True
                    rbUE.Checked = True
                Else
                    rbUE.Enabled = False
                    rbUE.Checked = False
                End If

                If dt.Rows(0)("SumScanUE2G") > 0 Then
                    ceTech2G.Enabled = True
                    ceTech2G.Checked = True
                Else
                    ceTech2G.Enabled = False
                    ceTech2G.Checked = False
                End If

                If dt.Rows(0)("SumScanUE3G") > 0 Then
                    ceTech3G.Enabled = True
                    ceTech3G.Checked = True
                Else
                    ceTech3G.Enabled = False
                    ceTech3G.Checked = False
                End If

                If dt.Rows(0)("SumScanUE4G") > 0 Then
                    ceTech4G.Enabled = True
                    ceTech4G.Checked = True
                Else
                    ceTech4G.Enabled = False
                    ceTech4G.Checked = False
                End If

                If dt.Rows(0)("SumEvents") > 0 Then
                    btnGetEvents.Enabled = True
                Else
                    btnGetEvents.Enabled = False
                End If
                DTPickerStart.EditValue = dt.Rows(0)("CampaignStart")
                DTPickerStop.EditValue = dt.Rows(0)("CampaignStop")
            End If
        End If
    End Sub

    Private Sub tvDriveTest_FocusedNodeChanged(sender As Object, e As FocusedNodeChangedEventArgs)
        Try
            If e.Node Is Nothing Then Exit Sub
            If (e.Node.CheckState = CheckState.Unchecked) Then
                If e.Node.Nodes.Count = 0 AndAlso e.Node.Tag IsNot Nothing Then
                    e.Node.Checked = True
                    tvDriveTest_AfterCheckNode(Nothing, New NodeEventArgs(e.Node))
                End If
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

    Private Sub tvDriveTest_AfterCheckNode(sender As Object, e As NodeEventArgs) Handles tvDriveTest.AfterCheckNode
        Try
            tvDriveTest.Cursor = Cursors.WaitCursor
            Application.DoEvents()
            Dim _dtId As String = ""
            e.Node.Selected = e.Node.CheckState
            cellEvent = ""

            For Each nd As TreeListNode In tvDriveTest.GetAllCheckedNodes().Where(Function(x) x.Nodes.Count = 0).ToList()
                _dtId &= nd.Tag.ToString() & ","
                cellEvent &= "'" & nd.Tag.ToString() & "',"
                UpdateDriveTestStats(nd.Tag.ToString())
            Next

            _dtId = _dtId.TrimEnd(",")
            SetDriveTestFilterDataOptions(_dtId)

            If Not (String.IsNullOrEmpty(cellEvent)) Then
                cellEvent = cellEvent.TrimEnd(",")
            End If
            SetDateTimeAndCoordinatesOnDriveTestSelection(cellEvent, conn_IOSDriveTestModule, False)
            SetDriveTestFilterDataOptions(cellEvent)

        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        Finally
            tvDriveTest.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

