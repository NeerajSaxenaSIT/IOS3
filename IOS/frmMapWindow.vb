    Public Function CreateTabWithGridViewForMapData(ByVal tabName As String) As DevExpress.XtraGrid.GridControl
        'Create a New Tab
        Dim vTabp As New DevExpress.XtraTab.XtraTabPage()
        vTabp.Text = tabName
        vTabp.Tag = tabName.Replace(" ", "_")
        vTabp.Name = tabName.Replace(" ", "_")
        vTabp.Padding = New Padding(3, 3, 3, 3)
        vtcMapGridTable.ClosePageButtonShowMode = DevExpress.XtraTab.ClosePageButtonShowMode.InActiveTabPageHeader

        Dim IsTabAlready As Boolean = False
        Dim IsNewTab As Boolean = False

        Dim ExistingTab As DevExpress.XtraTab.XtraTabPage = Nothing
        If (vtcMapGridTable.TabPages.Count > 0) Then
            For Each pageTab As DevExpress.XtraTab.XtraTabPage In vtcMapGridTable.TabPages
                If (pageTab.Text = tabName) Then
                    IsTabAlready = True
                    ExistingTab = pageTab
                    Exit For
                End If
            Next
        End If

        If Not (IsTabAlready) Then
            vtcMapGridTable.TabPages.Add(vTabp)
            vtcMapGridTable.SelectedTabPage = vTabp
            IsNewTab = True
        End If

        'If create a Tab then craete a grid with in
        If (IsNewTab) Then
            Dim newGCMap As GridControl = New GridControl()
            newGCMap.Name = "gcMap_" & tabName.Replace(" ", "_")
            newGCMap.Dock = DockStyle.Fill

            Dim newGVMap As New DevExpress.XtraGrid.Views.Grid.GridView()
            newGCMap.MainView = newGVMap
            newGVMap.GridControl = newGCMap
            newGCMap.ViewCollection.AddRange(New DevExpress.XtraGrid.Views.Base.BaseView() {newGVMap})

            newGVMap.Name = "gvMap_" & tabName.Replace(" ", "_")
            newGVMap.Tag = tabName.Replace(" ", "_")
            newGCMap.ForceInitialize()

            newGVMap.OptionsView.ShowGroupPanel = False
            newGVMap.OptionsBehavior.Editable = False
            newGVMap.OptionsBehavior.AllowAddRows = DevExpress.Utils.DefaultBoolean.False
            newGVMap.OptionsBehavior.AllowDeleteRows = DevExpress.Utils.DefaultBoolean.False
            newGVMap.OptionsView.ColumnAutoWidth = False
            newGVMap.OptionsSelection.MultiSelect = True
            newGVMap.BestFitColumns()

            AddHandler newGVMap.RowCellClick, AddressOf MapGridTable_RowCellClick
            AddHandler newGVMap.DoubleClick, AddressOf MapGridTable_DoubleClick
            AddHandler newGVMap.RowClick, AddressOf MapGridTable_RowClick
            AddHandler newGCMap.MouseDoubleClick, AddressOf MapGridTable_MouseDoubleClick
            AddHandler newGVMap.KeyDown, AddressOf MapGridTable_KeyDown
            vtcMapGridTable.TabPages.Item(vtcMapGridTable.TabPages.Count - 1).Controls.Add(newGCMap)
            vtcMapGridTable.TabIndex = vtcMapGridTable.TabPages().Count()
            Return newGCMap
        Else
            Dim newGCMap As GridControl = Nothing
            If (ExistingTab IsNot Nothing) Then
                newGCMap = TryCast(ExistingTab.Controls(0), GridControl)
                newGCMap.DataSource = Nothing
            End If
            Return newGCMap
        End If
    End Function

    Public Function GridView_Map_Col2Index(ByRef dgv As DevExpress.XtraGrid.Views.Grid.GridView, ByVal colname As String) As Integer
        For Each chi As DevExpress.XtraGrid.Columns.GridColumn In dgv.Columns
