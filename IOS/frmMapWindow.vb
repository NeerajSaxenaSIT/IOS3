    Private Sub btnFreqCalc_Click(sender As Object, e As EventArgs) Handles btnFreqCalc.Click
        'construct strings
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        'SQLREPLACE
        Try
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            Dim icells As String = "IN ("
            For Each lvi As ListViewItem In ListViewFreq.Items
                icells = icells + Chr(39) + lvi.Text + "',"
            Next
            icells = icells.TrimEnd(",") + ")"

            Dim parray()() As String = {New String() {"@objects1", "= " & Chr(39) & txtFreqTargetCell.Text.Trim & Chr(39)}, New String() {"@objects2", icells}}

            'Vendor2g1 Query
            Dim strOSS As String = GetSQL(1011, parray)(0)
            Dim sql_oss As String = GetSQL(1011, parray)(1)
            Dim ds_oss_vendor1 As DataTable = DataAccessorODBC.GetDataTable(strOSS, sql_oss, iQryTimeOut)
            Dim ds_oss_vendor1_hasdata As Boolean = False

            If ds_oss_vendor1 Is Nothing Then
                SetStatus("No data retrieved")  ' from " & strOSS
            ElseIf ds_oss_vendor1.Rows.Count = 0 Then
                SetStatus("No data retrieved")  ' from " & strOSS
            Else
                ds_oss_vendor1_hasdata = True
            End If

            'For Each dc As DataColumn In ds_oss_vendor1.Columns
            '    Console.WriteLine(dc.ColumnName & ":" & dc.DataType.ToString)
            'Next

            'Vendor2g3 Query
            Dim strOSS2 As String = GetSQL(20060, parray)(0)
            Dim sql_oss2 As String = GetSQL(20060, parray)(1)
            Dim ds_oss_vendor2 As DataTable = DataAccessorODBC.GetDataTable(strOSS2, sql_oss2, iQryTimeOut)
            Dim ds_oss_vendor2_hasdata As Boolean = False

            If ds_oss_vendor2 Is Nothing Then
                SetStatus("No data retrieved")  ' from " & strOSS2
            ElseIf ds_oss_vendor2.Rows.Count = 0 Then
                SetStatus("No data retrieved")  ' from " & strOSS2
            Else
                ds_oss_vendor2_hasdata = True
            End If

            'Vendor2g3 Query
            Dim strOSS3 As String = GetSQL(9060, parray)(0)
            Dim sql_oss3 As String = GetSQL(9060, parray)(1)
            Dim ds_oss_vendor3 As DataTable = DataAccessorODBC.GetDataTable(strOSS3, sql_oss3, iQryTimeOut)
            Dim ds_oss_vendor3_hasdata As Boolean = False

            If ds_oss_vendor3 Is Nothing Then
                SetStatus("No data retrieved")  ' from " & strOSS3
            ElseIf ds_oss_vendor3.Rows.Count = 0 Then
                SetStatus("No data retrieved")  ' from " & strOSS3
            Else
                ds_oss_vendor3_hasdata = True
            End If

            'For Each dc As DataColumn In ds_oss_vendor2.Columns
            '    Console.WriteLine(dc.ColumnName & ":" & dc.DataType.ToString)
            'Next

            'merging vendors
            Dim ds_oss As DataTable = Nothing
            If ds_oss_vendor1_hasdata And ds_oss_vendor2_hasdata And ds_oss_vendor3_hasdata Then
                ds_oss_vendor1.Merge(ds_oss_vendor2)
                ds_oss_vendor1.Merge(ds_oss_vendor3)
                ds_oss = ds_oss_vendor1
            ElseIf ds_oss_vendor1_hasdata And ds_oss_vendor2_hasdata Then
                ds_oss_vendor1.Merge(ds_oss_vendor2)
                ds_oss = ds_oss_vendor1
            ElseIf ds_oss_vendor1_hasdata And ds_oss_vendor3_hasdata Then
                ds_oss_vendor1.Merge(ds_oss_vendor3)
                ds_oss = ds_oss_vendor1
            ElseIf ds_oss_vendor2_hasdata And ds_oss_vendor3_hasdata Then
                ds_oss_vendor2.Merge(ds_oss_vendor3)
                ds_oss = ds_oss_vendor2
            ElseIf ds_oss_vendor1_hasdata Then
                ds_oss = ds_oss_vendor1
            ElseIf ds_oss_vendor2_hasdata Then
                ds_oss = ds_oss_vendor2
            ElseIf ds_oss_vendor3_hasdata Then
                ds_oss = ds_oss_vendor3
            Else
                Exit Sub
            End If

            'get frequency from ios frequency table

            'Dim strIOS As String = "Dsn=IOS_Server;uid=IOS;pwd=IOS"
            ''Dim sql_freq As String = "SELECT * FROM IOS_Frequencies WHERE TECH = '2G' ORDER BY ARFCN"
            Dim dt_freq As DataTable = clsSQLCommands.Get2GFrequencies(connStrIOSServer)

            If dt_freq Is Nothing Then
                SetStatus("No data retrieved from " & connStrIOSServer)
                Exit Sub
            End If

            If dt_freq.Rows.Count = 0 Then
                SetStatus("No data retrieved from " & connStrIOSServer)
                Exit Sub
            End If

            'construct final table
            '------------------

            'add column to ds_freq
            dt_freq.Columns.Add("Occurence")
            dt_freq.Columns.Add("Used By")

            'for each freq, count occurences in ds_oss and add to table
            Dim occ As Integer = 0
            Dim freq As String = ""
            Dim used_by As String = ""
            For Each row_freq As DataRow In dt_freq.Rows
                freq = row_freq("ARFCN").ToString
                For Each row_used As DataRow In ds_oss.Rows
                    If freq = row_used("ARFCN").ToString Then
                        occ = occ + 1
                        used_by = used_by + row_used("Reason") + ", "
                    End If
                Next
                used_by = used_by.TrimEnd(" ")
                used_by = used_by.TrimEnd(",")
                row_freq.BeginEdit()
                row_freq.Item("Occurence") = occ
                row_freq.Item("Used By") = used_by
                row_freq.EndEdit()
                occ = 0
                used_by = ""
            Next
            Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData(dt_freq.TableName)
            Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
            IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, dt_freq, "ALL")

            Dim lv_egsm As System.Windows.Forms.ListView = frmFreqChooser.ListViewFreqGSM
            Dim lv_dcs As System.Windows.Forms.ListView = frmFreqChooser.ListViewfreqDCS
            lv_egsm.Clear()
            lv_dcs.Clear()

            lv_egsm.Columns.Add("ARFCN", "ARFCN")
            lv_egsm.Columns.Add("Band", "Band")
            lv_egsm.Columns.Add("Usage", "Usage")
            lv_egsm.Columns.Add("Occurence", "Occurence")
            lv_egsm.Columns.Add("Used By", "Used By")

            lv_dcs.Columns.Add("ARFCN", "ARFCN")
            lv_dcs.Columns.Add("Band", "Band")
            lv_dcs.Columns.Add("Usage", "Usage")
            lv_dcs.Columns.Add("Occurence", "Occurence")
            lv_dcs.Columns.Add("Used By", "Used By")

            Dim lvitem As ListViewItem
            For Each drow As DataRow In dt_freq.Rows
                lvitem = New ListViewItem()
                lvitem.Text = drow.Item("ARFCN").ToString
                lvitem.SubItems.Add(drow.Item("Band").ToString)
                lvitem.SubItems.Add(drow.Item("Usage").ToString)
                lvitem.SubItems.Add(drow.Item("Occurence").ToString)
                lvitem.SubItems.Add(drow.Item("Used By").ToString)

                If drow.Item("Usage").ToString = "GUARD CHANNEL" Then
                    lvitem.BackColor = Color.Red
                End If

                If CInt(drow.Item("ARFCN").ToString) < 975 And CInt(drow.Item("ARFCN").ToString) > 124 Then
                    lv_dcs.Items.Add(lvitem)
                Else
                    lv_egsm.Items.Add(lvitem)
                End If
            Next
            frmFreqChooser.Show()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus("Error calculating frequencies..." & Chr(13) & ex.Message.ToString)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

