    Public Sub cmbNBFilter_Update(ByVal dcc As DataColumnCollection)
        Try
            Dim excludelist As New List(Of String)
            excludelist.Add("SCELL")
            excludelist.Add("SCELLNAME")
            excludelist.Add("TCELL")
            excludelist.Add("TCELLNAME")
            excludelist.Add("SLAC")
            excludelist.Add("STAC")
            excludelist.Add("TLAC")
            excludelist.Add("TTAC")
            excludelist.Add("NB_DEFINED")
            excludelist.Add("NB_TYPE")
            excludelist.Add("UARFCN_Source")
            excludelist.Add("EARFCN_Source")
            excludelist.Add("UARFCN_Target")
            excludelist.Add("EARFCN_Target")

            Dim currectselection As String = cmbNBFilter.Text
            cmbNBFilter.Properties.Items.Clear()

            For Each dc As DataColumn In dcc
                If Not cmbNBFilter.Properties.Items.Contains(dc.ColumnName.ToUpper) And Not excludelist.Contains(dc.ColumnName.ToUpper) Then
                    cmbNBFilter.Properties.Items.Add(dc.ColumnName.ToUpper)
                End If
            Next

            If cmbNBFilter.Properties.Items.IndexOf(currectselection) <> -1 Then
                cmbNBFilter.SelectedItem = cmbNBFilter.Properties.Items(cmbNBFilter.Properties.Items.IndexOf(currectselection))
            Else
                'cmbNBFilter.SelectedItem = cmbNBFilter.Properties.Items(0)
                cmbNBFilter.Text = cmbNBFilter.SelectedItem.ToString
            End If
        Catch ex As Exception

        End Try
    End Sub

    Private Sub btnNBArrows_Click(sender As Object, e As EventArgs) Handles btnNBArrows.Click
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            btnNBArrows.ChangeToggleState()
            If btnNBArrows.ToggleState = CheckState.Checked Then
                Layer_View("NB_Lines", True)
                btnNBArrows.Text = "Arrows"
                NBInfoArrowsDisplayed = True
            Else
                Layer_View("NB_Lines", False)
                btnNBArrows.Text = "No Arrows"
                NBInfoArrowsDisplayed = False
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub btnNBClear_Click(sender As Object, e As EventArgs) Handles btnNBClear.Click
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            Dim connection As New MIConnection
            connection.Open()

            'check existing plot/remove if there
            connection.Catalog.CloseTable("NB_Table")
            connection.Catalog.CloseTable("NB_Lines")
            connection.Catalog.CloseTable("Label_NB_Lines")
            connection.Catalog.CloseTable("NB_2G2G_Source")
            connection.Catalog.CloseTable("NB_2G2G_Target")
            connection.Catalog.CloseTable("NB_2G3G_Source")
            connection.Catalog.CloseTable("NB_2G3G_Target")
            connection.Catalog.CloseTable("NB_3G2G_Source")
            connection.Catalog.CloseTable("NB_3G2G_Target")
            connection.Catalog.CloseTable("NB_3G3G_Source")
            connection.Catalog.CloseTable("NB_3G3G_Target")

            connection.Close()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub track_NBFilterTopX_ValueChanged(sender As Object, e As EventArgs) Handles track_NBFilterTopX.ValueChanged
