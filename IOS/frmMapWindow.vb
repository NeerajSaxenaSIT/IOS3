            objMapHelper.RemoveLayer(tblname2g_agg)
            objMapHelper.CloseTable(tblname2g_agg)
            objMapHelper.RemoveLayer(tblname3g_agg)
            objMapHelper.CloseTable(tblname3g_agg)
            objMapHelper.RemoveLayer(tblname4g_agg)
            objMapHelper.CloseTable(tblname4g_agg)
            objMapHelper.RemoveLayer(tblname5g_agg)
            objMapHelper.CloseTable(tblname5g_agg)

            'Map 2G
            Dim dr_2G() As DataRow = dt.AsEnumerable().Where(Function(x) x.Field(Of String)("BAND") = "2G").ToArray()

            If dr_2G.Count > 0 Then
                Dim dStyle2G As Style = IOSStyleHelper.GetSytle(TableNames.CNE_RAW_Map_2G)
