    Private Sub tvDriveTest_NodeChanged(sender As Object, e As DevExpress.XtraTreeList.NodeChangedEventArgs)
        RemoveHandler tvDriveTest.NodeChanged, AddressOf tvDriveTest_NodeChanged
        If e.ChangeType = DevExpress.XtraTreeList.NodeChangeTypeEnum.CheckedState Then
            If e.Node.CheckState = CheckState.Checked Then
                e.Node.CheckAll()
            Else
                e.Node.UncheckAll()
            End If
            tvDriveTest.CheckParentNode(e.Node)
        End If
        AddHandler tvDriveTest.NodeChanged, AddressOf tvDriveTest_NodeChanged
    End Sub

