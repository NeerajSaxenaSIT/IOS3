    Private Sub SelectionWindowUpdate(ByRef irfc As IResultSetFeatureCollection, ByVal IsSelected As Boolean)
        Try
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Start SelectionWindowUpdate")
            Dim lvselection As LidorSystems.IntegralUI.Lists.TreeListView = dlgMappingSelection.tlvSelection
            If lvselection.Nodes.Count > 0 And irfc.Count > 0 And Layer_InMapConfiguration(irfc.BaseTable.Alias) Then
                If lvselection.Columns(0).HeaderText.ToString = "Cell ID" Then
                    Dim mireader As MIDataReader
                    mireader = irfc.Table.ExecuteReader
                    mireader.Read()
                    Dim tech As String = mireader.GetValue("TECHNOLOGY").ToString.Trim.ToUpper

                    If lvselection.Nodes(0).SubItems(1).Text.ToString.ToUpper <> tech.ToUpper Then
                        mireader.Close()
                        mireader.Dispose()
                        Exit Sub
                    End If
                    mireader.Close()
                    mireader.Dispose()
                Else
                    lvselection.Nodes.Clear()
                    lvselection.Columns.Clear()
                    dlgMappingSelection.tlvDetail.Columns.Clear()
                    dlgMappingSelection.tlvDetail.Nodes.Clear()
                End If
            End If

            If IsSelected = True And Layer_InMapConfiguration(irfc.BaseTable.Alias) Then
                Dim fc As IResultSetFeatureCollection = irfc

                Dim uniquecellfield As String = Layer_Column2Tree(irfc.BaseTable.Alias)
                If Layer_Column2Tree(irfc.BaseTable.Alias) Is Nothing Then
                    uniquecellfield = "CELLID"
                End If

                If Not fc Is Nothing And CheckColumn_MapinfoTable(fc.Table, uniquecellfield) Then
                    Dim mireader As MIDataReader
                    mireader = fc.Table.ExecuteReader
                    'lvselection.Items.Clear()
                    lvselection.Columns.Clear()
                    Dim tlvc As TreeListViewColumn

                    If uniquecellfield.ToUpper = "LINKNAME" Then
                        tlvc = New TreeListViewColumn("Link Name", "")
                        tlvc.Width = 60
                    Else
                        tlvc = New TreeListViewColumn("Cell ID", "")
                        tlvc.Width = 50
                    End If
                    lvselection.Columns.Add(tlvc)

                    Dim tlvc1 As TreeListViewColumn = New TreeListViewColumn("Tech", "")
                    tlvc.Width = 40
                    lvselection.Columns.Add(tlvc1)

                    Dim tlvc2 As TreeListViewColumn = New TreeListViewColumn("Sector Type", "")
                    tlvc.Width = 60
                    lvselection.Columns.Add(tlvc2)

                    Dim tlvc3 As TreeListViewColumn = New TreeListViewColumn("Source Table", "")
                    'tlvc.Width = 60
                    lvselection.Columns.Add(tlvc3)

                    Dim objstring As String = Nothing
                    Dim objSubString As String = Nothing
                    Dim objStringCellID As String = Nothing
                    Dim objStringLinkName As String = Nothing
                    Dim objStringIOSCellGID As String = Nothing
                    Dim objStringUniqueField As String = Nothing
                    Dim tech As String = Nothing
                    Dim sectortype As String = Nothing

                    If dlgMappingSelection.Visible Or cellFootPrintSelectedType = CellFootPrintType.Scanner Or cellFootPrintSelectedType = CellFootPrintType.UE Or cellFootPrintSelectedType = CellFootPrintType.CNE Then

                        While mireader.Read
                            tech = mireader.GetValue("TECHNOLOGY").ToString.Trim

                            If dlgMappingSelection.Visible Then
                                lvselection.Sorting = SortOrder.Ascending
                                lvselection.ComparerObjectType = ComparerObjectType.String

                                Dim lvitem As New TreeListViewNode(mireader.GetValue(uniquecellfield).ToString.Trim)
                                lvitem.SortTag = mireader.GetValue(uniquecellfield).ToString.Trim
                                Dim si1 As TreeListViewSubItem = New TreeListViewSubItem(mireader.GetValue(uniquecellfield).ToString.Trim)
                                si1.SortTag = mireader.GetValue(uniquecellfield).ToString.Trim
                                'Dim si2 As TreeListViewSubItem = New TreeListViewSubItem(mireader.GetValue("TECHNOLOGY").ToString.Trim)
                                Dim si2 As TreeListViewSubItem = New TreeListViewSubItem(tech)
                                Dim si3 As TreeListViewSubItem

                                If tech.ToUpper.Contains("TX") Then
                                    si3 = New TreeListViewSubItem("")
                                Else
                                    si3 = New TreeListViewSubItem(mireader.GetValue("SECTORTYPE").ToString.Trim)
                                End If

                                Dim si4 As TreeListViewSubItem = New TreeListViewSubItem(irfc.BaseTable.Alias)

                                lvitem.SubItems.Add(si1)
                                lvitem.SubItems.Add(si2)
                                lvitem.SubItems.Add(si3)
                                lvitem.SubItems.Add(si4)

                                lvselection.Nodes.Add(lvitem)
                            End If
                            If Not tech.ToUpper.Contains("TX") Then
                                sectortype = mireader.GetValue("SECTORTYPE").ToString.Trim
                            End If
                            objstring = objstring & Chr(39) & mireader.GetValue(uniquecellfield).ToString.Trim & Chr(39) & ","
                            If tech.ToUpper.Contains("TX") Then
                                objStringCellID = objStringCellID & Chr(39) & mireader.GetValue("LINKNAME").ToString.Trim & Chr(39) & ","
                            Else
                                objStringCellID = objStringCellID & Chr(39) & mireader.GetValue("CELLID").ToString.Trim & Chr(39) & ","
                            End If

                            If tech.ToUpper.Contains("4G") Then

                                objSubString = objSubString & Chr(39) & mireader.GetValue("TAC").ToString.Trim & Chr(39) & ","
                            ElseIf tech.ToUpper.Contains("3G") Then

                                objSubString = objSubString & Chr(39) & mireader.GetValue("LAC").ToString.Trim & Chr(39) & ","
                            ElseIf tech.ToUpper.Contains("2G") Then

                                objSubString = objSubString & Chr(39) & mireader.GetValue("LAC").ToString.Trim & Chr(39) & ","
                            ElseIf tech.ToUpper.Contains("5G") Then

                                objSubString = objSubString & Chr(39) & mireader.GetValue("TAC").ToString.Trim & Chr(39) & ","
                            ElseIf tech.ToUpper.Contains("TX") Then

                                objSubString = objSubString & Chr(39) & mireader.GetValue("maxPacketLinkCapacity").ToString.Trim & Chr(39) & ","
                            ElseIf tech.ToUpper.Contains("TRANSPORT") Then
                                'TODO
                                objSubString = objSubString & Chr(39) & mireader.GetValue("").ToString.Trim & Chr(39) & ","
                            End If

                            Try
                                objStringIOSCellGID = objStringIOSCellGID & Chr(39) & mireader.GetValue("IOS_CELL_GID").ToString.Trim & Chr(39) & ","
                            Catch ex As Exception
                            End Try

                            If tech.ToUpper.Contains("TX") Then
                                Try
                                    objStringUniqueField = objStringUniqueField & Chr(39) & mireader.GetValue("LINKNAME").ToString.Trim & Chr(39) & ","
                                Catch ex As Exception
                                End Try
                            Else
                                Try
                                    objStringUniqueField = objStringUniqueField & Chr(39) & mireader.GetValue("CELLNAME").ToString.Trim & Chr(39) & ","
                                Catch ex As Exception
                                End Try
                            End If

                        End While
                        dlgMappingSelection.ListView_ColumnResize()

                        'launch create tree for all lvitems at once
                        If objstring IsNot Nothing Then
                            objstring = objstring.TrimEnd(",")
                        End If
                        If objStringCellID IsNot Nothing Then
                            objStringCellID = objStringCellID.TrimEnd(",")
                        End If
                        If objSubString IsNot Nothing Then
                            objSubString = objSubString.TrimEnd(",")
                        End If

                        If Not objStringIOSCellGID Is Nothing Then
                            objStringIOSCellGID = objStringIOSCellGID.TrimEnd(",")
                        End If

                        If Not objStringUniqueField Is Nothing Then
                            objStringUniqueField = objStringUniqueField.TrimEnd(",")
                        End If

                        If dlgMappingSelection.Visible Then
                            dlgMappingSelection.TreeListView_BuildFromMapSelection_New2(objstring, tech)
                        End If

                        'Get cell footprint if activated
                        'If ToolBarButton8.Pushed = True Then
                        '    CellFootPrint(MI_Connection_CF, objstring, sectortype)
                        'End If
                        If cellFootPrintSelectedType = CellFootPrintType.Scanner Or cellFootPrintSelectedType = CellFootPrintType.UE Then
                            CellFootPrint(objStringCellID, objSubString, sectortype, tech)
                        ElseIf cellFootPrintSelectedType = CellFootPrintType.CNE Then

                            'collect all ios_cell_gid from default selection (new method)
                            objStringIOSCellGID = ""
                            Try
                                For Each tbl In MapInfo.Engine.Session.Current.Catalog
                                    Dim fc1 As IResultSetFeatureCollection = Session.Current.Selections.DefaultSelection(tbl)
                                    If Not fc1 Is Nothing AndAlso fc1.Count <> 0 AndAlso Layer_InMapConfiguration(fc1.BaseTable.Alias) Then
                                        For Each f As Feature In fc1
                                            objStringIOSCellGID = objStringIOSCellGID & Chr(39) & f("IOS_CELL_GID").ToString.Trim & Chr(39) & ","
                                        Next
                                        objStringIOSCellGID = objStringIOSCellGID.TrimEnd(",")
                                    End If

                                Next
                            Catch

                            End Try

                            If Not objStringIOSCellGID Is Nothing Then
                                CNE_CellFootPrint(objStringIOSCellGID, "IOS_CELL_GID")
                            Else
                                CNE_CellFootPrint(objStringUniqueField, "CELLNAME")
                            End If
                        End If
                        mireader.Close()
                        mireader.Dispose()
                    End If

                Else
                    lvselection.Nodes.Clear()
                End If
            ElseIf IsSelected = True And Layer_InMapConfiguration(irfc.BaseTable.Alias) = False Then
                'Dim fc As IResultSetFeatureCollection = irfc
                'Dim mireader As MIDataReader
                'mireader = fc.Table.ExecuteReader
                'lvselection.Columns.Clear()
                'lvselection.Columns.Add(mireader.Columns(0).Alias, 50, HorizontalAlignment.Left)
                'lvselection.Columns.Add("SourceTable", 150, HorizontalAlignment.Left)


                'Dim objstring As String = Nothing
                'Dim tech As String = Nothing
                'Dim sectortype As String = Nothing
                'While mireader.Read
                'Dim lvitem As New ListViewItem(mireader.GetValue(0).ToString.Trim, 0)
                'lvitem.SubItems.Add(irfc.BaseTable.Alias)
                'lvselection.Items.Add(lvitem)
                'End While

                'launch create tree for all lvitems at once
                'objstring = objstring.Trim(",")
                'If frm_IOS_Mapping_Selection.Visible Then
                ' frm_IOS_Mapping_Selection.TreeListView_BuildFromMapSelection(objstring, tech)
                'End If

                'mireader.Close()
                'mireader.Dispose()
                'For Each col As ColumnHeader In lvselection.Columns
                ' col.AutoResize(ColumnHeaderAutoResizeStyle.ColumnContent)
                ' Next

            Else
                lvselection.Nodes.Clear()
                lvselection.Columns.Clear()
                dlgMappingSelection.tlvDetail.Nodes.Clear()
                dlgMappingSelection.tlvDetail.Columns.Clear()
                ' frm_IOS_Mapping_Selection.VComboBox1.DataSource = Nothing
                ' frm_IOS_Mapping_Selection.VComboBox1.Items.Clear()
                'frm_IOS_Mapping_Selection.VComboBox1.Text = ""
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

    Public Sub Default_SelectionChangedEvent(ByVal sender As Object, ByVal e As MapInfo.Engine.SelectionChangedEventArgs)
        Dim session As ISession = MapInfo.Engine.Session.Current
        statusIsSelected = e.Selected
        '' Used in tool used for multi selection
        Try
            If e.Selected = True Then
                'If e.Features.Columns.Equals("px") Then
                Dim item As ToolStripMenuItem = CType(tlb_ParcelSelector.DropDownItems(2), ToolStripMenuItem)
                If (e.Features.BaseTable.Alias.Contains("DT_Scan3G_Parallel") Or e.Features.BaseTable.Alias.Contains("DT_Scan4G_Parallel") Or e.Features.BaseTable.Alias = "DT_Scan2G_Parallel" Or
                    e.Features.BaseTable.Alias = "DT_UE2G_Parallel" Or e.Features.BaseTable.Alias.Contains("DT_UE3G_Parallel") Or e.Features.BaseTable.Alias.Contains("DT_UE4G_Parallel") Or
                    e.Features.BaseTable.Alias.Contains("DT_UE5G_Parallel") Or e.Features.BaseTable.Alias.Contains("DT_Scan5G_Parallel")) And item.Checked Then
                    'the drawing of the line can only happen if the selected object has px column (and py... it's assumed that px comes with py)
                    If Not e.Features.Columns("px") Is Nothing Then
                        ' we check if there are any features in the list
                        If e.Features.Count > 0 Then
                            'calling the procedure below, cleans up the LineSources table and creates a new one.
                            DT_CreateLineSourceTable(e.Features.BaseTable.Alias)
                            ' An MIDataReader is an method to read the content of a list of features
                            ' below procedure is meant to create all the lines for the features of the particular selection in a table
                            DT_CreateLineFeatures2(e.Features.BaseTable.Alias, e.Features)

                        End If
                    End If
                ElseIf e.Features.BaseTable.Alias.Contains("CNE_RAW") And item.Checked Then
                    If e.Features.Count > 0 Then
                        CNE_CreateLineSourceTable_RAW(e.Features.BaseTable.Alias)
                        CNE_CreateLineFeatures2_RAW(e.Features.BaseTable.Alias, e.Features)
                    End If
                ElseIf e.Features.BaseTable.Alias.StartsWith("CNE_") And e.Features.BaseTable.Alias.Contains("AGG") And item.Checked Then
                    If e.Features.Count > 0 Then
                        CNE_CreateLineSourceTable_AGG(e.Features.BaseTable.Alias)
                        CNE_CreateLineFeatures2_AGG(e.Features.BaseTable.Alias, e.Features)
                    End If

                ElseIf e.Features.BaseTable.Alias.Contains(frmEvent.eventMapLayerName) And item.Checked Then
                    If Not e.Features.Columns("x") Is Nothing Then

                        ' we check if there are any features in the list
                        If e.Features.Count > 0 Then

                            'calling the procedure below, cleans up the LineSources table and creates a new one.
                            DT_CreateLineSourceTable(e.Features.BaseTable.Alias)

                            ' An MIDataReader is an method to read the content of a list of features
                            ' below procedure is meant to create all the lines for the features of the particular selection in a table
                            DT_CreateLineFeatures2(e.Features.BaseTable.Alias, e.Features)

                        End If
                    End If
                ElseIf e.Features.BaseTable.Alias.Contains("AntennaTilt") And Not Application.OpenForms(frmTerrainProfile.Name) Is Nothing Then
                    'Exit Sub
                    Dim enumerator As IFeatureEnumerator = e.Features.GetFeatureEnumerator
                    Do While enumerator.MoveNext

                        Dim uniquemapfield As String = "CELL"
                        Dim cellid As String = enumerator.Current(uniquemapfield).ToString
                        Dim cellid_x As String = enumerator.Current("X").ToString
                        Dim cellid_y As String = enumerator.Current("Y").ToString
                        Dim cellid_az As Double = CDbl(enumerator.Current("AZIMUTH").ToString)
                        Dim cellid_rc As Double = CDbl(enumerator.Current("RADIATIONCENTER").ToString)
                        Dim cellid_electilt As Double = Nothing
                        Dim cellid_mechtilt As Double = Nothing
                        Dim antennatype As String = Nothing
                        cellid_electilt = CDbl(nEmpty(nZ(enumerator.Current("ELECTRICALTILT").ToString, 0), 0))
                        cellid_mechtilt = CDbl(nEmpty(nZ(enumerator.Current("MECHANICALTILT").ToString, 0), 0))
                        If CheckColumn_MapinfoTable(enumerator.Current.Table, "ANTENNATYPE") Then
                            antennatype = enumerator.Current("ANTENNATYPE").ToString
                        End If
                        If bInternetAvailable = True Then
                            Cell_AntennaTiltCoverage(CDbl(enumerator.Current("RECORDID")), cellid, cellid_x, cellid_y, antennatype, cellid_az, cellid_rc, cellid_electilt, cellid_mechtilt, CDbl(enumerator.Current("ELECTRICALTILT").ToString), CDbl(enumerator.Current("CLUTTER").ToString), 1)
                        End If
                    Loop
                    enumerator.Dispose()
                    '    MapInfo.Engine.Session.Current.Catalog.CloseTable(e.Features.BaseTable.Alias)

                Else
                    If e.Features.BaseTable.Alias = "DT_Events_GetEvents" Or e.Features.BaseTable.Alias = "DT_Events" Or e.Features.BaseTable.Alias = "DT_Events_Open" Then
                        _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Features BaseTable DT_Events_GetEvents")
                        If Not e.Features.Columns("x") Is Nothing Then
                            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Set Connection conn_IOSDriveTestModule")
                            frmEvent.SetConnectionString(conn_IOSDriveTestModule)
                            Dim mireader As MIDataReader
                            mireader = e.Features.Table.ExecuteReader

                            While mireader.Read
                                eventid = CInt(mireader.GetValue("EventID"))
                                DtId = CInt(mireader.GetValue("DTid"))
                            End While
                            mireader.Close()
                            mireader.Dispose()
                            If (dtEventFailurData IsNot Nothing) Then
                                _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Begin SetFailurData")
                                frmEvent.SetFailurData(dtEventFailurData)
                                tableAliasForEvent = e.Features.BaseTable.Alias
                                statusForEvent = True
                            End If
                            ' frmEvent.Show()
                            'Me.TopMost = False
                            'ShowEventForm()
                            'Application.DoEvents()
                        End If
                        _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "End Features BaseTable DT_Events_GetEvents")
                    End If
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        SelectionWindowUpdate(e.Features, e.Selected)
    End Sub

    Private Sub DT_CreateLineSourceTable(Optional ByVal techName As String = Nothing)
        Dim tblname As String = "Lines_SourceCells"
        Try
            'Create Temp layer

            'Dim techTable As String = e.Features.BaseTable.Alias
            Dim tblInfoTemp As New TableInfoMemTable(tblname)
            Dim tblTemp As Table = Session.Current.Catalog.GetTable(tblname)
            If IsNothing(tblTemp) = False Then 'Table exists close it
                Session.Current.Catalog.CloseTable(tblname)
            End If
            tblInfoTemp.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(MapControl1.Map.GetDisplayCoordSys()))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateStyleColumn())
            tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("ParcelID"))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("CellID", 5))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("Channel"))
            If (techName.Contains("DT_Scan4G_Parallel") Or techName.Contains("DT_UE4G_Parallel")) Then
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("TAC"))
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RSRP"))
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RSRQ"))
            ElseIf (techName.Contains("DT_EventGrid")) Then
                If (EventTypeMapped = "lte") Then
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("TAC"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RSRP"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RSRQ"))
                ElseIf (EventTypeMapped = "nr") Then
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("TAC"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RSRP"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RSRQ"))
                ElseIf (EventTypeMapped = "umts") Then
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("LAC"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RSCP"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("ECNO"))
                Else
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("LAC"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("BCCH"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("NCC"))
                    tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("BCC"))
                End If
            ElseIf (techName.Contains("DT_Scan3G_Parallel") Or techName.Contains("DT_UE3G_Parallel")) Then
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("LAC"))
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RSCP"))
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("EcNo"))
            ElseIf (techName.Contains("DT_Scan2G_Parallel") Or techName.Contains("DT_UE2G_Parallel")) Then
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("LAC"))
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RxLev"))
                tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("RxQual"))
            End If

            tblTemp = Session.Current.Catalog.CreateTable(tblInfoTemp)
