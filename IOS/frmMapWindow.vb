    Private Sub CNE_CreateThematic(ByVal item As clsComboBoxItem, Optional ByVal LayerName As String = "")
        Dim dtCNEThematicsRes As DataTable = dtCNEThematics.AsEnumerable().Where(Function(x) x.Field(Of Integer)("ThematicID") = item.Value.ToString And x.Field(Of String)("ThematicField") = item.Text).CopyToDataTable()

        Dim countOfBins As Integer = dtCNEThematicsRes.Rows.Count()
        For Each ml As IMapLayer In MapControl1.Map.Layers.GetMapLayerEnumerator()
            Try
                If TypeOf ml Is FeatureLayer Then
