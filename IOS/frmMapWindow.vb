    Private Sub ManageDTLayerOnClick()
        For Each tbl As MapInfo.Data.Table In Session.Current.Catalog
            If Not tbl.TableInfo Is Nothing Then
                If ((rbScanner.Checked AndAlso tbl.Alias.Contains("DT_Scan")) Or (rbUE.Checked AndAlso tbl.Alias.Contains("DT_UE"))) Then
                    objMapHelper.CloseTable(tbl.Alias)
                    objMapHelper.RemoveLayer(tbl.Alias)
                End If
            End If
        Next
    End Sub

    Private Sub DT_Scan2GRadio(ByVal str As String)
        Try
            If (ceTech2G.Checked) Then
                Dim sql As String
                If Not IsWithCordinates() Then
                    sql = "SELECT * FROM dbo.DT_Scan2G_Parallel where TimeStamp between ? and ? and DtID in(" & cellEvent & ")"
                Else
                    sql = "SELECT * FROM dbo.DT_Scan2G_Parallel where TimeStamp between ? and ? and DtID in(" & cellEvent & ") and (px >= ? and py >= ?) and (px <= ? and py <= ?)"
                End If

                Dim dStyle As Style = IOSStyleHelper.GetSytle(TableNames.DT_Scan2G_Parallel)
                Dim objAdoTableInfo As New IOSTableInfoAdoNet("DT_Scan2G_Parallel", str, sql, dStyle, "PX", "PY")
                objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoTableInfo, GetRadioParameters())
                If (ApplyHavingSettings(objAdoTableInfo.OutLayer)) Then
                    DT_CreateThematics(objAdoTableInfo.OutLayer, "Best RxLevAvg", "Scan 2G Radio", "RxLevAvg")
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message.ToString)
        End Try
    End Sub

    Private Sub DT_Scan3GRadio(ByVal connStr As String)
        Try
            If (ceTech3G.Checked) Then
                Dim q As String
                If Not IsWithCordinates() Then
                    q = "SELECT distinct UARFCN FROM dbo.DT_Scan3G_Parallel where TimeStamp between ? and ? and DtID in(" & cellEvent & ")"
                Else
                    q = "SELECT distinct UARFCN FROM dbo.DT_Scan3G_Parallel where TimeStamp between ? and ? and DtID in(" & cellEvent & ") and (px >= ? and py >= ?) and (px <= ? and py <= ?)"
                End If
                Dim channels As DataSet = DataAccessorODBC.GetDataSet(connStr, q, GetRadioParameters())
                If Not channels Is Nothing And channels.Tables.Count > 0 Then
                    For Each Item As DataRow In channels.Tables(0).Rows
                        Dim uarfcn As String = nZ(Item("UARFCN"), "0")
                        If Not uarfcn = "0" Then
                            tblname = "DT_Scan3G_Parallel_" & uarfcn
                            Dim sql As String
                            If Not IsWithCordinates() Then
                                sql = "SELECT * FROM dbo.DT_Scan3G_Parallel where TimeStamp between ? and ?  and DtID in(" & cellEvent & ") and UARFCN=?"
                            Else
                                sql = "SELECT * FROM dbo.DT_Scan3G_Parallel where TimeStamp between ? and ?  and DtID in(" & cellEvent & ") and (px >= ? and py >= ?) and (px <= ? and py <= ?) and UARFCN=?"
                            End If

                            Dim dStyle As Style = IOSStyleHelper.GetSytle(TableNames.DT_Scan3G_Parallel)
                            Dim objAdoTableInfo As New IOSTableInfoAdoNet(tblname, connStr, sql, dStyle, "PX", "PY")
                            Dim parameters As List(Of Odbc.OdbcParameter) = GetRadioParameters()
                            Dim pUARFCN As New Odbc.OdbcParameter("@uarfcn", Odbc.OdbcType.NVarChar)
                            pUARFCN.Value = uarfcn
                            parameters.Add(pUARFCN)
                            objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoTableInfo, parameters)
                            'Dim objTableInfoServer As New IOSTableInfoServer(tblname, str, "SELECT * FROM dbo.DT_Scan3G_Parallel where UARFCN='" & uarfcn & "' AND TimeStamp between '" & DTPickerStart.Value & "' and '" & DTPickerStop.Value & "'and DtID in(" & cellEvent & ")")
                            'objMapHelper.CreateMapLayerUsingServerTableInfo(objTableInfoServer)
                            If (ApplyHavingSettings(objAdoTableInfo.OutLayer)) Then
                                DT_CreateThematics(objAdoTableInfo.OutLayer, "Best RSCP", "Scan 3G Radio for " + uarfcn, "RSCP")
                                DT_CreateThematics(objAdoTableInfo.OutLayer, "Best EcNo", "Scan 3G Radio for " + uarfcn, "EcNo")
                                DT_CreateThematics(objAdoTableInfo.OutLayer, "Pilot Pollution", "Scan 3G Radio for " + uarfcn, "Pilot Pollution")
                            End If
                            ToolStripProgressBar1.Value += (50 / channels.Tables(0).Rows.Count)
                            'Application.DoEvents()
                        End If
                    Next
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message.ToString)
        End Try
    End Sub

    Private Sub DT_Scan4GRadio(ByVal connStr As String)
        Try
            If (ceTech4G.Checked) Then
                Dim query As String
                If Not IsWithCordinates() Then
                    query = "SELECT distinct EARFCN FROM dbo.DT_Scan4G_Parallel where TimeStamp between ? and ? and DtID in(" & cellEvent & ")"
                Else
                    query = "SELECT distinct EARFCN FROM dbo.DT_Scan4G_Parallel where TimeStamp between ? and ? and DtID in(" & cellEvent & ") and (px >= ? and py >= ?) and (px <= ? and py <= ?)"
                End If
                Dim channels As DataSet = DataAccessorODBC.GetDataSet(connStr, query, GetRadioParameters())
                If Not channels Is Nothing And channels.Tables.Count > 0 Then
                    For Each Item As DataRow In channels.Tables(0).Rows
