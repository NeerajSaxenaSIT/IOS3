    Private Sub CNE_CreateLineFeatures2_RAW(ByVal sourcetable As String, ByRef irfc As IResultSetFeatureCollection)
        Try
            'opening table and featurelayer for modifciation
            Dim tblTemp As Table = MapInfo.Engine.Session.Current.Catalog.GetTable("Lines_SourceCells_CNE_RAW")
            Dim lyr As FeatureLayer = MapControl1.Map.Layers("Lines_SourceCells_CNE_RAW")

            'depending on the selected object (read from the selected table name), different actions need to happen:
            If sourcetable.Contains("CNE_RAW") Then
                For Each ftr As Feature In irfc
                    Dim cellname As String = "IN(" & Chr(39) & CStr(ftr("CELLNAME").ToString) & Chr(39) & ")"
                    Dim IOS_CELL_GID As String = "IN(" & Chr(39) & CStr(ftr("IOS_CELL_GID").ToString) & Chr(39) & ")"


                    If Not tblTemp Is Nothing And Not lyr Is Nothing Then
                        Dim j As Integer = 1

                        Dim tbl_search As MapInfo.Data.Table = Cell_LAC_SearchAndReturnGeo3(cellname, "CELLNAME", "CNE_CellSearch")

                        If tbl_search Is Nothing Then
                            Continue For

                        Else
                            For Each ftr3 As Feature In tbl_search
                                'the below part we'll draw a line between two points. First point being the px, py of the feature itself.
                                'second point being the centroid of the searched CellID/LAC object on the map.

                                Dim dps(1) As MapInfo.Geometry.DPoint
                                ''dps(0) = CType(ftr("px"), MapInfo.Geometry.Point).Centroid
                                dps(0) = TransformPointWGS84ToDisplay(ftr.Geometry.Centroid)
                                dps(1) = TransformPointWGS84ToDisplay(ftr3.Geometry.Centroid)

                                'the creation of the lin based on 2 pts
                                Dim ln As FeatureGeometry = New MapInfo.Geometry.MultiCurve(lyr.CoordSys, CurveSegmentType.Linear, dps)

                                'now we add a style to the line. first by creating the style object. we are working with a line so we need a simplelinestyle
                                Dim lstyle As SimpleLineStyle = Nothing
                                lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 3, System.Drawing.Color.Black)
                                Dim cs As New CompositeStyle(lstyle)

                                ' a new feature is created and inserted based on the table definition set in tlb_ParcelSelector_Click
                                Dim ftr2 As New Feature(tblTemp.TableInfo.Columns)
                                ftr2.Geometry = ln
                                ftr2.Style = cs
                                ftr2.Item("ID") = ftr("ID")
                                ftr2.Item("CELLNAME") = ftr("CELLNAME")
                                tblTemp.InsertFeature(ftr2)
                                j = j + 1
                            Next
                            Session.Current.Catalog.CloseTable(tbl_search.Alias)
                        End If
                    End If
                Next
                ' irfc.Close()
                ' similar actions happen for the other tables.
            End If
            'for every line we want a tooltip to show up when user puts mouse cursor on it for 1 sec or longer.
            'the tooltip should show all data for that line.
            'this is achieved by calling "ColumnsInfoTip_MapinfoTable". this loops through th table to get all columns and tags for it and returns a string that is interpreted by mapxtreme for tooltip.
            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tblTemp))
        Catch ex As System.AccessViolationException
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message)
        End Try
    End Sub

    Private Sub CNE_CreateLineFeatures2_AGG(ByVal sourcetable As String, ByRef irfc As IResultSetFeatureCollection)
        Try
            'opening table and featurelayer for modifciation
            Dim tblTemp As Table = MapInfo.Engine.Session.Current.Catalog.GetTable("Lines_SourceCells_CNE_AGG")
            Dim lyr As FeatureLayer = MapControl1.Map.Layers("Lines_SourceCells_CNE_AGG")

            Dim sql_insert As String = Nothing
            Dim connstring As String = Nothing

            Dim NumOfLines As Int16 = 0

            'depending on the selected object (read from the selected table name), different actions need to happen:
            If sourcetable.StartsWith("CNE_") And sourcetable.Contains("AGG") Then
                For Each ftr As Feature In irfc
                    Dim GeoID As String = "IN(" & CStr(ftr("GeoID").ToString) & ")"
                    Dim iosgids As String = Nothing
                    Dim binres As Double = CoordSys.ConvertDistanceUnits(DistanceUnit.Meter, ftr.Geometry.Bounds.Width, DistanceUnit.Degree)
                    If binres < 150 Then
                        binres = 50
                    ElseIf binres < 500 Then
                        binres = 200
                    Else
                        binres = 1000
                    End If

                    'query geoid for active resolution, filter, area, period, returning table with geoid, ios_Cell_gid, cellname, tech

                    Dim ds_ParcelSelect As DataSet = CNE_GetData("GeoID " & GeoID, False, binres)



                    If Not tblTemp Is Nothing And Not lyr Is Nothing And Not ds_ParcelSelect Is Nothing Then

                        For Each dr As DataRow In ds_ParcelSelect.Tables(0).Rows
                            iosgids = iosgids & "'" & dr("IOS_CELL_GID") & "',"
                        Next
                        iosgids = "IN(" & iosgids.TrimEnd(",") & ")"


                        Dim j As Integer = 1

                        Dim tbl_search As MapInfo.Data.Table = Cell_LAC_SearchAndReturnGeo3(iosgids, "IOS_CELL_GID", "CNE_CellSearch")

                        If tbl_search Is Nothing Then
                            Continue For

                        Else
                            For Each ftr3 As Feature In tbl_search
                                'the below part we'll draw a line between two points. First point being the px, py of the feature itself.
                                'second point being the centroid of the searched CellID/LAC object on the map.

                                Dim dps(1) As MapInfo.Geometry.DPoint
                                ''dps(0) = CType(ftr("px"), MapInfo.Geometry.Point).Centroid
                                dps(0) = TransformPointWGS84ToDisplay(ftr.Geometry.Centroid)
                                dps(1) = TransformPointWGS84ToDisplay(ftr3.Geometry.Centroid)

                                'the creation of the lin based on 2 pts
                                Dim ln As FeatureGeometry = New MapInfo.Geometry.MultiCurve(lyr.CoordSys, CurveSegmentType.Linear, dps)

                                'now we add a style to the line. first by creating the style object. we are working with a line so we need a simplelinestyle
                                Dim lstyle As SimpleLineStyle = Nothing
                                lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 3, System.Drawing.Color.Black)
                                Dim cs As New CompositeStyle(lstyle)

                                ' a new feature is created and inserted based on the table definition set in tlb_ParcelSelector_Click
                                Dim ftr2 As New Feature(tblTemp.TableInfo.Columns)
                                ftr2.Geometry = ln
                                ftr2.Style = cs
                                ftr2.Item("GEOID") = ftr("GEOID")
                                ftr2.Item("IOS_CELL_GID") = ftr3("IOS_CELL_GID")
                                ftr2.Item("SampleCount") = ds_ParcelSelect.Tables(0).AsEnumerable().Where(Function(x) x.Field(Of String)("IOS_CELL_GID") = ftr3("IOS_CELL_GID")).ToArray()(0)("SampleCount")

                                tblTemp.InsertFeature(ftr2)
                                j = j + 1
                                NumOfLines = NumOfLines + 1
                            Next
                            Session.Current.Catalog.CloseTable(tbl_search.Alias)
                        End If
                    End If
                Next
                ' irfc.Close()
                ' similar actions happen for the other tables.
            End If



            Dim thm3 As New MapInfo.Mapping.Thematics.RangedTheme(lyr, "SampleCount", "SampleCount", Math.Min(NumOfLines, 3), DistributionMethod.EqualCountPerRange)
            thm3.ApplyStylePart = Thematics.StylePart.Color
            thm3.SpreadBy = SpreadByPart.None
            thm3.RoundBy = 0.01

            thm3.Recompute()

            If NumOfLines = 1 Or thm3.Bins.Count = 1 Then
                thm3.Bins(0).Style.LineStyle = New SimpleLineStyle(New LineWidth(1, 0), 2, Color.FromArgb(255, Color.Green), False)
            ElseIf NumOfLines = 2 Or thm3.Bins.Count = 2 Then
                thm3.Bins(1).Style.LineStyle = New SimpleLineStyle(New LineWidth(1, 0), 2, Color.FromArgb(255, Color.Green), False)
                thm3.Bins(0).Style.LineStyle = New SimpleLineStyle(New LineWidth(1, 0), 2, Color.FromArgb(255, Color.Yellow), False)
            Else
                thm3.Bins(2).Style.LineStyle = New SimpleLineStyle(New LineWidth(1, 0), 2, Color.FromArgb(255, Color.Green), False)
                thm3.Bins(1).Style.LineStyle = New SimpleLineStyle(New LineWidth(1, 0), 2, Color.FromArgb(255, Color.Yellow), False)
                thm3.Bins(0).Style.LineStyle = New SimpleLineStyle(New LineWidth(1, 0), 2, Color.FromArgb(255, Color.Red), False)
            End If

            thm3.Recompute()
            thm3.RecomputeBins()

            lyr.Modifiers.Append(thm3)

            thm3.Enabled = True
            Legend_CreateThematic(thm3, "SampleCount Per Cell", "SampleCount", lyr)

            'for every line we want a tooltip to show up when user puts mouse cursor on it for 1 sec or longer.
            'the tooltip should show all data for that line.
            'this is achieved by calling "ColumnsInfoTip_MapinfoTable". this loops through th table to get all columns and tags for it and returns a string that is interpreted by mapxtreme for tooltip.
            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tblTemp))
        Catch ex As System.AccessViolationException
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message)
        End Try
    End Sub

    Public Function Cell_LAC_SearchAndReturnGeo3(ByVal cell2search As String, ByVal FieldToSearch As String, ByVal DestinationTableName As String) As MapInfo.Data.Table
        If (cell2search = "In()") Then
            Return Nothing
        End If
        Dim connection As MIConnection = New MIConnection
        connection.Open()
        Try
            Dim found As Boolean = False
            Dim tbl As MapInfo.Data.Table
            Dim tbl_cells As MapInfo.Data.Table = Nothing
            Dim tbl_cells_name As String = DestinationTableName
            connection.Catalog.CloseTable(tbl_cells_name)
            'to find the cellid/lac object, we need to loop through all tables that can hold tha info.
            'this is configured on the IOS Server in the IOS_Map_Configuration.
            'and stored in the dt_Map_configuraton datatable
            'so, below code loops through all active layers if tlb_ParcelSelector is toggled.

            For Each drow As DataRow In dt_Map_Configuration.Rows
                Try
                    Dim itemSelect As ToolStripMenuItem = CType(tlb_ParcelSelector.DropDownItems(2), ToolStripMenuItem)
                    Dim itemHover As ToolStripMenuItem = CType(tlb_ParcelSelector.DropDownItems(1), ToolStripMenuItem)
                    If drow("LayerActive").ToString = True And (itemSelect.Checked Or itemHover.Checked) = True Then
                        tbl = Session.Current.Catalog.GetTable(drow("LayerName").ToString.Trim)
                        If Not tbl Is Nothing Then
                            'for the selected table, a search is executed to find matching CellID/LAC object

                            If MapControl1.Map.Layers(tbl.Alias).Enabled Then
                                Dim command As MICommand = connection.CreateCommand()
                                Dim irfc As IResultSetFeatureCollection

                                command.CommandText = "Select " & FieldToSearch & ", obj FROM  " & tbl.Alias & " WHERE " & FieldToSearch & " " & cell2search
                                irfc = command.ExecuteFeatureCollection()

                                If irfc.Count <> 0 Then
                                    If connection.Catalog.GetTable(tbl_cells_name) Is Nothing Then
                                        Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(tbl_cells_name, MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                                        tbl_cells = Session.Current.Catalog.CreateTable(ti_memtbl)
                                        tbl_cells.InsertFeatures(irfc)
                                    Else
                                        tbl_cells = Session.Current.Catalog.GetTable(tbl_cells_name)
                                        tbl_cells.InsertFeatures(irfc)
                                    End If
                                    command.Dispose()
                                End If
                                irfc.Close()
                            End If
                        End If
                    End If
                Catch ex As Exception
                    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                End Try
            Next

            Return tbl_cells
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            Return Nothing
        End Try
    End Function

