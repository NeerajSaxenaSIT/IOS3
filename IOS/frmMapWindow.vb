    Public Sub Mapcontrol_LoadRaster(ByVal fn As String, ByVal fsm_passed As FeatureStyleModifier)
        Try
            Dim MyTable As Table = Session.Current.Catalog.OpenTable(fn)
            Dim MyLayer As FeatureLayer = New FeatureLayer(MyTable)
            MapControl1.Map.Layers.Add(MyLayer)

            Dim IsGrey As Boolean = False
            For Each mitem As ToolStripMenuItem In tlb_Layer_GM.DropDownItems
                If mitem.Checked = True And mitem.Text.Contains("_Grey") Then
                    IsGrey = True
                End If
            Next

            If IsGrey = True Then
                Dim vs As MapInfo.Styles.RasterStyle = New RasterStyle(True, False, Color.AliceBlue, 128, 50, 50)
                Dim cs As MapInfo.Styles.CompositeStyle = New CompositeStyle(vs)
                Dim fsm As FeatureOverrideStyleModifier = New FeatureOverrideStyleModifier("TileMap_Style", "TileMap_Style", cs)
                MyLayer.Modifiers.Append(fsm)
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus("Mapcontrol_LoadRaster:  Problem Loading TileRaster" & Chr(13) & ex.Message)
        End Try
    End Sub

