            Map_StatusStrip.Visible = False
            ToolStripStatusLabel1.Text = ""
            ToolStripStatusLabel2.Text = ""
            ToolStripStatusLabel3.Text = ""
        ElseIf e.ToolName = "AddPoint" Then '' Add point is used for Distance
            Map_StatusStrip.Visible = True
            ToolStripProgressBar1.Visible = False
        ElseIf e.ToolName = "Distance" Then
            Map_StatusStrip.Visible = True
            ToolStripProgressBar1.Visible = False
        ElseIf e.ToolName = "SelectRect" Then

        ElseIf e.ToolName = "Select" And Not eventid = 0 And Not tableAliasForEvent = "" Then
            'This code is written here because we are not able to use frmEvent.Show() method on SelectionChanged event
            If Not frmEvent.Visible Then
                'statusForEvent is used to ensure that same method will not call second time.
                If statusForEvent Then
