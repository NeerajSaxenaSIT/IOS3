    Private Sub Cell_TA(ByVal ftr As Feature)


        Dim tech As String = ftr("TECHNOLOGY").ToString
        Dim uniquemapfield As String = "CELLID"
        Try
            Dim originaltable As String = ftr.Table.Alias.Substring(0, ftr.Table.Alias.IndexOf("_selection"))
            Dim field = Layer_Column2Tree(originaltable)
            If Not field Is Nothing Then
                uniquemapfield = field
            End If
        Catch ex As Exception

        End Try

        Dim cellid As String = ftr(uniquemapfield).ToString
        'Dim lac As String = ftr("LAC").ToString
        Dim cellid_x As String = ftr("X").ToString
        Dim cellid_y As String = ftr("Y").ToString
        Dim cellid_az As String = ftr("AZIMUTH").ToString


        'Dim startdate As Date = DateAdd(DateInterval.Day, -1 * TimAdvIntervalIndex, Now())
        'Dim enddate As Date = Now()

        Dim startdate_string As String = ""
        Dim enddate_string As String = ""
        If trafficDenStartDate = trafficDenEndDate Then
            startdate_string = Chr(39) & trafficDenStartDate.ToString("yyyyMMdd") & Chr(39)
            enddate_string = Chr(39) & trafficDenEndDate.AddDays(1).ToString("yyyyMMdd") & Chr(39)
        Else
            startdate_string = Chr(39) & trafficDenStartDate.ToString("yyyyMMdd") & Chr(39)
            enddate_string = Chr(39) & trafficDenEndDate.ToString("yyyyMMdd") & Chr(39)
        End If

        'query
        Dim parray()() As String = {
            New String() {"@cellid", "IN(" & Chr(39) & cellid & Chr(39) & ")"},
            New String() {"@startdate", startdate_string},
            New String() {"@enddate", enddate_string}}
        '   New String() {"@lac", Chr(39) & lac & Chr(39)}}

        Dim dtCellTA As System.Data.DataTable = Nothing
        dtCellTA = New System.Data.DataTable
        Dim tblname As String = Nothing
        cellid = System.Text.RegularExpressions.Regex.Replace(cellid, "[^\w]", "_")



        Select Case tech.ToUpper
            Case networkAll.Network2G1.ToUpper
                If GetSQL(1068, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(1068, parray)(0), GetSQL(1068, parray)(1), iQryTimeOut)
            Case networkAll.Network2G2.ToUpper
                If GetSQL(9068, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(9068, parray)(0), GetSQL(9068, parray)(1), iQryTimeOut)
            Case networkAll.Network2G3.ToUpper
                If GetSQL(20020, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(20020, parray)(0), GetSQL(20020, parray)(1), iQryTimeOut)
            Case networkAll.Network3G1.ToUpper
                If GetSQL(1069, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_PropDelay_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(1069, parray)(0), GetSQL(1069, parray)(1), iQryTimeOut)
            Case networkAll.Network3G2.ToUpper
                If GetSQL(9559, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_PropDelay_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(9559, parray)(0), GetSQL(9559, parray)(1), iQryTimeOut)
            Case networkAll.Network3G3.ToUpper
                If GetSQL(30020, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_PropDelay_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(30020, parray)(0), GetSQL(30020, parray)(1), iQryTimeOut)
            Case networkAll.Network4G1.ToUpper
                If GetSQL(10059, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(10059, parray)(0), GetSQL(10059, parray)(1), iQryTimeOut)
            Case networkAll.Network4G2.ToUpper
                If GetSQL(15059, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(15059, parray)(0), GetSQL(15059, parray)(1), iQryTimeOut)
            Case networkAll.Network4G3.ToUpper
                If GetSQL(17059, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If
                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(17059, parray)(0), GetSQL(17059, parray)(1), iQryTimeOut)
            Case networkAll.Network5G1.ToUpper
                If GetSQL(51059, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(51059, parray)(0), GetSQL(51059, parray)(1), iQryTimeOut)
            Case networkAll.Network5G2.ToUpper
                If GetSQL(52059, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(52059, parray)(0), GetSQL(52059, parray)(1), iQryTimeOut)
            Case networkAll.Network5G3.ToUpper
                If GetSQL(53059, parray)(1).Contains("@iosgid") Then
                    cellid = ftr("IOS_CELL_GID").ToString
                    parray(0)(0) = "@iosgid"
                    parray(0)(1) = "In(" & Chr(39) & cellid & Chr(39) & ")"
                End If

                tblname = "Map_TimAdv_" & cellid
                dtCellTA = DataAccessorODBC.GetDataTable(GetSQL(53059, parray)(0), GetSQL(53059, parray)(1), iQryTimeOut)
        End Select

        Dim connection As MIConnection = New MIConnection
        Dim command As MICommand = connection.CreateCommand()
        Dim tbl As MapInfo.Data.Table

        Try
            connection.Open()
            connection.Catalog.CloseTable(tblname)
            Dim ti As TableInfoAdoNet = New TableInfoAdoNet("Temp_" & tblname, dtCellTA)
            tbl = connection.Catalog.OpenTable(ti)

            Dim newtbl As MapInfo.Data.Table
            newtbl = CreateMemTableGeoFromADO(tbl, Nothing, tblname, CDbl(cellid_x), CDbl(cellid_y), CInt(cellid_az))
            tbl.Close()
            'append to map
            Dim lyr As New FeatureLayer(newtbl)

            MapControl1.Map.Layers.Add(lyr)
            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(newtbl))
            Dim thm As MapInfo.Mapping.Thematics.RangedTheme = Nothing

            If tech.ToUpper = networkAll.Network2G1.ToUpper Or tech.ToUpper = networkAll.Network2G2.ToUpper Or tech.ToUpper = networkAll.Network2G3.ToUpper Then
                thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, "Erlangs", "Erlangs", 5, Thematics.DistributionMethod.EqualRangeSize)
            ElseIf tech.ToUpper = networkAll.Network3G1.ToUpper Or tech.ToUpper = networkAll.Network3G2.ToUpper Or tech.ToUpper = networkAll.Network3G3.ToUpper Then
                thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, "MeasRep", "MeasRep", 5, Thematics.DistributionMethod.EqualRangeSize)
            ElseIf tech.ToUpper = networkAll.Network4G1.ToUpper Then
                thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, "MeasRep", "MeasRep", 5, Thematics.DistributionMethod.EqualRangeSize)
            ElseIf tech.ToUpper = networkAll.Network4G2.ToUpper Then
                thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, "MeasRep", "MeasRep", 5, Thematics.DistributionMethod.EqualRangeSize)
            ElseIf tech.ToUpper = networkAll.Network4G3.ToUpper Then
                thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, "MeasRep", "MeasRep", 5, Thematics.DistributionMethod.EqualRangeSize)
            ElseIf tech.ToUpper = networkAll.Network5G1.ToUpper Then
                thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, "MeasRep", "MeasRep", 5, Thematics.DistributionMethod.EqualRangeSize)
            ElseIf tech.ToUpper = networkAll.Network5G2.ToUpper Then
                thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, "MeasRep", "MeasRep", 5, Thematics.DistributionMethod.EqualRangeSize)
            ElseIf tech.ToUpper = networkAll.Network5G3.ToUpper Then
                thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, "MeasRep", "MeasRep", 5, Thematics.DistributionMethod.EqualRangeSize)
            End If

            'set bins
            'thm.ApplyStylePart = Thematics.StylePart.Color

            For m = 0 To thm.Bins.Count - 1
                Select Case m
                    Case 0
                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.LightGray))))
                    Case 1
                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.Gray))))
                    Case 2
                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.DarkGray))))
                    Case 3
                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.DarkRed))))
                    Case 4
                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.Red))))
                    Case Else
                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.WhiteSmoke))))
                End Select
            Next

            thm.Recompute()
            lyr.Modifiers.Append(thm)

            ' label layer
            If Me.CheckLabelLayer("Labels_" + newtbl.Alias) Then
                Me.MapControl1.Map.Layers.Remove("Labels_" + newtbl.Alias)
            End If
            Dim layer As New MapInfo.Mapping.LabelLayer
            layer.Alias = "Labels_" + newtbl.Alias
            Me.MapControl1.Map.Layers.Insert(0, layer)
            Dim source As New MapInfo.Mapping.LabelSource(newtbl)
            source.Alias = "tesT"
            source.DefaultLabelProperties.Caption = "MeasRep"
            source.DefaultLabelProperties.Style.Font.ForeColor = Color.Black
            source.DefaultLabelProperties.Style.Font.Size = 8
            source.DefaultLabelProperties.Style.Font.TextEffect = &H100
