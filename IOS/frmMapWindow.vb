    Private Sub Search_SC_Field()
        Dim psc As Integer, layer As String
        psc = CInt(txtSearchNGSCPCI.Text.ToString)
        layer = Chr(39) & cmbSearchNGLayer.Text & Chr(39)

        Dim parray()() As String = {
            New String() {"@Field", cmbSearchNGField.Text},
            New String() {"@Value", psc},
            New String() {"@Layer", layer}
        }

        Dim connstring As String = GetSQL(1004, parray)(0)
        Dim sql_freq As String = GetSQL(1004, parray)(1)

        If sql_freq Is Nothing Then
            Exit Sub
        End If

        Dim dt_SC_Search As DataTable = DataAccessorODBC.GetDataTable(connstring, sql_freq, iQryTimeOut)

        If dt_SC_Search.Rows.Count = 0 Then
            SetStatus(cmbSearchNGField.Text & " not found!")
            Exit Sub
        End If

        'map data
        Dim connection As New MIConnection
        connection.Open()

        Dim sctbl As String = "PSC_Search"
        connection.Catalog.CloseTable(sctbl)
        connection.Catalog.CloseTable(sctbl & "_Map")
        'constructing select string

        Dim ti As TableInfoAdoNet = New TableInfoAdoNet(sctbl)
        ti.ReadOnly = True
        ti.DataTable = dt_SC_Search
        Dim table As Table = connection.Catalog.OpenTable(ti)

        Dim command As MICommand = connection.CreateCommand()
        Dim irfc As IResultSetFeatureCollection = Nothing
        Dim tbl As MapInfo.Data.Table = Nothing

        Dim ti_memtable As TableInfoMemTable = Nothing
        Dim tbl_result As MapInfo.Data.Table = Nothing

        For Each drow As DataRow In dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerName").Contains(cmbSearchNGLayer.Text)).ToArray()

            Dim uniquecellfield As String = Layer_Column2Tree(drow.Item("LayerName").ToString.Trim.Replace("_Voronoi", ""))
            If Layer_Column2Tree(drow.Item("LayerName").ToString.Trim.Replace("_Voronoi", "")) Is Nothing Then
                uniquecellfield = "CELLID"
            End If

            tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim)
            If drow.Item("LayerTechnology").ToString.Contains("3G") And Not tbl Is Nothing Then
                Dim sql_select As String = "SELECT "
                For Each dcol As DataColumn In dt_SC_Search.Columns
                    sql_select = sql_select + sctbl + "." + dcol.ColumnName.ToString & ", "
                Next

                Dim sql_from As String = "FROM "
                Dim sql_where As String = "WHERE "
                Dim sql_total As String = ""

                uniquecellfield = "CELLNAME"

                sql_select = sql_select + "MI_CENTROID(" & drow.Item("LayerName").ToString.Trim + ".obj) as MI_Geometry "
                sql_from = sql_from + sctbl & ", " + drow.Item("LayerName").ToString.Trim + " "
                sql_where = sql_where + sctbl & "." + uniquecellfield + " = " + drow.Item("LayerName").ToString.Trim + "." + uniquecellfield + " "

                sql_total = sql_select + sql_from + sql_where

                command.CommandText = sql_total

                If (ti_memtable Is Nothing) Then
                    Dim features As IResultSetFeatureCollection = command.ExecuteFeatureCollection
                    ti_memtable = TableInfoFactory.CreateFromFeatureCollection(sctbl & "_Map", TableType.MemTable, features)

                    tbl_result = Session.Current.Catalog.CreateTable(ti_memtable)
                    tbl_result.InsertFeatures(features)
                Else
                    Dim features As IResultSetFeatureCollection = command.ExecuteFeatureCollection
                    tbl_result.InsertFeatures(features)
                End If
            End If
        Next

        connection.Close()
        command.Dispose()

        If Not tbl_result Is Nothing Then
            'Map the query
            Dim lyr As New FeatureLayer(tbl_result)
            MapControl1.Map.Layers.Insert(0, lyr)
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
            'MapControl1.Map.SetView(irfc.Envelope)
            Dim thm As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "PSC", "Scrambling Code")

            thm.ApplyStylePart = Thematics.StylePart.All

            'This line changes the style of the first bin for region layer
            'thm.Bins(0).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(5, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.OrangeRed), New MapInfo.Styles.SimpleInterior(3, System.Drawing.Color.OrangeRed)))
            thm.Bins(0).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.FontPointStyle(35, New MapInfo.Styles.Font("MapInfo Symbols", 20), 0, Color.Green, 20))
            'thm.Bins(0).Style = CreateSelectionStyle(5, 65000)

            lyr.Modifiers.Append(thm)
            '  MapInfo.Engine.Session.Current.MapFactory(0).SetView(lyr)

        End If

        Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData("PSC_" & Replace(psc, Chr(39), "") & "_UARFCN_" & Replace(layer, Chr(39), ""))
        Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
        IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, dt_SC_Search, "ALL")
    End Sub

    Private Sub Search_PCI_PSS_RSI_Field()
        Dim layer As String = Chr(39) & cmbSearchNGLayer.Text & Chr(39)

        Dim parray()() As String = {
            New String() {"@Field", cmbSearchNGField.Text},
            New String() {"@Value", CInt(txtSearchNGSCPCI.Text.ToString)},
            New String() {"@Layer", layer}
        }

        Dim connstring As String = GetSQL(1004, parray)(0)
        Dim sql_freq As String = GetSQL(1004, parray)(1)

        Dim dt_SC_Search As DataTable = DataAccessorODBC.GetDataTable(connstring, sql_freq, iQryTimeOut)

        If dt_SC_Search Is Nothing Then
            SetStatus("No resultset ! Queries failed...")
        End If

        If dt_SC_Search.Rows.Count = 0 Then
            SetStatus(cmbSearchNGField.Text & " not found!")
            Exit Sub
        End If

        'map data
        Dim connection As New MIConnection
        connection.Open()

        Dim sctbl As String = cmbSearchNGField.Text & "_Search"
        connection.Catalog.CloseTable(sctbl)
        connection.Catalog.CloseTable(sctbl & "_Map")

        'constructing select string
        Dim ti As TableInfoAdoNet = New TableInfoAdoNet(sctbl)
        ti.ReadOnly = True
        ti.DataTable = dt_SC_Search
        Dim table As Table = connection.Catalog.OpenTable(ti)

        Dim command As MICommand = connection.CreateCommand()
        Dim irfc As IResultSetFeatureCollection = Nothing
        Dim tbl As MapInfo.Data.Table = Nothing

        Dim ti_memtable As TableInfoMemTable = Nothing
        Dim tbl_result As MapInfo.Data.Table = Nothing

        For Each drow As DataRow In dt_Map_Configuration.Rows
            Dim uniquecellfield As String = Layer_Column2Tree(drow.Item("LayerName").ToString.Trim.Replace("_Voronoi", ""))
            If Layer_Column2Tree(drow.Item("LayerName").ToString.Trim.Replace("_Voronoi", "")) Is Nothing Then
                uniquecellfield = "CELLID"
            End If

            tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim)
            If (drow.Item("LayerTechnology").ToString.Contains("4G") Or drow.Item("LayerTechnology").ToString.Contains("5G")) And Not tbl Is Nothing Then
                Dim sql_select As String = "SELECT "
                For Each dcol As DataColumn In dt_SC_Search.Columns
                    sql_select = sql_select + sctbl + "." + dcol.ColumnName.ToString & ", "
                Next

                Dim sql_from As String = "FROM "
                Dim sql_where As String = "WHERE "
                Dim sql_total As String = ""

                sql_select = sql_select + "MI_CENTROID(" & drow.Item("LayerName").ToString.Trim + ".obj) as MI_Geometry "
                sql_from = sql_from + sctbl & ", " + drow.Item("LayerName").ToString.Trim + " "
                sql_where = sql_where + sctbl & "." + uniquecellfield + " = " + drow.Item("LayerName").ToString.Trim + "." + uniquecellfield + " "
                sql_total = sql_select + sql_from + sql_where
                command.CommandText = sql_total

                If (ti_memtable Is Nothing) Then
                    Dim features As IResultSetFeatureCollection = command.ExecuteFeatureCollection
                    ti_memtable = TableInfoFactory.CreateFromFeatureCollection(sctbl & "_Map", TableType.MemTable, features)

                    tbl_result = Session.Current.Catalog.CreateTable(ti_memtable)
                    tbl_result.InsertFeatures(features)
                Else
                    Dim features As IResultSetFeatureCollection = command.ExecuteFeatureCollection
                    tbl_result.InsertFeatures(features)
                End If
            End If
        Next

        connection.Close()
        command.Dispose()

        If Not tbl_result Is Nothing Then
            'Map the query
            Dim lyr As New FeatureLayer(tbl_result)
            MapControl1.Map.Layers.Insert(0, lyr)
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
            'MapControl1.Map.SetView(irfc.Envelope)
            Dim thm As MapInfo.Mapping.Thematics.IndividualValueTheme = Nothing

            Try
                If cmbSearchNGField.Text.ToUpper = "PCI" Then
                    thm = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "PCI", "PCI")
                ElseIf cmbSearchNGField.Text.ToUpper = "PHYCELLID" Then
                    thm = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "PHYCELLID", "PHYCELLID")
                ElseIf cmbSearchNGField.Text.ToUpper = "SSS" Then
                    thm = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "SSS", "SSS")
                ElseIf cmbSearchNGField.Text.ToUpper = "PSS" Then
                    thm = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "PSS", "PSS")
                ElseIf cmbSearchNGField.Text.ToUpper = "RSI" Then
                    thm = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "RSI", "RSI")
                End If
            Catch
            End Try

            thm.ApplyStylePart = Thematics.StylePart.All
            'This line changes the style of the first bin for region layer
            'thm.Bins(0).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(5, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.OrangeRed), New MapInfo.Styles.SimpleInterior(3, System.Drawing.Color.OrangeRed)))
            thm.Bins(0).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.FontPointStyle(35, New MapInfo.Styles.Font("MapInfo Symbols", 20), 0, Color.Green, 20))
            'thm.Bins(0).Style = CreateSelectionStyle(5, 65000)

            lyr.Modifiers.Append(thm)
            'MapInfo.Engine.Session.Current.MapFactory(0).SetView(lyr)

        End If
        Dim GridCtrl_Map As GridControl = Nothing

        If cmbSearchNGField.Text.ToUpper = "PCI" Or cmbSearchNGField.Text.ToUpper = "PHYCELLID" Then
            GridCtrl_Map = Me.CreateTabWithGridViewForMapData("PCI_" & Replace(CInt(txtSearchNGSCPCI.Text.ToString), Chr(39), "") & "_" & Replace(layer, Chr(39), ""))
        ElseIf cmbSearchNGField.Text.ToUpper = "SSS" Then
            GridCtrl_Map = Me.CreateTabWithGridViewForMapData("SSS_" & Replace(CInt(txtSearchNGSCPCI.Text.ToString), Chr(39), "") & "_" & Replace(layer, Chr(39), ""))
        ElseIf cmbSearchNGField.Text.ToUpper = "PSS" Then
            GridCtrl_Map = Me.CreateTabWithGridViewForMapData("PSS_" & Replace(CInt(txtSearchNGSCPCI.Text.ToString), Chr(39), "") & "_" & Replace(layer, Chr(39), ""))
        ElseIf cmbSearchNGField.Text.ToUpper = "RSI" Then
            GridCtrl_Map = Me.CreateTabWithGridViewForMapData("RSI_" & Replace(CInt(txtSearchNGSCPCI.Text.ToString), Chr(39), "") & "_" & Replace(layer, Chr(39), ""))
        End If

        Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
        IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, dt_SC_Search, "ALL")
    End Sub

