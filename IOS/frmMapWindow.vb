    Public Sub BindCombowithThematicData(ByRef combo As ComboBoxEdit)
        Try
            combo.Properties.Items.Clear()
            If combo.Properties.Items.Count = 0 Then
                'collect all unique fields of all open Cells_tables
                For Each drow As DataRow In dt_Map_Configuration.Rows
                    If drow("LayerActive").ToString = True Then
                        Dim tbl As MapInfo.Data.Table = Session.Current.Catalog.GetTable(drow("LayerName").ToString.Trim)
                        If Not tbl Is Nothing Then
                            If (tbl.TableInfo.TableType = TableType.Native) And (tbl.Alias.Contains("Cells_") Or tbl.Alias.Contains("Links_")) And (Not tbl.Alias.Contains("Voronoi")) Then
                                For Each dc As MapInfo.Data.Column In tbl.TableInfo.Columns
                                    If Not dc.DataType = MIDbType.FeatureGeometry And Not dc.DataType = MIDbType.Grid And Not dc.DataType = MIDbType.Style Then

                                        Dim li As New clsComboBoxItem()
                                        li.Text = dc.Alias
                                        li.Value = dc.Alias
                                        li.Tag = dc.Alias
                                        li.Sorted = True

                                        Dim cmbItem As New DevExpress.XtraEditors.Controls.ComboBoxItem()
                                        cmbItem.Value = li

                                        Dim _isExist As Boolean = False
                                        For Each obj As clsComboBoxItem In combo.Properties.Items
                                            If obj.ToString = dc.Alias Then
                                                _isExist = True
                                                Exit For
                                            End If
                                        Next

                                        If _isExist = False Then
                                            combo.Properties.Items.Add(cmbItem)
                                        End If

                                        'TODO Some how this condition is not working
                                        'If combo.Properties.Items.Contains(dc.Alias) = False Then
                                        '    combo.Properties.Items.Add(cmbItem)
                                        'End If
                                    End If
                                Next
                            End If
                        End If
                    End If
                Next
            End If
            For i As Integer = 0 To combo.Properties.Items.Count - 1
                If combo.Properties.Items(i).ToString.ToUpper = "CELLNAME" Then
                    combo.SelectedIndex = i
                    Exit For
                End If
            Next
            combo.Properties.Sorted = True

            AttachAutoCompleteWithTextBox(txtSearchCell, "CELLID", cmbNetworkArea.SelectedItem.ToString)
            AttachAutoCompleteWithTextBox(txtSearchSiteID, "Sitecode", cmbNetworkArea.SelectedItem.ToString)
        Catch ex As Exception
        End Try
    End Sub

