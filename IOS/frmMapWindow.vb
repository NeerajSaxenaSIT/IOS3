    Private Sub KpiCounter_Filter_Grid_Add(ByRef gc As GridControl, filter As List(Of String))
        Try
            Dim gv As GridView = gc.MainView
            RemoveHandler gv.ShowingEditor, AddressOf gvKpiSelFilter_ShowingEditor
            RemoveHandler gv.CustomRowCellEdit, AddressOf gvKpiSelFilter_CustomRowCellEdit

            'Dim dt As New DataTable()
            If gv.RowCount = 0 AndAlso dtKpiInfoFilter.Columns.Count = 0 Then
                dtKpiInfoFilter.Columns.Add("Dimension", GetType(String))
                dtKpiInfoFilter.Columns.Add("Operator", GetType(String))
                dtKpiInfoFilter.Columns.Add("Value", GetType(String))
                dtKpiInfoFilter.Columns.Add("Tag", GetType(String))
            Else
                dtKpiInfoFilter = gc.DataSource
            End If

            Dim foundRow As Integer = 0
            If dtKpiInfoFilter.Rows.Count > 0 Then
                foundRow = dtKpiInfoFilter.AsEnumerable().Where(Function(x) x.Field(Of String)("Dimension") = filter(0)).ToArray().Count
            End If

            If foundRow = 0 Then
                Dim dr As DataRow = dtKpiInfoFilter.NewRow()
                dr("Dimension") = filter(0)
                dr("Operator") = "<"
                dr("Value") = ""
                dr("Tag") = filter(1)
                dtKpiInfoFilter.Rows.Add(dr)
                dtKpiInfoFilter.AcceptChanges()

                IOSDevExpressGrid.PopulateDataInGrid(gc, gv, dtKpiInfoFilter, "ALL", {"Tag"}, "Value")
                CreateOperatorCombo(gc)

                gv.BestFitColumns(True)
                gv.RefreshData()
            End If

            AddHandler gv.ShowingEditor, AddressOf gvKpiSelFilter_ShowingEditor
            AddHandler gv.CustomRowCellEdit, AddressOf gvKpiSelFilter_CustomRowCellEdit

        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

