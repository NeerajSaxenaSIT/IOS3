    Public Sub Mapcontrol_ActivateMapViewChange(ByVal addon As Boolean)
        If addon = True Then
            If block_MapViewChange = False Then
                RemoveHandler MapControl1.Map.ViewChangedEvent, AddressOf MapControl_MapViewChanged
                MapControlMapViewChangehandlerCount = MapControlMapViewChangehandlerCount + 1
                block_MapViewChange = True
                AddHandler MapControl1.Map.ViewChangedEvent, AddressOf MapControl_MapViewChanged
            End If
        Else
            If MapControl1.Map IsNot Nothing Then
                RemoveHandler MapControl1.Map.ViewChangedEvent, AddressOf MapControl_MapViewChanged
                MapControlMapViewChangehandlerCount = Math.Max(MapControlMapViewChangehandlerCount - 1, 0)
                block_MapViewChange = False
            End If
        End If
    End Sub

    Public Sub MapControl_MapViewChanged(ByVal sender As Object, ByVal e As ViewChangedEventArgs)
        Try
            If e.SizeChange = True Or (CType(tlb_Layer_GM.DropDownItems(0), ToolStripMenuItem).Checked = True And Not tglSwitchCNE.IsOn) Then
                Exit Sub
            End If

            Me.Cursor = Cursors.WaitCursor
            'Application.DoEvents()

            If StaticAndGoogle = False Then
                Mapcontrol_ActivateMapViewChange(False)
            End If

            'MapControl1.Invalidate()
            Dim pt1 As DPoint = TransformPointToWGS84(MapControl1.Map.Bounds.DefiningPoints(0))
            Dim pt2 As DPoint = TransformPointToWGS84(MapControl1.Map.Bounds.DefiningPoints(1))
            Dim rct As GMap.NET.RectLatLng = New GMap.NET.RectLatLng(pt1.y, pt1.x, pt2.x - pt1.x, pt2.y - pt1.y)
            frmTileMapping.FocusMapOnPoint(New GMap.NET.PointLatLng(TransformPointToWGS84(MapControl1.Map.Center).y, TransformPointToWGS84(MapControl1.Map.Center).x), rct)
            frmTileMapping.TileMap_Update()

            'MapControl1.Update()

            'If PageRequestCount Mod 25 = 0 Then
            '    PageViewsStatsUpdate()
            'End If

            If (CType(tlb_Layer_GM.DropDownItems(0), ToolStripMenuItem).Checked = True And Not tglSwitchCNE.IsOn) Then
                Exit Sub
            End If

            If tglSwitchCNE.IsOn Then
                'SetStatus("Loading grid...")
                If dicSelectedTheme.Count > 0 Then
                    Application.DoEvents()
                    LoadCNEData()
                    Dim currentzoom As Distance
                    currentzoom = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)
                    SetGridSizeLabel(currentzoom)

                    For Each item As Object In draggedKPIList
                        If Not dicCneThmExcd.Keys.Contains(item.Text) Then
                            CNE_CreateThematic(item)
                        Else
                            SetStatus("Distinct Thematic field count cannnot be more than 500")
                        End If
                    Next
                    Application.DoEvents()
                End If
            End If
            Mapcontrol_ActivateMapViewChange(True)

        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            Me.Cursor = Cursors.Default
            'Application.DoEvents()
        End Try
    End Sub

    Public Sub Location_Map(ByVal location As String, ByVal x As Double, ByVal y As Double, Optional ByVal tablename As String = "Location_Searched", Optional FocusMap As Boolean = True)
        Dim Cat As Catalog = MapInfo.Engine.Session.Current.Catalog
        'Create Temp layer
        Try
            Dim tblTemp As Table = Cat.GetTable(tablename)
            If (IsNothing(tblTemp) = False And ce_KeepLocation.Checked = False) Or IsNothing(tblTemp) = True Then
                Cat.CloseTable(tablename)
                Dim tblInfoTemp As New TableInfoMemTable(tablename)
                tblInfoTemp.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
                tblInfoTemp.Columns.Add(ColumnFactory.CreateStyleColumn())
                tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("Location", 40))
                tblTemp = Cat.CreateTable(tblInfoTemp)
                Dim lyr As New FeatureLayer(tblTemp)
                MapControl1.Map.Layers.Add(lyr)
                MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
                MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, location)
            End If

            'Create Points
            Dim pt As FeatureGeometry = New MapInfo.Geometry.Point(csysWGS84, New DPoint(x, y))
            Dim cs As New CompositeStyle(New SimpleVectorPointStyle(59, Color.FromArgb(200, System.Drawing.Color.DarkViolet), 30))
            Dim ftr As New Feature(tblTemp.TableInfo.Columns)
            ftr.Geometry = pt
            ftr.Style = cs
            ftr.Item("Location") = Mid(location, 1, 39)
            tblTemp.InsertFeature(ftr)
            ' If frm_IOS_TileMapping.GMapControl1.Enabled = False Then
            If ce_SetView.Checked = True Then
                If getMapCoords = True Then
                    If FocusMap = True Then
                        MapControl1.Map.SetView(ftr)
                    End If

                Else
                    MapControl1.Map.SetView(ftr.Geometry.Bounds.Center, csysWGS84, GetMapZoomDistance())
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus("Location_Mapping: Error Drawing Location!" & Chr(13) & ex.Message)
        End Try
    End Sub

    Public Sub Cell_AntennaTiltCoverage(ByVal RecordID As Double, ByVal cellid As String, ByVal cellid_x As String, ByVal cellid_y As String, ByVal antennatype As String, ByVal cellid_az As Double, ByVal cellid_rc As Double, ByVal et As Double,
                                        ByVal mt As Double, Optional ByVal tilt As Double = 99, Optional clutter As Double = 0, Optional FromTiltClick As Integer = 0, Optional azimuthChanged As Boolean = False)

        _logger.SetInfo("Start CellAntennaTiltCoverage")
        _logger.SetInfo("Reading Feature data...")
        Dim cellid_electilt As Double = Nothing
        Dim cellid_mechtilt As Double = Nothing
        Dim hpbw_db As Double = -3
        Dim hpbw_horizontal As Double = 60
        Dim VAngle As Double = 6

        ' IIf(cellid_az = 360, 60, 360) ''
        cellid_electilt = tilt
        cellid_mechtilt = mt

        If tilt = 99 Then
            cellid_electilt = et
            cellid_mechtilt = mt
        Else
            cellid_electilt = tilt
            cellid_mechtilt = mt
        End If

        frmTerrainProfile.CustomClutterDefault = 0
        If FromTiltClick = 1 Then
            frmTerrainProfile.CustomClutter = clutter
        End If

        'frm_IOS_TerrainProfile.CustomTiltDefault = CDbl(nEmpty(nZ(ftr("ELECTRICALTILT").ToString, 0), 0))
        frmTerrainProfile.CustomTiltDefault = et
        frmTerrainProfile.CustomAzimuthDefault = cellid_az

        Dim hpbw_upper As Double = cellid_electilt - 3
        Dim hpbw_lower As Double = cellid_electilt + 3
        'getting antenna profile for requested tilt
        Dim dt_antenna As DataTable = Nothing
        Dim ds_antenna As DataSet = Nothing

        _logger.SetInfo("Cellid: " & cellid)
        _logger.SetInfo("cellid_x: " & cellid_x)
        _logger.SetInfo("cellid_y: " & cellid_y)
        _logger.SetInfo("cellid_az: " & cellid_az)
        _logger.SetInfo("cellid_rc: " & cellid_rc)
        _logger.SetInfo("cellid_electilt: " & cellid_electilt)
        _logger.SetInfo("cellid_mechtilt: " & cellid_mechtilt)

        Try
            Dim antennasql As String = Nothing
            If antennatype = Nothing Then
                antennasql = "SELECT TOP 1 * FROM Antennas where Antenna='" & "Default" & "' and Attenuation = " & hpbw_db & " order by (tilt - " & cellid_electilt & ") ASC "
                antennatype = "Default"
            Else
                antennasql = "IF EXISTS(select antenna from Antennas where antenna = '" & antennatype & "')  " &
                                " BEGIN " &
                                "SELECT TOP 1 * FROM Antennas where Antenna='" & antennatype & "' and Attenuation = " & hpbw_db & " order by (tilt - " & cellid_electilt & ") ASC " &
                                " END " &
                            "ELSE " &
                                "BEGIN " &
                                "SELECT TOP 1 * FROM Antennas where Antenna='Default' and Attenuation = " & hpbw_db & " order by (tilt - " & cellid_electilt & ") ASC " &
                                "END"
            End If

            _logger.SetInfo("Acquire Antenna Data - " + antennasql + " " + connStrIOSServer)
            ds_antenna = DataAccessorODBC.GetDataSet(connStrIOSServer, antennasql)

            If ds_antenna.Tables.Count = 1 Then
                If ds_antenna.Tables(0).Rows.Count > 0 Then
                    _logger.SetInfo("Antenna Data Rows- " + ds_antenna.Tables(0).Rows.Count.ToString)
                    dt_antenna = ds_antenna.Tables(0)
                    antennatype = dt_antenna(0)("Antenna").ToString
                    hpbw_lower = cellid_electilt + dt_antenna(0)("Vangle") / 2
                    hpbw_upper = cellid_electilt - dt_antenna(0)("Vangle") / 2
                    hpbw_horizontal = nZ(dt_antenna(0)("Hangle"), "60")
                    VAngle = dt_antenna(0)("Vangle")
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try

        'calculate distance based on 0 receiving height

        'get elevation of antenna:
        Dim p_profile(1) As DPoint
        p_profile(0) = New DPoint(cellid_x, cellid_y)
        Dim antenna_elevation As Double = 0

        antenna_elevation = frmTileMapping.TileMapping_GeoElevationPoint(p_profile(0))
        If antenna_elevation = -9999 Then
            Exit Sub
        End If
        ' Exit Sub

        Dim horizon_hit As Boolean = False
        'get maximum upper 3db distance (considering flat surface)
        Dim maxdistance_up3db As Double
        Dim maxdistance_down3db As Double
        Dim cellid_tt As Double = cellid_electilt + cellid_mechtilt
        If (90 - (cellid_mechtilt + hpbw_upper)) >= 90 Then
            maxdistance_up3db = Math.Sqrt(2 * 6400 * (antenna_elevation + cellid_rc) / 1000)
            horizon_hit = True
        Else
            maxdistance_up3db = (antenna_elevation + cellid_rc) * Math.Tan((90 - (cellid_mechtilt + hpbw_upper)) * Math.PI / 180) * 1 / 1000
        End If

        maxdistance_down3db = maxdistance_up3db 'temporary value
        'Exit Sub

        Try
            'get point of maxdistance
            Dim pint As MapInfo.Geometry.IPointEdit = New MapInfo.Geometry.Point(csysWGS84, p_profile(0)).GetPointEditor
            If cellid_az > 90 Then
                pint.OffsetByAngle((90 - cellid_az) + 360, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
            Else
                pint.OffsetByAngle(90 - cellid_az, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
            End If

            Dim p2 As DPoint = New DPoint(pint.X, pint.Y)
            p_profile(1) = p2
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try

        Dim profile_distance As Double = maxdistance_up3db

        'create antenna terrain profile & coverage pie wedge
        'Create_TerrainProfile_PieWedge_For_Selected_Cell(profile_distance, maxdistance_up3db, maxdistance_down3db, hpbw_upper, hpbw_lower, p_profile, cellid_tt, RecordID, cellid, cellid_x, cellid_y, et, cellid_electilt, mt, cellid_mechtilt, antennatype, antenna_elevation, cellid_az, cellid_rc, VAngle, clutter, hpbw_horizontal, FromTiltClick)

        'create antenna terrain profile
        Create_TerrainProfile_For_Selected_Cells(profile_distance, maxdistance_up3db, maxdistance_down3db, hpbw_upper, hpbw_lower, p_profile, cellid_tt, RecordID, cellid, cellid_x, cellid_y, et, cellid_electilt, mt, cellid_mechtilt, antennatype, antenna_elevation, cellid_az, cellid_rc, VAngle, clutter, hpbw_horizontal, FromTiltClick)

        'create antenna coverage area as wedge
        Create_Polygon_Wedge_For_Selected_Cell(p_profile, RecordID, cellid, cellid_x, cellid_y, antennatype, cellid_az, cellid_rc, antenna_elevation, maxdistance_up3db, cellid_electilt, cellid_mechtilt, hpbw_upper, hpbw_lower, clutter, FromTiltClick, hpbw_horizontal, azimuthChanged)

    End Sub

    Private Sub Create_TerrainProfile_For_Selected_Cells(profile_distance As Double, maxdistance_up3db As Double, maxdistance_down3db As Double, hpbw_upper As Double, hpbw_lower As Double, p_profile As DPoint(), cellid_tt As Double, RecordID As Double, CellId As String, ByVal cellid_x As String, ByVal cellid_y As String,
                                                              et As Double, cellid_electilt As Double, mt As Double, cellid_mechtilt As Double, antennatype As String, antenna_elevation As Double, ByVal cellid_az As Double, cellid_rc As Double, VAngle As Double, clutter As Double, hpbw_horizontal As Double,
                                                              Optional fromTiltClick As Integer = 0)

        Dim dt_profile As DataTable = Nothing
        Try
            _logger.SetInfo("Start GeoProfile Request -  " & profile_distance.ToString & " / " & p_profile(0).ToString & "," & p_profile(1).ToString)

            dt_profile = frmTileMapping.TileMapping_GeoProfile(p_profile, profile_distance)

            _logger.SetInfo("Profile -  " & dt_profile.Rows.Count.ToString)

            Dim samples_in_profile As Integer = dt_profile.Rows.Count
            Dim distancepersample As Double = profile_distance / samples_in_profile * 1000
            Try
                If Not dt_profile Is Nothing Then
                    _logger.SetError("calculating Rays")

                    dt_profile.Columns.Add(New DataColumn("lowerbeam_height", GetType(System.Double)))
                    dt_profile.Columns.Add(New DataColumn("meanbeam_height", GetType(System.Double)))
                    dt_profile.Columns.Add(New DataColumn("upperbeam_height", GetType(System.Double)))
                    dt_profile.Columns.Add(New DataColumn("distance", GetType(System.Double)))
                    dt_profile.Columns.Add(New DataColumn("clutter_height", GetType(System.Double)))

                    For i = 0 To dt_profile.Rows.Count - 1
                        If dt_profile(i)("elevation") < -10 Then
                            dt_profile(i)("elevation") = -10
                        End If
                        dt_profile(i)("distance") = distancepersample * i / 1000
                        dt_profile(i)("clutter_height") = dt_profile(i)("elevation") + clutter
                        If i = 0 Then
                            dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation
                            dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation
                            dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation
                        Else
                            If 90 - cellid_tt - hpbw_lower < 90 Then
                                dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_lower) * Math.PI / 180) * distancepersample * i)
                            Else
                                dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_lower) * Math.PI / 180) * distancepersample * i)
                                ' dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                            End If
                            If 90 - cellid_tt < 90 Then
                                dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_tt) * Math.PI / 180) * distancepersample * i)
                            Else
                                dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_tt) * Math.PI / 180) * distancepersample * i)
                                'dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                            End If

                            If 90 - (cellid_mechtilt + hpbw_upper) < 90 Then
                                dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_upper) * Math.PI / 180) * distancepersample * i)
                            Else
                                dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_upper) * Math.PI / 180) * distancepersample * i)
                                'dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                            End If

                            If dt_profile(i)("upperbeam_height") < dt_profile(i)("clutter_height") And maxdistance_up3db = profile_distance Then
                                maxdistance_up3db = Math.Min(distancepersample * i / 1000, maxdistance_up3db)

                            End If
                            If dt_profile(i)("meanbeam_height") < dt_profile(i)("clutter_height") Then
                                ' maxdistance_up3db = distancepersample * i
                            End If
                            If dt_profile(i)("lowerbeam_height") < dt_profile(i)("clutter_height") Then
                                maxdistance_down3db = Math.Min(distancepersample * i / 1000, maxdistance_down3db)
                            End If
                        End If
                    Next
                    _logger.SetInfo("Dt Profile Calculation" + " - " + dt_profile.Rows.Count.ToString)
                Else
                    maxdistance_down3db = cellid_rc * Math.Tan((90 - cellid_mechtilt - hpbw_lower) * Math.PI / 180) * 1 / 1000
                End If

            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try

            _logger.SetInfo("Start Terrain Profile Plot" + " - " + profile_distance.ToString + " - " + CellId.ToString + " - " + cellid_electilt.ToString + " - " + cellid_mechtilt.ToString + " - " + antennatype.ToString)
            frmTerrainProfile.tp_cellid = CellId
            frmTerrainProfile.tp_cellidx = cellid_x
            frmTerrainProfile.tp_cellidy = cellid_y
            frmTerrainProfile.tp_cellid_az = cellid_az
            frmTerrainProfile.tp_cellid_rc = cellid_rc
            frmTerrainProfile.tp_cellid_ant = antennatype
            frmTerrainProfile.tp_cellid_et = et
            frmTerrainProfile.tp_cellid_mt = mt
            frmTerrainProfile.tp_recordid = RecordID

            Dim IndexWhereBeamHitsGround As Integer = dt_profile.Rows.Count - 1
            For Each dr As DataRow In dt_profile.Rows
                If dr("upperbeam_height") < dr("clutter_height") Then
                    IndexWhereBeamHitsGround = dt_profile.Rows.IndexOf(dr)
                    ' profile_distance = dr("distance")
                    Exit For
                End If
            Next

            If IndexWhereBeamHitsGround = 0 Then
                IndexWhereBeamHitsGround = dt_profile.Rows.Count - 1
            End If

            For i = dt_profile.Rows.Count - 1 To 0 Step -1
                If i > IndexWhereBeamHitsGround + 50 Then
                    dt_profile.Rows(i).Delete()

                Else
                    profile_distance = dt_profile.Rows(i)("distance")
                    Exit For
                End If
            Next

            'create antenna terrain profile
            frmTerrainProfile.TerrainProfileStart(dt_profile, profile_distance, CellId, cellid_electilt, cellid_mechtilt, antennatype, cellid_rc, VAngle, cellid_az)
        Catch
        Finally
            dt_profile.Dispose()
            dt_profile = Nothing
        End Try
    End Sub

    Private Sub Create_Polygon_Wedge_For_Selected_Cell(p_profile As DPoint(), RecordID As Double, ByVal cellid As String, ByVal cellid_x As String, ByVal cellid_y As String, ByVal antennatype As String, ByVal cellid_az As Double, ByVal cellid_rc As Double, antenna_elevation As Double,
                                                       ByVal maxdistance_up3db As Double, cellid_electilt As Double, cellid_mechtilt As Double, hpbw_upper As Double, hpbw_lower As Double, clutter As Double, fromTiltClick As Integer, hpbw_horizontal As Double, Optional azimuthChanged As Boolean = False)

        Dim profile3db1 As Int16
        Dim profile3db2 As Int16

        If Not fromTiltClick = 1 Then

            If (Me.tp_resolution = 7) Then
                frmTerrainProfile.cmbResolution.SelectedIndex = 0
            ElseIf (Me.tp_resolution = 15) Then
                frmTerrainProfile.cmbResolution.SelectedIndex = 1
            ElseIf (Me.tp_resolution = 25) Then
                frmTerrainProfile.cmbResolution.SelectedIndex = 2
            End If

            Dim pcenter As DPoint = Nothing
            maxdistance_up3db = Math.Sqrt(2 * 6400 * (antenna_elevation + cellid_rc - clutter) / 1000)

            Dim ds_profile As DataSet = Nothing
            Dim ds_profile_remove As DataSet = Nothing

            Dim ds_profile3dB As DataSet = Nothing
            Dim ds_profile3dB_remove As DataSet = Nothing
            Dim p_profile3dB As DPoint() = p_profile

            If azimuthChanged = False Then
                For Each ds As DataSet In lst_ds_Profile_Wedges
                    If ds.DataSetName = cellid Then
                        If Me.tp_resolution <> ds.Tables.Count Then
                            ds_profile_remove = ds
                        Else
                            ds_profile = ds
                        End If
                    End If
                Next
                For Each ds As DataSet In lst_ds_Profile_Wedges_3dB
                    If ds.DataSetName = cellid Then
                        If Me.tp_resolution <> ds.Tables.Count Then
                            ds_profile3dB_remove = ds
                        Else
                            ds_profile3dB = ds
                        End If
                    End If
                Next
            End If

            'Remove the cell dataset for a diff resolution set
            If Not ds_profile_remove Is Nothing Then
                lst_ds_Profile_Wedges.Remove(ds_profile_remove)
                lst_ds_Profile_Wedges.Remove(ds_profile3dB_remove)
            End If

            If ds_profile Is Nothing Then
                ds_profile = New DataSet
                ds_profile.DataSetName = cellid
                lst_ds_Profile_Wedges.Add(ds_profile)

                ds_profile3dB = New DataSet
                ds_profile3dB.DataSetName = cellid
                lst_ds_Profile_Wedges_3dB.Add(ds_profile3dB)
            End If

            Try
                Dim p2(1) As DPoint

                Dim lstOfNewAngles As New List(Of Double)
                Dim DeltaAngle1 As Double = 120 - hpbw_horizontal
                Dim DeltaAngle2 As Double = hpbw_horizontal



                If tp_resolution = 7 Then
                    lstOfNewAngles.Add((cellid_az - (120 / 2)))
                    For icntr = 1 To 2
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle1 / 2) / 2))
                    Next
                    For icntr = 1 To 4
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle2 / 2) / 2))
                    Next
                    For icntr = 1 To 2
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle1 / 2) / 2))
                    Next

                    profile3db1 = 2
                    profile3db2 = 6
                End If

                If tp_resolution = 15 Then
                    lstOfNewAngles.Add((cellid_az - (120 / 2)))
                    For icntr = 1 To 4
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle1 / 2) / 4))
                    Next
                    For icntr = 1 To 8
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle2 / 2) / 4))
                    Next
                    For icntr = 1 To 4
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle1 / 2) / 4))
                    Next

                    profile3db1 = 4
                    profile3db2 = 12

                End If

                If tp_resolution = 25 Then
                    lstOfNewAngles.Add((cellid_az - (120 / 2)))
                    For icntr = 1 To 6
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle1 / 2) / 6))
                    Next
                    For icntr = 1 To 12
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle2 / 2) / 6))
                    Next
                    For icntr = 1 To 6
                        lstOfNewAngles.Add((lstOfNewAngles.Last() + (DeltaAngle1 / 2) / 6))
                    Next

                    profile3db1 = 6
                    profile3db2 = 18
                End If


                'create wedge data table
                For icntr = 0 To lstOfNewAngles.Count - 1

                    Dim pint As MapInfo.Geometry.IPointEdit = New MapInfo.Geometry.Point(csysWGS84, p_profile(0)).GetPointEditor
                    pcenter = New DPoint(pint.X, pint.Y)

                    Dim newAngle As Double = lstOfNewAngles(icntr)
                    If newAngle < 0 Then
                        newAngle = newAngle + 360
                    End If
                    If newAngle > 90 Then
                        pint.OffsetByAngle(90 - newAngle + 360, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
                    Else
                        pint.OffsetByAngle(90 - newAngle, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
                    End If

                    p_profile(0) = pcenter
                    p_profile(1) = New DPoint(pint.X, pint.Y)

                    Dim dt_profile_Wedge As DataTable = Nothing

                    If ds_profile.Tables.Contains("dt_profile" & icntr.ToString) Then
                        dt_profile_Wedge = ds_profile.Tables("dt_profile" & icntr.ToString)
                    Else
                        dt_profile_Wedge = New DataTable
                        dt_profile_Wedge = frmTileMapping.TileMapping_GeoProfile(p_profile, maxdistance_up3db)

                        dt_profile_Wedge.TableName = "dt_profile" & icntr.ToString

                        dt_profile_Wedge.Columns.Add(New DataColumn("ubh_" & cellid, GetType(System.String)))
                        dt_profile_Wedge.Columns.Add(New DataColumn("lbh_" & cellid, GetType(System.String)))
                        dt_profile_Wedge.Columns.Add(New DataColumn("distance", GetType(System.Double)))
                        dt_profile_Wedge.Columns.Add(New DataColumn("clutter_height", GetType(System.Double)))

                        ds_profile.Tables.Add(dt_profile_Wedge)
                    End If

                    Dim samples_in_profile As Integer = dt_profile_Wedge.Rows.Count
                    Dim distancepersample As Double = maxdistance_up3db / samples_in_profile * 1000

                    Try
                        If Not dt_profile_Wedge Is Nothing Then
                            _logger.SetError("calculating Rays")

                            For i = 0 To dt_profile_Wedge.Rows.Count - 1
                                If dt_profile_Wedge(i)("elevation") < -10 Then
                                    dt_profile_Wedge(i)("elevation") = -10
                                End If

                                dt_profile_Wedge(i)("distance") = distancepersample * i / 1000
                                dt_profile_Wedge(i)("clutter_height") = dt_profile_Wedge(i)("elevation") + clutter
                                If i = 0 Then
                                    dt_profile_Wedge(i)("ubh_" & cellid) = cellid_rc + CDbl(dt_profile_Wedge(i)("Elevation"))
                                    dt_profile_Wedge(i)("lbh_" & cellid) = cellid_rc + CDbl(dt_profile_Wedge(i)("Elevation"))
                                Else

                                    If 90 - (cellid_mechtilt + hpbw_upper) < 90 Then
                                        dt_profile_Wedge(i)("ubh_" & cellid) = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_upper) * Math.PI / 180) * distancepersample * i)
                                    Else
                                        dt_profile_Wedge(i)("ubh_" & cellid) = cellid_rc + antenna_elevation - (cellid_rc) / samples_in_profile * i
                                    End If

                                    If 90 - (cellid_mechtilt + hpbw_lower) < 90 Then
                                        dt_profile_Wedge(i)("lbh_" & cellid) = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_lower) * Math.PI / 180) * distancepersample * i)
                                    Else
                                        dt_profile_Wedge(i)("lbh_" & cellid) = cellid_rc + antenna_elevation - (cellid_rc) / samples_in_profile * i
                                    End If

                                End If
                            Next
                            _logger.SetInfo("Dt Profile Calculation" + " - " + dt_profile_Wedge.Rows.Count.ToString)
                        End If

                    Catch ex As Exception
                        _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                    End Try

                Next

            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try

            Dim dtPoints = New DataTable
            dtPoints.Columns.Add("CellName", GetType(String))
            dtPoints.Columns.Add("dtProfileTable", GetType(Integer))
            dtPoints.Columns.Add("MaxDistancePoint", GetType(String))
            dtPoints.Columns.Add("MaxDistancePoint_lbh", GetType(String))
            dtPoints.Columns.Add("MaxDistance", GetType(String))
            dtPoints.Columns.Add("inHPBW_Horizontal", GetType(Boolean))

            Dim lbh_location As String = Nothing

            'Dim IndexWhereBeamHitsGround As Integer = 0
            For Each dt As DataTable In ds_profile.Tables
                For Each col As DataColumn In dt.Columns
                    If col.ColumnName.StartsWith("ubh_") Then
                        For Each dr As DataRow In dt.Rows
                            If (dr(col.ColumnName.Replace("ubh", "lbh")) < dr("clutter_height") Or dt.Rows.IndexOf(dr) = dt.Rows.Count - 1) And lbh_location Is Nothing Then
                                lbh_location = dr("Location")
                            End If

                            If dr(col) < dr("clutter_height") Or dt.Rows.IndexOf(dr) = dt.Rows.Count - 1 Then
                                Dim drNew As DataRow = dtPoints.NewRow
                                drNew("CellName") = cellid
                                drNew("dtProfileTable") = CInt(Replace(dt.TableName, "dt_profile", ""))
                                drNew("MaxDistancePoint") = dr("Location")
                                drNew("MaxDistancePoint_lbh") = lbh_location
                                drNew("MaxDistance") = dr("distance")
                                drNew("inHPBW_Horizontal") = IIf(CInt(Replace(dt.TableName, "dt_profile", "")) < (tp_resolution - 1) / 4 Or CInt(Replace(dt.TableName, "dt_profile", "")) > (tp_resolution - 1) * 3 / 4, 0, 1)

                                dtPoints.Rows.Add(drNew)
                                Exit For

                            End If
                        Next
                    End If
                Next
                lbh_location = Nothing
            Next

            Dim con As New MapInfo.Data.MIConnection
            Try
                con.Open()
                'Dim dtWedge As DataTable = dtTreeRef.Select("CELLNAME='" & cellName & "'").CopyToDataTable
                'For Each drWedge As DataRow In dtWedge.Rows

                Dim lyr As FeatureLayer = Nothing
                Dim styleftr As CompositeStyle = Nothing
                Dim MemTable As MapInfo.Data.Table = Nothing

                Dim connection As MIConnection = New MIConnection
                Dim command As MICommand = connection.CreateCommand()
                MapInfo.Engine.Session.Current.Catalog.CloseTable("AntennaTilt_" & cellid)

                Dim ti As TableInfo = New TableInfoMemTable("AntennaTilt_" & cellid)
                ti.Columns.Add(ColumnFactory.CreateStringColumn("CELL", 100))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("X"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("Y"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("AZIMUTH"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("RADIATIONCENTER"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("ELECTRICALTILT"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("MECHANICALTILT"))
                ti.Columns.Add(ColumnFactory.CreateStringColumn("ANTENNATYPE", 100))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("CLUTTER"))
                ti.Columns.Add(ColumnFactory.CreateIndexedDoubleColumn("RECORDID"))
                ti.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
                ti.Columns.Add(ColumnFactory.CreateStyleColumn())

                MemTable = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti)

                MemTable.BeginAccess(TableAccessMode.Write)
                Dim ftr_new As New Feature(MemTable.TableInfo.Columns)
                Dim ftr_3db1 As New Feature(MemTable.TableInfo.Columns)
                Dim ftr_3db2 As New Feature(MemTable.TableInfo.Columns)

                Dim i As Integer = 1
                Dim previouswidth As Double = 0
                Dim cp(dtPoints.Rows.Count * 2) As DPoint

                If dtPoints.Rows.Count > 0 Then

                    Dim dRow() As DataRow = dtPoints.AsEnumerable().Where(Function(X) X.Field(Of String)("CellName") = cellid).OrderBy(Function(x) x.Field(Of Integer)("dtProfileTable")).ToArray()

                    '   Dim previous_InHPBW As Boolean = False
                    Dim cp_index As Integer = 0
                    For iCntr = 0 To dRow.Length - 1
                        cp.SetValue(New DPoint(dRow(iCntr)("MaxDistancePoint").ToString.Split(";")(1), dRow(iCntr)("MaxDistancePoint").ToString.Split(";")(0)), cp_index)
                        cp_index = cp_index + 1
                    Next

                    For iCntr = dRow.Length - 1 To 0 Step -1
                        cp.SetValue(New DPoint(dRow(iCntr)("MaxDistancePoint_lbh").ToString.Split(";")(1), dRow(iCntr)("MaxDistancePoint_lbh").ToString.Split(";")(0)), cp_index)
                        cp_index = cp_index + 1
                    Next

                    cp(dtPoints.Rows.Count * 2) = cp(0)

                    Dim geoftr As Geometry = CreatePolygon(cp)
                    Dim cp3db1 As DPoint = New DPoint(dRow(profile3db1)("MaxDistancePoint").ToString.Split(";")(1), dRow(profile3db1)("MaxDistancePoint").ToString.Split(";")(0))
                    Dim cp3db2 As DPoint = New DPoint(dRow(profile3db1)("MaxDistancePoint_lbh").ToString.Split(";")(1), dRow(profile3db1)("MaxDistancePoint_lbh").ToString.Split(";")(0))
                    Dim cp3db3 As DPoint = New DPoint(dRow(profile3db2)("MaxDistancePoint").ToString.Split(";")(1), dRow(profile3db2)("MaxDistancePoint").ToString.Split(";")(0))
                    Dim cp3db4 As DPoint = New DPoint(dRow(profile3db2)("MaxDistancePoint_lbh").ToString.Split(";")(1), dRow(profile3db2)("MaxDistancePoint_lbh").ToString.Split(";")(0))

                    Dim geoftr3db1 As Geometry = GetLineFeature(cp3db1, cp3db2, csysWGS84)
                    Dim geoftr3db2 As Geometry = GetLineFeature(cp3db3, cp3db4, csysWGS84)


                    styleftr = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(2, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.DarkGreen), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(100, Color.LightGreen))))

                    Dim lstyle As SimpleLineStyle = Nothing
                    lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 3, System.Drawing.Color.LightGray)
                    Dim styleftr3db As New CompositeStyle(lstyle)

                    '    styleftr.LineStyle.ApplyStyle(lstyle)
                    styleftr.ApplyStyle(lstyle)

                    ftr_new("CELL") = cellid
                    ftr_new("X") = cellid_x
                    ftr_new("Y") = cellid_y
                    ftr_new("AZIMUTH") = cellid_az
                    ftr_new("RADIATIONCENTER") = cellid_rc
                    ftr_new("ELECTRICALTILT") = cellid_electilt
                    ftr_new("MECHANICALTILT") = cellid_mechtilt
                    ftr_new("ANTENNATYPE") = antennatype
                    ftr_new("CLUTTER") = 0
                    ftr_new("RECORDID") = RecordID
                    ftr_new("obj") = geoftr
                    ftr_new("MI_Style") = styleftr

                    ftr_3db1("obj") = geoftr3db1
                    ftr_3db1("MI_Style") = styleftr3db

                    ftr_3db2("obj") = geoftr3db2
                    ftr_3db2("MI_Style") = styleftr3db

                    MemTable.InsertFeature(ftr_new)
                    MemTable.InsertFeature(ftr_3db1)
                    MemTable.InsertFeature(ftr_3db2)

                    'MemTable.InsertFeature(ftr_new_3db)

                    MemTable.EndAccess()
                    lyr = New FeatureLayer(MemTable)
                    MapControl1.Map.Layers.Add(lyr)
                    lyr.Modifiers.Append(New FeatureOverrideStyleModifier("AntennaStyle", styleftr))

                    MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(MemTable))

                End If
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Finally
                If Not con Is Nothing Then
                    con.Close()
                    con.Dispose()
                    con = Nothing
                End If
            End Try

        End If
    End Sub

    Private Sub Create_TerrainProfile_PieWedge_For_Selected_Cell(profile_distance As Double, maxdistance_up3db As Double, maxdistance_down3db As Double, hpbw_upper As Double, hpbw_lower As Double, p_profile As DPoint(), cellid_tt As Double, RecordID As Double, CellId As String, ByVal cellid_x As String, ByVal cellid_y As String,
                                                         et As Double, cellid_electilt As Double, mt As Double, cellid_mechtilt As Double, antennatype As String, antenna_elevation As Double, ByVal cellid_az As Double, cellid_rc As Double, VAngle As Double, clutter As Double, hpbw_horizontal As Double, Optional fromTiltClick As Integer = 0)

        _logger.SetInfo("Start GeoProfile Request -  " & profile_distance.ToString & " / " & p_profile(0).ToString & "," & p_profile(1).ToString)

        Dim dt_profile As DataTable = frmTileMapping.TileMapping_GeoProfile(p_profile, profile_distance)

        _logger.SetInfo("Profile -  " & dt_profile.Rows.Count.ToString)

        Dim samples_in_profile As Integer = dt_profile.Rows.Count
        Dim distancepersample As Double = profile_distance / samples_in_profile * 1000
        Try
            If Not dt_profile Is Nothing Then
                _logger.SetError("calculating Rays")

                dt_profile.Columns.Add(New DataColumn("lowerbeam_height", GetType(System.Double)))
                dt_profile.Columns.Add(New DataColumn("meanbeam_height", GetType(System.Double)))
                dt_profile.Columns.Add(New DataColumn("upperbeam_height", GetType(System.Double)))
                dt_profile.Columns.Add(New DataColumn("distance", GetType(System.Double)))
                dt_profile.Columns.Add(New DataColumn("clutter_height", GetType(System.Double)))

                For i = 0 To dt_profile.Rows.Count - 1
                    If dt_profile(i)("elevation") < -10 Then
                        dt_profile(i)("elevation") = -10
                    End If

                    dt_profile(i)("distance") = distancepersample * i / 1000
                    dt_profile(i)("clutter_height") = dt_profile(i)("elevation") + clutter
                    If i = 0 Then
                        dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation
                        dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation
                        dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation
                    Else
                        If 90 - cellid_tt - hpbw_lower < 90 Then
                            dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_lower) * Math.PI / 180) * distancepersample * i)
                        Else
                            dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                        End If
                        If 90 - cellid_tt < 90 Then
                            dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_tt) * Math.PI / 180) * distancepersample * i)
                        Else
                            dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                        End If

                        If 90 - (cellid_mechtilt + hpbw_upper) < 90 Then
                            dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_upper) * Math.PI / 180) * distancepersample * i)
                        Else
                            dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                        End If

                        If dt_profile(i)("upperbeam_height") < dt_profile(i)("clutter_height") And maxdistance_up3db = profile_distance Then
                            maxdistance_up3db = Math.Min(distancepersample * i / 1000, maxdistance_up3db)

                        End If
                        If dt_profile(i)("meanbeam_height") < dt_profile(i)("clutter_height") Then
                            ' maxdistance_up3db = distancepersample * i
                        End If
                        If dt_profile(i)("lowerbeam_height") < dt_profile(i)("clutter_height") Then
                            maxdistance_down3db = Math.Min(distancepersample * i / 1000, maxdistance_down3db)
                        End If
                    End If
                Next
                _logger.SetInfo("Dt Profile Calculation" + " - " + dt_profile.Rows.Count.ToString)
            Else
                maxdistance_down3db = cellid_rc * Math.Tan((90 - cellid_mechtilt - hpbw_lower) * Math.PI / 180) * 1 / 1000
            End If

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try

        _logger.SetInfo("Start Terrain Profile Plot" + " - " + profile_distance.ToString + " - " + CellId.ToString + " - " + cellid_electilt.ToString + " - " + cellid_mechtilt.ToString + " - " + antennatype.ToString)
        frmTerrainProfile.tp_cellid = CellId
        frmTerrainProfile.tp_cellidx = cellid_x
        frmTerrainProfile.tp_cellidy = cellid_y
        frmTerrainProfile.tp_cellid_az = cellid_az
        frmTerrainProfile.tp_cellid_rc = cellid_rc
        frmTerrainProfile.tp_cellid_ant = antennatype
        frmTerrainProfile.tp_cellid_et = et
        frmTerrainProfile.tp_cellid_mt = mt
        frmTerrainProfile.tp_recordid = RecordID

        Dim IndexWhereBeamHitsGround As Integer = dt_profile.Rows.Count - 1
        For Each dr As DataRow In dt_profile.Rows
            If dr("upperbeam_height") < dr("elevation") Then
                IndexWhereBeamHitsGround = dt_profile.Rows.IndexOf(dr)
                ' profile_distance = dr("distance")
                Exit For
            End If
        Next

        For i = dt_profile.Rows.Count - 1 To 0 Step -1
            If i > IndexWhereBeamHitsGround + 50 Then
                dt_profile.Rows(i).Delete()
            Else
                profile_distance = dt_profile.Rows(i)("distance")
                Exit For
            End If
        Next

        'create antenna terrain profile
        frmTerrainProfile.TerrainProfileStart(dt_profile, profile_distance, CellId, cellid_electilt, cellid_mechtilt, antennatype, cellid_rc, VAngle, cellid_az)

        'Create pie wedge
        Me.Create_Pie_Wedge_For_Selected_Cell(RecordID, CellId, cellid_x, cellid_y, antennatype, cellid_az, cellid_rc, maxdistance_up3db, maxdistance_down3db, cellid_electilt, cellid_mechtilt, hpbw_horizontal, clutter, fromTiltClick)

    End Sub

    Private Sub Create_Pie_Wedge_For_Selected_Cell(RecordID As Double, ByVal cellid As String, ByVal cellid_x As String, ByVal cellid_y As String, ByVal antennatype As String, ByVal cellid_az As Double, ByVal cellid_rc As Double,
                                               ByVal maxdistance_up3db As Double, ByVal maxdistance_down3db As Double, cellid_electilt As Double, cellid_mechtilt As Double, hpbw_horizontal As Double, clutter As Double, Optional fromTiltClick As Integer = 0)

        If Not fromTiltClick = 1 Then

            _logger.SetError("Start Map Drawing")
            Dim connection As MIConnection = New MIConnection
            Dim command As MICommand = connection.CreateCommand()
            MapInfo.Engine.Session.Current.Catalog.CloseTable("AntennaTilt_" & cellid)

            Dim ti As TableInfo = New TableInfoMemTable("AntennaTilt_" & cellid)
            ti.Columns.Add(ColumnFactory.CreateStringColumn("CELL", 100))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("X"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("Y"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("AZIMUTH"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("RADIATIONCENTER"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("ELECTRICALTILT"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("MECHANICALTILT"))
            ti.Columns.Add(ColumnFactory.CreateStringColumn("ANTENNATYPE", 100))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("CLUTTER"))
            ti.Columns.Add(ColumnFactory.CreateIndexedDoubleColumn("RECORDID"))
            ti.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
            ti.Columns.Add(ColumnFactory.CreateStyleColumn())

            Dim MemTable As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti)
            Dim con As New MapInfo.Data.MIConnection

            Try
                con.Open()
                MemTable.BeginAccess(TableAccessMode.Write)
                Dim ftr_new As New Feature(MemTable.TableInfo.Columns)
                Dim i As Integer = 1
                Dim previouswidth As Double = 0
                Dim geoftr As Geometry = CreatePieRingGeometry(New DPoint(cellid_x, cellid_y), cellid_az, maxdistance_down3db, hpbw_horizontal, maxdistance_up3db - maxdistance_down3db)
                Dim styleftr As CompositeStyle = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(2, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.DarkGreen), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(100, Color.LightGreen))))

                ftr_new("CELL") = cellid
                ftr_new("X") = cellid_x
                ftr_new("Y") = cellid_y
                ftr_new("AZIMUTH") = cellid_az
                ftr_new("RADIATIONCENTER") = cellid_rc
                ftr_new("ELECTRICALTILT") = cellid_electilt
                ftr_new("MECHANICALTILT") = cellid_mechtilt
                ftr_new("ANTENNATYPE") = antennatype
                ftr_new("CLUTTER") = clutter
                ftr_new("RECORDID") = RecordID
                ftr_new("obj") = geoftr
                ftr_new("MI_Style") = styleftr

                MemTable.InsertFeature(ftr_new)
                MemTable.EndAccess()
                Dim lyr As New FeatureLayer(MemTable)
                MapControl1.Map.Layers.Add(lyr)
                lyr.Modifiers.Append(New FeatureOverrideStyleModifier("AntennaStyle", styleftr))
                MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(MemTable))
            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            Finally
                If Not con Is Nothing Then
                    con.Close()
                    con.Dispose()
                    con = Nothing
                End If
            End Try

        End If
    End Sub

    Public Sub Cell_Cluster_Map(ByVal tech As String, ByVal kpi As String, ByVal dt As DataTable, ByVal rowindex As Integer, ByVal minval As Double, ByVal maxval As Double, ByVal venodrname As String)
        Dim UpdateClusterTable As Boolean = False
        Dim connection As New MIConnection
        Try
            connection.Open()
            Dim ClusterTbl As String = "Cluster_" & Replace(tech, " ", "_")
            Dim field2search As String = "CELLID"
            'check if table exists
            Dim ctbl As Table = connection.Catalog.GetTable(ClusterTbl)
            Dim objs As String = Nothing
            If Not ctbl Is Nothing Then
                'check if table has same objects
                objs = kpi
                For Each dr As DataRow In dt.Rows
                    objs = objs + dr(0).ToString + ","
                Next

                If ctbl.CustomProperties.ContainsValue(objs) Then
                    UpdateClusterTable = True
                End If
            End If

            If UpdateClusterTable = False Then
                connection.Catalog.CloseTable(ClusterTbl)

                'constructing select string
                Dim sql_select As String = "SELECT "
                Dim sql_from As String = "FROM "
                Dim sql_where As String = "WHERE "
                Dim strObjInCluster As String = "IN("

                Dim cellsearch As String = ""

                If objfrmTechnology Is Nothing Then
                    If Not objFrmTechList.Exists(Function(x) x.Network.ToUpper.Equals(tech)) Then
                        frmMDI.OpenTechFormDynamically(tech, objfrmTechnology, False)
                    Else
                        objfrmTechnology = objFrmTechList.Where(Function(x) x.Network.Equals(tech)).LastOrDefault()
                    End If
                End If

                If tech.ToUpper = objfrmTechnology.Network.ToUpper Then
                    If Not dtCluster Is Nothing Then
                        dtCluster.Dispose()
                        dtCluster = Nothing
                    End If
                    cellsearch = objfrmTechnology.cmbObjectTreeStats.Text.ToString
                End If

                connection.Catalog.CloseTable(kpi)
                Dim ti As TableInfoAdoNet = New TableInfoAdoNet(kpi)
                ti.ReadOnly = True

                If tech.ToUpper = objfrmTechnology.Network.ToUpper Then
                    dtCluster = dt.Copy
                    ti.DataTable = dtCluster
                End If

                Dim table As Table = connection.Catalog.OpenTable(ti)
                Dim tbl As MapInfo.Data.Table = Nothing
                Dim tbl_map As MapInfo.Data.Table = Nothing

                For Each drow As DataRow In dt_Map_Configuration.Rows
                    Dim sql_select_final As String = ""
                    Dim sql_from_final As String = ""
                    Dim sql_where_final As String = ""
                    Dim sql_total As String = ""
                    tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim)

                    If drow.Item("LayerTech").ToString.ToUpper = tech.ToUpper And Not tbl Is Nothing Then
                        Try
                            field2search = drow("LayerColumn2Tree").ToString
                        Catch ex As Exception

                        End Try

                        sql_select_final = "SELECT " + tbl.Alias + ".SITECODE, " + tbl.Alias + "." + field2search + " , " + tbl.Alias + ".obj "
                        sql_from_final = sql_from + kpi & ", " + tbl.Alias + " "
                        If tech.ToLower.Contains("topx") Then
                            If cellsearch = flpSourceBtn_GetType(tech, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText Then
                                sql_where_final = sql_where + kpi & ".ObjectID = " + tbl.Alias + "." + field2search
                            ElseIf cellsearch = flpSourceBtn_GetType(tech, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText Then
                                sql_where_final = sql_where + kpi & ".ObjectID = " + tbl.Alias + ".SITECODE"
                            End If
                        Else
                            If cellsearch = flpSourceBtn_GetType(tech, "CELL", objfrmTechnology.flpCounterTypeStats).SourceButtonText Then
                                sql_where_final = sql_where + kpi & ".ObjectID = " + tbl.Alias + "." + field2search
                            ElseIf cellsearch = flpSourceBtn_GetType(tech, "SITE", objfrmTechnology.flpCounterTypeStats).SourceButtonText Then
                                sql_where_final = sql_where + kpi & ".ObjectID = " + tbl.Alias + ".SITECODE"
                            End If
                        End If

                        If sql_where_final <> "" Then
                            sql_total = sql_select_final + sql_from_final + sql_where_final
                            Dim command As MICommand = connection.CreateCommand()
                            Dim irfc As IResultSetFeatureCollection
                            command.CommandText = sql_total
                            irfc = command.ExecuteFeatureCollection()

                            If irfc.Count <> 0 Then
                                If connection.Catalog.GetTable(ClusterTbl) Is Nothing Then
                                    Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(ClusterTbl, MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                                    tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                                    tbl_map.InsertFeatures(irfc)
                                Else
                                    tbl_map = Session.Current.Catalog.GetTable(ClusterTbl)
                                    tbl_map.InsertFeatures(irfc)
                                End If
                                command.Dispose()
                            End If
                        End If
                    End If
                Next

                If tbl_map Is Nothing Then
                    connection.Close()
                    Exit Sub
                End If

                If cellsearch = flpSourceBtn_GetType(tech, "SITE", If(tech.ToLower.Contains("topx"), objfrmTechnology.flpCounterTypeTopX, objfrmTechnology.flpCounterTypeStats)).SourceButtonText Then
                    tbl_map.AddColumns(Nothing, BindType.Static, table, "ObjectID", [Operator].Equal, "SITECODE")
                Else
                    tbl_map.AddColumns(Nothing, BindType.Static, table, "ObjectID", [Operator].Equal, field2search)
                End If

                'Map the query
                If CountRowsInTable(tbl_map, False) > 0 Then
                    Dim lyr As New FeatureLayer(tbl_map)
                    'MapControl1.Map.Layers.Insert(0, lyr)
                    'MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)

                    'set view
                    MapControl1.Map.Layers.Add(lyr)
                    'Dim thm2 As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, kpi, kpi, minval, maxval, 8)
                    'Dim thm2 As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, kpi, kpi, 8, Thematics.DistributionMethod.EqualRangeSize)

                    Dim thm As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, kpi, kpi, 8, Thematics.DistributionMethod.CustomRanges)
                    thm.Bins(0).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, Color.DarkBlue, False)
                    thm.Bins(0).Style.AreaStyle.Interior = New SimpleInterior(2, Color.DarkBlue)

                    thm.InflectionColor = Color.FromArgb(168, Color.Yellow)
                    thm.InflectionIndex = 4
                    thm.Inflected = True
                    thm.Recompute()

                    'set bins
                    thm.ApplyStylePart = Thematics.StylePart.All
                    thm.SpreadBy = Thematics.SpreadByPart.Color
                    thm.RoundBy = 0.01

                    Dim delta As Double = (maxval - minval) / 8
                    For i = 0 To thm.Bins.Count - 1
                        thm.Bins(i).Min = Math.Round(minval + delta * i, 1)
                        thm.Bins(i).Max = Math.Round(minval + delta * (i + 1), 1)
                        Dim si As SimpleInterior = thm.Bins(i).Style.AreaStyle.Interior
                        Dim frcolor As Color = Color.FromArgb(168, si.ForeColor)

                        thm.Bins(i).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, frcolor, False)
                        thm.Bins(i).Style.AreaStyle.Interior = New SimpleInterior(si.Pattern, frcolor)
                    Next
                    thm.Recompute()
                    lyr.Modifiers.Append(thm)

                    Legend_CreateThematic(thm, "Cluster " & tech, kpi, lyr)

                    'MapInfo.Engine.Session.Current.MapFactory(0).SetView(lyr.Bounds, csysWGS84)
                    MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tbl_map))
                    tbl_map.CustomProperties.Add(1, objs)

                    'Dim legend As MapInfo.Mapping.Legends.Legend = MapControl1.Map.Legends(0)

                    legend_ac.Refresh()
                    legend_ac.Visible = True
                    Dim item As ToolStripButton = CType(Me.map_ToolStrip.Items("tlb_Legend"), ToolStripButton)
                    item.Checked = True

                End If
            Else
                If objfrmTechnology Is Nothing Then
                    If Not objFrmTechList.Exists(Function(x) x.Network.ToUpper.Equals(tech)) Then
                        frmMDI.OpenTechFormDynamically(tech, objfrmTechnology, False)
                    Else
                        objfrmTechnology = objFrmTechList.Where(Function(x) x.Network.Equals(tech)).LastOrDefault()
                    End If
                End If

                If tech.ToUpper = objfrmTechnology.Network.ToUpper Then
                    For Each drow As DataRow In dtCluster.Rows
                        For Each drow_new As DataRow In dt.Rows
                            If drow(0) = drow_new(0) Then
                                drow.BeginEdit()
                                drow(1) = drow_new(1)
                                drow.AcceptChanges()
                            End If
                        Next
                    Next
                End If

                Dim ctbl2 As Table = connection.Catalog.GetTable(ClusterTbl)
                ctbl2.Refresh()

                Dim lyr As FeatureLayer = MapControl1.Map.Layers.Item(ClusterTbl)
                Dim iEnumMod As System.Collections.IEnumerator = lyr.Modifiers.GetEnumerator
                iEnumMod.MoveNext()

                Dim ithm As MapInfo.Mapping.Thematics.IRangedTheme = iEnumMod.Current
                ithm.Recompute()

                legend_ac.Refresh()
            End If

            'legend
            connection.Close()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            connection.Close()
        End Try
    End Sub

