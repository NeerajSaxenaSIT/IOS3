    Private Sub SpinEditKpiSelHours_EditValueChanged(sender As Object, e As EventArgs) Handles SpinEditKpiSelHours.EditValueChanged
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Try
            If dtKpiInfoData IsNot Nothing Then

                Me.Cursor = Cursors.WaitCursor
                Application.DoEvents()

                Dim tech As String = tlKpiSelection.GetAllCheckedNodes().Where(Function(nd) nd.Level = 3)(0).Tag
                kpiCounterName = tlKpiSelection.GetAllCheckedNodes().Where(Function(nd) nd.Level = 3)(0)("ObjectName")
                Dim objectType As String = tlKpiSelection.GetAllCheckedNodes().Where(Function(nd) nd.Level = 3)(0)("ObjectType")

                If dtKpiInfoData.AsEnumerable().Where(Function(x) x.Field(Of Date)("Date") = CalendarKpiSelection.SelectionStart.AddHours(SpinEditKpiSelHours.EditValue)).Count > 0 Then
                    MapKPICounterForDayHour(tech, objectType, kpiCounterName)
                Else
                    SetStatus("No data found to map...")
                    RemoveLayerNoMapData(kpiCounterName)
                End If

            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

