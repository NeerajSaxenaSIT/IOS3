    Private Sub tvDriveTest_CellValueChanged(sender As Object, e As DevExpress.XtraTreeList.CellValueChangedEventArgs) Handles tvDriveTest.CellValueChanged
        Dim selectedNode As TreeListNode = e.Node
        If (e.Value IsNot Nothing) Then
            Try
                'If Not (e.Value = selectedNode.Item("ObjectName")) Then
                Dim nodeId As String = selectedNode.Tag
                If (selectedNode.Level = 1) Then
                    clsSQLCommands.ManageDTProject(conn_IOSDriveTestModule, "RENAMEPRJ", nodeId, e.Value)

                ElseIf (selectedNode.Level = 2) Then
                    clsSQLCommands.ManageDriveTest(conn_IOSDriveTestModule, "RENAMEDT", nodeId, e.Value)

                ElseIf (selectedNode.Level = 3) Then
                    clsSQLCommands.ManageDevice(conn_IOSDriveTestModule, "RENAMEDEVICE", nodeId, e.Value)

                End If
                LoadDriveTestTree()
                tvDriveTest.OptionsBehavior.Editable = False
                tvDriveTest.OptionsBehavior.ReadOnly = True
                'End If
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & "-" & ex.Message)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
            Finally
            End Try
        End If
    End Sub

