    Private Sub track_NBFilterTopXcell_ValueChanged(sender As Object, e As EventArgs) Handles track_NBFilterTopXcell.ValueChanged
        Dim bar As DevExpress.XtraEditors.TrackBarControl = DirectCast(sender, DevExpress.XtraEditors.TrackBarControl)
        Try
            lbl_NBFilterTopXcell.Text = Convert.ToString(CDbl((Math.Round(CDbl((CDbl(bar.Value) / 5)), 0) * 5)))
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

