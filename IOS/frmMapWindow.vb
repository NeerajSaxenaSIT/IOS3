                            If connection.Catalog.GetTable("NetworkStatus_Alarms_Map") Is Nothing Then
                                Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection("NetworkStatus_Alarms_Map", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                                tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                                tbl_map.InsertFeatures(irfc)
                            Else
                                tbl_map = Session.Current.Catalog.GetTable("NetworkStatus_Alarms_Map")
                                tbl_map.InsertFeatures(irfc)
                            End If
                            command.Dispose()
                        End If
                    End If
                End If
            Next

