    Dim clr As Color = Color.Empty
    Private Sub Calendar_GetNetworks_CustomDrawDayNumberCell(sender As Object, e As Calendar.CustomDrawDayNumberCellEventArgs) Handles Calendar_GetNetworks.CustomDrawDayNumberCell
        If lstNetworkDate.Count > 0 Then
            If lstNetworkDate.Contains(e.Date) Then
                e.Style.Font = New System.Drawing.Font(e.Style.Font, System.Drawing.FontStyle.Bold)
            End If
        End If

        If lstPreGenNetworkDate.Count > 0 Then
            If lstPreGenNetworkDate.Contains(e.Date) Then
                e.Style.Font = New System.Drawing.Font(e.Style.Font, System.Drawing.FontStyle.Underline)
            End If
        End If

        If lstNetworkDate.Count > 0 And lstPreGenNetworkDate.Count > 0 Then
            If lstNetworkDate.Contains(e.Date) And lstPreGenNetworkDate.Contains(e.Date) Then
                e.Style.Font = New System.Drawing.Font(e.Style.Font, System.Drawing.FontStyle.Bold Or System.Drawing.FontStyle.Underline)
            End If
        End If

        If e.Disabled = False And e.Holiday = False And e.Inactive = False And e.Selected = False And e.Today = False Then
            clr = e.Style.ForeColor
        End If
        If e.Holiday = True And e.Disabled = False And e.Inactive = False And clr <> Color.Empty Then
            e.Style.ForeColor = clr
        End If
    End Sub

