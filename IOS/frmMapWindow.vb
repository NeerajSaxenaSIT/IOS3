    Private Sub TRX_Get(ByVal tech As String, ByVal cellid As String)
        Try
            Dim parray2()() As String = {New String() {"@cell", "IN(" & cellid & ")"},
                                         New String() {"@iosgid", "IN(" & cellid & ")"}}
            Dim dsTRX As DataSet = Nothing

            Select Case tech.ToUpper
                Case networkAll.Network2G1.ToUpper
                    dsTRX = DataAccessorODBC.GetDataSet(GetSQL(1074, parray2)(0), GetSQL(1074, parray2)(1), iQryTimeOut)
                Case networkAll.Network2G2.ToUpper
                    dsTRX = DataAccessorODBC.GetDataSet(GetSQL(9050, parray2)(0), GetSQL(9050, parray2)(1), iQryTimeOut)
                Case networkAll.Network2G3.ToUpper
                    dsTRX = DataAccessorODBC.GetDataSet(GetSQL(20012, parray2)(0), GetSQL(20012, parray2)(1), iQryTimeOut)
            End Select

            Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData("TRX_Get_" & Replace(cellid, "'", ""))
            Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
            IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, dsTRX.Tables(0), "ALL")

            If Not dsTRX Is Nothing Then
                dsTRX.Dispose()
                dsTRX = Nothing
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally

        End Try
    End Sub

