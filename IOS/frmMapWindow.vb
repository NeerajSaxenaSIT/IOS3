    Private Sub GetServiceCheckForGeoLocation(sender As Object, e As EventArgs)
        Try
            Dim btnSrvChk As ToolStripButton = Me.map_ToolStrip.Items("btnSrvCheck")
            If btnSrvChk IsNot Nothing Then
                If btnSrvChk.CheckState = CheckState.Checked Then

                    ' Me.MapControl1.Cursor = Cursors.Cross
                    '   Application.DoEvents()

                    '  frmServiceCheck.frmServiceCheck_Load(Nothing, Nothing)

                    objFrmSvcCheck = New frmServiceCheck()

                    If objFrmSvcCheck.Visible = False Then
                        objFrmSvcCheck.networkArea = cmbNetworkArea.Text.Trim
                        objFrmSvcCheck.TopLevel = False
                        objFrmSvcCheck.TopMost = True
                        frmMDI.Controls.Add(objFrmSvcCheck)
                        objFrmSvcCheck.Top = Me.Location.Y + Me.Size.Height - objFrmSvcCheck.Height + 55
                        objFrmSvcCheck.Left = Me.Location.X + Me.accMapExplorerBar.Width + 20
                        objFrmSvcCheck.Show()
                        objFrmSvcCheck.BringToFront()
                    End If

                    'objFrmSvcCheck = New frmServiceCheck()
                    'objFrmSvcCheck.TopLevel = False
                    'objFrmSvcCheck.TopMost = True

                    ' ' objFrmSvcCheck.Top = Me.Location.Y + Me.Size.Height - objFrmSvcCheck.Size.Height + 45
                    'objFrmSvcCheck.Left = Me.Location.X + Me.accMapExplorerBar.Width + 20

                    ' objFrmSvcCheck.Show()
                    ' objFrmSvcCheck.BringToFront()

                    'objFrmSvcCheck.Latitude = MapCoordinates.Split(",")(0)
                    'objFrmSvcCheck.Longitude = MapCoordinates.Split(",")(1)
                    'objFrmSvcCheck.txtGeoCoderSearch.Text = MapCoordinates
                Else
                    RemoveHandler btnSrvChk.Click, AddressOf GetServiceCheckForGeoLocation

                    objFrmSvcCheck.Close()
                    objFrmSvcCheck = Nothing

                    'clear thematics
                    CloseMapTables_RemoveLayerModifiers()
                    RemoveLabelLayers()
                    MapControl1.Map.Legends.Clear()

                    Me.MapControl1.Cursor = Cursors.Arrow
                    Application.DoEvents()
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally

        End Try
    End Sub

