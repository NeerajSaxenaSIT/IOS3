    Private Sub CNE_CellFootPrint(ByVal ios_cell_gids As String, ByVal mapfield As String)
        Try
            Dim ds As DataSet = CNE_GetData(mapfield & " IN(" & ios_cell_gids & ")", True)

            For Each tbl As MapInfo.Data.Table In Session.Current.Catalog
                If tbl.Alias.StartsWith("CNE_GEOAGG_CF_") Or tbl.Alias.StartsWith("CNE_RAW_CF_") Then
                    tbl.Close()
                End If
            Next

            If Not ds Is Nothing AndAlso ds.Tables.Count > 0 AndAlso ds.Tables(0).Rows.Count > 0 Then

                If rbCNESourceRaw.Checked = True Then

                    Dim tn As String = "CNE_RAW_CF_Selection"
                    If Not ios_cell_gids.Contains(",") Then
                        tn = "CNE_RAW_CF_" + Replace(ios_cell_gids, "'", "")
                    End If

                    ds.Tables(0).TableName = tn
                    Dim GridCtrlMap As DevExpress.XtraGrid.GridControl = Me.CreateTabWithGridViewForMapData(ds.Tables(0).TableName)
                    Dim GridViewMap As New DevExpress.XtraGrid.Views.Grid.GridView()
                    GridCtrlMap.MainView = GridViewMap
                    GridViewMap.GridControl = GridCtrlMap
                    GridCtrlMap.ViewCollection.Add(GridViewMap)
                    IOSDevExpressGrid.PopulateDataInGrid(GridCtrlMap, GridViewMap, ds.Tables(0), "ALL")
                    CNE_MapRawEvents(ds.Tables(0), True)
                    For Each item In draggedKPIList
                        CNE_CreateThematic(item, tn)
                    Next

                Else

                    Dim tn As String = "CNE_GEOAGG_CF_Selection"
                    If Not ios_cell_gids.Contains(",") Then
                        tn = "CNE_GEOAGG_CF_" + Replace(ios_cell_gids, "'", "")
                    End If
                    ds.Tables(0).TableName = tn

                    Dim GridCtrlMap As DevExpress.XtraGrid.GridControl = Me.CreateTabWithGridViewForMapData(ds.Tables(0).TableName)
                    Dim GridViewMap As New DevExpress.XtraGrid.Views.Grid.GridView()
                    GridCtrlMap.MainView = GridViewMap
                    GridViewMap.GridControl = GridCtrlMap
                    GridCtrlMap.ViewCollection.Add(GridViewMap)
                    IOSDevExpressGrid.PopulateDataInGrid(GridCtrlMap, GridViewMap, ds.Tables(0), "ALL")
                    CNE_MapGeoAgg(ds.Tables(0), True)
                    For Each item In draggedKPIList
                        CNE_CreateThematic(item, tn)
                    Next

                End If
            Else
                If ds Is Nothing Then
                    SetStatus("No Data in Result - Query Problem - Check with Admin")
                Else
                    SetStatus("No Data in Result - Check Zoom/Filters/Resolution")
                End If
            End If

        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

