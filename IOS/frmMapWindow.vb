    Private Function Get_IN_SelectedIOSGID(Optional ByVal tech As String = Nothing) As String
        Dim str2 As String = "IN("
        Dim enumerator As ITableEnumerator = Session.Current.Catalog.GetEnumerator
        Do While enumerator.MoveNext
            Dim table As Table = enumerator.Current
            Dim features As IResultSetFeatureCollection = Session.Current.Selections.DefaultSelection.Item(table)
            Try
                If ((Not features Is Nothing) And Me.Layer_InMapConfiguration(table.Alias)) Then
                    Dim enumerator2 As IEnumerator = Nothing
                    Try
                        enumerator2 = features.GetEnumerator
                        Do While enumerator2.MoveNext
                            Dim current As Feature = DirectCast(enumerator2.Current, Feature)
                            If (tech Is Nothing) Then
                                str2 = (str2 & "'" & current.Item("IOS_CELL_GID").ToString & "', ")
                            ElseIf (Me.Layer_Tech(table.Alias).ToUpper = tech.ToUpper) Then
                                str2 = (str2 & "'" & current.Item("IOS_CELL_GID").ToString & "', ")
                            End If
                        Loop
                    Finally
                        If TypeOf enumerator2 Is IDisposable Then
                            TryCast(enumerator2, IDisposable).Dispose()
                        End If
                    End Try
                End If
                Continue Do
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                Continue Do
            End Try
        Loop
        Return (str2.TrimEnd(New Char() {" "c}).TrimEnd(New Char() {","c}) & ")")
    End Function

    Public Function ColumnString_DataTable(ByVal tablename As String, ByVal dt As DataTable) As String
        Dim str As String
        str = ""
        For Each col As DataColumn In dt.Columns
            str = str & tablename & "." & col.ColumnName & ","
        Next col
        Return str.TrimEnd(",")
    End Function

