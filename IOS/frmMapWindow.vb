    Public Sub LayerControl_ApplyClicked(ByVal sender As Object, ByVal e As System.EventArgs)
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Dim filter As FilterByLayerType = GetLayerFilterType()
        ShowHideLegandsWithLayer(filter)
        Dim fe As FeatureLayer
        Dim extraType(0) As System.Type
        For Each t As IMapLayer In MapControl1.Map.Layers.GetMapLayerEnumerator(filter)
            Try
                fe = CType(t, FeatureLayer)
                If (fe.Modifiers.Count > 0) Then
                    Dim m As New IOSStyleModifier()
                    m.FeatureLayer = fe
                    m.LayerName = fe.Alias

                    Dim legands As MapInfo.Mapping.Legends.LegendFactory = MapControl1.Map.Legends
                    For Each Item As MapInfo.Mapping.Legends.Legend In legands
                        For Each f As MapInfo.Mapping.Legends.ThemeLegendFrame In Item.Frames
                            Dim a As String = f.Theme.Table.Alias
                            f.Visible = False
                            If (a = fe.Alias) Then
                                Dim legand As New IOSLegandInfo()
                                legand.LayerName = fe.Alias
                                legand.ThemeName = f.Theme.Alias
                                legand.Header = f.Title
                                legand.SubHeader = f.SubTitle
                                m.ILegendList.Add(legand)
                            End If
                        Next
                    Next
                    Dim p As String = path + "\\" + fe.Alias + ".data"
                    If System.IO.File.Exists(p) Then
                        System.IO.File.Delete(p)
                    End If
                    Dim stream As System.IO.FileStream = System.IO.File.Create(p)
                    Dim formatter As New BinaryFormatter()
                    formatter.Serialize(stream, m)
                    stream.Close()
                End If
            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try
        Next
        RefreshQuickThemeControl()
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

