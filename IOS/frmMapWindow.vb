    Private Sub CNE_FilterTemplate_Add(ByVal Templatename As String, ByVal resolution As String)
        Dim sql_insert As String = Nothing
        Dim connstring As String = Nothing

        Dim tech As String = Nothing
        For Each chk As CheckEdit In gcCNETechFilter.Controls
            If chk.Checked = True Then
                tech = tech & "'" & chk.Tag & "',"
            End If
        Next

        If tech <> "" Then
            tech = tech.Substring(0, tech.Length - 1)
        End If

        If tech.ToString.Contains(",") Or tech = "" Then
            MsgBox("Analysis can only be assigned to 1 Technology. Make sure 1 technology checkbox is checked !", vbExclamation)
            Exit Sub
        End If

        Try
            Dim parray()() As String = {
                New String() {"@TemplateName", Chr(39) & Templatename & Chr(39)},
                New String() {"@Tech", tech},
                New String() {"@userid", Chr(39) & Environment.UserName.ToString & Chr(39)},
                New String() {"@RawOrAgg", Chr(39) & resolution & Chr(39)}
            }
            'New String() {"@datasource", CType(cmb_DataSource.SelectedItem, clsComboBoxItem).Value}

            sql_insert = GetSQL(8900, parray)(1)
            connstring = GetSQL(8900, parray)(0)
            cneFilterTemplateID = DataAccessorODBC.GetDataTable(connstring, sql_insert, iQryTimeOut).Rows(0)("CNEFilterTemplateID")
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        Finally

        End Try
    End Sub

