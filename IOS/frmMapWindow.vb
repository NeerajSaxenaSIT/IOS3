    Private Sub SearchLacOfCell(ByVal cell As String)
        'loop through tables
        Try
            Dim currentzoom As Distance
            currentzoom = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)

            Dim connection As New MIConnection
            connection.Open()
            Dim command As MICommand = connection.CreateCommand()

            cmbSearchLac.Properties.Items.Clear()

            Dim tbl As MapInfo.Data.Table = Nothing
            Dim irfc As IResultSetFeatureCollection = Nothing
            Dim sql_string As String = Nothing
            Dim LacOrTac As String = "LAC"

            For Each drow As DataRow In dt_Map_Configuration.Rows
                Dim lyr As FeatureLayer = CType(MapControl1.Map.Layers(drow("LayerName").ToString), FeatureLayer)
                If Not lyr Is Nothing Then
                    If drow("LayerActive").ToString = True And lyr.Enabled = True Then
                        tbl = Session.Current.Catalog.GetTable(drow("LayerName").ToString.Trim)
                        If Not tbl Is Nothing Then
                            If drow("LayerTech").contains("4G") Then
                                LacOrTac = "TAC"
                            Else
                                LacOrTac = "LAC"
                            End If
                            sql_string = "SELECT " & tbl.Alias & "." & LacOrTac & " FROM " & tbl.Alias & " WHERE " & tbl.Alias & ".CELLID = " & Chr(39) & cell & Chr(39) & " GROUP BY " & tbl.Alias & "." & LacOrTac

                            command.CommandText = sql_string
                            irfc = command.ExecuteFeatureCollection

                            If irfc.Count <> 0 Then
                                For Each ftr As Feature In irfc
                                    cmbSearchLac.Properties.Items.Add(ftr.Item(LacOrTac).ToString)
                                Next
                            End If

                        End If
                    End If
                End If
            Next

            If Not connection Is Nothing Then
                connection.Close()
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus("SearchLACofCells: Problem retrieving LAC values for " & cell & "%")
        End Try
    End Sub

