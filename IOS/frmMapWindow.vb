                        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                        Exit Sub
                    End Try
                    _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "After Search LAC or TAC")
                    If Not tblTemp1 Is Nothing And Not lyr Is Nothing Then
                        Dim dps(1) As MapInfo.Geometry.DPoint
                        dps(0).x = rows(0)("x")
                        dps(0).y = rows(0)("y")
                        dps(0) = TransformPointWGS84ToDisplay(dps(0))

                        'If tlb_ParcelSelectorFlag Then
                        Dim ftg As FeatureGeometry = Cell_LAC_SearchAndReturnGeo(cellid, lac, searchColumnsName)
                        If Not (ftg Is Nothing) Then
                            dps(1) = TransformPointWGS84ToDisplay(ftg.Centroid)
                            Dim ln As FeatureGeometry = New MapInfo.Geometry.MultiCurve(MapControl1.Map.GetDisplayCoordSys, CurveSegmentType.Linear, dps)
                            Dim lstyle As SimpleLineStyle = Nothing
                            lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 2, System.Drawing.Color.Violet)
                            Dim cs As New CompositeStyle(lstyle)
                            Dim ftr As New Feature(tblTemp1.TableInfo.Columns)
