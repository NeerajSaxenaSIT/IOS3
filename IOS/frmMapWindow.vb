    Private Sub RemoveLayerNoMapData(_kpiCounterName)
        Try
            Dim modifierToDelete As FeatureStyleModifier = Nothing
            Dim layerToDelete As FeatureLayer = Nothing

            For Each layer As MapLayer In MapControl1.Map.Layers
                Dim featureLayer As FeatureLayer = Me.IsValidLayer(layer)
                If Not featureLayer Is Nothing Then
                    If featureLayer.Name.Contains(_kpiCounterName & "_Map") Then
                        layerToDelete = featureLayer
                        Exit For
                    End If
                End If
            Next

            If Not layerToDelete Is Nothing Then
                MapControl1.Map.Layers.Remove(layerToDelete)
                MapControl1.Refresh()
                If Not legend_ac Is Nothing Then
                    legend_ac.Refresh()
                End If
            End If
        Catch
        End Try
    End Sub

    Function IsValidLayer(ByRef layer As MapLayer) As FeatureLayer
        Return TryCast(layer, FeatureLayer)
    End Function

    Public Sub KPIInfo_KPICounter_Mapping(tech As String, objectType As String, kpi As String, dt As DataTable,
                                          themeExpression As String, layrePrefix As String, Optional kpiInfoMaptoVoronoi As Boolean = False,
                                          Optional MapToSite As Boolean = False, Optional MapToEachLayer As Boolean = False)
        Dim connection As New MIConnection
        Try
            WaitScreen.ShowWaitScreen("Mapping KPI...")
            'SetStatus("Mapping KPI...")

            connection.Open()
            Dim topxtbl As String = layrePrefix & Replace(tech, " ", "_") & "_" & kpi
            connection.Catalog.CloseTable(kpi)
            PrevKpiTable = kpi
            connection.Catalog.CloseTable(topxtbl & "_Map")
            PrevLayerName = topxtbl & "_Map"
            connection.Catalog.CloseTable(themeExpression)

            'truncate 30 
            For Each dcol As DataColumn In dt.Columns
                If dcol.ColumnName.Length >= 30 Then
                    If dcol.ColumnName = themeExpression Then
                        themeExpression = dcol.ColumnName.Substring(0, 27) + dcol.Ordinal.ToString
                    End If
                    dcol.ColumnName = dcol.ColumnName.Substring(0, 27) + dcol.Ordinal.ToString
                End If
            Next

            'constructing select string
            Dim sql_select As String = "SELECT "
            Dim sql_from As String = "FROM "
            Dim sql_where As String = "WHERE "

            For Each dcol As DataColumn In dt.Columns
                sql_select = sql_select + kpi + "." + dcol.ColumnName.ToString & ", "
            Next

            Dim cellsearch As String = ""

            'Find Out Object of Respective form with the help of Vender and Tech
            'objfrmTechnology = Nothing
            'frmMDI.OpenTechFormDynamically(tech, objfrmTechnology, False)

            'If objfrmTechnology IsNot Nothing Then
            If tech.ToLower = networkAll.Network3G1.ToLower Then
                If sql_select.Contains(objectType) Then   'flpSourceBtn_GetType(networkAll.Network3G1, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                    cellsearch = objectType 'flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                Else
                    cellsearch = objectType 'flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                    If IOSAppConfigManage.DeploymentName = "TMNL" Then
                        For Each drow As DataRow In dt.Rows
                            drow.BeginEdit()
                            drow.Item(objectType) = drow(objectType).ToString.Substring(0, 5) 'flpSourceBtn_GetType(objfrmTechnology.Network, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                            drow.AcceptChanges()
                            drow.EndEdit()
                        Next
                    End If
                End If
            ElseIf tech.ToLower = networkAll.NetworkTX.ToLower Or tech.ToLower = networkAll.NetworkTX2.ToLower Then
                If sql_select.Contains(objectType) Then   'flpSourceBtn_GetType(objfrmTechnology.Network, "LINK", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                    cellsearch = objectType 'flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "LINK", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                End If
            Else 'If tech.ToLower = objfrmTechnology.Network.ToLower Then
                If sql_select.Contains(objectType) Then   'flpSourceBtn_GetType(objfrmTechnology.Network, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                    cellsearch = objectType 'flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                Else
                    cellsearch = objectType 'flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                End If
            End If
            'End If

            Dim ti As TableInfoAdoNet = New TableInfoAdoNet(kpi)
            ti.ReadOnly = True
            ti.DataTable = dt

            Dim table As Table = connection.Catalog.OpenTable(ti)

            Dim tbl As MapInfo.Data.Table = Nothing
            Dim tbl_map As MapInfo.Data.Table = Nothing

            If MapToSite = False Then
                For Each drow As DataRow In dt_Map_Configuration.Rows
                    Dim sql_select_final As String = ""
                    Dim sql_from_final As String = ""
                    Dim sql_where_final As String = ""
                    Dim sql_total As String = ""
                    If kpiInfoMaptoVoronoi = True Then
                        tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim & "_Voronoi")
                    Else
                        tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim)
                    End If

                    If (drow.Item("LayerTech").ToString.ToUpper = tech.ToUpper And Not tbl Is Nothing) Then
                        Dim field2search As String = "CELLID"
                        Try
                            Dim colToMap As String = drow("LayerColumn2Tree").ToString
                            If (Not String.IsNullOrEmpty(colToMap)) Then
                                field2search = colToMap
                            End If
                        Catch ex As Exception

                        End Try
                        sql_select_final = sql_select + " " + tbl.Alias + ".obj "

                        sql_from_final = sql_from + kpi & ", " + tbl.Alias + " "

                        If cellsearch = objectType Then   'flpSourceBtn_GetType("topx_" & tech, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                            sql_where_final = sql_where + kpi & "." + cellsearch + " = " + tbl.Alias + "." & field2search
                            'ElseIf cellsearch = objectType Then 'flpSourceBtn_GetType("topx_" & tech, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText Then
                            '    sql_where_final = sql_where + "UPPER(" + kpi & "." + cellsearch + ") = UPPER(" + tbl.Alias + ".SiteCode)"
                            'ElseIf cellsearch = objectType Then 'flpSourceBtn_GetType("topx_" & tech, "LINK", objfrmTechnology.flpCounterTypeTopX).SourceButtonText Then
                            '    sql_where_final = sql_where + kpi & "." + cellsearch + " = " + tbl.Alias + "." & field2search
                        End If

                        sql_total = sql_select_final + sql_from_final + sql_where_final
                        Dim command As MICommand = connection.CreateCommand()
                        Dim irfc As IResultSetFeatureCollection
                        command.CommandText = sql_total
                        If MapToEachLayer = False Then
                            irfc = command.ExecuteFeatureCollection()
                        Else
                            irfc = command.ExecuteFeatureCollection(drow.Item("LayerName").ToString & "_" & kpi & "_Map")
                        End If

                        If irfc.Count <> 0 Then
                            If MapToEachLayer = False Then
                                If connection.Catalog.GetTable(topxtbl & "_Map") Is Nothing Then
                                    Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(topxtbl & "_Map", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                                    tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                                    tbl_map.InsertFeatures(irfc)
                                Else
                                    tbl_map = Session.Current.Catalog.GetTable(topxtbl & "_Map")
                                    tbl_map.InsertFeatures(irfc)
                                End If
                                command.Dispose()
                            Else
                                Try
                                    Dim lyr As New FeatureLayer(irfc.Table)
                                    MapControl1.Map.Layers.Insert(0, lyr)
                                    Dim lyr2 As FeatureLayer = CType(MapControl1.Map.Layers(tbl.Alias), FeatureLayer)
                                    Layer_View(irfc.Alias, lyr2.Enabled)
                                    MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)

                                    'If topxmaptype = 1 Then
                                    '    Dim thm1 As MapInfo.Mapping.Thematics.GraduatedSymbolTheme = New MapInfo.Mapping.Thematics.GraduatedSymbolTheme(lyr.Table, themeExpression)
                                    '    Try
                                    '        Dim linecolor As Integer = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerName") = tbl.Alias).ToArray()(0)("LayerLineColor")
                                    '        thm1.PositiveSymbol.Color = ColorInt2Color(linecolor)
                                    '    Catch ex As Exception

                                    '    End Try

                                    '    Dim objthm As ObjectThemeLayer = New ObjectThemeLayer(lyr.Table.Alias, Nothing, thm1)
                                    '    'Dim objthm As ObjectThemeLayer = New ObjectThemeLayer(themeExpression, Nothing, thm1)
                                    '    MapControl1.Map.Layers.Add(objthm)
                                    '    objthm.RebuildTheme()
                                    '    Legend_CreateThematic(thm1, themeExpression, lyr)
                                    '    MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(lyr.Table))
                                    'Else

                                    legendMappingDate = CDate(dt.Rows(0)("Date")).ToString("dd/MM/yyyy HH:mm:ss")
                                    ApplyRangeTheme(False, lyr, themeExpression, Nothing, dtKpiInfoThemeBins, dtKpiInfoThemeBins.Rows.Count)
                                    MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(lyr.Table))
                                    'End If
                                Catch ex As Exception

                                End Try
                            End If
                        End If
                    End If
                Next
            Else
                Dim technology As String = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerTech") = tech).ToArray()(0)("LayerTechnology").ToString.ToUpper

                Dim SiteTable As String = "Sites_" & technology
                Dim sql_select_final As String = ""
                Dim sql_from_final As String = ""
                Dim sql_where_final As String = ""
                Dim sql_total As String = ""

                If kpiInfoMaptoVoronoi = True Then
                    tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(SiteTable & "_Voronoi")
                Else
                    tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(SiteTable)
                End If

                If Not tbl Is Nothing Then

                    sql_select_final = sql_select + " " + tbl.Alias + ".obj "

                    sql_from_final = sql_from + kpi & ", " + tbl.Alias + " "
                    sql_where_final = sql_where + kpi & "." + cellsearch + " = " + tbl.Alias + ".SiteCode"
                    sql_total = sql_select_final + sql_from_final + sql_where_final
                    Dim command As MICommand = connection.CreateCommand()
                    Dim irfc As IResultSetFeatureCollection
                    command.CommandText = sql_total
                    irfc = command.ExecuteFeatureCollection()

                    If irfc.Count <> 0 Then
                        If connection.Catalog.GetTable(topxtbl & "_Map") Is Nothing Then
                            Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(topxtbl & "_Map", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                            tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                            tbl_map.InsertFeatures(irfc)
                        Else
                            tbl_map = Session.Current.Catalog.GetTable(topxtbl & "_Map")
                            tbl_map.InsertFeatures(irfc)
                        End If
                        command.Dispose()
                    End If
                End If
            End If

            If tbl_map Is Nothing Then
                connection.Close()
                Exit Sub
            End If

            'Map the query
            If CountRowsInTable(tbl_map, False) > 0 And MapToEachLayer = False Then
                Dim lyr As New FeatureLayer(tbl_map)
                'set view
                'If topxmaptype = 1 Then
                '    Dim thm1 As MapInfo.Mapping.Thematics.GraduatedSymbolTheme = New MapInfo.Mapping.Thematics.GraduatedSymbolTheme(lyr.Table, themeExpression)
                '    If (themeExpression.ToUpper = "ParamHistoryMap".ToUpper) Then
                '        If (tech.ToUpper.Contains("2G")) Then
                '            thm1.PositiveSymbol = New MapInfo.Styles.SimpleVectorPointStyle(46, Color.Red, 36)
                '        End If
                '        If (tech.ToUpper.Contains("3G")) Then
