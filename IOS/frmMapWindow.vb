    Private Sub gvKpiSelFilter_KeyDown(sender As Object, e As KeyEventArgs) Handles gvKpiSelFilter.KeyDown
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Try
            If e.KeyCode = Keys.Delete Then
                If XtraMessageBox.Show("Are you sure to remove selected filter(s) from the list?", "Remove Filter!", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Warning) = DialogResult.Yes Then
                    Dim gv As GridView = DirectCast(sender, GridView)
                    Dim rIndex() As Integer = gv.GetSelectedRows()
                    If rIndex.Count > 0 Then
                        For iCntr = 0 To rIndex.Count - 1
                            Dim dr As DataRow = gv.GetDataRow(rIndex(iCntr))
                            dtKpiInfoFilter.Rows.Remove(dr)
                        Next
                        If gv.RowCount = 0 Then
                            dtKpiInfoFilter.Rows.Clear()
                            dtKpiInfoFilter.AcceptChanges()
                        End If
                    End If
                End If
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

