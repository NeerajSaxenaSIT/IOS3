    Private Sub MapControl1_MouseMove(ByVal sender As Object, ByVal e As MouseEventArgs)
        Dim item As ToolStripMenuItem = CType(tlb_ParcelSelector.DropDownItems(1), ToolStripMenuItem)
        'If parcelselectmenu.MenuItems(1).Checked = True Then
        If item.Checked Then
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            Dim newPoint As New MapInfo.Geometry.DPoint(0, 0)
            MapControl1.Map.DisplayTransform.FromDisplay(New System.Drawing.PointF(e.X, e.Y), newPoint)
            Dim pt As New MapInfo.Geometry.Point(Me.MapControl1.Map.GetDisplayCoordSys(), newPoint.x, newPoint.y)

            Dim connection As New MapInfo.Data.MIConnection
            connection.Open()
            Dim i As Int16 = 0

            Try
                Dim fl As FeatureLayer = TopDrivetestLayer()
                If fl.Enabled = True And fl.Type <> LayerType.Raster Then
                    If fl.VisibleRangeEnabled = True And fl.VisibleRange.Within(Me.MapControl1.Map.Zoom) Or fl.VisibleRangeEnabled = False Then
                        'if the layer is visible within the current map

                        Dim command As MapInfo.Data.MICommand = connection.CreateCommand()
                        command.CommandText = "Select * from " & fl.Table.Alias & " where @pt intersects Obj"
                        Dim geoCol As MapInfo.Data.GeometryColumn = fl.Table.TableInfo.Columns(GetGeoColIndexOfFeatureLayer(fl))
                        If geoCol.PredominantGeometryType.ToString() = "Point" Or geoCol.PredominantGeometryType.ToString() = "MultiPoint" Then
                            'Checks to see if the table is a table of Points or MultiPoints. This buffer will be used for these features as 'well.
                            command.Parameters.Add("@pt", pt.Buffer(Me.MapControl1.Map.Zoom.Value / 200, MapInfo.Geometry.DistanceUnit.Mile, 99))
                        Else
                            command.Parameters.Add("@pt", pt)
                        End If

                        Dim irfc As MapInfo.Data.IResultSetFeatureCollection = command.ExecuteFeatureCollection()

                        For Each f As MapInfo.Data.Feature In irfc
                            If LastParcelTouched <> CLng(nZ(f("ParcelID"), "0")) Then
                                LastParcelTouched = CLng(nZ(f("ParcelID"), "0"))
                                DT_CreateLineSourceTable(fl.Alias)
                                DT_CreateLineFeatures2(fl.Alias, f)
                            End If
                        Next

                        'mfc.Add(irfc)
                        command.Dispose()
                        irfc.Close()
                        'Console.WriteLine(mfc.Item(0).Alias)
                    End If
                End If
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                'Console.Write(fl.Table.Alias)
                'Console.WriteLine(ex)
            Finally
                i = i + 1
                connection.Close()
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
            End Try
        End If

        If isMiddleButtonDown Then
            Dim dx As Integer = e.X - startMousePosition.X
            Dim dy As Integer = e.Y - startMousePosition.Y

            ' Calculate the new center coordinates based on mouse movement
            Dim displayUnitsPerPixelX As Double = MapControl1.Map.Bounds.Width / MapControl1.Width
            Dim displayUnitsPerPixelY As Double = MapControl1.Map.Bounds.Height / MapControl1.Height

            Dim newCenterX As Double = startMapCenter.x - dx * displayUnitsPerPixelX
            Dim newCenterY As Double = startMapCenter.y + dy * displayUnitsPerPixelY

            Dim newCenter As New DPoint(newCenterX, newCenterY)

            ' Set the new center
            MapControl1.Map.Center = newCenter
        End If
    End Sub

    Function TopDrivetestLayer() As FeatureLayer
        For Each fl As MapLayer In Me.MapControl1.Map.Layers
            If (fl.Alias.Contains("DT_") And fl.IsVisible) And Not fl.Alias.Contains("Event") Then
                Return fl
            End If
        Next
        Return Nothing
    End Function

