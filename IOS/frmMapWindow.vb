    Public Function Cell_BCC_SearchAndReturnGeo(ByVal bcchSearch As String, ByVal nccSearch As String, ByVal bccSearch As String) As MapInfo.Data.Table
        If (bcchSearch = "" Or nccSearch = "" Or bccSearch = "") Then
            Return Nothing
        End If
        Dim connection As MIConnection = New MIConnection
        connection.Open()
        Try
            Dim strComand As String = Nothing
            Dim bcchParame As String() = bcchSearch.Split(",")
            Dim nccParame As String() = nccSearch.Split(",")
            Dim bccParame As String() = bccSearch.Split(",")

            For value As Integer = 0 To bcchParame.Length - 1
                strComand += "(BCCH=" & bcchParame(value) & " and NCC=" & nccParame(value) & " and BCC=" & bccParame(value) & ")"
                If (value < bcchParame.Length - 1) Then
                    strComand += " Or "
                End If
            Next

            Dim found As Boolean = False
            Dim tbl As MapInfo.Data.Table
            Dim tbl_cells As MapInfo.Data.Table = Nothing
            Dim tbl_cells_name As String = "DT_CellsSearch"
            connection.Catalog.CloseTable(tbl_cells_name)

            For Each drow As DataRow In dt_Map_Configuration.Rows
                Try
                    Dim itemSelect As ToolStripMenuItem = CType(tlb_ParcelSelector.DropDownItems(2), ToolStripMenuItem)
                    Dim itemHover As ToolStripMenuItem = CType(tlb_ParcelSelector.DropDownItems(1), ToolStripMenuItem)
                    If drow("LayerActive").ToString = True And (itemSelect.Checked Or itemHover.Checked) = True Then
                        tbl = Session.Current.Catalog.GetTable(drow("LayerName").ToString.Trim)
                        If Not tbl Is Nothing Then
                            If MapControl1.Map.Layers(tbl.Alias).Enabled Then
                                If (drow("LayerTech").ToString.Trim.Equals("2G")) Then
                                    Dim command As MICommand = connection.CreateCommand()
                                    Dim irfc As IResultSetFeatureCollection

                                    'command.CommandText = "SELECT CELLID, LAC,BCCH,NCC,BCC, SECTORTYPE, obj FROM  " & tbl.Alias & " WHERE BCCH " & bcchSearch & " AND NCC " & nccSearch & " AND BCC " & bccSearch
                                    command.CommandText = "SELECT CELLID,LAC,BCCH,NCC,BCC, SECTORTYPE, obj FROM  " & tbl.Alias & " WHERE " & strComand

                                    irfc = command.ExecuteFeatureCollection()

                                    If irfc.Count <> 0 Then
                                        If connection.Catalog.GetTable(tbl_cells_name) Is Nothing Then
                                            Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(tbl_cells_name, MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                                            tbl_cells = Session.Current.Catalog.CreateTable(ti_memtbl)
                                            tbl_cells.InsertFeatures(irfc)
                                        Else
                                            tbl_cells = Session.Current.Catalog.GetTable(tbl_cells_name)
                                            tbl_cells.InsertFeatures(irfc)
                                        End If
                                        command.Dispose()
                                    End If
                                    irfc.Close()
                                End If
                            End If
                        End If
                    End If
                Catch
                End Try
            Next

            Return tbl_cells
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Return Nothing
        End Try
    End Function

