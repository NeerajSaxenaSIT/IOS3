    Private Sub CellFootPrint(ByVal cellid As String, ByVal tacLacValue As String, ByVal sectortype As String, ByVal tech As String)
        'fetch data
        Try
            Dim sql As String = ""
            Dim tblname As String = ""
            Dim prm As String = ""
            Dim data1 As New System.Data.DataTable()
            Dim timeStamp As String

            Dim timeStampParameters As List(Of Odbc.OdbcParameter) = GetTimeStampParameters()
            timeStamp = "where LAC in(" & tacLacValue & ") AND CellId in (" & cellid & ") and TimeStamp > ? and timestamp < ? "

            Select Case True
                Case tech.Contains("2G")
                    If (Me.cellFootPrintSelectedType = CellFootPrintType.Scanner) Then
                        sql = "select sc2g.* from DT_Scan2G_Serial sc2g Inner join (select parcelID,CellId, LAC, MAX(timestamp) as timestamp from DT_Scan2G_Serial "
                        sql += timeStamp & "group by parcelID,CellId, LAC) temp2G on "
                        sql += "sc2g.CellId = temp2G.CellId And sc2g.parcelID = temp2G.parcelID And sc2g.LAC = temp2G.LAC And sc2g.TimeStamp = temp2G.timestamp"

                        tblname = "CF_" & sectortype & "_Scan"
                    Else
                        sql = "select ue2g.* from DT_UE2G_Serial ue2g Inner join (select parcelID,CellId, LAC, MAX(timestamp) as timestamp from DT_UE2G_Serial "
                        sql += timeStamp & "group by parcelID,CellId, LAC) temp2G on ue2g.CellId = temp2G.CellId And ue2g.parcelID = temp2G.parcelID"
                        sql += " and ue2g.LAC= temp2G.LAC and ue2g.TimeStamp= temp2G.timestamp"

                        tblname = "CF_" & sectortype & "_UE"
                    End If
                    prm = "RxLevAvg"

                Case tech.Contains("3G")
                    Dim sqlCount As String = String.Empty
                    If (Me.cellFootPrintSelectedType = CellFootPrintType.Scanner) Then

                        sql = "select sc3g.*,CASE WHEN [RANK]=1 AND Threshold_PP=1 THEN 'Rank=1 and PP Threshold=True'  WHEN [RANK]=2 AND Threshold_PP=1 THEN 'Rank=2 and PP Threshold=True' WHEN [RANK]=2 AND Threshold_PP=0 THEN 'Rank=2 and PP Threshold=False' WHEN [RANK]=3 AND Threshold_PP=1 THEN 'Rank=3 and PP Threshold=True' WHEN [RANK]=3 AND Threshold_PP=0 THEN 'Rank=3 and PP Threshold=False' WHEN [RANK]>3 AND Threshold_PP=1 THEN 'Rank>3 and PP Threshold=True' WHEN [RANK]>3 AND Threshold_PP=0 THEN 'Rank>3 and PP Threshold=False' END AS PP from DT_Scan3G_Serial sc3g Inner join"
                        sql += " (select parcelID,CellId, LAC, MAX(timestamp) as timestamp from DT_Scan3G_Serial "
                        sql += timeStamp & "group by parcelID,CellId, LAC) temp3G on sc3g.CellId = temp3G.CellId And sc3g.parcelID = temp3G.parcelID"
                        sql += " and sc3g.LAC= temp3G.LAC and sc3g.TimeStamp= temp3G.timestamp ORDER BY PP"

                        sqlCount = "select distinct CASE WHEN [RANK]=1 AND Threshold_PP=1 THEN 'Rank=1 and PP Threshold=True'  WHEN [RANK]=2 AND Threshold_PP=1 THEN 'Rank=2 and PP Threshold=True' WHEN [RANK]=2 AND Threshold_PP=0 THEN 'Rank=2 and PP Threshold=False' WHEN [RANK]=3 AND Threshold_PP=1 THEN 'Rank=3 and PP Threshold=True' WHEN [RANK]=3 AND Threshold_PP=0 THEN 'Rank=3 and PP Threshold=False' WHEN [RANK]>3 AND Threshold_PP=1 THEN 'Rank>3 and PP Threshold=True' WHEN [RANK]>3 AND Threshold_PP=0 THEN 'Rank>3 and PP Threshold=False' END AS PP from DT_Scan3G_Serial sc3g Inner join"
                        sqlCount += "(select parcelID,CellId, LAC, MAX(timestamp) as timestamp from DT_Scan3G_Serial "
                        sqlCount += timeStamp & "group by parcelID,CellId, LAC) temp3G on sc3g.CellId = temp3G.CellId And sc3g.parcelID = temp3G.parcelID"
                        sqlCount += " and sc3g.LAC= temp3G.LAC and sc3g.TimeStamp= temp3G.timestamp  ORDER BY PP"

                        tblname = "CF_" & sectortype & "_Scan"
                    Else
                        sql = "select ue3g.* from DT_UE3G_Serial ue3g Inner join (select parcelID,CellId, LAC, MAX(timestamp) as timestamp from DT_UE3G_Serial "
                        sql += timeStamp & "group by parcelID,CellId, LAC) "
                        sql += " temp3G on ue3g.CellId = temp3G.CellId And ue3g.parcelID = temp3G.parcelID And ue3g.LAC = temp3G.LAC And ue3g.TimeStamp = temp3G.timestamp "

                        sqlCount = "select distinct RANK from DT_UE3G_Serial ue3g Inner join (select parcelID,CellId, LAC, MAX(timestamp) as timestamp from DT_UE3G_Serial "
                        sqlCount += timeStamp & " group by parcelID,CellId, LAC) "
                        sqlCount += " temp3G on ue3g.CellId = temp3G.CellId And ue3g.parcelID = temp3G.parcelID And ue3g.LAC = temp3G.LAC And ue3g.TimeStamp = temp3G.timestamp "

                        tblname = "CF_" & sectortype & "_UE"
                    End If
                    Dim dataSet As DataSet = DataAccessorODBC.GetDataSet(conn_IOSDriveTestModule, sqlCount, timeStampParameters)
                    If (Not dataSet Is Nothing) Then
                        If dataSet.Tables.Count > 0 Then
                            data1 = dataSet.Tables(0)
                        End If
                    End If

                    prm = "RSCP"
                Case tech.Contains("4G")
                    timeStamp = "where  CellId in (" & cellid & ") AND TAC in(" & tacLacValue & ") AND TimeStamp > ? and timestamp < ? "
                    Dim sqlCount As String = String.Empty
                    If (Me.cellFootPrintSelectedType = CellFootPrintType.Scanner) Then
                        sql = "select sc4g.*, CASE WHEN [RANK]=1 AND Threshold_PP=1 THEN 'Rank=1 and PP Threshold=True' WHEN [RANK]=2 AND Threshold_PP=1 THEN 'Rank=2 and PP Threshold=True' WHEN [RANK]=2 AND Threshold_PP=0 THEN 'Rank=2 and PP Threshold=False' WHEN [RANK]=3 AND Threshold_PP=1 THEN 'Rank=3 and PP Threshold=True' WHEN [RANK]=3 AND Threshold_PP=0 THEN 'Rank=3 and PP Threshold=False' WHEN [RANK]>3 AND Threshold_PP=1 THEN 'Rank>3 and PP Threshold=True' WHEN [RANK]>3 AND Threshold_PP=0 THEN 'Rank>3 and PP Threshold=False' END AS PP from DT_Scan4G_Serial sc4g Inner join "
                        sql += "(select parcelID,CellId,TAC, MAX(timestamp) as timestamp from DT_Scan4G_Serial "
                        sql += timeStamp & "group by parcelID,CellId, TAC) temp3G on sc4g.CellId = temp3G.CellId "
                        sql += " And sc4g.parcelID = temp3G.parcelID And sc4g.TAC = temp3G.TAC And sc4g.TimeStamp = temp3G.timestamp ORDER BY PP"

                        sqlCount = "select distinct CASE WHEN [RANK]=1 AND Threshold_PP=1 THEN 'Rank=1 and PP Threshold=True' WHEN [RANK]=2 AND Threshold_PP=1 THEN 'Rank=2 and PP Threshold=True' WHEN [RANK]=2 AND Threshold_PP=0 THEN 'Rank=2 and PP Threshold=False' WHEN [RANK]=3 AND Threshold_PP=1 THEN 'Rank=3 and PP Threshold=True' WHEN [RANK]=3 AND Threshold_PP=0 THEN 'Rank=3 and PP Threshold=False' WHEN [RANK]>3 AND Threshold_PP=1 THEN 'Rank>3 and PP Threshold=True' WHEN [RANK]>3 AND Threshold_PP=0 THEN 'Rank>3 and PP Threshold=False' END AS PP from DT_Scan4G_Serial sc4g Inner join "
                        sqlCount += "(select parcelID,CellId, TAC, MAX(timestamp) as timestamp from DT_Scan4G_Serial "
                        sqlCount += timeStamp & "group by parcelID,CellId, TAC) temp3G on sc4g.CellId = temp3G.CellId "
                        sqlCount += " And sc4g.parcelID = temp3G.parcelID And sc4g.TAC = temp3G.TAC And sc4g.TimeStamp = temp3G.timestamp ORDER BY PP"

                        tblname = "CF_" & sectortype & "_Scan"
                    Else
                        sql = " select ue4g.* from DT_UE4G_Serial ue4g Inner join (select parcelID,CellId, TAC, MAX(timestamp) as timestamp from DT_UE4G_Serial "
                        sql += timeStamp & "group by parcelID,CellId, TAC) temp3G on "
                        sql += " ue4g.CellId = temp3G.CellId And ue4g.parcelID = temp3G.parcelID and ue4g.TAC= temp3G.TAC and ue4g.TimeStamp= temp3G.timestamp"

                        sqlCount = " select distinct Rank from DT_UE4G_Serial ue4g Inner join (select parcelID,CellId, TAC, MAX(timestamp) as timestamp from DT_UE4G_Serial "
                        sqlCount += timeStamp & "group by parcelID,CellId, TAC) temp3G on "
                        sqlCount += " ue4g.CellId = temp3G.CellId And ue4g.parcelID = temp3G.parcelID and ue4g.TAC= temp3G.TAC and ue4g.TimeStamp= temp3G.timestamp"

                        tblname = "CF_" & sectortype & "_UE"
                    End If
                    Dim dataSet As DataSet = DataAccessorODBC.GetDataSet(conn_IOSDriveTestModule, sqlCount, timeStampParameters)    'DataSetFromODBC(conn_IOSDriveTestModule, sqlCount)
                    If (Not dataSet Is Nothing) Then
                        If dataSet.Tables.Count > 0 Then
                            data1 = dataSet.Tables(0)
                        End If
                    End If
                    prm = "RSRP"
                Case Else
                    SetStatus("Problem with sectortype selection in cellfootprint process")
                    Exit Sub
            End Select
            Dim fLayer As MapInfo.Mapping.FeatureLayer = MapControl1.Map.Layers(tblname)
            themeListCellFootPrint.Clear()

            If Not fLayer Is Nothing Then
                For Each Item As FeatureStyleModifier In fLayer.Modifiers
                    If (Not Item.Enabled) Then
                        themeListCellFootPrint.Add(Item.Name)
                    End If
                Next
            End If

            If MapControl1.Map.Legends.Count > 0 Then
                MapControl1.Map.Legends(0).Format.AutoSizeLegend = False
            End If
            'themeListCellFootPrint

            Dim l As IMapLayer
            Dim layersToRemove As New List(Of String)
            For Each l In MapControl1.Map.Layers
                If (l.Alias.StartsWith("CF")) Then
                    layersToRemove.Add(l.Alias)
                End If
            Next
            For Each layerToRemove As String In layersToRemove
                objMapHelper.RemoveLayer(layerToRemove)
            Next

            Dim objAdoNetTable As New IOSTableInfoAdoNet(tblname, conn_IOSDriveTestModule, sql, IOSStyleHelper.GetSytle(TableNames.CellFootPrint), "PX", "PY")
            timeStampParameters = GetTimeStampParameters()
            objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoNetTable, timeStampParameters)
            'plot data
            Dim lyr As FeatureLayer = objAdoNetTable.OutLayer
            ' MapControl1.Map.Layers.Add(lyr)
            ''   MapInfo.Mapping.LayerHelper.SetEditable(lyr,True);
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
            If ApplyHavingSettings(lyr) Then

                Dim cl As Color

                DT_CreateThematics(lyr, prm, "Cell - Footprint", "SectorType:  " & sectortype & "-" & prm)

                If tech.Contains("3G") Or tech.Contains("4G") Then
                    Dim subHeader As String = "EcNo"
                    If (tech.Contains("4G")) Then
                        subHeader = "RSRQ"
                    End If
                    DT_CreateThematics(lyr, "Best " & subHeader & " Cell FootPrint", "Cell - Footprint", "SectorType:  " & sectortype & "-" & subHeader)

                    If (data1 IsNot Nothing AndAlso data1.Rows.Count > 0) Then
                        If (cellFootPrintSelectedType = CellFootPrintType.UE) Then
                            Dim thm2 As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "Rank", "Rank")
                            thm2.ApplyStylePart = Thematics.StylePart.Color
                            thm2.Name = "Rank"

                            Dim mtb2 As Thematics.ModifierThemeBin
                            For i = 0 To thm2.Bins.Count - 1
                                mtb2 = thm2.Bins.Item(i)
                                Dim j As String = Convert.ToString(thm2.Bins(i).Value)
                                Select Case j
                                    Case "1"
                                        cl = Color.Green
                                    Case "2"
                                        cl = Color.YellowGreen
                                    Case "3"
                                        cl = Color.Yellow
                                    Case "4"
                                        cl = Color.Orange
                                    Case "5"
                                        cl = Color.Red
                                    Case Else
                                        cl = Color.Red
                                End Select

                                mtb2.Style.SymbolStyle.Color = cl
                            Next

                            thm2.RecomputeBins()

                            lyr.Modifiers.Append(thm2)
                            Legend_CreateThematic(thm2, "CP - Rank", "SectorType:  " & sectortype, lyr)
                        End If
                        If (cellFootPrintSelectedType = CellFootPrintType.Scanner) Then
                            Dim thm1 As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "PP", "PP")
                            thm1.Name = "Pilot Pollution"

                            thm1.ApplyStylePart = Thematics.StylePart.Color
                            For i As Integer = 0 To data1.Rows.Count - 1
                                thm1.Bins(i).Value = data1.Rows(i)("PP")
                            Next

                            Dim mtb1 As Thematics.ModifierThemeBin
                            For i = 0 To thm1.Bins.Count - 1
                                mtb1 = thm1.Bins.Item(i)
                                Dim j As String = Convert.ToString(thm1.Bins(i).Value)
                                Select Case j
                                    Case "Rank=1 and PP Threshold=True"
                                        cl = Color.Green
                                    Case "Rank=2 and PP Threshold=True"
                                        cl = Color.Yellow
                                    Case "Rank=2 and PP Threshold=False"
                                        cl = Color.Gray
                                    Case "Rank=3 and PP Threshold=True"
                                        cl = Color.Yellow
                                    Case "Rank=3 and PP Threshold=False"
                                        cl = Color.Gray
                                    Case "Rank>3 and PP Threshold=True"
                                        cl = Color.Red
                                    Case "Rank>3 and PP Threshold=False"
                                        cl = Color.Gray
                                End Select
                                mtb1.Style.SymbolStyle.Color = cl
                            Next

                            thm1.RecomputeBins()
                            lyr.Modifiers.Append(thm1)
                            Legend_CreateThematic(thm1, "CP - Pilot Polution", "SectorType:  " & sectortype, lyr)
                        End If
                    End If
                End If

                If (cellFootPrintSelectedType = CellFootPrintType.UE) Then
                    If tech.Contains("2G") Then
                        ''   DT_CreateThematics(lyr, "CP - RxQual", "Cell - Footprint", "sectortype:  " & sectortype & " - RxQual")
                    End If
                End If
            End If
            If Not lyr Is Nothing Then
                For Each Item As FeatureStyleModifier In lyr.Modifiers
                    Item.Enabled = Not themeListCellFootPrint.Contains(Item.Name)
                Next
            End If
            RefreshQuickThemeControl()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus("Error occured while retrieving cellfootprint information. Error: " & ex.Message)
            Me.Cursor = Cursors.Default
        End Try
    End Sub

