                        sql_from_final = sql_from + tableAlias & ", " + tbl.Alias + " "

                        sql_where_final = sql_where + tableAlias & "." + cellsearch + " = " + tbl.Alias + ".CELLID"

                        sql_total = sql_select_final + sql_from_final + sql_where_final

                        Dim command As MICommand = connection.CreateCommand()
                        Dim irfc As IResultSetFeatureCollection
                        command.CommandText = sql_total
                        irfc = command.ExecuteFeatureCollection()

                        If irfc.Count <> 0 Then
