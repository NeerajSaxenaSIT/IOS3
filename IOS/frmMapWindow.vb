            'connecting to datatable
            Dim ti As TableInfoAdoNet = New TableInfoAdoNet(tblname)
            ti.ReadOnly = True
            ti.DataTable = dt
            Dim paramtable As Table = connection.Catalog.OpenTable(ti)

            'constructing select string
            Dim sql_select As String = "SELECT "
            Dim sql_from As String = "FROM "
            Dim sql_where As String = "WHERE "

            For Each dcol As DataColumn In dt.Columns
                sql_select = sql_select + tblname + "." + dcol.ColumnName.ToString & ", "
            Next

            Dim tbl As MapInfo.Data.Table = Nothing
            Dim tbl_map As MapInfo.Data.Table = Nothing

            Dim sql_select_final As String = ""
            Dim sql_from_final As String = ""
            Dim sql_where_final As String = ""
            Dim sql_total As String = ""
            Dim irfc As IResultSetFeatureCollection = Nothing
            tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(LayerName)

            Dim uniquecellfield As String = Layer_Column2Tree(LayerName.Replace("_Voronoi", ""))
            If uniquecellfield Is Nothing Then
                uniquecellfield = "CELLID"
            End If

            If Not tbl Is Nothing Then
                sql_select_final = sql_select & tbl.Alias & ".obj "
                sql_from_final = sql_from & tbl.Alias & ", " & paramtable.Alias & " "
                If tech.ToUpper = networkAll.Network4G1.ToUpper Or tech.ToUpper = networkAll.Network4G2.ToUpper Or tech.ToUpper = networkAll.Network4G3.ToUpper Then
                    sql_where_final = sql_where & tbl.Alias & "." & uniquecellfield & " = " & paramtable.Alias & "." & cellsearch '& " AND " & tbl.Alias & ".TAC = " & paramtable.Alias & ".TAC"
                Else
                    sql_where_final = sql_where & tbl.Alias & "." & uniquecellfield & " = " & paramtable.Alias & "." & cellsearch '& " AND " & tbl.Alias & ".LAC = " & paramtable.Alias & ".LAC"
                End If

                sql_total = sql_select_final & sql_from_final & sql_where_final

                Dim command As MICommand = connection.CreateCommand()
                command.CommandText = sql_total
                irfc = command.ExecuteFeatureCollection(LayerName)
                command.Dispose()

                'Map the query
                If irfc.Count > 0 Then
                    tbl_map = irfc.Table
                    MapControl1.Map.Layers.Remove("Labels_" & LayerName)

                    'Dim labelLayer As New MapInfo.Mapping.LabelLayer("Labels_" & LayerName & "_" & param.Replace("_Map", ""), "Labels_" & LayerName & "_" & param.Replace("_Map", ""))
                    Dim labelLayer As New MapInfo.Mapping.LabelLayer("Labels_" & LayerName, "Labels_" & LayerName)
                    labelLayer.VisibleRangeEnabled = False


                    MapControl1.Map.Layers.Insert(0, labelLayer)
                    Dim source As New MapInfo.Mapping.LabelSource(tbl_map)
                    source.DefaultLabelProperties.Caption = param ''LayerName

