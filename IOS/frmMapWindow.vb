    Public Sub ChangeNetworkFeatures(ByVal tbl As DataTable)
        For Each drow As DataRow In tbl.Rows
            dlgSettingsNetworkFeatures.pbcGetNetworks2.EditValue = 0
            Dim nativeTable As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName"))

            Dim cstyle As CompositeStyle = CreateNetworkStyle(CInt(drow.Item("LayerLineWidth")), CInt(drow.Item("LayerLineColor")))
            Dim csize As Integer = CInt(drow.Item("LayerRelativeSize").ToString)
            Dim cBeam As Integer = CInt(drow.Item("LayerBeamWidth").ToString)

            nativeTable.BeginAccess(TableAccessMode.Write)
            Dim con As New MapInfo.Data.MIConnection
            con.Open()

            Dim gtemp As FeatureGeometry = GetLineFeature(New DPoint(4, 52), New DPoint(4, 53), csysWGS84)
            Dim com As MapInfo.Data.MICommand = con.CreateCommand()

            Dim irfc As IResultSetFeatureCollection = Session.Current.Catalog.Search(nativeTable, MapInfo.Data.SearchInfoFactory.SearchAll())

            Dim totalrecords As Integer = irfc.Count

            irfc.Close()

            com = con.CreateCommand() '
            com.CommandText = "Update " + nativeTable.Alias + " set obj = @Obj, MI_Style = @style where RecordID = @RecordID"
            com.Parameters.Add("@Obj", gtemp)
            com.Parameters.Add("@style", cstyle)
            com.Parameters.Add("@RecordID", 1)

            Dim i As Integer = 1

            For Each ftr As Feature In nativeTable

                If Not ftr.Item("X") Is Nothing Then
                    com.Parameters("@Obj").Value = CreatePieGeometry(New DPoint(ftr.Item("X").ToString, ftr.Item("Y").ToString), ftr.Item("AZIMUTH"), csize, cBeam)
                    com.Parameters("@style").Value = cstyle
                    com.Parameters("@RecordID").Value = ftr.Item("RecordID")
                    i = i + com.ExecuteNonQuery()
                End If

                dlgSettingsNetworkFeatures.pbcGetNetworks2.EditValue = CInt(System.Math.Min(i / totalrecords * 100, 100))
                Application.DoEvents()
            Next

            nativeTable.EndAccess()
            com.Dispose()
            con.Close()
            con.Dispose()
        Next
    End Sub

    Public Sub Preparation_Parameters_OSS(Optional ByVal reload As Boolean = False, Optional ByVal dt As DataTable = Nothing)
        Try
            Dim strArray As String()()
            Dim strArray2 As String()()
            Dim dataSetFromODBC As New DataSet

            Dim connStr As String
            Dim sql As String

            Dim list = New List(Of String)
            For Each row As DataRow In dt.Rows
                list.Add(row(0).ToString)
            Next

            If (System.IO.File.Exists((GetUserDataPath() & "\dt_IOS_OSSParams.xml")) And Not reload) Then
                dataSetFromODBC.ReadXml((GetUserDataPath() & "\dt_IOS_OSSParams.xml"), XmlReadMode.ReadSchema)
                dt_IOS_OSSParams = dataSetFromODBC.Tables.Item(0)
            Else
                strArray = Nothing
                strArray2 = Nothing

                dataSetFromODBC = DataAccessorODBC.GetDataSet(GetSQL(6001, strArray)(0), GetSQL(&H1771, strArray2)(1), iQryTimeOut)

                If dataSetFromODBC.Tables.Count > 0 Then
                    dataSetFromODBC.WriteXml((GetUserDataPath() & "\dt_IOS_OSSParams.xml"), XmlWriteMode.WriteSchema)
                    dt_IOS_OSSParams = dataSetFromODBC.Tables.Item(0)
                End If

            End If

            If (dt_IOS_OSSParams Is Nothing) Then
                Interaction.MsgBox("Problem loading IOS Parameter database...Exiting", MsgBoxStyle.OkOnly, Nothing)
            Else
                dt_IOS_OSSParams.TableName = "IOS"
                Dim set3 As New DataSet
                If (System.IO.File.Exists((GetUserDataPath() & "\ds_OSS_3G_UserParams.xml")) And Not reload) Then
                    set3.ReadXml((GetUserDataPath() & "\ds_OSS_3G_UserParams.xml"), XmlReadMode.ReadSchema)
                    dt_OSS_3G_UserParams = set3.Tables.Item(0)
                Else
                    _logger.SetError("OSS Parameters - 3G - File doesn't existing - Trying Creating...")

                    strArray2 = Nothing
                    strArray = Nothing

                    connStr = GetSQL(1027, strArray2)(0)

                    If list.Contains(connStr) Then
                        sql = GetSQL(1027, strArray)(1)

                        set3 = DataAccessorODBC.GetDataSet(connStr, sql, iQryTimeOut)
                        If set3 Is Nothing Then
                            _logger.SetError("OSS Parameters - 3G - File doesn't existing - No Data From Query.")
                        End If
                        set3.WriteXml((GetUserDataPath() & "\ds_OSS_3G_UserParams.xml"), XmlWriteMode.WriteSchema)
                        dt_OSS_3G_UserParams = set3.Tables.Item(0)
                    End If
                End If

                dt_OSS_3G_UserParams.TableName = "OSS"
                If (dt_OSS_3G_UserParams Is Nothing) Then
                    Interaction.MsgBox("Problem loading 3G OSS Parameter database...Exiting", MsgBoxStyle.OkOnly, Nothing)
                Else
                    Dim enumerator As IEnumerator = Nothing
                    dt_OSS_3G_UserParams.Columns.Add("ParamAbbrName")
                    dt_OSS_3G_UserParams.Columns.Add("DBTableName")
                    dt_OSS_3G_UserParams.Columns.Add("DBColumnName")
                    dt_OSS_3G_UserParams.Columns.Add("Description")
                    Me.str_sqlOSSParams_3G = ""
                    Try
                        enumerator = dt_OSS_3G_UserParams.Rows.GetEnumerator
                        Do While enumerator.MoveNext
                            Dim current As DataRow = DirectCast(enumerator.Current, DataRow)
                            Dim source As DataRow() = dt_IOS_OSSParams.Select(String.Concat(New String() {"P_abbr_name = '", current.Item("PARAM").ToString, "' AND Managed_Object = '", current.Item("OBJECT").ToString.Trim, "'"}))

                            If (source.Count() > 0) Then

                                current.Item("ParamAbbrName") = source(0).Item("P_abbr_name").ToString
                                current.Item("DBTableName") = source(0).Item("DB_table_name").ToString
                                current.Item("DBColumnName") = source(0).Item("DB_column_name").ToString
                                current.Item("Description") = source(0).Item("Description").ToString

                                If (Not current.Item("DBTableName") Is Nothing) Then
                                    Me.str_sqlOSSParams_3G = str_sqlOSSParams_3G & current.Item("DBTableName") & "." & current.Item("DBColumnName") & " , "
                                Else
                                    Me.str_sqlOSSParams_3G = (Me.str_sqlOSSParams_3G & "null Dummy, ")
                                End If
                            Else
                                current.Item("ParamAbbrName") = ""
                                current.Item("DBTableName") = ""
                                current.Item("DBColumnName") = ""
                                current.Item("Description") = ""
                                Me.str_sqlOSSParams_3G = (Me.str_sqlOSSParams_3G & "null Dummy, ")
                            End If
                        Loop
                    Finally
                        If TypeOf enumerator Is IDisposable Then
                            TryCast(enumerator, IDisposable).Dispose()
                        End If
                    End Try
                    Me.str_sqlOSSParams_3G = Me.str_sqlOSSParams_3G.TrimEnd(New Char() {" "c})
                    Me.str_sqlOSSParams_3G = Me.str_sqlOSSParams_3G.TrimEnd(New Char() {","c})
                    Dim set2 As New DataSet
                    If (System.IO.File.Exists((GetUserDataPath() & "\ds_OSS_2G_UserParams.xml")) And Not reload) Then
                        set2.ReadXml((GetUserDataPath() & "\ds_OSS_2G_UserParams.xml"), XmlReadMode.ReadSchema)
                        dt_OSS_2G_UserParams = set2.Tables.Item(0)
                    Else
                        _logger.SetError("OSS Parameters - 2G - File doesn't existing - Trying Creating...")

                        strArray2 = Nothing
                        strArray = Nothing

                        connStr = GetSQL(1030, strArray2)(0)

                        If list.Contains(connStr) Then
                            sql = GetSQL(1030, strArray)(1)

                            set2 = DataAccessorODBC.GetDataSet(connStr, sql, iQryTimeOut)
                            If set2 Is Nothing Then
                                _logger.SetError("OSS Parameters - 2G - File doesn't existing - No Data From Query.")
                            End If
                            set2.WriteXml((GetUserDataPath() & "\ds_OSS_2G_UserParams.xml"), XmlWriteMode.WriteSchema)
                            dt_OSS_2G_UserParams = set2.Tables.Item(0)
                        End If

                    End If

                    If (dt_OSS_2G_UserParams Is Nothing) Then
                        Interaction.MsgBox("Problem loading 2G OSS Parameter database...Exiting", MsgBoxStyle.OkOnly, Nothing)
                    Else
                        Dim enumerator2 As IEnumerator = Nothing
                        dt_OSS_2G_UserParams.TableName = "OSS"
                        dt_OSS_2G_UserParams.Columns.Add("ParamAbbrName")
                        dt_OSS_2G_UserParams.Columns.Add("DBTableName")
                        dt_OSS_2G_UserParams.Columns.Add("DBColumnName")
                        dt_OSS_2G_UserParams.Columns.Add("Description")
                        Me.str_sqlOSSParams_2G = ""
                        Try
                            enumerator2 = dt_OSS_2G_UserParams.Rows.GetEnumerator
                            Do While enumerator2.MoveNext
                                Dim row2 As DataRow = DirectCast(enumerator2.Current, DataRow)
                                Dim rowArray2 As DataRow() = dt_IOS_OSSParams.Select(String.Concat(New String() {"P_abbr_name = '", row2.Item("PARAM").ToString, "' AND Managed_Object = '", row2.Item("OBJECT").ToString.Trim, "'"}))
                                If (rowArray2.Count() > 0) Then
                                    row2.Item("ParamAbbrName") = rowArray2(0).Item("P_abbr_name").ToString
                                    row2.Item("DBTableName") = rowArray2(0).Item("DB_table_name").ToString
                                    row2.Item("DBColumnName") = rowArray2(0).Item("DB_column_name").ToString
                                    row2.Item("Description") = rowArray2(0).Item("Description").ToString
                                    If (Not row2.Item("DBTableName") Is Nothing) Then

                                        Me.str_sqlOSSParams_2G = str_sqlOSSParams_2G & row2.Item("DBTableName") & "." & row2.Item("DBColumnName") & " , "
                                    Else
                                        Me.str_sqlOSSParams_2G = (Me.str_sqlOSSParams_2G & "null Dummy, ")
                                    End If
                                Else
                                    row2.Item("ParamAbbrName") = ""
                                    row2.Item("DBTableName") = ""
                                    row2.Item("DBColumnName") = ""
                                    row2.Item("Description") = ""
                                    Me.str_sqlOSSParams_2G = (Me.str_sqlOSSParams_2G & "null Dummy, ")
                                End If
                            Loop
                        Finally
                            If TypeOf enumerator2 Is IDisposable Then
                                TryCast(enumerator2, IDisposable).Dispose()
                            End If
                        End Try
                        Me.str_sqlOSSParams_2G = Me.str_sqlOSSParams_2G.TrimEnd(New Char() {" "c})
                        Me.str_sqlOSSParams_2G = Me.str_sqlOSSParams_2G.TrimEnd(New Char() {","c})
                    End If
                End If
            End If
        Catch ex As Exception
            'ProjectData.SetProjectError(exception1)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Interaction.MsgBox("Preparation for OSS Parameters: " & ex.Message.ToString, MsgBoxStyle.OkOnly, Nothing)
            'ProjectData.ClearProjectError()
        End Try
    End Sub

