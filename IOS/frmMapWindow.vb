    Private Sub ApplyPieTheme(ByVal isSymbolApply As Boolean, ByRef lyr As MapInfo.Mapping.FeatureLayer, ByVal themeExpression As String, ByVal mappingColumns() As String, ByVal dtThematicBins As DataTable)
        Dim rowscounter As Integer = 0
        Dim pieThem As MapInfo.Mapping.Thematics.PieTheme = New MapInfo.Mapping.Thematics.PieTheme(MapControl1.Map, lyr.Table, mappingColumns)

        Dim thmLyr As New ObjectThemeLayer(pieThem)
        MapControl1.Map.Layers.Add(thmLyr)
        Dim framColor As Color
        Dim framColorBorder As Color
        For Each dr As DataRow In dtThematicBins.Rows
            framColor = IntegerToColor(dr(IOSThematicKeys.REGION_TRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
            framColorBorder = IntegerToColor(dr(IOSThematicKeys.REGION_BORDER_LINETRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))

            Dim sInterior As New SimpleInterior(dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColor)
            pieThem.Categories.Item(rowscounter).FillStyle = sInterior
            rowscounter += 1
        Next

        pieThem.Graduated = CType(dtThematicBins.Rows(0)(IOSThematicKeys.IS_GRANDUATED), Boolean)
        pieThem.Half = CType(dtThematicBins.Rows(0)(IOSThematicKeys.IS_HALFPIE), Boolean)

        'adding invisible symbol to show values when hovering over pie
        Dim sVectorPoint As MapInfo.Styles.SimpleVectorPointStyle = New MapInfo.Styles.SimpleVectorPointStyle(0)
        Dim cs As MapInfo.Styles.CompositeStyle = New MapInfo.Styles.CompositeStyle(sVectorPoint)
        Dim fsm As FeatureOverrideStyleModifier = New FeatureOverrideStyleModifier("PieThemeLabel", cs)
        MapControl1.Map.Layers.Add(lyr)
        lyr.Modifiers.Append(fsm)

        thmLyr.RebuildTheme()

        MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
        Legend_CreateThematic(pieThem, themeExpression, lyr)
    End Sub

    Private Sub Legend_CreateThematic(ByVal th As Thematics.ITheme, ByVal title As String, ByRef lyr As IMapLayer)
        Try
            Dim legend As MapInfo.Mapping.Legends.Legend = Nothing
            If MapControl1.Map.Legends.Count = 0 Then
                Dim legendFactory As MapInfo.Mapping.Legends.LegendFactory = MapControl1.Map.Legends

                Dim iSize As Integer = 200
                If lyr IsNot Nothing Then
                    Dim textSize As Size = TextRenderer.MeasureText(lyr.Name.ToString, New System.Drawing.Font("Arial", 10, GraphicsUnit.Point))
                    iSize = textSize.Width + 25
                End If
                legend = legendFactory.CreateLegend(New System.Drawing.Size(200, 200))
                legend.Border = True
                legend.BorderPen = New Pen(Color.Gray, 2.0!)
                legend.Format = New MapInfo.Mapping.Legends.LegendFormat
                legend.Format.AutoPositionFrames = True
                legend.Format.AutoSizeLegend = True
                legend.Format.FrameAlignment = MapInfo.Mapping.Legends.LegendFrameAlignment.Vertical
                legend.Format.FramesPerRow = 1
                legend.Format.FramesPerColumn = 5
                legend.Format.HorizontalFramePadding = 1
                legend.Format.VerticalFramePadding = 1
                legend.BackgroundBrush = New SolidBrush(Color.White)
                legend.Alias = "Legend " & title
                legend_ac = New MapInfo.Windows.Controls.LegendAdornmentControl(legend, MapControl1.Map)
                legend_ac.Visible = False
                MapControl1.AddAdornment(legend, legend_ac)
            Else
                legend = MapControl1.Map.Legends(0)
            End If

            Dim themeFrame As ThemeLegendFrame = Nothing 'LegendFrameFactory.CreateThemeLegendFrame(th)
            If Not legend Is Nothing And lyr.IsVisible Then
                ' Add theme legend frame to legend's Frames collection.
                legend.Format.AutoSizeLegend = True
                If Not themeFrame Is Nothing Then
                    legend.Frames.Remove(themeFrame)
                Else
                    themeFrame = LegendFrameFactory.CreateThemeLegendFrame(th)
                End If
                legend.Frames.Append(themeFrame)

                If Not TypeOf th Is GraduatedSymbolTheme Then
                    themeFrame.ShowCount = True
                End If

                'removing custom frame if exists in the legend box
                If customFrame IsNot Nothing AndAlso legend.Frames.Contains(customFrame) Then
                    legend.Frames.Remove(customFrame)
                End If

                themeFrame.TitleStyle = New MapInfo.Styles.Font("Arial", 10)
                themeFrame.SubTitleStyle = New MapInfo.Styles.Font("Arial", 8)
                themeFrame.RowTextStyle = New MapInfo.Styles.Font("Arial", 8)
                themeFrame.Title = title
                themeFrame.SubTitle = lyr.Name
                themeFrame.Border = LegendFrameBorder.Off

                If Not legend.Frames.Contains(customFrame) Then
                    Dim rows(0) As MapInfo.Mapping.Legends.CustomLegendFrameRow
                    rows(0) = New CustomLegendFrameRow(New CompositeStyle(Nothing, Nothing, New TextStyle(New Font("Arial", 6)), Nothing), "Date: " & legendMappingDate.ToString)
                    customFrame = LegendFrameFactory.CreateCustomLegendFrame("Custom Legend", "Custom_Legend_Alias", rows)
                    legend.Frames.Append(customFrame)
                End If

                If Not lyr Is Nothing Then
                    themeFrame.Visible = lyr.Enabled
                Else
                    themeFrame.Visible = True
                End If
                themeFrame.ShowEmptyRanges = True
                legend_ac.Refresh()
                legend_ac.Visible = tlb_Legend.Checked
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

    Private Sub ApplyRangeTheme(ByVal isSymbolApply As Boolean, ByRef lyr As MapInfo.Mapping.FeatureLayer, ByVal themeExpression As String,
                                ByVal mappingColumns() As String, ByVal dtThematicBins As DataTable, ByVal countOfBins As Integer)

        If Not MapControl1.Map.Layers.Contains(lyr) Then
            MapControl1.Map.Layers.Add(lyr)
        End If

        Dim rowscounter As Integer = 0
        If dtThematicBins.Rows(0)("DistributionMethod").ToString.Trim = "CustomRanges" Then

            Dim themRange As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, themeExpression, countOfBins, Thematics.DistributionMethod.CustomRanges)
            themRange.ApplyStylePart = Thematics.StylePart.All
            themRange.RoundBy = dtThematicBins.Rows(0)(IOSThematicKeys.ROUND_BY) '0.01
            themRange.SpreadBy = SpreadByPart.None
            Dim framColor As Color
            Dim framColorBorder As Color
            For Each dr As DataRow In dtThematicBins.Rows
                If (isSymbolApply) Then
                    framColor = IntegerToColorOle(dr(IOSThematicKeys.SYMBOL_INTERIOR_TRANSPARENCY), dr(IOSThematicKeys.SYMBOL_INTERIOR_COLOR))
                    framColorBorder = IntegerToColorOle(dr(IOSThematicKeys.SYMBOL_BORDERTRANSPARENCY), dr(IOSThematicKeys.SYMBOL_BORDER_COLOR))
                    themRange.Bins(rowscounter).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(dr(IOSThematicKeys.SYMBOL_NUMBER), framColorBorder, dr(IOSThematicKeys.SYMBOL_SIZE))
                    themRange.SpreadBy = SpreadByPart.None
                Else
                    framColor = IntegerToColorOle(dr(IOSThematicKeys.REGION_TRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
                    framColorBorder = IntegerToColorOle(dr(IOSThematicKeys.REGION_BORDER_LINETRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))

                    themRange.Bins(rowscounter).Style.AreaStyle.Border = New SimpleLineStyle(New MapInfo.Styles.LineWidth(dr(IOSThematicKeys.REGION_BORDER_LINEWIDTH), 0), dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColorBorder, False)
                    themRange.Bins(rowscounter).Style.AreaStyle.Interior = New SimpleInterior(dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColor)
                End If

                themRange.Bins(rowscounter).Min = dr(IOSThematicKeys.RANGE_MIN)
                themRange.Bins(rowscounter).Max = dr(IOSThematicKeys.RANGE_MAX)
                rowscounter += 1
            Next

            themRange.Recompute()
            lyr.Modifiers.Append(themRange)
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
            Legend_CreateThematic(themRange, themeExpression, lyr)

        ElseIf dtThematicBins.Rows(0)("DistributionMethod").ToString.Trim = "EqualCountPerRange" Then

            Dim themRange As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, themeExpression, countOfBins, Thematics.DistributionMethod.EqualCountPerRange)
            themRange.ApplyStylePart = Thematics.StylePart.All
            themRange.RoundBy = dtThematicBins.Rows(0)(IOSThematicKeys.ROUND_BY) '0.01
            themRange.SpreadBy = SpreadByPart.None
            themRange.Recompute()

            Dim framColor As Color
            Dim framColorBorder As Color
            For Each dr As DataRow In dtThematicBins.Rows
                If (isSymbolApply) Then
                    framColor = IntegerToColorOle(dr(IOSThematicKeys.SYMBOL_INTERIOR_TRANSPARENCY), dr(IOSThematicKeys.SYMBOL_INTERIOR_COLOR))
                    framColorBorder = IntegerToColorOle(dr(IOSThematicKeys.SYMBOL_BORDERTRANSPARENCY), dr(IOSThematicKeys.SYMBOL_BORDER_COLOR))
                    themRange.Bins(rowscounter).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(dr(IOSThematicKeys.SYMBOL_NUMBER), framColorBorder, dr(IOSThematicKeys.SYMBOL_SIZE))
                    themRange.SpreadBy = SpreadByPart.None
                Else
                    framColor = IntegerToColorOle(dr(IOSThematicKeys.REGION_TRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
                    framColorBorder = IntegerToColorOle(dr(IOSThematicKeys.REGION_BORDER_LINETRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))

                    themRange.Bins(rowscounter).Style.AreaStyle.Border = New SimpleLineStyle(New MapInfo.Styles.LineWidth(dr(IOSThematicKeys.REGION_BORDER_LINEWIDTH), 0), dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColorBorder, False)
                    themRange.Bins(rowscounter).Style.AreaStyle.Interior = New SimpleInterior(dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColor)
                End If
                rowscounter += 1
            Next

            lyr.Modifiers.Append(themRange)
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
            Legend_CreateThematic(themRange, themeExpression, lyr)

        ElseIf dtThematicBins.Rows(0)("DistributionMethod").ToString.Trim = "EqualRangeSize" Then

            Dim themRange As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, themeExpression, countOfBins, Thematics.DistributionMethod.EqualRangeSize)
            themRange.ApplyStylePart = Thematics.StylePart.All
            themRange.RoundBy = dtThematicBins.Rows(0)(IOSThematicKeys.ROUND_BY) '0.01
            themRange.SpreadBy = SpreadByPart.None
            themRange.Recompute()

            Dim framColor As Color
            Dim framColorBorder As Color
            For Each dr As DataRow In dtThematicBins.Rows
                If (isSymbolApply) Then
                    framColor = IntegerToColorOle(dr(IOSThematicKeys.SYMBOL_INTERIOR_TRANSPARENCY), dr(IOSThematicKeys.SYMBOL_INTERIOR_COLOR))
                    framColorBorder = IntegerToColorOle(dr(IOSThematicKeys.SYMBOL_BORDERTRANSPARENCY), dr(IOSThematicKeys.SYMBOL_BORDER_COLOR))
                    themRange.Bins(rowscounter).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(dr(IOSThematicKeys.SYMBOL_NUMBER), framColorBorder, dr(IOSThematicKeys.SYMBOL_SIZE))
                    themRange.SpreadBy = SpreadByPart.None
                Else
                    framColor = IntegerToColorOle(dr(IOSThematicKeys.REGION_TRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
                    framColorBorder = IntegerToColorOle(dr(IOSThematicKeys.REGION_BORDER_LINETRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))

                    themRange.Bins(rowscounter).Style.AreaStyle.Border = New SimpleLineStyle(New MapInfo.Styles.LineWidth(dr(IOSThematicKeys.REGION_BORDER_LINEWIDTH), 0), dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColorBorder, False)
                    themRange.Bins(rowscounter).Style.AreaStyle.Interior = New SimpleInterior(dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColor)
                End If
                rowscounter += 1
            Next

            lyr.Modifiers.Append(themRange)
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
            Legend_CreateThematic(themRange, themeExpression, lyr)
        End If

    End Sub

    Private Sub ApplyIndividualTheme(ByVal isSymbolApply As Boolean, ByRef lyr As MapInfo.Mapping.FeatureLayer,
                                     ByVal themeExpression As String, ByVal mappingColumns() As String, ByVal dtThematicBins As DataTable, ByVal countOfBins As Integer)

        MapControl1.Map.Layers.Add(lyr)
        Dim rowscounter As Integer = 0
        Dim thmIndividual As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, themeExpression, themeExpression)
        Try
            Dim framColor As Color
            Dim framColorBorder As Color
            For Each dr As DataRow In dtThematicBins.Rows
                If (isSymbolApply) Then
                    framColor = IntegerToColor(dr(IOSThematicKeys.SYMBOL_INTERIOR_TRANSPARENCY), dr(IOSThematicKeys.SYMBOL_INTERIOR_COLOR))
                    framColorBorder = IntegerToColor(dr(IOSThematicKeys.SYMBOL_BORDERTRANSPARENCY), dr(IOSThematicKeys.SYMBOL_BORDER_COLOR))
                    thmIndividual.Bins(rowscounter).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(dr(IOSThematicKeys.SYMBOL_NUMBER), framColor, dr(IOSThematicKeys.SYMBOL_SIZE))
                Else
                    framColor = IntegerToColor(dr(IOSThematicKeys.REGION_TRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
                    framColorBorder = IntegerToColor(dr(IOSThematicKeys.REGION_BORDER_LINETRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
                    thmIndividual.Bins(rowscounter).Style.AreaStyle.Border = New SimpleLineStyle(New MapInfo.Styles.LineWidth(dr(IOSThematicKeys.REGION_BORDER_LINEWIDTH), 0), dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColorBorder, False)
                    thmIndividual.Bins(rowscounter).Style.AreaStyle.Interior = New SimpleInterior(dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColor)
                End If

                thmIndividual.Bins(rowscounter).Min = dr(IOSThematicKeys.RANGE_MIN)
                thmIndividual.Bins(rowscounter).Max = dr(IOSThematicKeys.RANGE_MAX)
                rowscounter += 1
            Next

            lyr.Modifiers.Append(thmIndividual)
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
            Legend_CreateThematic(thmIndividual, themeExpression, lyr)
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

    Sub ShowHideLegandsWithLayer(ByVal filter As FilterByLayerType)
        Try
            Dim legands As MapInfo.Mapping.Legends.LegendFactory = MapControl1.Map.Legends
            For Each Item As MapInfo.Mapping.Legends.Legend In legands
                legend_ac.Visible = False
                Item.Frames.Clear()
                For Each t As IMapLayer In MapControl1.Map.Layers.GetMapLayerEnumerator()
                    If TypeOf t Is ObjectThemeLayer Then
                        Dim thm1 As ObjectThemeLayer = TryCast(t, ObjectThemeLayer)
                        Dim thm2 As GraduatedSymbolTheme = TryCast(thm1.Theme, GraduatedSymbolTheme)
                        If Not thm2 Is Nothing Then
                            Legend_CreateThematic(thm2, thm2.Expression, t)
                        End If
                    End If

                    If TypeOf t Is FeatureLayer AndAlso t.IsVisible Then
                        Dim lyr As FeatureLayer = TryCast(t, FeatureLayer)
                        Try
                            For Each modifier As FeatureStyleModifier In lyr.Modifiers
                                If TypeOf modifier Is ITheme Then
                                    Dim ithm As ITheme = CType(modifier, ITheme)
                                    If TypeOf ithm Is RangedTheme Then
                                        Legend_CreateThematic(modifier, CType(ithm, RangedTheme).Expression, lyr)
                                    ElseIf TypeOf ithm Is IndividualValueTheme Then
                                        Legend_CreateThematic(modifier, CType(ithm, IndividualValueTheme).Expression, lyr)
                                    ElseIf TypeOf ithm Is GraduatedSymbolTheme Then
                                        Legend_CreateThematic(modifier, CType(ithm, GraduatedSymbolTheme).Expression, lyr)
                                    End If
                                End If
                            Next
                        Catch ex As Exception

                        End Try
                    End If
                Next
            Next
            NBInfoArrowsDisplayed = True

            If Not legend_ac Is Nothing Then
                Dim item As ToolStripButton = CType(Me.map_ToolStrip.Items("tlb_Legend"), ToolStripButton)
                legend_ac.Refresh()
                legend_ac.Visible = item.Checked
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally

        End Try
    End Sub

