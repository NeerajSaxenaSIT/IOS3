    Private Function GetRadioParameters() As List(Of Odbc.OdbcParameter)

        Dim truncatedDateTime1 As DateTime = New DateTime(DTPickerStart.EditValue.Ticks - (DTPickerStart.EditValue.Ticks Mod TimeSpan.TicksPerSecond), DTPickerStart.EditValue.Kind)
        Dim truncatedDateTime2 As DateTime = New DateTime(DTPickerStop.EditValue.Ticks - (DTPickerStop.EditValue.Ticks Mod TimeSpan.TicksPerSecond), DTPickerStop.EditValue.Kind)

        Dim parameters As New List(Of Odbc.OdbcParameter)
        Dim parameterStDate As New Odbc.OdbcParameter("@sDate", Odbc.OdbcType.DateTime)
        parameterStDate.Value = truncatedDateTime1
        Dim parameterEnDate As New Odbc.OdbcParameter("@eDate", Odbc.OdbcType.DateTime)
        parameterEnDate.Value = truncatedDateTime2
        parameters.Add(parameterStDate)
        parameters.Add(parameterEnDate)
        If (IsWithCordinates()) Then
            Dim px1 As New Odbc.OdbcParameter("@px1", Odbc.OdbcType.Double)
            px1.Value = Convert.ToSingle(strpx1)
            Dim py1 As New Odbc.OdbcParameter("@py1", Odbc.OdbcType.Double)
            py1.Value = Convert.ToSingle(strpy1)
            Dim px2 As New Odbc.OdbcParameter("@px2", Odbc.OdbcType.Double)
            px2.Value = Convert.ToSingle(strpx2)
            Dim py2 As New Odbc.OdbcParameter("@py2", Odbc.OdbcType.Double)
            py2.Value = Convert.ToSingle(strpy2)
            parameters.Add(px1)
            parameters.Add(py1)
            parameters.Add(px2)
            parameters.Add(py2)
        End If
        Return parameters
    End Function

