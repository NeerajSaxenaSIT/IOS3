    Private Sub btnGeocoder_Click(sender As Object, e As DevExpress.XtraEditors.Controls.ButtonPressedEventArgs) Handles txtGeoCoderSearch.Properties.ButtonClick
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            Dim posLat As Double = Nothing
            Dim posLng As Double = Nothing
            Dim latLng() As String = Nothing
            Dim inputIsCoordinate As Boolean = False

            If regionalSettings = True Then
                txtGeoCoderSearch.Text = txtGeoCoderSearch.Text.Trim.Replace(",", ".")
            End If

            If txtGeoCoderSearch.Text.Trim.IndexOf(",") <> -1 Then
                latLng = txtGeoCoderSearch.Text.Trim().Split({","}, StringSplitOptions.RemoveEmptyEntries)
            ElseIf txtGeoCoderSearch.Text.Trim.IndexOf(";") <> -1 Then
                latLng = txtGeoCoderSearch.Text.Trim().Split({";"}, StringSplitOptions.RemoveEmptyEntries)
            Else
                latLng = txtGeoCoderSearch.Text.Trim().Split({" "}, StringSplitOptions.RemoveEmptyEntries)
            End If

            If latLng IsNot Nothing Then
                If latLng.Length = 2 Then
                    If (IsNumeric(latLng(0).Trim()) AndAlso IsNumeric(latLng(1).Trim())) Then
                        posLat = CDbl(latLng(0).Trim())
                        posLng = CDbl(latLng(1).Trim())
                        inputIsCoordinate = True
                    End If
                End If
            End If

            If (inputIsCoordinate = True) Then
                Me.Location_Map(txtGeoCoderSearch.Text.Trim(), posLng, posLat)
            Else
                frmTileMapping.TileMapping_GeoCoder(txtGeoCoderSearch.Text.Trim)
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub btnSearchCell_Click(sender As Object, e As DevExpress.XtraEditors.Controls.ButtonPressedEventArgs) Handles txtSearchCell.Properties.ButtonClick
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            If cmbSearchLac.Properties.Items.Count = 0 Then
                SearchLacOfCell(txtSearchCell.Text.ToString.Trim)
            End If
            If cmbSearchLac.Properties.Items.Count = 0 Then
                SetStatus("Cell not found!")
                Exit Sub
            End If

            If cmbSearchLac.Properties.Items.Count = 1 Then
                cmbSearchLac.SelectedIndex = 0
                Cell_LAC_SearchAndDisplay(txtSearchCell.Text, cmbSearchLac.SelectedItem.ToString.Trim)
            ElseIf cmbSearchLac.SelectedIndex = -1 And cmbSearchLac.Properties.Items.Count > 1 Then
                SetStatus("Select LAC! Number of LACs for " & txtSearchCell.Text.ToString & ": " & cmbSearchLac.Properties.Items.Count)
            ElseIf cmbSearchLac.SelectedIndex > -1 Then
                Cell_LAC_SearchAndDisplay(txtSearchCell.Text, cmbSearchLac.SelectedItem.ToString)
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
