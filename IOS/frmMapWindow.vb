                connection.Close()
                connection.Dispose()
                Exit Sub
            End If

            'Adding Feature Layer
            Dim lyr As New FeatureLayer(newtbl)
            MapControl1.Map.Layers.Add(lyr)
            mapLyrBounds.Add(lyr.Alias, lyr.Bounds)
            MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, layerConfig.Item("LayerLabelName").ToString)
            'Adding Label Layer
            connection.Catalog.CloseTable("Labels_" & tblName)
            CreateNetworkLabels(newtbl, layerConfig.Item("LayerLabelName").ToString, CInt(layerConfig.Item("LayerLabelSize").ToString), CInt(layerConfig.Item("LayerLineColor").ToString))

            'NetworkLines
            Dim tblName_lines As String = layerConfig.Item("LayerName").ToString & "_Lines"
            Dim command_lines As MICommand = connection.CreateCommand()
            Dim tbl_lines As MapInfo.Data.Table
            ' connection.Open()
            connection.Catalog.CloseTable(tblName_lines)

            Dim ti_lines As TableInfoAdoNet = New TableInfoAdoNet("Temp_" & tblName, linktable)
            tbl_lines = connection.Catalog.OpenTable(ti_lines)
            Dim newtbl_lines As MapInfo.Data.Table = Nothing
            newtbl_lines = CreateNetworkTable_LinksLines(tbl_lines, "CellID", tblName_lines, GetUserDataPath() & "\Data\", True, CreateNetworkStyle(1, 12237770), CInt(layerConfig.Item("LayerRelativeSize").ToString), CInt(layerConfig.Item("LayerBeamWidth").ToString), layerConfig.Item("LayerPolygonType").ToString)
            tbl_lines.Close()
            If newtbl_lines Is Nothing Then
                connection.Close()
                connection.Dispose()
                Exit Sub
            End If

            Dim lyr_lines As New FeatureLayer(newtbl_lines)
            MapControl1.Map.Layers.Add(lyr_lines)
            mapLyrBounds.Add(lyr_lines.Alias, lyr_lines.Bounds)
            MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr_lines), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr_lines, layerConfig.Item("LayerLabelName").ToString)
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr_lines, False)

            'Voronoi Calculation
            If cbVoronoi.Checked = True Then
                connection.Catalog.CloseTable(tblName & "_Voronoi")
                Dim newtbl_voronoi As MapInfo.Data.Table = Nothing
                newtbl_voronoi = CreateNetworkTable_Voronoi(newtbl, "CellID", tblName & "_Voronoi", GetUserDataPath() & "\Data\", True, "RecordID")
                If Not newtbl_voronoi Is Nothing Then
                    Dim lyr_voronoi As New FeatureLayer(newtbl_voronoi)
                    lyr_voronoi.Enabled = False
                    MapControl1.Map.Layers.Add(lyr_voronoi)
                    mapLyrBounds.Add(lyr_voronoi.Alias, lyr_voronoi.Bounds)
                    MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr_voronoi), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
                    MapInfo.Mapping.LayerHelper.SetSelectable(lyr_voronoi, False)
                End If
            End If

            connection.Close()
            connection.Dispose()
            Layer_Voronoi_Update()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            If connection.State = ConnectionState.Open Then
                connection.Close()
                connection.Dispose()
            End If
        End Try
    End Sub

