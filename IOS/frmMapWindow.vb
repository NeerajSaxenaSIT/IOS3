    Public Sub Cells_SearchAndDisplay(ByVal Field2Search As String, ByVal FieldValue As String, Optional isSearchFromNB As Boolean = False, Optional layerName As String = Nothing)
        Dim connection As New MIConnection
        Try
            If IsClearDefaultSelection = True Then
                MapInfo.Engine.Session.Current.Selections.DefaultSelection.Clear()
            End If

            Dim currentzoom As Distance
            currentzoom = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)
            Dim tbl As MapInfo.Data.Table
            connection.Open()

            Dim filter As String = ""
            If isSearchFromNB = True Then
                If FieldValue.ToUpper.Contains("2G") Then
                    filter = "LayerTechnology='2G' And LayerName like '%_" & layerName & "%'"
                ElseIf FieldValue.ToUpper.Contains("3G") Then
                    filter = "LayerTechnology='3G' And LayerName like '%_" & layerName & "%'"
                ElseIf FieldValue.ToUpper.Contains("4G") Then
                    filter = "LayerTechnology='4G' And LayerName like '%_" & layerName & "%'"
                ElseIf FieldValue.ToUpper.Contains("5G") Then
                    filter = "LayerTechnology='5G' And LayerName like '%_" & layerName & "%'"
                End If
            End If

            Dim layerRowsColl() As DataRow = dt_Map_Configuration.Select(filter)

            For Each drow As DataRow In layerRowsColl
                If drow("LayerActive").ToString = True Then
                    tbl = Session.Current.Catalog.GetTable(drow("LayerName").ToString.Trim)
                    If Not tbl Is Nothing Then
                        If CheckColumn_MapinfoTable(tbl, Field2Search) = True Then
                            Dim sql As String = Nothing

                            If tbl.TableInfo.Columns(Field2Search).DataType = MIDbType.String Then
                                sql = "SELECT " & tbl.Alias & ".* FROM " & tbl.Alias & " WHERE UPPER(" & tbl.Alias & "." & Field2Search & ") = UPPER('" & FieldValue & "')"
                            Else
                                sql = "SELECT " & tbl.Alias & ".* FROM " & tbl.Alias & " WHERE " & tbl.Alias & "." & Field2Search & " = " & FieldValue
                            End If
                            Dim command As MICommand = connection.CreateCommand()
                            command.CommandText = sql
                            Dim irfc As IResultSetFeatureCollection = command.ExecuteFeatureCollection()
                            If irfc.Count <> 0 Then
                                MapInfo.Engine.Session.Current.Selections.DefaultSelection.Add(irfc)
                            End If
                        End If
                    End If
                End If
            Next

            If Session.Current.Selections.DefaultSelection.Envelope IsNot Nothing Then
                If (MapControl1.Map.Bounds.Height > Session.Current.Selections.DefaultSelection.Envelope.Bounds.Height) And (MapControl1.Map.Bounds.Width > Session.Current.Selections.DefaultSelection.Envelope.Bounds.Width) Then
                    MapInfo.Engine.Session.Current.MapFactory(0).SetView(Session.Current.Selections.DefaultSelection.Envelope.Bounds.Center, Session.Current.Selections.DefaultSelection.Envelope.CoordSys, GetMapZoomDistance())
                Else
                    MapInfo.Engine.Session.Current.MapFactory(0).SetView(Session.Current.Selections.DefaultSelection.Envelope.Bounds, Session.Current.Selections.DefaultSelection.Envelope.CoordSys)
                End If
            End If
            Session.Current.Selections.DefaultSelection.Style = CreateSelectionStyle(7, 65280)
            connection.Close()
            connection.Dispose()
            SetStatus("Cells_SearchAndDisplay: Cell Found: " & Session.Current.Selections.DefaultSelection.TotalCount)
            frmGISSearch.lblMsg.Text = "Cells_SearchAndDisplay: Cell Found: " & Session.Current.Selections.DefaultSelection.TotalCount
            layerRowsColl = Nothing
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            connection.Close()
            connection.Dispose()
            SetStatus("Cells_SearchAndDisplay: Cell not found in Map")
            frmGISSearch.lblMsg.Text = "Cells_SearchAndDisplay: Cell not found in Map"
        End Try
    End Sub

