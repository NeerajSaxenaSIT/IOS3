    Private Sub cms_DtDrive_Opening(sender As Object, e As System.ComponentModel.CancelEventArgs) Handles cms_DtDrive.Opening
        Try
            If tvDriveTest.GetAllCheckedNodes().Where(Function(x) x.Nodes.Count = 0).ToList().Count > 0 Then
                Dim id As String = tvDriveTest.GetAllCheckedNodes().Where(Function(x) x.Nodes.Count = 0).ToList()(0).ToString()
                If (IsDTOwner(id, Environment.UserName)) Then
                    tsmi_DTRename.Enabled = True
                    tsmi_DTDelete.Enabled = True
                Else
                    tsmi_DTRename.Enabled = False
                    tsmi_DTDelete.Enabled = False
                End If
            End If
        Catch ex As Exception
        End Try

        If (tvDriveTest.FocusedNode IsNot Nothing) Then
            If (tvDriveTest.FocusedNode.Level = 1) Then

                tsmi_DeleteProject.Enabled = True
                tsmi_RenameProject.Enabled = True

                tsmi_DeleteDrivetest.Enabled = False
                tsmi_RenameDrivetest.Enabled = False

                tsmi_DeleteUE.Enabled = False
                tsmi_RenameUE.Enabled = False

            ElseIf (tvDriveTest.FocusedNode.Level = 2) Then

                tsmi_DeleteProject.Enabled = False
                tsmi_RenameProject.Enabled = False

                tsmi_DeleteDrivetest.Enabled = True
                tsmi_RenameDrivetest.Enabled = True

                tsmi_DeleteUE.Enabled = False
                tsmi_RenameUE.Enabled = False

            ElseIf (tvDriveTest.FocusedNode.Level = 3) Then

                tsmi_DeleteProject.Enabled = False
                tsmi_RenameProject.Enabled = False

                tsmi_DeleteDrivetest.Enabled = False
                tsmi_RenameDrivetest.Enabled = False

                tsmi_DeleteUE.Enabled = True
                tsmi_RenameUE.Enabled = True

            End If
        End If
    End Sub

