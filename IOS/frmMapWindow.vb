                    frmEvent.GetFailureEvents()
                    _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Show Event Form from Selected event on Map")
                End If
                statusForEvent = False
            End If
            If (frmEvent.WindowState = FormWindowState.Minimized) Then
                frmEvent.WindowState = FormWindowState.Normal
            End If
            frmEvent.Show()
            'Application.DoEvents()
            'Application.DoEvents()
            If Not eventid = 0 Then
                frmEvent.GetSelectedFailureEvents(eventid, DtId)
                objMapHelper.CloseTable("Lines_SourceCells_Events")
                objMapHelper.RemoveLayer("Lines_SourceCells_Events")
            End If
            eventid = 0
            tableAliasForEvent = ""
            statusForEvent = True

        ElseIf (e.ToolName = "AddRectangle") AndAlso Not IsToolEndingCalled Then
            If (addRectagulType = IOS.AddRectangleType.ActiveArea) Then
                activeRectCoordinates = New RectCoordinates

                activeRectCoordinates.X1 = Convert.ToDouble(e.MapCoordinate.x)
                activeRectCoordinates.Y1 = Convert.ToDouble(e.MapCoordinate.y)
            ElseIf (addRectagulType = IOS.AddRectangleType.SelectionArea) Then
                selectedRectCoordinates = New RectCoordinates
                selectedRectCoordinates.X1 = Convert.ToDouble(e.MapCoordinate.x)
                selectedRectCoordinates.Y1 = Convert.ToDouble(e.MapCoordinate.y)
                'ElseIf (addRectagulType = IOS.AddRectangleType.RegionTag) Then
                '    selectedRectRegionCoordinates = New RectCoordinates
                '    selectedRectRegionCoordinates.X1 = Convert.ToDouble(e.MapCoordinate.x)
                '    selectedRectRegionCoordinates.Y1 = Convert.ToDouble(e.MapCoordinate.y)
            Else
                'Exit Sub
            End If
        Else
            Map_StatusStrip.Visible = False
            ToolStripStatusLabel1.Text = ""
            ToolStripStatusLabel2.Text = ""
            ToolStripStatusLabel3.Text = ""
        End If
        statusIsSelected = False
        IsToolEndingCalled = False
    End Sub

    Private Sub ToolEnding(ByVal sender As System.Object, ByVal e As ToolEndingEventArgs)
        If (e.ToolName = "AddRectangle") Then
            If (addRectagulType = IOS.AddRectangleType.ActiveArea) Then
                activeRectCoordinates.X2 = Convert.ToDouble(e.MapCoordinate.x)
                activeRectCoordinates.Y2 = Convert.ToDouble(e.MapCoordinate.y)
                IsToolEndingCalled = True

            ElseIf (addRectagulType = IOS.AddRectangleType.SelectionArea) Then
                If (selectedRectCoordinates.X1 = -1 And selectedRectCoordinates.Y1 = -1) Then
                    strpx1 = ""
                    strpx2 = ""
                    strpy1 = ""
                    strpy2 = ""
                    ''lblAreaSelection.Text = "None"
                    Exit Sub
                End If

                strpx1 = selectedRectCoordinates.X1.ToString
                strpx2 = e.MapCoordinate.x.ToString
                strpy1 = e.MapCoordinate.y.ToString
                strpy2 = selectedRectCoordinates.Y1.ToString
                ''lblAreaSelection.Text = "Selection Area"
            ElseIf (addRectagulType = IOS.AddRectangleType.RegionTag) Then
                isFeatureAddedCalled = True
                IsToolEndingCalled = True
            End If
        ElseIf ((e.ToolName = "AddPolygon" Or e.ToolName = "AddCircle") AndAlso Not IsToolEndingCalled) Then
            If (addRectagulType = IOS.AddRectangleType.RegionTag) Then
                isFeatureAddedCalled = True
                IsToolEndingCalled = True
            End If
        End If

        If (isTagSelection) Then
            isTagSelection = False
        End If
    End Sub

    Public Sub ServiceCheckCreateMapInfo(dtMapServiceCheckData As DataTable, clickedX As Double, clickedY As Double)
        tblname = "ServiceCheckMapInfo"
        Dim tblInfoTemp As New TableInfoMemTable(tblname)
        Dim tblTemp As Table = Session.Current.Catalog.GetTable(tblname)
        If IsNothing(tblTemp) = False Then 'Table exists close it
            Session.Current.Catalog.CloseTable(tblname)
        End If

        tblInfoTemp.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
        tblInfoTemp.Columns.Add(ColumnFactory.CreateStyleColumn())
        tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("TECHNOLOGY", 20))
        tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("LAYER", 10))
        tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("SITENAME", 100))
        tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("CELLNAME", 100))
        tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("DistanceToSite"))
        tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("CoverageAsPlanned"))
        'tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("KPI", 100))

        tblTemp = Session.Current.Catalog.CreateTable(tblInfoTemp)
        Dim lyr As New FeatureLayer(tblTemp)

        For Each dr As DataRow In dtMapServiceCheckData.Rows
            Dim dps(1) As MapInfo.Geometry.DPoint
            dps(0) = TransformPointWGS84ToDisplay(New DPoint(clickedX, clickedY))
            dps(1) = TransformPointWGS84ToDisplay(New DPoint(CDbl(dr("SiteX")), CDbl(dr("SiteY"))))


            'create linefeature:
            Dim ln As FeatureGeometry = New MapInfo.Geometry.MultiCurve(lyr.CoordSys, CurveSegmentType.Linear, dps)

            'Dim rect As MapInfo.Geometry.DRect = New MapInfo.Geometry.DRect(dps(0), dps(1))
            'Dim larc As MapInfo.Geometry.LegacyArc = New MapInfo.Geometry.LegacyArc(csysWGS84, rect, -30, 30)
            'Dim mcurve As MultiCurve = larc.CreateMultiCurve(20)
            'Dim dps2() As DPoint = mcurve.Item(0).SamplePoints


            'Dim mpPie As MultiPolygon = New MultiPolygon(csysWGS84, CurveSegmentType.Linear, dps2)

            'add style
            Dim lstyle As SimpleLineStyle = Nothing
            Select Case dr("TECHNOLOGY")
                Case "2G"
                    lstyle = New SimpleLineStyle(New LineWidth(7, LineWidthUnit.Pixel), 2, System.Drawing.Color.Red)
                Case "3G"
                    lstyle = New SimpleLineStyle(New LineWidth(5, LineWidthUnit.Pixel), 2, System.Drawing.Color.Blue)
                Case "4G"
                    lstyle = New SimpleLineStyle(New LineWidth(3, LineWidthUnit.Pixel), 2, System.Drawing.Color.Orange)
                Case "5G"
                    lstyle = New SimpleLineStyle(New LineWidth(1, LineWidthUnit.Pixel), 2, System.Drawing.Color.DarkGreen)
            End Select

            Dim cs As New CompositeStyle(lstyle)
            Dim ftr2 As New Feature(tblTemp.TableInfo.Columns)
            ftr2.Geometry = ln
            ftr2.Style = cs
            ftr2.Item("TECHNOLOGY") = dr("TECHNOLOGY")
            ftr2.Item("LAYER") = dr("LAYER")
            ftr2.Item("SITENAME") = dr("SITENAME")
            ftr2.Item("CELLNAME") = dr("S_CELLNAME")
            ftr2.Item("DistanceToSite") = CDbl(dr("DistanceToSite"))
            ftr2.Item("CoverageAsPlanned") = CDbl(dr("CoverageAsPlanned"))
            ' ftr2.Item("KPI") = recordSecondTableofSP("KPI")  (Not used for now)

            tblTemp.InsertFeature(ftr2)
        Next

        'append to map
        MapControl1.Map.Layers.Add(lyr)
        MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tblTemp))
    End Sub

