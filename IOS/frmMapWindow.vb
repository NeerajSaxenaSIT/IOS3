    Private Sub Call_CalendarKpiSelection_DateChanged()
        Try
            If tlKpiSelection.GetAllCheckedNodes().Count = 0 Then
                Exit Sub
            End If

            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            Dim selected_count As Integer = 0
            Dim selected_tech As String = ""

            For Each tbl In Session.Current.Catalog
                Dim fc As IResultSetFeatureCollection = Session.Current.Selections.DefaultSelection(tbl)
                If Not fc Is Nothing Then
                    If fc.Count <> 0 And (Layer_InMapConfiguration(fc.BaseTable.Alias) Or Layer_InMapConfiguration(Replace(fc.BaseTable.Alias, "_Voronoi", ""))) Then
                        'kpiInfo_Selected_Cells.Clear()
                        selected_count = selected_count + fc.Count
                        If Not selected_tech.Contains(CType(fc, IDynamicFeatureCollection)(0)("TECHNOLOGY").ToString) Then
                            If selected_tech = "" Then
                                selected_tech = CType(fc, IDynamicFeatureCollection)(0)("TECHNOLOGY").ToString
                            Else
                                selected_tech = "Multi"
                            End If
                        End If

                        Dim field2tree As String = Layer_Column2Tree(tbl.Alias)
                        If field2tree = Nothing Then
                            field2tree = "CELLID"
                        End If
                        For Each ftr As Feature In fc
                            kpiInfo_Selected_Cells.Add(ftr.Item(field2tree).ToString)
                        Next
                    End If
                End If
            Next

            If cmbKpiSelTheme.SelectedIndex > 0 Then
                GetSelectedThemeData(CInt(CType(cmbKpiSelTheme.SelectedItem, clsComboBoxItem).Value))
            Else
                SetStatus("Please select a theme")
                Exit Sub
            End If

            If selected_count <> 0 Then

                btnKpiInfoClearSel.Appearance.BackColor = Color.LightGreen
                LoadKpiCounterMappingData()

            ElseIf kpiInfo_Selected_Cells.Count > 0 Then

                LoadKpiCounterMappingData()

            Else
                SetStatus("No data found to map...")
            End If

        Catch ex As Exception
