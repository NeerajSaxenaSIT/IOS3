                'ElseIf topxmaptype = 2 Then
                '    Dim geoHeatMapData As New GeoAggregationData(tbl_map.Alias, themeExpression, "SUM")
                '    geoHeatMapData.GeoDataType = GeoDataType.HeatMap
                '    GeoAggregationManager.RemoveByTableNameAndType(geoHeatMapData)
                '    GeoAggregationManager.Add(geoHeatMapData)
                '    GeoAggregationManager.GenerateGeoAggregation(AddressOf CreateGridFromFeatures, GeoDataType.HeatMap)

                '    'CreateHTMLForHeatmap(tbl_map, PrevLayerName, kpi)
                'Else
                MapControl1.Map.Layers.Add(lyr)
                'Dim thm2 As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, themeExpression, 8, Thematics.DistributionMethod.EqualRangeSize)
                Dim thm2 As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, dt.TableName, 8, Thematics.DistributionMethod.EqualRangeSize)
                thm2.RoundBy = 0.01

                'starting color
                thm2.Bins(0).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, Color.DarkBlue, False)
                thm2.Bins(0).Style.AreaStyle.Interior = New SimpleInterior(2, Color.DarkBlue)

                thm2.InflectionColor = Color.Yellow
                thm2.InflectionIndex = 3
                thm2.Inflected = True
                thm2.Recompute()

                For i = 0 To thm2.Bins.Count - 1
                    Dim si As SimpleInterior = thm2.Bins(i).Style.AreaStyle.Interior
                    Dim frcolor As Color = Color.FromArgb(128, si.ForeColor)
                    Dim frcolorbrdr As Color = Color.FromArgb(255, si.ForeColor)

                    thm2.Bins(i).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, frcolorbrdr, False)
                    thm2.Bins(i).Style.AreaStyle.Interior = New SimpleInterior(si.Pattern, frcolor)

                Next
                'thm2.Recompute()
                thm2.Bins(thm2.InflectionIndex).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, thm2.InflectionColor, False)
                thm2.Bins(thm2.InflectionIndex).Style.AreaStyle.Interior = New SimpleInterior(2, thm2.InflectionColor)
                lyr.Modifiers.Append(thm2)
                MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
                Legend_CreateThematic(thm2, themeExpression, lyr)
                'End If
                MapInfo.Engine.Session.Current.MapFactory(0).SetView(lyr.Bounds, csysWGS84)
                MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tbl_map))
            End If

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus("Cell_TopX_Mapping: Problem during mapping of TopX" & Chr(13) & ex.Message)
        Finally
            connection.Close()
            RefreshQuickThemeControl()
            WaitScreen.CloseWaitScreen()
        End Try
    End Sub

