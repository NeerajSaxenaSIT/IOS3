    Private Sub CNE_CounterFilter_Load()
        Dim SourceType As String = IIf(rbCNESourceRaw.Checked, "CNE_RAW", "CNE_AGG")

        If cmb_DataSource.SelectedIndex > 0 Then
            Dim parray()() As String = {
                New String() {"@SourceType", Chr(39) & SourceType & Chr(39)},
                New String() {"@datasource", CType(cmb_DataSource.SelectedItem, clsComboBoxItem).Value}
            }
            Dim dsFilter As New DataSet
            dsFilter = DataAccessorODBC.GetDataSet(GetSQL(8908, parray)(0), GetSQL(8908, parray)(1), iQryTimeOut)

            If dsFilter Is Nothing Then
                Exit Sub
            End If

            Try
                lbCNECounterList.Items.Clear()
                lbCNECounterList.DisplayMember = "FieldName"
                lbCNECounterList.ValueMember = "FieldName"
                lbCNECounterList.DataSource = dsFilter.Tables(0)
                cmbCNETemplate.Tag = SourceType
                btnCNESaveTemplate.Tag = SourceType
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
            End Try
            dsFilter.Dispose()
            dsFilter = Nothing
        End If
    End Sub

