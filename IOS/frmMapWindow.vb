    Private Function CreatePieRingGeometry(ByVal cp As DPoint, ByVal azimuth As Integer, ByVal size As Double, ByVal beamwidth As Integer, ByVal sizewidth As Double) As FeatureGeometry
        Try
            'size 3 = 100m
            If size = 0 Then
                size = 0.01
            End If
            'Dim size_real As Double = size * 10 * 3
            'Dim sizewidth_real As Double = sizewidth * 10 * 3
            Dim size_real As Double = size * 1000
            Dim sizewidth_real As Double = sizewidth * 1000

            Dim ftrPie As FeatureGeometry

            Dim pint As MapInfo.Geometry.IPointEdit = New MapInfo.Geometry.Point(csysWGS84, cp).GetPointEditor

            pint.OffsetByXY(-1 * size_real, -1 * size_real, DistanceUnit.Meter, DistanceType.Spherical)
            Dim p1 As DPoint = New DPoint(pint.X, pint.Y)
            'Location_Map("p1", p1.x, p1.y, "p1")
            pint = New MapInfo.Geometry.Point(csysWGS84, cp).GetPointEditor

            pint.OffsetByXY(size_real, size_real, DistanceUnit.Meter, DistanceType.Spherical)
            Dim p2 As DPoint = New DPoint(pint.X, pint.Y)
            ' Location_Map("p2", p2.x, p2.y, "p2")
            pint = New MapInfo.Geometry.Point(csysWGS84, cp).GetPointEditor

            pint.OffsetByXY(-1 * (size_real + sizewidth_real), -1 * (size_real + sizewidth_real), DistanceUnit.Meter, DistanceType.Spherical)
            Dim p3 As DPoint = New DPoint(pint.X, pint.Y)
            ' Location_Map("p3", p3.x, p3.y, "p3")
            pint = New MapInfo.Geometry.Point(csysWGS84, cp).GetPointEditor

            pint.OffsetByXY((size_real + sizewidth_real), (size_real + sizewidth_real), DistanceUnit.Meter, DistanceType.Spherical)
            Dim p4 As DPoint = New DPoint(pint.X, pint.Y)
            '  Location_Map("p4", p4.x, p4.y, "p4")

            Dim rect1 As MapInfo.Geometry.DRect = New MapInfo.Geometry.DRect(p1, p2)
            Dim rect2 As MapInfo.Geometry.DRect = New MapInfo.Geometry.DRect(p3, p4)

            Dim larc1 As MapInfo.Geometry.LegacyArc = New MapInfo.Geometry.LegacyArc(csysWGS84, rect1, azimuth * -1 + 90 - beamwidth / 2, azimuth * -1 + 90 + beamwidth / 2)
            Dim larc2 As MapInfo.Geometry.LegacyArc = New MapInfo.Geometry.LegacyArc(csysWGS84, rect2, azimuth * -1 + 90 - beamwidth / 2, azimuth * -1 + 90 + beamwidth / 2)

            Dim mcurve1 As MultiCurve = larc1.CreateMultiCurve(20)
            Dim mcurve2 As MultiCurve = larc2.CreateMultiCurve(20)

            Dim dps1() As DPoint = mcurve1.Item(0).SamplePoints
            Dim dps2() As DPoint = mcurve2.Item(0).SamplePoints


            ReDim Preserve dps1(dps1.Length + dps2.Length - 1)
            For j As Integer = 0 To mcurve2.Item(0).SamplePoints.Count - 1
                dps1(dps1.Length - dps2.Length + j) = dps2(dps2.Length - 1 - j)
            Next

            Dim mpPie As MultiPolygon = New MultiPolygon(csysWGS84, CurveSegmentType.Linear, dps1)
            ftrPie = mpPie
            'ftrPie = ringPie
            Return ftrPie
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Return Nothing
        End Try
        Return Nothing
    End Function

    Private Function GetFootPrintTimeStamp(ByVal dateItemIndex As Integer) As DateTime
        Dim dateControlMenuItem As ToolStripMenuItem = TryCast(bCellFootPrint.DropDownItems(4), ToolStripMenuItem)
        If (dateControlMenuItem IsNot Nothing) Then
            Dim dateControlHost As ToolStripControlHost = TryCast(dateControlMenuItem.DropDownItems(dateItemIndex), ToolStripControlHost)
            If (dateControlHost IsNot Nothing) Then
                Dim dateControls As IOS.Configuration.DateTimeControl.IOS_UI_CustomDateTimePicker = TryCast(dateControlHost.Control, IOS.Configuration.DateTimeControl.IOS_UI_CustomDateTimePicker)
                If (dateControls IsNot Nothing) Then

                    Dim truncatedDateTime As DateTime = New DateTime(dateControls.StartAndEndDate.Ticks - (dateControls.StartAndEndDate.Ticks Mod TimeSpan.TicksPerSecond), dateControls.StartAndEndDate.Kind)

                    Return truncatedDateTime
                End If
                Return Nothing
            End If
            Return Nothing
        End If
        Return Nothing
    End Function

    Function GetTimeStampParameters() As List(Of Odbc.OdbcParameter)
        Dim parameters As New List(Of Odbc.OdbcParameter)
        Dim parameterStDate As New Odbc.OdbcParameter("@sDate", Odbc.OdbcType.DateTime)
        parameterStDate.Value = GetFootPrintTimeStamp(0)
        Dim parameterEnDate As New Odbc.OdbcParameter("@endDate", Odbc.OdbcType.DateTime)
        parameterEnDate.Value = GetFootPrintTimeStamp(1).AddDays(1).AddSeconds(-1)
        parameters.Add(parameterStDate)
        parameters.Add(parameterEnDate)
        Return parameters
    End Function

    Private Function CalculateDistance(ByVal ftrTbl As MapInfo.Data.Table, ByVal ftr As Feature) As List(Of IOSFeatureGeometry)
        Dim ftrGemList As New List(Of IOSFeatureGeometry)
        For Each ftr1 As Feature In ftrTbl
            Dim iosFeatGem As New IOSFeatureGeometry
            iosFeatGem.cellID = ftr1("CELLID")
            iosFeatGem.lac = ftr1("LAC")
            iosFeatGem.bcch = ftr1("BCCH")
            iosFeatGem.ncc = ftr1("NCC")
            iosFeatGem.bcc = ftr1("BCC")
            iosFeatGem.distance = ftr.Geometry.Distance(ftr1.Geometry, DistanceUnit.Kilometer, DistanceType.Spherical, True)
            Dim r = From w In ftrGemList
                    Where w.bcch = iosFeatGem.bcch AndAlso w.ncc = iosFeatGem.ncc AndAlso w.bcc = iosFeatGem.bcc
                    Select w
            If (r.Count() > 0) Then
                If (r(0).distance > iosFeatGem.distance) Then
                    r(0).distance = iosFeatGem.distance
                    r(0).cellID = iosFeatGem.cellID
                    r(0).lac = iosFeatGem.lac
                    r(0).feature = ftr1
                End If
            Else
                iosFeatGem.feature = ftr1
                ftrGemList.Add(iosFeatGem)
            End If
        Next
        Return ftrGemList
    End Function

    Private Function CreateNetworkTable_Sites(ByVal tableToIndex As MapInfo.Data.Table, ByVal columnAliasToIndex As String, ByVal AliasForNewTable As String, ByVal FilePathToSaveNativeTable As String, ByVal CloseOldTable As Boolean) As MapInfo.Data.Table
