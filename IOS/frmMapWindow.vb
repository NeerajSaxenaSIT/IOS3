    Private Sub LoadCNEData()
        Try
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            Dim startdate As Date = Nothing
            Dim enddate As Date = Nothing
            startdate = deCNEStart.EditValue
            enddate = deCNEEnd.EditValue

            If Math.Abs(DateDiff(DateInterval.Day, startdate, enddate)) > 3 AndAlso rbCNESourceRaw.Checked Then
                SetStatus("Querying huge data in RAW mode, The data could be truncated!")
                'Exit Sub
            End If

            'collect filters
            'get basefilter of theme
            Dim additionalFilter As String = ""
            For Each item In draggedKPIList
                Dim dr() As DataRow = dtCNEThematics.AsEnumerable().Where(Function(x) x.Field(Of Integer)("ThematicID") = item.Value.ToString).ToArray()

                If Not dr Is Nothing AndAlso dr.Count > 0 Then
                    additionalFilter = nZ(dr(0)("BaseFilter"), "")
                End If
            Next

            Dim ds As DataSet = CNE_GetData(additionalFilter)
            If Not ds Is Nothing AndAlso ds.Tables.Count > 0 AndAlso ds.Tables(0).Rows.Count > 0 Then

                Dim thematicTypeName As String = CStr(dtCNEThematics.AsEnumerable().Where(Function(x) x.Field(Of Integer)("ThematicID") = gvCNETheme.GetFocusedRowCellValue("ThematicID")).ToArray()(0)("ThematicTypeName"))

                If thematicTypeName.ToLower = "individual value" Then
                    Dim thematicFld As String = dtCNEThematics.AsEnumerable().Where(Function(x) x.Field(Of Integer)("ThematicID") = gvCNETheme.GetFocusedRowCellValue("ThematicID")).ToArray()(0)("ThematicField").ToString
                    Dim dtDistinctThematicItems As DataTable = ds.Tables(0).DistinctCol(thematicFld)
                    If dtDistinctThematicItems.Rows.Count > 500 Then
                        If Not dicCneThmExcd.Keys.Contains(thematicFld) Then
                            dicCneThmExcd.Add(thematicFld, dtDistinctThematicItems.Rows.Count)
                        End If
                    Else
                        dicCneThmExcd.Remove(thematicFld)
                    End If
                End If

                SetStatus("Loading grid...")
                If rbCNESourceRaw.Checked Then
                    ds.Tables(0).TableName = "CNE_RAW"
                    Dim GridCtrlMap As GridControl = Me.CreateTabWithGridViewForMapData("CNE_RAW")

                    Dim GridViewMap As New Views.Grid.GridView()
                    GridCtrlMap.MainView = GridViewMap
                    GridViewMap.GridControl = GridCtrlMap
                    GridCtrlMap.ViewCollection.Add(GridViewMap)

                    IOSDevExpressGrid.PopulateDataInGrid(GridCtrlMap, GridViewMap, ds.Tables(0), "ALL")
                    CNE_MapRawEvents(ds.Tables(0))
                Else
                    ds.Tables(0).TableName = "CNE_AGG"
                    Dim GridView_Map As DevExpress.XtraGrid.GridControl = Me.CreateTabWithGridViewForMapData("CNE_AGG")
                    'GridViewMapAddData(GridView_Map, GridView_Map.MainView, ds.Tables(0), "ALL")
                    CNE_MapGeoAgg(ds.Tables(0), True)
                End If
                ''StatusStrip1.Visible = False
            Else
                If ds Is Nothing Then
                    SetStatus("No Data in Result - Query Problem - Check with Admin")
                Else
                    SetStatus("No Data in Result - Check Zoom/Filters/Resolution")
                End If

                ''clearing existing tables
                Dim mtn As String = CNE_MapTableName()
                Session.Current.Catalog.CloseTable(mtn)
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        RefreshQuickThemeControl()
    End Sub

