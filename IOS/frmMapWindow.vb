    End Sub

    Private Sub btnCNESaveTemplate_Click(sender As Object, e As EventArgs) Handles btnCNESaveTemplate.Click
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            Dim resolution As String = ""
            If rbCNESourceRaw.Checked = True Then
                resolution = "Raw"
            Else
                resolution = "GeoAgg"
            End If
            Dim analysisName As String = Nothing
            Dim result As Integer = 7
            If cmbCNETemplate.Text <> "No Filter" Then
                result = XtraMessageBox.Show("Overwrite Selected Analysis?", "Analysis Saving", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question)
            End If

            If result = DialogResult.Cancel Then
                Exit Sub
            ElseIf result = DialogResult.No Then
                analysisName = InputBox("Analysis Name: ", "Add Analysis", "")
            ElseIf result = DialogResult.Yes Then
                analysisName = cmbCNETemplate.SelectedItem.ToString
            End If

            If analysisName = "" Or analysisName = "No Filter" Then
                Exit Sub
            End If

            If analysisName = "No Filter" Then
                MsgBox("No Filter is a reserved name")
                Exit Sub
            End If

            Dim indexOftemplate As Integer = -1
            For i = 0 To cmbCNETemplate.Properties.Items.Count - 1
                If cmbCNETemplate.Properties.Items(i).Text = analysisName Then
                    indexOftemplate = i
                End If
            Next

            If indexOftemplate = -1 Then
                CNE_FilterTemplate_Add(analysisName, resolution)

                Dim dtFilters As New DataTable
                dtFilters.Columns.Add("cneFilter", GetType(String))
                dtFilters.Columns.Add("cneOp", GetType(String))
                dtFilters.Columns.Add("cneValue", GetType(String))

                For Each nd As TreeListViewNode In tlvCNEFilters.Nodes
                    Dim drFilter As DataRow = dtFilters.NewRow()
                    drFilter("cneFilter") = nd.SubItems(0).Text
                    drFilter("cneOp") = nd.SubItems(1).Text
                    drFilter("cneValue") = nd.SubItems(2).Text
                    dtFilters.Rows.Add(drFilter)
                    dtFilters.AcceptChanges()
                Next

                LoadCNEAnalysisForTech()

                For i = 0 To cmbCNETemplate.Properties.Items.Count - 1
                    If cmbCNETemplate.Properties.Items(i).Text = analysisName Then
                        indexOftemplate = i
                    End If
                Next

                CNE_Filter_Delete(cneFilterTemplateID)
                For Each drFilter As DataRow In dtFilters.Rows
                    CNE_Filter_Add(cneFilterTemplateID, drFilter("cneFilter").ToString, drFilter("cneOp").ToString, drFilter("cneValue").ToString)
                Next
                cmbCNETemplate.SelectedItem = cmbCNETemplate.Properties.Items(indexOftemplate)
            Else
                Dim templateid As Integer = CType(cmbCNETemplate.SelectedItem, clsComboBoxItem).Value
                CNE_Filter_Delete(templateid)

                For Each nd As TreeListViewNode In tlvCNEFilters.Nodes
                    CNE_Filter_Add(templateid, nd.SubItems(0).Text, nd.SubItems(1).Text, nd.SubItems(2).Text)
                Next
                cmbCNETemplate.SelectedItem = cmbCNETemplate.Properties.Items(indexOftemplate)
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub btnCNEDelTemplate_Click(sender As Object, e As EventArgs) Handles btnCNEDelTemplate.Click
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            Dim tech As String = ""
            If rbCNEAuto.Checked = True Then
                tech = "CNE_AGG"
            Else
                tech = "CNE_RAW"
            End If

            If cmbCNETemplate.Text = "No Filter" Then
                MsgBox("No Filter Is Reserved, Can't be Deleted")
                Exit Sub
            End If

            Dim cneFilterTemplateID As Integer = CInt(CType(cmbCNETemplate.SelectedItem, clsComboBoxItem).Value)
            Dim templateOwner As String = dtCNEAnalysis.AsEnumerable().Where(Function(x) x.ItemArray("CNEFIlterTemplateID") = cneFilterTemplateID).ToArray()(0)("TemplateOwner").ToString

            Dim isPowerUser As Boolean = False
            If (templateOwner.ToLower <> Environment.UserName.ToLower) Then
                If configMgr.User.IsPowerUser = True Then
                    isPowerUser = True
                Else
                    XtraMessageBox.Show("Only the template owner or the power user can clear the analysis", "Delete Analysis!", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                    isPowerUser = False
                    Exit Sub
                End If
            Else
                'analysis owner
                isPowerUser = True
            End If

            If (isPowerUser = True) Then
                CNE_FilterTemplate_Del(cneFilterTemplateID)
                LoadCNEAnalysisForTech()
                tlv_CNE_Filters_Update()
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub tlv_CNE_Filters_Update()
        Dim sql As String = Nothing
        Dim connstring As String = Nothing
        Dim dt_filters As DataTable = Nothing

        Try
            If cmbCNETemplate.SelectedIndex > 0 Then
                Dim parray()() As String = {
                    New String() {"@TemplateID", CType(cmbCNETemplate.SelectedItem, clsComboBoxItem).Value},
                    New String() {"@datasource", CType(cmb_DataSource.SelectedItem, clsComboBoxItem).Value}
                }
                parray(0)(1) = CInt(TryCast(cmbCNETemplate.SelectedItem, clsComboBoxItem).Value)

                sql = GetSQL(8902, parray)(1)
                connstring = GetSQL(8902, parray)(0)
                dt_filters = DataAccessorODBC.GetDataTable(connstring, sql, iQryTimeOut)
                tlvCNEFilters.Nodes.Clear()

                If dt_filters.Rows.Count > 0 Then
                    For Each drow As DataRow In dt_filters.Rows
                        Dim newnode As TreeListViewNode = New TreeListViewNode(drow(2).ToString)
                        newnode.Tag = drow(0).ToString
                        Dim si1 As TreeListViewSubItem = New TreeListViewSubItem(drow(2).ToString)
                        newnode.SubItems.Add(si1)
                        Dim si2 As TreeListViewSubItem = New TreeListViewSubItem(drow(3).ToString)
                        newnode.SubItems.Add(si2)
                        Dim si3 As TreeListViewSubItem = New TreeListViewSubItem(drow(4).ToString)
                        newnode.SubItems.Add(si3)
                        tlvCNEFilters.Nodes.Add(newnode)
                    Next

                    tlvCNEFilters.Columns(0).Width = 150
                    tlvCNEFilters.Refresh()
                End If
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        Finally
            If Not dt_filters Is Nothing Then
                dt_filters.Dispose()
                dt_filters = Nothing
            End If
        End Try
    End Sub

