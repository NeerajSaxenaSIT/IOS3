    Private Sub LoadCNEThemeForTech()
        Dim strConnection As String = Nothing
        Dim sqlParam As String = Nothing
        Dim tech As String = ""
        Dim RaworAgg As String = IIf(rbCNESourceRaw.Checked, "Raw", "GeoAgg")

        Dim HasChangedFromRawToAgg As Boolean = True

        If Not dtCNEThemes Is Nothing Then
            HasChangedFromRawToAgg = IIf(dtCNEThemes.TableName <> RaworAgg, 1, 0)
        End If


        For Each chk As CheckEdit In gcCNETechFilter.Controls
            If chk.Checked = True Then
                tech = tech & "'" & chk.Tag & "',"
            End If
        Next
        tech = tech.Substring(0, tech.Length - 1)
        Dim parray()() As String = {
            New String() {"@Technology", tech.Trim},
            New String() {"@RawOrAgg", Chr(39) & RaworAgg & Chr(39)}
        }
        strConnection = GetSQL(8913, parray)(0)
        sqlParam = GetSQL(8913, parray)(1)
        dtCNEThemes = DataAccessorODBC.GetDataTable(strConnection, sqlParam, iQryTimeOut)
        dtCNEThemes.TableName = RaworAgg
        dtCNEThemes.Columns.Add("Select", GetType(Boolean))


        For Each dr As DataRow In dtCNEThemes.Rows
            If dicSelectedTheme.Count > 0 And HasChangedFromRawToAgg = False Then
                If dicSelectedTheme.Keys.Contains(dr("ThematicID")) Then
                    dr("Select") = CBool(dicSelectedTheme(dr("ThematicID")))
                Else
                    dr("Select") = False
                End If
            Else
                dr("Select") = False
            End If
            dtCNEThemes.AcceptChanges()
        Next

        Dim columnsToHide() As String = {"ThematicID", "ThematicField", "ThematicTypeName", "BaseFilter"}
        IOSDevExpressGrid.PopulateDataInGrid(gridCNETheme, gvCNETheme, dtCNEThemes, "ALL", columnsToHide, "ThematicName")

        Dim riChkCNE As Repository.RepositoryItemCheckEdit = TryCast(gridCNETheme.RepositoryItems.Add("CheckEdit"), Repository.RepositoryItemCheckEdit)
        riChkCNE.CheckStyle = DevExpress.XtraEditors.Controls.CheckStyles.Standard
        riChkCNE.AllowGrayed = False
        riChkCNE.NullStyle = DevExpress.XtraEditors.Controls.StyleIndeterminate.Unchecked
        gvCNETheme.Columns("Select").ColumnEdit = riChkCNE
        AddHandler riChkCNE.CheckedChanged, AddressOf riChkCNE_CheckedChanged

        If gvCNETheme.Columns.Count > 0 Then
            gvCNETheme.Columns("Select").Width = 40
            gvCNETheme.Columns("Select").Visible = True
        End If
    End Sub

    Private Sub riChkCNE_CheckedChanged(sender As Object, e As EventArgs)
        Try
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            Dim chkBox As CheckEdit = TryCast(sender, CheckEdit)
            Dim drChecked As DataRow = Nothing
            If (chkBox IsNot Nothing AndAlso chkBox.Checked = True) Or (sender.Parent.Name = "gridCNEAnalysis") Then
                drChecked = gvCNETheme.GetFocusedDataRow()
                Dim objClsItem As New clsComboBoxItem()
                objClsItem.Text = drChecked("ThematicField")
                objClsItem.Value = drChecked("ThematicID")

                If (sender.Parent.Name = "gridCNETheme") Then
                    For Each dr As DataRow In dtCNEThemes.Rows
                        If drChecked("ThematicID") = dr("ThematicID") Then
                            dr("Select") = chkBox.Checked
                            If Not dicSelectedTheme.Keys.Contains(drChecked("ThematicID")) Then
                                dicSelectedTheme.Add(CInt(drChecked("ThematicID")), chkBox.Checked)
                            End If
                        Else
                            dr("Select") = False
                            dicSelectedTheme.Remove(dr("ThematicID"))
                        End If
                        dtCNEThemes.AcceptChanges()
                    Next
                    draggedKPIList.Clear()
                    draggedKPIList.Add(objClsItem)
                End If

                If tglSwitchCNE.IsOn Then
                    'check if cne data is present, if so skip loading
                    Dim mtn As String = CNE_MapTableName()
                    Dim isDataPresent As Boolean = False
                    Dim lyr As FeatureLayer = Nothing
                    For Each tbl As MapInfo.Data.Table In Session.Current.Catalog.EnumerateTables
                        If tbl.Alias.Equals(mtn) Then
                            For Each ml As IMapLayer In MapControl1.Map.Layers.GetMapLayerEnumerator()
                                If (TypeOf ml Is FeatureLayer) AndAlso (ml.Alias.Equals(mtn)) Then
                                    lyr = TryCast(ml, FeatureLayer)
                                    Exit For
                                End If
                            Next
                            isDataPresent = True
                        End If
                    Next

                    If isDataPresent = False Or mtn.Contains("RAW") Or (sender.Parent.Name = "gridCNEAnalysis") Then
                        LoadCNEData()
                    End If

                    If Not dicCneThmExcd.Keys.Contains(objClsItem.Text) Then
                        CNE_CreateThematic(objClsItem)
                    Else
                        lyr.Modifiers.Clear()
                        SetStatus("Distinct Thematic field count cannnot be more than 500")
                    End If

                ElseIf cellFootPrintSelectedType = 3 Then
                    For Each tbl As MapInfo.Data.Table In Session.Current.Catalog.EnumerateTables
                        If tbl.Alias.StartsWith("CNE_GEOAGG_CF_") Or tbl.Alias.StartsWith("CNE_RAW_CF_") Then
                            CNE_CreateThematic(objClsItem, tbl.Alias)
                        End If
                    Next
                End If

            Else
                drChecked = gvCNETheme.GetFocusedDataRow()
                dicSelectedTheme.Remove(drChecked("ThematicID"))
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Private Function CNE_MapTableName() As String
        Dim maptablename As String = ""

        If rbCNESourceRaw.Checked Then
            maptablename = "CNE_RAW_Map_"
        Else
            maptablename = "CNE_AGG_Map_"
        End If

        If chk2G.Checked Then
            maptablename = maptablename + "2G"
        ElseIf chk3G.Checked Then
            maptablename = maptablename + "3G"
        ElseIf chk4G.Checked Then
            maptablename = maptablename + "4G"
        ElseIf chk5G.Checked Then
            maptablename = maptablename + "5G"
        ElseIf chkall.Checked Then
            maptablename = maptablename + "ALL"
        End If

        Return maptablename
    End Function
    Private Function CNE_GetCheckedTheme() As DataRow
        Dim rowHandle As Int16 = 0
        While gvCNETheme.IsValidRowHandle(rowHandle)
            Dim dr As DataRow = gvCNETheme.GetDataRow(rowHandle)
            If dr("Select") = True Then
                Return dr
            End If
            rowHandle = rowHandle + 1
        End While
        Return Nothing
    End Function

