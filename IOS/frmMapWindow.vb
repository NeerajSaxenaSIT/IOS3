    Function ApplyHavingSettings(ByRef layer As FeatureLayer) As Boolean
        Dim objThematicHelper As New IOSThematicHelper(layer)
        Try
            If (objThematicHelper.ApplyThematicSettings(GetUserDataPath())) Then
                For Each Item As MapInfo.Mapping.FeatureStyleModifier In objThematicHelper.IThemeList
                    Dim alias1 As String = Item.Alias
                    Dim layerAlias As String = layer.Alias
                    Dim legands = From legand In objThematicHelper.ILegendList
                                  Where legand.LayerName = layerAlias AndAlso legand.ThemeName = alias1
                                  Select legand
                    If legands.Count() > 0 Then
                        Dim legandinfo As IOSLegandInfo = legands(0)
                        Legend_CreateThematic(Item, legandinfo.Header, legandinfo.SubHeader, Nothing)
                    End If
                Next
                Return False
            End If
        Catch ex As Exception
            Return True
        End Try
        Return True
    End Function

    Private Function GetColorToCategery(ByVal category As String) As System.Drawing.Color
        If objFrmICM IsNot Nothing Then
            If (objFrmICM.Visible) Then
                Dim shortedName As String = objFrmICM.GetShortedName(category)
                Select Case shortedName.ToUpper.Trim
                    Case "BL".ToUpper.Trim
                        Return System.Drawing.Color.Blue
                    Case "BI".ToUpper.Trim
                        Return System.Drawing.Color.Green
                    Case "CBI".ToUpper.Trim
                        Return System.Drawing.Color.Red
                    Case "OUC".ToUpper.Trim
                        Return System.Drawing.Color.Yellow
                    Case "RC".ToUpper.Trim
                        Return System.Drawing.Color.Violet
                    Case "TUD".ToUpper.Trim
                        Return System.Drawing.Color.Silver
                    Case "TRU".ToUpper.Trim
                        Return System.Drawing.Color.Purple
                    Case Else
                        Return System.Drawing.Color.Black
                End Select
            Else
                Return System.Drawing.Color.Black
            End If
