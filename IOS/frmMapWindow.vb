    Private Sub GetCNEAnalysisData(ByVal res As String)
        Dim tech As String = ""

        For Each chk As CheckEdit In gcCNETechFilter.Controls
            If chk.Checked = True Then
                tech = tech & "'" & chk.Tag & "',"
            End If
        Next
        tech = tech.Substring(0, tech.Length - 1)
        Dim parray()() As String = {
            New String() {"@Tech", tech.Trim},
            New String() {"@TemplateOwner", Chr(39) & Environment.UserName.ToString & Chr(39)},
            New String() {"@RawOrAgg", Chr(39) & res & Chr(39)}
        }
        Dim strConnection As String = GetSQL(8903, parray)(0)
        Dim sqlParam As String = GetSQL(8903, parray)(1)
        dtCNEAnalysis = DataAccessorODBC.GetDataTable(strConnection, sqlParam, iQryTimeOut)
    End Sub

