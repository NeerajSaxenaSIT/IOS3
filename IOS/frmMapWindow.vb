    Private Function CNE_GetData(Optional ByVal additionalFilter As String = "", Optional IsFootPrint As Boolean = False, Optional Size_ParcelSelected As Int16 = 0) As DataSet
        Try
            Dim sql_period As String = CNEGetPeriod()
            Dim areafilter As String = ""
            If tglCNEArea.ToggleState = CheckState.Checked Then
                'collect coordinates from drawn rectangle
                areafilter = " And PX >= '" & activeRectCoordinates.X1 & "'" &
                             " AND PX <= '" & activeRectCoordinates.X2 & "'" &
                             " AND PY >= '" & activeRectCoordinates.Y2 & "'" &
                             " AND PY <= '" & activeRectCoordinates.Y1 & "'"
            ElseIf rbCNE50m.Checked Or rbCNE200m.Checked Or rbCNE1000m.Checked Or rbCNEAuto.Checked Or rbCNESourceRaw.Checked Then
                Dim pt1 As DPoint = TransformPointToWGS84(MapControl1.Map.Bounds.DefiningPoints(0))
                Dim pt2 As DPoint = TransformPointToWGS84(MapControl1.Map.Bounds.DefiningPoints(1))
                areafilter = " AND PX >= '" & pt1.x & "'" &
                             " AND PX <= '" & pt2.x & "'" &
                             " AND PY >= '" & pt1.y & "'" &
                             " AND PY <= '" & pt2.y & "'"
            End If

            'collect cne filter setting
            Dim CNE_FieldFilter As String = Nothing
            Dim CNE_LayerFilter As String = Nothing

            If analysisChecked = True And Size_ParcelSelected = 0 Then
                For Each nd As TreeListViewNode In tlvCNEFilters.Nodes
                    If CNE_FieldFilter = Nothing Then
                        CNE_FieldFilter = " AND " + nd.SubItems(0).Text.ToString + "  " + nd.SubItems(1).Text.ToString + "  '" + nd.SubItems(2).Text.ToString + Chr(39)
                    Else
                        CNE_FieldFilter = CNE_FieldFilter + " AND " + nd.SubItems(0).Text.ToString + "  " + nd.SubItems(1).Text.ToString + "  " + nd.SubItems(2).Text.ToString
                    End If
                Next
            End If

            If additionalFilter <> "" Then
                CNE_FieldFilter = CNE_FieldFilter + " AND " + additionalFilter
            End If

            'layer filter

            If cmb_CNE_LayerFilter.SelectedIndex > 0 Then
                CNE_LayerFilter = " AND LAYER='" + cmb_CNE_LayerFilter.SelectedText + "'"
            End If

            'build query
            Dim sql_insert As String = Nothing
            Dim connstring As String = Nothing
            Dim dtfilter As DataTable = New DataTable()
            dtfilter = Nothing

            Dim resolution As String = Nothing
            If rbCNEAuto.Checked Then
                resolution = "AUTO"
            ElseIf rbCNE50m.Checked Then
                resolution = "50"
            ElseIf rbCNE200m.Checked Then
                resolution = "200"
            ElseIf rbCNE1000m.Checked Then
                resolution = "1000"
            End If

            Try
                Dim currentzoom As Distance
                currentzoom = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)
                Dim tech As String = ""

                If rbCNESourceRaw.Checked = True And Size_ParcelSelected = 0 Then

                    For Each chk As CheckEdit In gcCNETechFilter.Controls
                        If chk.Checked = True Then
                            tech = tech & "'" & chk.Tag & "',"
                        End If
                    Next
                    tech = tech.Substring(0, tech.Length - 1)

                    Dim parray()() As String = {
                        New String() {"@period", sql_period},
                        New String() {"@area", areafilter},
                        New String() {"@filter", CNE_FieldFilter},
                        New String() {"@datasource", CType(cmb_DataSource.SelectedItem, clsComboBoxItem).Value},
                        New String() {"@ZoomDistance ", currentzoom.Value},
                        New String() {"@layer ", CNE_LayerFilter},
                        New String() {"@technology", tech.Trim}
                    }

                    sql_insert = GetSQL(8910, parray)(1)
                    connstring = GetSQL(8910, parray)(0)
                ElseIf IsFootPrint = False And Size_ParcelSelected = 0 Then

                    For Each chk As CheckEdit In gcCNETechFilter.Controls
                        If chk.Checked = True Then
                            tech = tech & "''" & chk.Tag & "'',"
                        End If
                    Next
                    tech = tech.Substring(0, tech.Length - 1)

                    SetGridSizeLabel(currentzoom)


                    Dim parray()() As String = {
                        New String() {"@period", Replace(sql_period, "'", "' + char(39) + '")},
                        New String() {"@area", Replace(areafilter, "'", "' + char(39) + '")},
                        New String() {"@filter", Replace(CNE_FieldFilter, "'", "' + char(39) + '")},
                        New String() {"@ZoomDistance ", currentzoom.Value},
                        New String() {"@datasource", CType(cmb_DataSource.SelectedItem, clsComboBoxItem).Value},
                        New String() {"@resolution", Chr(39) & resolution & Chr(39)},
                        New String() {"@layer ", Replace(CNE_LayerFilter, "'", "' + char(39) + '")},
                        New String() {"@technology", tech.Trim}
                    }

                    sql_insert = GetSQL(8911, parray)(1)
                    connstring = GetSQL(8911, parray)(0)
                ElseIf IsFootPrint = True Then
                    'Dim currentzoom As Distance
                    currentzoom = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)
                    SetGridSizeLabel(currentzoom)

                    Dim parray()() As String = {
                        New String() {"@period", Replace(sql_period, "'", "' + char(39) + '")},
                        New String() {"@area", Replace(areafilter, "'", "' + char(39) + '")},
                        New String() {"@filter", Replace(CNE_FieldFilter, "'", "' + char(39) + '")},
                        New String() {"@ZoomDistance ", currentzoom.Value},
                        New String() {"@layer ", Replace(CNE_LayerFilter, "'", "' + char(39) + '")},
                        New String() {"@datasource", CType(cmb_DataSource.SelectedItem, clsComboBoxItem).Value}
                    }

                    sql_insert = GetSQL(8912, parray)(1)
                    connstring = GetSQL(8912, parray)(0)

                ElseIf Size_ParcelSelected > 0 Then
                    'Dim currentzoom As Distance
                    currentzoom = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)
                    SetGridSizeLabel(currentzoom)

                    Dim parray()() As String = {
                        New String() {"@period", Replace(sql_period, "'", "' + char(39) + '")},
                        New String() {"@area", Replace(areafilter, "'", "' + char(39) + '")},
                        New String() {"@filter", Replace(CNE_FieldFilter, "'", "' + char(39) + '")},
                        New String() {"@ZoomDistance ", currentzoom.Value},
                        New String() {"@datasource", CType(cmb_DataSource.SelectedItem, clsComboBoxItem).Value},
                        New String() {"@resolution", Chr(39) & Size_ParcelSelected & Chr(39)},
                        New String() {"@layer ", Replace(CNE_LayerFilter, "'", "' + char(39) + '")},
                        New String() {"@technology", tech.Trim}
                    }

                    sql_insert = GetSQL(8916, parray)(1)
                    connstring = GetSQL(8916, parray)(0)

                End If

                Dim ds As DataSet = DataAccessorODBC.GetDataSet(connstring, sql_insert, iQryTimeOut)
                Return ds
            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        Return Nothing
    End Function

