                            tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                            tbl_map.InsertFeatures(irfc)
                        Else
                            tbl_map = Session.Current.Catalog.GetTable(topxtbl & "_Map")
                            tbl_map.InsertFeatures(irfc)
                        End If
                        command.Dispose()
                    End If
                End If
            End If
            If tbl_map Is Nothing Then
                connection.Close()
                Exit Sub
            End If
            'Map the query
            If CountRowsInTable(tbl_map, False) > 0 Then
                Dim lyr As New FeatureLayer(tbl_map)
                'MapControl1.Map.Layers.Add(lyr)
                Try
                    If (Not dtThematicBins Is Nothing) Then
                        If (dtThematicBins.Rows.Count > 0) Then
                            Dim countOfBins As Integer = dtThematicBins.Rows.Count()
                            If (dtThematicBins.Rows(0)(IOSThematicKeys.TARGET_OBJECT).ToString.ToUpper = "SYMBOL") Then
                                If (dtThematicBins.Rows(0)(IOSThematicKeys.THEMATIC_TYPE).ToString.ToUpper = "PIETHEME") Then
                                    ApplyPieTheme(True, lyr, themeExpression, mappingColumns, dtThematicBins)
                                ElseIf (dtThematicBins.Rows(0)(IOSThematicKeys.THEMATIC_TYPE).ToString.ToUpper = "RANGEDTHEME") Then
                                    ApplyRangeTheme(True, lyr, themeExpression, mappingColumns, dtThematicBins, countOfBins)
                                ElseIf (dtThematicBins.Rows(0)(IOSThematicKeys.THEMATIC_TYPE).ToString.ToUpper = "INDIVIDUALTHEME") Then
                                    ApplyIndividualTheme(True, lyr, themeExpression, mappingColumns, dtThematicBins, countOfBins)
