    Private Function SelectionToTree(ByVal Topx As Boolean, Optional ByVal techCommon As String = Nothing) As String
        Dim sw As Stopwatch = New Stopwatch()
        sw.Start()
        Dim tbl As MapInfo.Data.Table
        Dim selected_tech As String = Nothing
        Dim tech_processed As New List(Of String)
        Dim flags As New IOS.Library.SelectionToTreeFlags()
        Dim totalcell As Integer = 0
        Dim tech As String = Nothing

        For Each tbl In MapInfo.Engine.Session.Current.Catalog
            Dim fc As IResultSetFeatureCollection = Session.Current.Selections.DefaultSelection(tbl)

            Try
                If Not fc Is Nothing And Layer_InMapConfiguration(tbl.Alias) Then
                    If techCommon Is Nothing Then
                        tech = Layer_Tech(tbl.Alias)
                    Else
                        tech = "COMMON"
                    End If
                    If Not tech_processed.Contains(tech) And fc.Count > 0 Then
                        tech_processed.Add(tech)
                        selected_tech = selected_tech + SelectionToTreeStep1(tech, fc.Count, Topx, flags) + ","
                    End If
                    Dim field2tree As String = Layer_Column2Tree(tbl.Alias)
                    If field2tree = Nothing Then
                        field2tree = "CELLID"
                    End If
                    For Each ftr As Feature In fc
                        SelectionToTreeStep2(tech, ftr.Item(field2tree).ToString(), Topx)
                    Next
                    If Topx = True Then
                        objfrmTechnology = Nothing
                        If Not objFrmTechList.Exists(Function(x) x.Network.ToUpper.Equals(tech)) Then
                            frmMDI.OpenTechFormDynamically(tech, objfrmTechnology, True)
                        Else
                            objfrmTechnology = objFrmTechList.Where(Function(x) x.Network.Equals(tech)).LastOrDefault()
                        End If
                        totalcell = totalcell + fc.Count
                        objfrmTechnology.SetToTech_TopXCounter(tech, totalcell)
                    End If
                End If
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try
        Next
        If Not selected_tech Is Nothing Then
            selected_tech = selected_tech.TrimEnd(",")
        End If
        sw.Stop()
        Return selected_tech
    End Function

