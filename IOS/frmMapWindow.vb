    Public Sub btnSearchChannel2G_Click(sender As Object, e As DevExpress.XtraEditors.Controls.ButtonPressedEventArgs) Handles txtSearch2GChannel.Properties.ButtonClick
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            If txtSearch2GChannel.Text <> "" Then
                'get data
                Me.Cursor = Cursors.WaitCursor
                Application.DoEvents()

                Dim freq, freqminus, freqplus As Integer
                freq = CInt(txtSearch2GChannel.Text)
                freqminus = freq - 1
                freqplus = freq + 1

                Dim parray()() As String = {
                    New String() {"@freqmatch", Chr(39) & freq & Chr(39)},
                    New String() {"@freqminus", freqminus}, New String() {"@freqplus", freqplus}
                }
                Dim connstring As String = GetSQL(1013, parray)(0)
                Dim sql_freq As String = GetSQL(1013, parray)(1)
                Dim connstring_Nano As String = GetSQL(1080, parray)(0)
                Dim sql_freq_Nano As String = GetSQL(1080, parray)(1)
                Dim connstring_2g3 As String = GetSQL(20014, parray)(0)
                Dim sql_freq_2g3 As String = GetSQL(20014, parray)(1)
                'dt_ARFCNSearch.Dispose()
                dt_ARFCNSearch = Nothing

                If connstring.StartsWith("DSN") Then
                    dt_ARFCNSearch = DataAccessorODBC.GetDataTable(connstring, sql_freq, iQryTimeOut)
                End If

                Dim dt_ARFCN_Search_Nano As DataTable = Nothing
                Dim dt_ARFCN_Search_2G3 As DataTable = Nothing
                If connstring_Nano.StartsWith("DSN") Then
                    dt_ARFCN_Search_Nano = DataAccessorODBC.GetDataTable(connstring_Nano, sql_freq_Nano, iQryTimeOut)
                End If
                If connstring_2g3.StartsWith("DSN") Then
                    dt_ARFCN_Search_2G3 = DataAccessorODBC.GetDataTable(connstring_2g3, sql_freq_2g3, iQryTimeOut)
                End If

                If Not dt_ARFCNSearch Is Nothing Then
                    If Not dt_ARFCN_Search_Nano Is Nothing Then
                        dt_ARFCNSearch.Merge(dt_ARFCN_Search_Nano)
                    End If
                    If Not dt_ARFCN_Search_2G3 Is Nothing Then
                        dt_ARFCNSearch.Merge(dt_ARFCN_Search_2G3)
                    End If
                ElseIf Not dt_ARFCN_Search_Nano Is Nothing Then
                    dt_ARFCNSearch = dt_ARFCN_Search_Nano
                    If Not dt_ARFCN_Search_2G3 Is Nothing Then
                        dt_ARFCNSearch.Merge(dt_ARFCN_Search_2G3)
                    End If
                Else
                    dt_ARFCNSearch = dt_ARFCN_Search_2G3
                End If

                Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData(Me.dt_ARFCNSearch.TableName)
                Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
                IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, dt_ARFCNSearch, "ALL")

                If dt_ARFCNSearch Is Nothing Then
                    Exit Sub
                End If

                If dt_ARFCNSearch.Rows.Count = 0 Then
                    SetStatus("Frequency not found!")
                    Exit Sub
                End If

                For Each drow As DataRow In dt_Map_Configuration.Rows
                    Dim band As String = Nothing
                    If freq < 924 And freq > 124 Then band = "DCS" Else band = "GSM"
                    If drow("LayerActive").ToString = True And drow("LayerTechnology").ToString.ToUpper = "2G" Then
                        Dim tbl As MapInfo.Data.Table = Session.Current.Catalog.GetTable(drow("LayerName").ToString.Trim)
                        If Not tbl Is Nothing Then
                            Cell_Freq2G_Map(tbl.Alias, dt_ARFCNSearch)
                        End If
                    End If
                Next
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Public Sub Cell_Freq2G_Map(ByVal strtbl As String, ByVal dt As DataTable)
        Dim connection As New MIConnection
        Try
            connection.Open()
            Dim freqtbl As String = "ARFCN_" & strtbl
            Dim freqtbltemp As String = "ARFCN_Temp_" & strtbl

            If MapControl1.Map.Legends.Count > 0 Then
                MapControl1.Map.Legends(0).Format.AutoSizeLegend = False
            End If

            connection.Catalog.CloseTable(freqtbl & "_Map")
            connection.Catalog.CloseTable(freqtbltemp)
            connection.Catalog.CloseTable(freqtbl)

            'constructing select string
            Dim sql_select As String = "SELECT "
            Dim sql_from As String = "FROM "
            Dim sql_where As String = "WHERE "
            Dim sql_total As String = ""
            Dim sql_where_channel As String = ""

            If rbSearch2GChannelAll.Checked = True Then
                sql_where_channel = ""
            ElseIf rbSearch2GChannelBCCH.Checked = True Then
                sql_where_channel = " AND " & freqtbltemp & ".TRX_Type = 'BCCH' "
            ElseIf rbSearch2GChannelTCH.Checked = True Then
                sql_where_channel = " AND " & freqtbltemp & ".TRX_Type = 'TCH' "
            ElseIf rbSearch2GChannelBSIC.Checked = True Then
                sql_where_channel = " AND " & freqtbltemp & ".TRX_TYPE = 'BCCH' AND " & freqtbltemp & ".BSIC = " & CInt(txtSearch2GChannelBSIC.Text) & "  AND " & freqtbltemp & ".ARFCN = " & CInt(txtSearch2GChannel.Text)
            End If

            For Each dcol As DataColumn In dt.Columns
                sql_select = sql_select + freqtbltemp + "." + dcol.ColumnName.ToString & ", "
            Next

            sql_select = sql_select + " MI_Centroid(" + strtbl + ".obj) as MI_Geometry "
            sql_from = sql_from + " " + strtbl + ", " + freqtbltemp + " "
            sql_where = sql_where + " " + strtbl + ".CellID = " & freqtbltemp & ".CELLID AND " + strtbl + ".LAC = " & freqtbltemp & ".LAC " + sql_where_channel
            sql_total = sql_select + sql_from + sql_where

            Dim ti As TableInfoAdoNet = New TableInfoAdoNet(freqtbltemp)
            ti.ReadOnly = True
            ti.DataTable = dt
            Dim tbl As Table = connection.Catalog.OpenTable(ti)

            Dim command As MICommand = connection.CreateCommand()
            Dim irfc As IResultSetFeatureCollection
            command.CommandText = sql_total
            irfc = command.ExecuteFeatureCollection(freqtbl & "_Map")

            Dim columns2index As StringCollection = New StringCollection()
            columns2index.Add("CELLID")
            columns2index.Add("LAC")
            Dim tbl_map As MapInfo.Data.Table = Nothing

            If irfc.Count <> 0 Then
                tbl_map = CreateMemTableFromADO(irfc.Table, columns2index, freqtbl)
                irfc.Close()
                tbl.Close()
                connection.Close()
                command.Dispose()

                'Map the query
                Dim lyr As New FeatureLayer(tbl_map)
                MapControl1.Map.Layers.Insert(0, lyr)
                MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
                Cell_Freq2G_Theme(lyr)
            Else
                'SetStatus("No cell found !")
                Exit Sub
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            connection.Close()
            SetStatus("Cell_Freq2G_Map: Problem with mapping 2G Frequencies!" & Chr(13) & ex.Message)
        End Try
    End Sub

    Private Function ColumnString_MapinfoTable_All(ByVal dt As MapInfo.Data.Table) As String
        Dim str As String = ""
        For Each col As MapInfo.Data.Column In dt.TableInfo.Columns
            str = str & col.Alias & ","
        Next col
        str = str.TrimEnd(",")
        Return str
    End Function

    Private Function CreateMemTableFromADO(ByVal tableToIndex As MapInfo.Data.Table, ByVal columnAliasToIndex As StringCollection, ByVal AliasForNewTable As String) As MapInfo.Data.Table
        lbl_GetNetworks_Status.Text = AliasForNewTable & " : Generating Geo..."
        Dim ti As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(AliasForNewTable, MapInfo.Data.TableType.MemTable, tableToIndex), MapInfo.Data.TableInfoMemTable)
        For Each Str As String In columnAliasToIndex
            ti.Columns(Str).Indexed = True
        Next
        ti.Alias = AliasForNewTable
        Dim MemTable As MapInfo.Data.Table = Nothing

        If Session.Current.Catalog.GetTable(ti.Alias) IsNot Nothing Then
            MapInfo.Engine.Session.Current.Catalog.CloseTable(ti.Alias)
        End If

        MemTable = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti)

        Dim con As New MapInfo.Data.MIConnection
        Dim com As MapInfo.Data.MICommand = con.CreateCommand()
        Dim totalrecords As Integer

        Try
            'Populating Native Table with data
            con.Open()
            'Console.WriteLine(ColumnString_MapinfoTable(MemTable).ToString)
            'populating native table with all values of datatable
            com = con.CreateCommand()
            com.CommandText = "Insert into " + MemTable.Alias + " (" + ColumnString_MapinfoTable_All(MemTable) + ") Select " & ColumnString_MapinfoTable_All(tableToIndex) + " from " + tableToIndex.Alias
            com.Prepare()
            totalrecords = com.ExecuteNonQuery
            com.Dispose()
            con.Close()

            Return MemTable
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            com.Dispose()
            con.Close()
            Return Nothing
        End Try
    End Function

