    Private Sub btnNeighbors_Click(sender As Object, e As EventArgs) Handles btnNeighbors.Click
        Try
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")

            If Not txt_CellGID_Neighbors.Text = "" Then
                Cells_SearchAndDisplay("IOS_CELL_GID", txt_CellGID_Neighbors.Text)
            End If

            'Get Technology of selected cell
            Dim SelectedTech As String = ""
            Dim enumerator As ITableEnumerator = Session.Current.Catalog.GetEnumerator
            Do While enumerator.MoveNext
                Dim table3 As Table = enumerator.Current
                Try
                    Dim features As IResultSetFeatureCollection = Session.Current.Selections.DefaultSelection.Item(table3)
                    If ((Not features Is Nothing) AndAlso (features.Count > 0)) Then
                        SelectedTech = CType(features, IDynamicFeatureCollection)(0)("TECHNOLOGY").ToString.ToUpper
                    End If
                    Continue Do
                Catch ex As Exception
                    _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                End Try
            Loop

            If (Me.cmbNBFilter.Text = "") Then
                Me.cmbNBFilter.SelectedItem = Me.cmbNBFilter.Properties.Items.Item(0)
                Me.cmbNBFilter.Text = Me.cmbNBFilter.Properties.Items.Item(0).ToString
            End If

            'getting queries for the selection
            Dim qry() As String = GetNBQuery(SelectedTech)
            WriteString_Log("NB Query: " & Now() & "    " & qry(0))

            If Me.rb_Direction_Incoming.Checked Then
                Me.dt_NBIncoming = Me.GetTableFromODBCSchema(qry(1), qry(0))
                If (Me.dt_NBIncoming Is Nothing) Then
                    Me.Cursor = Cursors.Default
                    SetStatus("No Incoming Neighbors found!")
                    Return
                End If
            End If

            If Me.rb_Direction_Outgoing.Checked Then
                Me.dt_NBOutgoing = Me.GetTableFromODBCSchema(qry(1), qry(0))
                If (Me.dt_NBOutgoing Is Nothing) Then
                    Me.Cursor = Cursors.Default
                    SetStatus("No Outgoing Neighbors found!")
                    Return
                End If
            End If

            Dim rel As String = Nothing
            Select Case True
                Case Me.rb_NB_2g2g.Checked
                    rel = "2G2G"
                Case Me.rb_NB_2g3g.Checked
                    rel = "2G3G"
                Case Me.rb_NB_2g3g.Checked
                    rel = "2G4G"
                Case Me.rb_NB_3g2g.Checked
                    rel = "3G2G"
                Case Me.rb_NB_3g3g.Checked
                    rel = "3G3G"
                Case Me.rb_NB_3g3g.Checked
                    rel = "3G4G"
                Case Me.rb_NB_4g4g.Checked
                    rel = "4G4G"
                Case Me.rb_NB_4g3g.Checked
                    rel = "4G3G"
                Case Me.rb_NB_4g2g.Checked
                    rel = "4G2G"
                Case Me.rb_NB_5g5g.Checked
                    rel = "5G5G"
                Case Me.rb_NB_5g4g.Checked
                    rel = "5G4G"
                Case Me.rb_NB_4g5g.Checked
                    rel = "4G5G"
            End Select

            If Me.rb_Direction_Incoming.Checked Then
                Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData("NB_In_" & rel & "_" & txt_CellGID_Neighbors.Text)
                Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
                IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, Me.dt_NBIncoming, "ALL")
                Me.Neighbor_Plot(Me.dt_NBIncoming)
                cmbNBFilter_Update(dt_NBIncoming.Columns)
            ElseIf Me.rb_Direction_Outgoing.Checked Then
                Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData("NB_Out_" & rel & "_" & txt_CellGID_Neighbors.Text)
                Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
                IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, Me.dt_NBOutgoing, "ALL")
                Me.Neighbor_Plot(Me.dt_NBOutgoing)
                cmbNBFilter_Update(dt_NBOutgoing.Columns)
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

