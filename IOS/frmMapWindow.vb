    Public Sub SelectFeatureOnEventFormClick(ByVal id As Integer)
        Try
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Start SelectFeatureOnEventFormClick")
            Dim found As Boolean = False
            Dim fGeometory As FeatureGeometry = Nothing
            Dim tbl As MapInfo.Data.Table
            tbl = Session.Current.Catalog.GetTable(frmEvent.eventMapLayerName)

            Dim expression As String = "id=" & id
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Starting  IResultSetFeatureCollection from Current Catalog")
            If Not tbl Is Nothing Then
                Dim irfc As IResultSetFeatureCollection = Session.Current.Catalog.Search(tbl, MapInfo.Data.SearchInfoFactory.SearchWhere(expression))
                If irfc.Count <> 0 Then
                    For Each f As Feature In irfc
                        If Not (found) Then
                            fGeometory = f.Geometry
                            MapInfo.Engine.Session.Current.Selections.DefaultSelection.Clear()
                            MapInfo.Engine.Session.Current.Selections.DefaultSelection.Add(irfc)
                            found = True
                        End If
                    Next
                End If
                irfc.Close()
                _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "After IResultSetFeatureCollection")
                _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Seting fGeometory on MapControl1.Map.SetView")
                If found Then
                    If Not (fGeometory.Centroid.IsIn(MapControl1.Map.Bounds)) Then
                        MapControl1.Map.SetView(fGeometory)
                    End If
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Exit SelectFeatureOnEventFormClick")
        End Try
    End Sub

