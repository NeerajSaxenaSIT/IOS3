                ClearTempTable(tempSelectRectDT)
            ElseIf (addRectagulType = IOS.AddRectangleType.RegionTag) Then
                ClearTempTable(tempRegionTagDT)
            End If
        ElseIf (e.ToolName = "AddPolygon" Or e.ToolName = "AddCircle") Then
            If (addRectagulType = IOS.AddRectangleType.RegionTag) Then
                ClearTempTable(tempRegionTagDT)
            End If
        End If
    End Sub

    Private Sub Tools_FeatureAdded(ByVal sender As Object, ByVal e As MapInfo.Tools.FeatureAddedEventArgs)
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            If (e.ToolName = "AddRectangle") Then
                If (addRectagulType = AddRectangleType.ActiveArea) Then
                    If (tglDTFilterArea.ToggleState = CheckState.Checked) Then
                        BindDT_SelectionArea()
                    ElseIf (tglDtDisplayArea.ToggleState = CheckState.Checked) Then
                        Dim x1 As Double = activeRectCoordinates.X1
                        Dim y1 As Double = activeRectCoordinates.Y1
                        Dim x2 As Double = activeRectCoordinates.X2
                        Dim y2 As Double = activeRectCoordinates.Y2
                        If Not (x1 = 0 Or x2 = 0 Or y1 = 0 Or y2 = 0) Then
                            If (x1 > x2) Then
                                Dim tempX As Double
                                tempX = x1
                                x1 = x2
                                x2 = tempX
                            End If
                            If (y1 > y2) Then
                                Dim tempY As Double
                                tempY = y1
                                y1 = y2
                                y2 = tempY
                            End If
                        End If
                        strpx1 = x1
                        strpy1 = y1
                        strpx2 = x2
                        strpy2 = y2
                    End If
                ElseIf (addRectagulType = AddRectangleType.RegionTag AndAlso isFeatureAddedCalled) Then
                    Dim featurePolygon As MapInfo.Geometry.Rectangle = TryCast(e.Feature, MapInfo.Geometry.Rectangle)
                    Dim geometryFeature As MapInfo.Geometry.FeatureGeometry = TryCast(featurePolygon, MapInfo.Geometry.FeatureGeometry)
                    'geometryFeature = TryCast(featurePolygon, MapInfo.Geometry.FeatureGeometry)
                    frmTagManager.Visible = True
                    frmTagManager.SetRectRegionSelection(geometryFeature)
                    objMapHelper.RemoveLayer(tempRegionTagDT)
                    isFeatureAddedCalled = False
                End If
            ElseIf (e.ToolName = "AddPolygon" AndAlso isFeatureAddedCalled) Then
                If (addRectagulType = IOS.AddRectangleType.RegionTag) Then
                    Dim featurePolygon As MapInfo.Geometry.MultiPolygon = TryCast(e.Feature, MapInfo.Geometry.MultiPolygon)
                    Dim geometryFeature As MapInfo.Geometry.FeatureGeometry = TryCast(featurePolygon, MapInfo.Geometry.FeatureGeometry)
                    'geometryFeature = TryCast(featurePolygon, MapInfo.Geometry.FeatureGeometry)
                    frmTagManager.Visible = True
                    frmTagManager.SetRectRegionSelection(geometryFeature)
                    objMapHelper.RemoveLayer(tempRegionTagDT)
                    isFeatureAddedCalled = False
                End If
            ElseIf (e.ToolName = "AddCircle" AndAlso isFeatureAddedCalled) Then
                If (addRectagulType = IOS.AddRectangleType.RegionTag) Then
                    Dim featurePolygon As MapInfo.Geometry.Ellipse = TryCast(e.Feature, MapInfo.Geometry.Ellipse)
                    Dim geometryFeature As MapInfo.Geometry.FeatureGeometry = TryCast(featurePolygon, MapInfo.Geometry.FeatureGeometry)

                    'geometryFeature = TryCast(featurePolygon, MapInfo.Geometry.FeatureGeometry)
                    frmTagManager.Visible = True
                    frmTagManager.SetRectRegionSelection(geometryFeature)
                    objMapHelper.RemoveLayer(tempRegionTagDT)
                    isFeatureAddedCalled = False
                End If
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

