    Private Function CNE_MapGeoAgg_Create(ByVal dt As DataTable, ByVal maptable As String) As FeatureLayer
        Dim connection As MIConnection = New MIConnection()
        Try
            connection.Open()
            connection.Catalog.CloseTable(maptable)
            connection.Catalog.CloseTable(Replace(maptable, "_Map", ""))

            Dim ti As TableInfoAdoNet = New TableInfoAdoNet(Replace(maptable, "_Map", ""))
            ti.ReadOnly = True
            ti.DataTable = dt
            Dim tbl_ExternalData As Table = connection.Catalog.OpenTable(ti)
            Dim tbl_map As MapInfo.Data.Table = Nothing
            Dim MaptableName = maptable
            connection.Catalog.CloseTable(MaptableName)

            Dim columns2index As StringCollection = New StringCollection
            columns2index.Add("GeoID")

            tbl_map = CNE_CreateMemTableFromADO(tbl_ExternalData, columns2index, MaptableName)

            Dim lyr As New FeatureLayer(tbl_map)
            MapControl1.Map.Layers.Add(lyr)
            MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
            Return lyr
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            If Not connection Is Nothing Then
                connection.Close()
                connection.Dispose()
                connection = Nothing
            End If
        End Try
        Return Nothing
    End Function

    Private Function CNE_CreateMemTableFromADO(ByVal tableToIndex As MapInfo.Data.Table, ByVal columnAliasToIndex As StringCollection, ByVal AliasForNewTable As String) As MapInfo.Data.Table
        'lbl_GetNetworks_Status.Text = AliasForNewTable & " : Generating Geo..."

        Dim ti As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(AliasForNewTable, MapInfo.Data.TableType.MemTable, tableToIndex), MapInfo.Data.TableInfoMemTable)
        'For Each Str As String In columnAliasToIndex
        'ti.Columns(Str).Indexed = True
        'Next
        ti.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
        ti.Columns.Add(ColumnFactory.CreateStyleColumn())
        ti.Alias = AliasForNewTable

        Dim MemTable As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti)
        Dim con As New MapInfo.Data.MIConnection
        Dim com As MapInfo.Data.MICommand = con.CreateCommand()
        Dim totalrecords As Integer

        Dim sf As StyleFactory = New StyleFactory()
        Dim cs As CompositeStyle
        cs = sf.FromMBString("Pen(1,2,0)")
        Dim cStyle As CompositeStyle

        Dim networkcolor As Color = Color.White
        Dim iStyle As SimpleInterior = New SimpleInterior(2, networkcolor, networkcolor, False)
        Dim lStyle As SimpleLineStyle = New SimpleLineStyle(1)
        Dim astyle As New MapInfo.Styles.AreaStyle(lStyle, iStyle)

        cStyle = New MapInfo.Styles.CompositeStyle(astyle)

        Try
            'Populating Native Table with data
            con.Open()
            'Console.WriteLine(ColumnString_MapinfoTable(MemTable).ToString)
            'populating native table with all values of datatable
            com = con.CreateCommand()
            com.CommandText = "Insert into " + MemTable.Alias + " (" + ColumnString_MapinfoTable(MemTable) + ",obj,MI_Style) Select " & ColumnString_MapinfoTable(tableToIndex) + ", MI_Box(x1,y1,x2,y2,'epsg:4326'), @style MI_Style from " + tableToIndex.Alias
            com.Parameters.Add("@style", cStyle)
            com.Prepare()
            totalrecords = com.ExecuteNonQuery
            com.Dispose()
            Return MemTable
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            Return Nothing
        Finally
            If Not com Is Nothing Then
                com.Dispose()
                com = Nothing
            End If
            If Not con Is Nothing Then
                con.Close()
                con.Dispose()
                con = Nothing
            End If
        End Try
    End Function

