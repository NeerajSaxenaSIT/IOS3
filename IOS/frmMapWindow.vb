                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("CELLID")).ToString
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("LAC")).ToString
                ElseIf Not dt.Columns("CELL_ID") Is Nothing And Not dt.Columns("LAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("CELL_ID")).ToString
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("LAC")).ToString
                ElseIf Not dt.Columns("WCEL_ID") Is Nothing And Not dt.Columns("LAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("WCEL_ID")).ToString
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("LAC")).ToString
                ElseIf Not dt.Columns("WCEL_ID") Is Nothing And Not dt.Columns("WCEL_LAC") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("WCEL_ID")).ToString
                    lac = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("WCEL_LAC")).ToString
                ElseIf Not dt.Columns("CELL") Is Nothing And Not dt.Columns("TECH") Is Nothing Then
                    cellid = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("CELL")).ToString
                    tech = tempGrid.GetRowCellValue(iRowSelected, tempGrid.Columns.Item("TECH")).ToString
                ElseIf Not dt.Columns("TICKET") Is Nothing Then
                    ticket = dt(tempGrid.FocusedRowHandle)("TICKET").ToString
                End If

                If Not cellid Is Nothing And Not lac Is Nothing And cellid <> "" And lac <> "" Then
                    Cell_LAC_SearchAndDisplay(cellid, lac)
                ElseIf Not cellid Is Nothing And Not tech Is Nothing And cellid <> "" And tech <> "" Then
                    'Cells_SearchAndDisplay("IN(" & Chr(39) & cellid & Chr(39) & ")", tech)
                ElseIf Not ticket Is Nothing Then
                    frmTicketDetail.Show()
                    frmTicketDetail.FetchTicket(ticket.Substring(3))
