    Private Sub LoadDriveTestTree()
        Try
            Dim sbQuery As New System.Text.StringBuilder()
            sbQuery.AppendLine("Select Distinct 0 as Dtid, 'ROOT' as ParentId, Project as ObjectName, '' As Equipment From IOS_DT.dbo.DT_List UNION ALL")
            sbQuery.AppendLine("Select Distinct 0 as Dtid, Project as ParentId, Drivetest as ObjectName, '' As Equipment From IOS_DT.dbo.DT_List UNION ALL")
            sbQuery.AppendLine("Select Distinct Dtid, Drivetest as ParentId, Device as ObjectName, Equipment From IOS_DT.dbo.DT_List;")
            Dim dtTree As DataTable = DataAccessorODBC.GetDataTable(conn_IOSDriveTestModule, sbQuery.ToString())
            RemoveHandler tvDriveTest.FocusedNodeChanged, AddressOf tvDriveTest_FocusedNodeChanged
            RemoveHandler tvDriveTest.NodeChanged, AddressOf tvDriveTest_NodeChanged
            FillTreeList(tvDriveTest, "ROOT", dtTree)
            AddHandler tvDriveTest.NodeChanged, AddressOf tvDriveTest_NodeChanged
            AddHandler tvDriveTest.FocusedNodeChanged, AddressOf tvDriveTest_FocusedNodeChanged
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            DataAccessorODBC.KeepConnectionOpen = False
        End Try
    End Sub

    Sub FillTreeList(ByRef tl As TreeList, rNode As String, ByVal dt As DataTable)
        If dt Is Nothing Then Exit Sub
        Try
            tl.Cursor = Cursors.WaitCursor
            tl.BeginUnboundLoad()
            Application.DoEvents()
            tl.Nodes.Clear()
            tl.PupulateTreeListColumn({"ParentID", "ObjectName", "Equipment"}, "ObjectName")

            Dim tlNode As TreeListNode = tl.Nodes.Add(New Object() {rNode, rNode, ""})
            tl.PopulateTreeList(rNode, tlNode, dt)
        Catch ex As Exception
        Finally
            tl.EndUnboundLoad()
            If tl.Nodes.Count > 0 Then
                tl.UncheckAll()
                tl.FocusedNode = Nothing
                tl.CollapseAll()
                tl.ExpandToLevel(0)
            End If
            tl.Cursor = Cursors.Default
            Application.DoEvents()
        End Try

        rbScanner.Enabled = False
        rbScanner.Checked = False

        rbUE.Enabled = False
        rbUE.Checked = False

        ceTech2G.Enabled = False
        ceTech2G.Checked = False

        ceTech3G.Enabled = False
        ceTech3G.Checked = False

        ceTech4G.Enabled = False
        ceTech4G.Checked = False

    End Sub

    Private Function GetdriveTest() As DataTable
        Try
            Dim pList As New List(Of System.Data.Odbc.OdbcParameter)
            Dim sbQuery As New System.Text.StringBuilder()
            Dim IsWithParameter As Boolean = False

            sbQuery.AppendLine("Select Distinct 0 as Dtid, 'ROOT' as ParentId, Project as ObjectName, '' As Equipment From IOS_DT.dbo.DT_List UNION ALL")
            sbQuery.AppendLine("Select Distinct 0 as Dtid, Project as ParentId, Drivetest as ObjectName, '' As Equipment From IOS_DT.dbo.DT_List UNION ALL")
            sbQuery.AppendLine("Select Distinct Dtid, Drivetest as ParentId, Device as ObjectName, Equipment From IOS_DT.dbo.DT_List ")

            If (tglDTFilterArea.ToggleState = CheckState.Checked AndAlso Not (activeRectCoordinates Is Nothing)) Then
                Dim x1 As Double = activeRectCoordinates.X1
                Dim y1 As Double = activeRectCoordinates.Y1
                Dim x2 As Double = activeRectCoordinates.X2
                Dim y2 As Double = activeRectCoordinates.Y2
                If Not (x1 = 0 Or x2 = 0 Or y1 = 0 Or y2 = 0) Then
                    IsWithParameter = True
                    If (x1 > x2) Then
                        Dim tempX As Double
                        tempX = x1
                        x1 = x2
                        x2 = tempX
                    End If
                    If (y1 > y2) Then
                        Dim tempY As Double
                        tempY = y1
                        y1 = y2
                        y2 = tempY
                    End If
                    pList.Add(New System.Data.Odbc.OdbcParameter("@x1", x1))
                    pList.Add(New System.Data.Odbc.OdbcParameter("@x2", x2))
                    pList.Add(New System.Data.Odbc.OdbcParameter("@y1", y1))
                    pList.Add(New System.Data.Odbc.OdbcParameter("@y2", y2))

                    sbQuery.Insert(0, "declare @x1 as float=?; declare @x2 as float=?; declare @y1 as float=?; declare @y2 as float=?; ")
                    sbQuery.AppendLine(" Where Dtid in(select distinct dtid from dbo.DT_Scan2G_Parallel where (PX between @x1 and @x2) AND PY between @y1 and @y2 union")
                    sbQuery.AppendLine(" select distinct dtid from dbo.DT_Scan3G_Parallel where (PX between @x1 and @x2) AND PY between @y1 and @y2 union")
                    sbQuery.AppendLine(" select distinct dtid from dbo.DT_Scan4G_Parallel where (PX between @x1 and @x2) AND PY between @y1 and @y2 union")
                    sbQuery.AppendLine(" select distinct dtid from dbo.DT_UE2G_Parallel where (PX between @x1 and @x2) AND PY between @y1 and @y2 union")
                    sbQuery.AppendLine(" select distinct dtid from dbo.DT_UE3G_Parallel where (PX between @x1 and @x2) AND PY between @y1 and @y2 union")
                    sbQuery.AppendLine(" select distinct dtid from dbo.DT_UE4G_Parallel where (PX between @x1 and @x2) AND PY between @y1 and @y2)")

                End If
            End If
            If (IsWithParameter) Then
                dt = DataAccessorODBC.GetDataTable(conn_IOSDriveTestModule, sbQuery.ToString(), pList)
            Else
                dt = DataAccessorODBC.GetDataTable(conn_IOSDriveTestModule, sql)
            End If
            Return dt
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message)
            Return Nothing
        Finally
            DataAccessorODBC.KeepConnectionOpen = False
        End Try
    End Function

