    Public Sub LoadNetworks_Sites_FromPreGenerated(ByVal dateSelected As Date, ByVal layerConfig As DataRow)
        Dim connection As MIConnection = New MIConnection
        Try
            lbl_GetNetworks_Status.Text = "Status: " & layerConfig.Item("LayerTechnology").ToString & ": Fetching Site Data..."
            pbcGetNetworks.Position = 0
            Application.DoEvents()

            Dim dateid As String
            dateid = dateSelected.ToString("yyyyMMdd")
            tblname = "Sites_" & layerConfig.Item("LayerTechnology").ToString
            If connection.State = ConnectionState.Closed Then
                connection.Open()
            End If

            Dim LayerLineColor As Integer = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerTechnology") = layerConfig("LayerTechnology").ToString).ToArray()(0)("LayerLinecolor")
            Dim dStyle As Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.FontPointStyle(35, New MapInfo.Styles.Font("MapInfo Symbols", 6), 0, ColorInt2Color(LayerLineColor), 6))
            Dim newtbl2 As MapInfo.Data.Table = Nothing

            Dim checkItemList() As String = {""} 'DirectCast(cmbNetworkArea.Properties.GetCheckedItems(), String).Split({","}, StringSplitOptions.RemoveEmptyEntries)
            checkItemList(0) = cmbNetworkArea.SelectedItem.ToString
            If checkItemList.Length = 0 Then
                ReDim checkItemList(0)
                checkItemList(0) = "ALL"
            End If
            For i As Integer = 0 To checkItemList.Length - 1

                Dim networkArea As String = Trim(checkItemList(i))
                Dim drFile() As DataRow = dt_Network_TabFiles.AsEnumerable().Where(Function(x) x.Field(Of Integer)("NetworkDate") = dateid And x.Field(Of String)("NetworkArea") = networkArea And x.Field(Of String)("TABFileName").Contains(tblname) And Not x.Field(Of String)("TABFileName").Contains("Voronoi")).ToArray()
                If drFile IsNot Nothing AndAlso drFile.Length > 0 Then
                    connection.Catalog.CloseTable(tblname & "_" & networkArea)
                    connection.Catalog.CloseTable(tblname)

                    Dim sourcePath As String = CopyFileFromNetworkToLocalPath(drFile(0).Item("TABFileName").ToString)
                    newtbl2 = MapInfo.Engine.Session.Current.Catalog.OpenTable(sourcePath)
                    pbcGetNetworks.Position = CInt(System.Math.Min(100, 100))
                    Application.DoEvents()
                End If

                If newtbl2 Is Nothing Then
                    connection.Close()
                    connection.Dispose()
                    Exit Sub
                End If

                'Adding Feature Layer
                Dim lyr2 As New FeatureLayer(newtbl2)
                MapControl1.Map.Layers.Add(lyr2)
                mapLyrBounds.Add(lyr2.Alias, lyr2.Bounds)
                MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr2), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
                MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr2, "SITECODE")
                MapInfo.Mapping.LayerHelper.SetSelectable(lyr2, False)
                lyr2.Enabled = False

                'Adding Label Layer
                connection.Catalog.CloseTable("Labels_" & tblname & "_" & networkArea)
                CreateNetworkLabels(newtbl2, "SITECODE", 10, 1)

                'Voronoi Calculation
                If cbVoronoi.Checked = True Then
                    connection.Catalog.CloseTable(tblname & "_Voronoi_" & networkArea)
                    Dim newtbl2_voronoi As MapInfo.Data.Table = Nothing
                    Dim drFile1() As DataRow = dt_Network_TabFiles.AsEnumerable().Where(Function(x) x.Field(Of Integer)("NetworkDate") = dateid And x.Field(Of String)("NetworkArea") = cmbNetworkArea.SelectedItem.ToString And x.Field(Of String)("TABFileName").Contains(tblname & "_Voronoi")).ToArray()
                    If drFile1 IsNot Nothing AndAlso drFile1.Length > 0 Then
                        Dim sourcePath As String = CopyFileFromNetworkToLocalPath(drFile1(0).Item("TABFileName").ToString)
                        newtbl2_voronoi = MapInfo.Engine.Session.Current.Catalog.OpenTable(sourcePath)
                    End If

                    If Not newtbl2_voronoi Is Nothing Then
                        Dim lyr2_voronoi As New FeatureLayer(newtbl2_voronoi)
                        lyr2_voronoi.Enabled = False
                        MapControl1.Map.Layers.Add(lyr2_voronoi)
                        mapLyrBounds.Add(lyr2_voronoi.Alias, lyr2_voronoi.Bounds)
                        MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr2_voronoi), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
                        MapInfo.Mapping.LayerHelper.SetSelectable(lyr2_voronoi, False)
                    End If
                End If
                Layer_Voronoi_Update()
            Next

            lbl_GetNetworks_Status.Text = "Finished !"
            connection.Close()
            connection.Dispose()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            If connection.State = ConnectionState.Open Then
                connection.Close()
                connection.Dispose()
            End If
        End Try
    End Sub

    Public Sub Cell_Top20_Map(ByVal tech As String, ByVal kpi As String, ByVal dt As DataTable, ByVal topxmaptype As Integer,
                                  ByVal themeExpression As String, ByVal layrePrefix As String, Optional ByVal MaptoVoronoi As Boolean = False,
                                  Optional ByVal MapToSite As Boolean = False, Optional ByVal MapToEachLayer As Boolean = False)
        Dim connection As New MIConnection
        Try
            WaitScreen.ShowWaitScreen("Mapping KPI...")
            SetStatus("Mapping KPI...")
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()
            connection.Open()
            Dim topxtbl As String = layrePrefix & Replace(tech, " ", "_") & "_" & kpi
            connection.Catalog.CloseTable(kpi)
            PrevKpiTable = kpi
            connection.Catalog.CloseTable(topxtbl & "_Map")
            PrevLayerName = topxtbl & "_Map"
            connection.Catalog.CloseTable(themeExpression)

            'truncate 30 
            For Each dcol As DataColumn In dt.Columns
                If dcol.ColumnName.Length >= 30 Then
                    If dcol.ColumnName = themeExpression Then
                        themeExpression = dcol.ColumnName.Substring(0, 27) + dcol.Ordinal.ToString
                    End If
                    dcol.ColumnName = dcol.ColumnName.Substring(0, 27) + dcol.Ordinal.ToString
                End If
            Next

            'constructing select string
            Dim sql_select As String = "SELECT "
            Dim sql_from As String = "FROM "
            Dim sql_where As String = "WHERE "

            For Each dcol As DataColumn In dt.Columns
                sql_select = sql_select + kpi + "." + dcol.ColumnName.ToString & ", "
            Next

            Dim cellsearch As String = ""

            'Find Out Object of Respective form with the help of Vender and Tech
            objfrmTechnology = Nothing
            If Not objFrmTechList.Exists(Function(x) x.Network.ToUpper.Equals(tech)) Then
                frmMDI.OpenTechFormDynamically(tech, objfrmTechnology, False)
            Else
                objfrmTechnology = objFrmTechList.Where(Function(x) x.Network.Equals(tech)).LastOrDefault()
            End If

            If objfrmTechnology IsNot Nothing Then
                If tech.ToLower = networkAll.Network3G1.ToLower Then
                    If sql_select.Contains(flpSourceBtn_GetType(networkAll.Network3G1, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText) Then
                        cellsearch = flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                    Else
                        cellsearch = flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                        If IOSAppConfigManage.DeploymentName = "TMNL" Then
                            For Each drow As DataRow In dt.Rows
                                drow.BeginEdit()
                                drow.Item(flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText) = drow(flpSourceBtn_GetType(objfrmTechnology.Network, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText).ToString.Substring(0, 5)
                                drow.AcceptChanges()
                                drow.EndEdit()
                            Next
                        End If
                    End If
                ElseIf tech.ToLower = networkAll.NetworkTX.ToLower Or tech.ToLower = networkAll.NetworkTX2.ToLower Then
                    If sql_select.Contains(flpSourceBtn_GetType(objfrmTechnology.Network, "LINK", objfrmTechnology.flpCounterTypeTopX).SourceButtonText) Then
                        cellsearch = flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "LINK", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                    End If
                ElseIf tech.ToLower = objfrmTechnology.Network.ToLower Then
                    If sql_select.Contains(flpSourceBtn_GetType(objfrmTechnology.Network, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText) Then
                        cellsearch = flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                    Else
                        cellsearch = flpSourceBtn_GetType("topx_" & objfrmTechnology.Network, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText
                    End If
                End If
            End If
            Dim ti As TableInfoAdoNet = New TableInfoAdoNet(kpi)
            ti.ReadOnly = True
            ti.DataTable = dt

            Dim table As Table = connection.Catalog.OpenTable(ti)


            Dim tbl As MapInfo.Data.Table = Nothing
            Dim tbl_map As MapInfo.Data.Table = Nothing

            GetSelectedThemeData(TechThematicID)


            'If drw("LayerActive") = True AndAlso drw("LayerTech").ToString.ToUpper = tech.ToUpper AndAlso frmMapWindow.MapControl1.Map.Layers(drw("LayerName")).IsVisible = True Then

            '    WaitScreen.ShowWaitScreen("Layers To Process: " & CInt(visibleLyrCntr - processedLyrCntr) & vbCrLf & "Mapping Layer: " & drw("LayerName").ToString.Trim)


            If MapToSite = False Then
                For Each drow As DataRow In dt_Map_Configuration.Rows
                    Dim sql_select_final As String = ""
                    Dim sql_from_final As String = ""
                    Dim sql_where_final As String = ""
                    Dim sql_total As String = ""
                    If topxmaptype = 3 Or MaptoVoronoi = True Then
                        tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim & "_Voronoi")
                    Else
                        tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim)
                    End If

                    If (drow.Item("LayerTech").ToString.ToUpper = tech.ToUpper And Not tbl Is Nothing) Then
                        If (MapControl1.Map.Layers(drow("LayerName")).IsVisible = True And MapToEachLayer = True) Or MapToEachLayer = False Then


                            Dim field2search As String = "CELLID"
                            Try
                                Dim colToMap As String = drow("LayerColumn2Tree").ToString
                                If (Not String.IsNullOrEmpty(colToMap)) Then
                                    field2search = colToMap
                                End If
                            Catch ex As Exception

                            End Try
                            sql_select_final = sql_select + " " + tbl.Alias + ".obj "

                            sql_from_final = sql_from + kpi & ", " + tbl.Alias + " "

                            If cellsearch = flpSourceBtn_GetType("topx_" & tech, "CELL", objfrmTechnology.flpCounterTypeTopX).SourceButtonText Then
                                sql_where_final = sql_where + kpi & "." + cellsearch + " = " + tbl.Alias + "." & field2search
                            ElseIf cellsearch = flpSourceBtn_GetType("topx_" & tech, "SITE", objfrmTechnology.flpCounterTypeTopX).SourceButtonText Then
                                sql_where_final = sql_where + "UPPER(" + kpi & "." + cellsearch + ") = UPPER(" + tbl.Alias + ".SiteCode)"
                            ElseIf cellsearch = flpSourceBtn_GetType("topx_" & tech, "LINK", objfrmTechnology.flpCounterTypeTopX).SourceButtonText Then
                                sql_where_final = sql_where + kpi & "." + cellsearch + " = " + tbl.Alias + "." & field2search
                            End If

                            sql_total = sql_select_final + sql_from_final + sql_where_final
                            Dim command As MICommand = connection.CreateCommand()
                            Dim irfc As IResultSetFeatureCollection
                            command.CommandText = sql_total
                            If MapToEachLayer = False Then
                                irfc = command.ExecuteFeatureCollection()
                            Else
                                WaitScreen.ShowWaitScreen("Mapping Layer: " & drow("LayerName").ToString.Trim)
                                Application.DoEvents()

                                irfc = command.ExecuteFeatureCollection(drow.Item("LayerName").ToString & "_" & kpi & "_Map")
                            End If

                            If irfc.Count <> 0 Then
                                If MapToEachLayer = False Then
                                    If connection.Catalog.GetTable(topxtbl & "_Map") Is Nothing Then
                                        Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(topxtbl & "_Map", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                                        tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                                        tbl_map.InsertFeatures(irfc)
                                    Else
                                        tbl_map = Session.Current.Catalog.GetTable(topxtbl & "_Map")
                                        tbl_map.InsertFeatures(irfc)
                                    End If
                                    command.Dispose()
                                Else
                                    Try
                                        Dim lyr As New FeatureLayer(irfc.Table)
                                        MapControl1.Map.Layers.Insert(0, lyr)
                                        Dim lyr2 As FeatureLayer = CType(MapControl1.Map.Layers(tbl.Alias), FeatureLayer)
                                        Layer_View(irfc.Alias, lyr2.Enabled)
                                        MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)

                                        If topxmaptype = 1 Then
                                            Dim thm1 As MapInfo.Mapping.Thematics.GraduatedSymbolTheme = New MapInfo.Mapping.Thematics.GraduatedSymbolTheme(lyr.Table, themeExpression)
                                            Try
                                                Dim linecolor As Integer = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerName") = tbl.Alias).ToArray()(0)("LayerLineColor")
                                                thm1.PositiveSymbol.Color = ColorInt2Color(linecolor)
                                            Catch ex As Exception

                                            End Try

                                            Dim objthm As ObjectThemeLayer = New ObjectThemeLayer(lyr.Table.Alias, Nothing, thm1)
                                            'Dim objthm As ObjectThemeLayer = New ObjectThemeLayer(themeExpression, Nothing, thm1)
                                            MapControl1.Map.Layers.Add(objthm)
                                            objthm.RebuildTheme()
                                            Legend_CreateThematic(thm1, themeExpression, lyr)
                                            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(lyr.Table))
                                        Else
                                            'set view
                                            '    Dim thm2 As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, dt.TableName, 8, Thematics.DistributionMethod.EqualCountPerRange)
                                            '    thm2.RoundBy = 0.01

                                            '    'starting color
                                            '    thm2.Bins(0).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(1, 0), 2, Color.DarkBlue, False)
                                            '    thm2.Bins(0).Style.AreaStyle.Interior = New SimpleInterior(2, Color.DarkBlue)

                                            '    thm2.InflectionColor = Color.FromArgb(168, Color.Yellow)
                                            '    thm2.InflectionIndex = 3
                                            '    thm2.Inflected = True
                                            '    thm2.Recompute()

                                            '    For i = 0 To thm2.Bins.Count - 1
                                            '        Dim si As SimpleInterior = thm2.Bins(i).Style.AreaStyle.Interior
                                            '        Dim frcolor As Color = Color.FromArgb(168, si.ForeColor)
                                            '        Dim frcolorbrdr As Color = Color.FromArgb(255, si.ForeColor)

                                            '        thm2.Bins(i).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(1, 0), 2, frcolorbrdr, False)
                                            '        thm2.Bins(i).Style.AreaStyle.Interior = New SimpleInterior(si.Pattern, frcolor)
                                            '    Next
                                            '    'thm2.Recompute()
                                            '    thm2.Bins(thm2.InflectionIndex).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(1, 0), 2, thm2.InflectionColor, False)
                                            '    thm2.Bins(thm2.InflectionIndex).Style.AreaStyle.Interior = New SimpleInterior(2, thm2.InflectionColor)

                                            '    lyr.Modifiers.Append(thm2)
                                            '    Legend_CreateThematic(thm2, themeExpression, lyr)
                                            '    MapInfo.Engine.Session.Current.MapFactory(0).SetView(irfc.Envelope.GeometricCentroid, irfc.Envelope.CoordSys, GetMapZoomDistance())
                                            '    MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(lyr.Table))

                                            legendMappingDate = CDate(dt.Rows(0)("Date")).ToString("dd/MM/yyyy HH:mm:ss")
                                            ApplyRangeTheme(False, lyr, themeExpression, Nothing, dtKpiInfoThemeBins, dtKpiInfoThemeBins.Rows.Count)
                                            MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(lyr.Table))

                                        End If
                                        WaitScreen.CloseWaitScreen()
                                        Application.DoEvents()

                                    Catch ex As Exception

                                    End Try
                                End If
                            End If
                        End If
                    End If
                Next
            Else
                Dim technology As String = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerTech") = tech).ToArray()(0)("LayerTechnology").ToString.ToUpper

                Dim SiteTable As String = "Sites_" & technology
                Dim sql_select_final As String = ""
                Dim sql_from_final As String = ""
                Dim sql_where_final As String = ""
                Dim sql_total As String = ""

                If topxmaptype = 3 Or MaptoVoronoi = True Then
                    tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(SiteTable & "_Voronoi")
                Else
                    tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(SiteTable)
                End If

                If Not tbl Is Nothing Then

                    sql_select_final = sql_select + " " + tbl.Alias + ".obj "

                    sql_from_final = sql_from + kpi & ", " + tbl.Alias + " "
                    sql_where_final = sql_where + kpi & "." + cellsearch + " = " + tbl.Alias + ".SiteCode"
                    sql_total = sql_select_final + sql_from_final + sql_where_final
                    Dim command As MICommand = connection.CreateCommand()
                    Dim irfc As IResultSetFeatureCollection
                    command.CommandText = sql_total
                    irfc = command.ExecuteFeatureCollection()

                    If irfc.Count <> 0 Then
                        If connection.Catalog.GetTable(topxtbl & "_Map") Is Nothing Then
                            Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(topxtbl & "_Map", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                            tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                            tbl_map.InsertFeatures(irfc)
                        Else
                            tbl_map = Session.Current.Catalog.GetTable(topxtbl & "_Map")
                            tbl_map.InsertFeatures(irfc)
                        End If
                        command.Dispose()
                    End If
                End If
            End If
            If tbl_map Is Nothing Then
                connection.Close()
                Exit Sub
            End If

            'Map the query
            If CountRowsInTable(tbl_map, False) > 0 And MapToEachLayer = False Then
                Dim lyr As New FeatureLayer(tbl_map)
                'set view
                If topxmaptype = 1 Then
                    Dim thm1 As MapInfo.Mapping.Thematics.GraduatedSymbolTheme = New MapInfo.Mapping.Thematics.GraduatedSymbolTheme(lyr.Table, themeExpression)
                    If (themeExpression.ToUpper = "ParamHistoryMap".ToUpper) Then
                        If (tech.ToUpper.Contains("2G")) Then
                            thm1.PositiveSymbol = New MapInfo.Styles.SimpleVectorPointStyle(46, Color.Red, 36)
                        End If
                        If (tech.ToUpper.Contains("3G")) Then
                            thm1.PositiveSymbol = New MapInfo.Styles.SimpleVectorPointStyle(46, Color.Blue, 36)
                        End If
                        If (tech.ToUpper.Contains("4G")) Then
                            thm1.PositiveSymbol = New MapInfo.Styles.SimpleVectorPointStyle(46, Color.Orange, 36)
                        End If
                    End If
                    Dim objthm As ObjectThemeLayer = New ObjectThemeLayer(lyr.Table.Alias, Nothing, thm1)
                    'Dim objthm As ObjectThemeLayer = New ObjectThemeLayer(themeExpression, Nothing, thm1)
                    MapControl1.Map.Layers.Add(objthm)
                    objthm.RebuildTheme()
                ElseIf topxmaptype = 2 Then
                    Dim geoHeatMapData As New GeoAggregationData(tbl_map.Alias, themeExpression, "SUM")
                    geoHeatMapData.GeoDataType = GeoDataType.HeatMap
                    GeoAggregationManager.RemoveByTableNameAndType(geoHeatMapData)
                    GeoAggregationManager.Add(geoHeatMapData)
                    GeoAggregationManager.GenerateGeoAggregation(AddressOf CreateGridFromFeatures, GeoDataType.HeatMap)

                    'CreateHTMLForHeatmap(tbl_map, PrevLayerName, kpi)
                Else
                    MapControl1.Map.Layers.Add(lyr)
                    'Dim thm2 As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, themeExpression, 8, Thematics.DistributionMethod.EqualRangeSize)
                    Dim thm2 As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, dt.TableName, 8, Thematics.DistributionMethod.EqualRangeSize)
                    thm2.RoundBy = 0.01

                    'starting color
                    thm2.Bins(0).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, Color.DarkBlue, False)
                    thm2.Bins(0).Style.AreaStyle.Interior = New SimpleInterior(2, Color.DarkBlue)

                    thm2.InflectionColor = Color.Yellow
                    thm2.InflectionIndex = 3
                    thm2.Inflected = True
                    thm2.Recompute()

                    For i = 0 To thm2.Bins.Count - 1
                        Dim si As SimpleInterior = thm2.Bins(i).Style.AreaStyle.Interior
                        Dim frcolor As Color = Color.FromArgb(128, si.ForeColor)
                        Dim frcolorbrdr As Color = Color.FromArgb(255, si.ForeColor)

                        thm2.Bins(i).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, frcolorbrdr, False)
                        thm2.Bins(i).Style.AreaStyle.Interior = New SimpleInterior(si.Pattern, frcolor)

                    Next
                    'thm2.Recompute()
                    thm2.Bins(thm2.InflectionIndex).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(3, 0), 2, thm2.InflectionColor, False)
                    thm2.Bins(thm2.InflectionIndex).Style.AreaStyle.Interior = New SimpleInterior(2, thm2.InflectionColor)
                    lyr.Modifiers.Append(thm2)
                    MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
                    Legend_CreateThematic(thm2, themeExpression, lyr)
                End If
                MapInfo.Engine.Session.Current.MapFactory(0).SetView(lyr.Bounds, csysWGS84)
                MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tbl_map))
            End If

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus("Cell_TopX_Mapping: Problem during mapping of TopX" & Chr(13) & ex.Message)
        Finally
            connection.Close()
            RefreshQuickThemeControl()
            WaitScreen.CloseWaitScreen()
            Me.Cursor = Cursors.Default
