    Private Sub btnCompare_Click(sender As Object, e As EventArgs) Handles btnCompare.Click
        Dim counter As Integer = 0
        Dim techCounter As Integer = 0
        Dim selectedTechnology As String = ""
        Dim selectedDriveTest As New List(Of String)
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")

        Try
            For Each nd As TreeListNode In tvDriveTest.GetAllCheckedNodes().Where(Function(x) x.Nodes.Count = 0).ToList()
                counter += 1
                selectedDriveTest.Add(nd.Tag.ToString())
            Next

            If (counter < 2) Then
                SetStatus("Please select atleast 2 drive test to compare")
                Exit Sub
            ElseIf counter > 2 Then
                SetStatus("Please select only 2 drive test to compare")
                Exit Sub
            ElseIf (Not rbUE.Checked AndAlso Not rbScanner.Checked) Then
                SetStatus("Please select Scan or UE")
                Exit Sub
            ElseIf (Not ceTech2G.Checked AndAlso Not ceTech3G.Checked AndAlso Not ceTech4G.Checked) Then
                SetStatus("Please select Technology.")
                Exit Sub
            End If
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()
            'Map_StatusStrip.Visible = True
            'ToolStripProgressBar1.Visible = True
            'ToolStripProgressBar1.Value = 5
            Application.DoEvents()
            Dim strFlag As String = "SCAN"
            If (rbUE.Checked) Then
                strFlag = "UE"
            End If

            If (ceTech2G.Checked And ceTech3G.Checked And ceTech4G.Checked) Then
                selectedTechnology = ceTech2G.Text & "," & ceTech3G.Text & "," & ceTech4G.Text
                techCounter = 2
            ElseIf (ceTech2G.Checked And ceTech3G.Checked) Then
                techCounter = 1
                selectedTechnology = ceTech2G.Text & "," & ceTech3G.Text
            ElseIf (ceTech2G.Checked And ceTech4G.Checked) Then
                techCounter = 1
                selectedTechnology = ceTech2G.Text & "," & ceTech4G.Text
            ElseIf (ceTech3G.Checked And ceTech4G.Checked) Then
                techCounter = 1
                selectedTechnology = ceTech3G.Text & "," & ceTech4G.Text
            ElseIf (ceTech2G.Checked) Then
                techCounter = 0
                selectedTechnology = ceTech2G.Text
            ElseIf (ceTech3G.Checked) Then
                techCounter = 0
                selectedTechnology = ceTech3G.Text
            ElseIf (ceTech4G.Checked) Then
                techCounter = 0
                selectedTechnology = ceTech4G.Text
            End If

            Dim query As String
            If (IsWithCordinates()) Then
                query = "EXEC dbo.DT_Compare '" & selectedTechnology & "','" & selectedDriveTest.Item(0).ToString & "','" & selectedDriveTest.Item(1).ToString & "',?,?,?,?,?,?," & strFlag
            Else
                query = "EXEC dbo.DT_Compare '" & selectedTechnology & "','" & selectedDriveTest.Item(0).ToString & "','" & selectedDriveTest.Item(1).ToString & "',?,?,'','','',''," + strFlag
            End If
            Dim isCompare3G As Boolean = False
            Dim isCompare2G As Boolean = False
            Dim isCompare4G As Boolean = False

            If (ceTech4G.Checked) Then
                Dim IOS_Compare4G As IOS.Configuration.EntityModel.IOSForm = configMgr.FindFormByName("frmCompare4G")
                If IOS_Compare4G IsNot Nothing Then
                    Dim c As IOS.Configuration.EntityModel.Control = IOS_Compare4G.FindControlByName("frmCompare4G")
                    If Not c Is Nothing Then
                        If (c.ConfigType = Configuration.EntityModel.ConfigType.Enable) Then
                            isCompare4G = True
                        End If
                    End If
                End If
            End If

            If (ceTech3G.Checked) Then
                Dim IOS_Compare3G As IOS.Configuration.EntityModel.IOSForm = configMgr.FindFormByName("frmCompare3G")
                If IOS_Compare3G IsNot Nothing Then
                    Dim c As IOS.Configuration.EntityModel.Control = IOS_Compare3G.FindControlByName("frmCompare3G")
                    If Not c Is Nothing Then
                        If (c.ConfigType = Configuration.EntityModel.ConfigType.Enable) Then
                            isCompare3G = True
                        End If
                    End If
                End If
            End If

            If (ceTech2G.Checked) Then
                Dim IOS_Compare2G As IOS.Configuration.EntityModel.IOSForm = configMgr.FindFormByName("frmCompare2G")
                If IOS_Compare2G IsNot Nothing Then
                    Dim c As IOS.Configuration.EntityModel.Control = IOS_Compare2G.FindControlByName("frmCompare2G")
                    If Not c Is Nothing Then
                        If (c.ConfigType = Configuration.EntityModel.ConfigType.Enable) Then
                            isCompare2G = True
                        End If
                    End If
                End If
            End If


            ToolStripProgressBar1.Value = 10
            Dim dStyle As Style = IOSStyleHelper.GetSytle(TableNames.DT_Compare)

            Dim data As DataSet = GetTechnologyTable(conn_IOSDriveTestModule, query, GetRadioParameters(), selectedTechnology, strFlag)
            If (data.Tables.Count > 1) Then  ' Ask
                If (ceTech3G.Checked) Then ' If (index = 1) Then
                    Dim objAdoNetTableInfo As New IOSTableInfoAdoNet("DT_Compare_" + strFlag + "_3G", data.Tables("3G"), dStyle, "PX", "PY")
                    objMapHelper.ProgressBar = ToolStripProgressBar1
                    objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoNetTableInfo, 20 * (1), 40 * (1))

                    If (objAdoNetTableInfo.OutData.Rows.Count > 0) Then
                        If (ApplyHavingSettings(objAdoNetTableInfo.OutLayer)) Then
                            Dim thm As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(objAdoNetTableInfo.OutLayer, "SC_Status", "Serving_SC")
                            thm.Name = "Serving_SC_Before-Serving_SC_After"
                            thm.ApplyStylePart = Thematics.StylePart.Color
                            Dim mtb2 As Thematics.ModifierThemeBin
                            Dim cl As System.Drawing.Color = Color.Green
                            For i = 0 To thm.Bins.Count - 1
                                mtb2 = thm.Bins.Item(i)
                                Dim j As String = Convert.ToString(thm.Bins(i).Value)
                                Select Case j
                                    Case "0"
                                        cl = Color.Green
                                    Case Else
                                        cl = Color.Red
                                End Select

                                mtb2.Style.SymbolStyle.Color = cl
                            Next
                            thm.RecomputeBins()
                            objAdoNetTableInfo.OutLayer.Modifiers.Append(thm)
                            '' If need to change last parameter of below than also change in  "Legend_CreateThematic" method
                            DT_CreateThematics(objAdoNetTableInfo.OutLayer, "Delta RSCP", strFlag.ToUpper() + " 3G DT RSCP Delta", "RSCP_Delta")
                            DT_CreateThematics(objAdoNetTableInfo.OutLayer, "Delta EcNo", strFlag.ToUpper() + " 3G DT EcNo Delta", "EcNo_Delta")
                        End If
                    End If
                    ToolStripProgressBar1.Value = 30
                ElseIf (ceTech2G.Checked) Then ' ElseIf (index = 1) Then
                    Dim objAdoNetTableInfo As New IOSTableInfoAdoNet("DT_Compare_" + strFlag + "_2G", data.Tables("2G"), dStyle, "PX", "PY")
                    objMapHelper.ProgressBar = ToolStripProgressBar1
                    objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoNetTableInfo, 20 * (2), 40 * (2))

                    If (objAdoNetTableInfo.OutData.Rows.Count > 0) Then
                        ToolStripProgressBar1.Value = 40
                        If (ApplyHavingSettings(objAdoNetTableInfo.OutLayer)) Then
                            Dim thm As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(objAdoNetTableInfo.OutLayer, "CellId_Status", "CellId_Status")
                            thm.Name = "CellID_Before-CellID_After"

                            thm.ApplyStylePart = Thematics.StylePart.Color
                            Dim mtb2 As Thematics.ModifierThemeBin
                            Dim cl As System.Drawing.Color = Color.Green
                            For i = 0 To thm.Bins.Count - 1
                                mtb2 = thm.Bins.Item(i)
                                Dim j As String = Convert.ToString(thm.Bins(i).Value)
                                Select Case j
                                    Case "0"
                                        cl = Color.Green
                                    Case Else
                                        cl = Color.Red
                                End Select

                                mtb2.Style.SymbolStyle.Color = cl
                            Next
                            thm.RecomputeBins()
                            objAdoNetTableInfo.OutLayer.Modifiers.Append(thm)
                            '' If need to change last parameter of below than also change in  "Legend_CreateThematic" method
                            DT_CreateThematics(objAdoNetTableInfo.OutLayer, "Delta RxLevAvg", strFlag.ToUpper() + " 2G DT RxLevAvg Delta", "RxLevAvg_Delta")

                            If (strFlag.ToUpper() = "UE") Then
                                DT_CreateThematics(objAdoNetTableInfo.OutLayer, "Delta RxQual", strFlag.ToUpper() + " 2G DT RxQual Delta", "RxQual_Delta")
                            End If
                        End If
                        ToolStripProgressBar1.Value = 60
                    End If
                ElseIf (ceTech4G.Checked) Then
                    Dim objAdoNetTableInfo As New IOSTableInfoAdoNet("DT_Compare_" + strFlag + "_4G", data.Tables("4G"), dStyle, "PX", "PY")
                    objMapHelper.ProgressBar = ToolStripProgressBar1
                    objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoNetTableInfo, 20 * (3), 40 * (3))

                    If (objAdoNetTableInfo.OutData.Rows.Count > 0) Then
                        If (ApplyHavingSettings(objAdoNetTableInfo.OutLayer)) Then
                            Dim thm As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(objAdoNetTableInfo.OutLayer, "PCI_Status", "Serving_PCI")
                            thm.Name = "Serving_PCI_Before-Serving_PCI_After"
                            thm.ApplyStylePart = Thematics.StylePart.Color
                            Dim mtb2 As Thematics.ModifierThemeBin
                            Dim cl As System.Drawing.Color = Color.Green
                            For i = 0 To thm.Bins.Count - 1
                                mtb2 = thm.Bins.Item(i)
                                Dim j As String = Convert.ToString(thm.Bins(i).Value)
                                Select Case j
                                    Case "0"
                                        cl = Color.Green
                                    Case Else
                                        cl = Color.Red
                                End Select

                                mtb2.Style.SymbolStyle.Color = cl
                            Next
                            thm.RecomputeBins()
                            objAdoNetTableInfo.OutLayer.Modifiers.Append(thm)
                            ''If need to change last parameter of below than also change in  "Legend_CreateThematic" method
                            DT_CreateThematics(objAdoNetTableInfo.OutLayer, "Delta RSRP", strFlag.ToUpper() + " 4G DT RSRP Delta", "RSRP_Delta")
                            DT_CreateThematics(objAdoNetTableInfo.OutLayer, "Delta RSRQ", strFlag.ToUpper() + " 4G DT RSRQ Delta", "RSRQ_Delta")
                        End If
                    End If
                    ToolStripProgressBar1.Value = 85
                End If
            End If

            If (ceTech3G.Checked) Then
                If (data.Tables.Count > 2) Then ' Ask
                    If (frmCompare3G.WindowState = FormWindowState.Minimized) Then
                        frmCompare3G.WindowState = FormWindowState.Normal
                    End If
                    If (isCompare3G) Then
                        frmCompare3G.SetChartData(data.Tables("3G_RSCP"), data.Tables("3G_Ecno"), (strFlag + "_3G"))   '4,5
                        ''frm_IOS_Compare3G.SetChartData(data.Tables(3), data.Tables(4), (strFlag + "_3G"))
                        frmCompare3G.Show()
                    End If
                    ToolStripProgressBar1.Value = 90
                End If
            End If
            If (ceTech2G.Checked) Then
                If (data.Tables.Count >= 2) Then
                    If (frmCompare2G.WindowState = FormWindowState.Minimized) Then
                        frmCompare2G.WindowState = FormWindowState.Normal
                    End If
                    If (isCompare2G) Then
                        Dim RxQualdata As DataTable = Nothing
                        If (strFlag.Equals("UE")) Then '' If (data.Tables.Count > 8) Then
                            RxQualdata = data.Tables("2G_RxQual")
                        End If
                        'frm_IOS_Compare2G.SetChartData(data.Tables(2), RxQualdata, (strFlag + "_2G"), strFlag)
                        frmCompare2G.SetChartData(data.Tables("2G_RxLevAvg"), RxQualdata, (strFlag + "_2G"), strFlag)  '3
                        frmCompare2G.Show()
                        ToolStripProgressBar1.Value = 95
                    End If
                End If
            End If
            If (ceTech4G.Checked) Then
                If (data.Tables.Count > 2) Then
                    If (frmCompare4G.WindowState = FormWindowState.Minimized) Then
                        frmCompare4G.WindowState = FormWindowState.Normal
                    End If
                    If (isCompare4G) Then
                        frmCompare4G.SetChartData(data.Tables("4G_RSRP"), data.Tables("4G_RSRQ"), (strFlag + "_4G"))   '6,7
                        frmCompare4G.Show()
                    End If
                    ToolStripProgressBar1.Value = 90
                End If
            End If
            ToolStripProgressBar1.Value = 100
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message.ToString)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            Map_StatusStrip.Visible = False
            ToolStripProgressBar1.Visible = False
            ToolStripProgressBar1.Value = 0
            Me.Cursor = Cursors.Default
            Application.DoEvents()
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
        End Try
    End Sub

