    Private Sub MapKPICounterForDayHour(_tech As String, _objectType As String, _kpiCounterName As String)
        Dim dtSelecedDate As DataTable = Nothing
        If dtKpiInfoData.Rows.Count > 0 Then
            If chkEditKpiSelHour.Checked Then
                dtSelecedDate = dtKpiInfoData.AsEnumerable().Where(Function(x) x.Field(Of Date)("Date") = CalendarKpiSelection.SelectionStart.AddHours(SpinEditKpiSelHours.EditValue)).CopyToDataTable
            Else
                dtSelecedDate = dtKpiInfoData.AsEnumerable().Where(Function(x) x.Field(Of Date)("Date") = CalendarKpiSelection.SelectionStart).CopyToDataTable
            End If
            dtSelecedDate.TableName = dtKpiInfoData.TableName
            If tglBtnKIVoronoi.ToggleState = CheckState.Checked Then
                KPIInfo_KPICounter_Mapping(_tech, _objectType, _kpiCounterName, dtSelecedDate, _kpiCounterName, "KPI", True, False, True)
            Else
                KPIInfo_KPICounter_Mapping(_tech, _objectType, _kpiCounterName, dtSelecedDate, _kpiCounterName, "KPI", False, False, True)
            End If
        End If
    End Sub

