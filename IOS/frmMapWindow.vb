    Private Sub CNE_MapRawEvents(ByVal dt As DataTable, Optional ByVal IsCF As Boolean = False)
        Try
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Start MapRawEvents")
            ToolStripProgressBar1.Value = 5

            Dim tblname2g As String = "CNE_RAW_Map_2G"
            Dim tblname3g As String = "CNE_RAW_Map_3G"
            Dim tblname4g As String = "CNE_RAW_Map_4G"
            Dim tblname5g As String = "CNE_RAW_Map_5G"
            Dim tblnameAll As String = "CNE_RAW_Map_All"

            Dim tblname2g_agg As String = "CNE_AGG_Map_2G"
            Dim tblname3g_agg As String = "CNE_AGG_Map_3G"
            Dim tblname4g_agg As String = "CNE_AGG_Map_4G"
            Dim tblname5g_agg As String = "CNE_AGG_Map_5G"
            Dim tblnameAll_agg As String = "CNE_AGG_Map_All"

            If IsCF Then
                tblname2g = dt.TableName & "_Map_2G"
                tblname3g = dt.TableName & "_Map_3G"
                tblname4g = dt.TableName & "_Map_4G"
                tblname5g = dt.TableName & "_Map_5G"
                tblnameAll = dt.TableName & "_Map_All"
            End If

            Dim checkedLayers As New List(Of String)

            For Each layer As MapLayer In MapControl1.Map.Layers
                Dim featureLayer As FeatureLayer = TryCast(layer, FeatureLayer)
                If Not featureLayer Is Nothing Then
                    If featureLayer.Name = tblname2g Or featureLayer.Name = tblname3g Or featureLayer.Name = tblname4g Or featureLayer.Name = tblnameAll Then
                        If featureLayer.Enabled Then
                            checkedLayers.Add(featureLayer.Name)

                            For Each modifier As MapInfo.Mapping.FeatureStyleModifier In featureLayer.Modifiers
                                If TypeOf modifier Is IndividualValueTheme Then
                                    Dim thm As IndividualValueTheme = CType(modifier, IndividualValueTheme)
                                    If thm.Enabled Then
                                        checkedLayers.Add(thm.Name)
                                    End If
                                End If
                                If modifier.Enabled Then
                                    checkedLayers.Add(modifier.Name)
                                End If
                            Next
                        End If
                    End If
                End If
            Next

            If checkedLayers.Count = 0 Then
                checkedLayers.Add(tblname2g)
                checkedLayers.Add(tblname3g)
                checkedLayers.Add(tblname4g)
                checkedLayers.Add(tblname5g)
            End If

            objMapHelper.RemoveLayer(tblname2g)
            objMapHelper.CloseTable(tblname2g)
            objMapHelper.RemoveLayer(tblname3g)
            objMapHelper.CloseTable(tblname3g)
            objMapHelper.RemoveLayer(tblname4g)
            objMapHelper.CloseTable(tblname4g)
            objMapHelper.RemoveLayer(tblname5g)
            objMapHelper.CloseTable(tblname5g)
            '    objMapHelper.CloseTable("Lines_SourceCells_CNE_RAW")
