    Public Sub CloseMapTables_RemoveLayerModifiers()
        For Each tbl As MapInfo.Data.Table In Session.Current.Catalog
            If Not tbl.TableInfo Is Nothing Then
                Try

                    If Layer_InMapConfiguration(tbl.Alias) = False And tbl.TableInfo.TableType <> TableType.Seamless And tbl.TableInfo.TableType <> TableType.Raster And Not tbl.Alias.Contains("Sites_") And tbl.TableInfo.TableType <> TableType.Native And Not tbl.Alias.Contains("Regions_") Then
                        tbl.Close()
                    ElseIf tbl.TableInfo.TableType <> TableType.Raster And tbl.TableInfo.TableType <> TableType.Seamless Then
                        Try
                            Dim lyr As FeatureLayer = CType(MapControl1.Map.Layers(tbl.Alias), FeatureLayer)
                            While lyr.Modifiers.Count > 0
                                lyr.Modifiers.Remove(lyr.Modifiers(0))
                            End While
                        Catch ex As Exception
                            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                        End Try
                    End If
                Catch ex As Exception

                End Try

            End If
        Next
    End Sub

    Public Sub RemoveLabelLayers()
        Dim l As IMapLayer
        Try
            For Each l In MapControl1.Map.Layers.GetMapLayerEnumerator(New FilterByLayerType(LayerType.Label), MapLayerEnumeratorOptions.Default)
                If Not l.Name Is Nothing Then
                    If l.Name.StartsWith("Labels") Then
                        If Layer_InMapConfiguration(l.Name.Substring(7)) = False And l.Name <> "Labels" And Not l.Name.Contains("Sites_") Then
                            MapControl1.Map.Layers.Remove(l)
                        End If
                    Else
                        MapControl1.Map.Layers.Remove(l)
                    End If
                End If
            Next
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

    Private Sub CreateNetworkLabels(ByRef tbl As MapInfo.Data.Table, ByVal LabelName As String, ByVal LabelSize As Integer, ByVal LabelColorInt As Integer)
        Try
            If CheckLabelLayer("Labels_" & tbl.Alias) Then
                MapControl1.Map.Layers.Remove("Labels_" & tbl.Alias)
            End If

            Dim labelLayer As New MapInfo.Mapping.LabelLayer("Labels_" & tbl.Alias)
            labelLayer.Name = "Labels_" & tbl.Alias
            labelLayer.Alias = "Labels_" & tbl.Alias
            MapControl1.Map.Layers.Insert(0, labelLayer)
            Dim source As New MapInfo.Mapping.LabelSource(tbl)
            source.DefaultLabelProperties.Caption = LabelName
            source.DefaultLabelProperties.Style.Font = New Font("Arial Narrow", LabelSize)
            source.DefaultLabelProperties.Style.Font.TextEffect = TextEffect.Halo
            source.DefaultLabelProperties.Style.Font.FontWeight = FontWeight.Bold

            Dim labelcolor As Color = ColorInt2Color(LabelColorInt)

            source.DefaultLabelProperties.Style.Font.Size = LabelSize
            source.DefaultLabelProperties.Style.Font.ForeColor = labelcolor

            If tbl.Alias.StartsWith("Sites_") Then
                source.DefaultLabelProperties.Layout.Alignment = MapInfo.Text.Alignment.CenterRight
                source.DefaultLabelProperties.Layout.Offset = 10

                Dim zoomvisible As VisibleRange = New VisibleRange(0, 50, DistanceUnit.Kilometer)
                labelLayer.VisibleRange = zoomvisible
                labelLayer.VisibleRangeEnabled = True
                labelLayer.Enabled = False
                source.DefaultLabelProperties.CalloutLine.Type = 1
            Else
                source.DefaultLabelProperties.Layout.Alignment = MapInfo.Text.Alignment.CenterCenter

                Dim zoomvisible As VisibleRange = New VisibleRange(0, 5, DistanceUnit.Kilometer)
                labelLayer.VisibleRange = zoomvisible
                labelLayer.VisibleRangeEnabled = True
            End If

            labelLayer.Sources.Append(source)

            MapControl1.Tools.SelectMapToolProperties.LabelsAreEditable = False
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus("Error: Network Label: " & tbl.Alias & " not mapped")
        End Try
    End Sub

