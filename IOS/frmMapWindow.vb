    Public Sub Cell_Availability_Map(ByVal dt As DataTable)
        Dim connection As New MIConnection
        Try
            connection.Open()
            Dim freqtbl As String = "Availability_Map"
            Dim freqtbltemp As String = "Availability_Temp_Map"

            If MapControl1.Map.Legends.Count > 0 Then
                MapControl1.Map.Legends(0).Format.AutoSizeLegend = False
            End If

            connection.Catalog.CloseTable(freqtbl)
            connection.Catalog.CloseTable(freqtbltemp)
            connection.Catalog.CloseTable(freqtbl)

            Dim tbl As MapInfo.Data.Table = Nothing
            Dim tbl_map As MapInfo.Data.Table = Nothing

            connection.Catalog.CloseTable(freqtbltemp)
            Dim ti As TableInfoAdoNet = New TableInfoAdoNet(freqtbltemp)
            ti.ReadOnly = True
            ti.DataTable = dt
            tbl = connection.Catalog.OpenTable(ti)

            Dim columns2index As StringCollection = New StringCollection()
            columns2index.Add("CELLNAME")

            For Each drow As DataRow In dt_Map_Configuration.Rows
                Try
                    If drow("LayerActive").ToString = True AndAlso CheckMapinfoTable(drow("LayerName").ToString) Then
                        'constructing select string
                        Dim sql_select As String = "SELECT "
                        Dim sql_from As String = "FROM "
                        Dim sql_where As String = "WHERE "
                        Dim sql_total As String = ""
                        Dim sql_where_channel As String = ""

                        For Each dcol As DataColumn In dt.Columns
                            sql_select = sql_select + freqtbltemp + "." + dcol.ColumnName.ToString & ", "
                        Next

                        tbl = Session.Current.Catalog.GetTable(drow("LayerName").ToString.Trim)

                        sql_select = sql_select + " MI_Centroid(" + tbl.Alias + ".obj) as MI_Geometry "
                        sql_from = sql_from + " " + tbl.Alias + ", " + freqtbltemp + " "
                        sql_where = sql_where + " " + tbl.Alias + ".CELLNAME = " & freqtbltemp & ".CELLNAME"
                        sql_total = sql_select + sql_from + sql_where

                        Dim command As MICommand = connection.CreateCommand()
                        Dim irfc As IResultSetFeatureCollection
                        command.CommandText = sql_total
                        irfc = command.ExecuteFeatureCollection()

                        If irfc IsNot Nothing AndAlso irfc.Count <> 0 Then
                            If connection.Catalog.GetTable(freqtbl) Is Nothing Then
                                tbl_map = CreateMemTableFromADO(irfc.Table, columns2index, freqtbl)
                                tbl_map.InsertFeatures(irfc)
                            Else
                                tbl_map = Session.Current.Catalog.GetTable(freqtbl)
                                tbl_map.InsertFeatures(irfc)
                            End If
                            command.Dispose()
                        End If
                    End If
                Catch
                End Try
            Next

            connection.Catalog.CloseTable(freqtbltemp)

            If tbl_map Is Nothing Then
                connection.Close()
                connection.Dispose()
                Exit Sub
            End If

            'Map the query
            Dim lyr As New FeatureLayer(tbl_map)
            MapControl1.Map.Layers.Insert(0, lyr)
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
            Cell_Availability_Theme(lyr)

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            connection.Close()
            SetStatus("Cell_Availability_Map: Problem with mapping availability state!" & Chr(13) & ex.Message)
        End Try
    End Sub

    Private Sub Cell_Availability_Theme(ByVal flyr As FeatureLayer)
        Dim thm As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(flyr, "Availability_Label", "Cell_Availability")
        Try
            thm.ApplyStylePart = Thematics.StylePart.All
            'This line changes the style of the first bin for region layer
            If thm.Bins(0).Value = "< " & trkBarNSAvailability.EditValue Then
                For iCntr = 0 To thm.Bins.Count - 1
                    If iCntr = 0 Then
                        thm.Bins(iCntr).Style = New CompositeStyle(New FontPointStyle(37, New Font("MapInfo Symbols", 10), 0, Color.Purple, 20))
                    Else
                        thm.Bins(iCntr).Style = New CompositeStyle(New FontPointStyle(37, New Font("MapInfo Symbols", 10), 0, Color.Purple, 20))
                    End If
                Next
            ElseIf thm.Bins(0).Value = "= " & trkBarNSAvailability.EditValue Then
                thm.Bins(0).Style = New CompositeStyle(New FontPointStyle(37, New Font("MapInfo Symbols", 10), 0, Color.Maroon, 10))
                thm.Bins(1).Style = New CompositeStyle(New FontPointStyle(37, New Font("MapInfo Symbols", 10), 0, Color.Maroon, 10))
            End If

            flyr.Modifiers.Append(thm)
            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, flyr, ColumnsInfoTip_MapinfoTable(flyr.Table))
            Legend_CreateThematic(thm, "Availability State Map", "", Nothing)
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

