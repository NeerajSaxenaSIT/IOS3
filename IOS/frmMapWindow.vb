    Private Sub DT_AllEvents_GetEvents(ByVal constr As String)
        Try
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Start DT_AllEvent_GetEvents")
            ToolStripProgressBar1.Value = 5
            tblname = "DT_Events_GetEvents"
            objMapHelper.RemoveLayer("DT_Events")
            objMapHelper.CloseTable("DT_Events")
            objMapHelper.CloseTable("Lines_SourceCells_Events")
            objMapHelper.RemoveLayer("Lines_SourceCells_Events")
            Dim q As String = String.Empty
            If Not IsWithCordinates() Then
                q = "SELECT DT_Events.* from dbo.DT_Events INNER JOIN dbo.DT_List ON DT_Events.DtId = DT_List.Dtid where DT_Events.DtId in (" & cellEvent & ") and DT_Events.TimeStamp >= ? and DT_Events.TimeStamp <= ?"
            Else
                q = "SELECT DT_Events.* from dbo.DT_Events INNER JOIN dbo.DT_List ON DT_Events.DtId = DT_List.Dtid where DT_Events.DtId in (" & cellEvent & ") and DT_Events.TimeStamp >= ? and DT_Events.TimeStamp <= ? and (DT_Events.x >= ? and DT_Events.y >= ?) and (DT_Events.x <= ? and DT_Events.y <= ?)"
            End If
            Dim dStyle As Style = IOSStyleHelper.GetSytle(TableNames.DT_Events_GetEvents)
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Get Style")
            Dim objAdoNetTableInfo As New IOSTableInfoAdoNet("DT_Events_GetEvents", constr, q, dStyle, "X", "Y")
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Get AdoTableInfo")
            objMapHelper.ProgressBar = ToolStripProgressBar1
            objMapHelper.CreateMapLayerUsingAdoNetTableInfo(objAdoNetTableInfo, GetRadioParameters(), 10, 40)
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Create MapLayer")
            If (objAdoNetTableInfo.OutData.Rows.Count > 0) Then
                dtEventFailurData = objAdoNetTableInfo.OutData
                frmEvent.SetFailurData(dtEventFailurData)
                _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Set FailurData on EventForm")
                ' Dim objThematicHelper As New IOSThematicHelper(objAdoNetTableInfo.OutLayer)
                ' If (objThematicHelper.ApplyThematicSettings(path)) Then '' Will return true if no setting saved. Return false if setting found and applied
                If (ApplyHavingSettings(objAdoNetTableInfo.OutLayer)) Then
                    Dim thm As New MapInfo.Mapping.Thematics.IndividualValueTheme(objAdoNetTableInfo.OutLayer, "ProblemEventType", "ProblemEventType")
                    thm.ApplyStylePart = Thematics.StylePart.All
                    Dim mtb2 As Thematics.ModifierThemeBin
                    For i = 0 To thm.Bins.Count - 1
                        mtb2 = thm.Bins.Item(i)
                        mtb2.Style.SymbolStyle.PointSize = CType(dStyle, MapInfo.Styles.CompositeStyle).SymbolStyle.PointSize
                    Next
                    thm.RecomputeBins()
                    objAdoNetTableInfo.OutLayer.Modifiers.Append(thm)
                    _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Modify tableInfo OutLayer")
                End If
            End If
            ToolStripProgressBar1.Value = 50
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message.ToString)
        Finally
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Exit Dt_AllEvents_GetEvents")
        End Try
    End Sub

