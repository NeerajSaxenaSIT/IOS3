    Public Sub Customer_CS_Graduated_Map(ByVal dt As DataTable)
        Dim connection As New MIConnection
        Try
            Dim Cat As Catalog = MapInfo.Engine.Session.Current.Catalog
            'Create Temp layer
            Dim tblInfoTemp As New TableInfoMemTable("Customer_Grouped")
            Dim tblTemp As Table = Cat.GetTable("Customer_Grouped")
            If MapControl1.Map.Legends.Count > 0 Then
                MapControl1.Map.Legends(0).Format.AutoSizeLegend = False
            End If
            If IsNothing(tblTemp) = False Then 'Table exists close it
                Cat.CloseTable("Customer_Grouped")
            End If
            Dim tblTempmap As Table = Cat.GetTable("Customer_Grouped_Map")
            If IsNothing(tblTempmap) = False Then 'Table exists close it
                Cat.CloseTable("Customer_Grouped_Map")
            End If
            'tblInfoTemp.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
            'tblInfoTemp.Columns.Add(ColumnFactory.CreateStyleColumn())
            tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("TCELLID", 5))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("TLAC"))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("Release", 10))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateIntColumn("CallCount"))

            tblTemp = Cat.CreateTable(tblInfoTemp)

            'LINQ code to groupby/count the original frap query
            Dim calls = dt.AsEnumerable

            Dim CallCounts = From p In calls
                             Group p By Key = p.Field(Of String)("TCELLID"), LAC = p.Field(Of Nullable(Of Double))("TLAC"), Release = p.Field(Of String)("release") Into Count()
                             Select TCELLID = Key, LAC, Release, CallCount = Count

            For Each tcellid In CallCounts

                If Not tcellid.TCELLID Is Nothing And Not tcellid.LAC Is Nothing Then
                    Dim ftr As New Feature(tblTemp.TableInfo.Columns)
                    ftr.Item("TCELLID") = tcellid.TCELLID
                    ftr.Item("TLAC") = tcellid.LAC
                    ftr.Item("Release") = tcellid.Release
                    ftr.Item("CallCount") = tcellid.CallCount
                    tblTemp.InsertFeature(ftr)
                End If
            Next

            'Mapping the stuff
            connection.Open()

            'constructing select string
            Dim sql_select As String = "SELECT "
            Dim sql_from As String = "FROM "
            Dim sql_where As String = "WHERE "

            Dim tblname As String = tblTemp.Alias

            For Each dcol As MapInfo.Data.Column In tblInfoTemp.Columns
                If dcol.Alias.ToString <> "Obj" And dcol.Alias.ToString <> "MI_Style" Then
                    sql_select = sql_select + tblTemp.Alias + "." + dcol.Alias.ToString & ", "
                End If
            Next

            Dim tbl As MapInfo.Data.Table = Nothing
            Dim tbl_map As MapInfo.Data.Table = Nothing

            For Each drow As DataRow In dt_Map_Configuration.Rows
                Dim sql_select_final As String = ""
                Dim sql_from_final As String = ""
                Dim sql_where_final As String = ""
                Dim sql_total As String = ""
                tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim)
                If Not tbl Is Nothing Then

                    sql_select_final = sql_select & " MI_Centroid(" & tbl.Alias & ".obj) AS obj "
                    sql_from_final = sql_from & tblname & ", " & tbl.Alias & " "
                    If drow.Item("LayerTechnology").ToString.Trim.ToUpper = "4G" Then
                        sql_where_final = sql_where & tblname & ".TCELLID = " & tbl.Alias & ".CELLID AND " & tblname & ".TLAC = " & tbl.Alias & ".TAC"
                    Else
                        sql_where_final = sql_where & tblname & ".TCELLID = " & tbl.Alias & ".CELLID AND " & tblname & ".TLAC = " & tbl.Alias & ".LAC"
                    End If

                    sql_total = sql_select_final + sql_from_final + sql_where_final

                    Dim command As MICommand = connection.CreateCommand()
                    Dim irfc As IResultSetFeatureCollection
                    command.CommandText = sql_total
                    irfc = command.ExecuteFeatureCollection()

                    If irfc.Count <> 0 Then
                        If connection.Catalog.GetTable(tblname & "_Map") Is Nothing Then
                            Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(tblname & "_Map", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                            tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                            tbl_map.InsertFeatures(irfc)

                        Else
                            tbl_map = Session.Current.Catalog.GetTable(tblname & "_Map")
                            tbl_map.InsertFeatures(irfc)

                        End If
                        command.Dispose()
                    End If
                End If
            Next

            If tbl_map Is Nothing Then
                connection.Close()
                connection.Dispose()
                Exit Sub
            End If

            WriteString_Log("CDR CS: " & Now() & "    " & "Map - Thematic: map table has rows: " & CountRowsInTable(tbl_map, False))

            'Map the query
            If CountRowsInTable(tbl_map, False) > 0 Then

                'Creating normal Release Layer
                '-----------------------------
                Dim command As MICommand = connection.CreateCommand()
                Dim irfc_normal As IResultSetFeatureCollection
                command.CommandText = "SELECT * FROM " & tbl_map.Alias & " WHERE " & tbl_map.Alias & ".Release = 'Normal'"
                irfc_normal = command.ExecuteFeatureCollection(tbl_map.Alias & "_Normal")
                command.Dispose()
                WriteString_Log("CDR CS: " & Now() & "    " & "Map - Thematic: map table Normal: " & irfc_normal.Count)

                If irfc_normal.Count > 0 Then
                    Dim lyr_normal As New FeatureLayer(irfc_normal.Table)
                    MapControl1.Map.Layers.Insert(0, lyr_normal)
                    MapInfo.Mapping.LayerHelper.SetSelectable(lyr_normal, False)

                    Dim thm_normal As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr_normal, "Release", "Release")
                    thm_normal.ApplyStylePart = Thematics.StylePart.All

                    'This line changes the style of the first bin for region layer
                    thm_normal.Bins(0).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.FontPointStyle(36, New MapInfo.Styles.Font("MapInfo Symbols", 10), 0, Color.FromArgb(125, Color.Lime), 10))
                    lyr_normal.Modifiers.Append(thm_normal)

                    MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr_normal, ColumnsInfoTip_MapinfoTable(irfc_normal.Table))
                    'Legend_CreateThematic(thm_normal, "CS Customer", "Normal")
                End If

                'Creating Abnormal Release Layer
                '-------------------------------
                command = connection.CreateCommand()
                Dim irfc_abnormal As IResultSetFeatureCollection
                command.CommandText = "SELECT * FROM " & tbl_map.Alias & " WHERE " & tbl_map.Alias & ".Release = 'Abnormal'"
                irfc_abnormal = command.ExecuteFeatureCollection(tbl_map.Alias & "_Abnormal")
                command.Dispose()

                WriteString_Log("CDR CS: " & Now() & "    " & "Map - Thematic: map table abNormal: " & irfc_normal.Count)

                If irfc_abnormal.Count > 0 Then
                    Dim lyr_abnormal As New FeatureLayer(irfc_abnormal.Table)
                    MapControl1.Map.Layers.Insert(0, lyr_abnormal)
                    MapInfo.Mapping.LayerHelper.SetSelectable(lyr_abnormal, False)
                    Dim thm_abnormal As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr_abnormal, "Release", "Release")
                    thm_abnormal.ApplyStylePart = Thematics.StylePart.All

                    'This line changes the style of the first bin for region layer
                    thm_abnormal.Bins(0).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.FontPointStyle(36, New MapInfo.Styles.Font("MapInfo Symbols", 30), 0, Color.Red, 30))
                    lyr_abnormal.Modifiers.Append(thm_abnormal)
                    MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr_abnormal, ColumnsInfoTip_MapinfoTable(irfc_abnormal.Table))
                    Legend_CreateThematic(thm_abnormal, "CS Customer", "Abnormal", Nothing)

                End If

                'Graduated theme for geo callcount distribution
                '-----------------------------------------------
                WriteString_Log("CDR CS: " & Now() & "    " & "Map - Thematic: apply graduated symboltheme")

                Dim thm As MapInfo.Mapping.Thematics.GraduatedSymbolTheme = New MapInfo.Mapping.Thematics.GraduatedSymbolTheme(tbl_map, "CallCount")
                thm.PositiveSymbol = New MapInfo.Styles.SimpleVectorPointStyle(46, Color.Cyan, 36)
                Dim objthm As ObjectThemeLayer = New ObjectThemeLayer("CallCount", Nothing, thm)
                objthm.Theme.GraduateSizeBy = Thematics.GraduateSizeBy.Log

                MapControl1.Map.Layers.Add(objthm)
                objthm.RebuildTheme()
            End If

            connection.Close()
            connection.Dispose()
        Catch ex As Exception
            WriteString_Log("CDR CS: " & Now() & "    " & "Error: " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus("Customer_Graduated_Map: Error producing Graduated Map for customer CS data" & Chr(13) & ex.Message)
            connection.Close()
            connection.Dispose()
        End Try
    End Sub

    Public Sub Customer_PS_Graduated_Map(ByVal dt As DataTable)
        Dim connection As New MIConnection
        Try
            WriteString_Log("CDR PS: " & Now() & "    " & "Start method: Customer CS Graduated Map")
            For Each dc As DataColumn In dt.Columns
                WriteString_Log("CDR PS: " & Now() & "    " & "Column: " & dc.ColumnName & " - " & dc.DataType.ToString)
            Next

            Dim Cat As Catalog = MapInfo.Engine.Session.Current.Catalog
            'Create Temp layer
            Dim tblInfoTemp As New TableInfoMemTable("Customer_Grouped")
            Dim tblTemp As Table = Cat.GetTable("Customer_Grouped")
            If IsNothing(tblTemp) = False Then 'Table exists close it
                Cat.CloseTable("Customer_Grouped")
            End If
            Dim tblTempmap As Table = Cat.GetTable("Customer_Grouped_Map")
            If IsNothing(tblTempmap) = False Then 'Table exists close it
                Cat.CloseTable("Customer_Grouped_Map")
            End If

            'tblInfoTemp.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
            'tblInfoTemp.Columns.Add(ColumnFactory.CreateStyleColumn())
            tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("CELL", 5))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("LAC"))
            'tblInfoTemp.Columns.Add(ColumnFactory.CreateStringColumn("Release", 10))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("MB_Avg"))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("MB_Sum"))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("Duration_Avg"))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("Duration_Sum"))
            tblInfoTemp.Columns.Add(ColumnFactory.CreateDoubleColumn("Throughput_Avg"))

            tblTemp = Cat.CreateTable(tblInfoTemp)

            'LINQ code to groupby/count the original frap query
            Dim calls = dt.AsEnumerable

            Dim CallCounts = From p In calls
                             Group p By Key = p.Field(Of String)("CELL"), LAC = p.Field(Of String)("LAC") Into Group
                             Select CELL = Key, LAC, MB_Avg = Group.Average(Function(p) p("MB")), MB_Sum = Group.Sum(Function(p) p("MB")), Duration_Avg = Group.Average(Function(p) p("Duration")), Duration_Sum = Group.Sum(Function(p) p("Duration"))

            WriteString_Log("CDR PS: " & Now() & "    " & "Callcounts finished: " & CallCounts.Count)

            For Each cell In CallCounts
                If Not cell.CELL Is Nothing And Not cell.LAC Is Nothing Then
                    Dim ftr As New Feature(tblTemp.TableInfo.Columns)
                    ftr.Item("CELL") = cell.CELL
                    ftr.Item("LAC") = cell.LAC
                    'ftr.Item("Release") = cell.Release
                    ftr.Item("MB_Avg") = cell.MB_Avg
                    ftr.Item("MB_Sum") = cell.MB_Sum
                    ftr.Item("Duration_Avg") = cell.Duration_Avg
                    ftr.Item("Duration_Sum") = cell.Duration_Sum
                    ftr.Item("Throughput_Avg") = Math.Round(cell.MB_Avg / cell.Duration_Avg, 2) * 8
                    tblTemp.InsertFeature(ftr)
                End If
            Next

            WriteString_Log("CDR CS: " & Now() & "    " & "Fill tmptable finished")

            'Mapping the stuff
            connection.Open()

            'constructing select string
            Dim sql_select As String = "SELECT "
            Dim sql_from As String = "FROM "
            Dim sql_where As String = "WHERE "

            Dim tblname As String = tblTemp.Alias

            For Each dcol As MapInfo.Data.Column In tblInfoTemp.Columns
                If dcol.Alias.ToString <> "Obj" And dcol.Alias.ToString <> "MI_Style" Then
                    sql_select = sql_select + tblTemp.Alias + "." + dcol.Alias.ToString & ", "
                End If
            Next

            Dim tbl As MapInfo.Data.Table = Nothing
            Dim tbl_map As MapInfo.Data.Table = Nothing

            For Each drow As DataRow In dt_Map_Configuration.Rows
                Dim sql_select_final As String = ""
                Dim sql_from_final As String = ""
                Dim sql_where_final As String = ""
                Dim sql_total As String = ""
                tbl = MapInfo.Engine.Session.Current.Catalog.GetTable(drow.Item("LayerName").ToString.Trim)
                If Not tbl Is Nothing Then
                    sql_select_final = sql_select & " MI_Centroid(" & tbl.Alias & ".obj) AS obj "
                    sql_from_final = sql_from & tblname & ", " & tbl.Alias & " "
                    If drow.Item("LayerTechnology").ToString.Trim.ToUpper = "4G" Then
                        sql_where_final = sql_where & tblname & ".CELL = " & tbl.Alias & ".CELLID AND " & tblname & ".LAC = " & tbl.Alias & ".TAC"
                    Else
                        sql_where_final = sql_where & tblname & ".CELL = " & tbl.Alias & ".CELLID AND " & tblname & ".LAC = " & tbl.Alias & ".LAC"
                    End If

                    sql_total = sql_select_final + sql_from_final + sql_where_final

                    WriteString_Log("CDR PS: " & Now() & "    " & "Map - Layer query on" & tbl.Alias & ":   " & sql_total)
                    Dim command As MICommand = connection.CreateCommand()
                    Dim irfc As IResultSetFeatureCollection
                    command.CommandText = sql_total
                    irfc = command.ExecuteFeatureCollection()

                    WriteString_Log("CDR CS: " & Now() & "    " & "Map - Layer query result count" & irfc.Count)

                    If irfc.Count <> 0 Then
                        If connection.Catalog.GetTable(tblname & "_Map") Is Nothing Then
                            Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(tblname & "_Map", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                            tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                            tbl_map.InsertFeatures(irfc)
                            WriteString_Log("CDR PS: " & Now() & "    " & "Map - Layer query result inserted in new table")

                        Else
                            tbl_map = Session.Current.Catalog.GetTable(tblname & "_Map")
                            tbl_map.InsertFeatures(irfc)
                            WriteString_Log("CDR PS: " & Now() & "    " & "Map - Layer query result inserted in existing table")
                        End If
                        command.Dispose()
                    End If
                End If
            Next

            If tbl_map Is Nothing Then
                connection.Close()
                connection.Dispose()
                Exit Sub
            End If
            WriteString_Log("CDR PS: " & Now() & "    " & "Map - Thematic: map table has rows: " & CountRowsInTable(tbl_map, False))

            'Map the query
            If CountRowsInTable(tbl_map, False) > 0 Then
                'Adding CustomerGroupMap layer
                '----------------------------
                Dim lyr As New FeatureLayer(tbl_map)
                MapControl1.Map.Layers.Insert(0, lyr)
                MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)

                'Graduated theme for geo callcount distribution
                '-----------------------------------------------
                Dim thm As MapInfo.Mapping.Thematics.GraduatedSymbolTheme = New MapInfo.Mapping.Thematics.GraduatedSymbolTheme(tbl_map, "MB_Sum")
                thm.PositiveSymbol = New MapInfo.Styles.SimpleVectorPointStyle(46, Color.Cyan, 36)
                Dim objthm As ObjectThemeLayer = New ObjectThemeLayer("MB_Sum", Nothing, thm)
                objthm.Theme.GraduateSizeBy = Thematics.GraduateSizeBy.Log

                MapControl1.Map.Layers.Add(objthm)
                objthm.RebuildTheme()

            End If
            connection.Close()
            connection.Dispose()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            WriteString_Log("CDR PS: " & Now() & "    " & "Error: " & ex.Message)
            SetStatus("Customer_Graduated_Map: Error producing Graduated Map for customer CS data" & Chr(13) & ex.Message)
            connection.Close()
            connection.Dispose()
        End Try
    End Sub

    Private Sub CDR_TO_GRID(ByVal cellname As String)
        Try
            SetStatus("Querying CDR RAW data... This can take a few minutes! TimeOut=200s.")
            'Map_StatusStrip.Visible = True
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            'construct query
            Dim startdate As Date = DTPicker1_Customer.EditValue
            Dim enddate As Date = DTPicker2_Customer.EditValue
            Dim startdate_string As String = Chr(39) & startdate.ToString("yyyyMMdd HH:mm:ss") & Chr(39)
            Dim enddate_string As String = Chr(39) & enddate.ToString("yyyyMMdd HH:mm:ss") & Chr(39)

            If Math.Abs(DateDiff(DateInterval.Day, enddate, startdate)) > 3 Then
                SetStatus("Warning - More than 3 days in query -> potential high load !")
            End If

            Dim parray()() As String
            Dim connstring As String = Nothing
            Dim sql_customer As String = Nothing
            cellname = "IN(" & cellname & ")"
            If cellname <> "" Then
                parray = {
                    New String() {"@cellname", cellname.ToString},
                    New String() {"@startdate", startdate_string},
                    New String() {"@enddate", enddate_string}
                }

                If rbCSInfo.Checked = True Then
                    connstring = GetSQL(5005, parray)(0)
                    sql_customer = GetSQL(5005, parray)(1)
                Else
                    connstring = GetSQL(5006, parray)(0)
                    sql_customer = GetSQL(5006, parray)(1)
                End If
            Else
                SetStatus("No CELLNAME set!")
            End If
            Application.DoEvents()

            dt_CustomerSearch = DataAccessorODBC.GetDataTable(connstring, sql_customer, 200)
            dt_CustomerSearch.TableName = "CDR_" & cellname
            Application.DoEvents()

            If dt_CustomerSearch Is Nothing Then
                Exit Sub
            End If

            If dt_CustomerSearch.Rows.Count = 0 Then
                Exit Sub
            Else
                Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData(Me.dt_CustomerSearch.TableName)
                Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
                IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, dt_CustomerSearch, "ALL")
            End If

            Application.DoEvents()
            If Not dt_CustomerSearch Is Nothing Then
                SetStatus("CallDetailsRecords Queried. See grid !")
            Else
                SetStatus("CallDetailsRecords Query - No Data/TimeOut")
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

