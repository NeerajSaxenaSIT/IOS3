    Public Sub CustomCal_MatchDate(ByVal sender As System.Object, ByVal e As System.EventArgs)
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Start CustomCal_MatchDate")
            Dim fromDate As Date
            Dim toDate As Date
            Dim toolStripMenu As ToolStripMenuItem = TryCast(bCellFootPrint.DropDownItems.Item(4), ToolStripMenuItem)
            If (toolStripMenu IsNot Nothing) Then
                Dim dateControlHost As ToolStripControlHost = TryCast(toolStripMenu.DropDownItems(0), ToolStripControlHost)
                If (dateControlHost IsNot Nothing) Then
                    Dim dateControls As DateTimeControl.IOS_UI_CustomDateTimePicker = TryCast(dateControlHost.Control, DateTimeControl.IOS_UI_CustomDateTimePicker)
                    If (dateControls IsNot Nothing) Then
                        If (dateControls.Tag = "From") Then
                            fromDate = dateControls.StartAndEndDate
                        End If
                    End If
                End If
                Dim toControlHost As ToolStripControlHost = TryCast(toolStripMenu.DropDownItems(1), ToolStripControlHost)
                If (toControlHost IsNot Nothing) Then
                    Dim toControls As DateTimeControl.IOS_UI_CustomDateTimePicker = TryCast(toControlHost.Control, DateTimeControl.IOS_UI_CustomDateTimePicker)
                    If (toControls IsNot Nothing) Then
                        If (toControls.Tag = "To") Then
                            toDate = toControls.StartAndEndDate
                        End If
                    End If
                End If
                If (DateTime.Compare(fromDate, toDate) > 0) Then
                    SetFootPrintTimeStamp(fromDate, "To Date : ", 1)
                End If
                ' CustomCal_Open(sender, e)
            End If
            _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Exit CustomCal_MatchDate")
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub ParcelDisableToolStripMenuItem_Click(ByVal sender As System.Object, ByVal e As System.EventArgs)
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            'Dim mi As MenuItem = CType(sender, MenuItem)
            'Dim cmenu As ContextMenu = CType(mi.Parent, ContextMenu)
            Dim mi As ToolStripMenuItem = CType(sender, ToolStripMenuItem)
            ' Dim cmenu As ContextMenu = CType(mi.Parent, ContextMenu)

            If mi.Checked Then
                For Each mitem As ToolStripMenuItem In tlb_ParcelSelector.DropDownItems
                    If mitem.Text IsNot mi.Text Then
                        mitem.Checked = False
                    End If
                Next
                tlb_ParcelSelectorFlag = False
                Try
                    MapControl1.Map.Layers.Remove("Lines_SourceCells_Events")
                    MapInfo.Engine.Session.Current.Catalog.CloseTable("Lines_SourceCells_Events")
                Catch ex As Exception

                End Try
                Try
                    MapControl1.Map.Layers.Remove("Lines_SourceCells")
                    MapInfo.Engine.Session.Current.Catalog.CloseTable("Lines_SourceCells")
                Catch ex As Exception

                End Try

                Try
                    MapControl1.Map.Layers.Remove("Lines_SourceCells_CNE_AGG")
                    MapInfo.Engine.Session.Current.Catalog.CloseTable("Lines_SourceCells_CNE_AGG")
                Catch ex As Exception

                End Try

                Try
                    MapControl1.Map.Layers.Remove("Lines_SourceCells_CNE_RAW")
