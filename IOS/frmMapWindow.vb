    Private Function CopyFileFromNetworkToLocalPath(ByVal sPath As String) As String
        Try
            Dim dPath As String = GetUserDataPath() & "\Data\"
            Dim fName As String = System.IO.Path.GetFileNameWithoutExtension(sPath)
            Dim fileName As String = System.IO.Path.GetFileName(sPath)

            WriteString_Log("GetNetworks -> CopyFileFromNetworkToLocalPath: sPath: " & sPath)
            WriteString_Log("GetNetworks -> CopyFileFromNetworkToLocalPath: dPath: " & dPath & fileName)

            If sPath.ToLower.Contains("https") Then
                System.Net.ServicePointManager.ServerCertificateValidationCallback = Function(senderX, certificate, chain, sslPolicyErrors) True
            End If

            Dim request As HttpWebRequest = CType(WebRequest.Create(sPath), HttpWebRequest)
            request.Method = "GET"

            ' Add security-related headers
            request.UserAgent = "CellSens/1.0 (contact: support@cellsens.com)" ' Customize this
            'request.Accept = "application/zip"    --THORWS ERROR 
            request.Referer = "cellsens" ' Optional: Set to your app's domain
            request.Timeout = 5000 ' Set timeout to 10 seconds
            request.KeepAlive = False ' Disable keep-alive for simplicity


            Using response As HttpWebResponse = CType(request.GetResponse(), HttpWebResponse)
                If response.StatusCode = HttpStatusCode.OK Then
                    ' Ensure the output directory exists
                    Dim directory As String = dPath


                    ' Read the response stream
                    Using responseStream As Stream = response.GetResponseStream()
                        ' If the API returns a zip file directly, save it

                        Using fileStream As New FileStream(dPath & fileName, FileMode.Create, FileAccess.Write)
                            responseStream.CopyTo(fileStream)
                        End Using
                        WriteString_Log($"Zip file saved successfully to {dPath & fileName}")


                    End Using
                Else
                    WriteString_Log($"Error: HTTP Status Code {response.StatusCode}")
                End If
            End Using

            'old
            '----
            'Dim webClient As New System.Net.WebClient()
            'webClient.Headers("Accept") = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
            'webClient.Headers("User-Agent") = "Mozilla/5.0 (Windows NT 6.1) AppleWebKit/537.1 (KHTML, like Gecko) Chrome/21.0.1180.83 Safari/537.1"
            'webClient.DownloadFile(New Uri(sPath), dPath & fileName)
            'webClient.Dispose()




            'System.IO.File.Copy(sPath, dPath & System.IO.Path.GetFileName(sPath), True)
            'ZipFile.ExtractToDirectory(dPath & System.IO.Path.GetFileName(sPath), GetUserDataPath() & "\Data\")

            Using archive As ZipArchive = ZipFile.OpenRead(dPath & fileName)
                For Each entry As ZipArchiveEntry In archive.Entries
                    entry.ExtractToFile(dPath & entry.FullName, True)
                Next
            End Using

            File.Delete(dPath & System.IO.Path.GetFileName(sPath))
            Return dPath & fName & ".Tab"
        Catch ex As Exception
            WriteString_Log("ERROR:  GetNetworks -> CopyFileFromNetworkToLocalPath: " & ex.Message)
        End Try
        Return Nothing
    End Function

