    Public Sub TiltManager_Cell_AntennaTiltCoverage(ByVal cellid As String, ByVal cellid_x As String, ByVal cellid_y As String, ByVal antennatype As String, ByVal cellid_az As Double, ByVal cellid_rc As Double,
                                                    ByVal et As Double, ByVal mt As Double, Optional ByVal tilt As Double = 99, Optional clutter As Double = 0, Optional FromTiltClick As Integer = 0, Optional antennaLinesColor As Color = Nothing)
        _logger.SetInfo("Start CellAntennaTiltCoverage")
        _logger.SetInfo("Reading Feature data...")
        Dim cellid_electilt As Double = Nothing
        Dim cellid_mechtilt As Double = Nothing
        Dim hpbw_db As Double = -3
        Dim hpbw_horizontal As Double = 60
        Dim VAngle As Double = 6

        ' IIf(cellid_az = 360, 60, 360) ''
        cellid_electilt = tilt
        cellid_mechtilt = mt

        If tilt = 99 Then
            cellid_electilt = et
            cellid_mechtilt = mt
        Else
            cellid_electilt = tilt
            cellid_mechtilt = mt
        End If

        objFrmAdHocTiltMngr.CustomClutterDefault = 0
        If FromTiltClick = 1 Then
            objFrmAdHocTiltMngr.CustomClutter = clutter
        End If

        objFrmAdHocTiltMngr.CustomTiltDefault = et

        Dim hpbw_upper As Double = cellid_electilt - 3
        Dim hpbw_lower As Double = cellid_electilt + 3
        'getting antenna profile for requested tilt
        Dim dt_antenna As DataTable = Nothing
        Dim ds_antenna As DataSet = Nothing

        _logger.SetInfo("Cellid: " & cellid)
        _logger.SetInfo("cellid_x: " & cellid_x)
        _logger.SetInfo("cellid_y: " & cellid_y)
        _logger.SetInfo("cellid_az: " & cellid_az)
        _logger.SetInfo("cellid_rc: " & cellid_rc)
        _logger.SetInfo("cellid_electilt: " & cellid_electilt)
        _logger.SetInfo("cellid_mechtilt: " & cellid_mechtilt)

        Try
            Dim antennasql As String = Nothing
            If antennatype = Nothing Then
                antennasql = "SELECT TOP 1 * FROM Antennas where Antenna='" & "Default" & "' and Attenuation = " & hpbw_db & " order by (tilt - " & cellid_electilt & ") ASC "
                antennatype = "Default"
            Else
                antennasql = "IF EXISTS(select antenna from Antennas where antenna = '" & antennatype & "')  " &
                                " BEGIN " &
                                "SELECT TOP 1 * FROM Antennas where Antenna='" & antennatype & "' and Attenuation = " & hpbw_db & " order by (tilt - " & cellid_electilt & ") ASC " &
                                " END " &
                            "ELSE " &
                                "BEGIN " &
                                "SELECT TOP 1 * FROM Antennas where Antenna='Default' and Attenuation = " & hpbw_db & " order by (tilt - " & cellid_electilt & ") ASC " &
                                "END"
            End If

            _logger.SetInfo("Acquire Antenna Data - " + antennasql + " " + connStrIOSServer)
            ds_antenna = DataAccessorODBC.GetDataSet(connStrIOSServer, antennasql)

            If ds_antenna.Tables.Count = 1 Then
                If ds_antenna.Tables(0).Rows.Count > 0 Then
                    _logger.SetInfo("Antenna Data Rows- " + ds_antenna.Tables(0).Rows.Count.ToString)
                    dt_antenna = ds_antenna.Tables(0)
                    antennatype = dt_antenna(0)("Antenna").ToString
                    hpbw_lower = cellid_electilt + dt_antenna(0)("Vangle") / 2
                    hpbw_upper = cellid_electilt - dt_antenna(0)("Vangle") / 2
                    hpbw_horizontal = dt_antenna(0)("Hangle")
                    VAngle = dt_antenna(0)("Vangle")
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try

        'calculate distance based on 0 receiving height

        'get elevation of antenna:
        Dim p_profile(1) As DPoint
        p_profile(0) = New DPoint(cellid_x, cellid_y)
        Dim antenna_elevation As Double = 0

        antenna_elevation = frmTileMapping.TileMapping_GeoElevationPoint(p_profile(0))
        If antenna_elevation = -9999 Then
            Exit Sub
        End If
        ' Exit Sub

        Dim horizon_hit As Boolean = False
        'get maximum upper 3db distance (considering flat surface)
        Dim maxdistance_up3db As Double
        Dim maxdistance_down3db As Double
        Dim cellid_tt As Double = cellid_electilt + cellid_mechtilt
        If (90 - (cellid_mechtilt + hpbw_upper)) >= 90 Then
            maxdistance_up3db = Math.Sqrt(2 * 6400 * (antenna_elevation + cellid_rc - clutter) / 1000)
            horizon_hit = True
        Else
            maxdistance_up3db = (antenna_elevation + cellid_rc - clutter) * Math.Tan((90 - (cellid_mechtilt + hpbw_upper)) * Math.PI / 180) * 1 / 1000
        End If

        maxdistance_down3db = maxdistance_up3db 'temporary value
        'Exit Sub

        Try
            'get point of maxdistance
            Dim pint As MapInfo.Geometry.IPointEdit = New MapInfo.Geometry.Point(csysWGS84, p_profile(0)).GetPointEditor
            If cellid_az > 90 Then
                pint.OffsetByAngle((90 - cellid_az) + 360, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
            Else
                pint.OffsetByAngle(90 - cellid_az, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
            End If

            Dim p2 As DPoint = New DPoint(pint.X, pint.Y)
            p_profile(1) = p2
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try

        Dim profile_distance As Double = maxdistance_up3db

        _logger.SetInfo("Start GeoProfile Request -  " & profile_distance.ToString & " / " & p_profile(0).ToString & "," & p_profile(1).ToString)

        Dim dt_profile As DataTable = frmTileMapping.TileMapping_GeoProfile(p_profile, profile_distance)

        _logger.SetInfo("Profile -  " & dt_profile.Rows.Count.ToString)

        Dim samples_in_profile As Integer = dt_profile.Rows.Count
        Dim distancepersample As Double = profile_distance / samples_in_profile * 1000
        Try
            If Not dt_profile Is Nothing Then
                _logger.SetError("calculating Rays")

                dt_profile.Columns.Add(New DataColumn("lowerbeam_height", GetType(System.Double)))
                dt_profile.Columns.Add(New DataColumn("meanbeam_height", GetType(System.Double)))
                dt_profile.Columns.Add(New DataColumn("upperbeam_height", GetType(System.Double)))
                dt_profile.Columns.Add(New DataColumn("distance", GetType(System.Double)))
                dt_profile.Columns.Add(New DataColumn("clutter_height", GetType(System.Double)))

                For i = 0 To dt_profile.Rows.Count - 1
                    dt_profile(i)("distance") = distancepersample * i / 1000
                    dt_profile(i)("clutter_height") = dt_profile(i)("elevation") + clutter
                    If i = 0 Then
                        dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation
                        dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation
                        dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation
                    Else
                        If 90 - cellid_tt - hpbw_lower < 90 Then
                            dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_lower) * Math.PI / 180) * distancepersample * i)
                        Else
                            dt_profile(i)("lowerbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                        End If
                        If 90 - cellid_tt < 90 Then
                            dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_tt) * Math.PI / 180) * distancepersample * i)
                        Else
                            dt_profile(i)("meanbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                        End If

                        If 90 - (cellid_mechtilt + hpbw_upper) < 90 Then
                            dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation - (Math.Tan((cellid_mechtilt + hpbw_upper) * Math.PI / 180) * distancepersample * i)
                        Else
                            dt_profile(i)("upperbeam_height") = cellid_rc + antenna_elevation - (cellid_rc + antenna_elevation) / samples_in_profile * i
                        End If

                        If dt_profile(i)("upperbeam_height") < dt_profile(i)("clutter_height") And maxdistance_up3db = profile_distance Then
                            maxdistance_up3db = Math.Min(distancepersample * i / 1000, maxdistance_up3db)

                        End If
                        If dt_profile(i)("meanbeam_height") < dt_profile(i)("clutter_height") Then
                            ' maxdistance_up3db = distancepersample * i
                        End If
                        If dt_profile(i)("lowerbeam_height") < dt_profile(i)("clutter_height") Then
                            maxdistance_down3db = Math.Min(distancepersample * i / 1000, maxdistance_down3db)
                        End If
                    End If
                Next
                _logger.SetInfo("Dt Profile Calculation" + " - " + dt_profile.Rows.Count.ToString)
            Else
                maxdistance_down3db = cellid_rc * Math.Tan((90 - cellid_mechtilt - hpbw_lower) * Math.PI / 180) * 1 / 1000
            End If

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try

        _logger.SetInfo("Start Terrain Profile Plot" + " - " + profile_distance.ToString + " - " + cellid.ToString + " - " + cellid_electilt.ToString + " - " + cellid_mechtilt.ToString + " - " + antennatype.ToString)
        objFrmAdHocTiltMngr.tp_cellid = cellid
        objFrmAdHocTiltMngr.tp_cellidx = cellid_x
        objFrmAdHocTiltMngr.tp_cellidy = cellid_y
        objFrmAdHocTiltMngr.tp_cellid_az = cellid_az
        objFrmAdHocTiltMngr.tp_cellid_rc = cellid_rc
        objFrmAdHocTiltMngr.tp_cellid_ant = antennatype
        objFrmAdHocTiltMngr.tp_cellid_et = et
        objFrmAdHocTiltMngr.tp_cellid_mt = mt
        'objFrmLaunchTiltMngr.tp_recordid = RecordID

        Dim IndexWhereBeamHitsGround As Integer = dt_profile.Rows.Count - 1
        For Each dr As DataRow In dt_profile.Rows
            If dr("upperbeam_height") < dr("elevation") Then
                IndexWhereBeamHitsGround = dt_profile.Rows.IndexOf(dr)
                ' profile_distance = dr("distance")
                Exit For
            End If
        Next

        For i = dt_profile.Rows.Count - 1 To 0 Step -1
            If i > IndexWhereBeamHitsGround + 50 Then
                dt_profile.Rows(i).Delete()
            Else
                profile_distance = dt_profile.Rows(i)("distance")
                Exit For
            End If
        Next

        ''frmLaunchTiltManager.TerrainProfileStart_Tiltmanager(dt_profile, profile_distance, cellid, cellid_electilt, cellid_mechtilt, antennatype, cellid_rc, VAngle, antennaLinesColor)

        If Not FromTiltClick = 1 Then
            _logger.SetError("Start Map Drawing")
            Dim connection As MIConnection = New MIConnection
            Dim command As MICommand = connection.CreateCommand()
            MapInfo.Engine.Session.Current.Catalog.CloseTable("AntennaTilt_" & cellid)
            Dim ti As TableInfo = New TableInfoMemTable("AntennaTilt_" & cellid)
            ti.Columns.Add(ColumnFactory.CreateStringColumn("CELL", 100))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("X"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("Y"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("AZIMUTH"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("RADIATIONCENTER"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("ELECTRICALTILT"))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("MECHANICALTILT"))
            ti.Columns.Add(ColumnFactory.CreateStringColumn("ANTENNATYPE", 100))
            ti.Columns.Add(ColumnFactory.CreateDoubleColumn("CLUTTER"))
            'ti.Columns.Add(ColumnFactory.CreateIndexedDoubleColumn("RECORDID"))
            ti.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
            ti.Columns.Add(ColumnFactory.CreateStyleColumn())

            Dim MemTable As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti)
            Dim con As New MapInfo.Data.MIConnection

            Try
                con.Open()
                MemTable.BeginAccess(TableAccessMode.Write)
                Dim ftr_new As New Feature(MemTable.TableInfo.Columns)
                Dim i As Integer = 1
                Dim previouswidth As Double = 0
                Dim geoftr As Geometry = CreatePieRingGeometry(New DPoint(cellid_x, cellid_y), cellid_az, maxdistance_down3db, hpbw_horizontal, maxdistance_up3db - maxdistance_down3db)
                Dim styleftr As CompositeStyle = Nothing
                If antennaLinesColor = Nothing Then
                    styleftr = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(2, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.DarkGreen), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(100, Color.LightGreen))))
                Else
                    styleftr = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(2, MapInfo.Styles.LineWidthUnit.Pixel), 2, antennaLinesColor), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(100, antennaLinesColor))))
                End If
                ftr_new("CELL") = cellid
                ftr_new("X") = cellid_x
                ftr_new("Y") = cellid_y
                ftr_new("AZIMUTH") = cellid_az
                ftr_new("RADIATIONCENTER") = cellid_rc
                ftr_new("ELECTRICALTILT") = cellid_electilt
                ftr_new("MECHANICALTILT") = cellid_mechtilt
                ftr_new("ANTENNATYPE") = antennatype
                ftr_new("CLUTTER") = clutter
                'ftr_new("RECORDID") = RecordID
                ftr_new("obj") = geoftr
                ftr_new("MI_Style") = styleftr

                MemTable.InsertFeature(ftr_new)
                MemTable.EndAccess()
                Dim lyr As New FeatureLayer(MemTable)
                MapControl1.Map.Layers.Add(lyr)
                lyr.Modifiers.Append(New FeatureOverrideStyleModifier("AntennaStyle", styleftr))
                MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(MemTable))
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Finally
                If Not con Is Nothing Then
                    con.Close()
                    con.Dispose()
                    con = Nothing
                End If
            End Try
        End If
    End Sub

    Public Sub TiltManager_Cell_AntennaTiltCoverage_New(ByRef dtTreeTiltMngr As DataTable)

        'ByVal cellid As String, ByVal cellid_x As String, ByVal cellid_y As String, ByVal antennatype As String, ByVal cellid_az As Double, ByVal cellid_rc As Double,
        'ByVal et As Double, ByVal mt As Double, Optional ByVal tilt As Double = 99, Optional clutter As Double = 0, Optional FromTiltClick As Integer = 0, Optional antennaLinesColor As Color = Nothing

        'Dim noOfQueries As Integer = 12
        Dim clutter As Double = 0
        Dim FromTiltClick As Integer = 0
        Dim pcenter As DPoint = Nothing

        objFrmAdHocTiltMngr.CustomClutterDefault = 0
        If FromTiltClick = 1 Then
            objFrmAdHocTiltMngr.CustomClutter = clutter
        End If

        'get elevation of antenna:
        Dim p_profile(1) As DPoint
        p_profile(0) = New DPoint(dtTreeTiltMngr.Rows(0)("X"), dtTreeTiltMngr.Rows(0)("Y"))
        Dim antenna_elevation As Double = 0

        antenna_elevation = frmTileMapping.TileMapping_GeoElevationPoint(p_profile(0))
        If antenna_elevation = -9999 Then
            Exit Sub
        End If

        Dim horizon_hit As Boolean = False
        Dim maxdistance_up3db As Double = Nothing
        Dim azimuth As Integer = CInt(dtTreeTiltMngr.Rows(0)("AZIMUTH"))
        Dim mechanicalTilt As Double = CDbl(dtTreeTiltMngr.Rows(0)("MTILT"))
        Dim radiationCenter As Double = CDbl(dtTreeTiltMngr.Rows(0)("RadiationCenter"))
        Dim hpbw_upper As Double = CDbl(dtTreeTiltMngr.Compute("MIN([HPDW])", String.Empty))

        maxdistance_up3db = Math.Sqrt(2 * 6400 * (antenna_elevation + radiationCenter - clutter) / 1000)

        'If (90 - (mechanicalTilt + hpbw_upper)) >= 90 Then
        '	maxdistance_up3db = Math.Sqrt(2 * 6400 * (antenna_elevation + radiationCenter - clutter) / 1000)
        '	horizon_hit = True
        'Else
        '	maxdistance_up3db = (antenna_elevation + radiationCenter - clutter) * Math.Tan((90 - (mechanicalTilt + hpbw_upper)) * Math.PI / 180) * 1 / 1000
        'End If

        'maxdistance_down3db = maxdistance_up3db

        'Dim ds_profile As New DataSet

        Try
            Dim pint As MapInfo.Geometry.IPointEdit = New MapInfo.Geometry.Point(csysWGS84, p_profile(0)).GetPointEditor
            pcenter = New DPoint(pint.X, pint.Y)
            Dim p2(1) As DPoint

            'A loop to execute 24 times for a 120 degress points calculation from the antenna center point
            'For iCntr = 0 To noOfQueries - 1

            If azimuth > 90 Then
                pint.OffsetByAngle(90 - azimuth + 360, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
            Else
                pint.OffsetByAngle(90 - azimuth, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
            End If

            p_profile(0) = pcenter
            p_profile(1) = New DPoint(pint.X, pint.Y)

            Dim dt_profile = New DataTable
            dt_profile = frmTileMapping.TileMapping_GeoProfile(p_profile, maxdistance_up3db)

            Dim samples_in_profile As Integer = dt_profile.Rows.Count
            Dim distancepersample As Double = maxdistance_up3db / samples_in_profile * 1000
            Try
                If Not dt_profile Is Nothing Then
                    _logger.SetError("calculating Rays")
                    objFrmAdHocTiltMngr.dynCellNameColumnsCount = 0

                    Dim dtDistinctCells As DataTable = dtTreeTiltMngr.DistinctCol({"CELLNAME", "HPDW", "VBeamAngle"})
                    For Each drCells As DataRow In dtDistinctCells.Rows
                        If Not dt_profile.Columns.Contains("ubh_" & drCells("CELLNAME")) Then
                            dt_profile.Columns.Add(New DataColumn("ubh_" & drCells("CELLNAME"), GetType(System.String)))
                            objFrmAdHocTiltMngr.dynCellNameColumnsCount += 1
                        End If
                    Next

                    dt_profile.Columns.Add(New DataColumn("distance", GetType(System.Double)))
                    dt_profile.Columns.Add(New DataColumn("clutter_height", GetType(System.Double)))

                    For i = 0 To dt_profile.Rows.Count - 1
                        dt_profile(i)("distance") = distancepersample * i / 1000
                        dt_profile(i)("clutter_height") = dt_profile(i)("elevation") + clutter
                        If i = 0 Then
                            For Each col As DataColumn In dt_profile.Columns
                                If col.ColumnName.StartsWith("ubh_") Then
                                    dt_profile(i)(col) = radiationCenter + CDbl(dt_profile(i)("Elevation"))   'for every dynamically added upper beam column
                                End If
                            Next
                        Else

                            'for every dynamic column (loop here)
                            For Each col As DataColumn In dt_profile.Columns

                                If col.ColumnName.StartsWith("ubh_") Then
                                    ''calculate hpbw_upper for every cell (as per formula available in this method)
                                    Dim hpdw_upper_cell As Double = CDbl(dtTreeTiltMngr.AsEnumerable().Where(Function(x) x.Field(Of String)("CELLNAME") = col.ColumnName.Substring("ubh_".Length))(0)("HPDW"))

                                    If 90 - (mechanicalTilt + hpdw_upper_cell) < 90 Then
                                        dt_profile(i)(col) = radiationCenter + antenna_elevation - (Math.Tan((mechanicalTilt + hpdw_upper_cell) * Math.PI / 180) * distancepersample * i)
                                    Else
                                        'dt_profile(i)(col) = radiationCenter + antenna_elevation - (radiationCenter + CDbl(dt_profile(i)("Elevation"))) / samples_in_profile * i
                                        'dt_profile(i)(col) = radiationCenter + antenna_elevation - (radiationCenter) / samples_in_profile * i
                                        dt_profile(i)(col) = radiationCenter + antenna_elevation - (Math.Tan((mechanicalTilt + hpdw_upper_cell) * Math.PI / 180) * distancepersample * i)
                                    End If

                                End If

                                ''If dt_profile(i)("upperbeam_height") < dt_profile(i)("clutter_height") And maxdistance_up3db = profile_distance Then
                                ''	maxdistance_up3db = Math.Min(distancepersample * i / 1000, maxdistance_up3db)
                                ''End If

                            Next

                        End If
                    Next
                    _logger.SetInfo("Dt Profile Calculation" + " - " + dt_profile.Rows.Count.ToString)
                Else
                    'maxdistance_down3db = radiationCenter * Math.Tan((90 - mechanicalTilt - hpbw_lower) * Math.PI / 180) * 1 / 1000
                End If

            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try

            'dt_profile.TableName = "dt_profile" & iCntr.ToString
            'ds_profile.Tables.Add(dt_profile)

            'Next

            Dim IndexWhereBeamHitsGround As Integer = 0
            For Each col As DataColumn In dt_profile.Columns
                If col.ColumnName.StartsWith("ubh_") Then
                    For Each dr As DataRow In dt_profile.Rows
                        If dr(col) < dr("elevation") Then
                            IndexWhereBeamHitsGround = IIf(dt_profile.Rows.IndexOf(dr) > IndexWhereBeamHitsGround, dt_profile.Rows.IndexOf(dr), IndexWhereBeamHitsGround)
                            ' profile_distance = dr("distance")
                            Exit For
                        End If
                    Next
                End If
            Next

            If IndexWhereBeamHitsGround = 0 Then
                IndexWhereBeamHitsGround = 499
            End If

            For i = dt_profile.Rows.Count - 1 To 0 Step -1
                If i > IndexWhereBeamHitsGround + 50 Then
                    dt_profile.Rows(i).Delete()
                Else
                    maxdistance_up3db = dt_profile.Rows(i)("distance")
                    Exit For
                End If
            Next

            objFrmAdHocTiltMngr.TerrainProfileStart_Tiltmanager(dt_profile, maxdistance_up3db, dtTreeTiltMngr)

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try

        '_logger.SetInfo("Start GeoProfile Request -  " & profile_distance.ToString & " / " & p_profile(0).ToString & "," & p_profile(1).ToString)
        '_logger.SetInfo("Profile -  " & dt_profile.Rows.Count.ToString)

    End Sub

    Public Sub TiltManager_Draw_Cell_Wedge(ByRef dtTreeRef As DataTable, ByVal cellName As String, ByVal devicename As String, ByVal antRes As Integer)

        'Dim noOfQueries As Integer = 12
        Dim clutter As Double = 0
        Dim FromTiltClick As Integer = 0
        Dim pcenter As DPoint = New DPoint(dtTreeRef.Rows(0)("X"), dtTreeRef.Rows(0)("Y"))

        If dtPointsTiltManager Is Nothing Then

            objFrmAdHocTiltMngr.CustomClutterDefault = 0
            If FromTiltClick = 1 Then
                objFrmAdHocTiltMngr.CustomClutter = clutter
            End If

            'get elevation of antenna:
            Dim p_profile(1) As DPoint
            p_profile(0) = New DPoint(dtTreeRef.Rows(0)("X"), dtTreeRef.Rows(0)("Y"))
            Dim antenna_elevation As Double = 0

            antenna_elevation = frmTileMapping.TileMapping_GeoElevationPoint(p_profile(0))
            If antenna_elevation = -9999 Then
                Exit Sub
            End If

            Dim horizon_hit As Boolean = False
            Dim maxdistance_up3db As Double = Nothing
            Dim azimuth As Integer = CInt(dtTreeRef.Rows(0)("AZIMUTH"))
            Dim mechanicalTilt As Double = CDbl(dtTreeRef.Rows(0)("MTILT"))
            Dim radiationCenter As Double = CDbl(dtTreeRef.Rows(0)("RadiationCenter"))
            Dim hpbw_upper As Double = CDbl(dtTreeRef.Compute("MIN([HPDW])", String.Empty))

            maxdistance_up3db = Math.Sqrt(2 * 6400 * (antenna_elevation + radiationCenter - clutter) / 1000)
            Dim ds_profile As New DataSet

            Try
                Dim p2(1) As DPoint

                'A loop to execute <antRes> times for a 120 degress points calculation from the antenna center point
                For iCntr = 0 To antRes - 1
                    Dim pint As MapInfo.Geometry.IPointEdit = New MapInfo.Geometry.Point(csysWGS84, p_profile(0)).GetPointEditor
                    pcenter = New DPoint(pint.X, pint.Y)

                    Dim newAngle As Double = (azimuth - 60 + iCntr * 120 / (antRes - 1))
                    If newAngle < 0 Then
                        newAngle = newAngle + 360
                    End If
                    If newAngle > 90 Then
                        pint.OffsetByAngle(90 - newAngle + 360, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
                    Else
                        pint.OffsetByAngle(90 - newAngle, maxdistance_up3db, DistanceUnit.Kilometer, DistanceType.Spherical)
                    End If

                    p_profile(0) = pcenter
                    p_profile(1) = New DPoint(pint.X, pint.Y)

                    Dim dt_profile As New DataTable
                    dt_profile = frmTileMapping.TileMapping_GeoProfile(p_profile, maxdistance_up3db)

                    Dim samples_in_profile As Integer = dt_profile.Rows.Count
                    Dim distancepersample As Double = maxdistance_up3db / samples_in_profile * 1000
                    Try
                        If Not dt_profile Is Nothing Then
                            _logger.SetError("calculating Rays")
                            objFrmAdHocTiltMngr.dynCellNameColumnsCount = 0

                            Dim dtDistinctCells As DataTable = dtTreeRef.DistinctCol({"CELLNAME", "HPDW", "VBeamAngle"})
                            For Each drCells As DataRow In dtDistinctCells.Rows
                                dt_profile.Columns.Add(New DataColumn("ubh_" & drCells("CELLNAME"), GetType(System.String)))
                                objFrmAdHocTiltMngr.dynCellNameColumnsCount += 1
                            Next

                            dt_profile.Columns.Add(New DataColumn("distance", GetType(System.Double)))
                            dt_profile.Columns.Add(New DataColumn("clutter_height", GetType(System.Double)))

                            For i = 0 To dt_profile.Rows.Count - 1
                                dt_profile(i)("distance") = distancepersample * i / 1000
                                dt_profile(i)("clutter_height") = dt_profile(i)("elevation") + clutter
                                If i = 0 Then
                                    For Each col As DataColumn In dt_profile.Columns
                                        If col.ColumnName.StartsWith("ubh_") Then
                                            dt_profile(i)(col) = radiationCenter + CDbl(dt_profile(i)("Elevation"))   'for every dynamically added upper beam column
                                        End If
                                    Next
                                Else

                                    'for every dynamic column (loop here)
                                    For Each col As DataColumn In dt_profile.Columns

                                        If col.ColumnName.StartsWith("ubh_") Then

                                            Dim hpdw_upper_cell As Double = CDbl(dtTreeRef.AsEnumerable().Where(Function(x) x.Field(Of String)("CELLNAME") = col.ColumnName.Substring("ubh_".Length))(0)("HPDW"))

                                            If 90 - (mechanicalTilt + hpdw_upper_cell) < 90 Then
                                                ''calculate hpbw_upper for every cell (as per formula available in this method)
                                                '  Dim hpdw_upper_cell As Double = CDbl(dtTreeRef.Select("CELLNAME='" & col.ColumnName.Substring("ubh_".Length) & "'")(0)("HPDW"))
                                                dt_profile(i)(col) = radiationCenter + antenna_elevation - (Math.Tan((mechanicalTilt + hpdw_upper_cell) * Math.PI / 180) * distancepersample * i)
                                            Else
                                                'drawing upto horizon, otherwise no endpoint...
                                                dt_profile(i)(col) = radiationCenter + antenna_elevation - (radiationCenter) / samples_in_profile * i
                                            End If

                                        End If

                                        ''If dt_profile(i)("upperbeam_height") < dt_profile(i)("clutter_height") And maxdistance_up3db = profile_distance Then
                                        ''	maxdistance_up3db = Math.Min(distancepersample * i / 1000, maxdistance_up3db)
                                        ''End If

                                    Next

                                End If
                            Next
                            _logger.SetInfo("Dt Profile Calculation" + " - " + dt_profile.Rows.Count.ToString)
                        Else
                            'maxdistance_down3db = radiationCenter * Math.Tan((90 - mechanicalTilt - hpbw_lower) * Math.PI / 180) * 1 / 1000
                        End If

                    Catch ex As Exception
                        _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                    End Try

                    dt_profile.TableName = "dt_profile" & iCntr.ToString
                    ds_profile.Tables.Add(dt_profile)

                Next

                'Dim IndexWhereBeamHitsGround As Integer = 0
                'For Each col As DataColumn In dt_profile_tiltManager.Columns
                '	If col.ColumnName.StartsWith("ubh_") Then
                '		For Each dr As DataRow In dt_profile_tiltManager.Rows
                '			If dr(col) < dr("elevation") Then
                '				IndexWhereBeamHitsGround = IIf(dt_profile_tiltManager.Rows.IndexOf(dr) > IndexWhereBeamHitsGround, dt_profile_tiltManager.Rows.IndexOf(dr), IndexWhereBeamHitsGround)
                '				' profile_distance = dr("distance")
                '				Exit For
                '			End If
                '		Next
                '	End If
                'Next

                'For i = dt_profile_tiltManager.Rows.Count - 1 To 0 Step -1
                '	If i > IndexWhereBeamHitsGround + 50 Then
                '		dt_profile_tiltManager.Rows(i).Delete()
                '	Else
                '		maxdistance_up3db = dt_profile_tiltManager.Rows(i)("distance")
                '		Exit For
                '	End If
                'Next

                'objFrmLaunchTiltMngr.TerrainProfileStart_Tiltmanager(dt_profile_tiltManager, maxdistance_up3db, dtTreeTiltMngr)

            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try

            '_logger.SetInfo("Start GeoProfile Request -  " & profile_distance.ToString & " / " & p_profile(0).ToString & "," & p_profile(1).ToString)
            '_logger.SetInfo("Profile -  " & dt_profile.Rows.Count.ToString)

            dtPointsTiltManager = New DataTable
            dtPointsTiltManager.Columns.Add("CellName", GetType(String))
            dtPointsTiltManager.Columns.Add("dtProfileTable", GetType(Integer))
            dtPointsTiltManager.Columns.Add("MaxDistancePoint", GetType(String))
            dtPointsTiltManager.Columns.Add("MaxDistance", GetType(String))

            Dim IndexWhereBeamHitsGround As Integer = 0
            For Each dt As DataTable In ds_profile.Tables
                For Each col As DataColumn In dt.Columns
                    If col.ColumnName.StartsWith("ubh_") Then
                        For Each dr As DataRow In dt.Rows
                            If dr(col) < dr("elevation") Or dt.Rows.IndexOf(dr) = dt.Rows.Count - 1 Then
                                Dim drNew As DataRow = dtPointsTiltManager.NewRow
                                drNew("CellName") = col.ColumnName
                                drNew("dtProfileTable") = CInt(Replace(dt.TableName, "dt_profile", ""))
                                drNew("MaxDistancePoint") = dr("Location")
                                drNew("MaxDistance") = dr("distance")

                                dtPointsTiltManager.Rows.Add(drNew)
                                Exit For

                            End If

                        Next
                    End If
                Next
            Next

        End If

        Dim con As New MapInfo.Data.MIConnection
        Try
            con.Open()
            Dim dtWedge As DataTable = dtTreeRef.AsEnumerable().Where(Function(x) x.Field(Of String)("CELLNAME") = cellName And x.Field(Of String)("DEVICENAME") = devicename).CopyToDataTable()

            For Each drWedge As DataRow In dtWedge.Rows

                Dim lyr As FeatureLayer = Nothing
                Dim styleftr As CompositeStyle = Nothing
                Dim MemTable As MapInfo.Data.Table = Nothing

                Dim connection As MIConnection = New MIConnection
                Dim command As MICommand = connection.CreateCommand()
                MapInfo.Engine.Session.Current.Catalog.CloseTable("AntennaTilt_" & drWedge("DEVICENAME"))
                Dim ti As TableInfo = New TableInfoMemTable("AntennaTilt_" & drWedge("DEVICENAME"))
                ti.Columns.Add(ColumnFactory.CreateStringColumn("DEVICENAME", 200))
                ti.Columns.Add(ColumnFactory.CreateStringColumn("CELL", 100))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("X"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("Y"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("AZIMUTH"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("RADIATIONCENTER"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("ELECTRICALTILT"))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("MECHANICALTILT"))
                ti.Columns.Add(ColumnFactory.CreateStringColumn("ANTENNATYPE", 100))
                ti.Columns.Add(ColumnFactory.CreateDoubleColumn("CLUTTER"))
                ti.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
                ti.Columns.Add(ColumnFactory.CreateStyleColumn())

                MemTable = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti)

                MemTable.BeginAccess(TableAccessMode.Write)
                Dim ftr_new As New Feature(MemTable.TableInfo.Columns)

                Dim i As Integer = 1
                Dim previouswidth As Double = 0
                Dim cp(antRes + 1) As DPoint

                cp(0) = pcenter
                'maxdistance_up3db = dtPOintsTiltManager.Select("dtProfileTable='dt_profile" & (antRes / 2 - 1).ToString & "' And CellName='ubh_" & dr("CELLNAME") & "'")(0)("MaxDistance")
                'Dim geoftr As Geometry = CreatePieRingGeometry(New DPoint(dr("X"), dr("Y")), azimuth, 0.01, 60, maxdistance_up3db - 0.01)

                Dim dRow() As DataRow = dtPointsTiltManager.AsEnumerable().Where(Function(x) x.Field(Of String)("CellName") = "ubh_" & cellName).OrderBy(Function(x) x.Field(Of Integer)("dtProfileTable")).ToArray()

                For iCntr = 0 To dRow.Length - 1
                    cp.SetValue(New DPoint(dRow(iCntr)("MaxDistancePoint").ToString.Split(";")(1), dRow(iCntr)("MaxDistancePoint").ToString.Split(";")(0)), iCntr + 1)
                Next

                cp(antRes + 1) = pcenter
                Dim geoftr As Geometry = CreatePolygon(cp)

                If CType(drWedge("CellColor"), Color) = Nothing Then
                    styleftr = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(2, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.DarkGreen), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(100, Color.LightGreen))))
                Else
                    styleftr = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(2, MapInfo.Styles.LineWidthUnit.Pixel), 2, CType(drWedge("CellColor"), Color)), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(100, CType(drWedge("CellColor"), Color)))))
                End If

                ftr_new("DEVICENAME") = drWedge("DEVICENAME")
                ftr_new("CELL") = drWedge("CELLID")
                ftr_new("X") = drWedge("X")
                ftr_new("Y") = drWedge("Y")
                ftr_new("AZIMUTH") = CInt(dtTreeRef.Rows(0)("AZIMUTH"))
                ftr_new("RADIATIONCENTER") = CDbl(dtTreeRef.Rows(0)("RadiationCenter"))
                ftr_new("ELECTRICALTILT") = drWedge("ETILT")
                ftr_new("MECHANICALTILT") = CDbl(dtTreeRef.Rows(0)("MTILT"))
                ftr_new("ANTENNATYPE") = drWedge("ANTENNATYPE")
                ftr_new("CLUTTER") = 0 'clutter
                ftr_new("obj") = geoftr
                ftr_new("MI_Style") = styleftr

                MemTable.InsertFeature(ftr_new)

                MemTable.EndAccess()
                lyr = New FeatureLayer(MemTable)
                MapControl1.Map.Layers.Add(lyr)
                lyr.Modifiers.Append(New FeatureOverrideStyleModifier("AntennaStyle", styleftr))
                MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(MemTable))

            Next

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            If Not con Is Nothing Then
                con.Close()
                con.Dispose()
                con = Nothing
            End If
        End Try

    End Sub

