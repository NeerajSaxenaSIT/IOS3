    Public Sub GenerateGeoAggregation(ByVal values As GeoAggregationData)
        Try
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()
            Dim isLegend As Boolean = True
            For Each zRange As KeyValuePair(Of String, VisibleRange) In values.ZoomRange
                Dim con As New MapInfo.Data.MIConnection
                Dim com As MapInfo.Data.MICommand = Nothing
                Dim layerPostFix As String = "_GeoAggregate" & zRange.Key
                Try
                    SetStatus("Generating GeoAggregate for:  " & layerPostFix)
                    MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName + "_Buffer")
                    MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName + "_Union")
                    MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName + "_UnionSplit")
                    MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName + "_UnionSplit_Agg")
                    MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName + "_UnionSplit_Add")
                    MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName + layerPostFix)

                    Dim currentzoom As Distance
                    currentzoom = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)
                    Dim zoomlevel As Double = currentzoom.Value / 100

                    If CheckMapinfoTable(values.TableName) Then
                        Dim tbl_icm As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.GetTable(values.TableName)

                        con.Open()
                        com = con.CreateCommand()
                        Dim totalrecords As Integer

                        'create buffer table
                        Dim ti As MapInfo.Data.TableInfoMemTable = New MapInfo.Data.TableInfoMemTable(values.TableName + "_Buffer")
                        ti.Columns.Add(ColumnFactory.CreateIndexedIntColumn("GROUP"))
                        ti.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
                        ti.Columns.Add(ColumnFactory.CreateStyleColumn())

                        Dim tbl_buffer As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti)

                        com = con.CreateCommand()
                        com.CommandText = "Insert into " + tbl_buffer.Alias + " (" + ColumnString_MapinfoTable(tbl_buffer) + ", obj) Select 1, MI_Buffer(Obj," + zoomlevel.ToString.Replace(",", ".") + ",'km','Spherical',10) from " + tbl_icm.Alias
                        com.Prepare()
                        totalrecords = com.ExecuteNonQuery()
                        com.Dispose()

                        'Create Union table
                        Dim ti2 As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(values.TableName + "_Union", MapInfo.Data.TableType.MemTable, tbl_buffer), MapInfo.Data.TableInfoMemTable)
                        Dim tbl_union As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti2)

                        com = con.CreateCommand()
                        com.CommandText = "Insert into " + tbl_union.Alias + " (" + ColumnString_MapinfoTable(tbl_union) + ", obj) Select 1, MI_AggregateUnion(Obj) from " + tbl_buffer.Alias
                        com.Prepare()
                        totalrecords = com.ExecuteNonQuery()

                        com.Dispose()

                        'Create UnionSplit Table
                        Dim ti3 As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(values.TableName + "_UnionSplit", MapInfo.Data.TableType.MemTable, tbl_buffer), MapInfo.Data.TableInfoMemTable)
                        Dim tbl_unionsplit As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti3)

                        For Each ftr As Feature In tbl_union
                            Dim geo As MultiPolygon = ftr.Geometry
                            Dim i As Integer = 0

                            For Each pl As Polygon In geo
                                Dim mp As MultiPolygon = New MultiPolygon(pl.CoordSys, pl.CopyPolygon)
                                Dim newftr As Feature = New Feature(tbl_unionsplit.TableInfo.Columns)
                                newftr("GROUP") = i
                                newftr.Geometry = mp
                                tbl_unionsplit.InsertFeature(newftr)
                                i = i + 1
                            Next
                        Next

                        Dim ti4 As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(values.TableName + "_UnionSplit_Add", MapInfo.Data.TableType.MemTable, tbl_buffer), MapInfo.Data.TableInfoMemTable)
                        ti4.Columns.Add(ColumnFactory.CreateIndexedDoubleColumn(values.KPI))
                        Dim tbl_unionsplit_add As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti4)

                        com = con.CreateCommand()
                        com.CommandText = "Insert into " + tbl_unionsplit_add.Alias + " (" + ColumnString_MapinfoTable(tbl_unionsplit_add) + ", obj) select " + tbl_unionsplit.Alias + ".GROUP, " + values.TableName + "." + values.KPI + ", " + tbl_unionsplit.Alias + ".obj  FROM " + tbl_unionsplit.Alias + "," + values.TableName + " where " + tbl_unionsplit.Alias + ".obj intersects " + values.TableName + ".obj  "
                        com.Prepare()
                        totalrecords = com.ExecuteNonQuery()
                        com.Dispose()

                        'Geo- Aggregate - No Circle
                        com = con.CreateCommand()
                        com.CommandText = " select " + tbl_unionsplit_add.Alias + ".GROUP," + values.AggregationFunction + "(" + tbl_unionsplit_add.Alias + "." + values.KPI + ") as " + values.AggregationFunction + "_" + values.KPI + ", MI_AggregateUnion(" + tbl_unionsplit_add.Alias + ".obj) as obj  FROM " + tbl_unionsplit_add.Alias + " GROUP BY  " + tbl_unionsplit_add.Alias + ".GROUP"

                        com.Prepare()
                        Dim irfc As IResultSetFeatureCollection = com.ExecuteFeatureCollection
                        com.Dispose()

                        Dim ti5 As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(values.TableName + "_UnionSplit_Agg", MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                        Dim tbl_unionsplit_agg As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti5)

                        tbl_unionsplit_agg.InsertFeatures(irfc)

                        'Geo- Aggregate - Circle
                        com = con.CreateCommand()
                        com.CommandText = " select  GROUP,   " + values.AggregationFunction + "_" + values.KPI + ", MI_Buffer(MI_Centroid(obj), sqrt(MI_Area(obj, 'sq km','Spherical')/(3.14)),'km','Spherical',12) as obj  FROM " + tbl_unionsplit_agg.Alias

                        com.Prepare()
                        Dim irfc2 As IResultSetFeatureCollection = com.ExecuteFeatureCollection
                        com.Dispose()

                        Dim ti6 As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(values.TableName + layerPostFix, MapInfo.Data.TableType.MemTable, irfc2), MapInfo.Data.TableInfoMemTable)
                        Dim tbl_unionsplit_agg2 As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti6)

                        tbl_unionsplit_agg2.InsertFeatures(irfc2)

                        MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName + "_Buffer")
                        MapInfo.Engine.Session.Current.Catalog.CloseTable(values.TableName + "_UnionSplit")

                        If irfc2.Count > 0 Then
                            Dim lyr As FeatureLayer = Nothing

                            If frmICM.CirclePresentationToolStripMenuItem.Checked = True Then
                                lyr = New FeatureLayer(tbl_unionsplit_agg2)
                            Else
                                lyr = New FeatureLayer(tbl_unionsplit_agg)
                            End If

                            lyr.VisibleRange = zRange.Value
                            lyr.VisibleRangeEnabled = True
                            Dim ft As FeatureLayer = MapControl1.Map.Layers(values.TableName)
                            Dim test As Integer = MapControl1.Map.Layers.IndexOf(ft)
                            MapControl1.Map.Layers.Insert(test + 1, lyr)

                            Dim thm As MapInfo.Mapping.Thematics.RangedTheme = Nothing

                            thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, values.AggregationFunction + "_" + values.KPI, values.AggregationFunction + "_" + values.KPI, 5, Thematics.DistributionMethod.EqualRangeSize)
                            thm.RoundBy = 0.01

                            For m = 0 To thm.Bins.Count - 1
                                Select Case m
                                    Case 0
                                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.LightGray))))
                                    Case 1
                                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.Gray))))
                                    Case 2
                                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.DarkGray))))
                                    Case 3
                                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.DarkRed))))
                                    Case 4
                                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.Red))))
                                    Case Else
                                        thm.Bins(m).Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Gray), New MapInfo.Styles.SimpleInterior(2, Color.FromArgb(150, Color.WhiteSmoke))))
                                End Select
                            Next

                            thm.Recompute()
                            lyr.Modifiers.Append(thm)

                            Legend_CreateThematic(thm, values.AggregationFunction + "_" + values.KPI + zRange.Key, "", lyr)

                            con.Catalog.CloseTable("Labels_" & tbl_unionsplit_agg2.Alias)
                            CreateNetworkLabels(tbl_unionsplit_agg2, "floor(" + values.AggregationFunction + "_" + values.KPI + ")", 15, 0)
                            MapControl1.Map.Layers("Labels_" & tbl_unionsplit_agg2.Alias).VisibleRangeEnabled = False
                        End If
                    End If
                Catch ex As Exception
                    GeoAggregationManager.AddToRemoveCollection(values)
                    If Not com Is Nothing Then
                        com.Dispose()
                        com = Nothing
                    End If

                    If Not con Is Nothing Then
                        con.Close()
                        con.Dispose()
                    End If

                    con = Nothing
                Finally
                    If Not com Is Nothing Then
                        com.Dispose()
                        com = Nothing
                    End If

                    If Not con Is Nothing Then
                        con.Close()
                        con.Dispose()
                    End If

                    con = Nothing
                End Try
                SetStatus("GeoAggregate Completed:  " & layerPostFix)
            Next
        Catch ex As Exception
        Finally
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Public Sub MapDataToSingleLayer(ByVal externalData As DataTable, ByVal TargetLayerName As String, ByVal SourceField As String, ByVal JoinField As String, ByVal theme As String, ByVal themeExpression As String, Optional InfoTipExpression As String = "")
        Try
            Dim connection As New MIConnection
            Dim tableNameAlias = TargetLayerName

            If (externalData IsNot Nothing) Then
                Dim cloneData As DataTable = externalData.Clone()
                If (theme.Contains("Ranged")) Then
                    '' Ranged theme require numeric type column
                    cloneData.Columns(themeExpression).DataType = System.Type.GetType("System.Decimal")
                    For Each row As DataRow In externalData.Rows
                        If (IsDBNull(row(themeExpression))) Then
                            Continue For
                        ElseIf (row(themeExpression).ToString().Trim = "") Then
                            Continue For
                        Else
                            Dim result As Decimal = 0
                            If (Not Decimal.TryParse(row(themeExpression), result)) Then
                                XtraMessageBox.Show("Data '" & row(themeExpression) & "' in thematic column is not a valid number", "Please correct you data.", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                                Exit Sub
                            End If

                        End If
                        cloneData.ImportRow(row)
                    Next
                End If
                connection.Open()
                connection.Catalog.CloseTable(tableNameAlias)
                connection.Catalog.CloseTable(tableNameAlias & "_Map")
                Dim ti As TableInfoAdoNet = New TableInfoAdoNet(tableNameAlias)
                ti.ReadOnly = True
                ti.DataTable = IIf((theme.Contains("Ranged")), cloneData, externalData)
                Dim tbl_ExternalData As Table = connection.Catalog.OpenTable(ti)
                Dim tbl_map As MapInfo.Data.Table = Nothing
                Dim MaptableName = tableNameAlias & "_Map"

                For Each drow As DataRow In dt_Map_Configuration.Rows
                    If drow("LayerActive").ToString = True Then
                        Dim tbl As MapInfo.Data.Table = Session.Current.Catalog.GetTable(drow("LayerName").ToString.Trim)
                        If tbl IsNot Nothing AndAlso (tbl.TableInfo.TableType = TableType.Native And tbl.Alias.Contains("Cells_") And Not tbl.Alias.Contains("Voronoi")) Then

                            Dim sql As String = ""
                            If theme.Contains("Symbol") Or theme.Contains("Individual") Then
                                sql = "Select " & tbl_ExternalData.Alias & ".*," & " MI_Centroid(" + tbl.Alias + ".obj) as MI_Geometry  from " & tbl_ExternalData.Alias & ", " & tbl.Alias & "  WHERE " & tbl_ExternalData.Alias & "." & SourceField & " = " & tbl.Alias & "." & JoinField

                            Else
                                sql = "Select " & tbl_ExternalData.Alias & ".*," & tbl.Alias & ".obj from " & tbl_ExternalData.Alias & ", " & tbl.Alias & "  WHERE " & tbl_ExternalData.Alias & "." & SourceField & " = " & tbl.Alias & "." & JoinField

                            End If

                            Dim command As MICommand = connection.CreateCommand()
                            command.CommandText = sql
                            Dim irfc As IResultSetFeatureCollection = command.ExecuteFeatureCollection()

                            'connection.Catalog.CloseTable(tbl.Alias & "_" & tableNameAlias)
                            'Dim irfc As IResultSetFeatureCollection = command.ExecuteFeatureCollection(tbl.Alias & "_" & tableNameAlias)
                            command.Dispose()

                            If irfc.Count <> 0 Then

                                If connection.Catalog.GetTable(MaptableName) Is Nothing Then
                                    Dim ti_memtbl As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(MaptableName, MapInfo.Data.TableType.MemTable, irfc), MapInfo.Data.TableInfoMemTable)
                                    tbl_map = Session.Current.Catalog.CreateTable(ti_memtbl)
                                    tbl_map.InsertFeatures(irfc)
                                Else
                                    tbl_map = Session.Current.Catalog.GetTable(MaptableName)
                                    tbl_map.InsertFeatures(irfc)
                                End If
                                command.Dispose()

                            End If
                        End If
                    End If
                Next

                If Not tbl_map Is Nothing Then
                    Dim lyr As New FeatureLayer(tbl_map)
                    MapControl1.Map.Layers.Insert(0, lyr)
                    If (theme = "Ranged Region Theme") Then
                        Dim rangedThematic As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, MaptableName, 6, Thematics.DistributionMethod.EqualRangeSize)
                        rangedThematic.RoundBy = 0.01
                        'starting color
                        rangedThematic.Bins(0).Style.AreaStyle.Border = New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(3, 0), 2, Color.DarkBlue, False)
                        rangedThematic.Bins(0).Style.AreaStyle.Interior = New MapInfo.Styles.SimpleInterior(2, Color.DarkBlue)

                        rangedThematic.InflectionColor = Color.Yellow
                        rangedThematic.InflectionIndex = 3
                        rangedThematic.Inflected = True
                        rangedThematic.Recompute()

                        For i = 0 To rangedThematic.Bins.Count - 1
                            Dim si As MapInfo.Styles.SimpleInterior = rangedThematic.Bins(i).Style.AreaStyle.Interior
                            Dim frcolor As Color = Color.FromArgb(128, si.ForeColor)
                            Dim frcolorbrdr As Color = Color.FromArgb(255, si.ForeColor)

                            rangedThematic.Bins(i).Style.AreaStyle.Border = New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(3, 0), 2, frcolorbrdr, False)
                            rangedThematic.Bins(i).Style.AreaStyle.Interior = New MapInfo.Styles.SimpleInterior(si.Pattern, frcolor)

                        Next

                        rangedThematic.Bins(rangedThematic.InflectionIndex).Style.AreaStyle.Border = New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(3, 0), 2, rangedThematic.InflectionColor, False)
                        rangedThematic.Bins(rangedThematic.InflectionIndex).Style.AreaStyle.Interior = New MapInfo.Styles.SimpleInterior(2, rangedThematic.InflectionColor)
                        lyr.Modifiers.Append(rangedThematic)
                        Legend_CreateThematic(rangedThematic, lyr.Alias, rangedThematic.Expression, lyr)
                    ElseIf (theme = "Ranged Symbol Theme") Then

                        Dim rangedThematic As MapInfo.Mapping.Thematics.RangedTheme = New MapInfo.Mapping.Thematics.RangedTheme(lyr, themeExpression, MaptableName, 6, Thematics.DistributionMethod.EqualRangeSize)
                        rangedThematic.RoundBy = 0.01
                        'starting color
                        rangedThematic.Bins(0).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(46, Color.DarkBlue, 20)

                        rangedThematic.InflectionColor = Color.Yellow
                        rangedThematic.InflectionIndex = 3
                        rangedThematic.Inflected = True
                        rangedThematic.Recompute()

                        For i = 0 To rangedThematic.Bins.Count - 1
                            Dim si As MapInfo.Styles.SimpleVectorPointStyle = rangedThematic.Bins(i).Style.SymbolStyle
                            Dim frcolor As Color = Color.FromArgb(128, si.Color)

                            rangedThematic.Bins(i).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(46, frcolor, 20)
                            rangedThematic.SpreadBy = SpreadByPart.None
                        Next

                        rangedThematic.Bins(rangedThematic.InflectionIndex).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(46, rangedThematic.InflectionColor, 20)

                        lyr.Modifiers.Append(rangedThematic)
                        Legend_CreateThematic(rangedThematic, lyr.Alias, rangedThematic.Expression, lyr)

                    ElseIf (theme.Contains("Individual")) Then
                        Dim individualValueTheme As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, themeExpression, MaptableName)

                        For i = 0 To individualValueTheme.Bins.Count - 1

                            'Dim si As MapInfo.Styles.SimpleInterior = individualValueTheme.Bins(i).Style.AreaStyle.Interior
                            'Dim frcolor As Color = Color.FromArgb(128, si.ForeColor)
                            'Dim frcolorbrdr As Color = Color.FromArgb(255, si.ForeColor)

                            Dim si As MapInfo.Styles.SimpleVectorPointStyle = individualValueTheme.Bins(i).Style.SymbolStyle
                            Dim frcolor As Color = Color.FromArgb(128, si.Color)

                            individualValueTheme.Bins(i).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(46, frcolor, 20)

                            'individualValueTheme.Bins(i).Style.AreaStyle.Border = New MapInfo.Styles.SimpleLineStyle(New MapInfo.Styles.LineWidth(3, 0), 2, frcolorbrdr, False)
                            'individualValueTheme.Bins(i).Style.AreaStyle.Interior = New MapInfo.Styles.SimpleInterior(si.Pattern, frcolor)
                        Next
                        individualValueTheme.Name = themeExpression
                        individualValueTheme.RecomputeBins()

                        lyr.Modifiers.Append(individualValueTheme)
                        Legend_CreateThematic(individualValueTheme, lyr.Alias, individualValueTheme.Expression, lyr)
                    ElseIf (theme = "Graduated Theme") Then
                        Dim thm1 As MapInfo.Mapping.Thematics.GraduatedSymbolTheme = New MapInfo.Mapping.Thematics.GraduatedSymbolTheme(lyr.Table, themeExpression)
                        'Try
                        '    Dim linecolor As Integer = dt_Map_Configuration.Select("LayerName = '" & tbl.Alias & "'")(0)("LayerLineColor")
                        '    thm1.PositiveSymbol.Color = ColorInt2Color(linecolor)
                        'Catch ex As Exception
                        'End Try

                        Dim objthm As ObjectThemeLayer = New ObjectThemeLayer(lyr.Table.Alias, Nothing, thm1)
                        MapControl1.Map.Layers.Add(objthm)
                        objthm.RebuildTheme()
                        Legend_CreateThematic(thm1, themeExpression, lyr)
                        'MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tbl_map))

                    End If

                    Dim Colarray() As String = InfoTipExpression.ToUpper.Split(",")
                    MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tbl_map, Colarray))
                    MapInfo.Mapping.LayerHelper.SetSelectable(lyr, False)
                    MapControl1.Map.SetView(lyr)
                    RefreshQuickThemeControl()
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message)
        End Try
    End Sub

