    Public Sub LoadNetworks_Cells(ByVal dateSelected As Date, ByVal layerConfig As DataRow)
        Dim connection As MIConnection = New MIConnection
        Try
            lbl_GetNetworks_Status.Text = "Status: " & layerConfig.Item("LayerName").ToString & ": Fetching data..."
            pbcGetNetworks.Position = 0
            Application.DoEvents()

            Dim dateid As String
            dateid = Chr(39) + dateSelected.ToString("yyyyMMdd") + Chr(39)
            Dim tblName As String = layerConfig.Item("LayerName").ToString

            Dim sql As String = Replace(layerConfig.Item("LayerSQL").ToString, "@networkdate", dateid) + NetworkArea_GetSelection().Replace("ALL", "")
            Dim starttime As DateTime = Now()

            'LOAD CELLS
            Dim networkTbl As New System.Data.DataTable
            networkTbl = GetTableFromODBCSchema(connStrIOSServer, sql)

            If networkTbl Is Nothing Then
                SetStatus(tblName & " not found on IOS server")
                Exit Sub
            End If

            Dim command As MICommand = connection.CreateCommand()
            Dim tbl As MapInfo.Data.Table
            connection.Open()
            connection.Catalog.CloseTable(tblName)

            Dim ti As TableInfoAdoNet = New TableInfoAdoNet("Temp_" & tblName, networkTbl)
            tbl = connection.Catalog.OpenTable(ti)
            Dim newtbl As MapInfo.Data.Table = Nothing
            newtbl = CreateNetworkTable_Cells(tbl, "CellID", tblName, GetUserDataPath() & "\Data\", True, CreateNetworkStyle(CInt(layerConfig.Item("LayerLineWidth").ToString), CInt(layerConfig.Item("LayerLineColor").ToString)), CInt(layerConfig.Item("LayerRelativeSize").ToString), CInt(layerConfig.Item("LayerBeamWidth").ToString), layerConfig.Item("LayerPolygonType").ToString)
            tbl.Close()
            If newtbl Is Nothing Then
                connection.Close()
                connection.Dispose()
                Exit Sub
            End If

            'Adding Feature Layer
            Dim lyr As New FeatureLayer(newtbl)
            MapControl1.Map.Layers.Add(lyr)
            mapLyrBounds.Add(lyr.Alias, lyr.Bounds)
            MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, layerConfig.Item("LayerLabelName").ToString)
            'Adding Label Layer
            connection.Catalog.CloseTable("Labels_" & tblName)
            CreateNetworkLabels(newtbl, layerConfig.Item("LayerLabelName").ToString, CInt(layerConfig.Item("LayerLabelSize").ToString), CInt(layerConfig.Item("LayerLineColor").ToString))

            'Voronoi Calculation
            If cbVoronoi.Checked = True Then
                connection.Catalog.CloseTable(tblName & "_Voronoi")
                Dim newtbl_voronoi As MapInfo.Data.Table = Nothing
                newtbl_voronoi = CreateNetworkTable_Voronoi(newtbl, "CellID", tblName & "_Voronoi", GetUserDataPath() & "\Data\", True, "RecordID")
                If Not newtbl_voronoi Is Nothing Then
                    Dim lyr_voronoi As New FeatureLayer(newtbl_voronoi)
                    lyr_voronoi.Enabled = False
                    MapControl1.Map.Layers.Add(lyr_voronoi)
                    mapLyrBounds.Add(lyr_voronoi.Alias, lyr_voronoi.Bounds)
                    MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr_voronoi), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
                    MapInfo.Mapping.LayerHelper.SetSelectable(lyr_voronoi, False)
                End If
            End If

            connection.Close()
            connection.Dispose()
            Layer_Voronoi_Update()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            If connection.State = ConnectionState.Open Then
                connection.Close()
                connection.Dispose()
            End If
        End Try
    End Sub

    Public Sub LoadNetworks_Sites(ByVal dateSelected As Date, ByVal layerConfig As DataRow)
        Dim connection As MIConnection = New MIConnection
        Try
            lbl_GetNetworks_Status.Text = "Status: " & layerConfig.Item("LayerTechnology").ToString & ": Fetching Site Data..."
            pbcGetNetworks.Position = 0
            Application.DoEvents()

            Dim dateid As String
            dateid = Chr(39) + dateSelected.ToString("yyyyMMdd") + Chr(39)
            'LOAD SITES
            Dim sitetable As New System.Data.DataTable
            tblname = "Sites_" & layerConfig.Item("LayerTechnology").ToString
            sql = "SELECT * FROM qry_IOS_Sites" & layerConfig.Item("LayerTechnology").ToString & " WHERE NetworkDate = " & dateid
            sitetable = DataAccessorODBC.GetDataTable(connStrIOSServer, sql)
            If sitetable Is Nothing Then
                SetStatus("qry_IOS_Sites" & layerConfig.Item("LayerTechnology").ToString & " not found on IOS server")
                Exit Sub
            End If
            If connection.State = ConnectionState.Closed Then
                connection.Open()
            End If
            connection.Catalog.CloseTable(tblname)
            Dim ti2 As TableInfoAdoNet = New TableInfoAdoNet("Temp" & tblname)
            ti2.DataTable = sitetable

            Dim LayerLineColor As Integer = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerTechnology") = layerConfig("LayerTechnology").ToString).ToArray()(0)("LayerLinecolor")

            Dim dStyle As Style = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.FontPointStyle(35, New MapInfo.Styles.Font("MapInfo Symbols", 6), 0, ColorInt2Color(LayerLineColor), 6))

            Dim xy As SpatialSchemaXY = New SpatialSchemaXY
            xy.XColumn = "X"
            xy.YColumn = "Y"
            xy.NullPoint = "0.0, 0.0"
            ' Any customer at 0,0 means we don't know their location.
            xy.DefaultStyle = dStyle
            xy.CoordSys = Session.Current.CoordSysFactory.CreateLongLat(csysWGS84.Datum)
            ti2.SpatialSchema = xy
            ' Now set the spatial schem

            Dim tbl2 As Table = connection.Catalog.OpenTable(ti2)
            Dim newtbl2 As MapInfo.Data.Table
            newtbl2 = CreateNetworkTable_Sites(tbl2, "SITECODE", tblname, GetUserDataPath() & "\Data\", True)
            tbl2.Close()

            If newtbl2 Is Nothing Then
                connection.Close()
                connection.Dispose()
                Exit Sub
            End If

            'Adding Feature Layer
            Dim lyr2 As New FeatureLayer(newtbl2)
            MapControl1.Map.Layers.Add(lyr2)
            mapLyrBounds.Add(lyr2.Alias, lyr2.Bounds)
            MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr2), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))

            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr2, "SITECODE")
            MapInfo.Mapping.LayerHelper.SetSelectable(lyr2, False)
            lyr2.Enabled = False

            'Voronoi Calculation
            If cbVoronoi.Checked = True Then
                connection.Catalog.CloseTable(newtbl2.Alias & "_Voronoi")
                Dim newtbl2_voronoi As MapInfo.Data.Table = Nothing
                newtbl2_voronoi = CreateNetworkTable_Voronoi(newtbl2, "SITECODE", newtbl2.Alias & "_Voronoi", GetUserDataPath() & "\Data\", True, "RecordID")
                If Not newtbl2_voronoi Is Nothing Then
                    Dim lyr2_voronoi As New FeatureLayer(newtbl2_voronoi)
                    lyr2_voronoi.Enabled = False
                    MapControl1.Map.Layers.Add(lyr2_voronoi)
                    mapLyrBounds.Add(lyr2_voronoi.Alias, lyr2_voronoi.Bounds)
                    MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(lyr2_voronoi), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))
                    MapInfo.Mapping.LayerHelper.SetSelectable(lyr2_voronoi, False)
                End If
            End If

            lbl_GetNetworks_Status.Text = "Finished !"
            connection.Close()
            connection.Dispose()
            Layer_Voronoi_Update()

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            If connection.State = ConnectionState.Open Then
                connection.Close()
                connection.Dispose()
            End If
        End Try
    End Sub

