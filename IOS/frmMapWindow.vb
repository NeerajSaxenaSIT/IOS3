    Private Function GetMapZoomDistance() As Distance
        Dim zoomDistance As Distance = New Distance(MapControl1.Map.Zoom.Value, DistanceUnit.Kilometer)
        Dim cmb As ToolStripComboBox = Me.map_ToolStrip.Items("cmb_SetMapZoom")
        If cmb.SelectedItem.ToString.ToLower.Contains("low") Then
            zoomDistance = New Distance(2, DistanceUnit.Kilometer)
        ElseIf cmb.SelectedItem.ToString.ToLower.Contains("medium") Then
            zoomDistance = New Distance(30, DistanceUnit.Kilometer)
        ElseIf cmb.SelectedItem.ToString.ToLower.Contains("high") Then
            zoomDistance = New Distance(100, DistanceUnit.Kilometer)
        End If
        Return zoomDistance
    End Function

