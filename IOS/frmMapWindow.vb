    Private Sub SetNetworkSelectionForWorkspace()
        Dim matchFound As Boolean = False
        For Each t As IMapLayer In MapControl1.Map.Layers.GetMapLayerEnumerator()
            Try
                For iCntr = 0 To cmbNetworkArea.Properties.Items.Count - 1
                    Dim cbi As clsComboBoxItem = cmbNetworkArea.Properties.Items(iCntr)
                    If t.Alias.ToString.Contains(cbi.Text) Then
                        SetComboBox(cmbNetworkArea, ComboSelectBased.TextBased, cbi.Text)
                        matchFound = True
                        Exit For
                    End If
                Next
            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            End Try
            If matchFound = True Then
                Exit For
            End If
        Next
    End Sub

