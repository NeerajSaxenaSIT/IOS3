    Private Sub tsmi_TicketInfo_Click(sender As Object, e As EventArgs) Handles tsmi_TicketInfo.Click
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            'Get selection information (Site)
            Dim tbl As MapInfo.Data.Table
            Dim ftr As Feature
            Dim selected_tech As String = ""
            Dim sites As String = Nothing
            Map_ContextMenu.Close()
            MapControl1.Cursor = Cursors.WaitCursor
            Application.DoEvents()
            For Each tbl In MapInfo.Engine.Session.Current.Catalog
                Try
                    Dim fc As IResultSetFeatureCollection = Session.Current.Selections.DefaultSelection(tbl)
                    If Not fc Is Nothing Then
                        selected_tech = CType(fc, IDynamicFeatureCollection)(0)("TECHNOLOGY").ToString
                        For Each ftr In fc
                            sites = sites + ftr("SITECODE").ToString + ","
                        Next
                    End If
                    'fc.Clear()
                    fc = Nothing
                Catch ex As Exception
                    _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
                    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
                End Try
            Next

            tbl = Nothing
            ftr = Nothing
            If sites Is Nothing Then Exit Sub
            sites = sites.TrimEnd(",")

            If sites.Trim = "" Then
                Exit Sub
            End If

            Dim parray()() As String = {New String() {"@site", "@site"}}
            Dim sql_ticket As String
            Dim connstring As String
            connstring = GetSQL(4002, parray)(0)
            sql_ticket = GetSQL(4002, parray)(1)

            'OR implementation
            Dim subj As String = sql_ticket.Substring(InStr(sql_ticket, "AND") + 5, (InStr(sql_ticket, "@site") - 1) - (InStr(sql_ticket, "AND") + 5))
            Dim where_or As String = ""
            Dim i As Integer = 0
            For i = 0 To sites.Split(",").Count - 1
                If i = 0 Then
                    where_or = where_or & Chr(39) & sites.Split(",")(i) & "%" & Chr(39) & " "
                Else
                    where_or = where_or & " OR " & subj & " " & Chr(39) & sites.Split(",")(i) & "%" & Chr(39) & " "
                End If
            Next

            Dim tt As String = Replace(sql_ticket, "@site", where_or)
            Dim dtQODBC As System.Data.DataTable = DataAccessorODBC.GetDataTable(connstring, tt, iQryTimeOut)
            If Not dtQODBC Is Nothing Then
                Dim GridCtrl_Map As GridControl = Me.CreateTabWithGridViewForMapData("Ticket Info")
                Dim GridView_Map As New DevExpress.XtraGrid.Views.Grid.GridView(GridCtrl_Map)
                IOSDevExpressGrid.PopulateDataInGrid(GridCtrl_Map, GridView_Map, dtQODBC, "ITEM")
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
            MapControl1.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Private Sub tsmi_SaveThematicToPreconfigured_Click(sender As Object, e As EventArgs) Handles tsmi_SaveThematicToPreconfigured.Click
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            'Dim aa As MapInfo.Mapping.IMapLayer = MapControl1.Map.Layers(0).Map().Layers(0).GetType()
            Dim preConfigureLayer As FeatureLayer = Nothing
            Dim preConfigurePieLayer As ObjectThemeLayer = Nothing
            For lyerCounter As Integer = 0 To MapControl1.Map.Layers.Count
                Dim layerName As String = MapControl1.Map.Layers(lyerCounter).Name
                If (layerName.ToLower.Contains("icm")) Then
                    If (layerName.ToLower.Contains("pthem")) Then

                        If (MapControl1.Map.Layers(lyerCounter).GetType.Name = "ObjectThemeLayer") Then
                            Dim lay As ObjectThemeLayer = CType(MapControl1.Map.Layers(lyerCounter), ObjectThemeLayer)
                            If (lay.Name.ToLower.Contains("icm")) Then
                                preConfigurePieLayer = lay
                                Exit For

                            End If
                        ElseIf (MapControl1.Map.Layers(lyerCounter).GetType.Name = "FeatureLayer") Then
                            Dim lay As FeatureLayer = CType(MapControl1.Map.Layers(lyerCounter), FeatureLayer)
                            If (lay.Name.ToLower.Contains("icm")) Then
                                preConfigureLayer = lay
                                Exit For
                            End If
                        End If
                    End If
                End If
            Next

            'If Not fc Is Nothing Then
            If (preConfigurePieLayer IsNot Nothing) Then
                If (preConfigurePieLayer.GetType().Name = "ObjectThemeLayer") Then
                    'Dim feStyleModifiers As FeatureStyleModifiers = preConfigurePieLayer.Theme
                    Dim themPie As MapInfo.Mapping.Thematics.PieTheme = TryCast(preConfigurePieLayer.Theme, MapInfo.Mapping.Thematics.PieTheme)
                    IOSThematicKPI.SetPieTheme(themPie, preConfigurePieLayer.Name, connStrIOSServer)
                End If
            End If

            If (preConfigureLayer IsNot Nothing) Then
                If (preConfigureLayer.GetType().Name = "FeatureLayer") Then
                    Dim feStyleModifiers As FeatureStyleModifiers = preConfigureLayer.Modifiers

                    For Each feStyleModifier As FeatureStyleModifier In feStyleModifiers
                        If (feStyleModifier.Name.ToLower.Contains("range")) Then
                            Dim themRange As MapInfo.Mapping.Thematics.RangedTheme = TryCast(feStyleModifier, MapInfo.Mapping.Thematics.RangedTheme)
                            IOSThematicKPI.SetRangedTheme(themRange, connStrIOSServer)
                        ElseIf (feStyleModifier.Name.ToLower.Contains("individual")) Then
                            Dim themIndividual As MapInfo.Mapping.Thematics.IndividualValueTheme = TryCast(feStyleModifier, MapInfo.Mapping.Thematics.IndividualValueTheme)
                            IOSThematicKPI.SetIndividualTheme(themIndividual, connStrIOSServer)
                        Else

                        End If
                    Next

                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

