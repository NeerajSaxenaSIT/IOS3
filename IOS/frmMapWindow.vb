    Public Function CountRowsInTable(ByVal t As MapInfo.Data.Table, ByVal CountAll As Boolean) As Integer
        If t Is Nothing Then
            Return 0
        End If
        Dim miConn As New MapInfo.Data.MIConnection
        Dim miComm As New MapInfo.Data.MICommand("SELECT " + t.TableInfo.Columns(0).Alias + " FROM " + t.Alias, miConn)
        miConn.Open()
        Dim miDR As MapInfo.Data.MIDataReader = miComm.ExecuteReader
        Dim i As Integer = 0
        If Not CountAll Then
            If miDR.Read Then i += 1
        Else
            While miDR.Read
                i += 1
            End While
        End If
        miDR.Close()
        miDR.Dispose()
        miComm.Dispose()
        miConn.Close()
        miConn.Dispose()
        Return i
    End Function

    Private Function ColumnsInfoTip_MapinfoTable(ByVal dt As MapInfo.Data.Table, ByVal param As String) As String
        Dim str As String = Nothing

        If dt Is Nothing Then
            Return Nothing
        End If

        For Each col As MapInfo.Data.Column In dt.TableInfo.Columns
            If (col.DataType <> 9 And col.DataType <> 13) And (col.Alias = "CELLID" Or col.Alias = param) Then
                str = str & Chr(39) & col.Alias & ": " & Chr(39) & "+" & col.Alias & "+ char(13) +"
            End If
        Next col
        str = str.TrimEnd("+")
        str = str.TrimEnd(Chr(13))
        str = str.TrimEnd("+")
        Return str
    End Function

    Public Function ColumnsInfoTip_MapinfoTable(ByVal dt As MapInfo.Data.Table, Optional ByVal ColArrayToInclude() As String = Nothing) As String
        Dim str As String = Nothing
        If dt Is Nothing Then
            Return Nothing
        End If
        If ColArrayToInclude Is Nothing Then
            For Each col As MapInfo.Data.Column In dt.TableInfo.Columns
                If col.DataType <> 9 And col.DataType <> 13 Then
                    str = str & Chr(39) & col.Alias & ": " & Chr(39) & "+" & col.Alias & "+ char(13) +"
                End If
            Next col
        Else
            For Each col As MapInfo.Data.Column In dt.TableInfo.Columns
                If col.DataType <> 9 And col.DataType <> 13 And ColArrayToInclude.Contains(col.Alias.ToUpper) Then
                    str = str & Chr(39) & col.Alias & ": " & Chr(39) & "+" & col.Alias & "+ char(13) +"
                End If
            Next col
        End If
        str = str.TrimEnd("+")
        str = str.TrimEnd(Chr(13))
        str = str.TrimEnd("+")
        Return str
    End Function

