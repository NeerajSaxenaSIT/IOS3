    Private Function CreateMemTableGeoFromADO(ByVal tableToIndex As MapInfo.Data.Table, ByVal columnAliasToIndex As StringCollection, ByVal AliasForNewTable As String, ByVal cellid_x As Double, ByVal cellid_y As Double, ByVal cellid_az As Integer) As MapInfo.Data.Table
        'lbl_GetNetworks_Status.Text = AliasForNewTable & " : Generating Geo..."

        Dim ti As MapInfo.Data.TableInfoMemTable = CType(MapInfo.Data.TableInfoFactory.CreateFromFeatureCollection(AliasForNewTable, MapInfo.Data.TableType.MemTable, tableToIndex), MapInfo.Data.TableInfoMemTable)
        'For Each Str As String In columnAliasToIndex
        'ti.Columns(Str).Indexed = True
        'Next
        ti.Columns.Add(ColumnFactory.CreateFeatureGeometryColumn(csysWGS84))
        ti.Columns.Add(ColumnFactory.CreateStyleColumn())
        ti.Alias = AliasForNewTable

        Dim MemTable As MapInfo.Data.Table = MapInfo.Engine.Session.Current.Catalog.CreateTable(ti)
        Dim con As New MapInfo.Data.MIConnection
        Dim com As MapInfo.Data.MICommand = con.CreateCommand()
        Dim totalrecords As Integer

        Try
            'Populating Native Table with data
            con.Open()
            'Console.WriteLine(ColumnString_MapinfoTable(MemTable).ToString)
            'populating native table with all values of datatable
            com = con.CreateCommand()
            com.CommandText = "Insert into " + MemTable.Alias + " (" + ColumnString_MapinfoTable(MemTable) + ") Select " & ColumnString_MapinfoTable(tableToIndex) + " from " + tableToIndex.Alias + " order by DistanceKM"
            com.Prepare()
            totalrecords = com.ExecuteNonQuery
            com.Dispose()

            'Dim csys As CoordSys
            'csys = MapControl1.Map.GetDisplayCoordSys

            MemTable.BeginAccess(TableAccessMode.Write)
            Dim gtemp As FeatureGeometry = GetLineFeature(New DPoint(4, 52), New DPoint(4, 53), csysWGS84)
            'Preparing update query
            com = con.CreateCommand()
            com.CommandText = "Update " + MemTable.Alias + " set obj = @Obj, MI_Style = @style where round(DistanceKM,0.1) = round(@Bin,0.1)"
            com.Parameters.Add("@Obj", gtemp)
            com.Parameters.Add("@style", CreateNetworkStyle(1, 122222))
            com.Parameters.Add("@Bin", 1)

            Dim recordsupdated As Integer
            com.Prepare()

            Dim ftr As New Feature(MemTable.TableInfo.Columns)
            Dim i As Integer = 1

            Dim previouswidth As Double = 0
            Dim hpbw_horizontal As Double = IIf(cellid_az = 360, 360, 60) ''60

            For Each ftr In MemTable
                If Not ftr.Item("DistanceKM") Is Nothing And CDbl(ftr.Item("MeasRep").ToString) <> 0 Then
                    com.Parameters("@Obj").Value = CreatePieRingGeometry(New DPoint(cellid_x, cellid_y), cellid_az, previouswidth, hpbw_horizontal, CDbl(ftr("DistanceKM").ToString) - previouswidth)
                    com.Parameters("@style").Value = CreateNetworkStyle(1, 122222)
                    com.Parameters("@Bin").Value = CDbl(ftr.Item("DistanceKM").ToString)
                    recordsupdated = com.ExecuteNonQuery()
                End If

                previouswidth = CDbl(ftr("DistanceKM").ToString)
                i = i + 1
                Application.DoEvents()
            Next

            MemTable.EndAccess()
            Return MemTable
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Return Nothing
        Finally
            If Not com Is Nothing Then
                com.Dispose()
                com = Nothing
            End If
            If Not con Is Nothing Then
                con.Close()
                con.Dispose()
                con = Nothing
            End If
        End Try
    End Function

