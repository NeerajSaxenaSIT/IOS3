                                        ftr2.Item("RSRQ") = CInt(nZ(ftr("SC_RSRQ"), 0))

                                    ElseIf (NLIST.Contains(cid)) Then
                                        ftr2.Item("RSRP") = CInt(nZ(ftr("N" & n.ToString() & "_RSRP"), 0))
                                        ftr2.Item("RSRQ") = CInt(nZ(ftr("N" & n.ToString() & "_RSRQ"), 0))
                                        n = n + 1
                                    Else
                                        ftr2.Item("RSRP") = CInt(nZ(ftr("D" & el.ToString() & "_RSRP"), 0))
                                        ftr2.Item("RSRQ") = CInt(nZ(ftr("D" & el.ToString() & "_RSRQ"), 0))
                                        el = el + 1
                                    End If
                                    tblTemp.InsertFeature(ftr2)

                                Next
                                Session.Current.Catalog.CloseTable(tbl_search.Alias)
                            End If
                        End If
                    ElseIf (EventTypeMapped = "umts") Then
                        '3G
                        Dim ASList As New List(Of String)
                        Dim NBList As New List(Of String)
                        Dim cellid3g As String = "IN("
                        Dim tac3g As String = "IN("
                        For Each Column As MapInfo.Data.Column In ftr.Columns
                            Dim c As String = ""
                            Dim l As String = ""
                            Try
                                If (Column.Alias.ToLower.Contains("nb1_cellid") Or Column.Alias.ToLower.Contains("nb2_cellid") Or Column.Alias.ToLower.Contains("nb3_cellid") Or Column.Alias.ToLower.Contains("nb4_cellid") Or Column.Alias.ToLower.Contains("nb5_cellid") Or Column.Alias.ToLower.Contains("nb6_cellid")) Then
                                    c = CStr(ftr(Column.Alias))
                                    NBList.Add(c)
                                ElseIf (Column.Alias.ToLower.Contains("as1_cellid") Or Column.Alias.ToLower.Contains("as2_cellid") Or Column.Alias.ToLower.Contains("as3_cellid")) Then
                                    c = CStr(ftr(Column.Alias))
                                    ASList.Add(c)
                                ElseIf (Column.Alias.ToLower.Contains("nb1_lac") Or Column.Alias.ToLower.Contains("nb2_lac") Or Column.Alias.ToLower.Contains("nb3_lac") Or Column.Alias.ToLower.Contains("nb4_lac") Or Column.Alias.ToLower.Contains("nb5_lac") Or Column.Alias.ToLower.Contains("nb6_lac")) Then
                                    l = CStr(ftr(Column.Alias))
                                ElseIf (Column.Alias.ToLower.Contains("as1_lac") Or Column.Alias.ToLower.Contains("as2_lac") Or Column.Alias.ToLower.Contains("as3_lac")) Then
                                    l = CStr(ftr(Column.Alias))
                                End If
                            Catch ex As Exception
                                Continue For
                            End Try
                            If Not String.IsNullOrEmpty(c) Then
                                cellid3g = cellid3g & "'" & c & "',"
                            End If
                            If Not String.IsNullOrEmpty(l) Then
                                tac3g = tac3g & l & ","
                            End If
                        Next
                        cellid3g = cellid3g.TrimEnd(",") + ")"
                        tac3g = tac3g.TrimEnd(",") + ")"
                        If Not tblTemp Is Nothing And Not lyr Is Nothing Then
                            Dim j As Integer = 1
                            Dim n As Integer = 1
                            Dim tbl_search As MapInfo.Data.Table = Cell_LAC_SearchAndReturnGeo2(cellid3g, tac3g)
                            If tbl_search Is Nothing Then
                            Else
                                For Each ftr3 As Feature In tbl_search
                                    'the below part we'll draw a line between two points. First point being the px, py of the feature itself.'second point being the centroid of the searched CellID/LAC object on the map.
                                    Dim dps(1) As MapInfo.Geometry.DPoint
                                    dps(0) = ftr.Geometry.Centroid
                                    dps(1) = ftr3.Geometry.Centroid
                                    'the creation of the line based on 2 pts
                                    Dim ln As FeatureGeometry = New MapInfo.Geometry.MultiCurve(lyr.CoordSys, CurveSegmentType.Linear, dps)
                                    'now we add a style to the line. first by creating the style object. we are working with a line so we need a simplelinestyle
                                    Dim lstyle As SimpleLineStyle = Nothing
                                    Dim cId As String = ftr3.Item(0).ToString()
                                    If (ASList.Contains(cId)) Then
                                        If (ASList.IndexOf(cId) = 0) Then
                                            lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 3, System.Drawing.Color.LimeGreen)
                                        Else
                                            lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 3, System.Drawing.Color.Yellow)
                                        End If
                                    Else
                                        lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 3, System.Drawing.Color.Black)
                                    End If

                                    Dim cs As New CompositeStyle(lstyle)
                                    ' a new feature is created and inserted based on the table definition set in tlb_ParcelSelector_Click
                                    Dim ftr2 As New Feature(tblTemp.TableInfo.Columns)
                                    ftr2.Geometry = ln
                                    ftr2.Style = cs
                                    ftr2.Item("CellID") = ftr3("CELLID")
                                    ftr2.Item("LAC") = ftr3("LAC")
                                    If (ASList.Contains(cId)) Then
                                        ftr2.Item("Channel") = ftr("UARFCN")
                                        ftr2.Item("ECNO") = CInt(nZ(ftr("AS" & n.ToString() & "_ECNO"), 0))
                                        ftr2.Item("RSCP") = CInt(nZ(ftr("AS" & n.ToString() & "_RSCP"), 0))
                                        n = n + 1
                                    Else
                                        ftr2.Item("Channel") = ftr("UARFCN")
                                        ftr2.Item("ECNO") = CInt(nZ(ftr("NB" & j.ToString() & "_ECNO"), 0))
                                        ftr2.Item("RSCP") = CInt(nZ(ftr("NB" & n.ToString() & "_RSCP"), 0))
                                        j = j + 1
                                    End If
                                    tblTemp.InsertFeature(ftr2)

                                Next
                                Session.Current.Catalog.CloseTable(tbl_search.Alias)
                            End If
                        End If
                    Else
                        '2G
                        Dim cellid2g As String = "IN("
                        Dim lac2g As String = "IN("
                        For Each Column As MapInfo.Data.Column In ftr.Columns
                            Dim c As String = ""
                            Dim l As String = ""
                            Try
                                If (Column.Alias.ToLower.Contains("sc_cellid_2g")) Then
                                    c = CStr(ftr(Column.Alias))
                                ElseIf (Column.Alias.ToLower.Contains("sc_lac")) Then
                                    l = CStr(ftr(Column.Alias))
                                End If
                            Catch ex As Exception
                                Continue For
                            End Try
                            If Not String.IsNullOrEmpty(c) Then
                                cellid2g = cellid2g & "'" & c & "',"
                            End If
                            If Not String.IsNullOrEmpty(l) Then
                                lac2g = lac2g & l & ","
                            End If
                        Next
                        cellid2g = cellid2g.TrimEnd(",") + ")"
                        lac2g = lac2g.TrimEnd(",") + ")"
                        If Not tblTemp Is Nothing And Not lyr Is Nothing Then
                            Dim jj As Integer = 1
                            Dim tbl_search2g As MapInfo.Data.Table = Cell_LAC_SearchAndReturnGeo2(cellid2g, lac2g)
                            If tbl_search2g Is Nothing Then
                                '' Exit Sub
                            Else

                                For Each ftr3 As Feature In tbl_search2g

                                    Dim dps(1) As MapInfo.Geometry.DPoint
                                    dps(0) = ftr.Geometry.Centroid
                                    dps(1) = ftr3.Geometry.Centroid
                                    Dim ln As FeatureGeometry = New MapInfo.Geometry.MultiCurve(MapControl1.Map.GetDisplayCoordSys, CurveSegmentType.Linear, dps)
                                    Dim lstyle As SimpleLineStyle = Nothing
                                    lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 3, System.Drawing.Color.LimeGreen)
                                    Dim cs As New CompositeStyle(lstyle)
                                    Dim ftr2 As New Feature(tblTemp.TableInfo.Columns)
                                    ftr2.Geometry = ln
                                    ftr2.Style = cs
                                    ftr2.Item("CellID") = ftr3("CELLID")
                                    ftr2.Item("LAC") = ftr3("LAC")
                                    tblTemp.InsertFeature(ftr2)
                                    jj = jj + 1
                                Next
                                Session.Current.Catalog.CloseTable(tbl_search2g.Alias)
                            End If
                        End If

                        Dim bcch As String = ""
                        Dim ncc As String = ""
                        Dim bcc As String = ""
                        For Each Column As MapInfo.Data.Column In ftr.Columns
                            Dim bh As String = ""
                            Dim n As String = ""
                            Dim b As String = ""
                            Try
                                If (Column.Alias.ToLower.Contains("bcch")) Then
                                    bh = CStr(ftr(Column.Alias))
                                ElseIf (Column.Alias.ToLower.Contains("ncc")) Then
                                    n = CStr(ftr(Column.Alias))
                                ElseIf (Column.Alias.ToLower.Contains("bcc")) Then
                                    b = CStr(ftr(Column.Alias))
                                End If
                            Catch ex As Exception
                                Continue For
                            End Try
                            If Not String.IsNullOrEmpty(bh) Then
                                bcch = bcch & bh & ","
                            End If
                            If Not String.IsNullOrEmpty(n) Then
                                ncc = ncc & n & ","
                            End If
                            If Not String.IsNullOrEmpty(b) Then
                                bcc = bcc & b & ","
                            End If
                        Next
                        bcch = bcch.TrimEnd(",") + ""
                        ncc = ncc.TrimEnd(",") + ""
                        bcc = bcc.TrimEnd(",") + ""
                        If Not tblTemp Is Nothing And Not lyr Is Nothing Then
                            Dim bnbcc As Integer = 1
                            Dim tblCC_search2g As MapInfo.Data.Table = Cell_BCC_SearchAndReturnGeo(bcch, ncc, bcc)

                            If tblCC_search2g Is Nothing Then
                                '' Exit Sub
                            Else
                                Dim lstFeat As New List(Of IOSFeatureGeometry)
                                lstFeat = CalculateDistance(tblCC_search2g, ftr)

                                For Each ftrGemList As IOSFeatureGeometry In lstFeat
                                    ' For Each ftr3 As Feature In ftrGemList.feature 'tblCC_search2g
                                    Dim dps(1) As MapInfo.Geometry.DPoint
                                    dps(0) = ftr.Geometry.Centroid
                                    dps(1) = ftrGemList.feature.Geometry.Centroid 'ftr3.Geometry.Centroid
                                    Dim ln As FeatureGeometry = New MapInfo.Geometry.MultiCurve(MapControl1.Map.GetDisplayCoordSys, CurveSegmentType.Linear, dps)

                                    Dim lstyle As SimpleLineStyle = Nothing
                                    lstyle = New SimpleLineStyle(New LineWidth(4, LineWidthUnit.Pixel), 3, System.Drawing.Color.Black)
                                    Dim cs As New CompositeStyle(lstyle)
                                    Dim ftr2 As New Feature(tblTemp.TableInfo.Columns)
                                    ftr2.Geometry = ln
                                    ftr2.Style = cs

                                    ftr2.Item("BCCH") = ftrGemList.feature("BCCH")
                                    ftr2.Item("NCC") = ftrGemList.feature("NCC")
                                    ftr2.Item("BCC") = ftrGemList.feature("BCC")
                                    tblTemp.InsertFeature(ftr2)
                                    bnbcc = bnbcc + 1
                                    'Next
                                Next
                                Session.Current.Catalog.CloseTable(tblCC_search2g.Alias)
                            End If
                        End If
                    End If
                Next
                ' irfc.Close()
            End If
            'for every line we want a tooltip to show up when user puts mouse cursor on it for 1 sec or longer.
            ' the tooltip should show all data for that line.
            ' this is achieved by calling "ColumnsInfoTip_MapinfoTable". this loops through th table to get all columns and tags for it and returns a string that is interpreted by mapxtreme for tooltip.
            MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, lyr, ColumnsInfoTip_MapinfoTable(tblTemp))
        Catch ex As System.AccessViolationException
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message)
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            SetStatus(ex.Message)
            'XtraMessageBox.Show(ex.Message)
        End Try
    End Sub

    Private Sub MapCatalog_TableOpened(ByVal sender As Object, ByVal e As TableOpenedEventArgs)
        Try
            Exit Sub
            For Each drow As DataRow In dt_Map_Configuration.Rows
                If drow.Item("LayerName").ToString.Trim = e.Table.Alias Then
                    Dim btn_tlb As ToolStripButton = Me.map_ToolStrip.Items(drow.Item("LayerName").ToString.Trim)
                    If Not btn_tlb Is Nothing Then
                        Dim lyr As FeatureLayer = CType(MapControl1.Map.Layers(drow("LayerName").ToString.Trim), FeatureLayer)
                        If Not lyr Is Nothing Then
                            If lyr.Enabled Then
                                btn_tlb.Checked = True
                            End If
                        End If
                        'MapInfo.Tools.MapTool.SetInfoTipExpression(MapControl1.Tools.MapToolProperties, MapControl1.Map.Layers(e.Table.Alias), "CELLID")
                    End If
                End If
            Next
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

