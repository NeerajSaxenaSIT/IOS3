            layerTemp.Table.InsertFeature(feature)
        End If
        MapControl1.Map.Layers.Insert(MapControl1.Map.Layers.Count, layerTemp)
    End Sub

    Public Sub AddTempTabletoMap(ByVal mapTableName As String, Optional LeaveOpen As Boolean = False)
        Dim tblTemp As MapInfo.Data.Table = Session.Current.Catalog.GetTable(mapTableName)
        Dim IsCosmeticLayer As Boolean = False
        For Each l In MapControl1.Map.Layers
            If (l.Alias.ToString = CosmeticLayer) Then
                IsCosmeticLayer = True
            End If
        Next

        If Not tblTemp Is Nothing Then
            If LeaveOpen = True And IsCosmeticLayer = True Then
                Exit Sub
            End If
        End If

        If Not (tblTemp Is Nothing) Then
            tblTemp.Close()
        End If

        Dim layerTemp As FeatureLayer = New FeatureLayer(Session.Current.Catalog.CreateTable(TableInfoFactory.CreateTemp(mapTableName), New TableSessionInfo()))
        Dim cStyle As MapInfo.Styles.CompositeStyle = Nothing

        If (addRectagulType = AddRectangleType.ActiveArea Or addRectagulType = AddRectangleType.RegionTag) Then
            cStyle = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(
        New MapInfo.Styles.SimpleLineStyle(
         New MapInfo.Styles.LineWidth(
         1, MapInfo.Styles.LineWidthUnit.Pixel), 2, System.Drawing.Color.Black),
         New MapInfo.Styles.SimpleInterior(1, System.Drawing.Color.Black, Color.White, True)))
        ElseIf (addRectagulType = AddRectangleType.SelectionArea) Then
            cStyle = New MapInfo.Styles.CompositeStyle(New MapInfo.Styles.AreaStyle(
        New MapInfo.Styles.SimpleLineStyle(
         New MapInfo.Styles.LineWidth(
         1, MapInfo.Styles.LineWidthUnit.Pixel), 3, System.Drawing.Color.Black),
         New MapInfo.Styles.SimpleInterior(1, System.Drawing.Color.Black, Color.White, True)))
        End If

        Dim sOverRideRule As New FeatureOverrideStyleModifier(mapTableName, mapTableName, cStyle)
        MapInfo.Mapping.LayerHelper.SetInsertable(layerTemp, True)
        If (addRectagulType = IOS.AddRectangleType.ActiveArea) Then
            MapControl1.Map.Layers.Insert(0, layerTemp)
        Else
            MapControl1.Map.Layers.Insert(MapControl1.Map.Layers.Count, layerTemp)
            'MapControl1.Map.Layers.Add(layerTemp)
        End If
        MapControl1.Map.Layers.Move(MapControl1.Map.Layers.IndexOf(layerTemp), Math.Min(GetIndexOfLayerName("IOS_TileMap") - 1, MapControl1.Map.Layers.Count - 1))

        AddHandler MapControl1.Tools.FeatureAdding, AddressOf Tools_FeatureAdding
        AddHandler MapControl1.Tools.FeatureAdded, AddressOf Tools_FeatureAdded
        ''AddHandler MapControl1.Too, AddressOf Tools_FeatureAdded
        layerTemp.Modifiers.Append(sOverRideRule)
    End Sub

    Public Sub SelectionToTreeStep2(ByVal tech As String, ByVal cellid As String, ByVal IsTopX As Boolean)
        objfrmTechnology = Nothing
        If Not objFrmTechList.Exists(Function(x) x.Network.ToUpper.Equals(tech)) Then
            frmMDI.OpenTechFormDynamically(tech, objfrmTechnology, False)
        Else
            objfrmTechnology = objFrmTechList.Where(Function(m) m.Network.Equals(tech)).LastOrDefault()
        End If
        If IsTopX = False Then
            If tech.ToUpper = objfrmTechnology.Network.ToUpper Then
                objfrmTechnology.FindNodeTreeviewStats(cellid)
            End If
        Else
            If tech.ToUpper = objfrmTechnology.Network.ToUpper Then
                objfrmTechnology.FindNodeTreeviewTopX(cellid)
            End If
        End If
    End Sub

    Public Sub DT_CreateThematics(ByRef lyr As FeatureLayer, ByVal thmType As String, Optional ByVal header As String = "", Optional ByVal subheader As String = "")
        Dim flag As Boolean = False
        Dim reader As MIDataReader = lyr.Table.ExecuteReader()
        Dim thm As MapInfo.Mapping.Thematics.RangedTheme = Nothing
        If thmType = "Best RSRP" Or thmType = "UE4G" Or thmType.Contains("RSRP") Then
            Dim exp As String = "RSRP_1"
            If (thmType = "UE4G") Then
                exp = "SC_RSRP"
            ElseIf (thmType.Contains("RSRP")) Then
                If header.Contains("Cell - Footprint") Then
                    exp = "RSRP"
                Else
                    exp = "RSRP_1"
                End If
            End If
            thm = New MapInfo.Mapping.Thematics.RangedTheme(lyr, exp, thmType, 7, Thematics.DistributionMethod.CustomRanges)
            Dim cl As Color
            thm.Name = thmType
            'set bins
            thm.ApplyStylePart = Thematics.StylePart.Color
            thm.SpreadBy = Thematics.SpreadByPart.None
            thm.Bins(6).Min = -60
            thm.Bins(6).Max = 0
            thm.Bins(5).Min = -80
            thm.Bins(5).Max = -60
            thm.Bins(4).Min = -90
            thm.Bins(4).Max = -80
            thm.Bins(3).Min = -100
            thm.Bins(3).Max = -90
            thm.Bins(2).Min = -110
            thm.Bins(2).Max = -100
            thm.Bins(1).Min = -120
            thm.Bins(1).Max = -110
            thm.Bins(0).Min = -130
            thm.Bins(0).Max = -120

            Dim mtb As Thematics.ModifierThemeBin
            For i = 0 To 6
                mtb = thm.Bins.Item(i)
                Select Case i
                    Case 6
                        cl = Color.Green
                    Case 5
                        cl = Color.LimeGreen
                    Case 4
                        cl = Color.Yellow
                    Case 3
                        cl = Color.Orange
                    Case 2
                        cl = Color.Red
                    Case 1
