    Private Sub CNE_ApplyRangeTheme(ByVal isSymbolApply As Boolean, ByRef lyr As FeatureLayer,
                                    ByVal themeExpression As String, ByVal dtThematicBins As DataTable, ByVal countOfBins As Integer)
        Try
            'MapControl1.Map.Layers.Add(lyr)
            Dim rowscounter As Integer = 0
            Dim themRange As RangedTheme = New RangedTheme(lyr, themeExpression, themeExpression, countOfBins, DistributionMethod.CustomRanges)
            themRange.ApplyStylePart = StylePart.All
            themRange.SpreadBy = SpreadByPart.None
            themRange.RoundBy = dtThematicBins.Rows(0)(IOSThematicKeys.ROUND_BY) '0.01

            Dim framColor As Color
            Dim framColorBorder As Color

            dtThematicBins.DefaultView.Sort = "RangeMax ASC"

            For Each dr As DataRow In dtThematicBins.DefaultView.ToTable.Rows
                If (isSymbolApply) Then

                    framColor = IntegerToColor(dr(IOSThematicKeys.SYMBOL_INTERIOR_TRANSPARENCY), dr(IOSThematicKeys.SYMBOL_INTERIOR_COLOR))
                    framColorBorder = IntegerToColor(dr(IOSThematicKeys.SYMBOL_BORDERTRANSPARENCY), dr(IOSThematicKeys.SYMBOL_BORDER_COLOR))
                    themRange.Bins(rowscounter).Style.SymbolStyle = New MapInfo.Styles.FontPointStyle(dr(IOSThematicKeys.SYMBOL_NUMBER), New MapInfo.Styles.Font("MapInfo Symbols", 20), 0, framColorBorder, dr(IOSThematicKeys.SYMBOL_SIZE))
                    ' themRange.Bins(rowscounter).Style.SymbolStyle = New MapInfo.Styles.SimpleVectorPointStyle(dr(IOSThematicKeys.SYMBOL_NUMBER), framColorBorder, dr(IOSThematicKeys.SYMBOL_SIZE))

                Else
                    framColor = IntegerToColor(dr(IOSThematicKeys.REGION_TRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
                    framColorBorder = IntegerToColor(dr(IOSThematicKeys.REGION_BORDER_LINETRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))

                    themRange.Bins(rowscounter).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(dr(IOSThematicKeys.REGION_BORDER_LINEWIDTH), 0), 0, framColorBorder, False)
                    themRange.Bins(rowscounter).Style.AreaStyle.Interior = New SimpleInterior(dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColor)
                End If

                themRange.Bins(rowscounter).Min = dr(IOSThematicKeys.RANGE_MIN)
                themRange.Bins(rowscounter).Max = dr(IOSThematicKeys.RANGE_MAX)

                rowscounter += 1
            Next

            themRange.Recompute()
            lyr.Modifiers.Clear()


            Dim item As ToolStripMenuItem = CType(tlb_ParcelSelector.DropDownItems(2), ToolStripMenuItem)


            lyr.Modifiers.Append(themRange)
            LayerHelper.SetSelectable(lyr, item.Checked)
            Legend_CreateThematic(themRange, themeExpression, lyr)

        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

    Private Sub CNE_ApplyIndividualTheme(ByVal isSymbolApply As Boolean, ByRef lyr As FeatureLayer,
                                         ByVal themeExpression As String, ByVal dtThematicBins As DataTable, ByVal countOfBins As Integer)
        'MapControl1.Map.Layers.Add(lyr)


        Dim rowscounter As Integer = 0
        Dim framColor As Color
        Dim framColorBorder As Color

        Dim thmIndividual As IndividualValueTheme = New IndividualValueTheme(lyr, themeExpression, themeExpression)
        thmIndividual.ApplyStylePart = StylePart.Color
        Try
            If thmIndividual.Bins.Count < 500 Then

                If IsDBNull(dtThematicBins.Rows(0)("IndividualValue")) Then
                    'Automatically generate theme
                    If (isSymbolApply) Then
                        For iCntr = 0 To thmIndividual.Bins.Count - 1
                            framColor = Color.FromArgb(dtThematicBins.Rows(0)(IOSThematicKeys.SYMBOL_INTERIOR_TRANSPARENCY), thmIndividual.Bins(iCntr).Style.SymbolStyle.Color)
                            framColorBorder = Color.FromArgb(dtThematicBins.Rows(0)(IOSThematicKeys.SYMBOL_BORDERTRANSPARENCY), thmIndividual.Bins(iCntr).Style.SymbolStyle.Color)
                            thmIndividual.Bins(iCntr).Style.SymbolStyle = New MapInfo.Styles.FontPointStyle(dtThematicBins.Rows(0)(IOSThematicKeys.SYMBOL_NUMBER), New MapInfo.Styles.Font("MapInfo Symbols", 20), 0, framColorBorder, dtThematicBins.Rows(0)(IOSThematicKeys.SYMBOL_SIZE))
                        Next
                    Else
                        For iCntr = 0 To thmIndividual.Bins.Count - 1
                            framColor = Color.FromArgb(dtThematicBins.Rows(0)(IOSThematicKeys.REGION_TRANSPARENCY), thmIndividual.Bins(iCntr).Style.SymbolStyle.Color)
                            framColorBorder = Color.FromArgb(dtThematicBins.Rows(0)(IOSThematicKeys.REGION_BORDER_LINETRANSPARENCY), thmIndividual.Bins(iCntr).Style.SymbolStyle.Color)
                            '      thmIndividual.Bins(rowscounter).Style.AreaStyle.Border = New SimpleLineStyle(New LineWidth(dtThematicBins.Rows(0)(IOSThematicKeys.REGION_BORDER_LINEWIDTH), 0), dtThematicBins.Rows(0)(IOSThematicKeys.REGION_INTERIOR_TYPE), framColorBorder, False)
                            thmIndividual.Bins(rowscounter).Style.AreaStyle.Border = New SimpleLineStyle(0)
                            thmIndividual.Bins(rowscounter).Style.AreaStyle.Interior = New SimpleInterior(dtThematicBins.Rows(0)(IOSThematicKeys.REGION_INTERIOR_TYPE), framColor)
                        Next
                    End If

                Else
                    'MANUAL setting of individual colors 
                    For Each dr As DataRow In dtThematicBins.Rows

                        If (isSymbolApply) Then
                            For iCntr = 0 To thmIndividual.Bins.Count - 1
                                If thmIndividual.Bins(iCntr).Value = dr("IndividualValue") Then
                                    framColor = IntegerToColor(dr(IOSThematicKeys.SYMBOL_INTERIOR_TRANSPARENCY), dr(IOSThematicKeys.SYMBOL_INTERIOR_COLOR))
                                    framColorBorder = IntegerToColor(dr(IOSThematicKeys.SYMBOL_BORDERTRANSPARENCY), dr(IOSThematicKeys.SYMBOL_BORDER_COLOR))
                                    '      thmIndividual.Bins(iCntr).Style.SymbolStyle = New MapInfo.Styles.FontPointStyle(dr(IOSThematicKeys.SYMBOL_NUMBER), New MapInfo.Styles.Font("MapInfo Symbols", 50), 0, framColorBorder, dr(IOSThematicKeys.SYMBOL_SIZE))
                                    Dim mtb As ModifierThemeBin = thmIndividual.Bins(iCntr)
                                    mtb.Style.ApplyStyle(New MapInfo.Styles.FontPointStyle(dr(IOSThematicKeys.SYMBOL_NUMBER), New MapInfo.Styles.Font("MapInfo Symbols", 20), 0, framColorBorder, dr(IOSThematicKeys.SYMBOL_SIZE)))
                                End If

                            Next
                        Else
                            For iCntr = 0 To thmIndividual.Bins.Count - 1
                                If thmIndividual.Bins(iCntr).Value = dr("IndividualValue") Then
                                    framColor = IntegerToColor(dr(IOSThematicKeys.REGION_TRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
                                    framColorBorder = IntegerToColor(dr(IOSThematicKeys.REGION_BORDER_LINETRANSPARENCY), dr(IOSThematicKeys.REGION_COLOR))
                                    Dim mtb As ModifierThemeBin = thmIndividual.Bins(iCntr)
                                    mtb.Style.ApplyStyle(New AreaStyle(New SimpleLineStyle(New LineWidth(dr(IOSThematicKeys.REGION_BORDER_LINEWIDTH), 0), 0, framColorBorder, False), New SimpleInterior(dr(IOSThematicKeys.REGION_INTERIOR_TYPE), framColor)))
                                End If

                            Next
                        End If
                    Next

                End If



                '  thmIndividual.RecomputeStyles()
                lyr.Modifiers.Clear()

                Dim item As ToolStripMenuItem = CType(tlb_ParcelSelector.DropDownItems(2), ToolStripMenuItem)

                lyr.Modifiers.Append(thmIndividual)
                MapInfo.Mapping.LayerHelper.SetSelectable(lyr, item.Checked)
                Legend_CreateThematic(thmIndividual, themeExpression, lyr)
            Else
                lyr.Modifiers.Clear()
                SetStatus("Distinct Thematic field count cannnot be more than 500")
                thmIndividual = Nothing
            End If

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

