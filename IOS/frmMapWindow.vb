                                For i = 0 To tbl.TableInfo.Columns.Count - 1
                                    If tbl.TableInfo.Columns(i).DataType <> MapInfo.Data.MIDbType.FeatureGeometry And tbl.TableInfo.Columns(i).DataType <> MapInfo.Data.MIDbType.Style Then
