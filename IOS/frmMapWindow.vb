            Dim tblTemp1 As Table = MapInfo.Engine.Session.Current.Catalog.GetTable("Lines_SourceCells_Events")
            Dim lyr As FeatureLayer = MapControl1.Map.Layers("Lines_SourceCells_Events")
            'sql = "SELECT * FROM dbo.DT_Events WHERE EventID = " & EventID & " and dtid=" & dtid & ""
            'dt = DataAccessor.ExecuteDataTable(conn_IOSDriveTestModule, sql)
            If (dtEventFailurData IsNot Nothing) Then
                Dim rows() As DataRow = dtEventFailurData.AsEnumerable().Where(Function(x) x.Field(Of Integer)("eventid") = EventID AndAlso x.Field(Of Integer)("DTid") = dtid).ToArray()
                If (rows.Length > 0) Then
