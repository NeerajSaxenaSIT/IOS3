    Private Sub btnGenerateNetworks_Click(sender As Object, e As EventArgs) Handles btnGenerateNetworks.Click
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
            'Check if bold date has been selected from the calendar.
            Me.Refresh()
            mapLyrBounds.Clear()
            btnGenerateNetworks.Enabled = False
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()
            Dim dateSelected As Date
            dateSelected = Calendar_GetNetworks.SelectionStart.Date
            Dim index As Integer = lstNetworkDate.IndexOf(dateSelected)
            If NetworkArea_GetSelection() = "" Then
                lbl_GetNetworks_Status.Text = "Select at least 1 Network Area !"
                Exit Sub
            End If

            If index > -1 Then
                Dim dtMapConfigTemp As DataTable = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerTechnology") <> "TX").CopyToDataTable()

                For Each drow As DataRow In dtMapConfigTemp.Rows
                    Dim LayerInMarket As Boolean = False
                    If dtMapConfigTemp.Columns.Contains("Market") Then
                        For Each market As String In drow("Market").ToString.Split(",")
                            If NetworkArea_GetSelection().ToUpper.Contains(market.ToUpper) Or NetworkArea_GetSelection() = "ALL" Then
                                LayerInMarket = True
                            End If
                        Next
                        If LayerInMarket = True Then
                            LoadNetworks_Cells(dateSelected, drow)
                        End If
                    Else
                        LoadNetworks_Cells(dateSelected, drow)
                    End If
                Next

                Dim cols_distinct() As String = {"LayerTechnology"}
                Dim distinctLayerTechnology As DataTable = dt_Map_Configuration.DefaultView.ToTable(True, cols_distinct)
                For Each drow As DataRow In distinctLayerTechnology.Rows
                    LoadNetworks_Sites(dateSelected, drow)
                Next

                Dim dr_tx() As DataRow = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerTechnology") = "TX").ToArray()

                If dr_tx.Count > 0 Then
                    Dim dtMapConfigTempTx As DataTable = dt_Map_Configuration.AsEnumerable().Where(Function(x) x.Field(Of String)("LayerTechnology") = "TX").CopyToDataTable()

                    For Each drow As DataRow In dtMapConfigTempTx.Rows
                        Dim LayerInMarket As Boolean = False
                        If dtMapConfigTempTx.Columns.Contains("Market") Then
                            For Each market As String In drow("Market").ToString.Split(",")
                                If NetworkArea_GetSelection().ToUpper.Contains(market.ToUpper) Or NetworkArea_GetSelection() = "ALL" Then
                                    LayerInMarket = True
                                End If
                            Next
                            If LayerInMarket = True Then
                                LoadNetworks_Links(dateSelected, drow)
                            End If
                        Else
                            LoadNetworks_Links(dateSelected, drow)
                        End If
                    Next
                End If
            Else
                Me.Cursor = Cursors.Default
                SetStatus("Select BOLD date only")
                Exit Sub
            End If

            QuickLayerAlignWithWorkspace()
            cmb_FieldSearch_Refresh()

            Dim oDRect As DRect = Nothing
            For Each lyrName As KeyValuePair(Of String, DRect) In mapLyrBounds
                If oDRect = Nothing Then
                    oDRect = lyrName.Value
                Else
                    If oDRect.x1 < lyrName.Value.x1 Or oDRect.x2 < lyrName.Value.x2 Or oDRect.y1 < lyrName.Value.y1 Or oDRect.y2 < lyrName.Value.y2 Then
                        oDRect = lyrName.Value
                    End If
                End If
            Next

            If Not (oDRect = Nothing) Then
                MapControl1.Map.Bounds = oDRect
            End If

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            AttachAutoCompleteWithTextBox(txtSearchCell, "CELLID", cmbNetworkArea.SelectedItem.ToString)
            AttachAutoCompleteWithTextBox(txtSearchSiteID, "Sitecode", cmbNetworkArea.SelectedItem.ToString)
            btnGenerateNetworks.Enabled = True
            lbl_GetNetworks_Status.Text = "Finished !"
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

