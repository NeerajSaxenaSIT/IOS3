                'set view
                Dim thm As MapInfo.Mapping.Thematics.IndividualValueTheme = New MapInfo.Mapping.Thematics.IndividualValueTheme(lyr, "SEVERITY_IOS", "SEVERITY_IOS")
                thm.ApplyStylePart = Thematics.StylePart.All

                'This line changes the style of the first bin for region layer
