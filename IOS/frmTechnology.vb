                            Dim tabcontrol As DevExpress.XtraTab.XtraTabControl = GetTabControlFromTech(tech).TabPages(GetTabPageIndex(GetTabControlFromTech(tech), drObject("ObjectTab").ToString.Trim)).Controls(0)
