    Private Sub tsmi_ExportToKML_Click(sender As Object, e As EventArgs) Handles tsmi_ExportToKML.Click
        Dim IsSuccess As Boolean = True
        Try
            Dim savefiledialog1 As New SaveFileDialog()
            savefiledialog1.FileName = ""
            savefiledialog1.Filter = "Google Earth KML File |*.kml"
            If savefiledialog1.ShowDialog <> DialogResult.OK Then
                Exit Sub
            End If
            Dim fp As String = savefiledialog1.FileName

            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            Dim exportFields As String = ""
            Dim dtRow() As DataRow = Nothing
            Dim dgCtrl As GridControl = cmTopX.SourceControl
            Dim dtTopx As DataTable = dgCtrl.DataSource
            Dim dtKML As DataTable = dtTopx.Clone()

            Dim tech As String = dgCtrl.Tag.ToString.Replace("TopX_", "")
            Dim aggr_from As String = Nothing
            Dim sqlTopx As String = Nothing

            aggr_from = flpSourceBtn_GetChecked(dgCtrl.Tag.ToLower, flpCounterTypeTopX)(0).SourceButtonText
            sqlTopx = SQL_Construct_TopX(aggr_from, Nothing)

            ' getting export fields from kml export config table
            Dim dt As DataTable = clsSQLCommands.GetKmlExportFields(connStrIOSServer, tech, aggr_from)
            If dt IsNot Nothing Then
                If dt.Rows.Count > 0 Then
                    For Each drExpFld As DataRow In dt.Rows
                        exportFields &= drExpFld("EXPORTFIELDS") & ","
                        If Not dtKML.Columns.Contains(drExpFld("EXPORTFIELDS").ToString) Then
                            dtKML.Columns.Add(drExpFld("EXPORTFIELDS").ToString, GetType(String))
                            dtKML.Columns(drExpFld("EXPORTFIELDS").ToString).SetOrdinal(0)
                        End If

                    Next
                End If
            End If

            dtKML.Columns.Add("X", GetType(String))
            dtKML.Columns.Add("Y", GetType(String))

            dtKML.Columns("X").SetOrdinal(0)
            dtKML.Columns("Y").SetOrdinal(0)

            ' getting export fields data to generate kml file
            sqlTopx = "SELECT X, Y, " & exportFields & " " & LTrim(sqlTopx).Substring(7)
            sqlTopx = Replace(sqlTopx, " GROUP BY ", " GROUP BY X, Y, " & exportFields & " ")
            Dim dtSource As DataTable = DataAccessorODBC.GetDataTable(connectionString, sqlTopx)

            For Each dr As DataRow In dtTopx.Rows
                Dim drow As DataRow = dtKML.NewRow()
                For Each col As DataColumn In dtTopx.Columns
                    drow(col.ColumnName) = dr(col.ColumnName)
                Next
                dtRow = dtSource.AsEnumerable().Where(Function(x) x.Field(Of String)(aggr_from) = dr(aggr_from).ToString).ToArray()

                drow("X") = dtRow(0)("X").ToString
                drow("Y") = dtRow(0)("Y").ToString

                ' Add export column rows
                If exportFields <> "" Then
                    Dim expFlds() As String = exportFields.TrimEnd(",").Split(",")
                    For Each str As String In expFlds
                        drow(str) = dtRow(0)(str).ToString
                    Next
                End If

                dtKML.Rows.Add(drow)
            Next

            ' generate kml file
            ExportToKML(dtKML, fp, tech, exportFields.TrimEnd(","))

            dtTopx = Nothing
            dtKML = Nothing
            dtSource = Nothing
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Application.DoEvents()
            IsSuccess = False
        Finally
            Me.Cursor = Cursors.Default
            Application.DoEvents()
            If IsSuccess = False Then
                MsgBox("Export False", MsgBoxStyle.Exclamation, "Exporting TopX Grid to KML")
            Else
                MsgBox("Export Completed", MsgBoxStyle.Information, "Exporting TopX Grid to KML")
            End If
        End Try
    End Sub

    Private Sub ExportToKML(ByRef dt As DataTable, fileName As String, tech As String, fields As String)
        Dim kmlout As New XmlTextWriter(fileName, System.Text.Encoding.UTF8)
        kmlout.WriteStartDocument()
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteStartElement("kml")
        kmlout.WriteAttributeString("xmlns", "http://www.opengis.net/kml/2.2")
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteStartElement("Document")
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteStartElement("Style")
        kmlout.WriteAttributeString("id", "cellIcon")
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteStartElement("IconStyle")
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteStartElement("Icon")
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteElementString("href", "http://maps.google.com/mapfiles/kml/pal4/icon51.png")
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteEndElement()
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteEndElement()
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteEndElement()
        kmlout.WriteWhitespace(vbCrLf)
        ' Writing placemark 
        WriteKMLPlacemark(kmlout, dt, tech, fields)
        kmlout.WriteEndElement()
        kmlout.WriteWhitespace(vbCrLf)
        kmlout.WriteEndDocument()
        kmlout.Flush()
    End Sub

    Sub WriteKMLPlacemark(ByRef kmlout As XmlTextWriter, ByRef dt As DataTable, tech As String, fields As String)
        Dim sbDesc As System.Text.StringBuilder

        For Each dr As DataRow In dt.Rows
            sbDesc = New System.Text.StringBuilder
            sbDesc.AppendLine("<table border='1' style='font-family:Arial,Verdana,Times;font-size:12px;text-align:left;width:100%;border-color:#666666;border-collapse:collapse;border-spacing:0px;padding:3px 3px 3px 3px'>")

            kmlout.WriteStartElement("Placemark")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("name", dr(fields.Split(",")(0)).ToString)
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("description")
            kmlout.WriteWhitespace(vbCrLf)

            Dim expFlds() As String = fields.Split(",")
            For Each str As String In expFlds
                sbDesc.AppendLine("<tr><td>" & str & "</td><td>" & dr(str).ToString & "</td></tr>")
            Next

            For Each col As DataColumn In dt.Columns
                If col.DataType <> GetType(System.String) Then
                    sbDesc.AppendLine("<tr><td>" & dt.Columns(col.ColumnName).Caption.ToString & "</td><td>" & dr(col.ColumnName).ToString & "</td></tr>")
                End If
            Next

            sbDesc.AppendLine("</table>")
            kmlout.WriteCData(sbDesc.ToString())
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement() ' End Description
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("styleUrl", "#cellIcon")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteStartElement("Point")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("extrude", "1")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("altitudeMode", "relativeToGround")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteElementString("coordinates", dr("X").ToString & ", " & dr("Y").ToString & ", 0")
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement() ' End Point
            kmlout.WriteWhitespace(vbCrLf)
            kmlout.WriteEndElement() ' End Place Mark
            kmlout.WriteWhitespace(vbCrLf)
        Next
    End Sub

