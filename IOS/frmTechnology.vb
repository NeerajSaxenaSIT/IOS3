    Private Sub btnKPIFilterSave_Click(sender As Object, e As EventArgs) Handles btnKPIFilterSaveTopX.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Try
            Dim vbtn As SimpleButton = DirectCast(sender, SimpleButton)
            Dim tech As String = "TopX_" & vbtn.Tag
            Dim templatename As String = Nothing
            Dim result As Integer = 7
            If cmbTemplateTopX.SelectedItem.ToString <> "No Filter" Then
                result = XtraMessageBox.Show("Overwrite Selected Template?", "Template Saving", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question)
            End If

            If result = DialogResult.Cancel Then
                Exit Sub
            ElseIf result = DialogResult.No Then
                templatename = InputBox("Template Name: ", "Add Template", "")
            ElseIf result = DialogResult.Yes Then
                templatename = cmbTemplateTopX.SelectedItem.ToString
            End If

            If templatename = "" Or templatename = "No Filter" Then
                Exit Sub
            End If

            If templatename = "No Filter" Then
                MsgBox("No Filter is a reserved name")
                Exit Sub
            End If

            Dim indexOftemplate As Integer = -1
            For i = 0 To cmbTemplateTopX.Properties.Items.Count - 1
                If cmbTemplateTopX.Properties.Items(i).Text = templatename Then
                    indexOftemplate = i
                End If
            Next

            If indexOftemplate = -1 Then
                KPI_FilterTemplate_Add(templatename, tech)
                KPI_FilterTemplate_Reload(tech, indexOftemplate)
                indexOftemplate = cmbTemplateTopX.Properties.Items.IndexOf(templatename)

                For i = 0 To cmbTemplateTopX.Properties.Items.Count - 1
                    If cmbTemplateTopX.Properties.Items(i).text = templatename Then
                        indexOftemplate = i
                    End If
                Next
            End If

            'Dim templateid As Integer = TryCast(cmbTemplateTopX.SelectedItem, clsComboBoxItem).Value
            Dim templateid As Integer = TryCast(cmbTemplateTopX.Properties.Items(indexOftemplate), clsComboBoxItem).Value
            KPI_Filter_Delete(templateid)
            For Each nd As TreeListViewNode In tlvFiltersTopX.Nodes
                KPIFilterAdd(templateid, nd.Tag.ToString, nd.SubItems(0).Text, nd.SubItems(1).Text, nd.SubItems(2).Text)
            Next

            cmbTemplateTopX.SelectedItem = cmbTemplateTopX.Properties.Items(indexOftemplate)
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "TopX " & Network & " " & DateDiff(DateInterval.Second, timerTopX, Now()) & "s")
    End Sub

