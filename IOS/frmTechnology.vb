                        Else
                            sc(i).Visible = False
                            If Not HiddenSeriesCollectionStats.ContainsValue(sc(i).Name) Then
                                HiddenSeriesCollectionStats.Add(ch.Name, sc(i).Name)
                            End If
                        End If
                    Next
                    ch.SeriesCollection.Clear()
                    ch.SeriesCollection.Add(sc)

                    'HideChartScaleIfNoDataStats(ch, dt)

