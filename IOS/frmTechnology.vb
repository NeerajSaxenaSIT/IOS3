        SplitContainer_Stats.Panel2.Height = Math.Abs(SplitContainer_Stats.Height / 3)
        accPeriodSelectionStats.Tag = accPeriodSelectionStats.Height
        accObjectTreeStats.Tag = accObjectTreeStats.Height

        xtcTechnology.TabPages.Item(1).Text = "TopX - " & networkName
        SetVendorImages(Me.VendorName, xtcTechnology.TabPages.Item(1))
        ObjectTypesTopX = clsSQLCommands.GetObjectConfigurationData(connStrIOSServer, networkName, VendorName)
        KPITreeDataTopX = GetKPIDS(networkName, techlevel, EnumStatsOrTopX.TOPX)
        TreeVendorTopX = Me.VendorTopXDS
