    Private Sub tsmiGeoIDMapKPI_ItemClick(sender As System.Object, e As System.EventArgs)
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Dim tsmi As ToolStripMenuItem = CType(sender, ToolStripMenuItem)
        Dim dgCtrl As GridControl
        dgCtrl = cm_sourcecontrol
        Dim dgv As GridView = dgCtrl.MainView

        Dim tech As String = "CNE"
        Dim kpi As String = tsmi.Text

        Dim ds As DataSet = TechToDataSet(tech, "topx")
        Dim GeoIdColumnName As String = ""
        Try
            If Not ds Is Nothing Then
                Dim dt As DataTable = ds.Tables(0)
                Dim dt_filtered As DataTable = dt.Clone
                dt_filtered.Rows.Clear()

                For Each dc As DataColumn In dt_filtered.Columns
                    If dc.ColumnName.Length > 30 Then
                        If kpi = dc.ColumnName Then
                            kpi = dc.ColumnName.Substring(0, 29) + dc.Ordinal.ToString
                        End If
                        dc.ColumnName = dc.ColumnName.Substring(0, 29) + dc.Ordinal.ToString
                    End If
                    If dc.ColumnName.ToUpper.StartsWith("GEOID") Then
                        GeoIdColumnName = dc.ColumnName
                    End If
                Next

                'construct filter
                Dim selectedRows() As Integer = dgv.GetSelectedRows()
                For i As Integer = 0 To selectedRows.Length - 1
                    'get geoid
                    Dim geoid As String = dgv.GetRowCellValue(selectedRows(i), dgv.Columns(GeoIdColumnName)).ToString
                    Dim nr_filtered As DataRow = dt_filtered.NewRow
                    Dim nr As DataRow = dt.AsEnumerable().Where(Function(x) x.Field(Of String)(GeoIdColumnName) = geoid).ToArray()(0)
                    dt_filtered.ImportRow(nr)
                Next

                For Each dc As DataColumn In dt_filtered.Columns
                    If dc.ColumnName.ToUpper.Contains("GEOID") Then
                        dc.ColumnName = "GeoID"
                    End If
                Next
                SendToMap(tech, kpi, dt_filtered, TopXMapType, EnumSendToMap.FromGeoID, Nothing, Nothing, False, False, "TopX_GeoID_" & kpi & "_Map", "", tech)
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "TopX " & Network & " " & DateDiff(DateInterval.Second, timerTopX, Now()) & "s")
    End Sub

