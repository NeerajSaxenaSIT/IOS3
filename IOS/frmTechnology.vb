    Public Sub Charts_ResizeWidth()
        Me.SuspendLayout()
        Console.WriteLine("ChartResize!")
        Dim ch As Chart
        Dim i As Integer
        i = 0
        Try
            For i = 0 To tcTabControlHighTopX.TabPages.Count - 1
                tcTabControlHighTopX.TabPages(i).Width = tcTabControlHighTopX.Width
                If tcTabControlHighTopX.TabPages(i).Controls.Count > 0 Then
                    If tcTabControlHighTopX.TabPages(i).Controls(0).GetType() = GetType(XtraTabControl) Then
                        Dim tc As XtraTabControl = CType(tcTabControlHighTopX.TabPages(i).Controls(0), XtraTabControl)
                        For Each tp As XtraTabPage In tc.TabPages
                            If tp.Controls.Count > 0 Then
                                For Each ch In tp.Controls(0).Controls
                                    ch.Width = (tcTabControlHighTopX.TabPages(i).Width - 50)
                                Next
                            End If
                        Next
                    End If
                End If
            Next
            Dim tlpwidth As Integer = tcTabControlHighTopX.Width
            For Each tp As DevExpress.XtraTab.XtraTabPage In tcTabControlHighTopX.TabPages
                If tp.Controls.Count > 0 Then
                    Dim tlp As TableLayoutPanel = TryCast(tp.Controls(0), TableLayoutPanel)
                    If tlp IsNot Nothing Then
                        tlp.ColumnStyles(0).Width = Math.Max(tlpwidth / 2, 500)
                    End If
                End If
            Next
            tcTabControlHighTopX.Refresh()
            DataGrid_TopX.Width = tcTabControlHighTopX.Width - 30
        Catch ex As Exception
        End Try

        Try
            For i = 0 To tcTabControlHighStats.TabPages.Count - 1
                tcTabControlHighStats.TabPages(i).Width = tcTabControlHighStats.Width
                If tcTabControlHighStats.TabPages(i).Controls.Count > 0 Then
                    If tcTabControlHighStats.TabPages(i).Controls(0).GetType() = GetType(XtraTabControl) Then
                        Dim tc As XtraTabControl = CType(tcTabControlHighStats.TabPages(i).Controls(0), XtraTabControl)
                        For Each tp As XtraTabPage In tc.TabPages
                            If tp.Controls.Count > 0 Then
                                For Each ch In tp.Controls(0).Controls
                                    ch.Width = (tcTabControlHighStats.TabPages(i).Width - 50) / Me.seChartsPerRowStats.Value - ((seChartsPerRowStats.Value - 1) * 2)
                                Next
                            End If
                        Next
                    End If
                End If
            Next
            Dim tlpwidth As Integer = tcTabControlHighStats.Width
            For Each tp As DevExpress.XtraTab.XtraTabPage In tcTabControlHighStats.TabPages
                If tp.Controls.Count > 0 Then
                    Dim tlp As TableLayoutPanel = TryCast(tp.Controls(0), TableLayoutPanel)
                    If tlp IsNot Nothing Then
                        tlp.ColumnStyles(0).Width = Math.Max(tlpwidth / 2, 500)
                    End If
                End If
            Next
            tcTabControlHighStats.Refresh()
            gcChartsStats.Width = tcTabControlHighStats.Width - 30
        Catch ex As Exception
        End Try

        Me.ResumeLayout()
    End Sub

