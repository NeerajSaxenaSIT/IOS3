    Public Function PeriodCalcChartMarkerExists(amc As AxisMarkerCollection, am As AxisMarker) As Boolean
        For Each m As AxisMarker In amc

            '--- Case 1: Both are single-value markers ---
            If m.Value <> Nothing AndAlso am.Value <> Nothing Then
                If m.Value = am.Value Then
                    Return True
                End If
            End If

            '--- Case 2: Both are range markers (StartValue – EndValue) ---
            If (m.ValueLow IsNot Nothing AndAlso am.ValueLow IsNot Nothing) Then
                If (am.Value.GetType().Name = "Double") AndAlso (m.ValueLow.GetType().Name = "Double") AndAlso (m.ValueHigh.GetType().Name = "Double") Then
                    If m.ValueLow = am.ValueLow AndAlso m.ValueHigh = am.ValueHigh Then
                        Return True
                    End If
                ElseIf (m.Value.GetType().Name = "DateTime") AndAlso (am.Value.GetType().Name = "DateTime") Then
                    If m.ValueLow = am.ValueLow AndAlso m.ValueHigh = am.ValueHigh Then
                        Return True
                    End If
                End If
            End If

            '--- Optional: Compare label ---
            If Not String.IsNullOrEmpty(m.Label.Text) AndAlso Not String.IsNullOrEmpty(am.Label.Text) Then
                If m.Label.Text = am.Label.Text Then
                    Return True
                End If
            End If

        Next

        Return False
    End Function

    Public Function MergePrdCalcSeriesDataTables(ds As DataSet) As DataTable
        Try
            If ds Is Nothing OrElse ds.Tables.Count = 0 Then
                Throw New ArgumentException("Dataset has no tables.")
            End If

            ' Step 1: Collect all unique dates across all tables
            Dim allDates = ds.Tables.Cast(Of DataTable)().
                        SelectMany(Function(t) t.AsEnumerable().Select(Function(r) r.Field(Of DateTime)("Date"))).
                        Distinct().
                        OrderBy(Function(d) d)

            ' Step 2: Create merged DataTable
            Dim dtMerged As New DataTable("Merged")
            dtMerged.Columns.Add("Date", GetType(DateTime))

            ' Add all numeric columns from each table
            Dim tblIndex As Integer = 1
            For Each t As DataTable In ds.Tables
                For Each col As DataColumn In t.Columns
                    If col.ColumnName <> "Date" Then
                        Dim newColName = col.ColumnName
                        ' Ensure column names are unique
                        If dtMerged.Columns.Contains(newColName) Then
                            newColName = $"{col.ColumnName}_{tblIndex}"
                        End If
                        dtMerged.Columns.Add(newColName, GetType(Double))
                    End If
                Next
                tblIndex += 1
            Next

            ' Step 3: Populate rows
            For Each d In allDates
                Dim newRow = dtMerged.NewRow()
                newRow("Date") = d

                Dim tblCount As Integer = 1
                For Each t As DataTable In ds.Tables
                    For Each col As DataColumn In t.Columns
                        If col.ColumnName <> "Date" Then
                            Dim newColName = col.ColumnName
                            If dtMerged.Columns.Contains(newColName & "_" & tblCount) Then
                                newColName &= "_" & tblCount
                            End If
                            Dim match = t.AsEnumerable().FirstOrDefault(Function(r) r.Field(Of DateTime)("Date") = d)
                            If match IsNot Nothing Then
                                Dim val = match(col.ColumnName)
                                If val IsNot DBNull.Value AndAlso Not IsNothing(val) Then
                                    newRow(newColName) = Convert.ToDouble(val)
                                End If
                            End If
                        End If
                    Next
                    tblCount += 1
                Next

                dtMerged.Rows.Add(newRow)
            Next

            Return dtMerged
        Catch
        End Try
    End Function

    Public Function PeriodCalculation(ByRef dt As DataTable, ByVal inputDates As DataTable, ByRef ChartELements As String()) As DataTable
        Try
            If dt Is Nothing OrElse dt.Rows.Count = 0 Then Return Nothing

            Dim dateColumnName As String = "Date"
            Dim columnPrefix As String = "PeriodCalc_"

            ' Earliest DateTime in the dataset (keep time component)
            Dim datasetStart As DateTime =
            dt.AsEnumerable().Select(Function(r) r.Field(Of DateTime)(dateColumnName)).Min()

            If inputDates.Rows.Count = 0 Then Return Nothing

            Dim ChartElements_Original As String() = ChartELements

            inputDates.DefaultView.Sort = "PeriodStart ASC"
            Dim inputDates_Sorted = inputDates.DefaultView.ToTable

            Dim prev As DateTime = datasetStart.AddMinutes(-1)

            Dim dt_period_summary As New DataTable
            dt_period_summary.Columns.Add("PeriodName", GetType(System.String))
            dt_period_summary.Columns.Add("KPIName", GetType(System.String))
            dt_period_summary.Columns.Add("AVG", GetType(System.Double))
            dt_period_summary.Columns.Add("MIN", GetType(System.Double))
            dt_period_summary.Columns.Add("MAX", GetType(System.Double))
            dt_period_summary.Columns.Add("STDEV", GetType(System.Double))
            dt_period_summary.Columns.Add("COUNT", GetType(System.Double))
            dt_period_summary.Columns.Add("MEDIAN", GetType(System.Double))
            dt_period_summary.Columns.Add("P90", GetType(System.Double))
            dt_period_summary.Columns.Add("P10", GetType(System.Double))

            For Each cur As DataRow In inputDates_Sorted.Rows
                ' Column name shown with your preferred format (to the minute)
                For Each KPIName As String In ChartElements_Original
                    Try
                        '    Dim colName As String = columnPrefix & "_" & KPIName & "_" & cur("PeriodName")
                        '    If dt.Columns.Contains(colName) Then dt.Columns.Remove(colName)

                        '    Dim col As New DataColumn(colName, GetType(Double)) With {
                        '    .AllowDBNull = True,
                        '    .DefaultValue = DBNull.Value
                        '}
                        '    dt.Columns.Add(col)


                        'ReDim Preserve ChartELements(ChartELements.Length)
                        'ChartELements(ChartELements.Length - 1) = colName

                        ' RowFilter must use US-style date literals with #...#.
                        ' Window: (prev, cur]  →  [Date] > prev AND [Date] <= cur

                        If dt.Columns(KPIName).DataType <> GetType(String) Then

                            Dim prevDate As DateTime = CDate(cur("PeriodStart"))
                            Dim curDate As DateTime = CDate(cur("PeriodEnd")).AddDays(1)

                            Dim prevStrForFilter As String = prevDate.ToString("MM\/dd\/yyyy HH:mm:ss", Globalization.CultureInfo.InvariantCulture)
                            Dim curStrForFilter As String = curDate.ToString("MM\/dd\/yyyy HH:mm:ss", Globalization.CultureInfo.InvariantCulture)

                            Dim filter As String = String.Format(Globalization.CultureInfo.InvariantCulture, "[{0}] >= #{1}# AND [{0}] < #{2}#", dateColumnName, prevStrForFilter, curStrForFilter)

                            ' Average ignores DBNulls
                            Dim avgObj As Object = dt.Compute($"AVG([{KPIName}])", filter)
                            Dim minObj As Object = dt.Compute($"MIN([{KPIName}])", filter)
                            Dim maxObj As Object = dt.Compute($"MAX([{KPIName}])", filter)
                            Dim stdObj As Object = dt.Compute($"STDEV([{KPIName}])", filter)
                            Dim countObj As Object = dt.Compute($"COUNT([{KPIName}])", filter)

                            'median
                            Dim medianObj As Object
                            Dim dr() As DataRow = dt.AsEnumerable().Where(Function(n)
                                                                              Dim rowDate = n.Field(Of DateTime)("Date")
                                                                              Return rowDate >= prevDate AndAlso rowDate < curDate
                                                                          End Function).OrderBy(Function(n) n.Field(Of Object)(KPIName)).ToArray()

                            If dr.Length > 0 Then

                                Try
                                    If dr.Count Mod 2 = 0 Then
                                        medianObj = (dr(((dr.Count) / 2) - 1)(KPIName) + dr(((dr.Count) / 2))(KPIName)) / 2
                                    Else
                                        medianObj = dr((dr.Count - 1) / 2)(KPIName)
                                    End If
                                Catch
                                End Try

                                'percentile
                                Dim p90 As Object
                                p90 = PercentileCalculation(dr.CopyToDataTable, KPIName, 90)

                                Dim p10 As Object
                                p10 = PercentileCalculation(dr.CopyToDataTable, KPIName, 10)

                                'If avgObj IsNot DBNull.Value Then
                                '    Dim avg As Double = Convert.ToDouble(avgObj, Globalization.CultureInfo.InvariantCulture)
                                '    For Each r In dt.Select(filter)
                                '        '   r(colName) = avg
                                '        r(colName) = r(KPIName)
                                '    Next
                                'End If

                                Dim nr As DataRow = dt_period_summary.NewRow
                                nr("PeriodName") = cur("PeriodName")
                                nr("KPIName") = KPIName
                                nr("AVG") = avgObj
                                nr("MIN") = minObj
                                nr("MAX") = maxObj
                                nr("STDEV") = stdObj
                                nr("COUNT") = countObj
                                nr("MEDIAN") = medianObj
                                nr("P90") = p90
                                nr("P10") = p10

                                dt_period_summary.Rows.Add(nr)

                            End If
                        End If
                    Catch ex As Exception
                        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
                    End Try
                Next
            Next

            Return dt_period_summary
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Function

    Public Function PercentileCalculation(dt As DataTable, columnName As String, ptile As Double) As Double
        Try
            ' Get non-null numeric values
            Dim values = dt.AsEnumerable().
            Where(Function(r) Not r.IsNull(columnName)).
            Select(Function(r) Convert.ToDouble(r(columnName))).
            OrderBy(Function(v) v).
            ToArray()

            If values.Count = 0 Then
                Console.WriteLine("No data available to calculate percentile.")
            Else
                ' Percentile position (0-based index)
                Dim position As Double = (ptile / 100) * (values.Length - 1)
                Dim lowerIndex As Integer = Math.Floor(position)
                Dim upperIndex As Integer = Math.Ceiling(position)

                ' Linear interpolation between nearest ranks
                If lowerIndex = upperIndex Then
                    Return values(lowerIndex)
                Else
                    Dim fraction As Double = position - lowerIndex
                    Return values(lowerIndex) + fraction * (values(upperIndex) - values(lowerIndex))
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Function

    Private Sub LoadPeriodCalculationData()
        Try
            Dim NumOfPeriods As Integer = dtPrdCalcStats.Rows.Count
            Dim distinctPeriods = dtPrdCalcStats.AsEnumerable().Select(Function(r) r.Field(Of String)("PeriodName")).Distinct().ToList()
            Dim dtMerged As DataTable = Nothing

            RemoveHandler gvPrdCalcCompStats.FocusedRowChanged, AddressOf gvPrdCalcCompStats_FocusedRowChanged
            IOSDevExpressGrid.ClearGrid(gcPrdCalcCompStats)

            If NumOfPeriods = 1 Then
                dtMerged = MergeDataTables(dicPrdCalcData)
                IOSDevExpressGrid.PopulateDataInGrid(gcPrdCalcCompStats, gvPrdCalcCompStats, dtMerged, "ALL")
            ElseIf NumOfPeriods = 2 Then

                Dim p1_date As String = ""
                Dim p2_date As String = ""
                Try
                    p1_date = CDate(dtPrdCalcStats(0)("PeriodStart")).ToString("yyy-MM-dd", Globalization.CultureInfo.InvariantCulture) & " to " & CDate(dtPrdCalcStats(0)("PeriodEnd")).ToString("yyy-MM-dd", Globalization.CultureInfo.InvariantCulture)
                    p2_date = CDate(dtPrdCalcStats(1)("PeriodStart")).ToString("yyy-MM-dd", Globalization.CultureInfo.InvariantCulture) & " to " & CDate(dtPrdCalcStats(1)("PeriodEnd")).ToString("yyy-MM-dd", Globalization.CultureInfo.InvariantCulture)

                Catch ex As Exception

                End Try

                Dim dtMerge1 As New DataTable
                Dim dtMerge2 As New DataTable

                Dim dtMergeFinal As New DataTable
                dtMergeFinal.Columns.Add(distinctPeriods(0) & "_Dates", GetType(String))
                dtMergeFinal.Columns.Add(distinctPeriods(1) & "_Dates", GetType(String))

                dtMergeFinal.Columns.Add("KPIName", GetType(String))
                dtMergeFinal.Columns.Add("CalculationType", GetType(String))
                dtMergeFinal.Columns.Add(distinctPeriods(0), GetType(String))
                dtMergeFinal.Columns.Add(distinctPeriods(1), GetType(String))
                dtMergeFinal.Columns.Add("Delta", GetType(Double))
                dtMergeFinal.Columns.Add("DeltaPercentage", GetType(Double))

                If dicPrdCalcData.Count > 0 Then

                    For Each kvp In dicPrdCalcData

                        dtMerge1 = Nothing
                        dtMerge2 = Nothing
                        Dim dt As DataTable = kvp.Value

                        If dt IsNot Nothing Then
                            Dim excludeCols() As String = {"PeriodName", "KPIName"}
                            Dim CalcTypeCols = dt.Columns.Cast(Of DataColumn)().Where(Function(c) Not excludeCols.Contains(c.ColumnName)).Select(Function(c) c.ColumnName).ToList()

                            dtMerge1 = dt.AsEnumerable().Where(Function(x) x.Field(Of String)("PeriodName") = distinctPeriods(0)).CopyToDataTable
                            dtMerge2 = dt.AsEnumerable().Where(Function(x) x.Field(Of String)("PeriodName") = distinctPeriods(1)).CopyToDataTable

                            For Each drMerge1 As DataRow In dtMerge1.Rows
                                For Each calcType In CalcTypeCols
                                    Dim drMergeFnial As DataRow = dtMergeFinal.NewRow()
                                    If dtMerge1.Columns.Contains(calcType) Then

                                        drMergeFnial(distinctPeriods(0) & "_Dates") = p1_date
                                        drMergeFnial(distinctPeriods(1) & "_Dates") = p2_date

                                        drMergeFnial("KPIName") = drMerge1("KPIName").ToString
                                        drMergeFnial("CalculationType") = calcType.ToString
                                        drMergeFnial(distinctPeriods(0)) = Math.Round(CDbl(drMerge1(calcType)), 2)
                                        Dim drMerge2 As DataRow = dtMerge2.Select("KPIName='" & drMerge1("KPIName").ToString & "'")(0)
                                        drMergeFnial(distinctPeriods(1)) = Math.Round(CDbl(drMerge2(calcType)), 2)
                                        drMergeFnial("Delta") = Math.Round(CDbl(drMerge2(calcType)) - CDbl(drMerge1(calcType)), IIf(drMergeFnial("KPIName").ToLower.Contains("rat"), 2, 1))
                                        drMergeFnial("DeltaPercentage") = Math.Round(100 * (CDbl(drMerge2(calcType)) - CDbl(drMerge1(calcType))) / CDbl(drMerge1(calcType)), IIf(drMergeFnial("KPIName").ToLower.Contains("rat"), 2, 1))
                                    End If
                                    dtMergeFinal.Rows.Add(drMergeFnial)
                                Next
                            Next
                        End If

                    Next

                    IOSDevExpressGrid.PopulateDataInGrid(gcPrdCalcCompStats, gvPrdCalcCompStats, dtMergeFinal, "ALL")

                    If gvPrdCalcCompStats.RowCount > 0 Then

                        gvPrdCalcCompStats.Columns("CalculationType").FilterInfo = New DevExpress.XtraGrid.Columns.ColumnFilterInfo("[CalculationType]='" & cmbPrdCalcStats.Text.ToUpper & "'")
                        gvPrdCalcCompStats.BeginSort()

                        Try
                            gvPrdCalcCompStats.ClearSorting()
                            gvPrdCalcCompStats.Columns("DeltaPercentage").SortOrder = DevExpress.Data.ColumnSortOrder.Descending
                            gvPrdCalcCompStats.TopRowIndex = 0
                            gvPrdCalcCompStats.FocusedRowHandle = 0
                        Finally
                            gvPrdCalcCompStats.EndSort()
                        End Try

                        gvPrdCalcCompStats.BestFitColumns()

                        dtMerge1 = Nothing
                        dtMerge2 = Nothing

                    End If
                End If
            End If
            AddHandler gvPrdCalcCompStats.FocusedRowChanged, AddressOf gvPrdCalcCompStats_FocusedRowChanged
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

