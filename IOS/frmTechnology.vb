    Private Sub gvEvalTimeBased_RowCellStyle(sender As Object, e As RowCellStyleEventArgs)
        Try
            If Not dtThresholdSetForKPI Is Nothing Then
                Dim drThreshold As DataRow = Nothing
                Dim clrTrans As Integer = 120
                Dim colsNoColoring() As String = {"CategoryField", "Tech", "SQLKPIID", "KPIName", "Category"}

                If e IsNot Nothing Then
                    Dim key As Cell = New Cell With {
                        .rowHandle = e.RowHandle,
                        .fieldName = e.Column.FieldName
                    }

                    If dicCellClrTB.ContainsKey(key) Then
                        e.Appearance.BackColor = dicCellClrTB(key)
                    Else
                        Dim kpiSqlID As Integer = IIf(IsDBNull(gvEvalTimeBased.GetRowCellValue(e.RowHandle, "SQLKPIID")), 0, gvEvalTimeBased.GetRowCellValue(e.RowHandle, "SQLKPIID"))
                        If kpiSqlID <> 0 Then
                            drThreshold = gvThresholdData.GetDataRow(gvThresholdData.LocateByValue("SQLKPIID", kpiSqlID))
                        End If

                        'for vendor kpi(s)
                        Dim kpiName As String = Nothing
                        Dim commonKpiName As String = Nothing
                        If drThreshold Is Nothing Then
                            If gvEvalTimeBased.GetRowCellValue(e.RowHandle, "KPIName").ToString.ToUpper.Contains("ERICSSON") Then
                                kpiName = gvEvalTimeBased.GetRowCellValue(e.RowHandle, "KPIName").ToString
