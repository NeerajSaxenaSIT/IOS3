    Public Sub ProcessStatsCompareOverlapTime_Custom(tech As String, ds As DataSet, constr As String, chart_name As String, chart_set_name As String, objectType As String, ByRef ch As Chart, Optional objectName As String = "")
        Try
            System.Threading.Thread.CurrentThread.CurrentCulture = CultureInfoDefault
            System.Threading.Thread.CurrentThread.CurrentUICulture = CultureUIDefault

            Dim dt_new As New DataTable
            Dim dtOverlapSet As New DataTable
            Dim KPIname As String = Nothing

            Dim ds_chart As DataSet = clsSQLCommands.GetDataAssignToCustomChart(constr, tech, chart_name, chart_set_name, objectType)
            Dim dt_chart As DataTable = ds_chart.Tables(0)
            KPIname = dt_chart.Rows(0).Item("ChartElements")

            For Each dt As DataTable In ds.Tables
                If dt.Columns.Contains(KPIname) Then
                    Dim displayView = New DataView(dt)
                    dt_new = displayView.ToTable(False, "Date", KPIname).Copy
                End If
            Next

            Dim intervalValue As Integer = CType(cmbAlignIntervalStats.SelectedItem, clsComboBoxItem).Value
            Dim intervalText As String = cmbAlignIntervalStats.SelectedItem.ToString.Split(" ")(1)

            dtOverlapSet.Columns.Add(New DataColumn("Date", GetType(DateTime)))
            dtOverlapSet.Columns.Add(New DataColumn(KPIname & "_Current" & intervalText, GetType(Double)))
            dtOverlapSet.Columns.Add(New DataColumn(KPIname & "_Last" & intervalText, GetType(Double)))

            If Not dt_new Is Nothing Then
                If dt_new.Rows.Count > 1 Then

                    'handling case for raw/hourly data...
                    If (rdoHourlyStats.Checked) Then
                        dt_new = AddLastDateMissingHoursToDatatable(dt_new)
                    ElseIf (rdoRawStats.Checked) Then
                        dt_new = AddLastDateMissingRawHoursToDatatable(dt_new)
                    End If

                    Dim dtReverse As DataTable = dt_new.AsEnumerable().Reverse().CopyToDataTable
                    For Each dr As DataRow In dtReverse.Rows
                        If dtReverse.Select("Date='" & CDate(dr("Date")).AddDays(-intervalValue) & "'").Length > 0 Then
                            Dim dr1stSet As DataRow = dtOverlapSet.NewRow()
                            dr1stSet("Date") = dr("Date")
                            dr1stSet(KPIname & "_Current" & intervalText) = dr(KPIname)

                            Dim lastWeekKPIVal As Double = dtReverse.Select("Date='" & CDate(dr("Date")).AddDays(-intervalValue) & "'")(0)(KPIname)
                            dr1stSet(KPIname & "_Last" & intervalText) = lastWeekKPIVal
                            dtOverlapSet.Rows.Add(dr1stSet)
                        End If
                    Next
                End If
                AssignDataToCompareOverlapTime_Custom(dtOverlapSet, constr, tech, chart_name, ch, objectName)
            End If
        Catch ex As Exception
        End Try
    End Sub

    Private Function AddLastDateMissingHoursToDatatable(dt As DataTable) As DataTable
        Dim maxDate As DateTime = dt.AsEnumerable().Max(Function(row) row.Field(Of DateTime)("Date"))
        Dim lastDateOnly As Date = maxDate.Date

        Dim existingHours = dt.AsEnumerable().
        Where(Function(r) r.Field(Of DateTime)("Date").Date = lastDateOnly).
        Select(Function(r) r.Field(Of DateTime)("Date").Hour).
        ToList()

        For hour As Integer = 0 To 23
            If Not existingHours.Contains(hour) Then
                Dim newRow As DataRow = dt.NewRow()
                newRow("Date") = lastDateOnly.AddHours(hour)
                newRow(dt.Columns(1).ColumnName) = DBNull.Value
                dt.Rows.Add(newRow)
            End If
        Next

        dt.DefaultView.Sort = "Date ASC"
        dt = dt.DefaultView.ToTable()
        Return dt
    End Function

    Private Function AddLastDateMissingRawHoursToDatatable(dt As DataTable) As DataTable
        Dim maxDate As DateTime = dt.AsEnumerable().Max(Function(row) row.Field(Of DateTime)("Date"))
        Dim lastDateOnly As Date = maxDate.Date

        Dim existingHours = dt.AsEnumerable().
        Where(Function(r) r.Field(Of DateTime)("Date").Date = lastDateOnly).
        Select(Function(r) r.Field(Of DateTime)("Date").Hour * 60 + r.Field(Of DateTime)("Date").Minute).
        ToList()

        For minutesForRawHours As Integer = 0 To (24 * 60 - 15) Step 15
            If Not existingHours.Contains(minutesForRawHours) Then
                Dim newRow As DataRow = dt.NewRow()
                newRow("Date") = lastDateOnly.AddMinutes(minutesForRawHours)
                newRow(dt.Columns(1).ColumnName) = DBNull.Value
                dt.Rows.Add(newRow)
            End If
        Next

        dt.DefaultView.Sort = "Date ASC"
        dt = dt.DefaultView.ToTable()
        Return dt
    End Function

