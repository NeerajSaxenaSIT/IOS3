    Private Sub ChartSetName_Changed(sender As Object, e As EventArgs)
        Try
            RemoveHandler cmbChartSetNameStats.SelectedIndexChanged, AddressOf ChartSetName_Changed
            RemoveHandler cmbChartSetNameTopX.SelectedIndexChanged, AddressOf ChartSetName_Changed

            Dim cmb As ComboBoxEdit = TryCast(sender, ComboBoxEdit)
            Dim selectedVal As String = cmb.SelectedItem.ToString

            If cmb.SelectedIndex <> 0 Then
                'Reload KPI tree data
                IOS_KPITrees_Load(_strNetwork, selectedVal)

                'Stats
                Dim tabcontrol As DevExpress.XtraTab.XtraTabControl = GetTabControlFromTech(_strNetwork)
                tabcontrol.TabPages.Clear()
                tabcontrol.TabPages.Add("TBD")

                SetComboBox(cmbChartSetNameStats, ComboSelectBased.TextBased, selectedVal)
                KPITreeStatsDS = frmMDI.GetKPITreeByTecnology(BaseTechnology, EnumStatsOrTopX.STATS)
                KPITreeDataStats = GetKPIDS(_strNetwork, _techInternal, EnumStatsOrTopX.STATS)
                If selectedVal <> chartSetName Then
                    Dim _dtTreeKPIStats As DataTable = KPITreeDataStats.Tables(0).AsEnumerable().Where(Function(x) x.Field(Of String)("ChartSetName") = selectedVal).CopyToDataTable()
                    _dsTreeKPIStats.Tables.Remove(_dsTreeKPIStats.Tables(0))
                    _dsTreeKPIStats.Tables.Add(_dtTreeKPIStats)
                End If
                tvKPIStats.Nodes.Clear()
                BindKPITreeViewStats(_strNetwork)

                'Select KPIs for toggled counter type only
                For Each tblBtn As IOS.Library.IOSToggleButton In flpCounterTypeStats.Controls
                    If tblBtn.ToggleState = CheckState.Checked Then
                        flpSourceBtn_ToggleChanges(tblBtn, Nothing)
                    End If
                Next

                'TopX
                SetComboBox(cmbChartSetNameTopX, ComboSelectBased.TextBased, selectedVal)
                KPITreeTopXDS = frmMDI.GetKPITreeByTecnology(BaseTechnology, EnumStatsOrTopX.TOPX)
                KPITreeDataTopX = GetKPIDS(_strNetwork, _techInternal, EnumStatsOrTopX.TOPX)
                Try
                    If selectedVal <> chartSetName Then
                        Dim _dtTreeKPITopX As DataTable = KPITreeDataTopX.Tables(0).AsEnumerable().Where(Function(x) x.Field(Of String)("ChartSetName") = selectedVal).CopyToDataTable()
                        _dsKPITreeTopX.Tables.Remove(_dsKPITreeTopX.Tables(0))
                        _dsKPITreeTopX.Tables.Add(_dtTreeKPITopX)
                    End If
                Catch
                End Try
                tvKPITopX.Nodes.Clear()
                BindKPITreeViewTopX(_strNetwork)
            Else
                SetComboBox(cmbChartSetNameStats, ComboSelectBased.TextBased, "Select")
                tvKPIStats.Nodes.Clear()
                SetComboBox(cmbChartSetNameTopX, ComboSelectBased.TextBased, "Select")
                tvKPITopX.Nodes.Clear()
            End If

        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        Finally
            AddHandler cmbChartSetNameStats.SelectedIndexChanged, AddressOf ChartSetName_Changed
            AddHandler cmbChartSetNameTopX.SelectedIndexChanged, AddressOf ChartSetName_Changed
        End Try
    End Sub

    Public Function GetKPIDS(networkName As String, dsName As String, statsOrTopX As EnumStatsOrTopX) As DataSet
        If (statsOrTopX = EnumStatsOrTopX.STATS) Then
            If Me.KPITreeStatsDS.ContainsKey(dsName) Then
                Return Me.KPITreeStatsDS.Item(dsName)
            Else
                Return Nothing
            End If
        ElseIf (statsOrTopX = EnumStatsOrTopX.TOPX) Then
            If Me.KPITreeTopXDS.ContainsKey(dsName) Then
                Return Me.KPITreeTopXDS.Item(dsName)
            Else
                Return Nothing
            End If
        Else
            Return Nothing
        End If
    End Function

