                                'getting threshold and evaluation period sql
                                sourcetable = nZ(dr.GetValue(0).ToString.Trim, "")
                                joinobjects = nZ(dr.GetValue(1).ToString.Trim, "")
                                sql_crosstabobj.Add(nZ(dr.Item("CrossTabObj"), "").ToString.Trim)
                                sql_obj.Add(cm_Chart_kpiname)
                                aggr_from = nZ(dr.GetValue(3).ToString.Trim, "")

                                If dtPrdCalcStats.Rows.Count = 1 Then
                                    sql_all.Add(SQL_Construct_ObjectTime_PrdCalc(aggr_from, sourcetable, cm_Chart_kpiname, dtPrdCalcStats.Rows(0)("PeriodName")))
                                ElseIf dtPrdCalcStats.Rows.Count = 2 Then
                                    sql_all.Add(SQL_Construct_ObjectTime_PrdCalc(aggr_from, sourcetable, cm_Chart_kpiname, dtPrdCalcStats.Rows(0)("PeriodName"), dtPrdCalcStats.Rows(1)("PeriodName")))
                                End If

                                lst_sqlCounterTypes.Add(dr("Object").ToString)
                            End If
                        End While
                    End Using
                End Using
            End Using

            If sql_all.Count = 0 Then
                btnApplyStats.PerformClick()
                Exit Sub
            End If

            connstring = connectionString
            Threads_Fired = 0
            dsPrdCalc_Histogram = New DataSet()
            ds_prdcalc_hist_list.Clear()
            t_list_prdcalc.Clear()
            mm.ReleaseMemory()

            '*****************************
            For Each sql_to_fire As String In sql_all
                Dim prdcalc_t As New Thread_Stats
                prdcalc_t.connstring = connstring
                prdcalc_t.sql_total = sql_to_fire
                prdcalc_t.ds_name = sql_obj(Threads_Fired)
                AddHandler prdcalc_t.ThreadComplete, AddressOf Process_PrdCalc_ObjectTime_ThreadEnd

                Dim thread_x = New Threading.Thread(AddressOf prdcalc_t.GetData)
                thread_x.Start()
                t_list_prdcalc.Add(thread_x)
                Threads_Fired = Threads_Fired + 1
            Next

            lblObjTreeStatusStats.Text = "Query Started..."
            lblObjTreeStatusStats.ForeColor = Color.Black

        Catch ex As Exception
            lblObjTreeStatusStats.Text = "Failed...Try Again"
            lblObjTreeStatusStats.ForeColor = Color.Red
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
        End Try
    End Sub

    Private Function SQL_Construct_ObjectTime_PrdCalc(objtype As String, aliastable As String, kpiname As String, calcPeriod As String, Optional calcperiod2 As String = Nothing) As String
        Dim tech As String = _strNetwork
        Dim sql_select As String = Nothing
        Dim sql_where_misc As String = ""
        Dim sql_where_object As String = ""
        Dim sql_where_tables As String = ""
        Dim sql_where_period As String = ""
        Dim sql_where_period2 As String = ""
        Dim sql_where_paramfilter As String = ""
        Dim sql_groupby As String = Nothing
        Dim sql_orderby As String = Nothing
        Dim sql_from_time As String = Nothing
        Dim sql_kpi As String = Nothing
        Dim sql_total As String = Nothing
        Dim aggr_from As String = Nothing
        'setting fixed time interval of 8 days
        Dim startdate As Date = Nothing
        Dim enddate As Date = Nothing
        startdate = dtEditStartTimeStats.EditValue
        enddate = dtEditEndTimeStats.EditValue

        Dim startdate_string As String = Chr(39) & startdate.ToString("yyyy-MM-dd HH:mm") & Chr(39)
        Dim enddate_string As String = Chr(39) & enddate.ToString("yyyy-MM-dd HH:mm") & Chr(39)
        Dim startdate_string2 As String = Chr(39) & startdate.ToString("yyyy-MM-dd HH:mm") & Chr(39)
        Dim enddate_string2 As String = Chr(39) & enddate.ToString("yyyy-MM-dd HH:mm") & Chr(39)
        Dim filterPeriodstring As String = GetFilterPeriodStats(cmbPredefinedFilterStats, dateNavigatorStats)
        Dim conn_el As Odbc.OdbcConnection = Nothing
        Dim comm_sql As Odbc.OdbcCommand = Nothing
        Dim comm_Element As Odbc.OdbcCommand = Nothing
        Dim dr_sql As Odbc.OdbcDataReader = Nothing
        Dim dr_element As Odbc.OdbcDataReader = Nothing
        Dim sqlelement As String = Nothing
        Dim sql_sql As String = Nothing

        Try
            'Open connection to server
            conn_el = New Odbc.OdbcConnection(connStrIOSServer)
            conn_el.ConnectionTimeout = 5
            conn_el.Open()

            'if aliastable is nothing and chartname is not, then get the aliastable (used for sql building based on chart)

            'objecttree selection to string
            Dim objectsel As String = ""

            If Export2Excel = True Then
                Dim checkNodesCount As Integer = tvObjectsTreeStats.GetEndCheckedNodes().Count
                Dim totalNodesCount As Integer = tvObjectsTreeStats.GetNodeList().Where(Function(x) x.Nodes.Count = 0).Count
                If checkNodesCount = totalNodesCount And tvObjectsTreeStats.FindFilterText = "" Then
                    objectsel = ""
                Else
                    objectsel = tvObjectsTreeStats.GetChecked2String(tech, cmbObjectTreeStats.Text, "ObjectID", strTreeFilterStats)
                End If
            Else
                objectsel = tvObjectsTreeStats.GetChecked2String(tech, cmbObjectTreeStats.Text, "ObjectID", strTreeFilterStats)
                If cmbObjectTreeStats.Text = "PLMN" Then objectsel = "IN('PLMN')"
                If objectsel = "IN ()" Then
                    lblObjTreeStatusStats.Text = "Error Building Query ! No Objects ..."
                    lblObjTreeStatusStats.ForeColor = Color.Red
                    Return Nothing
                End If
                ObjectsCharted = tvObjectsTreeStats.GetChecked2String(tech, cmbObjectTreeStats.Text, "ObjectName", strTreeFilterStats).Substring(4).TrimEnd(")")

                If tsmi_ObjectAggregationOnOff.Checked = False Then
                    ObjectsCharted = "IN('" & CType(cm_Chart_Sourcecontrol, Chart).Title.Split("'")(1) & "')"
                    objectsel = ObjectsCharted
                End If
            End If

            'set aggr_to
            Dim aggr_to As String = cmbObjectTreeStats.Text

            Dim CMFilter As String = Nothing
            Dim tagid As String = Nothing
            Dim RegionFilter As String = ""
            If aggr_to = "TAGS" Then
                ObjectsCharted = tagid
                ' ObjectsCharted = tvObjectsTreeStats.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()(0).Item(2)
                'tagid = tvObjectsTreeStats.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()(0).Item(0)
                For Each tln As TreeListNode In tvObjectsTreeStats.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()
                    ObjectsCharted = ObjectsCharted + tln.Item(2) + ","
                    tagid = tagid + tln.Item(0) + ","
                Next
                tagid = "IN(" + tagid.TrimEnd(",") + ")"
                ObjectsCharted = ObjectsCharted.TrimEnd(",")

                aggr_to = "TAGS_" + tvObjectsTreeStats.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()(0).Item(3)
                If aggr_to.Contains("CM") Then
                    CMFilter = tvObjectsTreeStats.GetChecked2String(tech, cmbObjectTreeStats.Text, "TAGS_CM", strTreeFilterStats)
                    ObjectsCharted = "TAGS CM: " & ObjectsCharted + ": " + tvObjectsTreeStats.GetChecked2String(tech, cmbObjectTreeStats.Text, "Naked", strTreeFilterStats)
                End If
                If aggr_to.Contains("Region") Then
                    RegionFilter = tvObjectsTreeStats.GetChecked2String(tech, "TAGS_Region", "ObjectName", strTreeFilterStats)
                End If
            End If
            Dim purpose As String = "ObjectTime"
            reportChartPurpose = purpose

            Dim chartname As String = Nothing
            If cm_Chart_ObjectCompareOrMapKPI = "tsmi_PeriodCalcHistogramChart" Then
                aggr_from = objtype
                chartname = ""
                purpose = "ObjectTimeBreak"
            Else
                aggr_from = "%"
            End If

            If objTechExportOption IsNot Nothing Then
                If ((Export2Excel = True) AndAlso (objTechExportOption.CellBasedExport = True)) Then
                    aggr_from = objtype
                    purpose = "ObjectTimeBreak"
                End If
            End If

            Dim StringForSourceTable As String = ""
            'get sql
            sql_sql = clsSQLCommands.GetConstructStatsSQL(tech, purpose, aggr_to, aggr_from, objtype)
            comm_sql = New Odbc.OdbcCommand(sql_sql, conn_el)
            dr_sql = comm_sql.ExecuteReader
            sql_from_time = ""

            dr_sql.Read()

            If Not dr_sql.HasRows = 0 Then
                sql_select = dr_sql("sql_select").ToString.Trim

                If cm_Chart_ObjectCompareOrMapKPI = "tsmi_ChartCompareElementsGroupBy" Then
                    sql_select = sql_select.Split(",")(0) & ", " & cm_Chart_GroupByName & ", "
                End If

                aggr_from = dr_sql("Aggregate_From").ToString.Trim
                If rdoHourlyStats.Checked = True Or xtcPSFilterStats.SelectedTabPage.Text = "Hours" Then
                    sql_from_time = " " & dr_sql("sql_time_hour").ToString.Trim
                    connectionString = dr_sql("sql_time_hour_connStr").ToString.Trim

                ElseIf rdoDailyStats.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_day").ToString.Trim
                    connectionString = dr_sql("sql_time_day_connStr").ToString.Trim

                ElseIf rdoDailyBHStats.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_bh").ToString.Trim
                    connectionString = dr_sql("sql_time_bh_connStr").ToString.Trim

                ElseIf rdoWeeklyStats.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_week").ToString.Trim
                    connectionString = dr_sql("sql_time_week_connStr").ToString.Trim

                ElseIf rdoDailyBH2Stats.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_bh").ToString.Trim
                    connectionString = dr_sql("sql_time_bh_connStr").ToString.Trim

                ElseIf rdoRawStats.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_raw").ToString.Trim
                    connectionString = dr_sql("sql_time_raw_connStr").ToString.Trim

                ElseIf rdoMonthlyStats.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_month").ToString.Trim
                    connectionString = dr_sql("sql_time_month_connStr").ToString.Trim

                End If

                If objTechExportOption IsNot Nothing Then
                    If ((Export2Excel = True) AndAlso (objTechExportOption.WholePeriodAggr = True)) Then
                        Dim ix1 As Int16 = sql_select.ToLower.IndexOf(".period")
                        Dim ix2 As Int16 = sql_select.Substring(0, ix1).LastIndexOf(" ")

                        Dim tableAlias As String = sql_select.Substring(ix2, ix1 - ix2).Trim
                        Dim periodName As String = ""
                        periodName = sql_select.Substring(ix2, tableAlias.Length + 1 + 18).Trim

                        If tableAlias <> "" Then
                            sql_select = sql_select.Replace(periodName + " as Date", "MIN(" + periodName + ") as StartDate, MAX(" + periodName + ") as EndDate, Count(*) as CountOfPeriods")
                        Else
                            sql_select = sql_select.Replace("SELECT ", "SELECT MIN(@alias.Period_Start_Time) as StartDate, MAX(@alias.PERIOD_START_TIME) as EndDate, Count(*) as CountOfPeriods,")
                        End If
                    End If
                End If

                If rdoHourlyStats.Checked = True Or xtcPSFilterStats.SelectedTabPage.Text = "Hours" Then
                    StringForSourceTable = "_HOUR"
                ElseIf rdoDailyStats.Checked = True Then
                    StringForSourceTable = "_DAY"
                ElseIf rdoDailyBHStats.Checked = True Then
                    StringForSourceTable = "_BH"
                ElseIf rdoWeeklyStats.Checked = True Then
                    StringForSourceTable = "_WEEK"
                ElseIf rdoDailyBH2Stats.Checked = True Then
                    StringForSourceTable = "_BHPS"
                ElseIf rdoRawStats.Checked = True Then
                    StringForSourceTable = "_RAW"
                ElseIf rdoMonthlyStats.Checked = True Then
                    StringForSourceTable = "_MONTH"
                End If

                sql_where_misc = " " & dr_sql("sql_where_misc").ToString.Trim

                If cmbObjectTreeStats.Text = "PLMN" Then 'Or cm_Chart_ObjectCompareOrMapKPI = "tsmi_Chart_MapKPI" Then
                    sql_where_object = " " & Replace(dr_sql("sql_where_object").ToString, "@object", " LIKE '%' ").ToString.Trim
                Else
                    sql_where_object = " " & Replace(dr_sql("sql_where_object").ToString, "@object", objectsel).ToString.Trim
                End If

                'If (Export2Excel = True) AndAlso (objectsel = "") Then
                '    If sql_where_misc.Contains("WHERE") Then
                '        sql_where_object = ""
                '    Else
                '        sql_where_object = " WHERE 1=1 "
                '    End If
                'End If

                sql_where_tables = " " & dr_sql("sql_where_tables").ToString.Trim

                If cm_Chart_ObjectCompareOrMapKPI = "tsmi_PeriodCalcHistogramChart" Then
                    If cm_Chart_ObjectCompareOrMapKPI = "tsmi_PeriodCalcHistogramChart" Then

                        If dtPrdCalcStats.Rows.Count = 1 Then

                            startdate_string = Chr(39) & CDate(dtPrdCalcStats.Rows(0)("PeriodStart")).ToString("yyyy-MM-dd") & Chr(39)
                            enddate_string = Chr(39) & CDate(dtPrdCalcStats.Rows(0)("PeriodEnd")).ToString("yyyy-MM-dd") & Chr(39)

                        ElseIf dtPrdCalcStats.Rows.Count = 2 Then

                            '      If calcPeriod.ToUpper = dtPrdCalcStats.Rows(0)("PeriodName").ToString.ToUpper Then
                            startdate_string = Chr(39) & CDate(dtPrdCalcStats.Rows(0)("PeriodStart")).ToString("yyyy-MM-dd") & Chr(39)
                            enddate_string = Chr(39) & CDate(dtPrdCalcStats.Rows(0)("PeriodEnd")).ToString("yyyy-MM-dd") & Chr(39)
                            '      ElseIf calcPeriod.ToUpper = dtPrdCalcStats.Rows(1)("PeriodName").ToString.ToUpper Then
                            startdate_string2 = Chr(39) & CDate(dtPrdCalcStats.Rows(1)("PeriodStart")).ToString("yyyy-MM-dd") & Chr(39)
                            enddate_string2 = Chr(39) & CDate(dtPrdCalcStats.Rows(1)("PeriodEnd")).ToString("yyyy-MM-dd") & Chr(39)
                            '      End If

                        End If
                        'periodCalculation = cm_Chart_MapKPI_Date.ToString("yyyyMMdd HHmm")
                        'If tsmi_EvalHistogramAggOrNoAgg.Checked = True Then
                        '    For Each ax As AxisMarker In CType(cm_Chart_Sourcecontrol, Chart).XAxis.Markers
                        '        startdate_string = startdate_string + "," + Chr(39) + CDate(ax.Value).ToString("yyyy-MM-dd HH:mm") + Chr(39)
                        '    Next
                        'End If
                        sql_where_period = " " & Split(dr_sql("sql_where_period"), ">")(0) & " Between " & startdate_string & " And " & enddate_string
                        sql_where_period2 = " " & Split(dr_sql("sql_where_period"), ">")(0) & " Between " & startdate_string2 & " And " & enddate_string2
                    Else
                        sql_where_period = " " & Replace(Replace(dr_sql("sql_where_period"), "@starttime", startdate_string), "@endtime", enddate_string).ToString.Trim & filterPeriodstring
                    End If
                Else
                    sql_where_period = " " & Replace(Replace(dr_sql("sql_where_period"), "@starttime", startdate_string), "@endtime", enddate_string).ToString.Trim & filterPeriodstring
                End If

                sql_groupby = " " & dr_sql("sql_groupby").ToString.Trim

                If cm_Chart_ObjectCompareOrMapKPI = "tsmi_ChartCompareElementsGroupBy" Then
                    sql_groupby = sql_groupby.Split(",")(0) & ", " & cm_Chart_GroupByName
                End If

                sql_orderby = " " & dr_sql("sql_orderby").ToString.Trim

                If objTechExportOption IsNot Nothing Then
                    If ((Export2Excel = True) AndAlso (objTechExportOption.WholePeriodAggr = True)) Then
                        Dim ix1 As Int16 = sql_groupby.ToLower.IndexOf(".period")
                        Dim ix2 As Int16 = sql_groupby.Substring(0, ix1).LastIndexOf(" ")

                        Dim tableAlias As String = sql_groupby.Substring(ix2, ix1 - ix2).Trim
                        Dim periodName As String = ""
                        periodName = sql_groupby.Substring(ix2, tableAlias.Length + 1 + 18).Trim

                        If tableAlias <> "" Then
                            sql_groupby = sql_groupby.Replace(periodName + ",", "")
                            sql_groupby = sql_groupby.Replace(periodName + " ,", "")
                            sql_groupby = sql_groupby.Replace(periodName, "")
                            If sql_groupby.ToLower.Trim = "group by" Then
                                sql_groupby = ""
                            End If
                        End If

                        sql_orderby = " "
                    End If
                End If

            Else
                lblObjTreeStatusStats.Text = "Error Building Query !"
                lblObjTreeStatusStats.ForeColor = Color.Red
                'Closing and dereferencing
                dr_sql.Close()
                dr_sql = Nothing
                comm_sql.Dispose()
                comm_sql = Nothing
                conn_el.Close()
                conn_el.Dispose()
                conn_el = Nothing
                Return ""
            End If
            'Closing and dereferencing
            dr_sql.Close()
            dr_sql = Nothing
            comm_sql.Dispose()
            comm_sql = Nothing
            conn_el.Close()
            conn_el.Dispose()
            conn_el = Nothing

            'get KPI sql
            conn_el = New Odbc.OdbcConnection(connStrIOSServer)
            conn_el.ConnectionTimeout = 5
            conn_el.Open()
            Dim supportcode As Integer = 0

            If Export2Excel = True Then
                kpiname = Nothing
                sqlelement = clsSQLCommands.GetSqlElementQuery(supportcode, tech, aliastable)
            Else
                If Not kpiname Is Nothing Then
                    sqlelement = clsSQLCommands.GetSqlElementQuery(supportcode, tech, aliastable, kpiname)
                Else
                    sqlelement = "SELECT IOS_SQL_KPI.KPI_SQL, IOS_SQL_KPI.sourcetable, IOS_SQL_KPI.tablealias, IOS_SQL_KPI.JoinObjects, IOS_SQL_KPI.Object, IOS_SQL_KPI.KPI_Name FROM IOS_Chart_Configuration " _
                       & " INNER JOIN IOS_SQL_KPI ON IOS_Chart_Configuration.SQLKPI_ID = IOS_SQL_KPI.SQLKPI_ID " _
                       & " WHERE (IOS_Chart_Configuration.ChartName = " & Chr(39) & chartname & Chr(39) & " ) AND (IOS_Chart_Configuration.TechTab = " & Chr(39) & tech & Chr(39) & ")  AND " _
                       & " (IOS_SQL_KPI.sourcetable= " & Chr(39) & aliastable & Chr(39) & ") AND (IOS_Chart_Configuration.ObjectTab = " & Chr(39) & objtype & Chr(39) & ") " _
                       & " GROUP BY IOS_SQL_KPI.KPI_Name,IOS_SQL_KPI.KPI_SQL, IOS_SQL_KPI.sourcetable, IOS_SQL_KPI.tablealias, IOS_SQL_KPI.JoinObjects, IOS_SQL_KPI.Object, IOS_Chart_Configuration.CategoryTabIndex, IOS_Chart_Configuration.ChartIndex " _
                       & " ORDER BY IOS_Chart_Configuration.CategoryTabIndex, IOS_Chart_Configuration.ChartIndex"
                End If
            End If

            '- add identification of primary keys if sourcetable has multiple tables and agg_from is diff from objtype
            If aggr_from <> objtype And aliastable.Split(",").Count > 1 Then
                Dim tableToIdentifyPrimKey As String = Replace(Replace(Split(Split(aliastable, ",")(0), ".").Last, "<AggregatedObject>", aggr_from).Trim, "_RAW", "_DAY")
                Dim dbToIdentifyPrimKey As String = Split(Split(aliastable, ",")(0), ".").First.Trim

                sqlelement = sqlelement & vbCrLf & " select schema_name(tab.schema_id) as [schema_name],  tab.[name] as table_name,   pk.[name] as pk_name,   substring(column_names, 1, len(column_names)-1) as [columns]
                        from " + dbToIdentifyPrimKey + ".sys.tables tab
                        left outer join " + dbToIdentifyPrimKey + ".sys.indexes pk on tab.object_id = pk.object_id  and pk.is_primary_key = 1
                        cross apply (select col.[name] + ', '
                            from " + dbToIdentifyPrimKey + ".sys.index_columns ic
                            inner join " + dbToIdentifyPrimKey + ".sys.columns col on ic.object_id = col.object_id and ic.column_id = col.column_id
                            where ic.object_id = tab.object_id and ic.index_id = pk.index_id
                            order by col.column_id for xml path ('') ) D (column_names) where tab.[name] = '" + tableToIdentifyPrimKey + "' 
                    order by schema_name(tab.schema_id),
                        tab.[name];"
            End If

            comm_Element = New Odbc.OdbcCommand(sqlelement, conn_el)
            dr_element = comm_Element.ExecuteReader
            sql_kpi = ""
            Dim sourcetable As String = ""
            Dim joinobjs As String = ""

            While dr_element.Read
                Dim kpisql As String = dr_element.GetValue(0).trim + " "

                If Not kpiname Is Nothing Then
                    kpisql = kpisql.Replace(" " + kpiname.Trim + " ", " [" + kpiname.Trim + "]")
                Else
                    Dim KpiNamefromQuery As String = dr_element.GetValue(5).trim
                    kpisql = kpisql.Replace(" " + KpiNamefromQuery + " ", " [" + KpiNamefromQuery + "]")
                End If

                sql_kpi = sql_kpi + " " + kpisql.Trim + ", " + Chr(13)

                sourcetable = dr_element.GetValue(1).trim
                If Not rdoRawStats.Checked Then
                    If sourcetable.Contains("_HOUR") Then
                        sourcetable = Replace(sourcetable, "_HOUR", StringForSourceTable) 'if _HOUR is base table in KPI then _HOUR must be replaced for day, bh, etc..
                    ElseIf sourcetable.Contains("_RAW") Then
                        sourcetable = Replace(sourcetable, "_RAW", StringForSourceTable) 'if _MNC1_RAW is base table, then _RAW must be replaced by day, bh, etc..
                    Else
                        If sourcetable.EndsWith("]") Then
                            sourcetable = sourcetable.Substring(0, Len(sourcetable) - 1) + StringForSourceTable + "]"
                        Else
                            sourcetable = sourcetable + StringForSourceTable
                        End If
                    End If
                    If sourcetable.Contains("MNC1") Then sourcetable = Replace(sourcetable, "MNC1", aggr_from) 'and MNC1 with element
                End If
                sourcetable = Replace(sourcetable, "<AggregatedObject>", aggr_from)
                aliastable = dr_element.GetValue(2).ToString.Trim
                joinobjs = dr_element.GetValue(3).ToString.Trim
            End While
            sql_kpi = sql_kpi.Trim
            sql_kpi = sql_kpi.TrimEnd(",")


            If dr_element.NextResult AndAlso dr_element.HasRows Then
                joinobjs = Replace(dr_element.GetValue(3), " ", "")
            End If

            Dim sourcetable_final As String = ""
            If Not sourcetable Is Nothing Then
                If sourcetable.Contains(",") Then
                    'get first table name and first alias
                    Dim firstTable As String = Split(sourcetable, ",")(0)
                    Dim firstAlias As String = Split(aliastable, ",")(0)
                    sourcetable_final = firstTable + " " + firstAlias
                    For i As Integer = 1 To Split(sourcetable, ",").Count - 1
                        sourcetable_final = sourcetable_final + " left outer join "
                        sourcetable_final = sourcetable_final + Split(sourcetable, ",")(i) & " " & Split(aliastable, ",")(i) + " ON "
                        For j = 0 To joinobjs.Split(",").Count - 1
                            sourcetable_final = sourcetable_final + firstAlias + "." + joinobjs.Split(",")(j) + "=" + aliastable.Split(",")(i) + "." + joinobjs.Split(",")(j)
                            If j < joinobjs.Split(",").Count - 1 Then
                                sourcetable_final = sourcetable_final + " AND "
                            End If
                        Next
                    Next
                    aliastable = Split(aliastable, ",")(0)
                Else
                    sourcetable_final = sourcetable + " " + aliastable
                End If
            End If

            '         'building jointable for multi
            '         Dim jointable As String = " "

            '         'building sourcetable for multi
            '         Dim sourcetable_final As String = ""
            'If sourcetable.Contains(",") Then
            '	For i As Integer = 0 To Split(sourcetable, ",").Count - 1
            '		sourcetable_final = sourcetable_final + Split(sourcetable, ",")(i) & " " & Split(aliastable, ",")(i) + ", "
            '	Next
            '	sourcetable_final = sourcetable_final.Substring(0, Len(sourcetable_final) - 2)
            'Else
            '	sourcetable_final = sourcetable + " " + aliastable
            'End If

            ''building jointable for multi
            Dim jointable As String = " "
            'If joinobjs.Contains(",") Then

            '	Dim firsttable As String = Split(aliastable, ",")(0)

            '	For Each obj As String In Split(joinobjs, ",")
            '		For i As Integer = 1 To Split(aliastable, ",").Count - 1
            '			jointable = jointable + firsttable + "." + obj + " = " + Split(aliastable, ",")(i) + "." + obj + " AND "
            '		Next
            '	Next
            '	jointable = " AND " + jointable.Substring(0, Len(jointable) - 4)
            '	aliastable = Split(aliastable, ",")(0)
            'End If

            'Closing and dereferencing
            comm_Element.Dispose()
            comm_Element = Nothing
            dr_element.Close()
            dr_element = Nothing
            conn_el.Close()
            conn_el.Dispose()
            conn_el = Nothing

            Dim sql_total2 As String     'second period if available

            sql_total = sql_select + sql_kpi + " " + sql_from_time + sql_where_misc + sql_where_object + sql_where_tables + sql_where_period + jointable + sql_groupby + sql_orderby
            sql_total = Replace(sql_total, "@sourcetable", sourcetable_final)
            sql_total = Replace(sql_total, "@alias", aliastable)
            sql_total = Replace(sql_total, "@object", objectsel)
            sql_total = Replace(sql_total, "@tablejoin", jointable)
            If tagid IsNot Nothing Then
                sql_total = Replace(sql_total, "= @TagID", tagid.Replace("TagID", ""))
                sql_total = Replace(sql_total, "@TagID", tagid.Replace("TagID", ""))
            End If
            sql_total = Replace(sql_total, "@RegionFilter", RegionFilter)




            If cm_Chart_ObjectCompareOrMapKPI = "tsmi_PeriodCalcHistogramChart" Then
                Dim UFP As Integer = underFlowPercentile_PC
                Dim OFP As Integer = overFlowPercentile_PC
                Dim NumberOfBins As String = histChartBinsCount_PC
                'encapsulation to calculate cdf serverside

                Dim targettype As String = ""
                Dim targettype2 As String = ""
                Dim targettype3 As String = ""


                targettype = "," + cmbObjectTreeStats.Text
                targettype2 = cmbObjectTreeStats.Text + ","
                targettype3 = "k." & cmbObjectTreeStats.Text

                If gvParamFiltersStats.RowCount > 0 Then
                    sql_where_paramfilter = GetParamFilterString("Stats")
                End If

                If calcperiod2 Is Nothing Then

                    If Not sql_select.Contains(targettype2) And cmbObjectTreeStats.Text <> "PLMN" And cmbObjectTreeStats.Text <> "TAGS" Then
                        sql_total = sql_select + targettype2 + sql_kpi + "," + Chr(39) + calcPeriod + Chr(39) + " as PC " + " into #PM " + sql_from_time + sql_where_misc + sql_where_object + sql_where_tables + sql_where_period + sql_where_paramfilter + jointable + sql_groupby + targettype
                    Else
                        sql_total = sql_select + sql_kpi + "," + Chr(39) + calcPeriod + Chr(39) + " as PC " + " into #PM " + sql_from_time + sql_where_misc + sql_where_object + sql_where_tables + sql_where_period + sql_where_paramfilter + jointable + sql_groupby
                    End If

                Else
                    If Not sql_select.Contains(targettype2) And cmbObjectTreeStats.Text <> "PLMN" And cmbObjectTreeStats.Text <> "TAGS" Then
                        sql_total = "SELECT * into #PM from (
                                    " + sql_select + targettype2 + sql_kpi + "," + Chr(39) + calcPeriod + Chr(39) + " as PC " + sql_from_time + sql_where_misc + sql_where_object + sql_where_tables + sql_where_period + sql_where_paramfilter + jointable + sql_groupby + targettype + "
                                    union (" + sql_select + targettype2 + sql_kpi + "," + Chr(39) + calcperiod2 + Chr(39) + " as PC " + sql_from_time + sql_where_misc + sql_where_object + sql_where_tables + sql_where_period2 + sql_where_paramfilter + jointable + sql_groupby + targettype +
                                       ")) x "
                    Else
                        sql_total = "SELECT * into #PM from (
                                            " + sql_select + sql_kpi + "," + Chr(39) + calcPeriod + Chr(39) + " as PC " + sql_from_time + sql_where_misc + sql_where_object + sql_where_tables + sql_where_period + sql_where_paramfilter + jointable + sql_groupby + "
                                     union (" + sql_select + sql_kpi + "," + Chr(39) + calcperiod2 + Chr(39) + " as PC " + sql_from_time + sql_where_misc + sql_where_object + sql_where_tables + sql_where_period2 + sql_where_paramfilter + jointable + sql_groupby +
                                        ")) x "
                    End If

                End If


                sql_total = Replace(sql_total, "@sourcetable", sourcetable_final)
                sql_total = Replace(sql_total, "@alias", aliastable)
                sql_total = Replace(sql_total, "@object", objectsel)
                sql_total = Replace(sql_total, "@tablejoin", jointable)
                If tagid IsNot Nothing Then
                    sql_total = Replace(sql_total, "= @TagID", tagid.Replace("TagID", ""))
                    sql_total = Replace(sql_total, "@TagID", tagid.Replace("TagID", ""))
                End If
                sql_total = Replace(sql_total, "@RegionFilter", RegionFilter)

                If targettype <> "" AndAlso Not targettype.Contains("PLMN") Then


                    sql_total = sql_total + "                 

                    select max([" + kpiname + "]) +0.0001 [" + kpiname + "],cdfbin into #PMCUM from (
                     select [" + kpiname + "] 
                     ,100 * (CUME_DIST () OVER ( ORDER BY [" + kpiname + "])) cdfbin
                     from #PM where [" + kpiname + "] is not null
                    ) y group by cdfbin order by 1

                    declare @MinValuePx as Float = (select max([" + kpiname + "])  [" + kpiname + "] from #PMcum where cdfbin <= " + UFP.ToString + "   )
                    If @MinValuePx is null 
                    set @MinValuePx = (select min([" + kpiname + "])  [" + kpiname + "]  from #PMcum)

                    declare @maxValuePx as Float = (select min([" + kpiname + "])  [" + kpiname + "] from #PMcum where cdfbin >= " + OFP.ToString + "   )
                    If @maxValuePx is null 
                    set @maxValuePx = (select max([" + kpiname + "])  [" + kpiname + "]  from #PMcum)

                    select t.*,  ( 1 +ISNULL(floor(([" + kpiname + "] - min_value) * (" + NumberOfBins + "-1)  / NULLIF(max_value - min_value,0 )),0)) as BucketNumber,  (max_value - min_value )/" + NumberOfBins + ".0 BucketSize, min_value as BucketStartValue
                    into #PMCDF 
                    from (select t.*, @MinValuePx  as min_value, @maxValuePx as max_value from #PM t where [" + kpiname + "] is not null
                    ) t					 

                    select  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,BucketSize,BucketStartValue + (case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ) * BucketSize BucketValue ," + targettype3 + ", k.pc
                    into #PMBuckets
                    from #PMCDF, (select  " + targettype3 + ", k.PC from #PMCDF k group by  " + targettype3 + ", k.PC) k where  BucketNumber >=0 and bucketnumber <=" + NumberOfBins + "  
                    group by case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ,BucketSize , BucketStartValue , " + targettype3 + ", k.PC


                    select k.BucketNumber,round(k.BucketValue,3) BucketValue, SampleCount,round(100.00 * sum(SampleCount) over (order by k.bucketnumber ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) / (sum(SampleCount) over ()),2)  SamplePercentage, " + "'" + Replace(targettype, ",", "") + "_'  + k.PC  " + Replace(targettype, ",", "") + "
                    from #PMBuckets k left outer join (
                      select  PC, case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,min([" + kpiname + "]) MinKPI,max([" + kpiname + "]) MaxKPI,count(*) SampleCount 
                      from #PMCDF 
                      group by  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end , PC
                    ) z on k.BucketNumber = z.BucketNumber  and z.pc=k.pc
                    where samplecount is not null group by k.BucketNumber, k.BucketValue, SampleCount, k.pc
                    order by 1
                    "
                Else
                    sql_total = sql_total + "
                 
                    select max([" + kpiname + "]) + 0.0001 [" + kpiname + "],cdfbin into #PMCUM from (
	                    select [" + kpiname + "] 
	                    ,100 * (CUME_DIST () OVER ( ORDER BY [" + kpiname + "])) cdfbin
	                    from #PM where [" + kpiname + "] is not null
                    ) y group by cdfbin order by 1

                    declare @MinValuePx as Float = (select max([" + kpiname + "])  [" + kpiname + "] from #PMcum where cdfbin <= " + UFP.ToString + "   )
                    If @MinValuePx is null 
                    set @MinValuePx = (select min([" + kpiname + "])  [" + kpiname + "]  from #PMcum )

                    declare @maxValuePx as Float = (select min([" + kpiname + "])  [" + kpiname + "] from #PMcum where cdfbin >= " + OFP.ToString + "   )
                    If @maxValuePx is null 
                    set @maxValuePx = (select max([" + kpiname + "])  [" + kpiname + "]  from #PMcum)

                    select t.*,  ( 1 +ISNULL(floor(([" + kpiname + "] - min_value) * (" + NumberOfBins + "-1)  / NULLIF(max_value - min_value,0 )),0)) as BucketNumber,  (max_value - min_value )/" + NumberOfBins + ".0 BucketSize, min_value as BucketStartValue
                    into #PMCDF
                    from (select t.*, @MinValuePx  as min_value,  @MaxValuePx as max_value from #PM t where [" + kpiname + "] is not null
                    ) t					 

                    select  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,BucketSize,BucketStartValue + (case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ) * BucketSize BucketValue , k.pc
                    into #PMBuckets
                    from #PMCDF k where  BucketNumber >=0 and bucketnumber <=" + NumberOfBins + "  
                    group by case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ,BucketSize , BucketStartValue , k.pc


                    select k.BucketNumber,round(k.BucketValue,3) BucketValue, SampleCount,round(100.00 * sum(SampleCount) over (order by k.bucketnumber ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) / (sum(SampleCount) over ()),2)  SamplePercentage, " + "'" + Replace(targettype, ",", "") + "_' + k.pc " + Replace(targettype, ",", "") + "
                    from #PMBuckets k left outer join (
		                    select  PC,case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,min([" + kpiname + "]) MinKPI,max([" + kpiname + "]) MaxKPI,count(*) SampleCount 
		                    from #PMCDF 
		                    group by  PC,case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end 
                    ) z on k.BucketNumber=z.BucketNumber  and z.pc=k.pc
                    where samplecount is not null group by k.BucketNumber, k.BucketValue, SampleCount,k.pc
                    order by 1
                    "
                End If

            End If

            Return sql_total
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)

            If Not dr_sql Is Nothing Then
                dr_sql.Close()
                dr_sql = Nothing
            End If
            If Not comm_sql Is Nothing Then
                comm_sql.Dispose()
                comm_sql = Nothing
            End If
            If Not dr_element Is Nothing Then
                dr_element.Close()
                dr_element = Nothing
            End If
            If Not comm_Element Is Nothing Then
                comm_Element.Dispose()
                comm_Element = Nothing
            End If
            If Not conn_el Is Nothing Then
                conn_el.Close()
                conn_el.Dispose()
                conn_el = Nothing
            End If
            Return Nothing
        End Try
    End Function

    Private Sub Process_PrdCalc_ObjectTime_ThreadEnd(ds As System.Data.DataSet, ti As Threading.Thread)
        Try
            Dim threadcorrect As Boolean = False
            For Each tid In t_list_prdcalc
                If tid.ManagedThreadId = ti.ManagedThreadId Then
                    threadcorrect = True
                End If
            Next

            If threadcorrect = False Then
                ds.Dispose()
                ds = Nothing
                Exit Sub
            End If

            SyncLock ds_prdcalc_hist_list
                If Not ds Is Nothing Then
                    If ds.Tables.Count > 0 Then
                        ds_prdcalc_hist_list.Add(ds)
                    End If
                End If
            End SyncLock

            Dim aResult As IAsyncResult = Nothing
            aResult = Me.BeginInvoke(Me.Call_ProcessPrdCalcObjectTimeInvoked)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
        End Try
    End Sub

    Private Sub Process_PrdCalc_ObjectTime_Invoked()
        Application.DoEvents()
        Try
            'If PrdCalcHistogramChartCntr = 0 Then
            '    Exit Sub
            'End If

            For Each t As Threading.Thread In t_list_prdcalc
                If t.ThreadState = Threading.ThreadState.AbortRequested Then
                    Exit Sub
                End If
            Next t
        Catch ex As Exception
            lblObjTreeStatusStats.ForeColor = Color.Red
            lblObjTreeStatusStats.Text = "Threads Error..." & Threads_Fired
        End Try
        SyncLock lblObjTreeStatusStats
            Threads_Fired = 0
            If Not lblObjTreeStatusStats.Text.Contains("Abort") And Threads_Fired > -1 Then
                lblObjTreeStatusStats.Text = "Threads To Complete..." & Threads_Fired
            End If
        End SyncLock

        Try
            If Threads_Fired = 0 Then
                Threads_Fired = -99
                Application.DoEvents()
                If ds_prdcalc_hist_list.Count > 0 Then
                    If cm_Chart_ObjectCompareOrMapKPI = "tsmi_PeriodCalcHistogramChart" Then

                        If (Not dsPrdCalc_Histogram.Tables.Contains(cm_Chart_kpiname)) Then
                            dtPrdCalc_Histogram = New DataTable
                            Dim dt_merge As DataTable = Nothing

                            For Each ds As DataSet In ds_prdcalc_hist_list
                                If ds.DataSetName.Contains(cm_Chart_kpiname) Then
                                    If ds.Tables.Count = 1 Then
                                        dt_merge = ds.Tables(0).Copy
                                        dtPrdCalc_Histogram.Merge(dt_merge)
                                    ElseIf ds.Tables.Count = 2 Then
                                        dt_merge = ds.Tables(0).Copy
                                        dtPrdCalc_Histogram.Merge(dt_merge)

                                        dt_merge = ds.Tables(1).Copy
                                        dtPrdCalc_Histogram.Merge(dt_merge)
                                    End If
                                    dtPrdCalc_Histogram.TableName = cm_Chart_kpiname
                                End If
                            Next

                            If dtPrdCalc_Histogram.Rows.Count > 0 Then
                                dsPrdCalc_Histogram.Tables.Add(dtPrdCalc_Histogram)
                                cm_Chart_kpiname = dtPrdCalc_Histogram.TableName
                                AssignDataToHistogram_PrdCalc(dtPrdCalc_Histogram, _strNetwork)

                            End If
                        End If

                        lblObjTreeStatusStats.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                        lblObjTreeStatusStats.ForeColor = Color.Black

                        AccCtrlStats.Enabled = True
                        Me.btnApplyStats.Text = "Apply"
                        ucProgPnlStats.StopProgress()
                    End If
                Else
                    lblObjTreeStatusStats.Text = "No Data Retrieved !"
                    lblObjTreeStatusStats.ForeColor = Color.Red
                    Me.btnApplyStats.Text = "Apply"
                    ucProgPnlStats.StopProgress()
                End If
            End If
        Catch ex As Exception
            AccCtrlStats.Enabled = True
            Me.btnApplyStats.Text = "Apply"
            ucProgPnlStats.StopProgress()

            lblObjTreeStatusStats.ForeColor = Color.Red
            lblObjTreeStatusStats.Text = "Error Merging Threads..." & Threads_Fired
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
        End Try
    End Sub

    Private Sub AssignDataToHistogram_PrdCalc(ByRef dt As DataTable, tech As String)
        'get original timebased data as first chart

        Dim ds As DataSet = TechToDataSet(tech, "Time")
        Dim dt_new As New DataTable

        For Each dtOriginal As DataTable In ds.Tables
            If dtOriginal.Columns.Contains(cm_Chart_kpiname) Then
                Dim displayView = New DataView(dtOriginal)
                displayView.RowFilter = ""
                dt_new = displayView.ToTable(False, "Date", cm_Chart_kpiname).Copy
            End If
        Next

        Dim objectscharted As String = ""

        'getting ObjectTab
        Dim tabcontrol As DevExpress.XtraTab.XtraTabControl = GetTabControlFromTech(tech)
        Dim ObjectTab_Active As String = tabcontrol.SelectedTabPage.Text

        Dim ds_chart As DataSet = clsSQLCommands.GetChartConfigurationByElement(connStrIOSServer, tech, cm_Chart_kpiname, ObjectTab_Active, cm_Chart_Name)
        Dim dt_chart As DataTable = ds_chart.Tables(0)

        'Assign data to all charts
        Dim ch As Chart = Nothing
        Dim i As Integer
        Dim Y1axislabel As String
        Dim Y2axislabel As String
        Dim Y1axisAbsorPerc, Y2axisAbsOrPerc As String
        Dim Y1axisPrecision, Y2axisPrecision As Integer
        Dim yaxis1 As Axis = Nothing
        Dim yaxis2 As Axis = Nothing
        Dim sp As New SmartPalette()
        Dim sc As New SeriesCollection

        Dim lastchart As String = ""

        Dim chart_elements() As String = {"0"}
        Dim chart_elementsYAxis() As String = {"0"}
        Dim chart_Eltype() As String = {"Bar"}
        Dim chart_ElColor() As Integer = {0}
        Dim chart_YaxisScale() As String = {"0", "0"}
        Dim chart_ElLineSize() As Integer = {0}

        Dim j As Integer = 0
        Dim rownum As Integer = 0
        Dim color_R As Integer = 0, color_B As Integer = 0, color_G As Integer = 0

        Dim isKpiPercentage As Boolean = False

        For rownum = 0 To 0
            Try
                'collecting elements from chart confguration
                Dim drow As DataRow = dt_chart.Rows(rownum)

                'configures individual chart when new chartline is detected
                If lastchart = "" Or lastchart <> drow(5).ToString Then
                    lastchart = drow(5).ToString.Trim
                    sp.Clear()

                    Y1axisAbsorPerc = nZ(drow(13), "Abs")
                    Y2axisAbsOrPerc = nZ(drow(14), "Abs")


                    If Y1axisPrecision = Nothing Then
                        Y1axisPrecision = CInt(nZ(drow(15), 0))
                    Else
                        Y1axisPrecision = Math.Max(CInt(nZ(drow(15), 0)), Y1axisPrecision)
                    End If

                    If Y2axisPrecision = Nothing Then
                        Y2axisPrecision = CInt(nZ(drow(16), 0))
                    Else
                        Y2axisPrecision = Math.Max(CInt(nZ(drow(16), 0)), Y2axisPrecision)
                    End If

                    '      Y1axisPrecision = CInt(nZ(drow(15), "0"))
                    '      Y2axisPrecision = CInt(nZ(drow(16), "0"))

                    Y1axislabel = nZ(drow(11), " ")
                    Y2axislabel = nZ(drow(12), " ")

                    chart_elementsYAxis(0) = nZ(drow(9), " ")
                    chart_ElColor(0) = CInt(nZ(drow("ChartElementsColor"), "0"))
                    chart_elements(0) = drow("ChartElements").ToString.Trim
                    chart_Eltype(0) = drow("chartElementsType").trim
                    chart_ElLineSize(0) = nZ(drow("LineSize").ToString.Trim, 3)

                    Dim tc As XtraTabControl
                    tc = GetTabControlFromTech(tech).TabPages(GetTabPageIndex(GetTabControlFromTech(tech), drow("ObjectTab").ToString.Trim)).Controls(0)
                    ch = tc.TabPages(GetTabPageIndex(tc, "*CLUSTER*")).Controls(0).Controls(cm_Chart_kpiname & "Histogram")

                    SetChartXAxis(tech, objectscharted, ch)

                    ch.Annotations.Clear()
                    ch.Annotations.Add(New Annotation(tech.ToUpper))
                    ch.TitleBox.HeaderLabel.Text = "Period Calculation   -   TimeBased " & "  -   KPI: " & cm_Chart_kpiname

                    If Count_OT > 10 Then
                        ch.TitleBox.Label.Text = " "
                        tsmi_ChartHideTitle.Text = "Chart - Show Title"
                    Else
                        ch.TitleBox.Label.Text = "Objects: " & objectscharted
                        tsmi_ChartHideTitle.Text = "Chart - Hide Title"
                    End If
                    ch.TitleBox.Label.Alignment = StringAlignment.Near
                    ch.TitleBox.Label.LineAlignment = StringAlignment.Near

                    If GetFromTech_RadioButton(tech, "Hourly").Checked Or GetFromTech_RadioButton(tech, "Raw").Checked Then
                        ch.DefaultElement.Hotspot.ToolTip = "DATE: <%XValue,dd/MM/yy HH:mm>" & Chr(13) & "%SeriesName: %Value "
                    Else
                        ch.DefaultElement.Hotspot.ToolTip = "DATE: %XValue" & Chr(13) & "%SeriesName: %Value "
                    End If

                    Dim charttitle As String = "Period calculation   -   TimeBased"

                    If UCase(chart_elementsYAxis(i)) = "LEFT" Then
                        chart_YaxisScale(0) = drow("chartYaxisScaleProp").trim
                    ElseIf UCase(chart_elementsYAxis(i)) = "RIGHT" Then
                        chart_YaxisScale(1) = drow("chartYaxisScaleProp").trim
                    End If

                    'Y-Axis Settingso   
                    If chart_elementsYAxis(i).Trim.ToUpper = "LEFT" Then
                        yaxis1 = New Axis
                        yaxis1.Orientation = Orientation.Left
                        yaxis1.Label.Text = Y1axislabel
                        If UCase(Y1axisAbsorPerc) = "ABS" Then
                            yaxis1.Percent = False
                        ElseIf UCase(Y1axisAbsorPerc) = "PERC" Then
                            yaxis1.Percent = True
                            isKpiPercentage = True
                        End If
                        yaxis1.NumberPrecision = Y1axisPrecision
                        If yaxis1.NumberPrecision < 2 And Not yaxis1.Percent = True Then
                            yaxis1.MinimumInterval = 1
                        End If
                        yaxis1.Scale = dotnetCHARTING.WinForms.Scale.Range
                    Else
                        yaxis2 = New Axis
                        yaxis2.Orientation = Orientation.Left
                        yaxis2.Label.Text = Y2axislabel
                        If UCase(Y2axisAbsOrPerc) = "PERC" Then
                            yaxis2.Percent = True
                            isKpiPercentage = True
                        ElseIf UCase(Y2axisAbsOrPerc) = "ABS" Then
                            yaxis2.Percent = False
                        End If
                        yaxis2.NumberPrecision = Y2axisPrecision
                        If yaxis2.NumberPrecision < 2 And Not yaxis2.Percent = True Then
                            yaxis2.MinimumInterval = 1
                        End If
                        yaxis2.Scale = dotnetCHARTING.WinForms.Scale.Range
                    End If

                    '+++++++++++++++++++++++++++++++++++++++
                    j = 0

                    For Each col As DataColumn In dt_new.Columns
                        ReDim Preserve chart_elements(j)
                        If col.ColumnName.ToUpper <> "DATE" Then
                            chart_elements(j) = col.ColumnName.ToUpper
                            j = j + 1
                        End If
                    Next

                    For Each dr As DataRow In dt_new.Rows
                        For Each col As DataColumn In dt_new.Columns
                            If dr(col).ToString = "" Then
                                dr(col) = 0
                            End If
                        Next
                    Next

                    If Not yaxis1 Is Nothing Then
                        If UCase(chart_YaxisScale(0)) = "STACKED" Then
                            yaxis1.Scale = dotnetCHARTING.WinForms.Scale.Stacked
                        ElseIf UCase(chart_YaxisScale(0)) = "FULLSTACKED" Then
                            yaxis1.Scale = dotnetCHARTING.WinForms.Scale.FullStacked
                        Else
                            yaxis1.Scale = dotnetCHARTING.WinForms.Scale.Range
                        End If
                    End If

                    If Not yaxis2 Is Nothing Then
                        If UCase(chart_YaxisScale(1)) = "STACKED" Then
                            yaxis2.Scale = dotnetCHARTING.WinForms.Scale.Stacked
                        ElseIf UCase(chart_YaxisScale(1)) = "FULLSTACKED" Then
                            yaxis2.Scale = dotnetCHARTING.WinForms.Scale.FullStacked
                        Else
                            yaxis2.Scale = dotnetCHARTING.WinForms.Scale.Range
                        End If
                    End If

                    If (xtcPSFilterStats.SelectedTabPage.Text.Contains("Hours") And (rdoFilterHrsExcStats.Checked = True Or rdoFilterHrsIncStats.Checked = True)) Or cmbPredefinedFilterStats.SelectedIndex > 0 Then
                        ch.XAxis.Scale = dotnetCHARTING.WinForms.Scale.Normal
                    ElseIf (xtcPSFilterStats.SelectedTabPage.Text.Contains("Days") And (rdoFilterDaysExcStats.Checked = True Or rdoFilterDaysIncStats.Checked = True)) Then
                        ch.XAxis.Scale = dotnetCHARTING.WinForms.Scale.Normal
                    End If

                    If ch.Type = ChartType.Combo Then
                        Dim xaxis_valuehigh As DateTime = GetFromTech_DateTimePicker(2).EditValue 'Add 1 day to insert a extra x-axis scale.

                        Select Case True
                            Case GetFromTech_RadioButton(tech, "Raw").Checked, GetFromTech_RadioButton(tech, "Hourly").Checked
                                xaxis_valuehigh = xaxis_valuehigh.AddHours(1)
                            Case Else
                                xaxis_valuehigh = xaxis_valuehigh.AddDays(1)
                        End Select

                        If xaxis_valuehigh.Date = Now.Date Then
                            Select Case True
                                Case GetFromTech_RadioButton(tech, "Daily").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.Day, -1, DateAdd(DateInterval.Hour, 12, xaxis_valuehigh.Date))
                                Case GetFromTech_RadioButton(tech, "BH").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.Day, -1, DateAdd(DateInterval.Hour, 12, xaxis_valuehigh.Date))
                                Case GetFromTech_RadioButton(tech, "Weekly").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.WeekOfYear, -1, xaxis_valuehigh.Date)
                                Case GetFromTech_RadioButton(tech, "BHPS").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.Day, -1, DateAdd(DateInterval.Hour, 12, xaxis_valuehigh.Date))
                                Case GetFromTech_RadioButton(tech, "Monthly").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.Month, -1, xaxis_valuehigh.Date)
                            End Select
                        End If

                        ch.XAxis.ScaleRange.ValueHigh = xaxis_valuehigh

                    End If

                    Dim de As DataEngine = New DataEngine(dt_new)
                    de.DataFields = String2DataFields(chart_elements, "Date")

                    If ch.Type = ChartType.Combo Then
                        If (GetFromTech_RadioButton(tech, "Hourly").Checked Or GetFromTech_RadioButton(tech, "Raw").Checked) And ((rdoFilterDaysExcStats.Checked = True Or rdoFilterDaysIncStats.Checked = True) Or (rdoFilterHrsExcStats.Checked = True Or rdoFilterHrsIncStats.Checked = True) Or (cmbPredefinedFilterStats.SelectedIndex > 0)) Then
                            de.FormatString = "dd/MM/yy HH:mm"
                        ElseIf GetFromTech_RadioButton(tech, "Daily").Checked And ((rdoFilterDaysExcStats.Checked = True Or rdoFilterDaysIncStats.Checked = True) Or (rdoFilterHrsExcStats.Checked = True Or rdoFilterHrsIncStats.Checked = True) Or (cmbPredefinedFilterStats.SelectedIndex > 0)) Then
                            de.FormatString = "dd/MM/yy"
                        ElseIf GetFromTech_RadioButton(tech, "Monthly").Checked And ((rdoFilterDaysExcStats.Checked = True Or rdoFilterDaysIncStats.Checked = True) Or (rdoFilterHrsExcStats.Checked = True Or rdoFilterHrsIncStats.Checked = True) Or (cmbPredefinedFilterStats.SelectedIndex > 0)) Then
                            de.FormatString = "MMMM"
                        Else
                            de.FormatString = "dd/MM/yy"
                        End If
                    End If

                    sc = de.GetSeries()

                    Dim LeftAxisDivisor As Int32 = 1
                    Dim RightAxisDivisor As Int32 = 1
                    Dim LeftAxisLabelAddition As String = ""
                    Dim RightAxisLabelAddition As String = ""

                    For i = 0 To sc.Count - 1
                        Dim MaxValueOfSeries As Double = sc(i).Calculate("test", Calculation.Maximum).YValue
                        If MaxValueOfSeries > 1000000000 Then
                            If MaxValueOfSeries > 1000000000000 Then
                                Select Case chart_elementsYAxis(i).ToString().Trim().ToUpper()
                                    Case "LEFT"
                                        LeftAxisDivisor = 1000000
                                        LeftAxisLabelAddition = " Million"
                                        Exit Select
                                    Case "RIGHT"
                                        RightAxisDivisor = 1000000
                                        RightAxisLabelAddition = " Million"
                                        Exit Select
                                End Select
                            Else
                                Select Case chart_elementsYAxis(i).ToString().Trim().ToUpper()
                                    Case "LEFT"
                                        If LeftAxisDivisor < 1000 Then
                                            LeftAxisDivisor = 1000
                                            LeftAxisLabelAddition = " Thousand"
                                        End If
                                        Exit Select
                                    Case "RIGHT"
                                        If RightAxisDivisor < 1000 Then
                                            RightAxisDivisor = 1000
                                            RightAxisLabelAddition = " Thousand"
                                        End If
                                        Exit Select
                                End Select
                            End If

                        End If
                    Next

                    Dim boundaries As String = Nothing
                    Dim dtHistogramData As DataTable = Nothing
                    For i = 0 To sc.Count() - 1
                        If ch.Type = ChartType.Combo Then
                            Select Case UCase(chart_Eltype(i).Trim)
                                Case "LINE"
                                    sc(i).Type = SeriesType.Line
                                    sc(i).Line.Width = CInt(chart_ElLineSize(i))
                                Case "BAR"
                                    sc(i).Type = SeriesType.Bar
                                Case "AREALINE"
                                    sc(i).Type = SeriesType.AreaLine
                            End Select
                        ElseIf ch.Type = ChartType.Scatter Then
                            yaxis1.Label.Text = Y1axislabel
                            sc(i).Type = SeriesType.Marker
                        End If

                        Select Case UCase(chart_elementsYAxis(i).Trim)
                            Case "LEFT"
                                sc(i).YAxis = yaxis1
                            Case "RIGHT"
                                sc(i).YAxis = yaxis2
                        End Select

                        Select Case chart_elementsYAxis(i).ToString().Trim().ToUpper()
                            Case "LEFT"
                                If LeftAxisDivisor > 1 Then
                                    sc(i) = Series.Divide(sc(i), LeftAxisDivisor)
                                End If
                                If Not yaxis1.Label.Text.Contains(LeftAxisLabelAddition) Then
                                    yaxis1.Label.Text = yaxis1.Label.Text + LeftAxisLabelAddition
                                End If

                                sc(i).YAxis = yaxis1
                                Exit Select
                            Case "RIGHT"
                                If RightAxisDivisor > 1 Then
                                    sc(i) = Series.Divide(sc(i), RightAxisDivisor)
                                End If

                                If Not yaxis2.Label.Text.Contains(RightAxisLabelAddition) Then
                                    yaxis2.Label.Text = yaxis2.Label.Text + RightAxisLabelAddition
                                End If
                                sc(i).YAxis = yaxis2
                                Exit Select
                        End Select

                        color_R = CLng(chart_ElColor(i)) Mod 256
                        color_G = (CLng(chart_ElColor(i)) \ 256) Mod 256
                        color_B = ((CLng(chart_ElColor(i)) \ 256) \ 256) Mod 256

                        sc(i).DefaultElement.Color = Color.FromArgb(255, color_R, color_G, color_B)
                        sc(i).DefaultElement.Marker.Type = i + 1

                    Next

                    ch.Type = ChartType.Combo
                    ch.ChartAreaLayout.Mode = ChartAreaLayoutMode.Horizontal

                    Dim yaxis1pdf As Axis = Nothing
                    Dim yaxis2pdf As Axis = Nothing

                    If ch.ExtraChartAreas.Count > 0 Then
                        ch.ExtraChartAreas.Clear()
                    End If


                    If ch.ExtraChartAreas.Count = 0 Then
                        Dim histChartArea As New ChartArea()
                        histChartArea.WidthPercentage = 50
                        histChartArea.YAxis.Label.Text = "Frequency"
                        histChartArea.XAxis.Label.Text = "Bins"
                        histChartArea.YAxis.Interval = 1
                        histChartArea.DefaultElement.Hotspot.ToolTip = "Bins: %XValue" & Chr(13) & "%SeriesName: %Value "

                        histChartArea.Series.Data = dt

                        ch.ExtraChartAreas.Add(histChartArea)
                        ch.ExtraChartAreas.Item(0).XAxis.TickLabelMode = TickLabelMode.Angled
                        ch.ExtraChartAreas.Item(0).XAxis.TickLabelAngle = 45
                        ch.ExtraChartAreas.Item(0).XAxis.Scale = dotnetCHARTING.WinForms.Scale.Range
                        ch.ExtraChartAreas.Item(0).XAxis.ScaleRange.ValueLow = CDbl(dt.Compute("min([BucketValue])", ""))
                        ch.ExtraChartAreas.Item(0).XAxis.ScaleRange.ValueHigh = CDbl(dt.Compute("max([BucketValue])", ""))

                        yaxis1pdf = New Axis()
                        yaxis1pdf.Orientation = Orientation.Left

                        yaxis2pdf = New Axis()
                        yaxis2pdf.Orientation = Orientation.Right
                        yaxis2pdf.Percent = True
                        yaxis2pdf.NumberPrecision = 0

                    End If

                    'loop through every TargetType if available
                    Dim distinctView As DataView = dt.DefaultView.ToTable(True, cmbObjectTreeStats.Text).DefaultView
                    distinctView.Sort = cmbObjectTreeStats.Text
                    Dim distinctDT As DataTable = distinctView.ToTable

                    Dim rnd As Random = New Random(ch.ExtraChartAreas(0).SeriesCollection.Count * 10)

                    'If tsmi_EvalHistogramPeriodSelection.Checked = False Or tsmi_EvalHistogramAggOrNoAgg.Checked = False Then
                    '    ch.XAxis.Markers.Clear()
                    'End If

                    Dim cl As Color = Nothing
                    For Each xm As AxisMarker In ch.XAxis.Markers
                        cl = Color.FromArgb(255, rnd.Next(255), rnd.Next(255), rnd.Next(255))
                    Next

                    For Each distinctTarget As DataRow In distinctDT.Rows

                        Dim deHisto As DataEngine = New DataEngine(dt.AsEnumerable().Where(Function(x) x.Field(Of String)(cmbObjectTreeStats.Text) = distinctTarget(cmbObjectTreeStats.Text)).CopyToDataTable())
                        deHisto.DataFields = String2DataFields({"SampleCount", "SamplePercentage"}, "BucketValue")

                        Dim scHisto As New SeriesCollection

                        scHisto = deHisto.GetSeries()

                        'Dim xmIsPresent As Boolean = False
                        'check if axismarker is present for series
                        'For Each xm As AxisMarker In ch.XAxis.Markers
                        '    If distinctTarget(cmbObjectTreeStats.Text).Contains(distinctTarget(cmbObjectTreeStats.Text)) And tsmi_StatsHistogramAggOrNoAgg.Checked = True Then
                        '        cl = xm.Line.Color
                        '        xmIsPresent = True
                        '    End If
                        'Next

                        'If xmIsPresent = False Then
                        cl = Color.FromArgb(255, rnd.Next(255), rnd.Next(255), rnd.Next(255))
                        'End If

                        scHisto(0).Type = SeriesType.Bar
                        scHisto(0).YAxis = yaxis1pdf
                        scHisto(0).Name = distinctTarget(cmbObjectTreeStats.Text) + "-" + scHisto(0).Name
                        scHisto(0).DefaultElement.Color = cl

                        ch.ExtraChartAreas.Item(0).SeriesCollection.Add(scHisto(0))

                        scHisto(1).YAxis = yaxis2pdf
                        scHisto(1).Type = SeriesType.Line
                        scHisto(1).Line.Width = 3
                        scHisto(1).YAxis = yaxis2pdf
                        scHisto(1).DefaultElement.Color = Color.FromArgb(255, Math.Max(cl.R - 50, 0), Math.Max(cl.G - 50, 0), Math.Max(cl.B - 50, 0))
                        scHisto(1).EmptyElement.Mode = EmptyElementMode.Ignore
                        scHisto(1).Name = distinctTarget(cmbObjectTreeStats.Text) + "-" + scHisto(1).Name

                        ch.ExtraChartAreas.Item(0).SeriesCollection.Add(scHisto(1))


                    Next

                    ch.SeriesCollection.Clear()
                    ch.SeriesCollection.Add(sc)

                    'HideChartScaleIfNoDataPrdCalc(ch, dt_new)

                    sc = Nothing
                    de = Nothing

                    ch.RefreshChart()
                    ch.Visible = True
                    Dim tn As TreeNode = New TreeNode()
                    tn.Text = charttitle
                    tn.Tag = ch.Name

                    ReDim chart_elements(0)
                    ReDim chart_elementsYAxis(0)
                    ReDim chart_Eltype(0)
                    ReDim chart_ElColor(0)
                    ReDim chart_YaxisScale(1)
                    j = 0

                    Dim scc As SplitContainerControl = CType(ch.Parent.Parent.Parent, SplitContainerControl)
                    'CType(tp.Parent, XtraTabControl).SelectedTabPage = tp
                    scc.Panel1.Controls(scc.Panel1.Controls.Count - 1).Controls(ch.Name).Focus()
                End If

                'Charts_ResizeWidth_PrdCalc()

            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
            End Try
        Next

        dt_chart.Dispose()
        ds_chart.Dispose()
        dt_chart = Nothing
        ds_chart = Nothing
        If Not dt Is Nothing Then
            dt.Dispose()
        End If

        If dtPrdCalcStats.Rows.Count = 1 Then
            'Adding Shade to the chart for the period1
            Dim shadePrd1 As AxisMarker = Nothing
            shadePrd1 = New AxisMarker(dtPrdCalcStats.Rows(0)("PeriodName").ToString, New Background(Color.FromArgb(100, Color.LightGreen)), CDate(dtPrdCalcStats.Rows(0)("PeriodStart")), CDate(dtPrdCalcStats.Rows(0)("PeriodEnd")))
            shadePrd1.LegendEntry.Visible = False
