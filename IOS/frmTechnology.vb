    Private Sub ProcessStatsObjectTime_Eval(tech As String)
        Try
            Dim connstring As String = Nothing

            'Constructing STATS SQL
            '***********************
            Dim aggr_from As String = ""
            aggr_from = tcTabControlHighStats.SelectedTabPage.Text

            If aggr_from = "" Then
                lblObjTreeStatusEval.Text = "Choose Source Type!"
                lblObjTreeStatusEval.ForeColor = Color.Red
                Exit Sub
            End If

            Dim sql_all As Specialized.StringCollection = New Specialized.StringCollection()
            Dim sql_crosstabobj As New List(Of String)
            Dim sql_obj As New List(Of String)
            Dim sql_tables As String
            'get list of tables

            'get KPI sql
            Using conn_el As New Odbc.OdbcConnection(connStrIOSServer)
                conn_el.ConnectionTimeout = 5
                conn_el.Open()

                For Each ChartKpi As String In lstTimeBasedKPIEval
                    sql_tables = clsSQLCommands.GetProcessStatsQuery(tech, ChartKpi)

                    Using comm_Element As New Odbc.OdbcCommand(sql_tables, conn_el)
                        'Dim dr As Odbc.OdbcDataReader = comm_Element.ExecuteReader
                        Dim sourcetable As String = ""
                        Dim aliastable As String = ""
                        Dim joinobjects As String = ""
                        Dim lst_sqlCounterTypes As New List(Of String)

                        Dim lstOfSelectedCounterTypes As New List(Of String)
                        For Each srcbtn As SourceButton In flpSourceBtn_GetChecked(_strNetwork, flpCounterTypeStats)
                            lstOfSelectedCounterTypes.Add(srcbtn.SourceButtonText)
                        Next

                        Using dr As Odbc.OdbcDataReader = comm_Element.ExecuteReader
                            While dr.Read
                                If lstOfSelectedCounterTypes.Contains(dr("Object").ToString.ToUpper) Then
                                    'getting threshold and evaluation period sql
                                    sourcetable = nZ(dr.GetValue(0).ToString.Trim, "")
                                    joinobjects = nZ(dr.GetValue(1).ToString.Trim, "")
                                    sql_crosstabobj.Add(nZ(dr.Item("CrossTabObj"), "").ToString.Trim)
                                    sql_obj.Add(ChartKpi)
                                    aggr_from = nZ(dr.GetValue(3).ToString.Trim, "")
                                    sql_all.Add(SQL_Construct_ObjectTime_Eval(aggr_from, sourcetable, ChartKpi, "Threshold") & ";" & SQL_Construct_ObjectTime_Eval(aggr_from, sourcetable, ChartKpi, "Evaluation"))
                                    lst_sqlCounterTypes.Add(dr("Object").ToString)

                                    'getting evaluation period sql
                                    'sourcetable = nZ(dr.GetValue(0).ToString.Trim, "")
                                    'joinobjects = nZ(dr.GetValue(1).ToString.Trim, "")
                                    'sql_crosstabobj.Add(nZ(dr.Item("CrossTabObj"), "").ToString.Trim)
                                    'sql_obj.Add(ChartKpi)
                                    'aggr_from = nZ(dr.GetValue(3).ToString.Trim, "")
                                    'sql_all.Add(SQL_Construct_ObjectTime_Eval(aggr_from, sourcetable, ChartKpi, "Evaluation"))
                                    'lst_sqlCounterTypes.Add(dr("Object").ToString)
                                End If
                            End While
                        End Using
                    End Using
                Next
            End Using
            'loop through all tables

            If sql_all.Count = 0 Then
                btnApplyEval.PerformClick() 'aborting
                Exit Sub
            End If

            connstring = connectionString
            Threads_Fired = 0
            dsEval_Histogram = New DataSet()
            ds_eval_hist_list.Clear()
            t_list.Clear()
            mm.ReleaseMemory()

            '*****************************
            For Each sql_to_fire As String In sql_all
                Dim eval_t As New Thread_Stats
                eval_t.connstring = connstring
                eval_t.sql_total = sql_to_fire
                eval_t.ds_name = sql_obj(Threads_Fired)
                AddHandler eval_t.ThreadComplete, AddressOf Process_Eval_ObjectTime_ThreadEnd

                Dim thread_x = New Threading.Thread(AddressOf eval_t.GetData)
                thread_x.Start()
                t_list.Add(thread_x)
                Threads_Fired = Threads_Fired + 1
            Next

            lblObjTreeStatusEval.Text = "Query Started..."
            lblObjTreeStatusEval.ForeColor = Color.Black

            'End If

        Catch ex As Exception
            lblObjTreeStatusEval.Text = "Failed...Try Again"
            lblObjTreeStatusEval.ForeColor = Color.Red
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
        End Try
    End Sub

    Private Function SQL_Construct_ObjectTime_Eval(objtype As String, aliastable As String, kpiname As String, calcPeriod As String) As String
        Dim tech As String = _strNetwork
        Dim sql_select As String = Nothing
        Dim sql_where_misc As String = ""
        Dim sql_where_object As String = ""
        Dim sql_where_tables As String = ""
        Dim sql_where_period As String = ""
        Dim sql_where_paramfilter As String = ""
        Dim sql_groupby As String = Nothing
        Dim sql_orderby As String = Nothing
        Dim sql_from_time As String = Nothing
        Dim sql_kpi As String = Nothing
        Dim sql_total As String = Nothing
        Dim aggr_from As String = Nothing
        'setting fixed time interval of 8 days
        Dim startdate As Date = Nothing
        Dim enddate As Date = Nothing
        startdate = dtEditStartTimeEval.EditValue
        enddate = dtEditEndTimeEval.EditValue

        Dim startdate_string As String = Chr(39) & startdate.ToString("yyyy-MM-dd HH:mm") & Chr(39)
        Dim enddate_string As String = Chr(39) & enddate.ToString("yyyy-MM-dd HH:mm") & Chr(39)
        Dim filterPeriodstring As String = GetFilterPeriodEval(cmbPredefinedFilterEval, dateNavigatorEval)
        Dim conn_el As Odbc.OdbcConnection = Nothing
        Dim comm_sql As Odbc.OdbcCommand = Nothing
        Dim comm_Element As Odbc.OdbcCommand = Nothing
        Dim dr_sql As Odbc.OdbcDataReader = Nothing
        Dim dr_element As Odbc.OdbcDataReader = Nothing
        Dim sqlelement As String = Nothing
        Dim sql_sql As String = Nothing

        Try
            'Open connection to server
            conn_el = New Odbc.OdbcConnection(connStrIOSServer)
            conn_el.ConnectionTimeout = 5
            conn_el.Open()

            'if aliastable is nothing and chartname is not, then get the aliastable (used for sql building based on chart)

            'objecttree selection to string
            Dim objectsel As String = ""

            If Export2Excel = True Then
                Dim checkNodesCount As Integer = tvObjectsTreeEval.GetEndCheckedNodes().Count
                Dim totalNodesCount As Integer = tvObjectsTreeEval.GetNodeList().Where(Function(x) x.Nodes.Count = 0).Count
                If checkNodesCount = totalNodesCount And tvObjectsTreeEval.FindFilterText = "" Then
                    objectsel = ""
                Else
                    objectsel = tvObjectsTreeEval.GetChecked2String(tech, cmbObjectTreeEval.Text, "ObjectID", strTreeFilterEval)
                End If
            Else
                objectsel = tvObjectsTreeEval.GetChecked2String(tech, cmbObjectTreeEval.Text, "ObjectID", strTreeFilterEval)
                If cmbObjectTreeEval.Text = "PLMN" Then objectsel = "IN('PLMN')"
                If objectsel = "IN ()" Then
                    lblObjTreeStatusEval.Text = "Error Building Query ! No Objects ..."
                    lblObjTreeStatusEval.ForeColor = Color.Red
                    Return Nothing
                End If
                ObjectsCharted = tvObjectsTreeEval.GetChecked2String(tech, cmbObjectTreeEval.Text, "ObjectName", strTreeFilterEval).Substring(4).TrimEnd(")")

                If tsmi_ObjectAggregationOnOff.Checked = False Then
                    ObjectsCharted = "IN('" & CType(cm_Chart_Sourcecontrol, Chart).Title.Split("'")(1) & "')"
                    objectsel = ObjectsCharted
                End If
            End If

            'set aggr_to
            Dim aggr_to As String = cmbObjectTreeEval.Text

            Dim CMFilter As String = Nothing
            Dim tagid As String = Nothing
            Dim RegionFilter As String = ""
            If aggr_to = "TAGS" Then
                ObjectsCharted = tagid
                ' ObjectsCharted = tvObjectsTreeEval.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()(0).Item(2)
                'tagid = tvObjectsTreeEval.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()(0).Item(0)
                For Each tln As TreeListNode In tvObjectsTreeEval.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()
                    ObjectsCharted = ObjectsCharted + tln.Item(2) + ","
                    tagid = tagid + tln.Item(0) + ","
                Next
                tagid = "IN(" + tagid.TrimEnd(",") + ")"
                ObjectsCharted = ObjectsCharted.TrimEnd(",")

                aggr_to = "TAGS_" + tvObjectsTreeEval.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()(0).Item(3)
                If aggr_to.Contains("CM") Then
                    CMFilter = tvObjectsTreeEval.GetChecked2String(tech, cmbObjectTreeEval.Text, "TAGS_CM", strTreeFilterEval)
                    ObjectsCharted = "TAGS CM: " & ObjectsCharted + ": " + tvObjectsTreeEval.GetChecked2String(tech, cmbObjectTreeEval.Text, "Naked", strTreeFilterEval)
                End If
                If aggr_to.Contains("Region") Then
                    RegionFilter = tvObjectsTreeEval.GetChecked2String(tech, "TAGS_Region", "ObjectName", strTreeFilterEval)
                End If
            End If
            Dim purpose As String = "ObjectTime"
            reportChartPurpose = purpose

            Dim chartname As String = Nothing
            If cm_Chart_ObjectCompareOrMapKPI = "tsmi_EvalHistogramOfCells" Then
                aggr_from = objtype
                chartname = ""
                purpose = "ObjectTimeBreak"
            Else
                aggr_from = "%"
            End If

            If objTechExportOption IsNot Nothing Then
                If ((Export2Excel = True) AndAlso (objTechExportOption.CellBasedExport = True)) Then
                    aggr_from = objtype
                    purpose = "ObjectTimeBreak"
                End If
            End If

            Dim StringForSourceTable As String = ""
            'get sql
            sql_sql = clsSQLCommands.GetConstructStatsSQL(tech, purpose, aggr_to, aggr_from, objtype)
            comm_sql = New Odbc.OdbcCommand(sql_sql, conn_el)
            dr_sql = comm_sql.ExecuteReader
            sql_from_time = ""


            dr_sql.Read()

            If Not dr_sql.HasRows = 0 Then
                sql_select = dr_sql("sql_select").ToString.Trim

                If cm_Chart_ObjectCompareOrMapKPI = "tsmi_ChartCompareElementsGroupBy" Then
                    sql_select = sql_select.Split(",")(0) & ", " & cm_Chart_GroupByName & ", "
                End If

                aggr_from = dr_sql("Aggregate_From").ToString.Trim
                If rdoHourlyEval.Checked = True Or xtcPSFilterEval.SelectedTabPage.Text = "Hours" Then
                    sql_from_time = " " & dr_sql("sql_time_hour").ToString.Trim
                    connectionString = dr_sql("sql_time_hour_connStr").ToString.Trim

                ElseIf rdoDailyEval.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_day").ToString.Trim
                    connectionString = dr_sql("sql_time_day_connStr").ToString.Trim

                ElseIf rdoDailyBHEval.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_bh").ToString.Trim
                    connectionString = dr_sql("sql_time_bh_connStr").ToString.Trim

                ElseIf rdoWeeklyEval.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_week").ToString.Trim
                    connectionString = dr_sql("sql_time_week_connStr").ToString.Trim

                ElseIf rdoDailyBH2Eval.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_bh").ToString.Trim
                    connectionString = dr_sql("sql_time_bh_connStr").ToString.Trim

                ElseIf rdoRawEval.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_raw").ToString.Trim
                    connectionString = dr_sql("sql_time_raw_connStr").ToString.Trim

                ElseIf rdoMonthlyEval.Checked = True Then
                    sql_from_time = " " & dr_sql("sql_time_month").ToString.Trim
                    connectionString = dr_sql("sql_time_month_connStr").ToString.Trim

                End If

                If objTechExportOption IsNot Nothing Then
                    If ((Export2Excel = True) AndAlso (objTechExportOption.WholePeriodAggr = True)) Then
                        Dim ix1 As Int16 = sql_select.ToLower.IndexOf(".period")
                        Dim ix2 As Int16 = sql_select.Substring(0, ix1).LastIndexOf(" ")

                        Dim tableAlias As String = sql_select.Substring(ix2, ix1 - ix2).Trim
                        Dim periodName As String = ""
                        periodName = sql_select.Substring(ix2, tableAlias.Length + 1 + 18).Trim

                        If tableAlias <> "" Then
                            sql_select = sql_select.Replace(periodName + " as Date", "MIN(" + periodName + ") as StartDate, MAX(" + periodName + ") as EndDate, Count(*) as CountOfPeriods")
                        Else
                            sql_select = sql_select.Replace("SELECT ", "SELECT MIN(@alias.Period_Start_Time) as StartDate, MAX(@alias.PERIOD_START_TIME) as EndDate, Count(*) as CountOfPeriods,")
                        End If
                    End If
                End If

                If rdoHourlyEval.Checked = True Or xtcPSFilterEval.SelectedTabPage.Text = "Hours" Then
                    StringForSourceTable = "_HOUR"
                ElseIf rdoDailyEval.Checked = True Then
                    StringForSourceTable = "_DAY"
                ElseIf rdoDailyBHEval.Checked = True Then
                    StringForSourceTable = "_BH"
                ElseIf rdoWeeklyEval.Checked = True Then
                    StringForSourceTable = "_WEEK"
                ElseIf rdoDailyBH2Eval.Checked = True Then
                    StringForSourceTable = "_BHPS"
                ElseIf rdoRawEval.Checked = True Then
                    StringForSourceTable = "_RAW"
                ElseIf rdoMonthlyEval.Checked = True Then
                    StringForSourceTable = "_MONTH"
                End If

                sql_where_misc = " " & dr_sql("sql_where_misc").ToString.Trim

                If cmbObjectTreeEval.Text = "PLMN" Then 'Or cm_Chart_ObjectCompareOrMapKPI = "tsmi_Chart_MapKPI" Then
                    sql_where_object = " " & Replace(dr_sql("sql_where_object").ToString, "@object", " LIKE '%' ").ToString.Trim
                Else
                    sql_where_object = " " & Replace(dr_sql("sql_where_object").ToString, "@object", objectsel).ToString.Trim
                End If

                'If (Export2Excel = True) AndAlso (objectsel = "") Then
                '    If sql_where_misc.Contains("WHERE") Then
                '        sql_where_object = ""
                '    Else
                '        sql_where_object = " WHERE 1=1 "
