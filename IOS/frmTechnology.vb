    Private Sub gvEvalCompare_RowCellStyle(sender As Object, e As RowCellStyleEventArgs)
        Try
            If Not dtEvalTBCompare Is Nothing Then
                Dim drCompare As DataRow = Nothing
                drCompare = gvEvalCompare.GetDataRow(e.RowHandle)

                If Not drCompare Is Nothing Then
                    If Not IsDBNull(e.CellValue) Then
                        If e.Column.FieldName = "EvaluationKPIValue" Then
                            If Not IsDBNull(drCompare("Operator")) Then
                                If drCompare("Operator") = "<" Then

                                    If (CDbl(e.CellValue) < CDbl(drCompare("FailureValue"))) Then
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorFailure")))
                                    ElseIf CDbl(e.CellValue) < CDbl(drCompare("ThresholdKPIValue")) Then
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorWarning")))
                                    Else
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorNormal")))
                                    End If

                                ElseIf drCompare("Operator") = ">" Then

                                    If (CDbl(e.CellValue) > CDbl(drCompare("FailureValue"))) Then
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorFailure")))
                                    ElseIf CDbl(e.CellValue) > CDbl(drCompare("ThresholdKPIValue")) Then
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorWarning")))
                                    Else
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorNormal")))
                                    End If

                                ElseIf drCompare("Operator") = "=" Then

                                    If (CDbl(e.CellValue) = CDbl(drCompare("FailureValue"))) Then
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorFailure")))
                                    ElseIf CDbl(e.CellValue) = CDbl(drCompare("ThresholdKPIValue")) Then
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorWarning")))
                                    Else
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorNormal")))
                                    End If

                                ElseIf drCompare("Operator") = "<>" Then

                                    If (CDbl(e.CellValue) <> CDbl(drCompare("FailureValue"))) Then
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorFailure")))
                                    ElseIf CDbl(e.CellValue) <> CDbl(drCompare("ThresholdKPIValue")) Then
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorWarning")))
                                    Else
                                        e.Appearance.BackColor = ColorInt2Color(CInt(drCompare("ColorNormal")))
                                    End If

                                End If
                            End If
                        End If
                    End If
                End If
            End If
