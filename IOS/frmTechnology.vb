    Private Sub frmTechnology_Shown(sender As Object, e As EventArgs) Handles MyBase.Shown
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Try
            xtcTechnology.Images = imgListVendors
            Me.ConfigureTechnologyForm("frmTechnology")
            _dsIOSObjectTypes = clsSQLCommands.GetObjectConfigurationData(connStrIOSServer, Nothing, Me.VendorName)

            If _dsIOSObjectTypes IsNot Nothing AndAlso _dsIOSObjectTypes.Tables(0).AsEnumerable().Where(Function(x) x.Field(Of String)("tech").ToUpper = _strNetwork.ToUpper).Count > 0 Then
                dtChartSetName = GetTechChartSetName()
                dtChartSetNameTopX = GetTechChartSetName("TopX_")
                InitializeTabs(_strNetwork, _techInternal)
            Else
                XtraMessageBox.Show("Data is not available for " & Me.VendorName & " " & _strNetwork, "Information", MessageBoxButtons.OK, MessageBoxIcon.Information)
            End If
            Me.ribbonControl.Minimized = True
            tsmi_EvalHistogramAggOrNoAgg = New ToolStripMenuItem()
            tsmi_EvalHistogramAggOrNoAgg.Checked = True
            tsmi_EvalHistogramAggOrNoAgg.CheckState = CheckState.Checked

            tsmi_EvalHistogramPeriodSelection = New ToolStripMenuItem()
            tsmi_EvalHistogramPeriodSelection.Checked = True
            tsmi_EvalHistogramPeriodSelection.CheckState = CheckState.Checked
            AddHandler cmChartLegendBox.Opening, AddressOf cmChartLegendBox_Opening
            AddHandler tbChartHeightEvalHistogram.EditValueChanged, AddressOf tbChartHeightEvalHistogram_EditValueChanged
            AddHandler splitCCStats.SplitterPositionChanged, AddressOf splitCCStats_SplitterPositionChanged
            AddHandler MyBase.FormClosed, AddressOf frmTechnology_InstanceClosed
            AddHandler xtcTechnology.SelectedPageChanged, AddressOf TechnologyTabControl_SelectedPageChanged
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
    End Sub

    Private Sub TechnologyTabControl_SelectedPageChanged(sender As Object, e As TabPageChangedEventArgs)
        If xtcTechnology.SelectedTabPageIndex = 2 Then
            If dtPrdCalcEval.Rows.Count = 0 Then
                Dim today As Date = Date.Today

                ' Get current week's Monday
                Dim daysFromMonday As Integer = (CInt(today.DayOfWeek) + 6) Mod 7
                Dim currentWeekMonday As Date = today.AddDays(-daysFromMonday)

                ' One week ago
                Dim oneWeekAgoMonday As Date = currentWeekMonday.AddDays(-7)
                Dim oneWeekAgoSunday As Date = oneWeekAgoMonday.AddDays(6)

                ' Two weeks ago
                Dim twoWeeksAgoMonday As Date = currentWeekMonday.AddDays(-14)
                Dim twoWeeksAgoSunday As Date = twoWeeksAgoMonday.AddDays(6)

                'Add 1st period
                Dim dr1 As DataRow = dtPrdCalcEval.NewRow()
                dr1("PeriodName") = "Two Weeks Ago"
                dr1("PeriodStart") = CDate(twoWeeksAgoMonday).ToString("yyyy-MM-dd")
                dr1("PeriodEnd") = CDate(twoWeeksAgoSunday).ToString("yyyy-MM-dd")
                dtPrdCalcEval.Rows.Add(dr1)
                dtPrdCalcEval.AcceptChanges()

                'Add 2nd period
                Dim dr2 As DataRow = dtPrdCalcEval.NewRow()
                dr2("PeriodName") = "One Week Ago"
                dr2("PeriodStart") = CDate(oneWeekAgoMonday).ToString("yyyy-MM-dd")
                dr2("PeriodEnd") = CDate(oneWeekAgoSunday).ToString("yyyy-MM-dd")
                dtPrdCalcEval.Rows.Add(dr2)
                dtPrdCalcEval.AcceptChanges()

                IOSDevExpressGrid.PopulateDataInGrid(gcPrdCalcEval, gvPrdCalcEval, dtPrdCalcEval, "ALL", Nothing, "PeriodName", "yyyy-MM-dd")

                Dim dtEditPrdStart As New RepositoryItemDateEdit()
                dtEditPrdStart.Mask.EditMask = "yyyy-MM-dd"
                dtEditPrdStart.Mask.UseMaskAsDisplayFormat = True
                gvPrdCalcEval.Columns("PeriodStart").ColumnEdit = dtEditPrdStart

                Dim dtEditPrdEnd As New RepositoryItemDateEdit()
                dtEditPrdEnd.Mask.EditMask = "yyyy-MM-dd"
                dtEditPrdEnd.Mask.UseMaskAsDisplayFormat = True
                gvPrdCalcEval.Columns("PeriodEnd").ColumnEdit = dtEditPrdEnd
            End If
            dtEditStartTimeEval.EditValue = CDate(dtPrdCalcEval.Rows(0)("PeriodStart"))
        End If
    End Sub

    Private Sub frmTechnology_InstanceClosed(sender As Object, e As FormClosedEventArgs)
        Dim closedFrm = TryCast(sender, frmTechnology)
        If closedFrm Is Nothing Then Return

        ' Remove by reference — this removes THAT exact instance even if many others share vendor/tech
        If dicFrmTechInstances.ContainsKey(closedFrm.InstanceKey) Then
            dicFrmTechInstances.Remove(closedFrm.InstanceKey)
            objFrmTechList.Remove(closedFrm)
        End If
    End Sub

    Public Function GetTechChartSetName(Optional prefix As String = Nothing) As DataTable
        Dim strConnection As String = Nothing
        Dim sqlParam As String = Nothing
        Dim parray()() As String = {
            New String() {"@LicenseUser", Chr(39) & Environment.UserName & Chr(39)},
            New String() {"@TechTab", IIf(prefix IsNot Nothing, Chr(39) & prefix & _strNetwork & Chr(39), Chr(39) & _strNetwork & Chr(39))}
        }
        strConnection = GetSQL(2001, parray)(0)
        sqlParam = GetSQL(2001, parray)(1)
        Return DataAccessorODBC.GetDataTable(strConnection, sqlParam, iQryTimeOut)
    End Function

