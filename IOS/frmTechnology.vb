                        End If
                        If dt_chart.AsEnumerable().Where(Function(m) m.Field(Of Integer)("ChartType") = IOSChartType.Scatter And m.Field(Of String)("ChartName") = lastchart).ToArray()(1)("ElementAxis") = "X" Then
