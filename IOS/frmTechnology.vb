    Public Sub ReleaseMemoryOfTechnologyStatsInstance()
        Try
            tcTabControlHighStats.Tag = Nothing
            DefaultSeriesCollectionStats.Clear()
            ExtraLegendEntryCollectionStats.Clear()
            HiddenSeriesCollectionStats.Clear()

            If Not dsStats Is Nothing Then
                dsStats.Dispose()
                dsStats = Nothing
            End If
            If Not dsStats_ObjectTime Is Nothing Then
                dsStats_ObjectTime.Dispose()
                dsStats_ObjectTime = Nothing
            End If
            If Not dsStats_ObjectTime_Stored Is Nothing Then
                dsStats_ObjectTime_Stored.Dispose()
                dsStats_ObjectTime_Stored = Nothing
            End If
            If Not dtStats_ObjectTime Is Nothing Then
                dtStats_ObjectTime.Dispose()
                dtStats_ObjectTime = Nothing
            End If

            If tcTabControlHighStats.Controls.Count > 0 Then
                If tcTabControlHighStats.Controls(0).Controls.Count > 0 Then
                    Dim tp As XtraTabPage = DirectCast(tcTabControlHighStats.Controls(0), XtraTabPage)
                    Dim xtc As XtraTabControl = Nothing
                    xtc = DirectCast(tp.Controls(0), XtraTabControl)
                    xtc.SuspendLayout()
                    For Each xtp As XtraTabPage In xtc.TabPages
                        Charts_ClearSeries(xtp)
                    Next
                    xtc.ResumeLayout()
                End If
            End If

            gcChartsStats.DataSource = Nothing
            gcChartsStats.Refresh()

        Catch ex As Exception
        Finally
            mm.ReleaseMemory()
        End Try
