    Public Sub FiltersInitialize()
        Dim col1 As TreeListViewColumn = New TreeListViewColumn("Drag KPI", "")
        Dim col2 As TreeListViewColumn = New TreeListViewColumn("Op", "")
        Dim col3 As TreeListViewColumn = New TreeListViewColumn("Value", "")
        col1.Width = 160
        col2.Width = 30
        col3.Width = 40
        Try
            If tlvFiltersTopX.Columns.Count = 0 Then
                tlvFiltersTopX.Columns.Clear()
                tlvFiltersTopX.Columns.Add(col1)
                tlvFiltersTopX.Columns.Add(col2)
                tlvFiltersTopX.Columns.Add(col3)
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try

        tlvFiltersTopX.AllowDrag = True
        tlvFiltersTopX.AllowDrop = True
        tlvFiltersTopX.DragDropMode = LidorSystems.IntegralUI.DragDropMode.Custom
        tlvFiltersTopX.LabelEdit = True

        'Filling combo box
        KPI_FilterTemplate_Reload("TopX_" & _strNetwork, 0)
        Dim parray()() As String = {New String() {"@techtab", Chr(39) & "TopX_" & _strNetwork & Chr(39)}}
        Dim dsFilter As DataSet = New System.Data.DataSet
        Dim sqlAndConnectionStr() As String = GetSQL(1072, parray, dt_IOS_SQL)
        dsFilter = DataAccessorODBC.GetDataSet(sqlAndConnectionStr(0), sqlAndConnectionStr(1), iQryTimeOut)
        If dsFilter Is Nothing Then
            Exit Sub
        End If

        Try
            lbcKPIListTopX.Items.Clear()
            lbcKPIListTopX.DisplayMember = "KPI_Name"
            lbcKPIListTopX.ValueMember = "SQLKPI_ID"
            lbcKPIListTopX.DataSource = dsFilter.Tables(0)
            cmbTemplateTopX.Tag = _strNetwork
            btnKPIFilterSaveTopX.Tag = _strNetwork
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
        dsFilter.Dispose()
        dsFilter = Nothing
    End Sub

    Private Sub BindFilterCombo(ByRef cmb As ComboBoxEdit, ByRef dt As DataTable, valueField As String, textfield As String, selectedIndex As Integer)
        RemoveHandler cmbTemplateTopX.SelectedValueChanged, AddressOf cmbTemplateTopX_SelectedValueChanged
        If Not dt Is Nothing Then
            cmb.Properties.Items.Clear()
            For Each drow As DataRow In dt.Rows
