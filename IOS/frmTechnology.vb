    Private Function GetFilterPeriodTopX(ByRef cmb As ComboBoxEdit, ByRef dNavigator As DevExpress.XtraScheduler.DateNavigator) As String
        Try
            Dim SQL As String = ""
            If cmb.SelectedIndex > 0 Then
                Dim cmbVal As Integer = TryCast(cmb.SelectedItem, clsComboBoxItem).Value
                Dim dr() As DataRow = dtPredefinePeriod.AsEnumerable().Where(Function(x) x.Field(Of Integer)("PredefinedPeriodID") = cmbVal).ToArray()
                If Not dr Is Nothing Then
                    If dr.Count > 0 Then
                        SQL = dr(0)("SQL").ToString
                    Else
                        SQL = "@filter"
                    End If
                Else
                    SQL = "@filter"
                End If
            Else
                SQL = "@filter"
            End If
            Dim filterPeriod As DevExpress.XtraScheduler.SchedulerDateRangeCollection
            filterPeriod = dNavigator.SelectedRanges

            If Not preSelectedFilterPeriodTopx Is Nothing Then
                For i As Integer = 0 To preSelectedFilterPeriodTopx.Count - 1
                    If Not filterPeriod.Contains(preSelectedFilterPeriodTopx(i)) Then
                        filterPeriod.Add(preSelectedFilterPeriodTopx(i))
                    End If
                Next
            End If

            If xtcPSFilterTopX.SelectedTabPage.Text = "Hours" Then
                filterPeriod.Clear()
                Dim endDate As DateTime = deEndTimeTopX.DateTime.AddDays(1)
                filterPeriod.Add(New DateRange(deStartTimeTopX.EditValue, endDate))
            End If

            Dim flag As Boolean = False
            HourListTopX.Clear()
            If xtcPSFilterTopX.SelectedTabPage.Text = "Hours" Then
                For Each btnToggle As Control In tlpFilterHoursTopX.Controls
                    If CType(btnToggle, IOSToggleButton).ToggleState = CheckState.Checked Then
                        HourListTopX.Add(btnToggle.Tag)
                    Else
                        HourListTopX.Remove(btnToggle.Tag)
                    End If
                Next
                If rdoFilterHrsIncTopX.Checked Or rdoFilterHrsExcTopX.Checked Then
                    flag = True
                End If
            Else
                If rdoFilterDaysIncTopX.Checked Or rdoFilterDaysExcTopX.Checked Then
                    flag = True
                End If
            End If

            Dim filterQry As String = ""
            If flag Then
                For Each dt As DateRange In filterPeriod
                    If dt.StartDate.Date.CompareTo(dt.EndDate.Date.AddDays(-1)) = 0 Then
                        If xtcPSFilterTopX.SelectedTabPage.Text = "Hours" Then
                            For Each tString As String In HourListTopX
                                filterQry = filterQry & "'" & dt.StartDate.ToString("yyyy-MM-dd " & tString & ":00") & "',"
                            Next
                        Else
                            filterQry = filterQry & "'" & dt.StartDate.ToString("yyyy-MM-dd 00:00") & "',"
                        End If
                        Continue For
                    Else
                        Dim sDate As Date = dt.StartDate
                        Dim eDate As Date = dt.EndDate
                        While sDate <= eDate
                            If xtcPSFilterTopX.SelectedTabPage.Text = "Hours" Then
                                For Each tString As String In HourListTopX
                                    filterQry = filterQry & "'" & sDate.ToString("yyyy-MM-dd " & tString & ":00") & "',"
                                Next
                            Else
                                If Not filterQry.Contains(sDate.ToString("yyyy-MM-dd 00:00")) Then
                                    filterQry = filterQry & "'" & sDate.ToString("yyyy-MM-dd 00:00") & "',"
                                End If
                            End If
                            sDate = sDate.AddDays(1)
                        End While
                    End If
                Next
            End If
            filterQry = filterQry.TrimEnd(",") & ""
            If filterQry = "" Then
                SQL = SQL.Replace("@filter", "")
            Else
                If xtcPSFilterTopX.SelectedTabPage.Text = "Hours" Then
                    If rdoFilterHrsIncTopX.Checked Then
                        filterQry = " IN(" & filterQry & ")"
                    ElseIf rdoFilterHrsExcTopX.Checked Then
                        filterQry = " NOT IN(" & filterQry & ")"
                    End If
                Else
                    If rdoFilterDaysIncTopX.Checked Then
                        filterQry = " IN(" & filterQry & ")"
                    ElseIf rdoFilterDaysExcTopX.Checked Then
                        filterQry = " NOT IN(" & filterQry & ")"
                    End If
                End If

                SQL = SQL.Replace("@filter", " AND PERIOD_START_TIME " & filterQry)
            End If

            If xtcPSFilterTopX.SelectedTabPage.Text = "Hours" Then
                SQL = SQL.Replace("PERIOD_START_TIME", "DATEADD(hh, DATEDIFF(hh, 0, @alias.PERIOD_START_TIME ), 0) ")
            Else
                SQL = SQL.Replace("PERIOD_START_TIME", "DATEADD(dd, DATEDIFF(dd, 0, @alias.PERIOD_START_TIME ), 0) ")
            End If

            Return SQL
        Catch ex As Exception
            Return ""
        End Try
    End Function

