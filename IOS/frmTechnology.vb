		                    from #PMCDF 
		                    group by  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end " + targettype + IIf(datestringToAddToTargetType <> "", ", [Date] ", "") + "
                    ) z on k.BucketNumber=z.BucketNumber and " + targettype3 + "=" + Replace(targettype3, "k", "z") + "
                    where samplecount is not null
