    Public Sub Notes_Get(tech As String)
        Dim obj_sel As String = Nothing
        Try
            Dim list = tvObjectsTreeStats.GetAllCheckedNodes().Select(Function(nd) nd.Item("ObjectName")).ToArray()
            obj_sel = String.Join("','", list)
            obj_sel = " IN ('" & obj_sel & "')"
            'obj_sel = tvObjectsTreeStats.GetChecked2String(tech, cmbObjectTreeStats.Text, "ObjectName")
            Notes_Obj = obj_sel

            Dim lstObjType = tvObjectsTreeStats.GetAllCheckedNodes().Select(Function(nd) nd.Item("ObjectType")).ToArray()
            Dim drilledObjString As String = ""
            For iCntr As Integer = 1 To lstObjType.Length - 1
                If Not drilledObjString.Contains(lstObjType(iCntr)) Then
                    drilledObjString &= "'" & lstObjType(iCntr) & "',"
                End If
            Next
            If drilledObjString <> String.Empty Then
                drilledObjString = drilledObjString.TrimEnd(",")
            End If

            If obj_sel Is Nothing Then
                Exit Sub
            End If

            Dim noteObject As String = ""
            If cmbObjectTreeStats.Text = "PLMN" Then
                noteObject = " = '" & cmbObjectTreeStats.Text & "'"
            Else
                noteObject = " IN ('PLMN'," & drilledObjString & ")"
                '" IN ('PLMN', '" & cmbObjectTreeStats.Text & "')"
            End If

            'Dim dsQODBC As System.Data.DataSet = clsSQLCommands.GetTechnologyNotesData(connStrIOSServer, obj_sel, tech, noteObject)

            Dim strConnection As String = Nothing
            Dim sqlParam As String = Nothing
            Dim parray()() As String = {
                New String() {"@ObjName", IIf(obj_sel.ToUpper = " IN ()", Chr(39) & obj_sel & Chr(39), Chr(39) & obj_sel.Replace("'", "''") & Chr(39))},
                New String() {"@Tech", Chr(39) & tech & Chr(39)},
                New String() {"@NoteObject", Chr(39) & noteObject.Replace("'", "''") & Chr(39)}
            }
            strConnection = GetSQL(2500, parray)(0)
            sqlParam = GetSQL(2500, parray)(1)
            Dim dsQODBC As DataSet = DataAccessorODBC.GetDataSet(strConnection, sqlParam, iQryTimeOut)

            If Not dsQODBC Is Nothing Then
                Notes_DatagridUpdate(gcNotesStats, gvNotesStats, dsQODBC.Tables(0))
                AddChartAxisMarkers_New(dsQODBC.Tables(0), "Timestamp", "NoteType", "NoteType,ShortDescription")
            Else
                IOSDevExpressGrid.ClearGrid(gcNotesStats)
                Charts_AxisMarkers_Clear(_strNetwork)
            End If
            KPINotes_Get(grdKPINotesStats, gvKPINotesStats, tech)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "ERROR", ex.Message.ToString & " " & ex.StackTrace.ToString)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

    Private Sub Notes_DatagridUpdate(ByRef gc As GridControl, ByRef dgv As GridView, dt As DataTable)
        Try
            dgv.Columns.Clear()
            gc.DataSource = dt

            For Each dtCol As DataColumn In dt.Columns
                If dgv.Columns(dtCol.ColumnName) IsNot Nothing Then
                    If dgv.Columns(dtCol.ColumnName).Visible = True Then

                        If dtCol.DataType = GetType(DateTime) Then
                            dgv.Columns(dtCol.ColumnName).DisplayFormat.FormatType = DevExpress.Utils.FormatType.DateTime
                            dgv.Columns(dtCol.ColumnName).DisplayFormat.FormatString = "yyyy-MM-dd HH:mm:ss"
                        End If

                        dgv.Columns(dtCol.ColumnName).BestFit()
                        dgv.Columns(dtCol.ColumnName).FieldName = dtCol.ColumnName
                        dgv.Columns(dtCol.ColumnName).Caption = dtCol.ColumnName
                    End If
                End If
            Next

            dgv.Columns("NotesID").Width = 65
            dgv.Columns("Timestamp").Width = 105
            dgv.Columns("Username").Width = 80
            dgv.Columns("Tech").Width = 80
            dgv.Columns("NoteType").Width = 110
            dgv.Columns("Department").Width = 110
            dgv.Columns("ShortDescription").Width = 250
            dgv.Columns("LongDescription").Width = 500
            dgv.Columns("NoteTypeID").Visible = False

        Catch ex As Exception
        End Try
    End Sub

    Public Sub KPINotes_Get(ByRef _grdKPINotes As GridControl, ByRef _gvKPINotes As GridView, tech As String) 'TODO
        Dim myChart As Chart = cm_Chart_Sourcecontrol
        If (myChart IsNot Nothing) Then
            If (myChart.Tag.ToString.ToUpper = tech.ToUpper) Then
                Dim dsKPI As String = Me.GetChartsKPIID_String(myChart)
                BindKPINoteGrid(dsKPI, _grdKPINotes, _gvKPINotes)
                Dim dtKPI As DataTable = GetChartsKPI(myChart)
                If (dtKPI IsNot Nothing AndAlso dtKPI.Rows.Count > 0) Then
                    CreateXaxisMarkerForKPINotes(myChart, dtKPI)
                End If
            Else
                BindKPINoteGrid("0", _grdKPINotes, _gvKPINotes)
            End If
        Else
            BindKPINoteGrid("0", _grdKPINotes, _gvKPINotes)
        End If
    End Sub

    Public Function GetChartsKPI(ByRef myChart As dotnetCHARTING.WinForms.Chart)
        Dim tech As String = myChart.Tag
        Dim chartname As String = myChart.Name
        Return clsSQLCommands.GetChartConfigurationData(connStrIOSServer, tech, chartname, cmbChartSetNameStats.SelectedItem.ToString)
    End Function

    Public Function GetChartsKPIID_String(ByRef myChart As dotnetCHARTING.WinForms.Chart) As String
        Dim tech As String = myChart.Tag
        Dim chartname As String = myChart.Name
        Dim strKPI As String = Nothing
        Dim dt As DataTable = clsSQLCommands.GetChartConfigurationData(connStrIOSServer, tech, chartname, cmbChartSetNameStats.SelectedItem.ToString)
        If (dt.Rows.Count > 0) Then
            For Each dr As DataRow In dt.Rows
                strKPI = strKPI + "," & dr("SQLKPI_ID")
            Next
            strKPI = strKPI.Remove(0, 1).TrimEnd(",")
        End If
        dt.Dispose()
        dt = Nothing
        Return strKPI
    End Function

    Public Sub CreateXaxisMarkerForKPINotes(ByRef ch As dotnetCHARTING.WinForms.Chart, dtKPI As DataTable)
        Dim distKPI = dtKPI.DefaultView.ToTable(True, "ChartElements")
        Dim strKPI = String.Join(",", distKPI.AsEnumerable().Select(Function(w) "'" & w.Field(Of String)("ChartElements") & "'").ToArray())

        Dim dt As DataTable = clsSQLCommands.GetKPINotesData(connStrIOSServer, strKPI)
        If (dt.Rows.Count > 0) Then
            ch.XAxis.Markers.Clear()
            For Each drow As DataRow In dt.Rows
                Dim datestart As DateTime = Convert.ToDateTime(drow("NoteTimeStamp").ToString)
                Dim cl As Color = Color.Black
                Dim am4 As New AxisMarker(drow("NoteDescription").ToString, New Line(cl, 4), datestart)
                am4.LegendEntry.Visible = False
                am4.Label.Hotspot.ToolTip = drow("NoteDescription").ToString
                am4.Label.Color = Color.Empty
                am4.Label.Alignment = StringAlignment.Near
                am4.Label.LineAlignment = StringAlignment.Far
                am4.BringToFront = True
                ch.XAxis.Markers.Add(am4)
            Next
            ch.RefreshChart()
        End If
        _logger.SetLogInfo(System.Reflection.MethodBase.GetCurrentMethod().Name, "Exit CreateXaxisMarkerForKPINotes")
    End Sub

    Private Sub BindKPINoteGrid(kpiID As String, ByRef _grdTemp As GridControl, ByRef _gvTemp As GridView)
