            tsmi_MapKPIThemes.Enabled = True
            tsmi_MapKPIThemes.AutoSize = False
            tsmi_MapKPIThemes.Width = 180
            Dim defaultTheme As String = ""
            If dtMapKpiThemes IsNot Nothing AndAlso dtMapKpiThemes.Rows.Count > 0 Then
                For Each dr As DataRow In dtMapKpiThemes.Rows
                    tsmi_MapKPIThemes.Items.Add(dr("ThematicName"))
                    If dr("ThematicName") = "EqualCountRangeTheme" Then
                        defaultTheme = dr("ThematicName").ToString
                    End If
                Next
                If SelectedTheme Is Nothing Then
                    tsmi_MapKPIThemes.SelectedItem = defaultTheme
                Else
                    tsmi_MapKPIThemes.SelectedItem = SelectedTheme
                End If
            End If
            AddHandler tsmi_MapKPIThemes.SelectedIndexChanged, AddressOf tsmi_MapKPIThemes_SelectedIndexChanged
        End If
