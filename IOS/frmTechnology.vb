    Private Sub ProcessStatsSurfaceChart_Custom(ByRef ds As DataSet, chartTitle As String, chartSetName As String, ObjectName As String, dtChart As DataTable, ByRef ch As Chart, objectsCharted As String)
        Try
            System.Threading.Thread.CurrentThread.CurrentCulture = CultureInfoDefault
            System.Threading.Thread.CurrentThread.CurrentUICulture = CultureUIDefault

            Dim dtData As DataTable = New DataTable()
            dtData.Columns.Add("Date")

            Dim cols As New List(Of String)
            cols.Add("Date")

            For Each dr As DataRow In dtChart.Rows
                cols.Add(dr("ChartElements"))
            Next

            For Each dt As DataTable In ds.Tables
                If dt.TableName = ObjectName Then
                    dtData = dt.DefaultView.ToTable(True, cols.ToArray())
                End If
            Next

            ch.ClearAll()
            ch.TempDirectory = "temp"
            '         ch.Debug = True
            ch.Use3D = False
            ch.Type = ChartType.Surface
            ch.LegendBox.Visible = False
            ch.DefaultSeries.Type = SeriesTypeSurface.Surface
            ch.XAxis.FormatString = ""
            ch.MarginTop = 60
            ch.XAxis.TickLabelAngle = 0
            ch.TitleBox.HeaderLabel.Text = chartTitle
            ch.TitleBox.Orientation = Orientation.Top
            ch.XAxis.Scale = dotnetCHARTING.WinForms.Scale.Range
            ch.TitleBox.Label.Text = "Objects: " & objectsCharted
            ch.Type = ChartType.Surface

            ch.SeriesCollection.Clear()

            Dim sc As SeriesCollection = GetSurfaceChartData_Custom(dtData, ch)
            '   ch.SmartPalette = sc(0).GetSmartPalette(ElementValue.ZValue, Color.Blue, Color.Aqua, Color.LightGreen, Color.Yellow, Color.Orange, Color.Crimson)

            'Dim MinMax As String = FindMinMaxDataTableValue(dtData)

            ch.SmartPalette = SmartPalette.FromColorsRange(ElementValue.ZValue, New ScaleRange(-125, -70), Color.DarkBlue, Color.Blue, Color.Turquoise, Color.LimeGreen, Color.YellowGreen, Color.Yellow, Color.Gold, Color.Orange, Color.OrangeRed, Color.Red, Color.DarkRed)

            Dim an As Annotation = New Annotation(getSwatch(510, ch.SmartPalette, 10, False))
            an.Header.Label.Text = "<Chart:Scale min='" & ch.SmartPalette.GetScaleRange("*").ValueLow & "' max='" & ch.SmartPalette.GetScaleRange("*").ValueHigh & "' width='590' >"
            'an.Header.Label.Text = "<Chart:Scale min='-120' max='-40' width='600' >"
            an.ClearColors()
            ch.Annotations.Add(an)
            an.Position = New Point(25, 10)
            an.DynamicSize = False

            ch.SeriesCollection.Add(sc)
            sc(0).Line.Transparency = 80

            Dim j As Int16 = 1

            For Each dr As DataRow In dtData.Rows
                If j Mod CInt(dtData.Rows.Count() / 10) = 0 Then
                    Dim at As New AxisTick()
                    at.Value = CInt(CDate(dr("date")).ToOADate())
                    at.Label.Text = CDate(dr("date")).ToShortDateString
                    ch.YAxis.ExtraTicks.Add(at)
                End If

                j = j + 1

            Next

            ch.YAxis.DefaultTick.Label.Text = ""
            ch.XAxis.Markers.Clear()
            ch.RefreshChart()
            ch.Series.Data = dtData

            Charts_ResizeWidth()

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

    Function GetSurfaceChartData_Custom(ByRef dtData As DataTable, ByRef ch As Chart) As SeriesCollection
        Try
            Dim PRBCols As New List(Of Integer)
            Dim colParts() As String = Nothing
            Dim kpiFixPart As String = Nothing

            For Each col As DataColumn In dtData.Columns
                If col.ColumnName.Contains("PRB") Then
                    colParts = col.ColumnName.Split("_")
                    PRBCols.Add(CInt(colParts(colParts.Count - 1)))
                End If
            Next

            Dim PadLength As Int16 = 2
            If PRBCols.Count > 100 Then
                PadLength = 3
            End If

            '    UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "ColParts:" & PRBCols.Count & " PadLength:" & PadLength & " Sample:" & CStr(0).PadLeft(PadLength, "0"))

            For iCntr = 0 To colParts.Count - 1
                If iCntr <> colParts.Count - 1 Then
                    kpiFixPart &= colParts(iCntr) & "_"
                End If
            Next

            Dim size As Integer = dtData.Rows.Count
            Dim yAxis As New Axis()
            yAxis.Scale = dotnetCHARTING.WinForms.Scale.Range

            Dim xVals As Double() = New Double(PRBCols.Count - 1) {}
            Dim yVals As Double() = New Double(dtData.Rows.Count - 1) {}
            Dim zVals As Double()() = New Double(PRBCols.Count - 1)() {}

            For i As Integer = 0 To PRBCols.Count - 1

                zVals(i) = New Double(dtData.Rows.Count - 1) {}

                For j As Integer = 0 To dtData.Rows.Count - 1

                    Dim x As Double = CDbl(i)
                    xVals(i) = x

                    Dim y As Double = CDate(dtData.Rows(j)("Date")).ToOADate()
                    yVals(j) = y

                    yAxis.Label.Text = dtData.Rows(j)("Date").ToString

                    zVals(i)(j) = CDbl(IIf(IsDBNull(dtData.Rows(j)(kpiFixPart & CStr(i).PadLeft(PadLength, "0"))), 0, dtData.Rows(j)(kpiFixPart & CStr(i).PadLeft(PadLength, "0"))))

                Next j

            Next i

            Dim sc As SeriesCollection = New SeriesCollection()
            Dim s As Series = Series.FromSurfaceData("", xVals, yVals, zVals)

            sc.Add(s)

            ch.XAxis.Minimum = xVals(0)
            ch.XAxis.Maximum = xVals(xVals.Count - 1)
            ch.XAxis.Interval = 1
            ch.YAxis.Minimum = yVals(0)

            Return sc

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        Return Nothing
    End Function

    Function getSwatch(width As Integer, sp As SmartPalette, divisions As Integer, withValues As Boolean) As String
        ' Get Maximum Value of the smart palette range
        Dim max As Double = CDbl(sp.GetScaleRange("*").ValueHigh)
        Dim min As Double = CDbl(sp.GetScaleRange("*").ValueLow)
        Dim swatch As String = "", spacers As String = ""
        Dim [step] As Double = (max - min) / divisions
        ' Width of each division.
        Dim boxWidth As Integer = width / divisions
        ' Generate swatch string for each division.
        For i As Integer = 0 To divisions
            spacers &= "<Chart:Spacer size='" & boxWidth & "x1'>"
            ' Get the color of the current division.
            Dim color As String = getHTMLColor(sp.GetValueColor("", min + (i * [step])))
            If withValues Then
                swatch &= "<block hAlignment='Center' bgColor='" & color & "'>" & Math.Round(min + i * [step], 1)
            Else
                swatch &= "<block bgColor='" & color & "' fColor='" & color & "'>_"
            End If
        Next i
        'return the swatch string.
        Return spacers & "<row>" & swatch
    End Function

    Function getHTMLColor(c As Color) As String
        Return "#" & c.R.ToString("X2") + c.G.ToString("X2") + c.B.ToString("X2")
    End Function

