                    If tsmi_Chart_LaunchHistogramPeriodSelection.Checked = False Or Not cm_Chart_Sourcecontrol.Name.Contains("Histogram") Or tsmi_Chart_LaunchHistogramAggOrNoAgg.Checked = False Then
