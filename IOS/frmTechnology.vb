    Private Sub rdoDailyTopX_CheckedChanged(sender As Object, e As EventArgs) Handles rdoDailyTopX.CheckedChanged, rdoDailyBHTopX.CheckedChanged, rdoDailyBH2TopX.CheckedChanged, rdoWeeklyTopX.CheckedChanged, rdoMonthlyTopX.CheckedChanged
        Try
            Dim rdo As RadioButton
            rdo = CType(sender, System.Windows.Forms.RadioButton)

            deStartTimeTopX.Properties.CalendarTimeEditing = DevExpress.Utils.DefaultBoolean.False
            deEndTimeTopX.Properties.CalendarTimeEditing = DevExpress.Utils.DefaultBoolean.False

            If rdo.Checked Then
                If rdo.Text = "Daily" Or rdo.Text = "Daily BH - 1" Or rdo.Text = "Daily BH - 2" Then
                    deStartTimeTopX.EditValue = DateSerial(Now().Year, Now().Month, Now.Day - 1)
                    deEndTimeTopX.EditValue = DateSerial(Now().Year, Now().Month, Now.Day - 1)
                    SetCustomPeriodSelectionTopX("daily")
                ElseIf rdo.Text = "Monthly" Then
                    deStartTimeTopX.EditValue = DateSerial(Now().Year, Now().Month - 24, Now.Day)
                    deEndTimeTopX.EditValue = DateSerial(Now().Year, Now().Month, Now.Day)
                    SetCustomPeriodSelectionTopX("monthly")
                ElseIf rdo.Text = "Weekly" Then
                    SetCustomPeriodSelectionTopX("weekly")
                End If

                deStartTimeTopX.Properties.DisplayFormat.FormatString = "dd/MM/yyyy"
                deStartTimeTopX.Properties.EditFormat.FormatString = "dd/MM/yyyy"
                deStartTimeTopX.Properties.EditMask = "dd/MM/yyyy"

                deEndTimeTopX.Properties.DisplayFormat.FormatString = "dd/MM/yyyy"
                deEndTimeTopX.Properties.EditFormat.FormatString = "dd/MM/yyyy"
                deEndTimeTopX.Properties.EditMask = "dd/MM/yyyy"
            End If

            If chkEnableComparisonTopX.Checked = True Then
                SetTopXDeltaInterval()
            Else
                dtDeltaBefore.Clear()
                dtDeltaAfter.Clear()
            End If
            ccPSDeltaTopX.Refresh()
            cmbPredefinedFilterTopX.SelectedIndex = 0
            cmbPredefTimeTopX.Update()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
