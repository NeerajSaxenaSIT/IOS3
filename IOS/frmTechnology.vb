    Private Function GetChartScaleIsAuto(ByRef chObject As dotnetCHARTING.WinForms.Chart) As Boolean
        If (chartAxisScaleAdjust.Count > 0) Then
            If (chartAxisScaleAdjust.ContainsKey(chObject.TitleBox.HeaderLabel.Text.ToUpper)) Then
                For Each chName As KeyValuePair(Of String, Boolean) In chartAxisScaleAdjust
                    If (chName.Key.ToUpper = chObject.TitleBox.HeaderLabel.Text.ToUpper) Then
                        Return chName.Value
                    End If
                Next
            Else
                chartAxisScaleAdjust.Add(chObject.TitleBox.HeaderLabel.Text.ToUpper, True)
                Return True
            End If
        Else
            chartAxisScaleAdjust.Add(chObject.TitleBox.HeaderLabel.Text.ToUpper, True)
            Return True
        End If
        Return False
    End Function

