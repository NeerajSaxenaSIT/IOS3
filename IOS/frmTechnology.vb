    Private Sub SetTopXDeltaInterval()
        Try
            Dim txtvalue As String = ""
            For Each tlpCtrl As Control In ResolutionGroupBox_3GTopX.Controls
                If TypeOf tlpCtrl Is System.Windows.Forms.TableLayoutPanel Then
                    For Each rb As Control In TryCast(tlpCtrl, System.Windows.Forms.TableLayoutPanel).Controls
                        If TypeOf rb Is System.Windows.Forms.RadioButton Then
                            Dim rb1 As System.Windows.Forms.RadioButton = TryCast(rb, System.Windows.Forms.RadioButton)
                            If rb1.Checked = True Then
                                If rb1.Text.ToLower.Contains("raw") Or rb1.Text.ToLower.Contains("hourly") Then
                                    txtvalue = 24
                                ElseIf rb1.Text.ToLower.Contains("daily") Or rb1.Text.ToLower.Contains("bh") Then
                                    txtvalue = 7
                                ElseIf rb1.Text.ToLower.Contains("monthly") Then
                                    txtvalue = 12
                                Else
                                    txtvalue = 1
                                End If
                            End If
                        End If
                    Next
                End If
            Next
            txtDeltaIntervalTopX.Text = txtvalue
            SetDeltaVisualMark()
        Catch ex As Exception
        End Try
    End Sub

    Private Sub SetDeltaVisualMark()
        If chkEnableComparisonTopX.Checked = True Then
            Dim difDay As Integer
            difDay = DateDiff(DateInterval.Day, deStartTimeTopX.EditValue, deEndTimeTopX.EditValue)
            If difDay < Val(txtDeltaIntervalTopX.Text) Then
                Dim sDate As Date
                Dim eDate As Date
                If rdoRawTopX.Checked Or rdoHourlyTopX.Checked Then
                    sDate = deStartTimeTopX.EditValue.AddHours(Val(txtDeltaIntervalTopX.Text) * -1)
                    eDate = deEndTimeTopX.EditValue.AddHours(Val(txtDeltaIntervalTopX.Text) * -1)
                Else
                    sDate = deStartTimeTopX.EditValue.AddDays(Val(txtDeltaIntervalTopX.Text) * -1)
                    eDate = deEndTimeTopX.EditValue.AddDays(Val(txtDeltaIntervalTopX.Text) * -1)
                End If
                dtDeltaBefore.Clear()
                While sDate <= eDate
                    dtDeltaBefore.Add(sDate.Date)
                    sDate = sDate.AddDays(1)
                End While

                sDate = deStartTimeTopX.EditValue
                eDate = deEndTimeTopX.EditValue
                dtDeltaAfter.Clear()
                While sDate <= eDate
                    dtDeltaAfter.Add(sDate.Date)
                    sDate = sDate.AddDays(1)
                End While
            Else
                MsgBox("TopX delta before period and after periods are overlapped, please select different period. ", MsgBoxStyle.Information, Application.ProductName)
                txtDeltaIntervalTopX.Text = ""
                txtDeltaIntervalTopX.Focus()
                dtDeltaBefore.Clear()
                dtDeltaAfter.Clear()
            End If
        Else
            dtDeltaBefore.Clear()
            dtDeltaAfter.Clear()
        End If
        ccPSDeltaTopX.Refresh()
    End Sub

    Private Sub DeltaCalculation(ByRef ds As DataSet)
        Try
            Dim dt1_original As DataTable = ds.Tables(0).Copy
            Dim dt1 As DataTable = ds.Tables(0)
            Dim dt2 As DataTable = ds.Tables(1)

            Dim j As Integer = 0
            Dim primkeys_dt1() As DataColumn = Nothing
            Dim primkeys_dt2() As DataColumn = Nothing
            Dim primkeys_dt1_original() As DataColumn = Nothing

            For Each dc As DataColumn In dt1.Columns
                If dc.DataType = GetType(System.String) Then
                    ReDim Preserve primkeys_dt1(j)
                    primkeys_dt1(j) = dc
                    j = j + 1
                Else
                    dc.ColumnName = dc.ColumnName + "_Before"
                    dc.DefaultValue = 0
                End If
            Next
            For Each dc As DataColumn In dt2.Columns
                If dc.DataType = GetType(System.String) Then
                    ReDim Preserve primkeys_dt2(j)
                    primkeys_dt2(j) = dc
                    j = j + 1
                Else
                    dc.ColumnName = dc.ColumnName + "_After"
                    dc.DefaultValue = 0
                End If
            Next

            For Each dc As DataColumn In dt1_original.Columns
                If dc.DataType = GetType(System.String) Then
                    ReDim Preserve primkeys_dt1_original(j)
                    primkeys_dt1_original(j) = dc
                    j = j + 1
                End If
            Next

            dt1.PrimaryKey = primkeys_dt1
            dt2.PrimaryKey = primkeys_dt2
            dt1_original.PrimaryKey = primkeys_dt1_original

            Dim dt_delta As DataTable = dt1.Copy
            dt_delta.Merge(dt2)

            For j = 0 To dt_delta.Columns.Count - 1
                If dt_delta.Columns(j).DataType <> GetType(System.String) Then
                    If dt_delta.Columns(j).ColumnName.EndsWith("_Before") Then
                        Dim dc As DataColumn = New DataColumn(Replace(dt_delta.Columns(j).ColumnName, "_Before", ""))
                        dc.DataType = dt_delta.Columns(j).DataType
                        Dim exp As String = "CONVERT(100 * (" + Replace(dt_delta.Columns(j).ColumnName, "_Before", "_After") + "-" + dt_delta.Columns(j).ColumnName + "),System.Int64) / 100"
                        dc.Expression = exp
                        dt_delta.Columns.Add(dc)
                    End If
                End If
            Next

            dt1.TableName = "Before"
            dt2.TableName = "After"
            dt_delta.TableName = "Delta"
            ds.Tables.Add(dt_delta)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

    Private Sub AssignDataToTopX_Delta(ByRef ds As DataSet, tech As String, Optional chartname_original As String = Nothing, Optional SeriesInVisible As List(Of String) = Nothing, Optional ChartElementSortOrder() As String = Nothing)
