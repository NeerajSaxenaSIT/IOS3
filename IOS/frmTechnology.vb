    Private Sub gvParamFilters_ShownEditor(sender As Object, e As EventArgs) Handles gvParamFiltersStats.ShownEditor, gvParamFiltersTopX.ShownEditor, gvParamFiltersEval.ShownEditor
        Dim view = CType(sender, DevExpress.XtraGrid.Views.Grid.GridView)

        If view.FocusedColumn.FieldName <> "FieldValue" Then Return

        Dim operatorValue As String = Convert.ToString(view.GetRowCellValue(view.FocusedRowHandle, "FieldOperator"))

        Dim editor = TryCast(view.ActiveEditor, DevExpress.XtraEditors.TextEdit)
        If editor Is Nothing Then Return

        If operatorValue = "LIKE" OrElse operatorValue = "NOT LIKE" Then
            editor.ToolTip = "Use % wildcard with LIKE operator."
            editor.ShowToolTips = True
        Else
            editor.ToolTip = Nothing
        End If
    End Sub

    Private Sub gvParamFilters_CellValueChanged(sender As Object, e As DevExpress.XtraGrid.Views.Base.CellValueChangedEventArgs)
        Try
            _likeWarningShown.Clear()
            Dim view = CType(sender, DevExpress.XtraGrid.Views.Grid.GridView)
            ' Validate when Operator or FieldValue changes
            If e.Column.FieldName <> "FieldValue" AndAlso e.Column.FieldName <> "Operator" Then
                Return
            End If
            ValidateLikeWithMessage(view, e.RowHandle)
        Catch
        End Try
    End Sub

    Private Sub ValidateLikeWithMessage(view As DevExpress.XtraGrid.Views.Grid.GridView, rowHandle As Integer)
        Try
            Dim operatorValue As String = Convert.ToString(view.GetRowCellValue(rowHandle, "FieldOperator"))

            Dim fieldValue As String = Convert.ToString(view.GetRowCellValue(rowHandle, "FieldValue"))

            ' Reset warning state if row becomes valid
            If operatorValue <> "LIKE" AndAlso operatorValue <> "NOT LIKE" OrElse (Not String.IsNullOrWhiteSpace(fieldValue) AndAlso fieldValue.Contains("%")) Then
                _likeWarningShown.Remove(rowHandle)
                Return
            End If

            ' Show warning per invalid state
            If Not _likeWarningShown.Contains(rowHandle) Then
                _likeWarningShown.Add(rowHandle)
                XtraMessageBox.Show("For LIKE/NOT LIKE Operator, the value must contain '%' wildcard.", "Invalid LIKE/NOT LIKE Field Value", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            End If
        Catch
        End Try
    End Sub

