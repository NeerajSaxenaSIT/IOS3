    Public Sub ObjectChangeButtons_Load(tech As String, objectname As String, sqlid As Integer)
        Try
            Dim devBtn As SimpleButton = New SimpleButton()
            devBtn.Text = objectname
            devBtn.Name = "devBtn_Changes_" & tech & "_" & objectname
            devBtn.Tag = sqlid
            devBtn.Size = New Size(87, 22)

            AddHandler devBtn.Click, AddressOf ObjectChangeButtons_Click
            flpChangesStats.Controls.Add(devBtn)
        Catch
        End Try
    End Sub

    Private Sub ObjectChangeButtons_Click(sender As Object, e As System.EventArgs)
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        'identify objects
        Try
            gcChangesStats.DataSource = Nothing
            gcChangesStats.Refresh()

            'Charts_AxisMarkers_Clear(_strNetwork)

            Dim btn As SimpleButton = CType(sender, SimpleButton)
            Dim tech As String = btn.Name.Split("_")(2)
            Dim objectsel As String = tvObjectsTreeStats.GetChecked2String(tech, btn.Text, "ObjectID", strTreeFilter)
            If objectsel = "IN ()" Then
                Exit Sub
            End If
            Dim lbl As LabelControl = lblChangesStats
            lbl.Text = "Objects: " & tvObjectsTreeStats.GetChecked2String(tech, btn.Text, "Naked", strTreeFilter)
            lbl.ForeColor = Color.Black

            'construct query
            Dim sql As String = Nothing
            Dim connstring As String = Nothing
            Dim ds_change As DataSet = Nothing

            Dim parray()() As String = {New String() {"@object", objectsel}, New String() {"@username", Chr(39) & Environment.UserName & "1" & Chr(39)}}

            sql = GetSQL(btn.Tag, parray, dt_IOS_SQL)(1)
            connstring = GetSQL(btn.Tag, parray, dt_IOS_SQL)(0)
            ds_change = DataAccessorODBC.GetDataSet(connstring, sql, iQryTimeOut)

            If ds_change Is Nothing Then
                lbl.Text = "Problem with query..."
                'Exit Sub
            End If

            If ds_change.Tables(0).Rows.Count = 0 Then
                lbl.Text = "No Changes recorded for selection..."
                'Exit Sub
            End If

            If (ds_change IsNot Nothing) AndAlso (ds_change.Tables(0).Rows.Count <> 0) Then
                IOSDevExpressGrid.PopulateDataInGrid(gcChangesStats, gvChangesStats, ds_change.Tables(0), "")
                AddChartAxisMarkers_New(ds_change.Tables(0), "LAST_MODIFIED", Nothing, "Label")
            End If

            manualAxisMarkerApplied = True
            ReDrawPeriodCalcAxisMarkers()

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
    End Sub

    Private Sub dbtn_Changes_UnHide_Click(sender As Object, e As EventArgs) Handles btnChangesUnHideStats.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Try
            If btnChangesUnHideStats.Text.ToLower = "unhide" Then
                For Each col As Columns.GridColumn In gvChangesStats.Columns
                    col.Visible = True
                Next
                btnChangesUnHideStats.Text = "Hide"
            Else
                dgv_HideSameCols(gcChangesStats, gvChangesStats, CType(gcChangesStats.DataSource, DataTable))
                btnChangesUnHideStats.Text = "UnHide"
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
    End Sub

    Private Sub dgv_HideSameCols(ByRef dgv As GridControl, ByRef view As GridView, dt As DataTable)
        If dt Is Nothing Then Exit Sub
        Dim same As Boolean = True
        Dim previousValue As String = ""

        If Not dt_paramchanges Is Nothing Then
            dt_paramchanges.Dispose()
        End If
        dt_paramchanges = New DataTable()
        Dim dcol1 As DataColumn = New DataColumn("LAST_MODIFIED", System.Type.GetType("System.DateTime"))
        dt_paramchanges.Columns.Add(dcol1)
        Dim dcol2 As DataColumn = New DataColumn("Parameter", System.Type.GetType("System.String"))
        dt_paramchanges.Columns.Add(dcol2)
        Dim dcol3 As DataColumn = New DataColumn("Label", System.Type.GetType("System.String"))
        dt_paramchanges.Columns.Add(dcol3)

        Try
            dt.Columns("LAST_MODIFIED").SetOrdinal(0)
            Dim columndeletions As New List(Of String)
            columndeletions.Add("LAST_MODIFIER")
            columndeletions.Add("OBJECT_STATE")
            columndeletions.Add("VALID_START_TIME")
            columndeletions.Add("VALID_FINISH_TIME")
            columndeletions.Add("BTS_NOTIF_ORIGIN")
            columndeletions.Add("WBTS_CHANGE_ORIGIN")
            columndeletions.Add("WCEL_CHANGE_ORIGIN")
            columndeletions.Add("BSC_NOTIF_ORIGIN")
            columndeletions.Add("RNW_CONF_ID")
            columndeletions.Add("RNW_FALLBACK_CONF_ID")
            columndeletions.Add("RNW_PLAN_CONF_ID")
            Dim i As Integer = 0
            For i = 0 To dt.Columns.Count - 1
                If columndeletions.Contains(dt.Columns(i).ColumnName) Then
                    dt.Columns.Remove(dt.Columns(i))
                    i = i - 1
                End If
            Next
        Catch
        End Try

        Try
            Dim row2remove As New List(Of DataRow)
            Dim i As Integer = 1
            Dim samerow As Boolean = True
            If dt.Rows.Count > 1 Then
                For i = 1 To dt.Rows.Count - 1
                    For Each col As DataColumn In dt.Columns
                        If Not col.DataType.ToString = "System.DateTime" Then
                            If dt(i)(col.Ordinal).ToString <> dt(i - 1)(col.Ordinal).ToString Then
                                samerow = False

                                Dim newrow As DataRow = dt_paramchanges.NewRow()
                                newrow(0) = dt(i)(0)
                                newrow(1) = col.ColumnName
                                newrow(2) = col.ColumnName & ": FROM " & dt(i - 1)(col.Ordinal).ToString & " TO " & dt(i)(col.Ordinal).ToString
                                dt_paramchanges.Rows.Add(newrow)
                            End If
                        End If
                    Next
                    If samerow = True Then
                        row2remove.Add(dt.Rows(i))
                    End If
                    samerow = True
                Next
            End If
            For Each k As DataRow In row2remove
                dt.Rows.Remove(k)
            Next
        Catch
        End Try

        dgv.DataSource = Nothing
        dgv.Refresh()
        IOSDevExpressGrid.PopulateDataInGrid(dgv, view, dt, "ALL")

        Dim columnexceptions As New List(Of String)
        columnexceptions.Add("LAST_MODIFIED")
        columnexceptions.Add("BTS")
        columnexceptions.Add("BCF")
        columnexceptions.Add("BSC")
        columnexceptions.Add("CELL")
        columnexceptions.Add("DN")
        columnexceptions.Add("CELL_ID")
        columnexceptions.Add("CELL_NAME")
        columnexceptions.Add("WCELL")
        columnexceptions.Add("WBTS")
        columnexceptions.Add("RNC")
        columnexceptions.Add(flpSourceBtn_GetType(Network, "CELL", flpCounterTypeStats).SourceButtonText)

        If dt.Rows.Count > 1 Then
            For Each col As DataColumn In dt.Columns
                If Not columnexceptions.Contains(col.ColumnName.ToUpper) Then
                    previousValue = dt(0)(col.Ordinal).ToString
                    For Each row As DataRow In dt.Rows
                        If previousValue <> row(col.Ordinal).ToString Then
                            same = False
                        End If
                    Next
                    If same = True Then
                        view.Columns(col.Ordinal).Visible = False
                    End If
                    same = True
                End If
            Next
        End If
        dgv.Refresh()
    End Sub

