    Private Sub ShowHideSingleChartSeries(myChart As Chart, SeriesName As String, Optional IsTopX As Boolean = False)
        Try
            Dim DefaultSeries As Dictionary(Of String, SeriesCollection)
            Dim ExtraSeries As Dictionary(Of String, LegendEntryCollection)

            Dim chartObject As String = Nothing
            Dim chartNameKey As String = Nothing

            If IsTopX = False Then
                DefaultSeries = DefaultSeriesCollectionStats
                ExtraSeries = ExtraLegendEntryCollectionStats
            Else
                DefaultSeries = DefaultSeriesCollectionTopX
                ExtraSeries = ExtraLegendEntryCollectionTopX
            End If

            If (tsmi_ObjectAggregationOnOff.Checked = False) Then
                chartObject = myChart.TitleBox.Label.Text.Split(":")(1).Trim.Replace("'", "")
                chartNameKey = myChart.Name & "-" & chartObject
            Else
                chartNameKey = myChart.Name
            End If

            If myChart.SeriesCollection.GetSeries(SeriesName) IsNot Nothing Then
                If myChart.SeriesCollection.Count > 1 Then

                    If ExtraSeries.ContainsKey(chartNameKey) = False Then
                        If DefaultSeries.ContainsKey(chartNameKey) Then
                            DefaultSeries.Remove(chartNameKey)
                        End If
                        Dim sc As New SeriesCollection()
                        For Each ser As Series In myChart.SeriesCollection
                            sc.Add(ser)
                        Next
                        DefaultSeries.Add(chartNameKey, sc)
                    End If

                    If DefaultSeries.ContainsKey(chartNameKey) Then

                        For Each defKVP As KeyValuePair(Of String, SeriesCollection) In DefaultSeries
                            If defKVP.Key = myChart.Name Then
                                For Each sr As Series In defKVP.Value
                                    If (sr.Name.ToUpper <> SeriesName.ToUpper) Then

                                        If myChart.SeriesCollection.Contains(sr) Then
                                            myChart.SeriesCollection.Remove(sr)
                                        End If

                                        Dim entry As New LegendEntry()
                                        entry.Name = sr.Name
                                        entry.Hotspot.ToolTip = sr.Name
                                        entry.LabelStyle.Color = Color.Gray
                                        myChart.LegendBox.ExtraEntries.Add(entry)
                                    End If
                                Next
                            End If
                        Next

                    End If

                    If ExtraSeries.ContainsKey(chartNameKey) Then
                        ExtraSeries.Remove(chartNameKey)
                    End If
                    Dim tempLegendCol As New LegendEntryCollection
                    For Each kvp As LegendEntry In myChart.LegendBox.ExtraEntries
                        tempLegendCol.Add(kvp)
                    Next
                    ExtraSeries.Add(chartNameKey, tempLegendCol)
                End If
            Else
                If ExtraSeries.ContainsKey(chartNameKey) Then

                    Dim LegendColl As LegendEntryCollection = Nothing
                    LegendColl = ExtraSeries.Item(chartNameKey)

                    myChart.LegendBox.ExtraEntries.Clear()

                    For Each defKVP As KeyValuePair(Of String, SeriesCollection) In DefaultSeries
                        If defKVP.Key = myChart.Name Then
                            For Each sr As Series In defKVP.Value
                                If (sr.Name.ToUpper <> SeriesName.ToUpper) Then
                                    Dim entry As New LegendEntry()
                                    entry.Name = sr.Name
                                    entry.Hotspot.ToolTip = sr.Name
                                    entry.LabelStyle.Color = Color.Gray
                                    myChart.LegendBox.ExtraEntries.Add(entry)
                                Else
                                    myChart.SeriesCollection.Clear()
                                    myChart.SeriesCollection.Add(sr)
                                End If
                            Next
                        End If
                    Next

                    ExtraSeries.Remove(chartNameKey)
                    Dim tempLegendCol As New LegendEntryCollection
                    For Each kvp As LegendEntry In myChart.LegendBox.ExtraEntries
                        tempLegendCol.Add(kvp)
                    Next
                    If tempLegendCol.Count > 0 Then
                        ExtraSeries.Add(chartNameKey, tempLegendCol)
                    End If

                End If
            End If

        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        Finally
            myChart.Refresh()
        End Try
    End Sub

