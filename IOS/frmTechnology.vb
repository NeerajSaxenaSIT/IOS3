    Private Sub ShowEvalObjectBasedProbCellsOnly()
        Try
            Dim ds As New DataSet
            Dim dtObjBasedData As DataTable = Nothing
            For Each dt As DataTable In dsEvalObj.Tables
                If dt.TableName.StartsWith("KPISetObjBased") Then
                    dtObjBasedData = dt
                ElseIf dt.TableName.StartsWith("ThresholdSetObjBased") Then
                    dtThresholdSetForKPIObj = dt
                End If
            Next

            If thresholdMethodName.ToLower = "datelistbased" Then
                If srcColThreshold Is Nothing Then
                    For Each col As DataColumn In dtThresholdSetForKPIObj.Columns
                        For Each fld As DataColumn In dtObjBasedData.Columns
                            If col.ColumnName = fld.ColumnName Then
                                srcColThreshold = col.ColumnName
                                Exit For
                            End If
                        Next
                    Next
                End If
            End If

            Dim dtProbCellsOnly As DataTable = dtObjBasedData.Clone()
            Dim rowCellClr As New List(Of Boolean)
            Dim drthresholdKpi As DataRow = Nothing

            If dtThresholdSetForKPIObj IsNot Nothing Then
                Dim KPIList As New List(Of String)

                For Each dr As DataRow In dtThresholdSetForKPIObj.DistinctCol("KPIName").Rows
                    KPIList.Add(dr("KPIName").ToString)
                Next

                For Each drObj As DataRow In dtObjBasedData.Rows
                    rowCellClr.Clear()

                    For Each kpi As String In KPIList

                        If Not IsDBNull(drObj(kpi)) Then

                            Try
                                If thresholdMethodName.ToLower = "dynamicselectionbased" Then
                                    drthresholdKpi = dtThresholdSetForKPIObj.AsEnumerable().Where(Function(x) x.Field(Of String)(cmbObjectTreeEval.Text) = drObj(cmbObjectTreeEval.Text).ToString And x.Field(Of String)("KPIName") = kpi).ToArray()(0)
                                ElseIf thresholdMethodName.ToLower = "datelistbased" Then
                                    drthresholdKpi = dtThresholdSetForKPIObj.AsEnumerable().Where(Function(x) x.Field(Of String)(srcColThreshold) = drObj(srcColThreshold) And x.Field(Of String)("KPIName") = kpi).ToArray()(0)
                                ElseIf thresholdMethodName.ToLower = "fixed" Then
                                    drthresholdKpi = dtThresholdSetForKPIObj.AsEnumerable().Where(Function(x) x.Field(Of String)("KPIName") = kpi).ToArray()(0)
                                End If
                            Catch
                            End Try

                            If CStr(drthresholdKpi("Operator")) = "<" Then

                                If CDbl(drObj(kpi)) < CDbl(drthresholdKpi("WarningValue")) Then
                                    rowCellClr.Add(False)
                                ElseIf CDbl(drObj(kpi)) < CDbl(drthresholdKpi("FailureValue")) Then
                                    rowCellClr.Add(False)
                                ElseIf CDbl(drObj(kpi)) < CDbl(drthresholdKpi("WarningValue")) AndAlso CDbl(drObj(kpi)) < CDbl(drthresholdKpi("FailureValue")) Then
                                    rowCellClr.Add(False)
                                Else
                                    rowCellClr.Add(True)
                                End If

                            ElseIf CStr(drthresholdKpi("Operator")) = ">" Then

                                If CDbl(drObj(kpi)) > CDbl(drthresholdKpi("WarningValue")) Then
                                    rowCellClr.Add(False)
                                ElseIf CDbl(drObj(kpi)) > CDbl(drthresholdKpi("FailureValue")) Then
                                    rowCellClr.Add(False)
                                ElseIf CDbl(drObj(kpi)) > CDbl(drthresholdKpi("WarningValue")) AndAlso CDbl(drObj(kpi)) > CDbl(drthresholdKpi("FailureValue")) Then
                                    rowCellClr.Add(False)
                                Else
                                    rowCellClr.Add(True)
                                End If

                            ElseIf CStr(drthresholdKpi("Operator")) = "=" Then

                                If CDbl(drObj(kpi)) = CDbl(drthresholdKpi("WarningValue")) Then
                                    rowCellClr.Add(False)
                                ElseIf CDbl(drObj(kpi)) = CDbl(drthresholdKpi("FailureValue")) Then
                                    rowCellClr.Add(False)
                                ElseIf CDbl(drObj(kpi)) = CDbl(drthresholdKpi("WarningValue")) AndAlso CDbl(drObj(kpi)) = CDbl(drthresholdKpi("FailureValue")) Then
                                    rowCellClr.Add(False)
                                Else
                                    rowCellClr.Add(True)
                                End If

                            ElseIf CStr(drthresholdKpi("Operator")) = "<>" Then

                                If CDbl(drObj(kpi)) <> CDbl(drthresholdKpi("WarningValue")) Then
                                    rowCellClr.Add(False)
                                ElseIf CDbl(drObj(kpi)) <> CDbl(drthresholdKpi("FailureValue")) Then
                                    rowCellClr.Add(False)
                                ElseIf CDbl(drObj(kpi)) <> CDbl(drthresholdKpi("WarningValue")) AndAlso CDbl(drObj(kpi)) <> CDbl(drthresholdKpi("FailureValue")) Then
                                    rowCellClr.Add(False)
                                Else
                                    rowCellClr.Add(True)
                                End If

                            End If

                        End If

                    Next

                    If rowCellClr.Contains(False) Then
                        dtProbCellsOnly.ImportRow(drObj)
                    End If
                Next

                If dtProbCellsOnly.Rows.Count > 0 Then
                    dtProbCellsOnly.TableName = "KPISetObjBased_" & CStr(cmbKPISetEval.SelectedItem.ToString)
                    ds.Tables.Add(dtProbCellsOnly.Copy)
                    ds.Tables.Add(dtThresholdSetForKPIObj.Copy)
                    AssignDataToObjectResultsGrid(ds)
                End If
            End If

            ds.Dispose()
            ds = Nothing
            dtObjBasedData.Dispose()
            dtObjBasedData = Nothing
            dtProbCellsOnly.Dispose()
            dtProbCellsOnly = Nothing
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

