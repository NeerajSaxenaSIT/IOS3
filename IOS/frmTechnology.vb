    Private Sub Charts_AxisMarkers_Clear(tech As String)
        Try
            Dim stc As XtraTabControl = Nothing
            stc = GetTabControlFromTech(tech)
            For Each tp As XtraTabPage In stc.TabPages
                For Each tb As XtraTabPage In TryCast(tp.Controls(0), XtraTabControl).TabPages
                    If tb.Controls.Count = 0 Then
                        Continue For
                    End If
                    For Each ch As Chart In tb.Controls(0).Controls.OfType(Of Chart)()
                        ch.XAxis.Markers.Clear()
                        ch.YAxis.Markers.Clear()
                        If ch.Type <> ChartType.Surface Then
                            For Each sc As Series In ch.SeriesCollection
                                sc.YAxis.Markers.Clear()
                            Next
                            ch.RefreshChart()
                        End If
                    Next
                Next
            Next
        Catch
        End Try
    End Sub

    Public Function GetTabControlFromTech(tech As String)
        Select Case tech.ToLower
            Case _strNetwork.ToLower
                Return tcTabControlHighStats
            Case "topx_" & _strNetwork.ToLower
                Return tcTabControlHighTopX
            Case "Eval".ToLower
                Return tcHighEvaluate
        End Select
        Return Nothing
    End Function

