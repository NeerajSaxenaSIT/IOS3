    Public Function GetObjectNameFromCellOrSite(tech As String, cellorsite As String) As String
        Try
            Dim dr() As DataRow = dt_IOS_ObjectConfig.AsEnumerable().Where(Function(x) x.Field(Of String)("Tech").ToUpper = tech.ToUpper).ToArray()

            For Each r As DataRow In dr
                If cellorsite = "CELL" And (r("InternalObjectName").ToString.Contains("CEL") Or r("InternalObjectName").ToString.Contains("AP")) Then
                    Return r("Object").ToString
                End If
                If cellorsite = "SITE" And (r("InternalObjectName").ToString.Contains("SITE") Or r("InternalObjectName").ToString.Contains("BCF") Or r("InternalObjectName").ToString.Contains("BTS")) Then
                    Return r("Object").ToString
                End If
            Next
        Catch ex As Exception
        End Try
        Return ""
    End Function

