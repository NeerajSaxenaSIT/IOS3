                sql_total = Replace(sql_total, "@RegionFilter", RegionFilter)

                If tsmi_EvalHistogramAggOrNoAgg.Checked = False And targettype <> "" Then

                    sql_total = sql_total + "                 

                    select max([" + kpiname + "]) +0.0001 [" + kpiname + "],cdfbin into #PMCUM" + calcPeriod + " from (
	                    select [" + kpiname + "] 
	                    ,100 * (CUME_DIST () OVER ( ORDER BY [" + kpiname + "])) cdfbin
	                    from #PM" + calcPeriod + " where [" + kpiname + "] is not null
                    ) y group by cdfbin order by 1


                    declare @MinValuePx" + calcPeriod + " as Float = (select max([" + kpiname + "])  [" + kpiname + "] from #PMcum" + calcPeriod + " where cdfbin <= " + UFP.ToString + "   )
                    If @MinValuePx" + calcPeriod + " is null 
                    set @MinValuePx" + calcPeriod + " = (select min([" + kpiname + "])  [" + kpiname + "]  from #PMcum" + calcPeriod + ")

                    declare @maxValuePx" + calcPeriod + " as Float = (select min([" + kpiname + "])  [" + kpiname + "] from #PMcum" + calcPeriod + " where cdfbin >= " + OFP.ToString + "   )
                    If @maxValuePx" + calcPeriod + " is null 
                    set @maxValuePx" + calcPeriod + " = (select max([" + kpiname + "])  [" + kpiname + "]  from #PMcum" + calcPeriod + ")

                    select t.*,  ( 1 +ISNULL(floor(([" + kpiname + "] - min_value) * (" + NumberOfBins + "-1)  / NULLIF(max_value - min_value,0 )),0)) as BucketNumber,  (max_value - min_value )/" + NumberOfBins + ".0 BucketSize, min_value as BucketStartValue
                    into #PMCDF" + calcPeriod + " 
                    from (select t.*, @MinValuePx" + calcPeriod + "  as min_value, @maxValuePx" + calcPeriod + " as max_value from #PM" + calcPeriod + " t where [" + kpiname + "] is not null
                    ) t					 

                    select  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,BucketSize,BucketStartValue + (case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ) * BucketSize BucketValue ," + targettype3 + "
                    into #PMBuckets" + calcPeriod + "
                    from #PMCDF" + calcPeriod + ", (select  " + targettype3 + " from #PMCDF" + calcPeriod + " k group by  " + targettype3 + ") k where  BucketNumber >=0 and bucketnumber <=" + NumberOfBins + "  
                    group by case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ,BucketSize , BucketStartValue , " + targettype3 + "


                    select k.BucketNumber,round(k.BucketValue,3) BucketValue, SampleCount,round(100.00 * sum(SampleCount) over (order by k.bucketnumber ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) / (sum(SampleCount) over ()),2)  SamplePercentage, " + "'" + Replace(targettype, ",", "") + "_" + IIf(calcPeriod = "Threshold", "Threshold'", "Evaluation'") + " " + Replace(targettype, ",", "") + "
                    from #PMBuckets" + calcPeriod + " k left outer join (
		                    select  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,min([" + kpiname + "]) MinKPI,max([" + kpiname + "]) MaxKPI,count(*) SampleCount 
		                    from #PMCDF" + calcPeriod + " 
		                    group by  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end 
                    ) z on k.BucketNumber = z.BucketNumber 
                    where samplecount is not null group by k.BucketNumber, k.BucketValue, SampleCount
                    order by 1
                    "
                Else
                    sql_total = sql_total + "
                 

                    select max([" + kpiname + "]) + 0.0001 [" + kpiname + "],cdfbin into #PMCUM" + calcPeriod + " from (
	                    select [" + kpiname + "] 
	                    ,100 * (CUME_DIST () OVER ( ORDER BY [" + kpiname + "])) cdfbin
	                    from #PM" + calcPeriod + " where [" + kpiname + "] is not null
                    ) y group by cdfbin order by 1


                    declare @MinValuePx" + calcPeriod + " as Float = (select max([" + kpiname + "])  [" + kpiname + "] from #PMcum" + calcPeriod + " where cdfbin <= " + UFP.ToString + "   )
                    If @MinValuePx" + calcPeriod + " is null 
                    set @MinValuePx" + calcPeriod + " = (select min([" + kpiname + "])  [" + kpiname + "]  from #PMcum" + calcPeriod + " )

                    declare @maxValuePx" + calcPeriod + " as Float = (select min([" + kpiname + "])  [" + kpiname + "] from #PMcum" + calcPeriod + " where cdfbin >= " + OFP.ToString + "   )
                    If @maxValuePx" + calcPeriod + " is null 
                    set @maxValuePx" + calcPeriod + " = (select max([" + kpiname + "])  [" + kpiname + "]  from #PMcum" + calcPeriod + ")

                    select t.*,  ( 1 +ISNULL(floor(([" + kpiname + "] - min_value) * (" + NumberOfBins + "-1)  / NULLIF(max_value - min_value,0 )),0)) as BucketNumber,  (max_value - min_value )/" + NumberOfBins + ".0 BucketSize, min_value as BucketStartValue
                    into #PMCDF" + calcPeriod + "
                    from (select t.*, @MinValuePx" + calcPeriod + "  as min_value,  @MaxValuePx" + calcPeriod + " as max_value from #PM" + calcPeriod + " t where [" + kpiname + "] is not null
                    ) t					 

                    select  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,BucketSize,BucketStartValue + (case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ) * BucketSize BucketValue 
                    into #PMBuckets" + calcPeriod + "
                    from #PMCDF" + calcPeriod + " k where  BucketNumber >=0 and bucketnumber <=" + NumberOfBins + "  
                    group by case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ,BucketSize , BucketStartValue 


                    select k.BucketNumber,round(k.BucketValue,3) BucketValue, SampleCount,round(100.00 * sum(SampleCount) over (order by k.bucketnumber ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) / (sum(SampleCount) over ()),2)  SamplePercentage, " + "'" + Replace(targettype, ",", "") + "_" + IIf(calcPeriod = "Threshold", "Threshold'", "Evaluation'") + " " + Replace(targettype, ",", "") + "
                    from #PMBuckets" + calcPeriod + " k left outer join (
		                    select  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,min([" + kpiname + "]) MinKPI,max([" + kpiname + "]) MaxKPI,count(*) SampleCount 
		                    from #PMCDF" + calcPeriod + " 
		                    group by  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end 
                    ) z on k.BucketNumber=z.BucketNumber 
                    where samplecount is not null group by k.BucketNumber, k.BucketValue, SampleCount
                    order by 1
                    "
                End If

            End If

            Return sql_total
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)

            If Not dr_sql Is Nothing Then
                dr_sql.Close()
                dr_sql = Nothing
            End If
            If Not comm_sql Is Nothing Then
                comm_sql.Dispose()
                comm_sql = Nothing
            End If
            If Not dr_element Is Nothing Then
                dr_element.Close()
                dr_element = Nothing
            End If
            If Not comm_Element Is Nothing Then
                comm_Element.Dispose()
                comm_Element = Nothing
            End If
            If Not conn_el Is Nothing Then
                conn_el.Close()
                conn_el.Dispose()
                conn_el = Nothing
            End If
            Return Nothing
        End Try
    End Function

    Private Sub Process_Eval_ObjectTime_ThreadEnd(ds As System.Data.DataSet, ti As Threading.Thread)
        Try
            Dim threadcorrect As Boolean = False
            For Each tid In t_list
                If tid.ManagedThreadId = ti.ManagedThreadId Then
                    threadcorrect = True
                End If
            Next

            If threadcorrect = False Then
                ds.Dispose()
                ds = Nothing
                Exit Sub
            End If

            'dsEval_Histogram = ds

            SyncLock ds_eval_hist_list
                If Not ds Is Nothing Then
                    If ds.Tables.Count > 0 Then
                        ds_eval_hist_list.Add(ds)
                    End If
                End If
            End SyncLock

            Dim aResult As IAsyncResult = Nothing
            aResult = Me.BeginInvoke(Me.Call_ProcessEvalObjectTimeInvoked)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
        End Try
    End Sub

    Private Sub Process_Eval_ObjectTime_Invoked()
        Application.DoEvents()
        Try
            If evalHistogramChartCntr = 0 Then
                Exit Sub
            End If

            For Each t As Threading.Thread In t_list
                If t.ThreadState = Threading.ThreadState.AbortRequested Then
                    Exit Sub
                End If
            Next t
        Catch ex As Exception
            lblObjTreeStatusEval.ForeColor = Color.Red
            lblObjTreeStatusEval.Text = "Threads Error..." & Threads_Fired
        End Try
        SyncLock lblObjTreeStatusEval
            Threads_Fired = 0
            If Not lblObjTreeStatusEval.Text.Contains("Abort") And Threads_Fired > -1 Then
                lblObjTreeStatusEval.Text = "Threads To Complete..." & Threads_Fired
            End If
        End SyncLock

        Try
            If Threads_Fired = 0 Then
                Threads_Fired = -99
                Application.DoEvents()
                If ds_eval_hist_list.Count > 0 Then
                    If cm_Chart_ObjectCompareOrMapKPI = "tsmi_EvalHistogramOfCells" AndAlso evalHistogramChartCntr > 0 Then
                        For Each ChartKPI As String In lstTimeBasedKPIEval

                            If (Not dsEval_Histogram.Tables.Contains(ChartKPI)) Then
                                dtEval_Histogram = New DataTable
                                Dim dt_merge As DataTable = Nothing

                                For Each ds As DataSet In ds_eval_hist_list
                                    If ds.DataSetName.Contains(ChartKPI) Then
                                        dt_merge = ds.Tables(0).Copy
                                        dtEval_Histogram.Merge(dt_merge)

                                        dt_merge = ds.Tables(1).Copy
                                        dtEval_Histogram.Merge(dt_merge)

                                        dtEval_Histogram.TableName = ChartKPI
                                    End If
                                Next

                                If dtEval_Histogram.Rows.Count > 0 Then
                                    dsEval_Histogram.Tables.Add(dtEval_Histogram)
                                    cm_Chart_kpiname = dtEval_Histogram.TableName
                                    AssignDataToHistogram_Eval(dtEval_Histogram, _strNetwork)
                                    evalHistogramChartCntr = evalHistogramChartCntr - 1
                                    Exit For
                                End If
                            End If
                        Next

                        'If evalHistogramChartCntr = 0 Then
                        gcHistogramData.DataSource = Nothing
                        gcHistogramData.Refresh()

                        lblObjTreeStatusEval.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                        lblObjTreeStatusEval.ForeColor = Color.Black

                        AccCtrlEval.Enabled = True
                        Me.btnApplyEval.Text = "Apply"
                        ucProgPnlEval.StopProgress()
                        'End If
                    End If
                Else
                    lblObjTreeStatusEval.Text = "No Data Retrieved !"
                    lblObjTreeStatusEval.ForeColor = Color.Red
                    Me.btnApplyEval.Text = "Apply"
                    ucProgPnlEval.StopProgress()
                End If
            End If
        Catch ex As Exception
            Me.btnApplyEval.Text = "Apply"
            ucProgPnlEval.StopProgress()

            lblObjTreeStatusEval.ForeColor = Color.Red
            lblObjTreeStatusEval.Text = "Error Merging Threads..." & Threads_Fired
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
        End Try
    End Sub

    Private Sub AssignDataToHistogram_Eval(ByRef dt As DataTable, tech As String, Optional ByRef nc As Chart = Nothing)
        'get original timebased data as first chart

        Dim ds As DataSet = TechToDataSet(tech, "EvalTime")
        Dim dt_new As New DataTable
        Dim dt_new_sort As New DataTable
        Dim pvt_Pivot As Pivot = Nothing
        Dim dt_pivot As DataTable = Nothing
        Dim dtCopy As DataTable = Nothing
        Dim objectTypeName As String = cmbObjectTreeEval.Text

        For Each dtOriginal As DataTable In ds.Tables
            If dtOriginal.TableName.Contains("KPISetTimeBased") Then
                Dim dt_Temp = dtOriginal.Select("KPIName='" & cm_Chart_kpiname & "'").CopyToDataTable()
                'If dtOriginal.Columns.Contains(cm_Chart_kpiname) Then
                '    Dim displayView = New DataView(dtOriginal)
                '    displayView.RowFilter = ""
                '    dt_new = displayView.ToTable(False, "Date", cm_Chart_kpiname).Copy
                'End If
                dt_Temp.Columns.Remove("CategoryField")
                dt_Temp.Columns.Remove("Tech")
                dt_Temp.Columns.Remove("SQLKPIID")
                dt_Temp.Columns.Remove("Category")

                dt_new.Columns.Add("Date", GetType(DateTime))
                dt_new.Columns.Add(cm_Chart_kpiname, GetType(Double))

                For Each col As DataColumn In dt_Temp.Columns
                    If col.ColumnName <> "KPIName" Then
                        Dim dr_New As DataRow = dt_new.NewRow()
                        dr_New("Date") = col.ColumnName
                        dt_new.Rows.Add(dr_New)
                    End If
                Next

                Dim iCntr As Integer = 1
                For Each dr As DataRow In dt_Temp.Rows
                    For Each drn As DataRow In dt_new.Rows
                        drn(1) = dr(iCntr)
                        iCntr = iCntr + 1
                    Next
                Next

            End If
        Next

        Dim objectscharted As String = ""

        'getting ObjectTab
        'Dim tabcontrol As XtraTabControl = GetTabControlFromTech("Eval")
        'Dim ObjectTab_Active As String = tabcontrol.SelectedTabPage.Text

        Dim ds_chart As DataSet = clsSQLCommands.GetChartConfigurationByElement(connStrIOSServer, tech, cm_Chart_kpiname, "")
        Dim dt_chart As DataTable = ds_chart.Tables(0)

        'Assign data to all charts
        Dim ch As Chart = Nothing
        If nc IsNot Nothing Then
            ch = nc
        End If

        Dim i As Integer
        Dim Y1axislabel As String
        Dim Y2axislabel As String
        Dim Y1axisAbsorPerc, Y2axisAbsOrPerc As String
        Dim Y1axisPrecision, Y2axisPrecision As Integer
        Dim yaxis1 As Axis = Nothing
        Dim yaxis2 As Axis = Nothing
        Dim sp As New SmartPalette()
        Dim sc As New SeriesCollection

        Dim lastchart As String = ""

        Dim chart_elements() As String = {"0"}
        Dim chart_elementsYAxis() As String = {"0"}
        Dim chart_Eltype() As String = {"Bar"}
        Dim chart_ElColor() As Integer = {0}
        Dim chart_YaxisScale() As String = {"0", "0"}
        Dim chart_ElLineSize() As Integer = {0}

        Dim j As Integer = 0
        Dim rownum As Integer = 0
        Dim color_R As Integer = 0, color_B As Integer = 0, color_G As Integer = 0

        Dim isKpiPercentage As Boolean = False

        For rownum = 0 To 0
            Try
                'collecting elements from chart confguration
                Dim drow As DataRow = dt_chart.Rows(rownum)

                'configures individual chart when new chartline is detected
                If lastchart = "" Or lastchart <> drow(5).ToString Then
                    lastchart = drow(5).ToString.Trim
                    sp.Clear()

                    Y1axisAbsorPerc = nZ(drow(13), "Abs")
                    Y2axisAbsOrPerc = nZ(drow(14), "Abs")

                    If Y1axisPrecision = Nothing Then
                        Y1axisPrecision = CInt(nZ(drow(15), 0))
                    Else
                        Y1axisPrecision = Math.Max(CInt(nZ(drow(15), 0)), Y1axisPrecision)
                    End If

                    If Y2axisPrecision = Nothing Then
                        Y2axisPrecision = CInt(nZ(drow(16), 0))
                    Else
                        Y2axisPrecision = Math.Max(CInt(nZ(drow(16), 0)), Y2axisPrecision)
                    End If

                    '      Y1axisPrecision = CInt(nZ(drow(15), "0"))
                    '     Y2axisPrecision = CInt(nZ(drow(16), "0"))

                    Y1axislabel = nZ(drow(11), " ")
                    Y2axislabel = nZ(drow(12), " ")

                    chart_elementsYAxis(0) = nZ(drow(9), " ")
                    chart_ElColor(0) = CInt(nZ(drow("ChartElementsColor"), "0"))
                    chart_elements(0) = drow("ChartElements").ToString.Trim
                    chart_Eltype(0) = drow("chartElementsType").trim
                    chart_ElLineSize(0) = nZ(drow("LineSize").ToString.Trim, 3)

                    If nc Is Nothing Then
                        Dim tc As XtraTabControl = tcHighEvaluate
                        Dim tlpEvalHist As TableLayoutPanel = CType(tc.TabPages(GetTabPageIndex(tc, "Histogram")).Controls(0), TableLayoutPanel)
                        Dim sccEvalHist As SplitContainerControl = CType(tlpEvalHist.Controls(0), SplitContainerControl)
                        Dim flpCount As Integer = sccEvalHist.Panel1.Controls.Count
                        ch = sccEvalHist.Panel1.Controls(flpCount - 1).Controls(cm_Chart_kpiname & "Histogram")
                    End If

                    SetChartXAxis(tech, objectscharted, ch)

                    ch.Annotations.Clear()
                    ch.Annotations.Add(New Annotation(tech.ToUpper))
                    ch.TitleBox.HeaderLabel.Text = "Evaluate   -   TimeBased " & "  -   KPI: " & cm_Chart_kpiname

                    If Count_OT > 10 Then
                        ch.TitleBox.Label.Text = " "
                        tsmi_ChartHideTitle.Text = "Chart - Show Title"
                    Else
                        If nc IsNot Nothing Then
                            ch.TitleBox.Label.Text = " "
                        Else
                            ch.TitleBox.Label.Text = "Objects: " & objectscharted
                        End If
                        tsmi_ChartHideTitle.Text = "Chart - Hide Title"
                    End If
                    ch.TitleBox.Label.Alignment = StringAlignment.Near
                    ch.TitleBox.Label.LineAlignment = StringAlignment.Near

                    If GetFromTech_RadioButton(tech, "Hourly").Checked Or GetFromTech_RadioButton(tech, "Raw").Checked Then
                        ch.DefaultElement.Hotspot.ToolTip = "DATE: <%XValue,dd/MM/yy HH:mm>" & Chr(13) & "%SeriesName: %Value "
                    Else
                        ch.DefaultElement.Hotspot.ToolTip = "DATE: %XValue" & Chr(13) & "%SeriesName: %Value "
                    End If

                    Dim charttitle As String = "Evaluate   -   TimeBased"

                    If UCase(chart_elementsYAxis(i)) = "LEFT" Then
                        chart_YaxisScale(0) = drow("chartYaxisScaleProp").trim
                    ElseIf UCase(chart_elementsYAxis(i)) = "RIGHT" Then
                        chart_YaxisScale(1) = drow("chartYaxisScaleProp").trim
                    End If

                    'Y-Axis Settingso   
                    If chart_elementsYAxis(i).Trim.ToUpper = "LEFT" Then
                        yaxis1 = New Axis
                        yaxis1.Orientation = Orientation.Left
                        yaxis1.Label.Text = Y1axislabel
                        If UCase(Y1axisAbsorPerc) = "ABS" Then
                            yaxis1.Percent = False
                        ElseIf UCase(Y1axisAbsorPerc) = "PERC" Then
                            yaxis1.Percent = True
                            isKpiPercentage = True
                        End If
                        yaxis1.NumberPrecision = Y1axisPrecision
                        If yaxis1.NumberPrecision < 2 And Not yaxis1.Percent = True Then
                            yaxis1.MinimumInterval = 1
                        End If
                        yaxis1.Scale = dotnetCHARTING.WinForms.Scale.Range
                    Else
                        yaxis2 = New Axis
                        yaxis2.Orientation = Orientation.Left
                        yaxis2.Label.Text = Y2axislabel
                        If UCase(Y2axisAbsOrPerc) = "PERC" Then
                            yaxis2.Percent = True
                            isKpiPercentage = True
                        ElseIf UCase(Y2axisAbsOrPerc) = "ABS" Then
                            yaxis2.Percent = False
                        End If
                        yaxis2.NumberPrecision = Y2axisPrecision
                        If yaxis2.NumberPrecision < 2 And Not yaxis2.Percent = True Then
                            yaxis2.MinimumInterval = 1
                        End If
                        yaxis2.Scale = dotnetCHARTING.WinForms.Scale.Range
                    End If

                    '+++++++++++++++++++++++++++++++++++++++
                    j = 0

                    For Each col As DataColumn In dt_new.Columns
                        ReDim Preserve chart_elements(j)
                        If col.ColumnName.ToUpper <> "DATE" Then
                            chart_elements(j) = col.ColumnName.ToUpper
                            j = j + 1
                        End If
                    Next

                    For Each dr As DataRow In dt_new.Rows
                        For Each col As DataColumn In dt_new.Columns
                            If dr(col).ToString = "" Then
                                dr(col) = 0
                            End If
                        Next
                    Next

                    If Not yaxis1 Is Nothing Then
                        If UCase(chart_YaxisScale(0)) = "STACKED" Then
                            yaxis1.Scale = dotnetCHARTING.WinForms.Scale.Stacked
                        ElseIf UCase(chart_YaxisScale(0)) = "FULLSTACKED" Then
                            yaxis1.Scale = dotnetCHARTING.WinForms.Scale.FullStacked
                        Else
                            yaxis1.Scale = dotnetCHARTING.WinForms.Scale.Range
                        End If
                    End If

                    If Not yaxis2 Is Nothing Then
                        If UCase(chart_YaxisScale(1)) = "STACKED" Then
                            yaxis2.Scale = dotnetCHARTING.WinForms.Scale.Stacked
                        ElseIf UCase(chart_YaxisScale(1)) = "FULLSTACKED" Then
                            yaxis2.Scale = dotnetCHARTING.WinForms.Scale.FullStacked
                        Else
                            yaxis2.Scale = dotnetCHARTING.WinForms.Scale.Range
                        End If
                    End If

                    If (xtcPSFilterEval.SelectedTabPage.Text.Contains("Hours") And (rdoFilterHrsExcEval.Checked = True Or rdoFilterHrsIncEval.Checked = True)) Or cmbPredefinedFilterEval.SelectedIndex > 0 Then
                        ch.XAxis.Scale = dotnetCHARTING.WinForms.Scale.Normal
                    ElseIf (xtcPSFilterEval.SelectedTabPage.Text.Contains("Days") And (rdoFilterDaysExcEval.Checked = True Or rdoFilterDaysIncEval.Checked = True)) Then
                        ch.XAxis.Scale = dotnetCHARTING.WinForms.Scale.Normal
                    End If

                    If ch.Type = ChartType.Combo Then
                        Dim xaxis_valuehigh As DateTime = GetFromTech_DateTimePicker(2).EditValue 'Add 1 day to insert a extra x-axis scale.

                        Select Case True
                            Case GetFromTech_RadioButton(tech, "Raw").Checked, GetFromTech_RadioButton(tech, "Hourly").Checked
                                xaxis_valuehigh = xaxis_valuehigh.AddHours(1)
                            Case Else
                                xaxis_valuehigh = xaxis_valuehigh.AddDays(1)
                        End Select

                        If xaxis_valuehigh.Date = Now.Date Then
                            Select Case True
                                Case GetFromTech_RadioButton(tech, "Daily").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.Day, -1, DateAdd(DateInterval.Hour, 12, xaxis_valuehigh.Date))
                                Case GetFromTech_RadioButton(tech, "BH").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.Day, -1, DateAdd(DateInterval.Hour, 12, xaxis_valuehigh.Date))
                                Case GetFromTech_RadioButton(tech, "Weekly").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.WeekOfYear, -1, xaxis_valuehigh.Date)
                                Case GetFromTech_RadioButton(tech, "BHPS").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.Day, -1, DateAdd(DateInterval.Hour, 12, xaxis_valuehigh.Date))
                                Case GetFromTech_RadioButton(tech, "Monthly").Checked
                                    xaxis_valuehigh = DateAdd(DateInterval.Month, -1, xaxis_valuehigh.Date)
                            End Select
                        End If

                        ch.XAxis.ScaleRange.ValueHigh = xaxis_valuehigh

                    End If

                    Dim de As DataEngine = New DataEngine(dt_new)
                    de.DataFields = String2DataFields(chart_elements, "Date")

                    If ch.Type = ChartType.Combo Then
                        If (GetFromTech_RadioButton(tech, "Hourly").Checked Or GetFromTech_RadioButton(tech, "Raw").Checked) And ((rdoFilterDaysExcEval.Checked = True Or rdoFilterDaysIncEval.Checked = True) Or (rdoFilterHrsExcEval.Checked = True Or rdoFilterHrsIncEval.Checked = True) Or (cmbPredefinedFilterEval.SelectedIndex > 0)) Then
                            de.FormatString = "dd/MM/yy HH:mm"
                        ElseIf GetFromTech_RadioButton(tech, "Daily").Checked And ((rdoFilterDaysExcEval.Checked = True Or rdoFilterDaysIncEval.Checked = True) Or (rdoFilterHrsExcEval.Checked = True Or rdoFilterHrsIncEval.Checked = True) Or (cmbPredefinedFilterEval.SelectedIndex > 0)) Then
                            de.FormatString = "dd/MM/yy"
                        ElseIf GetFromTech_RadioButton(tech, "Monthly").Checked And ((rdoFilterDaysExcEval.Checked = True Or rdoFilterDaysIncEval.Checked = True) Or (rdoFilterHrsExcEval.Checked = True Or rdoFilterHrsIncEval.Checked = True) Or (cmbPredefinedFilterEval.SelectedIndex > 0)) Then
                            de.FormatString = "MMMM"
                        Else
                            de.FormatString = "dd/MM/yy"
                        End If
                    End If

                    sc = de.GetSeries()

                    Dim LeftAxisDivisor As Int32 = 1
                    Dim RightAxisDivisor As Int32 = 1
                    Dim LeftAxisLabelAddition As String = ""
                    Dim RightAxisLabelAddition As String = ""

                    For i = 0 To sc.Count - 1
                        Dim MaxValueOfSeries As Double = sc(i).Calculate("test", Calculation.Maximum).YValue
                        If MaxValueOfSeries > 1000000000 Then
                            If MaxValueOfSeries > 1000000000000 Then
                                Select Case chart_elementsYAxis(i).ToString().Trim().ToUpper()
                                    Case "LEFT"
                                        LeftAxisDivisor = 1000000
                                        LeftAxisLabelAddition = " Million"
                                        Exit Select
                                    Case "RIGHT"
                                        RightAxisDivisor = 1000000
                                        RightAxisLabelAddition = " Million"
                                        Exit Select
                                End Select
                            Else
                                Select Case chart_elementsYAxis(i).ToString().Trim().ToUpper()
                                    Case "LEFT"
                                        If LeftAxisDivisor < 1000 Then
                                            LeftAxisDivisor = 1000
                                            LeftAxisLabelAddition = " Thousand"
                                        End If
                                        Exit Select
                                    Case "RIGHT"
                                        If RightAxisDivisor < 1000 Then
                                            RightAxisDivisor = 1000
                                            RightAxisLabelAddition = " Thousand"
                                        End If
                                        Exit Select
                                End Select
                            End If

                        End If
                    Next

                    Dim boundaries As String = Nothing
                    Dim dtHistogramData As DataTable = Nothing
                    For i = 0 To sc.Count() - 1
                        If ch.Type = ChartType.Combo Then
                            Select Case UCase(chart_Eltype(i).Trim)
                                Case "LINE"
                                    sc(i).Type = SeriesType.Line
                                    sc(i).Line.Width = CInt(chart_ElLineSize(i))
                                Case "BAR"
                                    sc(i).Type = SeriesType.Bar
                                Case "AREALINE"
                                    sc(i).Type = SeriesType.AreaLine
                            End Select
                        ElseIf ch.Type = ChartType.Scatter Then
                            yaxis1.Label.Text = Y1axislabel
                            sc(i).Type = SeriesType.Marker
                        End If

                        Select Case UCase(chart_elementsYAxis(i).Trim)
                            Case "LEFT"
                                sc(i).YAxis = yaxis1
                            Case "RIGHT"
                                sc(i).YAxis = yaxis2
                        End Select

                        Select Case chart_elementsYAxis(i).ToString().Trim().ToUpper()
                            Case "LEFT"

                                If LeftAxisDivisor > 1 Then
                                    sc(i) = Series.Divide(sc(i), LeftAxisDivisor)
                                End If
                                If Not yaxis1.Label.Text.Contains(LeftAxisLabelAddition) Then
                                    yaxis1.Label.Text = yaxis1.Label.Text + LeftAxisLabelAddition
                                End If

                                sc(i).YAxis = yaxis1
                                Exit Select
                            Case "RIGHT"
                                If RightAxisDivisor > 1 Then
                                    sc(i) = Series.Divide(sc(i), RightAxisDivisor)
                                End If

                                If Not yaxis2.Label.Text.Contains(RightAxisLabelAddition) Then
                                    yaxis2.Label.Text = yaxis2.Label.Text + RightAxisLabelAddition
                                End If
                                sc(i).YAxis = yaxis2
                                Exit Select
                        End Select

                        color_R = CLng(chart_ElColor(i)) Mod 256
                        color_G = (CLng(chart_ElColor(i)) \ 256) Mod 256
                        color_B = ((CLng(chart_ElColor(i)) \ 256) \ 256) Mod 256

                        sc(i).DefaultElement.Color = Color.FromArgb(255, color_R, color_G, color_B) 'chartSeriesClr(sc(i).Name)
                        sc(i).DefaultElement.Marker.Type = i + 1

                    Next

                    ch.Type = ChartType.Combo
                    ch.ChartAreaLayout.Mode = ChartAreaLayoutMode.Horizontal

                    Dim yaxis1pdf As Axis = Nothing
                    Dim yaxis2pdf As Axis = Nothing

                    If ch.ExtraChartAreas.Count > 0 Then
                        ch.ExtraChartAreas.Clear()
                    End If


                    If ch.ExtraChartAreas.Count = 0 Then
                        Dim histChartArea As New ChartArea()
                        histChartArea.WidthPercentage = 50
                        histChartArea.YAxis.Label.Text = "Frequency"
                        histChartArea.XAxis.Label.Text = "Bins"
                        histChartArea.YAxis.Interval = 1
                        histChartArea.DefaultElement.Hotspot.ToolTip = "Bins: %XValue" & Chr(13) & "%SeriesName: %Value "

                        histChartArea.Series.Data = dt

                        ch.ExtraChartAreas.Add(histChartArea)
                        ch.ExtraChartAreas.Item(0).XAxis.TickLabelMode = TickLabelMode.Angled
                        ch.ExtraChartAreas.Item(0).XAxis.TickLabelAngle = 45
                        ch.ExtraChartAreas.Item(0).XAxis.Scale = dotnetCHARTING.WinForms.Scale.Range
                        ch.ExtraChartAreas.Item(0).XAxis.ScaleRange.ValueLow = CDbl(dt.Compute("min([BucketValue])", ""))
                        ch.ExtraChartAreas.Item(0).XAxis.ScaleRange.ValueHigh = CDbl(dt.Compute("max([BucketValue])", ""))

                        yaxis1pdf = New Axis()
                        yaxis1pdf.Orientation = Orientation.Left

                        yaxis2pdf = New Axis()
                        yaxis2pdf.Orientation = Orientation.Right
                        yaxis2pdf.Percent = True
                        yaxis2pdf.NumberPrecision = 0

                    End If

                    'loop through every TargetType if available
                    Dim distinctView As DataView = dt.DefaultView.ToTable(True, cmbObjectTreeEval.Text).DefaultView
                    distinctView.Sort = cmbObjectTreeEval.Text
                    Dim distinctDT As DataTable = distinctView.ToTable

                    Dim rnd As Random = New Random(ch.ExtraChartAreas(0).SeriesCollection.Count * 10)

                    If tsmi_EvalHistogramPeriodSelection.Checked = False Or tsmi_EvalHistogramAggOrNoAgg.Checked = False Then
                        ch.XAxis.Markers.Clear()
                    End If

                    Dim cl As Color = Nothing
                    For Each xm As AxisMarker In ch.XAxis.Markers
                        cl = Color.FromArgb(255, rnd.Next(255), rnd.Next(255), rnd.Next(255))
                    Next

                    For Each distinctTarget As DataRow In distinctDT.Rows

                        Dim deHisto As DataEngine = New DataEngine(dt.AsEnumerable().Where(Function(x) x.Field(Of String)(cmbObjectTreeEval.Text) = distinctTarget(cmbObjectTreeEval.Text)).CopyToDataTable())
                        deHisto.DataFields = String2DataFields({"SampleCount", "SamplePercentage"}, "BucketValue")

                        Dim scHisto As New SeriesCollection

                        scHisto = deHisto.GetSeries()

                        Dim xmIsPresent As Boolean = False
                        'check if axismarker is present for series
                        For Each xm As AxisMarker In ch.XAxis.Markers
                            If distinctTarget(cmbObjectTreeEval.Text).Contains(distinctTarget(cmbObjectTreeEval.Text)) And tsmi_EvalHistogramAggOrNoAgg.Checked = True Then
                                cl = xm.Line.Color
                                xmIsPresent = True
                            End If
                        Next

                        'If xmIsPresent = False Then
                        cl = Color.FromArgb(255, rnd.Next(255), rnd.Next(255), rnd.Next(255))
                        'End If

                        scHisto(0).Type = SeriesType.Bar
                        scHisto(0).YAxis = yaxis1pdf
                        scHisto(0).Name = distinctTarget(cmbObjectTreeEval.Text) + "-" + scHisto(0).Name
                        scHisto(0).DefaultElement.Color = cl

                        ch.ExtraChartAreas.Item(0).SeriesCollection.Add(scHisto(0))

                        scHisto(1).YAxis = yaxis2pdf
                        scHisto(1).Type = SeriesType.Line
                        scHisto(1).Line.Width = 3
                        scHisto(1).YAxis = yaxis2pdf
                        scHisto(1).DefaultElement.Color = Color.FromArgb(255, Math.Max(cl.R - 50, 0), Math.Max(cl.G - 50, 0), Math.Max(cl.B - 50, 0))
                        scHisto(1).EmptyElement.Mode = EmptyElementMode.Ignore
                        scHisto(1).Name = distinctTarget(cmbObjectTreeEval.Text) + "-" + scHisto(1).Name

                        ch.ExtraChartAreas.Item(0).SeriesCollection.Add(scHisto(1))

                        'axis markers in case of dateselection
                        If tsmi_EvalHistogramPeriodSelection.Checked = True And xmIsPresent = False Then

                            Dim am1 As New AxisMarker("", New Line(cl, 4), CDate(dtPrdCalcEval.Rows(0)("PeriodStart")).ToString("yyyy-MM-dd"))
                            am1.LegendEntry.Visible = False
                            am1.BringToFront = True
                            ch.XAxis.Markers.Add(am1)

                            Dim am2 As New AxisMarker("", New Line(cl, 4), CDate(dtPrdCalcEval.Rows(0)("PeriodEnd")).ToString("yyyy-MM-dd"))
                            am2.LegendEntry.Visible = False
                            am2.BringToFront = True
                            ch.XAxis.Markers.Add(am2)

                            Dim am3 As New AxisMarker("", New Line(cl, 4), CDate(dtPrdCalcEval.Rows(1)("PeriodStart")).ToString("yyyy-MM-dd"))
                            am3.LegendEntry.Visible = False
                            am3.BringToFront = True
                            ch.XAxis.Markers.Add(am3)

                            Dim am4 As New AxisMarker("", New Line(cl, 4), CDate(dtPrdCalcEval.Rows(1)("PeriodEnd")).ToString("yyyy-MM-dd"))
                            am4.LegendEntry.Visible = False
                            am4.BringToFront = True
                            ch.XAxis.Markers.Add(am4)

                        End If
                    Next

                    ch.SeriesCollection.Clear()
                    ch.SeriesCollection.Add(sc)

                    HideChartScaleIfNoDataEval(ch, dt_new)

                    sc = Nothing
                    de = Nothing

                    ch.RefreshChart()
                    ch.Visible = True
                    Dim tn As TreeNode = New TreeNode()
                    tn.Text = charttitle
                    tn.Tag = ch.Name

                    ReDim chart_elements(0)
                    ReDim chart_elementsYAxis(0)
                    ReDim chart_Eltype(0)
                    ReDim chart_ElColor(0)
                    ReDim chart_YaxisScale(1)
                    j = 0

                    If nc Is Nothing Then
                        Dim scc As SplitContainerControl = CType(ch.Parent.Parent.Parent, SplitContainerControl)
                        'CType(tp.Parent, XtraTabControl).SelectedTabPage = tp
                        scc.Panel1.Controls(scc.Panel1.Controls.Count - 1).Controls(ch.Name).Focus()
                    End If

                End If

                Charts_ResizeWidth_Eval()

            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
            End Try
        Next
        dt_chart.Dispose()
        ds_chart.Dispose()
        dt_chart = Nothing
        ds_chart = Nothing
        If Not dt Is Nothing Then
            dt.Dispose()
        End If
        'ds_eval_hist_list.Clear()

        'Adding Shade to the chart for the threshold period
        Dim shadeThreshold As AxisMarker = Nothing
        shadeThreshold = New AxisMarker("Threshold Period", New Background(Color.FromArgb(100, Color.LightGreen)), CDate(dtPrdCalcEval.Rows(0)("PeriodStart")), CDate(dtPrdCalcEval.Rows(0)("PeriodEnd")))
        shadeThreshold.LegendEntry.Visible = False
        shadeThreshold.Label.LineAlignment = StringAlignment.Near
        shadeThreshold.Label.Alignment = StringAlignment.Center
        shadeThreshold.LegendEntry.Value = ""
        ch.XAxis.Markers.Add(shadeThreshold)

        'Adding Shade to the chart for the evaluation period
        Dim shadeEvaluation As AxisMarker = Nothing
        shadeEvaluation = New AxisMarker("Evaluation Period", New Background(Color.FromArgb(100, Color.LightBlue)), CDate(dtPrdCalcEval.Rows(1)("PeriodStart")), CDate(dtPrdCalcEval.Rows(1)("PeriodEnd")))
        shadeEvaluation.LegendEntry.Visible = False
        shadeEvaluation.Label.LineAlignment = StringAlignment.Near
        shadeEvaluation.Label.Alignment = StringAlignment.Center
        shadeEvaluation.LegendEntry.Value = ""
        ch.XAxis.Markers.Add(shadeEvaluation)

        ch.RefreshChart()

        'Store chart bitmap image stream to directory
        If EvaluateReport = True Then
            If Not dicEvalRptChartImages.ContainsKey(cm_Chart_kpiname & "_Hist") Then
                dicEvalRptChartImages.Add(cm_Chart_kpiname & "_Hist", ch.GetChartBitmap)
            End If
        End If
    End Sub

    Public Sub HideChartScaleIfNoDataEval(ByRef ch As Chart, ByRef dtData As DataTable)
        '-------Hide Date if there is no data in dtChild-------
        ch.XAxis.ScaleBreakStyle = ScaleBreakStyle.None
        ch.XAxis.ScaleBreaks.Clear()
        Dim sDate As Date = dtEditStartTimeEval.EditValue
        Dim eDate As Date = dtEditEndTimeEval.EditValue
        Dim dtAxis As DataTable = dtData.DefaultView.ToTable(True, dtData.Columns(0).ColumnName)
        While sDate <= eDate
            Dim colName As String = dtData.Columns(0).ColumnName
            Dim dr() As DataRow = dtAxis.AsEnumerable().Where(Function(x) x.Item(colName) = sDate).ToArray()
            If dr.Length = 0 Then
                ch.XAxis.ScaleBreaks.Add(New dotnetCHARTING.WinForms.ScaleRange(sDate, sDate))
