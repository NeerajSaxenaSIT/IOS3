    Private Sub btnExportStats_Click(sender As Object, e As EventArgs) Handles btnExportStats.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Dim fp As String = ""
        Dim folder As String = ""
        Dim fileName As String = ""
        Dim fileNames As String = ""
        Try
            dsExport2Excel = Nothing
            dtExport2Excel = Nothing
            objTechExportOption = New dlgTechExportOption()
            objTechExportOption.ShowDialog()

            If objTechExportOption.DialogResult = DialogResult.OK Then
                Export2Excel = True
                WaitScreen.ShowWaitScreen("Exporting to CSV...")
                Application.DoEvents()

                Dim periodinterval As String = "DAY"
                If rdoRawStats.Checked Then
                    periodinterval = "RAW"
                ElseIf rdoHourlyStats.Checked Or xtcPSFilterStats.SelectedTabPage.Text.Contains("Hours") Then
                    periodinterval = "HOUR"
                ElseIf rdoWeeklyStats.Checked Then
                    periodinterval = "WEEK"
                ElseIf rdoDailyBHStats.Checked Then
                    periodinterval = "BH"
                ElseIf rdoDailyBH2Stats.Checked Then
                    periodinterval = "BHPS"
                ElseIf rdoMonthlyStats.Checked Then
                    periodinterval = "MONTH"
                End If

                If Not Directory.Exists(techExportFilePath) Then
                    XtraMessageBox.Show("Directory does not exist", "Export Failed", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                    Exit Sub
                End If

                If IsDateIntervalObjectsOK(dtEditStartTimeStats, dtEditEndTimeStats, periodinterval, Count_OT, 1000000) = False Then
                    MsgBox("Too many records! Reduce number of objects or Reduce period duration.")
                End If

                ' Build and launch object time sql query and populate dataset for export 2 excel
                ProcessStatsObjectTime(_strNetwork.ToUpper)

                fileName = "CIOS_" & Network & "_" & cmbObjectTreeStats.SelectedItem.ToString() & "_" & Now.ToString("yyyyMMddHHmmss") & ".csv"
                folder = techExportFilePath 'Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData) & "\CellSens\CIOS\" & IOS.Configuration.IOSAppConfigManage.DeploymentName
                fp = folder & "\" & fileName

                ' Delete the file if already exists
                If IO.File.Exists(fp) Then
                    IO.File.Delete(fp)
                End If

                If Not dsExport2Excel Is Nothing AndAlso dsExport2Excel.Tables.Count > 0 Then
                    MergeTablesByPrefix_MergeMethod(dsExport2Excel)
                    'Dim mergedDS As DataSet = MergeTablesByPrefix(dsExport2Excel)
                    ' For Each dt As DataTable In mergedDS.Tables
                    For Each dt As DataTable In dsExport2Excel.Tables
                        If dt.IsValid() Then
                            IOSDevExpressGrid.DataTable2Excel(dt, Replace(fp, ".csv", "_" & dt.TableName & ".csv"), objTechExportOption.fileDelimiter)
                            fileNames = fileNames & vbCrLf & Replace(fp, ".csv", "_" & dt.TableName & ".csv").TrimStart("\")
                        End If
                    Next
                Else
                    MsgBox("No data to export !")
                    Exit Sub
                End If
            Else
                Exit Sub
            End If

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        Finally
            WaitScreen.CloseWaitScreen()
            If Not dsExport2Excel Is Nothing AndAlso dsExport2Excel.Tables.Count > 0 Then
                If (folder <> "") AndAlso (folder IsNot Nothing) Then
                    XtraMessageBox.Show("Export Completed !" & vbCrLf & fileNames, "Export Successful")
                    Process.Start(folder)
                End If
            End If
            Application.DoEvents()
            Export2Excel = False
        End Try
    End Sub

