    Private Sub ResizeChartHeightsTopX(tlpRowHeight As Integer)
        Try
            tcTabControlHighTopX.SuspendLayout()
            tcTabControlHighTopX.UseWaitCursor = True

            Dim tbc As XtraTabControl = tcTabControlHighTopX
            For Each tp As XtraTabPage In tbc.TabPages
                If tp.Controls.Count > 0 Then
                    Dim tlp As TableLayoutPanel = CType(tp.Controls(0), TableLayoutPanel)
                    For Each rs As RowStyle In tlp.RowStyles
                        rs.Height = tlpRowHeight
                    Next
                End If
            Next
        Catch ex As Exception
        Finally
            tcTabControlHighTopX.ResumeLayout()
            tcTabControlHighTopX.UseWaitCursor = False
        End Try
    End Sub

