    Private Sub tvObjectsTreeStats_NodeChanged(sender As Object, e As NodeChangedEventArgs)
        RemoveHandler tvObjectsTreeStats.NodeChanged, AddressOf tvObjectsTreeStats_NodeChanged
        If e.ChangeType = DevExpress.XtraTreeList.NodeChangeTypeEnum.CheckedState Then
            If e.Node.CheckState = CheckState.Checked Then
                If tvObjectsTreeStats.FindFilterText <> "" Then
                    tvObjectsTreeStats_FilterCheckVisible(e.Node.Nodes)
                Else
                    e.Node.CheckAll()
                End If
            Else
