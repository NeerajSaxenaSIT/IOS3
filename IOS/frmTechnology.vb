    Private Function GetFilterPeriodStats(ByRef cmb As ComboBoxEdit, ByRef dNavigator As DevExpress.XtraScheduler.DateNavigator) As String
        Try
            Dim SQL As String = ""
            Dim cmbVal As Integer = TryCast(cmb.SelectedItem, clsComboBoxItem).Value
            If cmb.SelectedIndex > 0 Then
                Dim dr() As DataRow = dtPredefinePeriod.AsEnumerable().Where(Function(x) x.Field(Of Integer)("PredefinedPeriodID") = cmbVal).ToArray()

                If Not dr Is Nothing Then
                    If dr.Count > 0 Then
                        SQL = dr(0)("SQL").ToString
                    Else
                        SQL = "@filter"
                    End If
                Else
                    SQL = "@filter"
                End If
            Else
                SQL = "@filter"
            End If

            Dim filterPeriod As DevExpress.XtraScheduler.SchedulerDateRangeCollection
            filterPeriod = dNavigator.SelectedRanges

            If Not preSelectedFilterPeriodStats Is Nothing Then
                For i As Integer = 0 To preSelectedFilterPeriodStats.Count - 1
                    If Not filterPeriod.Contains(preSelectedFilterPeriodStats(i)) Then
                        filterPeriod.Add(preSelectedFilterPeriodStats(i))
                    End If
                Next
            End If

            If xtcPSFilterStats.SelectedTabPage.Text = "Hours" Then
                filterPeriod.Clear()
                Dim endDate As DateTime = dtEditEndTimeStats.DateTime.AddDays(1)
                filterPeriod.Add(New DateRange(dtEditStartTimeStats.EditValue, endDate))
            End If

            Dim flag As Boolean = False
            HourListStats.Clear()
            If xtcPSFilterStats.SelectedTabPage.Text = "Hours" Then
                For Each btnToggle As Control In tlpFilterHoursStats.Controls
                    If CType(btnToggle, IOSToggleButton).ToggleState = CheckState.Checked Then
                        HourListStats.Add(btnToggle.Tag)
                    Else
                        HourListStats.Remove(btnToggle.Tag)
                    End If
                Next
                If rdoFilterHrsIncStats.Checked Or rdoFilterHrsExcStats.Checked Then
                    flag = True
                End If
            Else
                If rdoFilterDaysIncStats.Checked Or rdoFilterDaysExcStats.Checked Then
                    flag = True
                End If
            End If

            ScaleDateToBeExcluded.Clear()
            Dim filterQry As String = ""
            If flag Then
                For Each dt As DateRange In filterPeriod
                    If dt.StartDate.Date.CompareTo(dt.EndDate.Date.AddDays(-1)) = 0 Then
                        If xtcPSFilterStats.SelectedTabPage.Text = "Hours" Then
                            For Each tString As String In HourListStats
                                filterQry = filterQry & "'" & dt.StartDate.ToString("yyyy-MM-dd " & tString & ":00") & "',"
                            Next
                        Else
                            filterQry = filterQry & "'" & dt.StartDate.ToString("yyyy-MM-dd 00:00") & "',"
                        End If
                        Continue For
                    Else
                        Dim sDate As Date = dt.StartDate
                        Dim eDate As Date = dt.EndDate.AddDays(-1)
                        While sDate <= eDate
                            If xtcPSFilterStats.SelectedTabPage.Text = "Hours" Then
                                For Each tString As String In HourListStats
                                    filterQry = filterQry & "'" & sDate.ToString("yyyy-MM-dd " & tString & ":00") & "',"
                                Next
                            Else
                                If Not filterQry.Contains(sDate.ToString("yyyy-MM-dd 00:00")) Then
                                    filterQry = filterQry & "'" & sDate.ToString("yyyy-MM-dd 00:00") & "',"
                                End If
                            End If
                            sDate = sDate.AddDays(1)
                        End While
                    End If
                Next
            End If
            filterQry = filterQry.TrimEnd(",") & ""
            If filterQry = "" Then
                SQL = SQL.Replace("@filter", "")
            Else
                If xtcPSFilterStats.SelectedTabPage.Text = "Hours" Then
                    If rdoFilterHrsIncStats.Checked Then
                        filterQry = " IN(" & filterQry & ")"
                    ElseIf rdoFilterHrsExcStats.Checked Then
                        filterQry = " NOT IN(" & filterQry & ")"
                    End If
                Else
                    If rdoFilterDaysIncStats.Checked Then
                        filterQry = " IN(" & filterQry & ")"
                    ElseIf rdoFilterDaysExcStats.Checked Then
                        filterQry = " NOT IN(" & filterQry & ")"
                    End If
                End If

                SQL = SQL.Replace("@filter", " AND PERIOD_START_TIME " & filterQry)
            End If
            If xtcPSFilterStats.SelectedTabPage.Text = "Hours" Then
                SQL = SQL.Replace("PERIOD_START_TIME", "DATEADD(hh, DATEDIFF(hh, 0, @alias.PERIOD_START_TIME ), 0) ")
            Else
                SQL = SQL.Replace("PERIOD_START_TIME", "DATEADD(dd, DATEDIFF(dd, 0, @alias.PERIOD_START_TIME ), 0) ")
            End If

            Return SQL

        Catch ex As Exception
            Return ""
        End Try
    End Function

