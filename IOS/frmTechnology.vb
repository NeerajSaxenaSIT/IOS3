    Private Sub btnApplyTopX_Click(sender As Object, e As EventArgs) Handles btnApplyTopX.Click
        Try
            topXGridActiveFiler = Nothing
            DefaultSeriesCollectionTopX.Clear()
            ExtraLegendEntryCollectionTopX.Clear()
            'HiddenSeriesCollectionTopX.Clear()

            If Not dsTopX Is Nothing Then
                dsTopX.Dispose()
                dsTopX = Nothing
            End If

            DataGrid_TopX.DataSource = Nothing
            DataGrid_TopX.Refresh()
            DataGrid_TopX.Update()

            If cmbObjectTreeTopX.Text = "" Then
                lblObjectTreeStatusTopX.Text = "Choose Target Aggregation !"
                lblObjectTreeStatusTopX.ForeColor = Color.Red
                Exit Sub
            End If

            If btnApplyTopX.Text = "Abort" Then
                t_TopX_lastid = -1
                lblObjectTreeStatusTopX.Text = "Thread Aborted !"
                lblObjectTreeStatusTopX.ForeColor = Color.Red

                btnApplyTopX.Text = "Apply"
                Me.AccCtrlTopX.Enabled = True
                ucProgPnlTopX.StopProgress()
                Exit Sub
            Else
                btnApplyTopX.Text = "Abort"
                Me.AccCtrlTopX.Enabled = False
                ucProgPnlTopX.StartProgress()
            End If

            timerTopX = Now()

            If cmbObjectTreeTopX.SelectedItem.ToString = "WCEL" Then
                If tvObjectsTreeTopX.GetAllCheckedNodes().Where(Function(nd) nd.Level = 3).ToList().Count = 0 Then
                    lblObjectTreeStatusTopX.Text = "No WCEL Source Selected !"
                    lblObjectTreeStatusTopX.ForeColor = Color.Red
                    Exit Sub
                End If
            ElseIf cmbObjectTreeTopX.SelectedItem.ToString = "WBTS" Then
                If tvObjectsTreeTopX.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList().Count = 0 Then
                    lblObjectTreeStatusTopX.Text = "No WBTS Source Selected !"
                    lblObjectTreeStatusTopX.ForeColor = Color.Red
                    Exit Sub
                End If
            ElseIf cmbObjectTreeTopX.SelectedItem.ToString = "RNC" Then
                If tvObjectsTreeTopX.GetAllCheckedNodes().Where(Function(nd) nd.Level = 1).ToList().Count = 0 Then
                    lblObjectTreeStatusTopX.Text = "No RNC Source Selected !"
                    lblObjectTreeStatusTopX.ForeColor = Color.Red
                    Exit Sub
                End If
            ElseIf cmbObjectTreeTopX.SelectedItem.ToString = "PLMN" Then
                If tvObjectsTreeTopX.GetAllCheckedNodes().Where(Function(nd) nd.Level = 0).ToList().Count = 0 Then
                    lblObjectTreeStatusTopX.Text = "No PLMN Source Selected !"
                    lblObjectTreeStatusTopX.ForeColor = Color.Red
                    Exit Sub
                End If
            End If

            Dim objectsel As String = tvObjectsTreeTopX.GetChecked2String("TopX_" & _strNetwork, cmbObjectTreeTopX.Text, "ObjectName")
            If objectsel = "IN ()" Then
                lblObjectTreeStatusTopX.Text = "No Object Selected of type: " & cmbObjectTreeTopX.Text
                lblObjectTreeStatusTopX.ForeColor = Color.Red
                btnApplyTopX.PerformClick()
                Exit Sub
            End If

            Dim charts_count As Integer = tvKPITopX.GetAllCheckedNodes().Where(Function(x) x.Level = 2).ToList().Count
            If charts_count < 10 Then
                If CInt(txtSelectXTopX.Text.Trim) > 5000 Then
                    lblObjectTreeCountTopX.Text = "Max Top 5000 allowed!"
                    Exit Sub
                End If
            Else
                If CInt(txtSelectXTopX.Text.Trim) > 1000 Then
                    lblObjectTreeCountTopX.Text = "Max Top 1000 allowed!"
                End If
            End If

            Reconstruct_Charts_TopX("TopX_" & _strNetwork)
            Process_TopX()
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

    Private Sub Process_TopX()
        Try
            Dim sql_total As String = Nothing
            Dim connstring As String
            'Get SQL
            Try
                sql_total = SQL_Construct_TopX(flpSourceBtn_GetChecked("topx_" & _strNetwork, flpCounterTypeTopX)(0).SourceButtonText, Nothing)
            Catch
            End Try

            If sql_total Is Nothing Then
                btnApplyTopX.PerformClick()
                Exit Sub
            End If

            If sql_total = "" Then
                btnApplyTopX.PerformClick()
                Exit Sub
            End If

            connstring = connectionString

            'Get DATA
            'Launching Top 3G  thread
            '*****************************

            t_TopStats = New Thread_Stats
            t_TopX = New Threading.Thread(AddressOf t_TopStats.GetData)

            t_TopStats.connstring = connstring
            t_TopStats.sql_total = sql_total

            AddHandler t_TopStats.ThreadComplete, AddressOf Process_TopX_ThreadEnd

            t_TopX_lastid = t_TopX.ManagedThreadId
            t_TopX.Start()
            lblObjectTreeStatusTopX.Text = "Query Started..."
            lblObjectTreeStatusTopX.ForeColor = Color.Black
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            lblObjectTreeStatusTopX.Text = "Failed...Try Again"
            lblObjectTreeStatusTopX.ForeColor = Color.Red
        End Try
    End Sub

    Private Function SQL_Construct_TopX(aggr_from As String, chartname As String) As String
        Dim tech As String = _strNetwork
