    Private Sub cmbObjectTreeEval_SelectedIndexChanged(sender As Object, e As EventArgs) Handles cmbObjectTreeEval.SelectedIndexChanged
        Try
            If Not cmbObjectTreeEval.SelectedItem Is Nothing Then
                If cmbObjectTreeEval.SelectedItem.ToString <> "" Then
                    FillTreeList(tvObjectsTreeEval, cmbObjectTreeEval.SelectedItem.ToString, "PLMN", Nothing, CType(cmbObjectTreeEval.SelectedItem, clsComboBoxItem).Enabled)
                    txtFilterTreeEval.Enabled = Not CType(cmbObjectTreeEval.SelectedItem, clsComboBoxItem).Enabled

                    For Each vb As IOS.Library.IOSToggleButton In flpCounterTypeEval.Controls
                        If vb.Text = cmbObjectTreeEval.SelectedItem.ToString Then
                            vb.ToggleState = CheckState.Checked
                        ElseIf cmbObjectTreeEval.SelectedItem.ToString = "PLMN" Then
                            Exit For
                        Else
                            vb.ToggleState = CheckState.Unchecked
                        End If
                    Next

                    LoadObjectFilterTemplateData(cmbObjectTreeEval.SelectedItem.ToString)
                    BindObjFilterTemplateCombo(cmbFilterTemplateEval)
                    LoadObjectFilterParams(cmbObjectTreeEval, "Eval")
                    ChangeSaveTemplateButtonBackColor(cmbObjectTreeEval.Name, Nothing)
                End If
            End If

            txtFilterTreeEval.Text = ""
            Count_OT = 0
            lblObjTreeCountEval.Text = "#: 0"
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

    Private Sub LoadObjectFilterParams(ByRef cmb As ComboBoxEdit, ByVal ProcType As String)
        Try
            Dim TargetType As String = cmb.SelectedItem.ToString
            Dim sqlParam As String = Nothing
            Dim connstring As String = Nothing
            Dim ShowObjects As String = Nothing

            If ProcType.ToLower.Contains("charts") Then
                ShowObjects = flpSourceBtn_GetChecked(_strNetwork, flpCounterTypeStats)(0).SourceButtonText
            ElseIf ProcType.ToLower.Contains("topx") Then
                ShowObjects = flpSourceBtn_GetChecked(_strNetwork, flpCounterTypeTopX)(0).SourceButtonText
            ElseIf ProcType.ToLower.Contains("eval") Then
                ShowObjects = "IS NULL"
            End If

            Dim parray()() As String = {
                New String() {"@Tech", Chr(39) & _strNetwork & Chr(39)},
                New String() {"@TargetType", Chr(39) & TargetType & Chr(39)},
                New String() {"@ChartsTopXEval", Chr(39) & ProcType & Chr(39)},
                New String() {"@ShowObjects", IIf(ShowObjects = "IS NULL", ShowObjects, " = " & Chr(39) & ShowObjects & Chr(39))}
            }

            sqlParam = GetSQL(8815, parray)(1)
            connstring = GetSQL(8815, parray)(0)
            Dim dt As DataTable = DataAccessorODBC.GetDataTable(connstring, sqlParam)
            Dim lbCtrl As ListBoxControl = Nothing

            If cmb.Name.ToLower.Contains("stats") Then
                lbCtrl = lbFilterParamListStats
            ElseIf cmb.Name.ToLower.Contains("topx") Then
                lbCtrl = lbFilterParamListTopX
            ElseIf cmb.Name.ToLower.Contains("eval") Then
                lbCtrl = lbFilterParamListEval
            End If

            lbCtrl.Items.Clear()
            lbCtrl.DataSource = Nothing
            If dt IsNot Nothing AndAlso dt.Rows.Count > 0 Then
                lbCtrl.DisplayMember = "ParameterName"
                lbCtrl.ValueMember = "ParameterName"
                lbCtrl.Tag = dt.Rows(0)("SourceTable").ToString
                lbCtrl.DataSource = dt
            Else
                lbCtrl.DataSource = Nothing
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

