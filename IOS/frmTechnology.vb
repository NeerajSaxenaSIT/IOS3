    Private Sub AddChartAxisMarkers_New(ByRef dt As DataTable, coldate As String, colprio As String, Optional labelcol As String = "")
        Dim stc As XtraTabControl = Nothing
        stc = CType(tcTabControlHighStats.SelectedTabPage.Controls(0), XtraTabControl)
        Dim culture As Globalization.CultureInfo = Globalization.CultureInfo.CurrentCulture

        If dt Is Nothing Then
            Exit Sub
        End If
        Try
            For Each tb As XtraTabPage In stc.TabPages
                If tb.Controls.Count > 0 Then
                    For Each ch As Chart In tb.Controls(0).Controls.OfType(Of Chart)()

                        If ch.Type <> ChartType.Surface Then

                            If colprio Is Nothing Then
                                ch.XAxis.Markers.Clear()
                            End If

                            For Each drow As DataRow In dt.Rows
                                Dim datestart As DateTime = Nothing
                                If (rdoDailyStats.Checked) Or (rdoDailyBHStats.Checked) Or (rdoDailyBH2Stats.Checked) Then
                                    datestart = CDate(drow(coldate).ToString).ToString("yyyy/MM/dd")
                                ElseIf rdoWeeklyStats.Checked Then
                                    datestart = GetStartOfWeek(CDate(drow(coldate).ToString), culture).ToString("yyyy/MM/dd")
                                ElseIf rdoMonthlyStats.Checked Then
                                    datestart = GetFirstDayOfMonth(CDate(drow(coldate).ToString)).ToString("yyyy/MM/dd")
                                ElseIf (rdoHourlyStats.Checked) Or (rdoRawStats.Checked) Then
                                    datestart = CDate(drow(coldate).ToString)
                                End If

                                Dim cl As Color = Color.Black
                                If Not colprio Is Nothing Then
                                    If colprio.ToUpper = "SEVERITY" Then
                                        Select Case drow(colprio).ToString
                                            Case "1"
                                                cl = Color.FromArgb(200, Color.Red)
                                            Case "2"
                                                cl = Color.FromArgb(150, Color.OrangeRed)
                                            Case "3"
                                                cl = Color.FromArgb(150, Color.Orange)
                                            Case "4"
                                                cl = Color.FromArgb(100, Color.Orange)
                                            Case "5"
                                                cl = Color.FromArgb(100, Color.Yellow)
                                        End Select
                                    ElseIf colprio = "NoteType" Then
                                        Select Case drow("NoteTypeID").ToString
                                            Case 1
                                                cl = Color.FromArgb(200, Color.DodgerBlue)
                                            Case 2
                                                cl = Color.FromArgb(200, Color.Blue)
                                            Case 3
                                                cl = Color.FromArgb(200, Color.DarkViolet)
                                            Case 4
                                                cl = Color.FromArgb(200, Color.LimeGreen)
                                            Case 5
                                                cl = Color.FromArgb(200, Color.OrangeRed)
                                            Case 6
                                                cl = Color.FromArgb(200, Color.Red)
                                            Case 7
                                                cl = Color.FromArgb(200, Color.DarkRed)
                                        End Select
                                    ElseIf colprio.ToUpper = "PRIO" Then
                                        Select Case ExtractNumber(drow(colprio).ToString)
                                            Case "1"
                                                cl = Color.FromArgb(200, Color.Red)
                                            Case "2"
                                                cl = Color.FromArgb(150, Color.OrangeRed)
                                            Case "3"
                                                cl = Color.FromArgb(150, Color.Orange)
                                            Case "4"
                                                cl = Color.FromArgb(100, Color.Orange)
                                            Case "5"
                                                cl = Color.FromArgb(100, Color.Yellow)
                                            Case "6"
                                                cl = Color.FromArgb(100, Color.Purple)
                                            Case "7"
                                                cl = Color.FromArgb(100, Color.Maroon)
                                            Case "8"
                                                cl = Color.FromArgb(100, Color.Teal)
                                        End Select
                                    End If
                                End If

                                Dim am4 As New AxisMarker("", New Line(cl, 4), datestart)
                                am4.LegendEntry.Visible = False
                                If labelcol <> "" Then
                                    Dim labeltextbycolumn As String = Nothing
                                    For Each str As String In Split(labelcol, ",")
                                        labeltextbycolumn = labeltextbycolumn & drow(str).ToString & ": "
                                    Next
                                    labeltextbycolumn = labeltextbycolumn.TrimEnd(": ")
                                    am4.Label.Alignment = StringAlignment.Near
                                    am4.Label.LineAlignment = StringAlignment.Far
                                    am4.Label.Text = labeltextbycolumn
                                End If
                                am4.BringToFront = True
                                ch.XAxis.Markers.Add(am4)
                            Next
                            ch.RefreshChart()
                        End If

                    Next
                End If
            Next
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

    Public Function ExtractNumber(input As String) As String
        ' \d+ looks for one or more digits
        Dim match As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(input, "\d+")

        If match.Success Then
            Return match.Value
        Else
            Return String.Empty ' Or handle as error/null
        End If
    End Function

