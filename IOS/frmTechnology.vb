    Private Function MergeDataTables(dict As Dictionary(Of String, DataTable)) As DataTable
        Dim dtMerged As DataTable = Nothing
        For Each kvp In dict
            Dim dt As DataTable = kvp.Value

            If dtMerged Is Nothing Then
                dtMerged = dt.Clone()
            End If

            For Each row As DataRow In dt.Rows
                dtMerged.ImportRow(row)
            Next
        Next
        Return dtMerged
    End Function

