    Private Sub KPI_FilterTemplate_Reload(tech As String, currentselection As Integer)
        Dim sql_insert As String = Nothing
        Dim connstring As String = Nothing
        Try
            Dim parray()() As String = {New String() {"@Tech", Chr(39) & tech & Chr(39)},
                                        New String() {"@userid", Chr(39) & System.Environment.UserName.ToString & Chr(39)}}

            sql_insert = GetSQL(8803, parray)(1)
            connstring = GetSQL(8803, parray)(0)

            Dim ds As DataSet = DataAccessorODBC.GetDataSet(connstring, sql_insert, iQryTimeOut)
            If Not ds Is Nothing Then
                If ds.Tables(0).Rows.Count = 0 Then
                    KPI_FilterTemplate_Add("No Filter", tech)
                    ds.Dispose()
                    ds = Nothing
                    ds = DataAccessorODBC.GetDataSet(connstring, sql_insert)
                End If
                If tech.ToLower = "topx_" & _strNetwork.ToLower Then
                    _dtKPIFilterTopX = ds.Tables(0)
                End If

                cmbTemplateTopX.SuspendLayout()
                cmbTemplateTopX.Text = ""
                If tech.ToLower = "topx_" & _strNetwork.ToLower Then
                    BindFilterCombo(cmbTemplateTopX, _dtKPIFilterTopX, ds.Tables(0).Columns(0).Caption, ds.Tables(0).Columns(1).Caption, currentselection)
                End If
                cmbTemplateTopX.SelectedIndex = currentselection
                cmbTemplateTopX.Properties.TextEditStyle = TextEditStyles.DisableTextEditor
                ds.Dispose()
                ds = Nothing
                cmbTemplateTopX.ResumeLayout()
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
