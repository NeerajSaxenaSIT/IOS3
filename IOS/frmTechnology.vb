    Private Sub ConstructTabAndChart_TopX(chSetName As String, tabname As String)
        Dim conn As Odbc.OdbcConnection = Nothing
        Dim comm As Odbc.OdbcCommand = Nothing
        Dim dr As Odbc.OdbcDataReader = Nothing
        Dim sql As String = Nothing
        Dim username As String = Chr(39) & Environment.UserName.ToString & Chr(39)
        Try
            conn = New Odbc.OdbcConnection(connStrIOSServer)
            conn.ConnectionTimeout = 5
            conn.Open()

            If chSetName = chartSetName Then
                sql = clsSQLCommands.GetChartConfigByUsernameAndChartSet(chSetName, username, tabname)
            Else
                sql = clsSQLCommands.GetChartConfigByUsernameAndChartSet(chSetName, tabname)
            End If
            comm = New Odbc.OdbcCommand(sql, conn)
            dr = comm.ExecuteReader

            If dr.HasRows = False Then
                MsgBox("No Chart Configuration Detected. Check IOS Server Connection!")
                dr.Close()
                comm.Dispose()
                conn.Close()
                Exit Sub
            End If

            While dr.Read
                AddTabPage(dr.GetValue(0).ToString.Trim, dr.GetValue(1), dr.GetValue(2), GetTabControlFromTech(dr.GetValue(0).ToString))
                Console.WriteLine(dr.GetValue(2).ToString & "-" & dr.GetValue(0).ToString & "!")
                If dr.GetValue(2).ToString = "Custom" And dr.GetValue(0).ToString.ToUpper = Network.ToUpper Then
                    customTabIndexStats = GetTabControlFromTech(dr.GetValue(0).ToString).TabPages.Count - 1
                ElseIf dr.GetValue(2).ToString = "Custom" And dr.GetValue(0).ToString.ToUpper = "TOPX_" & Network.ToUpper Then
                    customTabIndexTopX = GetTabControlFromTech(dr.GetValue(0).ToString).TabPages.Count - 1
                End If
            End While

            dr.Close()
            comm.Dispose()

            'ADD fixed 3G HOURLY tab
            If tabname = _strNetwork Then
                AddTabPage(_strNetwork, GetTabControlFromTech(_strNetwork).TabPages.Count, "*CLUSTER*", GetTabControlFromTech(_strNetwork))
            End If

            'Add chart
            If chSetName = chartSetName Then
                sql = clsSQLCommands.GetAddChartQuery(chSetName, username, tabname)
            Else
                sql = clsSQLCommands.GetAddChartQuery(chSetName, tabname)
            End If

            comm = New Odbc.OdbcCommand(sql, conn)
            dr = comm.ExecuteReader

            Dim tabindex_old As Integer = 0
            Dim chartindex As Integer = -1

            While dr.Read
                Dim tabindex_new As Integer = CInt(dr.GetValue(1))

                If tabindex_old <> tabindex_new Then
                    chartindex = 0
                    tabindex_old = tabindex_new
                Else
                    chartindex = chartindex + 1
                End If
                If CInt(dr.GetValue(1)) = 99 And dr.GetValue(0).ToString.ToUpper = "TOPX_" & _strNetwork.ToUpper Then
                    AddChart(dr.GetValue(0).ToString.Trim, customTabIndexTopX, dr.GetValue(4).ToString, chartindex)
                ElseIf CInt(dr.GetValue(1)) = 99 And dr.GetValue(0).ToString.ToUpper = _strNetwork.ToUpper Then
                    AddChart(dr.GetValue(0).ToString.Trim, customTabIndexStats, dr.GetValue(4).ToString, chartindex)
                Else
                    AddChart(dr.GetValue(0).ToString.Trim, dr.GetValue(1), dr.GetValue(4).ToString, chartindex)
                End If
            End While
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        Finally
            If Not conn Is Nothing Then
                conn.Close()
            End If
            If Not dr Is Nothing Then
                dr.Close()
            End If
            comm.Dispose()
            conn.Dispose()
        End Try
    End Sub

    Private Sub AddTabPage(tech As String, tabindex As Integer, tabname As String, ByRef SuperTabControl As XtraTabControl)
        Try
            Dim tp As New DevExpress.XtraTab.XtraTabPage
            Dim flp As FlowLayoutPanel = New FlowLayoutPanel()
            flp.FlowDirection = FlowDirection.LeftToRight
            flp.AutoScroll = True

            If Not tech.ToLower.Contains("topx_") Then
                If tabindex = 0 Then
                    SuperTabControl.TabPages(0).Text = tabname.ToString.Trim
                    SuperTabControl.TabPages(0).Name = tabname.ToString.Trim
                    SuperTabControl.TabPages(0).Controls.Add(flp)

                Else
                    tp = New XtraTabPage
                    tp.Text = tabname.ToString.Trim
                    tp.Name = tabname.ToString.Trim
                    tp.Width = SuperTabControl.Width
                    tp.AutoScroll = True
                    SuperTabControl.TabPages.Add(tp)
                    tp.Dock = DockStyle.Fill
                    tp.Controls.Add(flp)
                End If
                flp.Dock = DockStyle.Fill
            Else

                tp = New XtraTabPage
                tp.Text = tabname.ToString.Trim
                tp.Name = tabname.ToString.Trim
                tp.AutoScroll = True
                SuperTabControl.TabPages.Add(tp)

                Dim tbllayout As TableLayoutPanel
                tbllayout = New System.Windows.Forms.TableLayoutPanel
                tbllayout.Anchor = AnchorStyles.Left
                tbllayout.Dock = DockStyle.Top
                tbllayout.GrowStyle = TableLayoutPanelGrowStyle.AddRows
                tbllayout.AutoSize = True
                tbllayout.AutoSizeMode = AutoSizeMode.GrowOnly
                tbllayout.ColumnCount = 2
                tbllayout.ColumnStyles.Add(New System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType.Absolute, Math.Max(tp.Parent.Width / 2, 500)))
                tbllayout.ColumnStyles.Add(New System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType.Percent, 50.0!))
                tbllayout.RowCount = 1
                tbllayout.RowStyles.Add(New System.Windows.Forms.RowStyle(System.Windows.Forms.SizeType.Absolute, 375.0!))
                tbllayout.Name = "Layout_" & tabname.ToString.Trim
                tbllayout.Size = New System.Drawing.Size(CInt(SuperTabControl.TabPages(SuperTabControl.TabPages.Count - 1).Width - 10), 375)
                tbllayout.MinimumSize = New System.Drawing.Size(800, 375)

                SuperTabControl.TabPages(SuperTabControl.TabPages.Count - 1).AutoScroll = True
                SuperTabControl.TabPages(SuperTabControl.TabPages.Count - 1).Controls.Add(tbllayout)

            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

