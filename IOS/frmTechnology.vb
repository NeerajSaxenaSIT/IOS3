    Private Sub Process_Stats(Optional IsObjectAggregated As Boolean = True)
        Try
            'Constructing STATS SQL
            If flpSourceBtn_GetChecked(_strNetwork, flpCounterTypeStats).Count = 0 Then
                lblObjTreeStatusStats.Text = "Choose Source Type!"
                lblObjTreeStatusStats.ForeColor = Color.Red
                Application.DoEvents()
                Exit Sub
            End If

            Dim sql_all As New System.Collections.Specialized.StringCollection()
            Dim sql_crosstabobj As New List(Of String)
            Dim sql_obj As New List(Of String)
            'get list of tables

            'get KPI sql
            Using conn_el As New Odbc.OdbcConnection(connStrIOSServer)
                conn_el.ConnectionTimeout = 5
                conn_el.Open()

                Dim selected_tabs As String = tvKPIStats.GetKPIChecked2String(2, "ObjectName") '' TreeViewKPI_Checked2String(tvKPIStats, 2, "ObjectName")
                Dim selected_charts As String = tvKPIStats.GetKPIChecked2String(3, "ObjectName") '' TreeViewKPI_Checked2String(tvKPIStats, 3, "ObjectName")

                For Each srcbtn As SourceButton In flpSourceBtn_GetChecked(_strNetwork, flpCounterTypeStats)

                    Using comm_Element As New Odbc.OdbcCommand("SELECT DISTINCT COALESCE(IOS_SQL_KPI.sourcetable,'') AS sourcetable,COALESCE(IOS_SQL_KPI.JoinObjects,'') AS JoinObjects,COALESCE(IOS_Chart_Configuration.CrossTabObj,'') AS CrossTabObj" _
                                                             & " FROM IOS_Chart_Configuration " _
                                                             & " INNER JOIN IOS_SQL_KPI ON IOS_Chart_Configuration.SQLKPI_ID = IOS_SQL_KPI.SQLKPI_ID " _
                                                             & " WHERE (IOS_Chart_Configuration.TechTab = " & Chr(39) & _strNetwork & Chr(39) & ") " _
                                                             & " And  CategoryTab " & selected_tabs & " " _
                                                             & " And ChartTitle " & selected_charts & " " _
                                                             & " And (IOS_SQL_KPI.Object = " & Chr(39) & srcbtn.SourceButtonText & Chr(39) & ") " _
                                                             & " And (sourcetable Is Not null)", conn_el)
                        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", comm_Element.CommandText)
                        Using dr As Odbc.OdbcDataReader = comm_Element.ExecuteReader
                            'loop through all tables
                            While dr.Read
                                sql_crosstabobj.Add(nZ(dr.Item("CrossTabObj"), "").ToString.Trim)
                                sql_obj.Add(srcbtn.SourceButtonText)
                                sql_all.Add(SQL_Construct(srcbtn.SourceButtonText, nZ(dr.Item("sourcetable").ToString.Trim, ""), Nothing, nZ(dr.Item("CrossTabObj"), ""), IsObjectAggregated))
                            End While
                        End Using

                    End Using
                Next
            End Using

            If sql_all.Count = 0 Then
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "No SQL to Fire")
                btnApplyStats.PerformClick() 'aborting
                Exit Sub
            End If

            Notes_Get(_strNetwork)
            Threads_Fired = 0
            dsStats = New DataSet
            ds_list.Clear()
            t_list.Clear()
            mm.ReleaseMemory()

            'Launching stats threads
            '****************************************
            For Each sql_to_fire As String In sql_all
                Dim stats_t As New Thread_Stats
                stats_t.connstring = connectionString
                stats_t.sql_total = sql_to_fire
                stats_t.ds_name = sql_obj(Threads_Fired) & "/" & sql_crosstabobj(Threads_Fired) & "/"
                AddHandler stats_t.ThreadComplete, AddressOf Process_Stats_ThreadEnd

                Dim thread_x As New Threading.Thread(AddressOf stats_t.GetData)
                thread_x.Start()

                t_list.Add(thread_x)
                Threads_Fired = Threads_Fired + 1
            Next

            Dim drow() As DataRow = dt_IOS_ObjectConfig.AsEnumerable().Where(Function(x) x.Field(Of String)("Tech").ToUpper = _strNetwork.ToUpper And x.Field(Of String)("Object") = cmbObjectTreeStats.SelectedItem.ToString).ToArray()
            If drow.Count > 0 And ConsoleAndRun = False Then
                If cmbObjectTreeStats.SelectedItem.ToString = "TAGS" Then
                    frmMapWindow.Cells_SearchAndDisplay(tvObjectsTreeStats.GetChecked2String(_strNetwork, flpSourceBtn_GetType(_strNetwork, "CELL", flpCounterTypeStats).SourceButtonText, "Naked", strTreeFilter), _strNetwork, cmbObjectTreeStats.SelectedItem.ToString)
                ElseIf drow(0)("InternalObjectName").ToString.ToUpper = "CELL" Then
                    frmMapWindow.Cells_SearchAndDisplay(tvObjectsTreeStats.GetChecked2String(_strNetwork, flpSourceBtn_GetType(_strNetwork, "CELL", flpCounterTypeStats).SourceButtonText, "Naked", strTreeFilter), _strNetwork, cmbObjectTreeStats.SelectedItem.ToString)
