    Private Sub btnDelTemplateEval_Click(sender As Object, e As EventArgs) Handles btnDelTemplateEval.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Try
            If cmbFilterTemplateEval.SelectedIndex > 0 Then
                Dim objFilterTemplateID As Integer = CInt(CType(cmbFilterTemplateEval.SelectedItem, clsComboBoxItem).Value)
                Dim templateOwner As String = dtObjFilterTemplate.AsEnumerable().Where(Function(x) x.Field(Of Integer)("ObjectFilterTemplateID") = objFilterTemplateID).ToArray()(0)("TemplateOwner").ToString

                Dim isPowerUser As Boolean = False
                If (templateOwner.ToLower <> Environment.UserName.ToLower) Then
                    If configMgr.User.IsPowerUser = True Then
                        isPowerUser = True
                    Else
                        XtraMessageBox.Show("Only the template owner or the power user can clear the analysis", "Delete Filter Template!", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                        isPowerUser = False
                        Exit Sub
                    End If
                Else
                    isPowerUser = True
                End If

                If (isPowerUser = True) Then
                    If XtraMessageBox.Show("Are you sure to delete filter template: " & cmbFilterTemplateEval.SelectedItem.ToString & "?", "Delete Filter Template!", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Warning) = DialogResult.Yes Then
                        DeleteObjFilterTemplate(objFilterTemplateID)

                        LoadObjectFilterTemplateData(cmbObjectTreeEval.SelectedItem.ToString)
                        BindObjFilterTemplateCombo(cmbFilterTemplateTopX)
                        UpdateObjFilterTemplateGrid(cmbFilterTemplateTopX, gcParamFiltersTopX)

                        BindObjFilterTemplateCombo(cmbFilterTemplateStats)
                        UpdateObjFilterTemplateGrid(cmbFilterTemplateStats, gcParamFiltersStats)

                        BindObjFilterTemplateCombo(cmbFilterTemplateEval)
                        UpdateObjFilterTemplateGrid(cmbFilterTemplateEval, gcParamFiltersEval)
                    End If
                End If
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub btnSaveTemplateEval_Click(sender As Object, e As EventArgs) Handles btnSaveTemplateEval.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Invoked")
        Try
            Dim FilterTemplateName As String = Nothing
            Dim objFilterTemplateID As Integer = Nothing
            Dim result As Integer = 7
            If cmbFilterTemplateEval.Text <> "Select" Then
                result = XtraMessageBox.Show("Overwrite Selected Filter Template?", "Filter Template Saving", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question)
            End If

            If result = DialogResult.Cancel Then
                Exit Sub
            ElseIf result = DialogResult.No Then
                FilterTemplateName = XtraInputBox.Show("Filter Template Name: ", "Add Filter Template", "")
            ElseIf result = DialogResult.Yes Then
                FilterTemplateName = cmbFilterTemplateEval.SelectedItem.ToString
            End If

            If FilterTemplateName = "" Or FilterTemplateName = "Select" Then
                Exit Sub
            End If

            Dim indexOftemplate As Integer = -1
            For i = 0 To cmbFilterTemplateEval.Properties.Items.Count - 1
                If cmbFilterTemplateEval.Properties.Items(i).Text = FilterTemplateName Then
                    indexOftemplate = i
                End If
            Next

            If indexOftemplate = -1 Then
                SaveNewFilterTemplate(FilterTemplateName, cmbObjectTreeEval.SelectedItem.ToString)

                Dim dtFilters As New DataTable
                dtFilters.Columns.Add("FieldName", GetType(String))
                dtFilters.Columns.Add("FieldOperator", GetType(String))
                dtFilters.Columns.Add("FieldValue", GetType(String))

                For iCntr = 0 To gvParamFiltersEval.RowCount - 1
                    Dim drFilter As DataRow = dtFilters.NewRow()
                    drFilter("FieldName") = gvParamFiltersEval.GetRowCellValue(iCntr, "FieldName")
                    drFilter("FieldOperator") = gvParamFiltersEval.GetRowCellValue(iCntr, "FieldOperator")
                    drFilter("FieldValue") = gvParamFiltersEval.GetRowCellValue(iCntr, "FieldValue")
                    dtFilters.Rows.Add(drFilter)
                    dtFilters.AcceptChanges()
                Next

                LoadObjectFilterTemplateData(cmbObjectTreeEval.SelectedItem.ToString)
                BindObjFilterTemplateCombo(cmbFilterTemplateEval)
                objFilterTemplateID = dtObjFilterTemplate.AsEnumerable().Where(Function(x) x.Field(Of String)("TemplateName") = FilterTemplateName)(0)("ObjectFilterTemplateID")
                SetComboBox(cmbFilterTemplateEval, ComboSelectBased.ValueBased, objFilterTemplateID)

                'delete existing filters in the template
                Object_Filter_Delete(objFilterTemplateID)
                For Each drFilter As DataRow In dtFilters.Rows
                    Object_Filter_Add(objFilterTemplateID, drFilter("FieldName").ToString, drFilter("FieldOperator").ToString, drFilter("FieldValue").ToString)
                Next

                cmbFilterTemplate_SelectedIndexChanged(cmbFilterTemplateEval, Nothing)
            Else
                objFilterTemplateID = CType(cmbFilterTemplateEval.SelectedItem, clsComboBoxItem).Value
                'delete existing filters in the template
                Object_Filter_Delete(objFilterTemplateID)

                For iCntr = 0 To gvParamFiltersEval.RowCount - 1
                    Object_Filter_Add(objFilterTemplateID, gvParamFiltersEval.GetRowCellValue(iCntr, "FieldName"), gvParamFiltersEval.GetRowCellValue(iCntr, "FieldOperator"), gvParamFiltersEval.GetRowCellValue(iCntr, "FieldValue"))
                Next
                cmbFilterTemplate_SelectedIndexChanged(cmbFilterTemplateEval, Nothing)
            End If
            ChangeSaveTemplateButtonBackColor(gvParamFiltersEval.Name, Nothing)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

