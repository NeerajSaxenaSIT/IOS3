    Public Sub BindKPITreeViewTopX(strNetwork As String)
        Dim tValue As Object = Nothing
        Try
            If Not _dsKPITreeTopX Is Nothing Then
                tvKPITopX.Cursor = Cursors.WaitCursor
                tValue = tvKPITopX.FocusedValue
                tvKPITopX.BeginUnboundLoad()
                Application.DoEvents()
                tvKPITopX.PupulateTreeListColumn({"ObjectID", "ParentID", "ObjectName", "ObjectType", "ChartSetName", "ImageIndex"})
                tvKPITopX.Nodes.Clear()
                Dim tlNode As TreeListNode = tvKPITopX.Nodes.Add(New Object() {"TopX_" & strNetwork, "0", "TopX_" & strNetwork, "EMPTY", cmbChartSetNameTopX.SelectedItem.ToString, 0})
                tvKPITopX.PopulateTreeList("0", tlNode, _dsKPITreeTopX, "0")
                tvKPITopX.CheckAll()
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        Finally
            tvKPITopX.EndUnboundLoad()
            If tvKPITopX.Nodes.Count > 0 Then
                If tValue IsNot Nothing Then
                    Dim tNode() As TreeListNode = tvKPITopX.FindNodes(Function(node) node.GetDisplayText("ObjectName").ToLower = tValue.ToString.ToLower())
                    If tNode.Length > 0 Then tvKPITopX.ExpandTreeListUntilCertainNode(tNode(0))
                Else
                    tvKPITopX.SelectNode(tvKPITopX.Nodes(0))
                    tvKPITopX.SetFocusedNode(tvKPITopX.Nodes(0))
                    tvKPITopX.CollapseAll()
                    tvKPITopX.ExpandToLevel(0)
                End If
            End If
            tvKPITopX.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Public Sub FindNodeTreeviewTopX(nd As String, Optional follow As Boolean = True)
        Try
            Dim tn() As TreeListNode = tvObjectsTreeTopX.GetNodeList().Where(Function(x) x.Item("ObjectName") = nd).ToArray()
            Dim i As Integer = 0
            For i = 0 To tn.Length - 1
                tn(i).Checked = True
                If follow = True Then
                    tvObjectsTreeStats.SelectNode(tn(i))
                    tvObjectsTreeTopX.FocusedNode = tn(i)
                End If
            Next i
        Catch
            'do nothing
        End Try
    End Sub

