    Public Function MergeData2_Old(SourceTables As List(Of DataTable), joinfield As String) As DataTable
        'Determine the number of rows the final table will have'
        Try
            Dim nMaxRowNew = 0
            Dim nMaxRowCount = 0
            Dim TargetTable As DataTable = SourceTables(0)

            For Each dt As DataTable In SourceTables
                If dt.Rows.Count > nMaxRowCount Then
                    nMaxRowCount = dt.Rows.Count
                End If
                For Each dr As DataRow In dt.Rows
                    nMaxRowNew = nMaxRowNew + 1
                Next
            Next

            TargetTable = SourceTables(0)
            Dim i As Integer = 1

            For i = 1 To SourceTables.Count - 1
                TargetTable = MyJoinMethod(TargetTable, SourceTables(i), joinfield, joinfield)
            Next i

            If joinfield = "Date" Then
                Dim SortedTargetTable As DataTable = TargetTable.Clone
                For Each drow As DataRow In TargetTable.AsEnumerable().OrderBy(Function(x) x.Item("Date")).ToArray()
                    SortedTargetTable.ImportRow(drow)
                Next
                TargetTable.Dispose()
                TargetTable = Nothing
                Return SortedTargetTable
            Else
                Return TargetTable
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Return Nothing
        End Try
    End Function

    Public Function MergeData2(SourceTables As List(Of DataTable), joinfield As String) As DataTable
        Try
            If SourceTables Is Nothing OrElse SourceTables.Count = 0 Then Return Nothing
            If String.IsNullOrEmpty(joinfield) Then Return Nothing

            ' Start with the first table as base
            Dim targetTable As DataTable = SourceTables(0)

            ' Merge remaining tables using MyJoinMethod
            For i As Integer = 1 To SourceTables.Count - 1
                targetTable = MyJoinMethod(targetTable, SourceTables(i), joinfield, joinfield)
            Next

            ' If the join field is "Date", perform efficient sorting using DataView
            If joinfield.Equals("Date", StringComparison.OrdinalIgnoreCase) AndAlso targetTable.Columns.Contains("Date") Then
                Dim view As New DataView(targetTable)
                view.Sort = "Date ASC"
                Return view.ToTable()
            End If

            Return targetTable

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            Return Nothing
        End Try
    End Function

