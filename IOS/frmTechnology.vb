            tabcontrol.SelectedTabPage.AutoScrollPosition = New System.Drawing.Point(Math.Abs(ptscroll.X), Math.Abs(ptscroll.Y))
            ptscroll = Nothing
            Charts_ResizeWidth()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
