            Dim selected_charts As String = tvKPITopX.GetKPIChecked2String(2, "ObjectName") ''TreeViewKPI_Checked2String(tvKPITopX, 2, "ObjectName")
            Dim selected_kpis As String = tvKPITopX.GetKPIChecked2String(3, "ObjectName") ''TreeViewKPI_Checked2String(tvKPITopX, 3, "ObjectName")

            'get KPI sql
            conn_el = New Odbc.OdbcConnection(connStrIOSServer)
            conn_el.ConnectionTimeout = 5
            conn_el.Open()
            sqlelement = clsSQLCommands.GetChartKPISQL(tech, supportcode, selected_tabs, selected_charts, selected_kpis, chartname)
            comm_Element = New Odbc.OdbcCommand(sqlelement, conn_el)
            dr_element = comm_Element.ExecuteReader
            sql_kpi = ""

            While dr_element.Read

                Dim kpisql As String = dr_element.GetValue(0).trim + " "

                Dim KpiNamefromQuery As String = dr_element.GetValue(1).trim
                kpisql = kpisql.Replace(" " + KpiNamefromQuery + " ", " [" + KpiNamefromQuery + "]")

                sql_kpi = sql_kpi + " " + kpisql.Trim + ", " + Chr(13)

            End While
            sql_kpi = sql_kpi.Trim
            sql_kpi = sql_kpi.TrimEnd(",")

            conn_el.Close()
            comm_Element.Dispose()
            comm_Element = Nothing
            dr_element.Close()
            dr_element = Nothing
            conn_el.Dispose()
            conn_el = Nothing

            If tvObjTreeFilterTempTopX.Nodes.Count > 0 Then
                sql_where_paramfilter = GetParamFilterStringTemplate(tech, "topx")
            End If

            If (tagExcID IsNot Nothing) AndAlso (sql_tags_exc IsNot Nothing) Then
                sql_from_time = sql_from_time + vbCrLf + sql_tags_exc
                sql_where_period = sql_where_period + " " + sql_tags_exc_where
            End If

            sql_total = sql_select + sql_kpi + " " + sql_from_time + sql_where_misc + sql_where_object + sql_where_tables + sql_where_period + sql_where_paramfilter + sql_groupby + sql_orderby
            sql_total = Replace(sql_total, "@CMFilter", CMFilter)
            sql_total = Replace(sql_total, "@RegionFilter", RegionFilter)
            If tagid IsNot Nothing Then
                sql_total = Replace(sql_total, "= @TagID", tagid.Replace("TagID", ""))
                sql_total = Replace(sql_total, "@TagID", tagid.Replace("TagID", ""))
            End If
            sql_total = Replace(sql_total, "@RegionFilter", RegionFilter)

            If chkEnableComparisonTopX.Checked = True Then
                Dim delta1date_string As String = Chr(39) & DeltaDate1.ToString("yyyy-MM-dd HH:mm") & Chr(39)
                Dim delta2date_string As String = Chr(39) & DeltaDate2.ToString("yyyy-MM-dd HH:mm") & Chr(39)
                sql_total = Replace(Replace(sql_total, "@starttime", delta1date_string), "@endtime", delta2date_string) + ";" + Replace(Replace(sql_total, "@starttime", startdate_string), "@endtime", enddate_string)
            End If

            Return sql_total
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)

            If Not dr_sql Is Nothing Then
                dr_sql.Close()
                dr_sql = Nothing
            End If
            If Not comm_sql Is Nothing Then
                comm_sql.Dispose()
                comm_sql = Nothing
            End If
            If Not dr_element Is Nothing Then
                dr_element.Close()
                dr_element = Nothing
            End If
            If Not comm_Element Is Nothing Then
                comm_Element.Dispose()
                comm_Element = Nothing
            End If
            If Not conn_el Is Nothing Then
                conn_el.Close()
                conn_el.Dispose()
                conn_el = Nothing
            End If

            Return Nothing
        End Try
    End Function

    Private Sub Process_TopX_ThreadEnd(ds As System.Data.DataSet, ti As Threading.Thread)
        Try
            Dim threadcorrect As Boolean = False
            If t_TopX_lastid = ti.ManagedThreadId Then
                threadcorrect = True
            End If
            If threadcorrect = False Then
                ds.Dispose()
                ds = Nothing
                Exit Sub
            End If
            dsTopX = New System.Data.DataSet
            dsTopX = ds
            If Not ds Is Nothing Then
                ds.Dispose()
                ds = Nothing
            End If
            Me.BeginInvoke(Me.Call_ProcessTopXInvoked)
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

    Private Sub Process_TopX_Invoked()
        Try
            If Not dsTopX Is Nothing Then
                If dsTopX.Tables.Count > 0 Then

                    If chkEnableComparisonTopX.Checked = False Then
                        AssignDataToTopX(dsTopX.Tables(0), "TopX_" & _strNetwork)
                        'IOSDevExpressGrid.PopulateDataInGrid(DataGrid_TopX, gvDataGridTopX, dsTopX.Tables(0), "ALL")
                        LoadGridWithHyperlink(DataGrid_TopX, gvDataGridTopX, dsTopX.Tables(0), "TicketURL")
                    Else
                        ' calculate delta
                        DeltaCalculation(dsTopX)
                        ' assign delta to charts
                        AssignDataToTopX_Delta(dsTopX, "TopX_" & _strNetwork)
                        'IOSDevExpressGrid.PopulateDataInGrid(DataGrid_TopX, gvDataGridTopX, dsTopX.Tables(2), "ALL")
                        LoadGridWithHyperlink(DataGrid_TopX, gvDataGridTopX, dsTopX.Tables(2), "TicketURL")
                    End If

                    lblObjectTreeStatusTopX.Text = "Query Success: " & DateDiff(DateInterval.Second, timerTopX, Now()) & "s"
                    lblObjectTreeStatusTopX.ForeColor = Color.Black
                    mm.ReleaseMemory()
                End If
            Else
                lblObjectTreeStatusTopX.Text = "No Data Retrieved ..."
                lblObjectTreeStatusTopX.ForeColor = Color.Red
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            Me.AccCtrlTopX.Enabled = True
            Me.btnApplyTopX.Text = "Apply"
            ucProgPnlTopX.StopProgress()
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "TopX " & Network & "," & " Target Type: " & cmbObjectTreeTopX.Text & "," & " Objects: " & UserTrackingTopXObjects & " " & DateDiff(DateInterval.Second, timerTopX, Now()) & "s")
        End Try
    End Sub

    Private Sub HideChartScaleIfNoDataTopX(ByRef ch As Chart, ByRef dtData As DataTable)
        '-------Hide Date if there is no data in dtChild-------
        ch.XAxis.ScaleBreakStyle = ScaleBreakStyle.None
        ch.XAxis.ScaleBreaks.Clear()
        Dim sDate As DateTime = deStartTimeTopX.EditValue
        Dim eDate As DateTime = deEndTimeTopX.EditValue
        Dim dtAxis As DataTable = dtData.DefaultView.ToTable(True, dtData.Columns(0).ColumnName)
        While sDate <= eDate
            Dim sDateCol As String = dtData.Columns(0).ColumnName
            Dim dr() As DataRow = dtAxis.AsEnumerable().Where(Function(x) x.Field(Of String)(sDateCol) = sDate).ToArray()
            If dr.Length = 0 Then
                ch.XAxis.Scale = dotnetCHARTING.WinForms.Scale.Normal
                ch.XAxis.ScaleBreaks.Add(New dotnetCHARTING.WinForms.ScaleRange(sDate, sDate))
            End If
            If xtcPSFilterTopX.SelectedTabPage.Text = "Hours" Then
                sDate = sDate.AddHours(1)
            Else
                sDate = sDate.AddDays(1)
            End If
        End While
        '------------------------------------------------
    End Sub

    Private Sub AssignDataToTopX(ByRef dt As DataTable, tech As String, Optional chartname_original As String = Nothing, Optional ChartElementSortOrder() As String = Nothing)
