    Private Sub tglTopX_Click(sender As Object, e As EventArgs) Handles tglTopX0.Click, tglTopX1.Click, tglTopX2.Click, tglTopX3.Click, tglTopX4.Click, tglTopX5.Click, tglTopX6.Click, tglTopX7.Click, tglTopX8.Click, tglTopX9.Click, tglTopX10.Click,
                                                                        tglTopX11.Click, tglTopX12.Click, tglTopX13.Click, tglTopX14.Click, tglTopX15.Click, tglTopX16.Click, tglTopX17.Click, tglTopX18.Click, tglTopX19.Click, tglTopX20.Click,
                                                                        tglTopX21.Click, tglTopX22.Click, tglTopX23.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Try
            Dim btnToggle As IOS.Library.IOSToggleButton = CType(sender, IOS.Library.IOSToggleButton)
            btnToggle.ChangeToggleState()
