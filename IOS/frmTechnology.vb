    Public Function GetParamFilterStringTemplate(tech As String, procType As String) As String
        Try
            Dim tl As TreeList = Nothing
            Dim cmb As ComboBoxEdit = Nothing
            Dim filterString As String = " And "

            If procType.ToUpper = "STATS" Then
                tl = tvObjTreeFilterTempStats
                cmb = cmbFilterTemplateStats
            ElseIf procType.ToUpper = "TOPX" Then
                tl = tvObjTreeFilterTempTopX
                cmb = cmbFilterTemplateTopX
            ElseIf procType.ToUpper = "EVAL" Then
                tl = tvObjTreeFilterTempEval
                cmb = cmbFilterTemplateEval
            End If

            If cmb.SelectedIndex <> 0 Then
                If Not tl Is Nothing AndAlso tl.GetEndCheckedNodes().Count > 0 Then
                    Dim tn() As TreeListNode = tl.FindNodes(Function(x) x.Level = 1 AndAlso x.Checked = True)
                    For Each nd As TreeListNode In tn
                        Dim singleParamString As String = ""
                        singleParamString = tl.GetChecked2StringFilterParam(nd.GetDisplayText("ObjectName"), "FilterTemplate", strTreeFilter) & " And "
                        filterString = filterString & " " & singleParamString
                    Next
                End If
            End If

            tl = Nothing
            cmb = Nothing
            filterString = filterString.Substring(0, filterString.Length - 4)
            Return filterString

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        Return Nothing
    End Function

    Private Function GetParamFilterString(procType As String) As String
        Try
            Dim gv As GridView = Nothing
            Dim cmb As ComboBoxEdit = Nothing
            Dim filterString As String = " And "

            If procType.ToUpper = "STATS" Then
                gv = gvParamFiltersStats
                cmb = cmbFilterTemplateStats
            ElseIf procType.ToUpper = "TOPX" Then
                gv = gvParamFiltersTopX
                cmb = cmbFilterTemplateTopX
            ElseIf procType.ToUpper = "EVAL" Then
                gv = gvParamFiltersEval
                cmb = cmbFilterTemplateEval
            End If

            If cmb.SelectedIndex <> 0 Then
                If Not gv Is Nothing Then
                    For iCntr = 0 To gv.RowCount - 1
                        Dim singleParamString As String = ""
                        If (gv.GetRowCellValue(iCntr, "FieldOperator").ToString = "IN") Or (gv.GetRowCellValue(iCntr, "FieldOperator").ToString = "NOT IN") Then
                            Dim modifiedFldValue As String = ""
                            Dim allValues() As String = gv.GetRowCellValue(iCntr, "FieldValue").ToString.Split(",")
                            For Each str As String In allValues
                                modifiedFldValue = modifiedFldValue & "'" & str.Trim & "',"
                            Next
                            modifiedFldValue = modifiedFldValue.TrimEnd(",")
                            singleParamString = gv.GetRowCellValue(iCntr, "FieldName").ToString & " " & gv.GetRowCellValue(iCntr, "FieldOperator").ToString & " (" & modifiedFldValue & ") And "
                            filterString = filterString & " " & singleParamString
                        ElseIf (gv.GetRowCellValue(iCntr, "FieldOperator").ToString.ToUpper = "LIKE") Or (gv.GetRowCellValue(iCntr, "FieldOperator").ToString.ToUpper = "NOT LIKE") Then
                            singleParamString = gv.GetRowCellValue(iCntr, "FieldName").ToString & " " & gv.GetRowCellValue(iCntr, "FieldOperator").ToString & " " & "'%" & gv.GetRowCellValue(iCntr, "FieldValue").ToString & "%'" & " And "
                            filterString = filterString & " " & singleParamString
                        Else
                            singleParamString = gv.GetRowCellValue(iCntr, "FieldName").ToString & " " & gv.GetRowCellValue(iCntr, "FieldOperator").ToString & " " & "'" & gv.GetRowCellValue(iCntr, "FieldValue").ToString & "'" & " And "
                            filterString = filterString & " " & singleParamString
                        End If
                    Next
                End If
            End If

            gv = Nothing
            cmb = Nothing
            filterString = filterString.Substring(0, filterString.Length - 4)
            Return filterString

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
        Return Nothing
    End Function

    Private Sub tsmi_PasteParamValues_Click(sender As Object, e As EventArgs) Handles tsmi_PasteParamValues.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Try
            Dim gc As GridControl = TryCast(cmFilterParamGrid.SourceControl, GridControl)
            Dim gv As GridView = TryCast(gc.MainView, GridView)

            'gc.Cursor = Cursors.WaitCursor
            'Application.DoEvents()

            gv.ShowEditor()
            Dim cmb As CheckedComboBoxEdit = TryCast(gv.ActiveEditor, CheckedComboBoxEdit)

            If cmb Is Nothing Then
                Exit Sub
            End If

            Dim str As String = Clipboard.GetText()
            Dim copiedVals As String = str.Replace(vbCrLf, ",")

            'add preselected values to the copied ones
            If cmb.EditValue <> "" Then
                copiedVals = cmb.EditValue & "," & copiedVals
            End If

            'checking if the copied item exist in the combo items list
            Dim temp() As String = copiedVals.Split(",")
            For Each val As String In temp
                If (Not cmb.Properties.Items.Contains(val)) AndAlso (val <> "") Then
                    copiedVals = copiedVals.Replace(val, "")
                End If
            Next

            copiedVals = copiedVals.TrimStart(",")
            copiedVals = copiedVals.Replace(",,", ",")
            copiedVals = copiedVals.TrimEnd(",")

            cmb.SetEditValue(copiedVals)
            cmb.RefreshEditValue()

            gv.CloseEditor()

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        Finally
            'gc.Cursor = Cursors.Default
            'Application.DoEvents()
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "Completed")
    End Sub

    Private Sub TreeListObjectFilter_ColumnFilterChanged(sender As Object, e As EventArgs) Handles tvObjTreeFilterTempStats.ColumnFilterChanged, tvObjTreeFilterTempTopX.ColumnFilterChanged, tvObjTreeFilterTempEval.ColumnFilterChanged
        Try
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            Dim tl As TreeList = TryCast(sender, TreeList)
            tl.SuspendLayout()

            strTreeFilter = tl.FindFilterText
            If String.IsNullOrWhiteSpace(tl.FindFilterText) Then
                tl.CollapseAll()
                tl.ExpandToLevel(0)
            Else
                Dim tNode() As TreeListNode = Nothing
                tNode = tl.FindNodes(Function(node) node.GetDisplayText("ObjectName").ToLower() = tl.FindFilterText.ToLower)
                If tNode IsNot Nothing AndAlso tNode.Length > 0 Then
                    tl.FocusedNode = tNode(0)
                End If
            End If
            tl.ResumeLayout()
        Catch ex As Exception
        Finally
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

#Region "Object Tree Context Menu"

    Private Sub cmObjectTree_Opening(sender As Object, e As System.ComponentModel.CancelEventArgs) Handles cmObjectTree.Opening
        cm_OT_SourceControl = cmObjectTree.SourceControl
        Dim tv As TreeList = CType(cmObjectTree.SourceControl, TreeList)
        Dim tech As String = tv.Tag

        Dim aggr_to As String = Nothing
        Dim countchecked As Integer = 0

        If tech.ToLower.Contains("topx") Then
            aggr_to = cmbObjectTreeTopX.SelectedItem.ToString
        Else
            aggr_to = cmbObjectTreeStats.SelectedItem.ToString
        End If

        Dim ExactMatch As Boolean = True
        If aggr_to = "WBTS" Or aggr_to = "BCF" Then
            ExactMatch = False
        Else
            ExactMatch = True
        End If

        'count checked boxes
        countchecked = tv.GetEndCheckedNodes().Count
        ''tsmi_OT_Exception.Visible = False

        'enable/disable copy
        If countchecked > 0 Then
            cm_OT_tsmi_copy.Text = "Copy - Objects: " & countchecked
            cm_OT_tsmi_copy.Enabled = True
        Else
            cm_OT_tsmi_copy.Text = "Copy"
            cm_OT_tsmi_copy.Enabled = False
        End If

        Dim dtTest As DataTable = Nothing
        If tv.Name.Contains("Stats") Then
            For Each dt As DataTable In TreeVendorStats.Tables
                If dt.TableName.EndsWith("_" & cmbObjectTreeStats.SelectedItem.ToString) Then
                    dtTest = dt
                End If
            Next
        ElseIf tv.Name.Contains("TopX") Then
            For Each dt As DataTable In TreeVendorTopX.Tables
                If dt.TableName.EndsWith("_" & cmbObjectTreeTopX.SelectedItem.ToString) Then
                    dtTest = dt
                End If
            Next
        End If

        dtCopyPasteObjects = New DataTable
        dtCopyPasteObjectsAny = New DataTable

        Dim dtObjectType As DataTable = Nothing
        If dtTest IsNot Nothing Then
            Dim indexOfSplitChar As Integer = dtTest.TableName.ToString.IndexOf("_")
            Dim objectType As String = dtTest.TableName.ToString.Substring(indexOfSplitChar + 1)
            If dtTest.Select("ObjectType='" & objectType & "'").Length <> 0 Then
                dtObjectType = dtTest.Select("ObjectType='" & objectType & "'").CopyToDataTable
            End If

            dtCopyPasteObjects.Columns.Add("ObjectID", GetType(String))
            dtCopyPasteObjectsAny.Columns.Add("ParentID", GetType(String))

            'check clipboard
            Dim s As String = Clipboard.GetText()                   'Get clipboard data as a string
            Dim rows() As String = s.Split(ControlChars.NewLine)    'Split into rows

            If Not dtObjectType Is Nothing Then
                Dim lstAllObjects = From row In dtObjectType.AsEnumerable()
                                    Let autoComplete = row.Field(Of String)("ObjectName")
                                    Select autoComplete
                Dim arrAllObjects As String() = lstAllObjects.ToArray()

                Dim clipboardObjects() As String = String.Join(ControlChars.Lf, rows).Replace(ControlChars.Lf, ",").Replace(",,", ",").Split(",")
                Dim matchedObjects As List(Of String) = arrAllObjects.Intersect(clipboardObjects, StringComparer.InvariantCultureIgnoreCase).ToList()

                Dim clipboardmatches As Integer = matchedObjects.Count

                For Each obj As String In matchedObjects
                    Dim dr As DataRow() = dtObjectType.Select("ObjectName='" & obj.Trim & "' And ObjectType='" & objectType & "'")
                    If dr IsNot Nothing Then
                        For Each dr2 As DataRow In dr
                            Dim drCopyObjects As DataRow = dtCopyPasteObjects.NewRow()
                            drCopyObjects("ObjectID") = dr2("ObjectID").ToString
                            dtCopyPasteObjects.Rows.Add(drCopyObjects)
                        Next
                    End If
                Next

                'checking if any site is copied
                Dim lstAllObjectsAny = From row In dtTest.AsEnumerable()
                                       Let autoComplete = row.Field(Of String)("ParentID")
                                       Select autoComplete
                Dim arrAllObjectsAny As String() = lstAllObjectsAny.ToArray()

                Dim clipboardObjectsAny() As String = String.Join(ControlChars.Lf, rows).Replace(ControlChars.Lf, ",").Replace(",,", ",").Split(",")
                Dim matchedObjectsAny As List(Of String) = arrAllObjectsAny.Intersect(clipboardObjects, StringComparer.InvariantCultureIgnoreCase).ToList()

                Dim clipboardmatchesAny As Integer = matchedObjectsAny.Count

                'Dim dtDistPID As DataTable = dtObjectType.DistinctCol("ParentID")

                For Each obj As String In matchedObjectsAny
                    Dim dr As DataRow() = dtTest.Select("ParentID='" & obj.Trim & "'")
                    If dr IsNot Nothing Then
                        For Each dr2 As DataRow In dr
                            If dtCopyPasteObjectsAny.Select("ParentID='" & dr2("ParentID").ToString & "'").Length = 0 Then
                                Dim drCopyObjectsAny As DataRow = dtCopyPasteObjectsAny.NewRow()
                                drCopyObjectsAny("ParentID") = dr2("ParentID").ToString
                                dtCopyPasteObjectsAny.Rows.Add(drCopyObjectsAny)
                            End If
                        Next
                    End If
                Next

                'enable/disable paste
                If clipboardmatches > 0 Then
                    cm_OT_tsmi_paste.Text = "Paste Target Type - Objects: " & dtCopyPasteObjects.Rows.Count.ToString
                    cm_OT_tsmi_paste.Enabled = True
                Else
                    cm_OT_tsmi_paste.Text = "Paste"
                    cm_OT_tsmi_paste.Enabled = False
                End If

                If clipboardmatchesAny > 0 Then
                    cm_OT_tsmi_pasteAny.Text = "Paste Any - Objects: " & dtCopyPasteObjectsAny.Rows.Count.ToString
                    cm_OT_tsmi_pasteAny.Enabled = True
                Else
                    cm_OT_tsmi_pasteAny.Text = "Paste"
                    cm_OT_tsmi_pasteAny.Enabled = False
                End If

                lstAllObjects = Nothing
                clipboardObjects = Nothing
                matchedObjects = Nothing

            End If
        End If

        'get all tags
        Dim sql As String = Nothing
        Dim connstring As String = Nothing
        cm_OT_tsmi_CopyToTag.Enabled = False
        Try
            Dim dt As DataTable = clsSQLCommands.GetIOSTags(connStrIOSServer, tv.Tag, System.Environment.UserName, aggr_to)

            cm_OT_tsmi_CopyToTag.DropDownItems.Clear()
            cm_OT_tsmi_CopyToTag.Enabled = True
            Dim tsmi_CreateTag As ToolStripMenuItem = New ToolStripMenuItem("Create Tag")
            AddHandler tsmi_CreateTag.Click, AddressOf CreateTagFromContextMenu
            cm_OT_tsmi_CopyToTag.DropDownItems.Add(tsmi_CreateTag)

            If Not dt Is Nothing Then
                If dt.Rows.Count > 0 Then
                    For Each dr As DataRow In dt.Rows
                        Dim tsmi_image As Image = Nothing
                        If dr("EnablePreAggregation").ToString.ToUpper = "TRUE" Then
                            tsmi_image = EmbeddedImage("square_green.bmp")
                        Else
                            tsmi_image = EmbeddedImage("square_red.bmp")
                        End If
                        Dim tsmi_CopyToTag As ToolStripMenuItem = New ToolStripMenuItem(dr("TagName").ToString, tsmi_image)
                        tsmi_CopyToTag.Tag = dr("TagID").ToString
                        AddHandler tsmi_CopyToTag.Click, AddressOf OT_CopyToTag
                        cm_Topx_MapSel.DropDownItems.Add(tsmi_CopyToTag)
                        cm_OT_tsmi_CopyToTag.DropDownItems.Add(tsmi_CopyToTag)
                    Next
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        Finally
        End Try

        'get drilldown options
        Try
            Dim dt As DataTable = clsSQLCommands.GetObjectConfigurationByObject(connStrIOSServer, aggr_to)

            If Not dt Is Nothing Then
                tsmi_OT_DrillDown.DropDownItems.Clear()
                If dt.Rows.Count = 0 Then
                ElseIf dt.Rows.Count = 1 Then
                Else
                    For Each dr As DataRow In dt.Rows
                        Dim tsmi_OT_DrillDown_DropDown As ToolStripMenuItem = New ToolStripMenuItem(dr("Object").ToString)
                        tsmi_OT_DrillDown_DropDown.Tag = dr("Object").ToString
                        AddHandler tsmi_OT_DrillDown_DropDown.Click, AddressOf OT_DrillDown_DropDown
                        tsmi_OT_DrillDown.DropDownItems.Add(tsmi_OT_DrillDown_DropDown)
                    Next
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try

        'disable copy to tag, drill up & drill down tsmi for targettype = TAGS and enable for the rest of targettypes
        If (aggr_to.ToUpper = "TAGS") Then
            cm_OT_tsmi_CopyToTag.Enabled = False
            tsmi_OT_DrillUp.Enabled = False
            tsmi_OT_DrillDown.Enabled = False
        Else
            cm_OT_tsmi_CopyToTag.Enabled = True
            tsmi_OT_DrillUp.Enabled = True
            tsmi_OT_DrillDown.Enabled = True
        End If

        dtTest = Nothing

        'exception list
        ''If tv.Name = "TreeView_Tuning_Objects" And countchecked > 0 Then
        ''    tsmi_OT_Exception.Visible = True
        ''End If
    End Sub

    Public Sub CreateTagFromContextMenu(sender As Object, e As System.EventArgs)
        Try
            Dim tv As TreeList = cm_OT_SourceControl
            Dim aggr_to As String = Nothing
            Dim tech As String = tv.Tag
            If tv.Name.ToString().ToLower.Contains("topx") Then
                aggr_to = cmbObjectTreeTopX.SelectedItem.ToString()
            Else
                aggr_to = cmbObjectTreeStats.SelectedItem.ToString()
            End If

            Dim tagInsertDialog As New dlgTagInsert()
            tagInsertDialog.ShowDialog()
            If (tagInsertDialog.IsValid) Then

                'check if the tag name already exits, else insert the new tag
                Dim TagID As Integer = clsSQLCommands.InsertTag(connStrIOSServer, tagInsertDialog.TagName, Network, "Static List", tagInsertDialog.TagDescription, aggr_to, tagInsertDialog.TagIsPrivate)

                If TagID <> 0 Then
                    Dim str_ObjectNames() As String = tv.GetChecked2String(tech, aggr_to, "Naked").Split(", ")
                    Dim str_ObjectIDs() As String = tv.GetChecked2String(tech, aggr_to, "ObjectID").Substring(4).Replace("','", "~").TrimEnd(")").Split({"~"}, System.StringSplitOptions.RemoveEmptyEntries)

                    'insert selected objects with the new tag
                    For iCntr As Integer = 0 To str_ObjectIDs.Length - 1
                        clsSQLCommands.InsertTagsDetailsList(connStrIOSServer, TagID, Replace(str_ObjectIDs(iCntr), "'", ""), Replace(str_ObjectNames(iCntr), "'", ""))
                    Next

                    frmTagManager.BindTagsGrid()
                Else
                    MsgBox("Tag Not Inserted " & vbCrLf & "TagName " & tagInsertDialog.TagName & " already exists In " & Network & "!", MsgBoxStyle.Exclamation)
                End If

            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

    Private Sub OT_DrillDown_DropDown(sender As System.Object, e As System.EventArgs)
        Try
            Dim tsmi As ToolStripMenuItem = CType(sender, ToolStripMenuItem)
            Dim tv As TreeList = cm_OT_SourceControl
            Dim tech As String = tv.Tag
            Dim aggr_to As String = Nothing
            Dim tnlist As New List(Of TreeListNode)
            Dim cmb As ComboBoxEdit

            If tech.ToLower.Contains("topx") Then
                cmb = cmbObjectTreeTopX
            Else
                cmb = cmbObjectTreeStats
            End If

            Try
                tnlist = tv.GetAllCheckedNodes()
            Catch
            End Try

            Try
                Dim nodeList(tnlist.Count - 1) As String
                For i As Integer = 0 To tnlist.Count - 1
                    nodeList(i) = tnlist(i).Item("ObjectName")
                Next

                Dim currentlevel As Integer = GetNodeLevelByObjectType(tech, cmb.Text)
                Dim targetlevel As Integer = Math.Min(3, currentlevel + 1)
                For i As Integer = cmb.SelectedIndex To cmb.Properties.Items.Count - 1 Step 1
                    If cmb.Properties.Items(i).ToString = tsmi.Text Then
                        cmb.SelectedIndex = i
                        Exit For
                    End If
                Next

                If currentlevel = 0 Then
                    tv.Nodes(0).Checked = True
                    Exit Sub
                End If

                For i As Integer = 0 To nodeList.Length - 1
                    Dim index As Integer = i
                    Dim ndfound() As TreeListNode = tv.GetNodeList().Where(Function(x) x.Item("ObjectName") = nodeList(index)).ToArray()
                    If ndfound.Length > 0 Then
                        For Each node As TreeListNode In ndfound
                            If node.Level = currentlevel And node.Checked = False Then
                                node.Checked = True
                                node.Selected = True
                                tv.FocusedNode = node
                                If node.ParentNode IsNot Nothing Then
                                    node.ParentNode.Expand()
                                End If
                                node.Expand()
                            End If
                        Next

                    End If
                Next
            Catch
            End Try
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

    Private Sub tsmi_OT_DrillDown_Click(sender As Object, e As EventArgs) Handles tsmi_OT_DrillDown.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        'collect selection of currentlevel - 1
        cm_OT_SourceControl = cmObjectTree.SourceControl
        Dim tv As TreeList = CType(cmObjectTree.SourceControl, TreeList)
        If (tv IsNot Nothing) Then
            Dim tech As String = tv.Tag
            Dim aggr_to As String = Nothing
            Dim tnlist As New List(Of TreeListNode)
            Dim cmb As ComboBoxEdit = Nothing
            Try
                tnlist = tv.GetAllCheckedNodes()
                If tv.Name.ToLower.Contains("stats") Then
                    cmb = cmbObjectTreeStats
                ElseIf tv.Name.ToLower.Contains("topx") Then
                    cmb = cmbObjectTreeTopX
                End If
            Catch
            End Try
            Try
                Dim nodeList(tnlist.Count - 1) As String
                For i As Integer = 0 To tnlist.Count - 1
                    nodeList(i) = tnlist(i).Item("ObjectName")
                Next

                Dim currentlevel As Integer = GetNodeLevelByObjectType(tech, cmb.Text)
                Dim targetlevel As Integer = Math.Min(3, currentlevel + 1)

                For i As Integer = cmb.SelectedIndex To cmb.Properties.Items.Count - 1 Step 1
                    If GetNodeLevelByObjectType(tech, cmb.Properties.Items(i).ToString) = targetlevel Then
                        cmb.SelectedIndex = i
                        Exit For
                    End If
                Next

                If currentlevel = 0 Then
                    tv.Nodes(0).Checked = True
                    Exit Sub
                End If

                For i As Integer = 0 To nodeList.Length - 1
                    Dim index As Integer = i
                    Dim ndfound() As TreeListNode = tv.GetNodeList().Where(Function(x) x.Item("ObjectName") = nodeList(index) And x.Checked = False).ToArray()
                    If ndfound.Length > 0 Then
                        For Each node As TreeListNode In ndfound
                            If node.Checked = False And node.Level = currentlevel Then
                                node.Checked = True
                                node.Selected = True
                                tv.FocusedNode = node
                                If node.ParentNode IsNot Nothing Then
                                    node.ParentNode.Expand()
                                End If
                                node.Expand()
                            End If
                        Next

                    End If
                Next
            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
            End Try
        End If
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
    End Sub

