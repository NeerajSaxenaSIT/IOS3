        Dim ds_chart As DataSet = DataAccessorODBC.GetDataSet(connStrIOSServer, sqlchart)
        Dim dt_chart As DataTable = ds_chart.Tables(0)

        'Assign data to all charts
        '*************************
        Dim ch As Chart
