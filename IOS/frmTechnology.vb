                    If @MinValuePx is null 
                    set @MinValuePx = (select min([" + kpiname + "])  [" + kpiname + "]  from #PMcum )

                    declare @maxValuePx as Float = (select min([" + kpiname + "])  [" + kpiname + "] from #PMcum where cdfbin >= " + OFP.ToString + "   )
                    If @maxValuePx is null 
                    set @maxValuePx = (select max([" + kpiname + "])  [" + kpiname + "]  from #PMcum )

                    select t.*,  ( 1 +ISNULL(floor(([" + kpiname + "] - min_value) * (" + NumberOfBins + "-1)  / NULLIF(max_value - min_value,0 )),0)) as BucketNumber,  (max_value - min_value )/" + NumberOfBins + ".0 BucketSize, min_value as BucketStartValue
                    into #PMCDF
                    from (select t.*, @MinValuePx  as min_value,  @MaxValuePx as max_value from #PM t
                    ) t					 

                    select  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,BucketSize,BucketStartValue + (case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ) * BucketSize BucketValue 
                    into #PMBuckets
                    from #PMCDF k where  BucketNumber >=0 and bucketnumber <=" + NumberOfBins + "  
                    group by case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end   ,BucketSize , BucketStartValue 


                    select k.BucketNumber,round(k.BucketValue,3) BucketValue, SampleCount,round(100.00 * sum(SampleCount) over (" + IIf(datestringToAddToTargetType <> "", "PARTITION BY [Date] ", "") + " order by k.BucketNumber) / (sum(SampleCount)  over (" + IIf(datestringToAddToTargetType <> "", "PARTITION BY [Date] ", "") + ")),2)  SamplePercentage ," + Chr(39) + Replace(targettype3, "k.", "") + "' " + IIf(datestringToAddToTargetType <> "", " + convert(varchar,[Date],112) + ' ' + replace(substring(convert(varchar,[Date],108),0,6),':','') ", "") + " " + Replace(targettype3, "k.", "") + "
                    from #PMBuckets k left outer join (
		                    select  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end as BucketNumber ,min([" + kpiname + "]) MinKPI,max([" + kpiname + "]) MaxKPI,count(*) SampleCount " + IIf(datestringToAddToTargetType <> "", ", [Date] ", "") + "
		                    from #PMCDF 
		                    group by  case when BucketNumber < 0 then 0 when bucketnumber > " + NumberOfBins + " then " + NumberOfBins + "  else BucketNumber end " + IIf(datestringToAddToTargetType <> "", ", [Date] ", "") + "
                    ) z on k.BucketNumber=z.BucketNumber 
                    where samplecount is not null
                    order by 1
                    "
                End If

            End If

            If cm_Chart_ObjectCompareOrMapKPI = "tsmi_EvalHistogramOfCells" Then
                'TODO
            End If

            Return sql_total
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)

            If Not dr_sql Is Nothing Then
                dr_sql.Close()
                dr_sql = Nothing
            End If
            If Not comm_sql Is Nothing Then
                comm_sql.Dispose()
                comm_sql = Nothing
            End If
            If Not dr_element Is Nothing Then
                dr_element.Close()
                dr_element = Nothing
            End If
            If Not comm_Element Is Nothing Then
                comm_Element.Dispose()
                comm_Element = Nothing
            End If
            If Not conn_el Is Nothing Then
                conn_el.Close()
                conn_el.Dispose()
                conn_el = Nothing
            End If
            Return Nothing
        End Try
    End Function

    Private Sub Process_Stats_ObjectTime_Invoked()
        Application.DoEvents()
        Try
            For Each t As Threading.Thread In t_list
                If t.ThreadState = Threading.ThreadState.AbortRequested Then
                    Exit Sub
                End If
            Next t
        Catch ex As Exception
            lblObjTreeStatusStats.ForeColor = Color.Red
            lblObjTreeStatusStats.Text = "Threads Error..." & Threads_Fired
        End Try
        SyncLock lblObjTreeStatusStats
            Threads_Fired = 0
            If Not lblObjTreeStatusStats.Text.Contains("Abort") And Threads_Fired > -1 Then
                lblObjTreeStatusStats.Text = "Threads To Complete..." & Threads_Fired
            End If
        End SyncLock

        Try
            If Threads_Fired = 0 Then
                Threads_Fired = -99
                Application.DoEvents()
                If Not dsStats_ObjectTime Is Nothing Then

                    If cm_Chart_ObjectCompareOrMapKPI = "tsmi_Chart_MapKPI" Then
                        Dim dt As DataTable = dsStats_ObjectTime.Tables(0)
                        TechThematicID = dtMapKpiThemes.Select("ThematicName='" & tsmi_MapKPIThemes.SelectedItem.ToString & "'")(0)("ThematicID")
                        frmMapWindow.Cell_Top20_Map(_strNetwork, cm_Chart_kpiname, dt, TimeMapType, cm_Chart_kpiname, "KPI", False, False, True)
                        lblObjTreeStatusStats.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                        lblObjTreeStatusStats.ForeColor = Color.Black
                    ElseIf cm_Chart_ObjectCompareOrMapKPI = "tsmi_Chart_LaunchObj" Then
                        dtStats_ObjectTime = dsStats_ObjectTime.Tables(0)
                        IOSDevExpressGrid.PopulateDataInGrid(gcChartsStats, gvChartsStats, dtStats_ObjectTime, "ALL")
                        gcChartsStats.Refresh()
                        lblObjTreeStatusStats.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                        lblObjTreeStatusStats.ForeColor = Color.Black
                    ElseIf cm_Chart_ObjectCompareOrMapKPI = "tsmi_Chart_LaunchHistogram" Then
                        dtStats_ObjectTime = dsStats_ObjectTime.Tables(0)
                        AssignDataToHistogram(dtStats_ObjectTime, _strNetwork)
                        ' IOSDevExpressGrid.PopulateDataInGrid(gcChartsStats, gvChartsStats, dtStats_ObjectTime, "ALL")
                        gcChartsStats.Refresh()
                        lblObjTreeStatusStats.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                        lblObjTreeStatusStats.ForeColor = Color.Black
                        'ElseIf cm_Chart_ObjectCompareOrMapKPI = "tsmi_EvalHistogramOfCells" Then
                        '    dtEval_ObjectTime = dsEval_ObjectTime.Tables(0)
                        '    AssignDataToHistogram(dtEval_ObjectTime, _strNetwork)
                        '    lblObjTreeStatusEval.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                        '    lblObjTreeStatusEval.ForeColor = Color.Black
                    Else
                        If tsmi_ChartHideTitle.Checked = True Then
                            If Count_OT > 10 Then
                                tsmi_ChartHideTitle.Checked = False
                            Else
                                tsmi_ChartHideTitle.Checked = True
                            End If
                        End If

                        'crosstab to get left column time, columnnames as object and KPI as value
                        If cm_Chart_ObjectCompareOrMapKPI = "tsmi_ChartCompareElementsGroupBy" Then
                            dtStats_CompareGroupBy = CrossTab(dsStats_ObjectTime.Tables(0), "DATE", cm_Chart_GroupByName, cm_Chart_kpiname)

                            AssignDataToObjectTime_New(dtStats_CompareGroupBy, _strNetwork)
                            IOSDevExpressGrid.PopulateDataInGrid(gcChartsStats, gvChartsStats, dtStats_CompareGroupBy, "ALL")
                            gcChartsStats.Refresh()
                            lblObjTreeStatusStats.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                            lblObjTreeStatusStats.ForeColor = Color.Black
                        Else
                            dtStats_ObjectTime = CrossTab(dsStats_ObjectTime.Tables(0), "DATE", cmbObjectTreeStats.Text.ToUpper, cm_Chart_kpiname)

                            Dim dtclone As DataTable = New DataTable
                            dtclone = dtStats_ObjectTime.Copy
                            dtclone.TableName = cm_Chart_kpiname
                            If Not dsStats_ObjectTime_Stored Is Nothing Then
                                If dsStats_ObjectTime_Stored.Tables.Contains(cm_Chart_kpiname) Then
                                    dsStats_ObjectTime_Stored.Tables.Remove(cm_Chart_kpiname)
                                End If
                            Else
                                dsStats_ObjectTime_Stored = New DataSet
                            End If

                            dsStats_ObjectTime_Stored.Tables.Add(dtclone)

                            AssignDataToObjectTime_New(dtStats_ObjectTime, _strNetwork)
                            IOSDevExpressGrid.PopulateDataInGrid(gcChartsStats, gvChartsStats, dtStats_ObjectTime, "ALL")
                            gcChartsStats.Refresh()
                            lblObjTreeStatusStats.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                            lblObjTreeStatusStats.ForeColor = Color.Black

                        End If
                    End If
                Else
                    lblObjTreeStatusStats.Text = "No Data Retrieved !"
                    lblObjTreeStatusStats.ForeColor = Color.Red
                End If
                AccCtrlStats.Enabled = True
                Me.btnApplyStats.Text = "Apply"
                ucProgPnlStats.StopProgress()
            End If
        Catch ex As Exception
            lblObjTreeStatusStats.ForeColor = Color.Red
            lblObjTreeStatusStats.Text = "Error Merging Threads..." & Threads_Fired
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)

        End Try
    End Sub

    Private Sub AssignDataToObjectTime_New(ByRef dt As DataTable, tech As String)
        'Dim sqlchart As String
        Dim objectscharted As String = ""

        'getting ObjectTab
        Dim tabcontrol As DevExpress.XtraTab.XtraTabControl = GetTabControlFromTech(tech)
        Dim ObjectTab_Active As String = tabcontrol.SelectedTabPage.Text

        Dim ds_chart As DataSet = clsSQLCommands.GetChartConfigurationByElement(connStrIOSServer, tech, cm_Chart_kpiname, ObjectTab_Active, cm_Chart_Name)
        Dim dt_chart As DataTable = ds_chart.Tables(0)

        'Assign data to all charts
        '*************************
        Dim ch As Chart
        Dim i As Integer
        Dim Y1axislabel As String
        Dim Y2axislabel As String
        Dim Y1axisAbsorPerc, Y2axisAbsOrPerc As String
        Dim Y1axisPrecision, Y2axisPrecision As Integer
        Dim yaxis1 As Axis = Nothing
        Dim yaxis2 As Axis = Nothing
        Dim sp As New SmartPalette()
        Dim sc As New SeriesCollection
        Dim lastchart As String = ""

        Dim chart_elements() As String = {"0"}
        Dim chart_elementsYAxis() As String = {"0"}
        Dim chart_Eltype() As String = {"Bar"}
        Dim chart_ElColor() As Integer = {0}
        Dim chart_YaxisScale() As String = {"0", "0"}
        Dim j As Integer = 0
        Dim rownum As Integer = 0

        For rownum = 0 To 0
            Try
                'collecting elements from chart confguration
                Dim drow As DataRow = dt_chart.Rows(rownum)

                'configures individual chart when new chartline is detected
                If lastchart = "" Or lastchart <> drow(5).ToString Then
                    lastchart = drow(5).ToString.Trim
                    sp.Clear()

                    Y1axisAbsorPerc = nZ(drow(13), "Abs")
                    Y2axisAbsOrPerc = nZ(drow(14), "Abs")


                    If Y1axisPrecision = Nothing Then
                        Y1axisPrecision = CInt(nZ(drow(15), 0))
                    Else
                        Y1axisPrecision = Math.Max(CInt(nZ(drow(15), 0)), Y1axisPrecision)
                    End If

                    If Y2axisPrecision = Nothing Then
                        Y2axisPrecision = CInt(nZ(drow(16), 0))
                    Else
                        Y2axisPrecision = Math.Max(CInt(nZ(drow(16), 0)), Y2axisPrecision)
                    End If

                    '          Y1axisPrecision = CInt(nZ(drow(15), "0"))
                    '         Y2axisPrecision = CInt(nZ(drow(16), "0"))

                    Y1axislabel = nZ(drow(11), " ")
                    Y2axislabel = nZ(drow(12), " ")

                    chart_elementsYAxis(0) = nZ(drow(9), " ")

                    Dim tc As XtraTabControl
                    tc = GetTabControlFromTech(tech).TabPages(GetTabPageIndex(GetTabControlFromTech(tech), drow("ObjectTab").ToString.Trim)).Controls(0)
                    If cm_Chart_ObjectCompareOrMapKPI = "tsmi_ChartCompareElementsGroupBy" Then
                        ch = tc.TabPages(GetTabPageIndex(tc, "*CLUSTER*")).Controls(0).Controls(cm_Chart_kpiname & "CompareGroupBy")
                    Else
                        ch = tc.TabPages(GetTabPageIndex(tc, "*CLUSTER*")).Controls(0).Controls(cm_Chart_kpiname & "ObjectTime")
                    End If

                    SetChartXAxis(tech, objectscharted, ch)

                    ch.Annotations.Clear()
                    ch.Annotations.Add(New Annotation(tech.ToUpper))

                    Dim strParamFilter As String = GetParamFilterStringTemplate(tech, "stats")
                    If strParamFilter <> " " Then
                        strParamFilter = strParamFilter.Substring(5, strParamFilter.Length - 5)
                        ch.TitleBox.HeaderLabel.Text = drow(6).Trim & "   -   CLUSTER" & "  -   KPI: " & cm_Chart_kpiname & Environment.NewLine & "Param Filter(s): " & strParamFilter
                    Else
                        ch.TitleBox.HeaderLabel.Text = drow(6).Trim & "   -   CLUSTER" & "  -   KPI: " & cm_Chart_kpiname
                    End If
                    'ch.TitleBox.HeaderLabel.Text = drow(6).Trim & "   -   CLUSTER" & "  -   KPI: " & cm_Chart_kpiname

                    If Count_OT > 10 Then
                        If tsmi_ChartHideTitle.Checked = True Then
                            ch.TitleBox.Label.Text = " "
                        Else
                            Dim strAllObjs() As String = objectscharted.Split(",")
                            Dim showObjs As String = ""
                            For iCntr = 0 To strAllObjs.Count - 1
                                If iCntr < 10 Then
                                    showObjs += strAllObjs(iCntr) & ","
                                End If
                            Next
                            showObjs = showObjs + " . . . ."
                            ch.TitleBox.Label.Text = "Objects: " & showObjs
                        End If
                    Else
                        If tsmi_ChartHideTitle.Checked = True Then
                            ch.TitleBox.Label.Text = " "
                        Else
                            ch.TitleBox.Label.Text = "Objects: " & objectscharted
                        End If
                    End If

                    ch.TitleBox.Label.Alignment = StringAlignment.Near
                    ch.TitleBox.Label.LineAlignment = StringAlignment.Near

                    If GetFromTech_RadioButton(tech, "Hourly").Checked Or GetFromTech_RadioButton(tech, "Raw").Checked Then
                        ch.DefaultElement.Hotspot.ToolTip = "DATE: <%XValue,dd/MM/yy HH:mm>" & Chr(13) & "%SeriesName: %Value "
                    Else
                        ch.DefaultElement.Hotspot.ToolTip = "DATE: %XValue" & Chr(13) & "%SeriesName: %Value "
                    End If

                    Dim charttitle As String = drow(6).Trim

                    'Y-Axis Settingso   
                    If chart_elementsYAxis(i).Trim.ToUpper = "LEFT" Then
                        yaxis1 = New Axis
                        yaxis1.Orientation = Orientation.Left
                        yaxis1.Label.Text = Y1axislabel
                        If UCase(Y1axisAbsorPerc) = "ABS" Then
                            yaxis1.Percent = False
                        ElseIf UCase(Y1axisAbsorPerc) = "PERC" Then
                            yaxis1.Percent = True
                        End If
                        yaxis1.NumberPrecision = Y1axisPrecision
                        If yaxis1.NumberPrecision < 2 And Not yaxis1.Percent = True Then
                            yaxis1.MinimumInterval = 1
                        End If
                        yaxis1.Scale = dotnetCHARTING.WinForms.Scale.Range
                    Else
                        yaxis2 = New Axis
                        yaxis2.Orientation = Orientation.Left
                        yaxis2.Label.Text = Y2axislabel
                        If UCase(Y2axisAbsOrPerc) = "PERC" Then
                            yaxis2.Percent = True
                        ElseIf UCase(Y2axisAbsOrPerc) = "ABS" Then
                            yaxis2.Percent = False
                        End If
                        yaxis2.NumberPrecision = Y2axisPrecision
                        If yaxis2.NumberPrecision < 2 And Not yaxis2.Percent = True Then
                            yaxis2.MinimumInterval = 1
                        End If
                        yaxis2.Scale = dotnetCHARTING.WinForms.Scale.Range
                    End If

                    '+++++++++++++++++++++++++++++++++++++++
                    j = 0

                    For Each col As DataColumn In dt.Columns
                        ReDim Preserve chart_elements(j)
                        If col.ColumnName.ToUpper <> "DATE" Then
                            chart_elements(j) = col.ColumnName.ToUpper
                            j = j + 1
                        End If

                    Next
                    For Each dr As DataRow In dt.Rows
                        For Each col As DataColumn In dt.Columns
                            If dr(col).ToString = "" Then
                                dr(col) = 0
                            End If
                        Next
                    Next

                    Dim de As DataEngine = New DataEngine(dt)
                    de.DataFields = String2DataFields(chart_elements, "Date")
                    sc = de.GetSeries()

                    'find maxValue per axis

                    Dim LeftAxisDivisor As Int32 = 1
                    Dim RightAxisDivisor As Int32 = 1
                    Dim LeftAxisLabelAddition As String = ""
                    Dim RightAxisLabelAddition As String = ""

                    For i = 0 To sc.Count - 1
                        Dim MaxValueOfSeries As Double = sc(i).Calculate("test", Calculation.Maximum).YValue
                        If MaxValueOfSeries > 1000000000 Then
                            If MaxValueOfSeries > 1000000000000 Then
                                Select Case chart_elementsYAxis(0).ToString().Trim().ToUpper()
                                    Case "LEFT"
                                        LeftAxisDivisor = 1000000
                                        LeftAxisLabelAddition = " Million"
                                        Exit Select
                                    Case "RIGHT"
                                        RightAxisDivisor = 1000000
                                        RightAxisLabelAddition = " Million"
                                        Exit Select
                                End Select
                            Else
                                Select Case chart_elementsYAxis(0).ToString().Trim().ToUpper()
                                    Case "LEFT"
                                        If LeftAxisDivisor < 1000 Then
                                            LeftAxisDivisor = 1000
                                            LeftAxisLabelAddition = " Thousand"
                                        End If
                                        Exit Select
                                    Case "RIGHT"
                                        If RightAxisDivisor < 1000 Then
                                            RightAxisDivisor = 1000
                                            RightAxisLabelAddition = " Thousand"
                                        End If
                                        Exit Select
                                End Select
                            End If
                        End If
                    Next

                    Dim rnd As Random = New Random(10)

                    For i = 0 To sc.Count() - 1
                        sc(i).Type = SeriesType.Line
                        sc(i).Line.Width = 3
                        If yaxis1 IsNot Nothing Then
                            sc(i).YAxis = yaxis1
                        Else
                            sc(i).YAxis = yaxis2
                        End If

                        Select Case chart_elementsYAxis(0).ToString().Trim().ToUpper()
                            Case "LEFT"
                                If LeftAxisDivisor > 1 Then
                                    sc(i) = Series.Divide(sc(i), LeftAxisDivisor)
                                End If
                                If Not yaxis1.Label.Text.Contains(LeftAxisLabelAddition) Then
                                    yaxis1.Label.Text = yaxis1.Label.Text + LeftAxisLabelAddition
                                End If

                                sc(i).YAxis = yaxis1

                                'If chartSeriesAutoScale(i) = False Then
                                '    yaxis1.Minimum = 0
                                'End If

                                Exit Select
                            Case "RIGHT"
                                If RightAxisDivisor > 1 Then
                                    sc(i) = Series.Divide(sc(i), RightAxisDivisor)
                                End If

                                If Not yaxis2.Label.Text.Contains(RightAxisLabelAddition) Then
                                    yaxis2.Label.Text = yaxis2.Label.Text + RightAxisLabelAddition
                                End If
                                sc(i).YAxis = yaxis2

                                'If chartSeriesAutoScale(i) = False Then
                                '    yaxis2.Minimum = 0
                                'End If

                                Exit Select
                        End Select

                        sc(i).DefaultElement.Color = Color.FromArgb(255, rnd.Next(255), rnd.Next(255), rnd.Next(255))
                        sc(i).DefaultElement.Marker.Type = i
                    Next
                    ch.SeriesCollection.Clear()
                    ch.SeriesCollection.Add(sc)

                    HideChartScaleIfNoDataStats(ch, dt)

                    sc = Nothing
                    de = Nothing

                    ch.XAxis.Markers.Clear()
                    ch.RefreshChart()
                    ch.Visible = True
                    Dim tn As TreeNode = New TreeNode()
                    tn.Text = charttitle
                    tn.Tag = ch.Name

                    ReDim chart_elements(0)
                    ReDim chart_elementsYAxis(0)
                    ReDim chart_Eltype(0)
                    ReDim chart_ElColor(0)
                    ReDim chart_YaxisScale(1)
                    j = 0

                    Dim tp As DevExpress.XtraTab.XtraTabPage = CType(ch.Parent.Parent, DevExpress.XtraTab.XtraTabPage)
                    CType(tp.Parent, DevExpress.XtraTab.XtraTabControl).SelectedTabPage = tp
                    tp.Controls(0).Controls(ch.Name).Focus()
                End If
                Charts_ResizeWidth()

            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
            End Try
        Next
        dt_chart.Dispose()
        ds_chart.Dispose()
        dt_chart = Nothing
        ds_chart = Nothing
        If Not dt Is Nothing Then
            dt.Dispose()
        End If
    End Sub

