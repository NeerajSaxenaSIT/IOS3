    Private Sub TopX_Datagrid_HeaderSortChanged(sender As Object, e As MouseEventArgs)
        Try
            Dim dgvGridControl As GridControl = TryCast(sender, GridControl)
            Dim dgv As GridView = dgvGridControl.DefaultView

            Dim dc As Columns.GridColumn = dgv.SortedColumns.Item(dgv.CalcHitInfo(e.X, e.Y).Column.SortIndex)

            Dim tlp_pos As TableLayoutPanelCellPosition = TryCast(dgv.GridControl.Parent, TableLayoutPanel).GetPositionFromControl(dgvGridControl)
            Dim nc As Chart = TryCast(dgv.GridControl.Parent, TableLayoutPanel).GetControlFromPosition(0, tlp_pos.Row)
            Dim tech As String = nc.Tag.ToString
            Dim kpi As String = dc.GetCaption()
            Dim seriesInvisible As List(Of String) = GetTopX_DeltaSeriesInvisible(nc)

            Dim ChartElementSortOrder(1) As String
            ChartElementSortOrder(0) = dc.GetCaption()

            If dgv.Columns(kpi).SortOrder = DevExpress.Data.ColumnSortOrder.Ascending Then
                ChartElementSortOrder(1) = "ASC"
            Else
                ChartElementSortOrder(1) = "DESC"
            End If

            Dim strActiveFilter As String = dgv.ActiveFilterString
            gvDataGridTopX.ActiveFilterString = strActiveFilter

            topXGridActiveFiler = dgv.ActiveFilterString

            RemoveHandler dgv.ColumnFilterChanged, AddressOf TopX_Datagrid_ColumnFilterChanged

            If chkEnableComparisonTopX.Checked = True Then
                AssignDataToTopX_Delta(dsTopX, tech, nc.Name, seriesInvisible, ChartElementSortOrder)
            Else
                AssignDataToTopX(dsTopX.Tables(0), tech, nc.Name, ChartElementSortOrder)
            End If

            AddHandler dgv.ColumnFilterChanged, AddressOf TopX_Datagrid_ColumnFilterChanged
            gvDataGridTopX.ActiveFilterString = topXGridActiveFiler
        Catch ex As Exception
        End Try
    End Sub

