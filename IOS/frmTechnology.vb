    Private Sub Process_Stats_ThreadEnd(ds As System.Data.DataSet, ti As Threading.Thread)
        Try
            Dim threadcorrect As Boolean = False
            For Each tid In t_list
                If tid.ManagedThreadId = ti.ManagedThreadId Then
                    threadcorrect = True
                End If
            Next
            If threadcorrect = False Then
                ds.Dispose()
                ds = Nothing
                Exit Sub
            End If
            SyncLock ds_list
                If Not ds Is Nothing Then
                    If ds.Tables.Count > 0 Then
                        ds_list.Add(ds)
                    End If
                End If
            End SyncLock
            Me.BeginInvoke(Me.Call_ProcessStatsInvoked)
        Catch
        End Try
    End Sub

    Protected Friend Sub Process_Stats_Invoked()
        Application.DoEvents()
        Try
            For Each t As Threading.Thread In t_list
                If t.ThreadState = Threading.ThreadState.AbortRequested Then
                    Exit Sub
                End If
            Next t
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            lblObjTreeStatusStats.ForeColor = Color.Red
            lblObjTreeStatusStats.Text = "Threads Error..." & Threads_Fired
        End Try

        SyncLock lblObjTreeStatusStats
            Threads_Fired = Threads_Fired - 1
            If Not lblObjTreeStatusStats.Text.Contains("Abort") And Threads_Fired > -1 Then
                lblObjTreeStatusStats.Text = "Threads To Complete..." & Threads_Fired
            End If
        End SyncLock

        Try
            If Threads_Fired = 0 Then
                Threads_Fired = -99
                Application.DoEvents()
                If ds_list.Count > 0 Then
                    For Each srcbtn As SourceButton In flpSourceBtn_GetChecked(_strNetwork, flpCounterTypeStats)
                        Dim dt_list_newdataset As New List(Of DataTable)
                        For Each ds As DataSet In ds_list
                            If ds.DataSetName.Contains(srcbtn.SourceButtonText) And ds.DataSetName.Contains("//") Then
                                dt_list_newdataset.Add(ds.Tables(0).Copy)
                            ElseIf Not ds.DataSetName.Contains("//") Then
                                dsStats.Tables.Add(ds.Tables(0).Copy)
                                dsStats.Tables(dsStats.Tables.Count - 1).TableName = ds.DataSetName & "//" & dsStats.Tables.Count - 1
                            End If
                            If tsmi_ObjectAggregationOnOff.Checked = False Then
                                Dim primkeys(0) As DataColumn
                                primkeys(0) = ds.Tables(0).Columns("DATE")
                                Dim i As Int16 = 1
                                For Each dc As DataColumn In ds.Tables(0).Columns
                                    If dc.DataType = GetType(System.String) Then
                                        ReDim Preserve primkeys(i)
                                        primkeys(i) = dc
                                        i = i + 1
                                    End If
                                Next

                                ds.Tables(0).PrimaryKey = primkeys
                                Dim dt_new As DataTable = ds.Tables(0).Copy
                                If ds.DataSetName.Split("/")(1) = "" Then
                                    If dsStats.Tables(srcbtn.SourceButtonText) Is Nothing Then
                                        dt_new.TableName = srcbtn.SourceButtonText
                                        dsStats.Tables.Add(dt_new)
                                    Else
                                        dsStats.Tables(srcbtn.SourceButtonText).Merge(dt_new)
                                    End If
                                Else

                                End If

                            End If
                        Next

                        dt_list_newdataset.Sort(Function(x, y) x.Rows.Count.CompareTo(y.Rows.Count))
                        dt_list_newdataset.Reverse()

                        If tsmi_ObjectAggregationOnOff.Checked = True Then
                            Dim dt_merged As DataTable = MergeData2(dt_list_newdataset, "Date")
                            If Not dt_merged Is Nothing Then
                                dt_merged.TableName = srcbtn.SourceButtonText
                                dsStats.Tables.Add(dt_merged.Copy)
                            End If
                        End If
                    Next

                    'If tsmi_ChartHideTitle.Checked = True Then
                    '    If Count_OT > 10 AndAlso tsmi_ObjectAggregationOnOff.Checked = True Then
                    '        tsmi_ChartHideTitle.Checked = False
                    '    Else
                    '        tsmi_ChartHideTitle.Checked = True
                    '    End If
                    'End If

                    For Each dt As DataTable In dsStats.Tables
                        If dt.TableName.Contains("//") Then
                            If tsmi_ObjectAggregationOnOff.Checked = True Then
                                AssignDataToCharts_CrossTab(dt, _strNetwork, Split(dt.TableName, "/")(1))
                            End If

                        Else
                            If tsmi_ObjectAggregationOnOff.Checked = True Then
                                AssignDataToCharts(dt, _strNetwork)
                            Else
                                Dim objsel() As String = Nothing
                                Dim objsel_id() As String = Nothing

                                If cmbObjectTreeStats.Text <> "TAGS" Then
                                    objsel = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectName", strTreeFilter).Substring(4).TrimEnd(")").Split(",")   'Was ObjectID
                                    objsel_id = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectID", strTreeFilter).Substring(4).TrimEnd(")").Split(",")   'Was ObjectID
                                Else
                                    objsel = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectName", strTreeFilter).Substring(4).TrimEnd(")").Split(",")
                                    objsel_id = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectID", strTreeFilter).Substring(4).TrimEnd(")").Split(",")
                                End If

                                'check if objectName is reported or objectID in the datatable
                                Dim exists As Boolean = False

                                For Each obj As String In objsel
                                    exists = dt.Select(cmbObjectTreeStats.Text + "=" + obj).Length > 0
                                    If exists = True Then Exit For
                                Next

                                If exists = True Then
                                    For j = 0 To objsel.Count - 1
                                        dt.DefaultView.RowFilter = cmbObjectTreeStats.Text + "=" + objsel(j)
                                        dt.DefaultView.Sort = "DATE ASC"
                                        AssignDataToCharts(dt.DefaultView.ToTable, _strNetwork, objsel(j), objsel.Count, j)
                                    Next
                                Else   'try objectid
                                    For j = 0 To objsel.Count - 1
                                        dt.DefaultView.RowFilter = cmbObjectTreeStats.Text + "=" + objsel_id(j)
                                        dt.DefaultView.Sort = "DATE ASC"
                                        AssignDataToCharts(dt.DefaultView.ToTable, _strNetwork, objsel_id(j), objsel_id.Count, j)
                                    Next
                                End If

                            End If
                        End If
                    Next

                    gcChartsStats.DataSource = Nothing
                    gcChartsStats.Refresh()

                    lblObjTreeStatusStats.Text = "Query Success: " & DateDiff(DateInterval.Second, timer, Now()) & "s"
                    lblObjTreeStatusStats.ForeColor = Color.Black
                Else
                    lblObjTreeStatusStats.Text = "No Data Retrieved !"
                    lblObjTreeStatusStats.ForeColor = Color.Red
                End If
                Me.AccCtrlStats.Enabled = True
                Me.btnApplyStats.Text = "Apply"
                ucProgPnlStats.StopProgress()
                Application.DoEvents()
            End If
            mm.ReleaseMemory()
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            lblObjTreeStatusStats.ForeColor = Color.Red
            lblObjTreeStatusStats.Text = "Error Merging Threads..." & Threads_Fired
            mm.ReleaseMemory()
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & "," & " Target Type: " & cmbObjectTreeStats.Text & "," & " Counter Type: " & UserTrackingStatsCounterType & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
    End Sub

    Private Sub ProcessStatsCompareTime(tech As String, KPIname As String, Optional objectName As String = "")
        Try
            System.Threading.Thread.CurrentThread.CurrentCulture = CultureInfoDefault
            System.Threading.Thread.CurrentThread.CurrentUICulture = CultureUIDefault

            Dim ds As DataSet = TechToDataSet(tech, "Time")
            Dim dt_new As New DataTable
            Dim dt_new_sort As New DataTable
            Dim pvt_Pivot As Pivot = Nothing
            Dim dt_pivot As DataTable = Nothing
            Dim dtCopy As DataTable = Nothing
            Dim objectTypeName As String = cmbObjectTreeStats.Text

            If tsmi_ObjectAggregationOnOff.Checked = False Then
                For Each dt As DataTable In ds.Tables
                    Dim dataView As DataView = dt.DefaultView

                    dataView.RowFilter = $"{objectTypeName} = '{objectName} '"
                    dtCopy = dataView.ToTable()

                    If dtCopy.Columns.Contains(KPIname) Then
                        Dim displayView = New DataView(dtCopy)
                        displayView.RowFilter = ""
                        dt_new = displayView.ToTable(False, "Date", KPIname).Copy
                    End If
                Next
            Else
                For Each dt As DataTable In ds.Tables
                    If dt.Columns.Contains(KPIname) Then
                        Dim displayView = New DataView(dt)
                        displayView.RowFilter = ""
                        dt_new = displayView.ToTable(False, "Date", KPIname).Copy
                    End If
                Next
            End If

            If Not dt_new Is Nothing Then
                'add time columns for pivot
                dt_new.Columns.Add(New DataColumn("RowsSortField", GetType(Integer)))
                dt_new.Columns.Add(New DataColumn("RowsField", GetType(String)))
                dt_new.Columns.Add(New DataColumn("ColumnsField", GetType(String)))

                If dt_new.Rows.Count > 1 Then
                    Dim d1 As DateTime = dt_new(0)("Date")
                    Dim d2 As DateTime = dt_new(1)("Date")
                    Dim dlast As DateTime = dt_new(dt_new.Rows.Count - 1)("Date")
                    Dim dd As Long = DateDiff(DateInterval.Minute, d1, d2)

                    If dd < 60 Then
                        For Each dr As DataRow In dt_new.Rows
                            Dim hourpart As String = "0" + DatePart(DateInterval.Hour, dr("Date")).ToString
                            Dim minpart As String = "0" + DatePart(DateInterval.Minute, dr("Date")).ToString
                            dr("RowsSortField") = hourpart.Substring(hourpart.Length - 2, 2) + minpart.Substring(minpart.Length - 2, 2)
                            dr("RowsField") = hourpart.Substring(hourpart.Length - 2, 2) + ":" + minpart.Substring(minpart.Length - 2, 2)
                            dr("ColumnsField") = "Day " & (DateDiff(DateInterval.Day, DateSerial(dlast.Year, dlast.Month, dlast.Day), DateSerial(dr("Date").Year, dr("Date").Month, dr("Date").Day), FirstDayOfWeek.System, FirstWeekOfYear.System))
                        Next
                    ElseIf dd = 60 Then
                        For Each dr As DataRow In dt_new.Rows
                            dr("RowsSortField") = DatePart(DateInterval.Hour, dr("Date"))
                            dr("RowsField") = DatePart(DateInterval.Hour, dr("Date"))
                            dr("ColumnsField") = "Day " & (DateDiff(DateInterval.Day, DateSerial(dlast.Year, dlast.Month, dlast.Day), DateSerial(dr("Date").Year, dr("Date").Month, dr("Date").Day), FirstDayOfWeek.System, FirstWeekOfYear.System))
                        Next
                    ElseIf dd = 60 * 24 Then
                        For Each dr As DataRow In dt_new.Rows
                            dr("RowsSortField") = DatePart(DateInterval.Weekday, dr("Date"), FirstDayOfWeek.System)
                            dr("RowsField") = WeekdayName(DatePart(DateInterval.Weekday, dr("Date"), FirstDayOfWeek.System), False, FirstDayOfWeek.System)
                            dr("ColumnsField") = "Week " & (DateDiff(DateInterval.WeekOfYear, DateSerial(dlast.Year, dlast.Month, dlast.Day), DateSerial(dr("Date").Year, dr("Date").Month, dr("Date").Day), FirstDayOfWeek.System, FirstWeekOfYear.System))
                        Next
                    End If
                    'remove date column
                    dt_new.Columns.Remove("Date")
                    Dim displayViewSort = New DataView(dt_new)
                    displayViewSort.Sort = "RowsSortField ASC"
                    dt_new_sort = displayViewSort.ToTable.Copy
                    'pivot
                    'pvt_Pivot = New Pivot(dt_new)
                    pvt_Pivot = New Pivot(dt_new_sort)
                    dt_pivot = pvt_Pivot.PivotData("RowsField", KPIname, AggregateFunction.Average, "ColumnsField")

                    'create chart
                    AssignDataToCompareTime_New(dt_pivot, tech, objectName)
                    SetToTech_StatusLabel(tech, "Query Success", Color.Black)
                    SetToTech_QueryStart(tech, 0)
                End If
            End If
        Catch ex As Exception
            SetToTech_StatusLabel(tech, "Query Failed", Color.Red)
            SetToTech_QueryStart(tech, 0)
        End Try
        'System.Threading.Thread.CurrentThread.CurrentUICulture = Globalization.CultureInfo.GetCultureInfo("en-US")
        'System.Threading.Thread.CurrentThread.CurrentCulture = Globalization.CultureInfo.GetCultureInfo("en-US")
    End Sub

    Private Sub AssignDataToCompareTime_New(ByRef dt As DataTable, tech As String, Optional objectName As String = "")
        Dim sqlchart As String
        Dim objectscharted As String = ""

        'this is to get objectcharted filled. 
        SetChartXAxis(tech, objectscharted, Nothing)

        sqlchart = "SELECT * from qry_IOS_Configuration_Charts_1Table WHERE ChartElements = " & Chr(39) & cm_Chart_kpiname & Chr(39) & " And techtab = " & Chr(39) & tech & Chr(39)
        Dim ds_chart As DataSet = DataAccessorODBC.GetDataSet(connStrIOSServer, sqlchart)
        Dim dt_chart As DataTable = ds_chart.Tables(0)

        'Assign data to all charts
        '*************************
        Dim ch As Chart = Nothing
        Dim i As Integer
        Dim Y1axislabel As String
        Dim Y2axislabel As String
        Dim Y1axisAbsorPerc, Y2axisAbsOrPerc As String
        Dim Y1axisPrecision, Y2axisPrecision As Integer
        Dim yaxis1 As Axis = Nothing
        Dim yaxis2 As Axis = Nothing
        Dim sp As New SmartPalette()
        Dim sc As New SeriesCollection
        'Dim color_R, color_B, color_G As Integer

        Dim lastchart As String = ""

        Dim chart_elements() As String = {"0"}
        Dim chart_elementsYAxis() As String = {"0"}
        Dim chart_Eltype() As String = {"Bar"}
        Dim chart_ElColor() As Integer = {0}
        Dim chart_YaxisScale() As String = {"0", "0"}
        Dim chart_ElLineSize() As Integer = {0}

        Dim j As Integer = 0
        Dim rownum As Integer = 0

        For rownum = 0 To 0
            Try
                'collecting elements from chart confguration
                Dim drow As DataRow = dt_chart.Rows(rownum)

                'configures individual chart when new chartline is detected
                If lastchart = "" Or lastchart <> drow(5).ToString Then
                    lastchart = drow(5).ToString.Trim
                    sp.Clear()

                    Y1axisAbsorPerc = nZ(drow(13), "Abs")
                    Y2axisAbsOrPerc = nZ(drow(14), "Abs")

                    If Y1axisPrecision = Nothing Then
                        Y1axisPrecision = CInt(nZ(drow(15), 0))
                    Else
                        Y1axisPrecision = Math.Max(CInt(nZ(drow(15), 0)), Y1axisPrecision)
                    End If

                    If Y2axisPrecision = Nothing Then
                        Y2axisPrecision = CInt(nZ(drow(16), 0))
                    Else
                        Y2axisPrecision = Math.Max(CInt(nZ(drow(16), 0)), Y2axisPrecision)
                    End If

                    'Y1axisPrecision = CInt(nZ(drow(15), "0"))
                    'Y2axisPrecision = CInt(nZ(drow(16), "0"))

                    Y1axislabel = nZ(drow(11), " ")
                    Y2axislabel = nZ(drow(12), " ")

                    chart_elementsYAxis(0) = nZ(drow(9), " ")

                    Dim tc As DevExpress.XtraTab.XtraTabControl
                    tc = GetTabControlFromTech(tech).TabPages(GetTabPageIndex(GetTabControlFromTech(tech), drow("ObjectTab").ToString.Trim)).Controls(0)
                    If tsmi_ObjectAggregationOnOff.Checked = False Then
                        ch = tc.TabPages(GetTabPageIndex(tc, "*CLUSTER*")).Controls(0).Controls(cm_Chart_kpiname & objectName & "CompareTime")
                        objectscharted = objectName
                    Else
                        ch = tc.TabPages(GetTabPageIndex(tc, "*CLUSTER*")).Controls(0).Controls(cm_Chart_kpiname & "CompareTime")
                    End If

                    ch.Annotations.Clear()
                    ch.Annotations.Add(New Annotation(tech.ToUpper))
                    ch.TitleBox.HeaderLabel.Text = drow(6).Trim & " - COMPARE TIME" & " - KPI: " & cm_Chart_kpiname

                    If Count_OT > 10 Then
                        If tsmi_ChartHideTitle.Checked = True Then
                            ch.TitleBox.Label.Text = " "
                        Else
                            Dim strAllObjs() As String = objectscharted.Split(",")
                            Dim showObjs As String = ""
                            For iCntr = 0 To strAllObjs.Count - 1
                                If iCntr < 10 Then
                                    showObjs += strAllObjs(iCntr) & ","
                                End If
                            Next
                            showObjs = showObjs + " . . . ."
                            ch.TitleBox.Label.Text = "Objects: " & showObjs
                            ch.TitleBox.HeaderLabel.AutoWrap = True
                        End If
                    Else
                        If tsmi_ChartHideTitle.Checked = True Then
                            ch.TitleBox.Label.Text = "Objects: " & objectscharted
                            ch.TitleBox.HeaderLabel.AutoWrap = True
                        Else
                            ch.TitleBox.Label.Text = " "
                        End If
                    End If

                    ch.TitleBox.Label.Alignment = StringAlignment.Near
                    ch.TitleBox.Label.LineAlignment = StringAlignment.Near

                    ch.DefaultElement.Hotspot.ToolTip = "DateTimeElement: %XValue" & Chr(13) & "%SeriesName: %Value "
                    Dim charttitle As String = drow(6).Trim

                    'Y-Axis Settingso   
                    If chart_elementsYAxis(i).Trim.ToUpper = "LEFT" Then
                        yaxis1 = New Axis
                        yaxis1.Orientation = Orientation.Left
                        yaxis1.Label.Text = Y1axislabel
                        If UCase(Y1axisAbsorPerc) = "ABS" Then
                            yaxis1.Percent = False
                            yaxis1.NumberPrecision = Y1axisPrecision
                        End If
                        If UCase(Y1axisAbsorPerc) = "PERC" Then
                            yaxis1.Percent = True
                            yaxis1.NumberPrecision = Y1axisPrecision
                        End If
                        If yaxis1.NumberPrecision < 2 And Not yaxis1.Percent = True Then
                            yaxis1.MinimumInterval = 1
                        End If
                        yaxis1.Scale = dotnetCHARTING.WinForms.Scale.Range
                    Else
                        yaxis2 = New Axis
                        yaxis2.Orientation = Orientation.Left
                        yaxis2.Label.Text = Y2axislabel
                        If UCase(Y2axisAbsOrPerc) = "ABS" Then
                            yaxis2.Percent = False
                            yaxis2.NumberPrecision = Y2axisPrecision
                        End If
                        If UCase(Y2axisAbsOrPerc) = "PERC" Then
                            yaxis2.Percent = True
                            yaxis2.NumberPrecision = Y2axisPrecision
                        End If
                        If yaxis2.NumberPrecision < 2 And Not yaxis2.Percent = True Then
                            yaxis2.MinimumInterval = 1
                        End If
                        yaxis2.Scale = dotnetCHARTING.WinForms.Scale.Range
                    End If

                    '+++++++++++++++++++++++++++++++++++++++
                    j = 0

                    For Each col As DataColumn In dt.Columns
                        ReDim Preserve chart_elements(j)
                        If col.ColumnName.ToUpper <> "ROWSFIELD" Then
                            chart_elements(j) = col.ColumnName.ToUpper
                            j = j + 1
                        End If
                    Next

                    Dim de As DataEngine = New DataEngine(dt)
                    de.DataFields = String2DataFields(chart_elements, "RowsField")
                    sc = de.GetSeries()

                    Dim rnd As Random = New Random(10)

                    For i = 0 To sc.Count() - 1
                        sc(i).Type = SeriesType.Line

                        If sc(i).Name = "DAY 0" Or sc(i).Name = "WEEK 0" Then
                            sc(i).Line.Width = 6
                        Else
                            sc(i).Line.Width = 3 'CInt(chart_ElLineSize(i))
                        End If

                        If yaxis1 IsNot Nothing Then
                            sc(i).YAxis = yaxis1
                        Else
                            sc(i).YAxis = yaxis2
                        End If
                        sc(i).DefaultElement.Color = Color.FromArgb(255, rnd.Next(255), rnd.Next(255), rnd.Next(255))
                        sc(i).DefaultElement.Marker.Type = i
                    Next
                    ch.SeriesCollection.Clear()
                    ch.SeriesCollection.Add(sc)

                    'HideChartScaleIfNoDataStats(ch, dt)

                    sc = Nothing
                    de = Nothing

                    ch.XAxis.Markers.Clear()
                    ch.RefreshChart()
                    ch.Visible = True

                    Dim tn As TreeNode = New TreeNode()
                    tn.Text = charttitle
                    tn.Tag = ch.Name


                    ReDim chart_elements(0)
                    ReDim chart_elementsYAxis(0)
                    ReDim chart_Eltype(0)
                    ReDim chart_ElColor(0)
                    ReDim chart_YaxisScale(1)
                    ReDim chart_ElLineSize(0)

                    j = 0

                    Dim tp As DevExpress.XtraTab.XtraTabPage = CType(ch.Parent.Parent, DevExpress.XtraTab.XtraTabPage)
                    CType(tp.Parent, DevExpress.XtraTab.XtraTabControl).SelectedTabPage = tp
                    tp.Controls(0).Controls(ch.Name).Focus()
                End If
                Charts_ResizeWidth()

            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
                Console.WriteLine(ex.Message.ToString)
            End Try
        Next
        If Not ch Is Nothing Then
            ch.Series.Data = dt.Copy
        End If

        dt_chart.Dispose()
        ds_chart.Dispose()
        dt_chart = Nothing
        ds_chart = Nothing
        If Not dt Is Nothing Then
            dt.Dispose()
        End If
    End Sub

    Private Function TechToDataSet(tech As String, TimeObjTime As String)

        If TimeObjTime.ToLower = "time".ToLower Then
            If tech.ToUpper = Network.ToUpper Then
                Return dsStats
            End If
        ElseIf TimeObjTime.ToLower = "topx" Then
            If tech.ToUpper = Network.ToUpper Then
                Return dsTopX
            End If
        ElseIf TimeObjTime.ToLower = "objtime".ToLower Then
            If tech.ToUpper = Network.ToUpper Then
                Return dsStats_ObjectTime
            End If
        ElseIf TimeObjTime.ToLower = "evaltime".ToLower Then
            If tech.ToUpper = Network.ToUpper Then
                Return dsEval
            End If
        End If
        Return Nothing
    End Function

