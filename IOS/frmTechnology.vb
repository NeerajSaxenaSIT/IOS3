    Private Sub dateNavigatorStats_CustomDrawDayNumberCell(sender As Object, e As Calendar.CustomDrawDayNumberCellEventArgs) Handles dateNavigatorStats.CustomDrawDayNumberCell
        Dim isDisabledDate As Boolean = True

        If (e.Date >= dtEditStartTimeStats.EditValue And e.Date <= dtEditEndTimeStats.EditValue) Or (e.Date.ToString("yyyyMMdd") = CDate(dtEditEndTimeStats.EditValue).ToString("yyyyMMdd")) Then
            If cmbPredefinedFilterStats.SelectedIndex > 0 Then
                If cmbPredefinedFilterStats.SelectedItem.ToString = e.Date.DayOfWeek.ToString Then
                    isDisabledDate = False
                ElseIf cmbPredefinedFilterStats.SelectedItem.ToString = "Weekdays" Then
                    If e.Date.DayOfWeek = DayOfWeek.Saturday Or e.Date.DayOfWeek = DayOfWeek.Sunday Then
                        isDisabledDate = True
                    Else
                        isDisabledDate = False
                    End If
                ElseIf cmbPredefinedFilterStats.SelectedItem.ToString = "Weekends" Then
                    If e.Date.DayOfWeek <> DayOfWeek.Saturday And e.Date.DayOfWeek <> DayOfWeek.Sunday Then
                        isDisabledDate = True
                    Else
                        isDisabledDate = False
                    End If
                End If
            Else
                isDisabledDate = False
            End If
        End If

        If isDisabledDate Then
            e.State = DevExpress.Utils.Drawing.ObjectState.Disabled
            e.Graphics.DrawString(e.Date.Day.ToString(), e.Style.Font, Brushes.Gray, New Point(e.ContentBounds.Location.X, e.ContentBounds.Location.Y))
            e.Handled = True
        Else
            e.Handled = False
        End If

        If e.Disabled = False And e.Holiday = False And e.Inactive = False And e.Selected = False And e.Today = False Then
            clr = e.Style.ForeColor
        End If
        If e.Holiday = True And e.Disabled = False And e.Inactive = False And clr <> Color.Empty Then
            e.Style.ForeColor = clr
        End If

        For Each dt As DateRange In preSelectedFilterPeriodStats
            If e.Date >= dt.StartDate AndAlso e.Date <= dt.EndDate Then
                e.Style.BackColor = Color.SkyBlue
            End If
        Next

    End Sub

