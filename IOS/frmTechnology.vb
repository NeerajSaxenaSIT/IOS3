                        ch.TitleBox.HeaderLabel.Text = drow(6).Trim
                    Else
                        ch.TitleBox.Label.Text = drow(6).Trim
                        ch.TitleBox.HeaderLabel.Text = ""
                    End If

                    ch.DefaultElement.Hotspot.ToolTip = "%SeriesName = %Value"

                    'Y-Axis Settings   
                    yaxis1 = New Axis
                    yaxis1.Orientation = Orientation.Left


                    yaxis2 = New Axis
                    yaxis2.Orientation = Orientation.Right

                    If ch.Type = ChartType.Scatter Then
                        If dt_chart.AsEnumerable().Where(Function(n) n.Field(Of Integer)("ChartType") = IOSChartType.Scatter And n.Field(Of String)("ChartName") = lastchart).ToArray()(0)("ElementAxis") = "Y" Then
