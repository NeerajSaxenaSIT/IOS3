    Private Sub InitializeTopXTagsDataTable()
        If dtTagsExcListTopX Is Nothing Then
            dtTagsExcListTopX = New DataTable
            If dtTagsExcListTopX.Columns.Count = 0 Then
                dtTagsExcListTopX.Columns.Add("Select", GetType(Boolean))
                dtTagsExcListTopX.Columns.Add("ListID", GetType(String))
                dtTagsExcListTopX.Columns.Add("ListName", GetType(String))
            End If
        End If
    End Sub

    Friend Function GetTagsExcListTopX(type As String) As String
        Dim tagsExcList As String = ""
        If dtTagsExcListTopX IsNot Nothing Then
            If dtTagsExcListTopX.Rows.Count > 0 Then
                If type.ToUpper = "ID" Then
                    For Each dr As DataRow In dtTagsExcListTopX.Rows
                        tagsExcList = tagsExcList & dr("ListID").ToString & ","
                    Next
                ElseIf type.ToUpper = "NAME" Then
                    For Each dr As DataRow In dtTagsExcListTopX.Rows
                        tagsExcList = tagsExcList & dr("ListName").ToString & ","
                    Next
                End If
            End If
        End If
        If tagsExcList IsNot Nothing Then tagsExcList.TrimEnd(",")
        Return tagsExcList
    End Function

