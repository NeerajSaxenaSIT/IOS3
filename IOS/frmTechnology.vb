    Public Function MarkerExists(markers As AxisMarkerCollection, marker As AxisMarker) As Boolean
        For Each m As AxisMarker In markers
            If m.Label.Text = marker.Label.Text Then
                Return True
            End If
        Next
        Return False
    End Function

