#Region "Threads"

Public Class Thread_Stats

    Public ds As System.Data.DataSet
    Public connstring As String
    Public sql_total As String
    Public ds_name As String = Nothing
    Private _p1 As Object

    Public Event ThreadComplete(ds As System.Data.DataSet, ti As Threading.Thread)

    Public Sub GetData()
        Try
            'For SQL debugging purposes
            WriteString_Query("Timestamp: " & Now.ToString & vbCrLf & "SQL Fired: " & vbCrLf & sql_total & vbCrLf & "------------------------------" & vbCrLf)

            Using cnQODBC As New System.Data.Odbc.OdbcConnection(connstring)
                cnQODBC.ConnectionTimeout = 300
                cnQODBC.Open()
                Using daQODBC As New System.Data.Odbc.OdbcDataAdapter(sql_total, cnQODBC)
                    daQODBC.SelectCommand.CommandTimeout = 3600
                    ds = New System.Data.DataSet

                    daQODBC.Fill(ds)

                    If Not ds_name Is Nothing Then
                        If ds_name <> "" Then
                            ds.DataSetName = ds_name
                        End If
                    End If
                End Using
            End Using
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
        Finally
            RaiseEvent ThreadComplete(ds, Threading.Thread.CurrentThread)
        End Try
    End Sub

End Class

#End Region