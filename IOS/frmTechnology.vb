        IsThreshHoldBreached()

        RemoveHandler cmbChartSetNameStats.SelectedIndexChanged, AddressOf ChartSetName_Changed
        RemoveHandler cmbChartSetNameTopX.SelectedIndexChanged, AddressOf ChartSetName_Changed
        RemoveHandler cmbChartSetNameEval.SelectedIndexChanged, AddressOf ChartSetNameEval_Changed

        xtcTechnology.SelectedTabPageIndex = 0

        xtcTechnology.TabPages.Item(0).Text = "Stats - " & networkName
        SetVendorImages(Me.VendorName, xtcTechnology.TabPages.Item(0))
        ObjectTypesStats = clsSQLCommands.GetObjectConfigurationData(connStrIOSServer, networkName, Me.VendorName)
        KPITreeDataStats = GetKPIDS(networkName, techlevel, EnumStatsOrTopX.STATS)
        TreeVendorStats = Me.VendorStatsDS
