    Public Sub btnApplyStats_Click(sender As Object, e As EventArgs) Handles btnApplyStats.Click
        Try
            Export2Excel = False

            'Setting Period Calculation Objects To Nothing
            prdCalcApplied = False
            showPrdCalcSeries = False
            chExtraLegendBoxClicked = False
            manualAxisMarkerApplied = False
            IOSDevExpressGrid.ClearGrid(gcPrdCalcCompStats)
            prdCalcAxisMarkerColl = Nothing

            If dicPrdCalcData IsNot Nothing Then
                dicPrdCalcData.Clear()
            End If
            If dicBrkKpiCntrData IsNot Nothing Then
                dicBrkKpiCntrData.Clear()
            End If
            dicBrkKpiCntrData = New Dictionary(Of String, DataTable)

            If dicPrdCalcAxisMarkers IsNot Nothing Then
                dicPrdCalcAxisMarkers.Clear()
            End If
            If dicPrdCalcSeriesData IsNot Nothing Then
                dicPrdCalcSeriesData.Clear()
            End If

            'clear all chart in selected tab page
            tsmi_ChartHideTitle.Tag = "SHOW"
            ReleaseMemoryOfTechnologyStatsInstance()
            AxisMarkerYListOfLastChart.Clear()
            HiddenSeriesCollectionStats.Clear()

            t_list_number = t_list_number + 1
            timer = Now()

            If btnApplyStats.Text = "Abort" Then
                If t_list.Count > 0 Then
                    t_list.Clear()
                End If
                lblObjTreeStatusStats.Text = "Threads Aborted !"
                lblObjTreeStatusStats.ForeColor = Color.Red

                t_lastid = -1
                btnApplyStats.Text = "Apply"
                Me.AccCtrlStats.Enabled = True
                ucProgPnlStats.StopProgress()
                Exit Sub
            Else
                btnApplyStats.Text = "Abort"
                Me.AccCtrlStats.Enabled = False
                ucProgPnlStats.StartProgress()
            End If

            'setting view in map
            If cmbObjectTreeStats.Text = "" Then
                lblObjTreeStatusStats.Text = "Choose Target Aggregation !"
                lblObjTreeStatusStats.ForeColor = Color.Red
                btnApplyStats.PerformClick()
                Exit Sub
            End If

            If cmbChartSetNameStats.Text = "" Or cmbChartSetNameStats.SelectedItem.ToString = "Select" Then
                lblObjTreeStatusStats.Text = "Choose Chart Set Name !"
                lblObjTreeStatusStats.ForeColor = Color.Red
                btnApplyStats.PerformClick()
                Exit Sub
            End If

            Application.DoEvents()
            Dim NumOfObjectsSelected As Integer = Count_OT
            Dim selected_charts As String = tvKPIStats.GetKPIChecked2String(3, "ObjectName") '' TreeViewKPI_Checked2String(tvKPIStats, 3, "ObjectName")
            Dim NumOfCharts As Integer = selected_charts.Split(",").Count
            ChartRightAxisAutoColor = GetConfigClientKeyValue("ChartRightAxisAutoColor")

            Try
                If tsmi_ObjectAggregationOnOff.Checked = True Then
                    Reconstruct_Charts_New(_strNetwork)
                Else
                    lblObjTreeStatusStats.ForeColor = Color.Black
                    lblObjTreeStatusStats.Text = "Building Charts..."
                    If Count_OT * NumOfCharts > 1000 Then
                        lblObjTreeStatusStats.ForeColor = Color.Red
                        lblObjTreeStatusStats.Text = "Too Many Charts!"
                        Exit Sub
                    End If
                    Application.DoEvents()
                    Reconstruct_Charts_New(_strNetwork, False, Count_OT)
                    If Count_OT > seChartsPerRowStats.Properties.MaxValue Then
                        seChartsPerRowStats.Value = seChartsPerRowStats.Properties.MaxValue
                    Else
                        seChartsPerRowStats.Value = Count_OT
                    End If
                End If

                gcChangesStats.DataSource = Nothing
                gcChangesStats.Refresh()
                gcAlarmsStats.DataSource = Nothing
                gcAlarmsStats.Refresh()
                gcTicketsStats.DataSource = Nothing
                gcTicketsStats.Refresh()

            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " " & ex.StackTrace)
            End Try

            Dim periodinterval As String = "DAY"
            If rdoRawStats.Checked Then
                periodinterval = "RAW"
            ElseIf rdoHourlyStats.Checked Or xtcPSFilterStats.SelectedTabPage.Text.Contains("Hours") Then
                periodinterval = "HOUR"
            ElseIf rdoMonthlyStats.Checked Then
                periodinterval = "MONTH"
            End If
            If IsDateIntervalChartVolumeOK(dtEditStartTimeStats, dtEditEndTimeStats, periodinterval, NumOfCharts) = False Then
                lblObjectsStats.ForeColor = Color.Red
                lblObjTreeStatusStats.Text = "Too Many Charts for Period !"
                btnApplyStats.Text = "Apply"
                Me.AccCtrlStats.Enabled = True
                Me.ucProgPnlStats.StopProgress()
                Exit Sub
            End If

            Application.DoEvents()
            Process_Stats(tsmi_ObjectAggregationOnOff.Checked)

            mm.ReleaseMemory()
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

    Private Sub Reconstruct_Charts_New(techname As String, Optional ClearOnly As Boolean = False, Optional NumOfObjectCharts As Integer = 1)
        ChartsReconstructed = False
        chartAxisScaleAdjust.Clear()
        cm_Chart_Sourcecontrol = Nothing
        'CN
        Dim tabcontrol As DevExpress.XtraTab.XtraTabControl = GetTabControlFromTech(techname)
        RemoveHandler tabcontrol.SelectedPageChanged, AddressOf Tabcontrol_Object_SelectedIndexChanged
        AddHandler tabcontrol.SelectedPageChanged, AddressOf Tabcontrol_Object_SelectedIndexChanged
        Dim tpobjectindex As Integer = tabcontrol.SelectedTabPageIndex
        Dim tctemp As DevExpress.XtraTab.XtraTabControl = Nothing
        Dim tpindex As Integer = Nothing
        Dim flptemp As FlowLayoutPanel = Nothing
        Dim ptscroll As System.Drawing.Point = Nothing
        Try
            If Not tpobjectindex = -1 Then
                tctemp = CType(tabcontrol.SelectedTabPage.Controls(0), XtraTabControl)
                tpindex = tctemp.SelectedTabPageIndex
                flptemp = CType(tctemp.SelectedTabPage.Controls(0), FlowLayoutPanel)
                Try
                    ptscroll = flptemp.AutoScrollPosition
                Catch
                End Try
            End If
        Catch
        End Try

        Try
            For Each tpage As DevExpress.XtraTab.XtraTabPage In tabcontrol.TabPages
                If tpage.Controls.Count > 0 Then
                    RemoveHandler TryCast(tpage.Controls(0), XtraTabControl).SelectedPageChanged, AddressOf Tabcontrol_Category_SelectedIndexChanged
                    For Each tp As XtraTabPage In TryCast(tpage.Controls(0), XtraTabControl).TabPages
                        If tp.Controls.Count > 0 Then
                            For Each ch As dotnetCHARTING.WinForms.Chart In tp.Controls(0).Controls
                                RemoveHandler ch.MouseClick, AddressOf Chart_Click
                                RemoveHandler ch.MouseDown, AddressOf Chart_MouseDown
                                RemoveHandler ch.Paint, AddressOf Chart_Paint
                                RemoveHandler ch.MouseUp, AddressOf Chart_MouseUp
                                RemoveHandler ch.MouseMove, AddressOf Chart_MouseMove

                                If Not ch.ContextMenuStrip Is Nothing Then
                                    ch.ContextMenuStrip.Dispose()
                                End If
                                ch.ContextMenuStrip = Nothing
                                ch.SeriesCollection.Clear()
                                ch.Dispose()
                                ch = Nothing
                            Next
                            tp.Controls(0).Dispose()
                            tp.Dispose()
                        End If
                    Next
                    tpage.Controls(0).Dispose()
                End If
                tpage.Dispose()
            Next
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        tabcontrol.TabPages.Clear()

        If ClearOnly = True Then
            mm.ReleaseMemory()
            Exit Sub
        End If

        Try
            ConstructTabAndChart_Stats(cmbChartSetNameStats.SelectedItem.ToString, techname, tabcontrol, NumOfObjectCharts, tpobjectindex, tpindex)
            'tabcontrol.SelectedTabPage = tabcontrol.TabPages(tpobjectindex)
            If tabcontrol.TabPages.Count <> 0 Then
                Dim tc As XtraTabControl = CType(tabcontrol.SelectedTabPage.Controls(0), XtraTabControl)
                If Not tpobjectindex = -1 Then
                    'tc.SelectedTabPage = tc.TabPages(tpindex)
                    'LastChartTabActive = tc.SelectedTabPage
                    flptemp = CType(tc.SelectedTabPage.Controls(0), FlowLayoutPanel)
                    flptemp.AutoScrollPosition = New System.Drawing.Point(Math.Abs(ptscroll.X), Math.Abs(ptscroll.Y))
                    ptscroll = Nothing
                End If

                Charts_ResizeWidth()
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message + " " + ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
        ChartsReconstructed = True
    End Sub

    Private Sub ConstructTabAndChart_Stats(chSetName As String, techname As String, ByRef supertabcontrol As XtraTabControl, NumOfObjectCharts As Integer, Optional LastSelectedObjectTabPageIndex As Integer = 0, Optional LastSelectedTabPageIndex As Integer = 0)
        Try
            Dim sql As String = Nothing
            Using conn As New Odbc.OdbcConnection(connStrIOSServer)
                conn.ConnectionTimeout = 5
                conn.Open()

                If (chSetName = chartSetName) Then
                    sql = "SELECT techtab,  Categorytabindex, Categorytab, ObjectTab 
                           FROM IOS_Chart_Configuration 
                            left outer join IOS_Object_Configuration on tech=techtab and [Object]=ObjectTab 
                            INNER JOIN (select ObjectConfigProfile from IOS_Licenses where LicenseUser = " & Chr(39) & Environment.UserName.ToString & Chr(39) & ") IOS_Licenses on IOS_Object_Configuration.ObjectConfigProfile = IOS_Licenses.ObjectConfigProfile
                            WHERE (((ChartSetName = " & Chr(39) & chartSetName & Chr(39) & ") OR (ChartSetName = " & Chr(39) & Environment.UserName.ToString & Chr(39) & "))  AND TechTab = " & Chr(39) & techname & Chr(39) & ")" & "
                            GROUP BY techtab, Categorytab, categorytabindex, ObjectTab, loadorder 
                            ORDER BY techtab, loadorder desc, categorytabindex"
                Else
                    sql = "SELECT techtab,  Categorytabindex, Categorytab, ObjectTab FROM IOS_Chart_Configuration 
                            left outer join IOS_Object_Configuration on tech=techtab and [Object]=ObjectTab 
                            INNER JOIN (select ObjectConfigProfile from IOS_Licenses where LicenseUser = " & Chr(39) & Environment.UserName.ToString & Chr(39) & ") IOS_Licenses on IOS_Object_Configuration.ObjectConfigProfile = IOS_Licenses.ObjectConfigProfile
                            WHERE ((ChartSetName = " & Chr(39) & chSetName & Chr(39) & ")  AND (TechTab = " & Chr(39) & techname & Chr(39) & ") AND (CategoryTab <> 'Dummy'))  " & "
                            GROUP BY techtab, Categorytab, categorytabindex, ObjectTab, loadorder 
                            ORDER BY techtab, loadorder desc, categorytabindex"
                End If

                Using comm As New Odbc.OdbcCommand(sql, conn)
                    Using dr As Odbc.OdbcDataReader = comm.ExecuteReader
                        If dr.HasRows = False Then
                            MsgBox("No Chart Configuration Detected. Check IOS Server Connection!")
                            Exit Sub
                        Else
                            While dr.Read
                                Console.WriteLine(dr.Item(0).ToString.Trim)
                                AddTabPage_New(dr.GetValue(0).ToString.Trim, dr.GetValue(3).ToString.Trim, dr.GetValue(1), dr.GetValue(2), supertabcontrol)
                            End While
                            dr.Close()


                            If Not LastSelectedObjectTabPageIndex = -1 Then
                                supertabcontrol.SelectedTabPage = supertabcontrol.TabPages(LastSelectedObjectTabPageIndex)
                                Dim tc As XtraTabControl = CType(supertabcontrol.SelectedTabPage.Controls(0), XtraTabControl)
                                If tc.TabPages.Count = LastSelectedTabPageIndex Then
                                    tc.SelectedTabPage = tc.TabPages(LastSelectedTabPageIndex - 1)
                                    'If tc.TabPages.Count = LastSelectedObjectTabPageIndex Then
                                    '    tc.SelectedTabPage = tc.TabPages(LastSelectedObjectTabPageIndex)
                                ElseIf tc.TabPages.Count > LastSelectedTabPageIndex Then
                                    tc.SelectedTabPage = tc.TabPages(LastSelectedTabPageIndex)
                                Else
                                    tc.SelectedTabPage = tc.TabPages(0)
                                End If
                                LastChartTabActive = tc.SelectedTabPage
                            End If

                            'Add chart 
                            '( techtab, categorytabindex, categorytab, chartindex, chartname, objecttab, objecttabindex, ChartTitle)
                            'GROUP BY techtab, categorytabindex,categorytab, chartindex, chartname, objecttab, objecttabindex,ChartTitle

                            If (chSetName = chartSetName) Then
                                sql = "SELECT * FROM IOS_Chart_Configuration WHERE (((ChartSetName = " & Chr(39) & chartSetName & Chr(39) & ") OR (ChartSetName = " & Chr(39) & Environment.UserName.ToString & Chr(39) & ")) AND TechTab = " & Chr(39) & techname & Chr(39) & ") ORDER BY techtab, objecttab, objecttabindex, categorytabindex, chartindex,ChartTitle ASC"
                            Else
                                sql = "SELECT * FROM IOS_Chart_Configuration WHERE ((ChartSetName = " & Chr(39) & chSetName & Chr(39) & ") AND TechTab = " & Chr(39) & techname & Chr(39) & ") ORDER BY techtab, objecttab, objecttabindex, categorytabindex, chartindex,ChartTitle ASC"
                            End If

                            Dim dt_charts As DataTable = DataLibrary.DataAccessorODBC.GetDataTable(connStrIOSServer, sql)
                            Dim ChartConfig As New ChartConfigDataTables
                            Dim dtChartGeneration As New DataTable
                            dtChartGeneration = dt_charts.DefaultView.ToTable(True, {"techtab", "categorytabindex", "categorytab", "chartindex", "chartname", "objecttab", "objecttabindex", "ChartTitle"})
                            ChartConfig.ChartFillingDataTable = dt_charts
                            ChartConfig.ChartGenerationDataTable = dtChartGeneration
                            supertabcontrol.Tag = ChartConfig
                            AddChartsFromDT(_strNetwork, supertabcontrol, dtChartGeneration, NumOfObjectCharts, CType(supertabcontrol.SelectedTabPage.Controls(0), XtraTabControl).SelectedTabPage.Name)
                            Application.DoEvents()
                        End If
                    End Using
                End Using
            End Using
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message + " " + ex.StackTrace)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

    Private Sub AddChartsFromDT(tech As String, ByRef supertabcontrol As DevExpress.XtraTab.XtraTabControl, ByRef dt As DataTable, NumOfObjectCharts As Integer, Optional TabNameSelected As String = Nothing)
        Try
            Dim tabindex_old As Integer = 0
            Dim chartindex As Integer = -1
            Dim selected_tabs As String = tvKPIStats.GetKPIChecked2String(2, "ObjectName") '' TreeViewKPI_Checked2String(tvKPIStats, 2, "ObjectName")
            Dim selected_charts As String = tvKPIStats.GetKPIChecked2String(3, "ObjectName") '' TreeViewKPI_Checked2String(tvKPIStats, 3, "ObjectName")
            Dim isFakeChart As Boolean = False

            Dim filter As String = Nothing
            If Not TabNameSelected Is Nothing Then
                filter = "techtab = '" + tech + "'  and categorytab = '" + TabNameSelected + "'"
            Else
                filter = ""
            End If

            For Each drow As DataRow In dt.Select(filter)
                isFakeChart = False
                Dim tabindex_new As Integer = CInt(drow(1))

                If tabindex_old <> tabindex_new Then
                    chartindex = 0
                    tabindex_old = tabindex_new
                Else
                    chartindex = chartindex + 1
                End If
                If Not selected_charts.Contains(drow(7).ToString) Then
                    isFakeChart = True
                End If

                If NumOfObjectCharts = 1 Then
                    If CInt(drow(1)) = 99 Then
                        tabindex_new = GetTabPageIndex(supertabcontrol.TabPages(GetTabPageIndex(supertabcontrol, drow(5).ToString.Trim)).Controls(0), "Custom")
                        AddChart(drow(0).ToString.Trim, tabindex_new, drow(4).ToString, chartindex, supertabcontrol.TabPages(GetTabPageIndex(supertabcontrol, drow(5).ToString.Trim)).Controls(0), isFakeChart)
                    Else
                        AddChart(drow(0).ToString.Trim, drow(1), drow(4).ToString, chartindex, supertabcontrol.TabPages(GetTabPageIndex(supertabcontrol, drow(5).ToString.Trim)).Controls(0), isFakeChart)
                    End If
                Else
                    If selected_tabs.Contains(drow("categorytab").ToString.TrimEnd) Then
                        Dim flowbreak As Boolean = False
                        For i = 0 To NumOfObjectCharts - 1
                            If i = NumOfObjectCharts - 1 Then
                                flowbreak = True
                            End If
                            If CInt(drow(1)) = 99 Then
                                tabindex_new = GetTabPageIndex(supertabcontrol.TabPages(GetTabPageIndex(supertabcontrol, drow(5).ToString.Trim)).Controls(0), "Custom")
                                AddChart(drow(0).ToString.Trim, tabindex_new, drow(4).ToString, chartindex, supertabcontrol.TabPages(GetTabPageIndex(supertabcontrol, drow(5).ToString.Trim)).Controls(0), isFakeChart, flowbreak)
                            Else
                                AddChart(drow(0).ToString.Trim, drow(1), drow(4).ToString, chartindex, supertabcontrol.TabPages(GetTabPageIndex(supertabcontrol, drow(5).ToString.Trim)).Controls(0), isFakeChart, flowbreak)
                            End If
                        Next
                    End If
                End If
            Next
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message + " " + ex.StackTrace)
        End Try
    End Sub

    Public Function MarkerExists(markers As List(Of AxisMarker), marker As AxisMarker) As Boolean
        Try
            For Each m As AxisMarker In markers
                If marker.Value.GetType().Name = "DateTime" Then
                    If m.Value = marker.Value AndAlso
                    m.Label.Text = marker.Label.Text Then
                        Return True
                    End If
                End If
            Next
            Return False
        Catch
        End Try
        Return False
    End Function

    Public Sub Charts_ClearSeries(vtab As XtraTabPage)
        Try
            If vtab.Controls.Count = 0 Then Exit Sub
            'store Axismarkers temporary in list
            AxisMarkerXListOfLastChart.Clear()
            'AxisMarkerYListOfLastChart.Clear()
            Dim j As Integer = 0

            For Each ch As Chart In vtab.Controls(0).Controls
                If j = 0 Then
                    For Each am As AxisMarker In ch.XAxis.Markers
                        If Not AxisMarkerXListOfLastChart.Contains(am) Then
                            AxisMarkerXListOfLastChart.Add(am)
                        End If
                    Next
                    For Each am As AxisMarker In ch.YAxis.Markers
                        AxisMarkerYListOfLastChart.Add(am)
                    Next
                End If

                RemoveHandler ch.MouseClick, AddressOf Chart_Click
                RemoveHandler ch.MouseDown, AddressOf Chart_MouseDown
                RemoveHandler ch.Paint, AddressOf Chart_Paint
                RemoveHandler ch.MouseUp, AddressOf Chart_MouseUp
                RemoveHandler ch.MouseMove, AddressOf Chart_MouseMove

                'Console.WriteLine(ch.Name)
                If Not ch.ContextMenuStrip Is Nothing Then
                    ch.ContextMenuStrip.Dispose()
                    ch.ContextMenuStrip = Nothing
                End If
                ch.SeriesCollection.Clear()
                ch.ClearAll()
                ch.Dispose()
                ch = Nothing
                j = j + 1
            Next
            vtab.Controls(0).Controls.Clear()
            vtab.Controls(0).Dispose()
        Catch ex As Exception
        End Try
    End Sub

    Private Sub Tabcontrol_Object_SelectedIndexChanged(sender As Object, e As System.EventArgs)
        Try
            Dim vtc As XtraTabControl = TryCast(sender, XtraTabControl)
            If vtc.SelectedTabPage IsNot Nothing Then
                Dim vtc_category As XtraTabControl = TryCast(vtc.SelectedTabPage.Controls(0), XtraTabControl)
                If LastChartTabActive IsNot Nothing AndAlso LastChartTabActive.Name <> "*CLUSTER*" Then
                    Charts_ClearSeries(LastChartTabActive)
                    mm.ReleaseMemory()
                End If
                Tabcontrol_Category_SelectedIndexChanged(vtc_category, Nothing)
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

    Private Sub Tabcontrol_Category_SelectedIndexChanged(sender As Object, e As System.EventArgs)
        Try
            If ChartsReconstructed = False Then
                Exit Sub
            End If
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            DefaultSeriesCollectionStats.Clear()
            ExtraLegendEntryCollectionStats.Clear()
            HiddenSeriesCollectionStats.Clear()

            Dim selectedChartTab As XtraTabPage = TryCast(sender, XtraTabControl).SelectedTabPage
            Dim selected_ObjectTab As XtraTabPage = TryCast(TryCast(sender, XtraTabControl).Parent, XtraTabPage).TabControl.SelectedTabPage

            'if techtab is changed, don't delete anything
            If TechTabChanged = True Then
                LastChartTabActive = selectedChartTab
                TechTabChanged = False
                Exit Sub
            End If

            'clear LastChartTab
            If Not LastChartTabActive Is Nothing AndAlso LastChartTabActive.Name <> "*CLUSTER*" Then       'AndAlso selectedChartTab.Name <> "*CLUSTER*"
                'clear
                Charts_ClearSeries(LastChartTabActive)
            ElseIf Not LastChartTabActive Is Nothing AndAlso LastChartTabActive.Name = "*CLUSTER*" Then
                'don't clear charts
            Else
                LastChartTabActive = selectedChartTab
                Exit Sub
            End If
            mm.ReleaseMemory()
            're-generate chart (if needed)
            'first check if first chart of tab has series
            If selectedChartTab.Controls.Count = 0 Then
                'regenerate chart
                Dim ChartConfig As ChartConfigDataTables = selected_ObjectTab.TabControl.Tag

                Dim tech As String = ChartConfig.ChartGenerationDataTable(0)(0)
                Dim ChartConfigDetailed As DataTable = Nothing
                If ChartConfig.ChartFillingDataTable IsNot Nothing AndAlso ChartConfig.ChartFillingDataTable.AsEnumerable().Where(Function(x) x.Field(Of String)("TechTab") = tech And x.Field(Of String)("CategoryTab") = selectedChartTab.Name).Count > 0 Then
                    ChartConfigDetailed = ChartConfig.ChartFillingDataTable.AsEnumerable().Where(Function(x) x.Field(Of String)("TechTab") = tech AndAlso x.Field(Of String)("CategoryTab") = selectedChartTab.Name.Trim).CopyToDataTable()
                End If

                Dim NumOfObjCharts As Integer = 1

                Dim flp As FlowLayoutPanel = New FlowLayoutPanel()
                flp.FlowDirection = FlowDirection.LeftToRight
                flp.AutoScroll = True
                selectedChartTab.Controls.Add(flp)
                flp.Dock = DockStyle.Fill

                If tsmi_ObjectAggregationOnOff.Checked = False Then
                    NumOfObjCharts = GetFromTech_CountOT(tech)
                End If
                AddChartsFromDT(tech, selected_ObjectTab.TabControl, ChartConfig.ChartGenerationDataTable, NumOfObjCharts, selectedChartTab.Name)

                'add data
                Dim ds As DataSet = Nothing
                ds = TechToDataSet(tech, "time")
                Dim cmb As ComboBoxEdit = GetFromTech_TargetObject(tech)

                If ds IsNot Nothing Then
                    For Each dt As DataTable In ds.Tables
                        If dt.TableName.Contains(selected_ObjectTab.Name) Then
                            If dt.TableName.Contains("//") Then
                                AssignDataToCharts_CrossTab(dt, tech, Split(dt.TableName, "/")(1), ChartConfigDetailed)
                            Else
                                If tsmi_ObjectAggregationOnOff.Checked = True Then
                                    AssignDataToCharts(dt, tech, "", 1, 0, ChartConfigDetailed)
                                Else


                                    Dim objsel() As String = Nothing
                                    Dim objsel_id() As String = Nothing

                                    If cmbObjectTreeStats.Text <> "TAGS" Then
                                        objsel = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectName", strTreeFilter).Substring(4).TrimEnd(")").Split(",")   'Was ObjectID
                                        objsel_id = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectID", strTreeFilter).Substring(4).TrimEnd(")").Split(",")   'Was ObjectID
                                    Else
                                        objsel = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectName", strTreeFilter).Substring(4).TrimEnd(")").Split(",")
                                        objsel_id = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectID", strTreeFilter).Substring(4).TrimEnd(")").Split(",")
                                    End If

                                    'check if objectName is reported or objectID in the datatable
                                    Dim exists As Boolean = False

                                    For Each obj As String In objsel
                                        exists = dt.Select(cmbObjectTreeStats.Text + "=" + obj).Length > 0
                                        If exists = True Then Exit For
                                    Next


                                    If exists = True Then
                                        For j = 0 To objsel.Count - 1
                                            dt.DefaultView.RowFilter = cmbObjectTreeStats.Text + "=" + objsel(j)
                                            dt.DefaultView.Sort = "DATE ASC"
                                            AssignDataToCharts(dt.DefaultView.ToTable, _strNetwork, objsel(j), objsel.Count, j)
                                        Next
                                    Else   'try objectid
                                        For j = 0 To objsel.Count - 1
                                            dt.DefaultView.RowFilter = cmbObjectTreeStats.Text + "=" + objsel_id(j)
                                            dt.DefaultView.Sort = "DATE ASC"
                                            AssignDataToCharts(dt.DefaultView.ToTable, _strNetwork, objsel_id(j), objsel_id.Count, j)
                                        Next
                                    End If

                                    'old... below was updated with above to deal with objecttime aggregate off, objectname/id difference

                                    'Dim objsel() As String = tvObjectsTreeStats.GetChecked2String(tech, cmb.Text, "ObjectName", strTreeFilter).Substring(4).TrimEnd(")").Split(",")
                                    'For j = 0 To objsel.Count - 1
                                    '    dt.DefaultView.RowFilter = cmb.Text + "=" + objsel(j)
                                    '    dt.DefaultView.Sort = "DATE ASC"
                                    '    AssignDataToCharts(dt.DefaultView.ToTable, tech, objsel(j), objsel.Count, j, ChartConfigDetailed)
                                    'Next
                                End If
                            End If
                        End If
                    Next

                    If prdCalcApplied = True AndAlso selectedChartTab.Text <> "*CLUSTER*" Then
                        If dicPrdCalcData IsNot Nothing Then dicPrdCalcData.Clear()
                        If dicPrdCalcAxisMarkers IsNot Nothing Then dicPrdCalcAxisMarkers.Clear()
                        ApplyPeriodCalculationToCharts()
                        LoadPeriodCalculationData()
                    End If

                    If selectedChartTab.Controls.Count > 0 Then
                        For Each ch As Chart In selectedChartTab.Controls(0).Controls
                            If prdCalcApplied = False Then
                                ch.XAxis.Markers.Clear()
                                ch.YAxis.Markers.Clear()
                                For Each am As AxisMarker In AxisMarkerXListOfLastChart
                                    ch.XAxis.Markers.Add(am)
                                Next
                            Else
                                For Each am As AxisMarker In AxisMarkerXListOfLastChart
                                    'If MarkerExists(prdCalcAxisMarkerColl, am) Then
                                    If (am.ValueLow = am.ValueHigh) AndAlso (am.Value.GetType().ToString <> "System.Double") Then
                                        ch.XAxis.Markers.Add(am)
                                    End If
                                    'End If
                                Next
                            End If
                            For Each am As AxisMarker In AxisMarkerYListOfLastChart
                                ch.YAxis.Markers.Add(am)
                            Next
                            ch.RefreshChart()
                        Next
                    End If

                End If
            End If

            'set LastChartTabActive to current tab
            LastChartTabActive = selectedChartTab

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        Finally
            mm.ReleaseMemory()
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Private Function GetFromTech_TargetObject(tech As String) As ComboBoxEdit
        Try
            Select Case tech.ToUpper
                Case Network.ToUpper
                    Return cmbObjectTreeStats
                Case "TOPX_" & Network.ToUpper
                    Return cmbObjectTreeTopX
            End Select
        Catch ex As Exception
        End Try
        Return Nothing
    End Function

    Private Sub AddTabPage_New(tech As String, ObjectTab As String, tabindex As Integer, tabname As String, ByRef SuperTabControl As XtraTabControl)
        Try
            Dim tp As New DevExpress.XtraTab.XtraTabPage
            Dim objectabcontrol As XtraTabControl = Nothing

            If Not tech.ToLower.Contains("topx_") Then
                If tabindex = 0 Then
                    If GetTabPage(SuperTabControl, ObjectTab) Is Nothing Then
                        Dim objtab As XtraTabPage = New XtraTabPage()                   'ObjectTab
                        objtab.Text = ObjectTab
                        Dim objtabcontrol As XtraTabControl = New XtraTabControl()
                        objtabcontrol.LookAndFeel.UseDefaultLookAndFeel = True
                        objtabcontrol.Dock = DockStyle.Fill
                        SuperTabControl.Margin = New Padding(0, 0, 0, 0)
                        objtabcontrol.Margin = New Padding(0, 0, 0, 0)
                        objtab.Margin = New Padding(0, 0, 0, 0)
                        objtab.Controls.Add(objtabcontrol)
                        SuperTabControl.TabPages.Add(objtab)
                        objectabcontrol = objtabcontrol
                        AddHandler objtabcontrol.SelectedPageChanged, AddressOf Tabcontrol_Category_SelectedIndexChanged
                    End If
                ElseIf tabindex = 99 Then
                    If GetTabPage(SuperTabControl, ObjectTab) Is Nothing Then
                        Dim objtab As XtraTabPage = New XtraTabPage()                   'ObjectTab
                        objtab.Text = ObjectTab
                        Dim objtabcontrol As XtraTabControl = New XtraTabControl()
                        objtabcontrol.LookAndFeel.UseDefaultLookAndFeel = True
                        objtabcontrol.Dock = DockStyle.Fill
                        SuperTabControl.Margin = New Padding(0, 0, 0, 0)
                        objtabcontrol.Margin = New Padding(0, 0, 0, 0)
                        objtab.Margin = New Padding(0, 0, 0, 0)
                        objtab.Controls.Add(objtabcontrol)
                        SuperTabControl.TabPages.Add(objtab)
                        objectabcontrol = objtabcontrol
                        AddHandler objtabcontrol.SelectedPageChanged, AddressOf Tabcontrol_Category_SelectedIndexChanged
                    End If
                End If

                objectabcontrol = GetTabPage(SuperTabControl, ObjectTab).Controls(0)
                tp = New DevExpress.XtraTab.XtraTabPage
                tp.Text = tabname.ToString.Trim
                tp.Name = tabname.ToString.Trim
                tp.Width = SuperTabControl.Width
                tp.AutoScroll = True
                objectabcontrol.TabPages.Add(tp)
                If objectabcontrol.TabPages.Count = 1 AndAlso SuperTabControl.TabPages.Count = 1 Then
                    Application.DoEvents()
                End If
                tp.Dock = DockStyle.Fill
            Else
                If tabindex = 0 Then
                    If GetTabPage(SuperTabControl, ObjectTab) Is Nothing Then
                        Dim objtab As XtraTabPage = New XtraTabPage()                   'ObjectTab
                        objtab.Text = ObjectTab
                        Dim objtabcontrol As XtraTabControl = New XtraTabControl()
                        objtabcontrol.Dock = DockStyle.Fill

                        objtab.Controls.Add(objtabcontrol)
                        objectabcontrol = objtabcontrol
                    Else
                        objectabcontrol = GetTabPage(SuperTabControl, ObjectTab).Controls(0)
                    End If
                End If
                tp = New DevExpress.XtraTab.XtraTabPage
                tp.Text = tabname.ToString.Trim
                tp.Name = tabname.ToString.Trim
                tp.AutoScroll = True
                objectabcontrol.TabPages.Add(tp)

                Dim tbllayout As TableLayoutPanel
                tbllayout = New System.Windows.Forms.TableLayoutPanel
                tbllayout.Anchor = AnchorStyles.Left
                tbllayout.Dock = DockStyle.Top
                tbllayout.GrowStyle = TableLayoutPanelGrowStyle.AddRows
                tbllayout.AutoSize = True
                tbllayout.AutoSizeMode = AutoSizeMode.GrowOnly
                tbllayout.ColumnCount = 2
                tbllayout.ColumnStyles.Add(New System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType.Absolute, 500.0!))
                tbllayout.ColumnStyles.Add(New System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType.Percent, 100.0!))
                tbllayout.RowCount = 1
                tbllayout.RowStyles.Add(New System.Windows.Forms.RowStyle(System.Windows.Forms.SizeType.Absolute, 300.0!))
                tbllayout.Name = "Layout_" & tabname.ToString.Trim
                tbllayout.Size = New System.Drawing.Size(CInt(SuperTabControl.TabPages(SuperTabControl.TabPages.Count - 1).Width - 10), 300)
                tbllayout.MinimumSize = New System.Drawing.Size(800, 300)

                objectabcontrol.TabPages(SuperTabControl.TabPages.Count - 1).AutoScroll = True
                objectabcontrol.TabPages(SuperTabControl.TabPages.Count - 1).Controls.Add(tbllayout)

            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

    Private Function GetTabPage(tabcontrol As XtraTabControl, tabtitle As String) As XtraTabPage
        Try
            For Each tp As XtraTabPage In tabcontrol.TabPages
                If tp.Text.Trim.ToUpper = tabtitle.Trim.ToUpper Then
                    Return tp
                End If
            Next
            Return Nothing
        Catch ex As Exception
            Return Nothing
        End Try
    End Function

    Public Function GetTabPageIndex(tabcontrol As XtraTabControl, tabtitle As String) As Integer
        Try
            Dim i As Integer = 0
            For i = 0 To tabcontrol.TabPages.Count - 1
                If tabcontrol.TabPages(i).Text.ToUpper = tabtitle.ToUpper Then
                    Return i
                End If
            Next
            Return Nothing
        Catch ex As Exception
            Return Nothing
        End Try
    End Function

    Public Sub AddChart(tech As String, tbpage As Integer, cName As String, pos As Integer, ByRef supertabcontrol As XtraTabControl, Optional IsFakeChart As Boolean = False, Optional FlowBreakCount As Boolean = False, Optional evalHistChart As Boolean = False)
        Dim nc As Chart = Nothing
        Try
            If Not tech.ToLower.Contains("topx") Then

                Dim flp As FlowLayoutPanel = Nothing
                If evalHistChart = False Then
                    If supertabcontrol.TabPages(tbpage).Controls.Count = 0 Then
                        flp = New FlowLayoutPanel()
                        flp.FlowDirection = FlowDirection.LeftToRight
                        flp.AutoScroll = True
                        supertabcontrol.TabPages(tbpage).Controls.Add(flp)
                        flp.Dock = DockStyle.Fill
                    Else
                        flp = CType(supertabcontrol.TabPages(tbpage).Controls(0), FlowLayoutPanel)
                    End If
                Else
                    Dim tlpEvalHist As TableLayoutPanel = CType(supertabcontrol.TabPages(tbpage).Controls(0), TableLayoutPanel)
                    Dim sccEvalHist As SplitContainerControl = CType(tlpEvalHist.Controls(0), SplitContainerControl)
                    If sccEvalHist.Panel1.Controls.Count = 0 Then
                        flp = New FlowLayoutPanel()
                        flp.FlowDirection = FlowDirection.LeftToRight
                        flp.AutoScroll = True
                        SplitContainerEval_Hist.Panel1.Controls.Add(flp)
                        flp.Dock = DockStyle.Fill
                    Else
                        flp = CType(sccEvalHist.Panel1.Controls(0), FlowLayoutPanel)
                    End If
                End If

                If IsFakeChart Then
                    nc = New Chart
                    nc.Visible = False
                    supertabcontrol.TabPages(tbpage).Controls(0).Controls.Add(nc)
                Else
                    nc = New Chart
                    nc.Name = cName
                    nc.Width = (flp.Width - 25) / seChartsPerRowStats.Value - ((seChartsPerRowStats.Value - 1) * 2)
                    If evalHistChart = False Then
                        nc.Height = tbChartHeightStats.Value
                    Else
                        nc.Height = tbChartHeightEvalHistogram.Value
                    End If
                    'Chart Default Properties
                    nc.DefaultElement.Marker.Visible = False
                    nc.LegendBox.Orientation = dotnetCHARTING.WinForms.Orientation.Bottom
                    nc.LegendBox.DefaultEntry.Value = ""
                    nc.LegendBox.DefaultEntry.Hotspot.ToolTip = "%Name"
                    nc.LegendBox.Visible = Not tsmi_ChartHideLegend.Checked
                    nc.LegendBox.DefaultCorner = BoxCorner.Round

                    nc.XAxis.TickLabelMode = TickLabelMode.Angled
                    nc.XAxis.TickLabelAngle = 45
                    nc.XAxis.Minimum = 0
                    nc.XAxis.Maximum = 0

                    nc.XAxis.Scale = dotnetCHARTING.WinForms.Scale.Time
                    nc.XAxis.TimeScaleLabels.Mode = TimeScaleLabelMode.Smart

                    nc.ToolTip.InitialDelay = 1
                    nc.ChartAreaLayout.Mode = ChartAreaLayoutMode.Horizontal
                    nc.DefaultSeries.EmptyElement.Mode = EmptyElementMode.None
                    nc.CleanupPeriod = 1

                    nc.TitleBox.Position = TitleBoxPosition.Full
                    nc.TitleBox.CornerTopLeft = BoxCorner.Round
                    nc.TitleBox.CornerTopRight = BoxCorner.Round
                    nc.TitleBox.Label.AutoWrap = True

                    AddHandler nc.MouseClick, AddressOf Chart_Click
                    AddHandler nc.MouseDown, AddressOf Chart_MouseDown
                    AddHandler nc.MouseUp, AddressOf Chart_MouseUp

                    'Dim flp As FlowLayoutPanel = CType(supertabcontrol.TabPages(tbpage).Controls(0), FlowLayoutPanel)
                    If FlowBreakCount = True Then
                        flp.SetFlowBreak(nc, True)
                    End If

                    flp.Controls.Add(nc)

                End If
            Else
                Dim tbllayout As TableLayoutPanel
                Dim tbllayoutname As String = "Layout_" & supertabcontrol.TabPages(tbpage).Name
                tbllayout = supertabcontrol.TabPages(tbpage).Controls(tbllayoutname)

                If pos > 0 Then
                    tbllayout.RowCount = pos + 1
                    Dim rwheight As Single = tbllayout.RowStyles(0).Height
                    tbllayout.RowStyles.Add(New System.Windows.Forms.RowStyle(SizeType.Absolute, rwheight))
                    tbllayout.Size = New System.Drawing.Size(CInt(supertabcontrol.TabPages(TabIndex).Width - 10), (pos + 1) * 300)
                End If

                nc = New Chart
                nc.Name = cName & "_" & tech
                'nc.Width = CInt(tbllayout.ColumnStyles(0).Width - 10)
                nc.Dock = DockStyle.Fill
                nc.ToolTip.InitialDelay = 1

                'Chart Default Properties
                nc.DefaultElement.Marker.Visible = False
                nc.LegendBox.Orientation = dotnetCHARTING.WinForms.Orientation.Bottom
