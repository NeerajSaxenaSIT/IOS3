#Region "Stats Helper"

    Private Sub ProcessStatsObjectTime(tech As String)
        Try
            Dim connstring As String = Nothing

            'Constructing STATS SQL
            '***********************
            Dim aggr_from As String = ""
            aggr_from = tcTabControlHighStats.SelectedTabPage.Text

            If aggr_from = "" Then
                lblObjTreeStatusStats.Text = "Choose Source Type!"
                lblObjTreeStatusStats.ForeColor = Color.Red
                Exit Sub
            End If

            Dim sql_all As Specialized.StringCollection = New Specialized.StringCollection()
            Dim sql_crosstabobj As New List(Of String)
            Dim sql_tables As String
            'get list of tables

            'get KPI sql
            Dim conn_el As Odbc.OdbcConnection = New Odbc.OdbcConnection(connStrIOSServer)
            conn_el.ConnectionTimeout = 5
            conn_el.Open()

            If Export2Excel = True Then
                sql_tables = clsSQLCommands.GetProcessStatsQueryExport2Excel(tech, cmbChartSetNameStats.SelectedItem.ToString, Environment.UserName.ToString)
            Else
                If (cm_Chart_ObjectCompareOrMapKPI = "tsmi_Chart_LaunchObj") Or (cm_Chart_ObjectCompareOrMapKPI = "tsmi_ChartCompareElementsGroupBy") Then
                    If CType(cm_Chart_Sourcecontrol, Chart).Parent IsNot Nothing Then
                        If (CType(CType(CType(cm_Chart_Sourcecontrol, Chart).Parent, FlowLayoutPanel).Parent, XtraTabPage).Name.ToUpper = "*CLUSTER*") Then
                            sql_tables = clsSQLCommands.GetProcessStatsQuery(tech, cm_Chart_kpiname)
                        Else
                            sql_tables = clsSQLCommands.GetProcessStatsQuery(tech, cm_Chart_kpiname, cm_Chart_Sourcecontrol.Name)
                        End If
                    Else
                        sql_tables = clsSQLCommands.GetProcessStatsQuery(tech, cm_Chart_kpiname, cm_Chart_Sourcecontrol.Name)
                    End If
                Else
                    sql_tables = clsSQLCommands.GetProcessStatsQuery(tech, cm_Chart_kpiname)
                End If
            End If

            Dim comm_Element As Odbc.OdbcCommand = New Odbc.OdbcCommand(sql_tables, conn_el)
            Dim dr As Odbc.OdbcDataReader = comm_Element.ExecuteReader
            Dim sourcetable As String = ""
            Dim aliastable As String = ""
            Dim joinobjects As String = ""
            Dim lst_sqlCounterTypes As New List(Of String)

            Dim lstOfSelectedCounterTypes As New List(Of String)
            For Each srcbtn As SourceButton In flpSourceBtn_GetChecked(_strNetwork, flpCounterTypeStats)
                lstOfSelectedCounterTypes.Add(srcbtn.SourceButtonText)
            Next

            While dr.Read
                If lstOfSelectedCounterTypes.Contains(dr("Object").ToString.ToUpper) Then
                    sourcetable = nZ(dr.GetValue(0).ToString.Trim, "")
                    joinobjects = nZ(dr.GetValue(1).ToString.Trim, "")
                    sql_crosstabobj.Add(nZ(dr.GetValue(2), "").ToString.Trim)
                    aggr_from = nZ(dr.GetValue(3).ToString.Trim, "")
                    sql_all.Add(SQL_Construct_ObjectTime(aggr_from, sourcetable, cm_Chart_kpiname))
                    lst_sqlCounterTypes.Add(dr("Object").ToString)
                End If
            End While

            conn_el.Close()
            conn_el.Dispose()
            conn_el = Nothing
            'loop through all tables

            If sql_all.Count = 0 Then
                btnApplyStats.PerformClick() 'aborting
                Exit Sub
            End If

            connstring = connectionString
            Threads_Fired = 0

            ds_list.Clear()
            t_list.Clear()

            If Export2Excel = True Then
                dsExport2Excel = New DataSet
                dtExport2Excel = New DataTable

                Dim Cntr As Integer = 0
                For Each sql_to_fire As String In sql_all
                    dtExport2Excel = GetExport2ExcelDataTable(sql_to_fire, connstring)
                    If dtExport2Excel.IsValid() Then
                        dtExport2Excel.TableName = lst_sqlCounterTypes(sql_all.IndexOf(sql_to_fire)) & "_" & Cntr 'sql_all.IndexOf(sql_to_fire)
                        dsExport2Excel.Tables.Add(dtExport2Excel)
                        Cntr = Cntr + 1
                    End If
                Next

                'Dim sql_to_fire As String = sql_all(0)
                'If sql_to_fire <> "" Then
                '    dtExport2Excel = GetExport2ExcelDataTable(sql_to_fire, connstring)
                'End If
            Else
                'Launching 3G stats threads
                '*****************************
                For Each sql_to_fire As String In sql_all
                    Dim stats_t As New Thread_Stats
                    stats_t.connstring = connstring
                    stats_t.sql_total = sql_to_fire
                    stats_t.ds_name = sql_crosstabobj(Threads_Fired)
                    AddHandler stats_t.ThreadComplete, AddressOf Process_Stats_ObjectTime_ThreadEnd

                    Dim thread_x = New Threading.Thread(AddressOf stats_t.GetData)
                    thread_x.Start()
                    t_list.Add(thread_x)
                    Threads_Fired = Threads_Fired + 1
                Next

                lblObjTreeStatusStats.Text = "Query Started..."
                lblObjTreeStatusStats.ForeColor = Color.Black

            End If

        Catch ex As Exception
            lblObjTreeStatusStats.Text = "Failed...Try Again"
            lblObjTreeStatusStats.ForeColor = Color.Red
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
        End Try
    End Sub

    Public Function GetExport2ExcelDataTable(sql_total As String, connstring As String) As DataTable
        Try
            WriteString_Query("Export CSV -- Timestamp: " & Now.ToString & vbCrLf & vbCrLf & "SQL Fired: " & vbCrLf & sql_total & vbCrLf & "------------------------------" & vbCrLf)

            Dim dt As DataTable
            Using cnQODBC As New System.Data.Odbc.OdbcConnection(connstring)
                cnQODBC.ConnectionTimeout = 300
                cnQODBC.Open()
                Using daQODBC As New System.Data.Odbc.OdbcDataAdapter(sql_total, cnQODBC)
                    daQODBC.SelectCommand.CommandTimeout = 3600
                    dt = New System.Data.DataTable
                    daQODBC.Fill(dt)
                End Using
            End Using
            Return dt
        Catch ex As Exception
            WriteString_Query("ERROR:" & ex.Message & " - " & ex.StackTrace)

            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)

            Return Nothing
        End Try
    End Function

    Private Sub Process_Stats_ObjectTime_ThreadEnd(ds As System.Data.DataSet, ti As Threading.Thread)
        Try
            Dim threadcorrect As Boolean = False
            For Each tid In t_list
                If tid.ManagedThreadId = ti.ManagedThreadId Then
                    threadcorrect = True
                End If
            Next

            If threadcorrect = False Then
                ds.Dispose()
                ds = Nothing
                Exit Sub
            End If

            dsStats_ObjectTime = ds

            Dim aResult As IAsyncResult = Nothing
            aResult = Me.BeginInvoke(Me.Call_ProcessStatsObjectTimeInvoked)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
        End Try
    End Sub

    Public Sub AddThemeType(ByRef tsmi_TopXMapType As ToolStripComboBox, Optional ForTimeBasedChart As Boolean = False, Optional ForGeoID As Boolean = False)
        If ForTimeBasedChart = True Then
            tsmi_TopXMapType.Items.Add("Ranged Theme")
            tsmi_TopXMapType.Items.Add("Graduated Theme")
            tsmi_TopXMapType.Items.Add("Voronoi")
        ElseIf ForGeoID = True Then
            tsmi_TopXMapType.Items.Add("Ranged Theme")
            tsmi_TopXMapType.Items.Add("Graduated Theme")
        Else
            tsmi_TopXMapType.Items.Add("Ranged Theme")
            tsmi_TopXMapType.Items.Add("Graduated Theme")
            tsmi_TopXMapType.Items.Add("Heatmap")
            tsmi_TopXMapType.Items.Add("Voronoi")
        End If
    End Sub

