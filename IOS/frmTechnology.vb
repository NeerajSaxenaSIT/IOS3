    Private Function MergeDataTablesToSingleTable(ds As DataSet) As DataTable
        If ds Is Nothing Then
            Throw New ArgumentNullException(NameOf(ds))
        End If

        Dim result As New DataTable("Merged")

        ' Track unique columns in order of first appearance
        Dim seen As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)
        Dim orderedColumns As New List(Of String)()

        ' Build column list
        For Each t As DataTable In ds.Tables
            For Each c As DataColumn In t.Columns
                If Not seen.Contains(c.ColumnName) Then
                    seen.Add(c.ColumnName)
                    orderedColumns.Add(c.ColumnName)
                End If
            Next
        Next

        ' Create columns as Object (safe for mixed types)
        For Each colName As String In orderedColumns
            result.Columns.Add(colName, GetType(Object))
        Next

        ' Merge rows
        For Each t As DataTable In ds.Tables
            For Each r As DataRow In t.Rows
                Dim newRow As DataRow = result.NewRow()

                For Each c As DataColumn In t.Columns
                    If result.Columns.Contains(c.ColumnName) Then
                        Dim val = r(c.ColumnName)
                        newRow(c.ColumnName) = If(val Is Nothing, DBNull.Value, val)
                    End If
                Next

                result.Rows.Add(newRow)
            Next
        Next

        Return result
    End Function

