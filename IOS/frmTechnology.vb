    Private Sub tsmi_cmTopx_Stats_Click(sender As Object, e As EventArgs) Handles tsmi_cmTopx_Stats.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        'check object using datagrid?
        Dim dgCtrl As GridControl = cmTopX.SourceControl
        Dim dgv As GridView = dgCtrl.DefaultView
        Dim tech As String = dgCtrl.Tag
        Dim targetobj As String = ""
        Dim selectedKPI As String = Nothing

        Try
            Me.xtcTechnology.SelectedTabPageIndex = 0
            If tech.ToLower = "topx_" & _strNetwork.ToLower Then
                targetobj = flpSourceBtn_GetChecked(tech, flpCounterTypeTopX)(0).SourceButtonText
            End If

            If tech.ToLower = "topx_" & _strNetwork.ToLower Then
                'set stat parameters correctly
                SetButtonsForLaunch(_strNetwork, targetobj, False)
                Dim selRows() As Integer = dgv.GetSelectedRows()
                For i As Integer = 0 To selRows.Length - 1
                    FindNodeTreeviewStats(dgv.GetRowCellValue(selRows(i), dgv.Columns(targetobj).ToString.Trim))
                Next
                'launch
                Call btnApplyStats_Click(btnApplyStats, Nothing)

                If dgv.FocusedColumn.FieldName = targetobj Then
                    selectedKPI = dgv.Columns(1).FieldName
                Else
                    selectedKPI = dgv.FocusedColumn.FieldName
                End If

                Dim tv_kpi As TreeListNode = tvKPIStats.FindNodeByFieldValue("ObjectName", selectedKPI)
                If Not tv_kpi Is Nothing Then
                    tvKPIStats.SetFocusedNode(tv_kpi.ParentNode)
                    tv_kpi.ParentNode.Expand()
                End If

            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "TopX " & Network & " " & DateDiff(DateInterval.Second, timerTopX, Now()) & "s")
    End Sub

    Public Sub SetButtonsForLaunch(tech As String, aggr_to As String, topx As Boolean)
        Try
            Dim TargetType As String = "CELL"
            If tech.Contains("TX") Then
                TargetType = "LINK"
            End If
            If tech.ToUpper = _strNetwork.ToUpper Then
                If topx = False Then
                    If aggr_to Is Nothing Then
                        aggr_to = flpSourceBtn_GetType(tech, TargetType, flpCounterTypeStats).SourceButtonText
                    End If
                    flpSourceBtn_SetChecked(tech, flpSourceBtn_GetType(tech, TargetType, flpCounterTypeStats).SourceButtonText)
                    If cmbObjectTreeStats.SelectedItem.ToString <> aggr_to Then
                        cmbObjectTreeStats.SelectedItem = cmbObjectTreeStats.Properties.Items(Cmb_ObjectTree_String2Index(cmbObjectTreeStats, aggr_to))
                    End If
                    tvObjectsTreeStats.UncheckAll()
                    xtcTechnology.SelectedTabPageIndex = 0
                Else
                    flpSourceBtn_SetChecked("topx_" & tech, aggr_to)
                    If cmbObjectTreeTopX.SelectedItem.ToString <> aggr_to Then
                        cmbObjectTreeTopX.SelectedItem = cmbObjectTreeTopX.Properties.Items(Cmb_ObjectTree_String2Index(cmbObjectTreeTopX, aggr_to))
                    End If
                    tvObjectsTreeTopX.UncheckAll()
                    xtcTechnology.SelectedTabPageIndex = 1
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

    Private Function Cmb_ObjectTree_String2Index(ByRef cmb As ComboBoxEdit, theitem As String) As Integer
        Dim i As Integer = 0
        For i = 0 To cmb.Properties.Items.Count - 1
            If cmb.Properties.Items(i).ToString.ToUpper = theitem.ToUpper Then
                Return i
            End If
        Next
        Return Nothing
    End Function

    Private Sub cm_Topx_Hide_Click(sender As Object, e As EventArgs) Handles cm_Topx_Hide.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Try
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            For Each xtp As XtraTabPage In tcTabControlHighTopX.TabPages
                Dim tbllayout As TableLayoutPanel = TryCast(xtp.Controls(0), TableLayoutPanel)
                For iCntr = 0 To tbllayout.RowCount - 1
                    Dim dgCtrl As GridControl = TryCast(tbllayout.GetControlFromPosition(1, iCntr), GridControl)
                    Dim dgv As GridView = dgCtrl.DefaultView

                    dgCtrl.SuspendLayout()
                    If dgv.Columns.Count > 0 Then
                        If dgv.Columns(0).Visible = False Then
                            For Each dcol As Columns.GridColumn In dgv.Columns
                                If dt_IOS_ObjectConfig.AsEnumerable().Where(Function(x) x.Field(Of String)("Object") = dcol.FieldName).Count > 0 Or dcol.FieldName = "OPT_ZONE" Or dcol.FieldName = "TicketURL" Then
                                    If dcol.FieldName.ToLower = "ticketnumber" Then
                                        dcol.Visible = False
                                    Else
                                        dcol.Visible = True
                                    End If
                                End If
                            Next
                            bTopXHideGridCols = False
                        Else
                            Dim obj As String = Nothing
                            Dim setstate As Boolean = False

                            If dgCtrl.Tag.ToString.ToLower = "topx_" & _strNetwork.ToLower Then
                                obj = flpSourceBtn_GetChecked("TopX" & _strNetwork, flpCounterTypeTopX)(0).SourceButtonText
                            End If

                            For Each dcol As Columns.GridColumn In dgv.Columns
                                If dcol.FieldName.ToUpper = obj Then
                                    setstate = True
                                ElseIf dt_IOS_ObjectConfig.AsEnumerable().Where(Function(x) x.Field(Of String)("Object") = dcol.FieldName).Count > 0 Or dcol.FieldName = "OPT_ZONE" Or dcol.FieldName = "TicketURL" Then
                                    dcol.Visible = setstate
                                End If
                                setstate = False
                            Next
                            bTopXHideGridCols = True
                        End If
                    End If
                    dgCtrl.ResumeLayout()
                    dgCtrl.Refresh()
                Next
            Next
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        Finally
            Me.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "TopX " & Network & " " & DateDiff(DateInterval.Second, timerTopX, Now()) & "s")
    End Sub

    Private Sub tsmi_Report_AddChart_DropDownOpening(sender As Object, e As EventArgs) Handles tsmi_Report_AddChart.DropDownOpening
        Dim dtReports As System.Data.DataTable = Nothing
        Dim dt_ReportsOfOwner As System.Data.DataTable = Nothing
        'add chart to report
        Try
            tsmi_Report_AddChart.DropDownItems.Clear()
            dicReportIDType.Clear()
            dtReports = clsSQLCommands.GetSlidesWithChartObject(connStrIOSServer)
            Dim tsmi_NewSlide As ToolStripMenuItem = Nothing

            If dtReports IsNot Nothing Then
                dt_ReportsOfOwner = dtReports.DefaultView.ToTable(True, "ReportName", "ReportID", "ReportType")
                If Not dt_ReportsOfOwner Is Nothing Then
                    For Each drow As DataRow In dt_ReportsOfOwner.Rows
                        dicReportIDType.Add(CInt(drow("ReportID")), drow("ReportType").ToString)
                        Dim tsmi_group As ToolStripMenuItem = New ToolStripMenuItem(drow("ReportName").ToString.Trim)

                        If dicReportIDType(drow("ReportID")) = "PowerPoint" Then
                            tsmi_NewSlide = New ToolStripMenuItem("Slide - Add New")
                        ElseIf dicReportIDType(drow("ReportID")) = "Excel" Then
                            tsmi_NewSlide = New ToolStripMenuItem("Worksheet - Add New")
                        End If

                        Dim tsmi_NewSlideSeparator As ToolStripSeparator = New ToolStripSeparator()
                        tsmi_NewSlide.Tag = drow("ReportID").ToString.Trim
                        tsmi_group.Tag = drow("ReportID").ToString.Trim
                        tsmi_group.DropDownItems.Add(tsmi_NewSlide)
                        tsmi_group.DropDownItems.Add(tsmi_NewSlideSeparator)
                        AddHandler tsmi_NewSlide.Click, AddressOf cmsNewSlide_Click
                        'AddHandler tsmi_group.Click, AddressOf cmsNewSlide_Click
                        Dim dtSlideAndObjects As DataTable = dtReports.AsEnumerable().Where(Function(x) x.Field(Of Integer)("ReportID") = drow("ReportID")).CopyToDataTable()
                        Dim dtSlideName As DataTable = dtSlideAndObjects.AsDataView.ToTable(True, "SlideID", "SlideName")
                        If Not dtSlideName Is Nothing Then
                            For Each drSlide As DataRow In dtSlideName.Rows
                                Dim tsmi_SlideName As ToolStripMenuItem = Nothing
                                If dicReportIDType(drow("ReportID")) = "PowerPoint" Then
                                    tsmi_SlideName = New ToolStripMenuItem(drSlide("SlideName").ToString.Trim)
                                    tsmi_SlideName.ToolTipText = "Charts in Slide: " & vbCrLf & GetObjectsName(dtSlideAndObjects, drSlide("SlideID").ToString.Trim)
                                ElseIf dicReportIDType(drow("ReportID")) = "Excel" Then
                                    tsmi_SlideName = New ToolStripMenuItem(drSlide("SlideName").ToString.Trim.Replace("Slide", "WS"))
                                    tsmi_SlideName.ToolTipText = "Charts in Worksheet: " & vbCrLf & GetObjectsName(dtSlideAndObjects, drSlide("SlideID").ToString.Trim)
                                End If

                                If tsmi_SlideName IsNot Nothing Then
                                    tsmi_SlideName.Tag = drSlide("SlideID").ToString.Trim
                                    tsmi_group.DropDownItems.Add(tsmi_SlideName)
                                    AddHandler tsmi_SlideName.Click, AddressOf cmsSlideName_Click
                                End If

                                If drSlide("SlideName").ToString.Contains(tcTabControlHighTopX.SelectedTabPage.Name) Then
                                    tsmi_NewSlide.Enabled = False
                                End If
                            Next
                        End If
                        tsmi_Report_AddChart.DropDownItems.Add(tsmi_group)
                    Next
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        Finally
            If Not dtReports Is Nothing Then
                dtReports.Dispose()
                dtReports = Nothing
            End If
        End Try
    End Sub

