    Private Sub Call_Evaluate_Time_Based()
        Try
            ReleaseMemoryOfTechnologyEvalInstance()

            t_list_number = t_list_number + 1
            timerEval = Now()

            If btnApplyEval.Text = "Abort" Then
                If t_list_eval.Count > 0 Then
                    t_list_eval.Clear()
                End If

                If cmbKPISetEval.SelectedIndex <> 0 Then
                    lblObjTreeStatusEval.Text = "Threads Aborted !"
                    lblObjTreeStatusEval.ForeColor = Color.Red
                End If

                t_lastid = -1
                btnApplyEval.Text = "Apply"
                Me.AccCtrlEval.Enabled = True
                ucProgPnlEval.StopProgress()
                Exit Sub
            Else
                btnApplyEval.Text = "Abort"
                Me.AccCtrlEval.Enabled = False
                ucProgPnlEval.StartProgress()
            End If

            'setting view in map
            If cmbObjectTreeEval.Text = "" Then
                lblObjTreeStatusEval.Text = "Choose Target Aggregation !"
                lblObjTreeStatusEval.ForeColor = Color.Red
                btnApplyEval.PerformClick()
                Exit Sub
            End If

            If cmbChartSetNameEval.Text = "" Or cmbChartSetNameEval.SelectedItem.ToString = "Select" Then
                lblObjTreeStatusEval.Text = "Choose Chart Set Name !"
                lblObjTreeStatusEval.ForeColor = Color.Red
                btnApplyEval.PerformClick()
                Exit Sub
            End If

            If cmbKPISetEval.Text = "" Or cmbKPISetEval.SelectedItem.ToString = "Select" Then
                lblObjTreeStatusEval.Text = "Choose KPI Set !"
                lblObjTreeStatusEval.ForeColor = Color.Red
                btnApplyEval.PerformClick()
                Exit Sub
            End If

            Application.DoEvents()
            Dim NumOfObjectsSelected As Integer = Count_OT

            Try
                'lblEvalObjStartDate.Text = String.Empty
                'lblEvalObjEndDate.Text = String.Empty

                gcEvalTimeBased.DataSource = Nothing
                gcEvalTimeBased.Refresh()
                'gcEvalObjectBased.DataSource = Nothing
                'gcEvalObjectBased.Refresh()
                gcEvalInfo.DataSource = Nothing
                gcEvalInfo.Refresh()
                gcEvalDrillDown.DataSource = Nothing
                gcEvalDrillDown.Refresh()
                gcEvalCompare.DataSource = Nothing
