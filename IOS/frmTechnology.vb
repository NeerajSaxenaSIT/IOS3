    Private Sub btnPrdCalcStatsApply_Click(sender As Object, e As EventArgs) Handles btnPrdCalcStatsApply.Click
        Try
            If gvPrdCalcStats.RowCount = 0 Then
                XtraMessageBox.Show("At least one period is required in the grid", "Period Calcuation", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                Exit Sub
            End If

            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            prdCalcApplied = True
            dicPrdCalcData = New Dictionary(Of String, DataTable)
            prdCalcAxisMarkerColl = New AxisMarkerCollection()
            dicPrdCalcAxisMarkers = New Dictionary(Of String, AxisMarkerCollection)
            dicPrdCalcSeriesData = New Dictionary(Of String, DataTable)
