    '        If currentValue < minValue Then minValue = currentValue
    '    Next
    '    Return minValue
    'End Function

    Private Function FindMinMaxDataTableValue(ByRef dt As DataTable) As String
        Dim icurrentValue As Integer
        'Dim imaxValList As New List(Of Integer)
        'Dim iMinVallist As New List(Of Integer)

        Dim iMax As Integer
        Dim iMin As Integer

        For Each colMyColumn As DataColumn In dt.Columns
            If colMyColumn.DataType <> GetType(DateTime) Then
                iMax = dt.Compute("MAX([" & colMyColumn.ColumnName & "])", "")
                iMin = dt.Compute("MIN([" & colMyColumn.ColumnName & "])", "")

                icurrentValue = dt.Compute("MAX([" & colMyColumn.ColumnName & "])", "")
                If icurrentValue > iMax Then iMax = icurrentValue

                icurrentValue = dt.Compute("MIN([" & colMyColumn.ColumnName & "])", "")
                If icurrentValue < iMin Then iMin = icurrentValue
            End If
        Next
        Return iMax & "^" & iMin
    End Function

