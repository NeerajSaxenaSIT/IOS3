    Private Sub TopX_Datagrid_ColumnFilterChanged(sender As Object, e As EventArgs)
        Try
            Me.Cursor = Cursors.WaitCursor
            Application.DoEvents()

            Dim view As GridView = TryCast(sender, GridView)
            Dim grdCtrl As GridControl = view.GridControl

            Dim strActiveFilter As String = view.ActiveFilterString
