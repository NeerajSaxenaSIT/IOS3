    Private Sub Process_EvaluateTime(Optional IsObjectAggregated As Boolean = True)
        Try
            Dim sql_all As New Specialized.StringCollection()
            Dim sql_crosstabobj As New List(Of String)
            Dim sql_obj As New List(Of String)
            'get list of tables

            Dim selectedObjs As String = tvObjectsTreeEval.GetChecked2String(Me._strNetwork, cmbObjectTreeEval.Text, "ObjectID", strTreeFilterEval)
            selectedObjs = selectedObjs.Replace("'", "''").Trim
            Dim filterPeriodstring As String = GetFilterPeriodEval(cmbPredefinedFilterEval, dateNavigatorEval)
            Dim filterParamString As String = ""

            If tvObjTreeFilterTempEval.Nodes.Count > 0 Then
                filterParamString = GetParamFilterStringTemplate("", "eval")
            End If

            'add param filter string with filter period string
            'filterPeriodstring = filterPeriodstring & filterParamString

            Dim sqlParam As String = Nothing
            Dim parray()() As String = {
                New String() {"@IOSTech", Chr(39) & Me._strNetwork & Chr(39)},
                New String() {"@TargetType", Chr(39) & cmbObjectTreeEval.SelectedItem.ToString & Chr(39)},
                New String() {"@KpiSetID", CInt(TryCast(cmbKPISetEval.SelectedItem, clsComboBoxItem).Value)},
                New String() {"@PeriodStart", Chr(39) & CDate(dtEditStartTimeEval.EditValue).ToString("yyyy-MM-dd") & Chr(39)},
                New String() {"@PeriodEnd", Chr(39) & CDate(dtEditEndTimeEval.EditValue).ToString("yyyy-MM-dd") & Chr(39)},
                New String() {"@EvalPeriodInterval", Chr(39) & GetEvalPeriodInterval() & Chr(39)},
                New String() {"@Objects", Chr(39) & selectedObjs & Chr(39)},
                New String() {"@FilterPeriod", Chr(39) & filterPeriodstring.Replace(Chr(39), Chr(39) & Chr(39)) & Chr(39)},
                New String() {"@ObjectFilter", Chr(39) & filterParamString.Replace(Chr(39), Chr(39) & Chr(39)) & Chr(39)}
            }
            connectionString = GetSQL(7018, parray)(0)
            sqlParam = GetSQL(7018, parray)(1)
            sql_obj.Add("KPISetTimeBased_" & CStr(cmbKPISetEval.SelectedItem.ToString))
            sql_all.Add(sqlParam)

            If cmbThresholdSetEval.SelectedIndex <> 0 Then
                sqlParam = Nothing
                parray = Nothing
                parray = {
                    New String() {"@UserName", Chr(39) & Environment.UserName & Chr(39)},
                    New String() {"@IOS_Tech", Chr(39) & Me._strNetwork & Chr(39)},
                    New String() {"@TargetType", Chr(39) & cmbObjectTreeEval.SelectedItem.ToString & Chr(39)},
                    New String() {"@KPISetID", CInt(TryCast(cmbKPISetEval.SelectedItem, clsComboBoxItem).Value)},
                    New String() {"@PeriodStart", Chr(39) & CDate(dtPrdCalcEval.Rows(0)("PeriodStart")).ToString("yyyy-MM-dd") & Chr(39)},
                    New String() {"@PeriodEnd", Chr(39) & CDate(dtPrdCalcEval.Rows(0)("PeriodEnd")).ToString("yyyy-MM-dd") & Chr(39)},
                    New String() {"@Objects", Chr(39) & selectedObjs & Chr(39)},
                    New String() {"@EvalPeriodInterval", Chr(39) & GetEvalPeriodInterval() & Chr(39)},
                    New String() {"@ThresholdSetID", CInt(TryCast(cmbThresholdSetEval.SelectedItem, clsComboBoxItem).Value)},
                    New String() {"@ThresholdIntervalOverride", 0},
                    New String() {"@PeriodEvalStart", "NULL"},
                    New String() {"@PeriodEvalEnd", "NULL"},
                    New String() {"@FilterPeriod", Chr(39) & filterPeriodstring.Replace(Chr(39), Chr(39) & Chr(39)) & Chr(39)},
                    New String() {"@ObjectFilter", Chr(39) & filterParamString.Replace(Chr(39), Chr(39) & Chr(39)) & Chr(39)}
                }
                connectionString = GetSQL(7019, parray)(0)
                sqlParam = GetSQL(7019, parray)(1)
                sql_obj.Add("ThresholdSetTimeBased_" & CStr(cmbThresholdSetEval.SelectedItem.ToString))
                sql_all.Add(sqlParam)
            End If

            If sql_all.Count = 0 Then
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "No SQL to Fire")
                btnApplyEval.PerformClick()
                Exit Sub
            End If

            Threads_Fired_Eval = 0
            dsEval = New DataSet
            ds_list_eval.Clear()
            t_list_eval.Clear()
            mm.ReleaseMemory()

            'Launching evaluate threads
            '****************************************
            For Each sql2exec As String In sql_all
                Dim eval_t As New Thread_Stats
                eval_t.connstring = connectionString
                eval_t.sql_total = sql2exec
                eval_t.ds_name = sql_obj(Threads_Fired_Eval)
                AddHandler eval_t.ThreadComplete, AddressOf Process_EvaluateTime_ThreadEnd

                Dim thread_x As New Threading.Thread(AddressOf eval_t.GetData)
                thread_x.Start()

                t_list_eval.Add(thread_x)
                Threads_Fired_Eval = Threads_Fired_Eval + 1
            Next

            lblObjTreeStatusEval.Text = "Query Started..."
            lblObjTreeStatusEval.ForeColor = Color.Black
            Application.DoEvents()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            lblObjTreeStatusEval.Text = "Failed...Try Again"
            ucProgPnlEval.StopProgress()
            lblObjTreeStatusEval.ForeColor = Color.Red
        End Try
    End Sub

    Private Sub Process_EvaluateTime_ThreadEnd(ds As System.Data.DataSet, ti As Threading.Thread)
        Try
            Dim threadcorrect As Boolean = False
            For Each tid In t_list_eval
                If tid.ManagedThreadId = ti.ManagedThreadId Then
                    threadcorrect = True
                End If
            Next
            If threadcorrect = False Then
                ds.Dispose()
                ds = Nothing
                Exit Sub
            End If
            SyncLock dsEval
                If Not ds Is Nothing Then
                    If ds.Tables.Count > 0 Then
                        ds_list_eval.Add(ds)
                    End If
                End If
            End SyncLock
            Me.BeginInvoke(Me.Call_ProcessEvaluateInvoked)
        Catch
        End Try
    End Sub

