    Private Sub GridViewParamFilters_MouseMove(sender As Object, e As MouseEventArgs) Handles gvParamFiltersStats.MouseMove, gvParamFiltersTopX.MouseMove, gvParamFiltersEval.MouseMove
        Try
            Dim gv As GridView = TryCast(sender, GridView)
            Dim gc As GridControl = gv.GridControl
            If e.Button = MouseButtons.Left Then
                Dim dr As DataRow = gv.GetFocusedDataRow()
                If dr IsNot Nothing Then
                    Dim obj() As Object = {"PositiveCorrDrag", dr}
                    gc.DoDragDrop(obj, DragDropEffects.Copy)
                End If
            Else
                Dim hitInfo = gv.CalcHitInfo(e.Location)
                If Not hitInfo.InRowCell OrElse hitInfo.Column.FieldName <> "FieldValue" Then
                    ToolTip1.Hide(gc)
                    _lastTooltipText = Nothing
                    Return
                End If

                Dim operatorValue As String =
                    Convert.ToString(gv.GetRowCellValue(hitInfo.RowHandle, "FieldOperator"))

                Dim tipText As String = Nothing

                If operatorValue = "LIKE" OrElse operatorValue = "NOT LIKE" Then
                    tipText =
                        "LIKE/NOT LIKE Operator Tip:" & vbCrLf &
                        "use % wildcard" & vbCrLf &
                        "abc%   → Starts with abc" & vbCrLf &
                        "%abc   → Ends with abc" & vbCrLf &
                        "%abc%  → Contains abc"
                End If

                ' Avoid re-showing same tooltip repeatedly
                If tipText IsNot Nothing AndAlso tipText <> _lastTooltipText Then
                    ToolTip1.Show(tipText, gc, e.Location.X + 15, e.Location.Y + 15, 5000)
                    _lastTooltipText = tipText
                End If
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
        End Try
    End Sub

