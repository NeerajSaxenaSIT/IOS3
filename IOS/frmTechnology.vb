                                                            shadeThreshold = New AxisMarker(If(showBandLabel, dr("PeriodName").ToString, ""), New Background(Color.FromArgb(120, Color.LightGreen)), CDate(dr("PeriodStart")), DateAdd(DateInterval.Month, 0, CDate(dr("PeriodEnd"))))
