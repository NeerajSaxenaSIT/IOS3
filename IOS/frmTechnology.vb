    Public Sub BindKPITreeViewStats(strNetwork As String)
        Dim tValue As Object = Nothing
        Try
            If Not _dsTreeKPIStats Is Nothing Then
                tvKPIStats.Cursor = Cursors.WaitCursor
                tValue = tvKPIStats.FocusedValue
                tvKPIStats.BeginUnboundLoad()
                Application.DoEvents()
                tvKPIStats.PupulateTreeListColumn({"ObjectID", "ParentID", "ObjectName", "ObjectType", "ChartSetName", "ImageIndex"})
                tvKPIStats.Nodes.Clear()
                Dim tlNode As TreeListNode = tvKPIStats.Nodes.Add(New Object() {strNetwork, "0", strNetwork, "EMPTY", cmbChartSetNameStats.SelectedItem.ToString, 0})
                tvKPIStats.PopulateTreeList("0", tlNode, _dsTreeKPIStats, "0")
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        Finally
            tvKPIStats.EndUnboundLoad()
            If tvKPIStats.Nodes.Count > 0 Then
                If tValue IsNot Nothing Then
                    Dim tNode() As TreeListNode = tvKPIStats.FindNodes(Function(node) node.GetDisplayText("ObjectName").ToLower = tValue.ToString.ToLower())
                    If tNode.Length > 0 Then tvKPIStats.ExpandTreeListUntilCertainNode(tNode(0))
                Else
                    tvKPIStats.SelectNode(tvKPIStats.Nodes(0))
                    tvKPIStats.SetFocusedNode(tvKPIStats.Nodes(0))
                    tvKPIStats.CollapseAll()
                    tvKPIStats.ExpandToLevel(0)
                End If
            End If
            tvKPIStats.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Private Sub tvKPITopX_AfterFocusNode(sender As Object, e As NodeEventArgs) Handles tvKPITopX.AfterFocusNode
        Try
            If e.Node.Selected = True Then
                Select Case e.Node.Level
                    Case 1
                        If e.Node.Item("ObjectName").ToLower = "custom" Then
                            tcTabControlHighTopX.SelectedTabPage = tcTabControlHighTopX.TabPages(tcTabControlHighTopX.TabPages.Count - 1)
                        Else
                            tcTabControlHighTopX.SelectedTabPage = tcTabControlHighTopX.TabPages(CLng(e.Node.Item(0)) / 1000000 - 1)
                        End If
                    Case 2
                        If e.Node.ParentNode.Item("ObjectName").ToLower = "custom" Then
                            tcTabControlHighTopX.SelectedTabPage = tcTabControlHighTopX.TabPages(tcTabControlHighTopX.TabPages.Count - 1)
                        Else
                            tcTabControlHighTopX.SelectedTabPage = tcTabControlHighTopX.TabPages(CLng(e.Node.ParentNode.Item(0)) / 1000000 - 1)
                        End If
                        tcTabControlHighTopX.SelectedTabPage.Controls(0).Controls(CInt(((CLng(e.Node.Item(0)) - CLng(e.Node.ParentNode.Item(0))) / 10000) - 1) * 2).Focus()
                    Case 3
                        If e.Node.ParentNode.ParentNode.Item("ObjectName").ToLower = "custom" Then
                            tcTabControlHighTopX.SelectedTabPage = tcTabControlHighTopX.TabPages(tcTabControlHighTopX.TabPages.Count - 1)
                        Else
                            tcTabControlHighTopX.SelectedTabPage = tcTabControlHighTopX.TabPages(CLng(e.Node.ParentNode.ParentNode.Item(0)) / 1000000 - 1)
                        End If
                        tcTabControlHighTopX.SelectedTabPage.Controls(CInt(((CLng(e.Node.ParentNode.Item(0)) - CLng(e.Node.ParentNode.ParentNode.Item(0))) / 10000) - 1) * 2).Focus()
                End Select
            End If
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

    Private Sub TreeView_KPI_AfterSelect(sender As Object, e As NodeEventArgs) Handles tvKPIStats.AfterFocusNode
        Try
            Dim tech As String = e.Node.TreeList.Tag
            If e.Node.Selected = True Then
                Select Case e.Node.Level
                    Case 1
                        Dim tc As XtraTabControl = GetTabControlFromTech(tech)
                        tc.SelectedTabPage = GetTabPage(tc, e.Node.Item("ObjectName"))
                        If tc.SelectedTabPage IsNot Nothing Then tc.SelectedTabPage.Focus()
                    Case 2
                        Dim tc As XtraTabControl = GetTabControlFromTech(tech)
                        tc.SelectedTabPage = GetTabPage(tc, e.Node.ParentNode.Item("ObjectName"))

                        Dim tc2 As XtraTabControl = CType(tc.SelectedTabPage.Controls(0), XtraTabControl)
                        tc2.SelectedTabPage = GetTabPage(tc2, e.Node.Item("ObjectName"))
                        tc2.SelectedTabPage.Focus()
                    Case 3
                        Dim tc As XtraTabControl = GetTabControlFromTech(tech)
                        tc.SelectedTabPage = GetTabPage(tc, e.Node.ParentNode.ParentNode.Item("ObjectName"))
                        If tc.SelectedTabPage IsNot Nothing Then
                            Dim tc2 As XtraTabControl = CType(tc.SelectedTabPage.Controls(0), XtraTabControl)
                            tc2.SelectedTabPage = GetTabPage(tc2, e.Node.ParentNode.Item("ObjectName"))
                            tc2.SelectedTabPage.Focus()
                            Dim tlist As TreeListNode = e.Node.ParentNode
                            Dim childList() As TreeListNode = tlist.Nodes.ToArray()
                            Dim index As Integer = Array.FindIndex(childList, Function(x) x.Item("ObjectName") = e.Node.Item("ObjectName"))
                            tc2.SelectedTabPage.Controls(0).Controls(index).Focus()
                        End If
                End Select
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
        End Try
    End Sub

