                If XtraMessageBox.Show("Are you sure to remove selected param(s) from the list?", "Remove Param(s) Filter!", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Warning) = DialogResult.Yes Then
                    Dim gv As GridView = DirectCast(sender, GridView)
