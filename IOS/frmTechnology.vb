                Dim ch As Chart = cm_Chart_Sourcecontrol
                If Not (chartDrawingPoint = Nothing) Then
                    Dim strPoint As String = chartDrawingPoint.X.ToString() + "," + chartDrawingPoint.Y.ToString()
