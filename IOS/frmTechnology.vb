    Private Sub FillFilterTemplateObjectTree(dtData As DataTable, ByRef treeList As TreeList)
        Try
            treeList.Cursor = Cursors.WaitCursor
            treeList.BeginUnboundLoad()
            Application.DoEvents()

            treeList.Columns.Clear()
            treeList.PupulateTreeListColumn({"ObjectID", "ParentID", "ObjectName", "ObjectType"})

            treeList.Nodes.Clear()
            treeList.OptionsView.AutoWidth = True

            Dim tlNode As TreeListNode = treeList.Nodes.Add(New Object() {"FILTER", "0", "FILTER", ""})
            PopulateFilterTemplateTreeList(treeList, "FILTER", tlNode, dtData)

        Catch ex As Exception
        Finally
            treeList.EndUnboundLoad()
            If treeList.Nodes.Count > 0 Then
                treeList.SelectNode(treeList.Nodes(0))
                treeList.SetFocusedNode(treeList.Nodes(0))
                treeList.CollapseAll()
                treeList.ExpandToLevel(0)
            End If
            treeList.Cursor = Cursors.Default
            Application.DoEvents()
        End Try
    End Sub

    Private Sub PopulateFilterTemplateTreeList(ByRef tl As TreeList, ParentID As String, rNode As TreeListNode, dt As DataTable)
        Dim foundRows() As DataRow = Nothing
        foundRows = dt.Select("ParentID = " & Chr(39) & ParentID & Chr(39))
        If foundRows.Length > 0 Then
            For Each row As DataRow In foundRows
                If row.Item(1).ToString <> "" Then
                    Dim parentnode As TreeListNode = tl.AppendNode(New Object() {row.Item(0), row.Item(1), row.Item(2)}, rNode)
                    If (row.Item(1).ToString.ToUpper = "ROOT") Then
                        parentnode.Tag = row.Item(2).ToString
                    ElseIf (row.Item(0).ToString <> "0") Then
                        parentnode.Tag = row.Item(0).ToString
                    Else
                        parentnode.Tag = row.Item(1).ToString & "_" & row.Item(2).ToString
                    End If
                    PopulateFilterTemplateTreeList(tl, row.Item(2), parentnode, dt)
                End If
            Next row
        End If
    End Sub

