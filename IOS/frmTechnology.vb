    Private Sub Process_EvalObject()
        Try
            Dim sql_all As New System.Collections.Specialized.StringCollection()
            Dim sql_obj As New List(Of String)

            Dim selectedObjs As String = tvObjectsTreeEval.GetChecked2String(Me._strNetwork, cmbObjectTreeEval.Text, "ObjectName", strTreeFilterEval)
            selectedObjs = selectedObjs.Replace("'", "''").Trim

            Dim ShowObjectButton As String = flpSourceBtn_GetChecked("topx", flpCounterTypeEval)(0).SourceButtonText

            Dim connectionString As String = Nothing
            Dim sqlParam As String = Nothing

            'lblEvalObjStartDate.Text = CDate(dtEditStartTimeEval.EditValue).ToString("dd-MM-yyyy")
            'lblEvalObjEndDate.Text = CDate(dtEditEndTimeEval.EditValue).ToString("dd-MM-yyyy")

            'query for object based data
            Dim parray()() As String = {
                New String() {"@IOS_Tech", Chr(39) & Me._strNetwork & Chr(39)},
                New String() {"@TargetType", Chr(39) & cmbObjectTreeEval.SelectedItem.ToString & Chr(39)},
                New String() {"@ShowObjects", Chr(39) & ShowObjectButton.Trim & Chr(39)},
                New String() {"@KPISetID", CInt(TryCast(cmbKPISetEval.SelectedItem, clsComboBoxItem).Value)},
                New String() {"@PeriodStart", Chr(39) & CDate(dtEditStartTimeEval.EditValue).ToString("yyyy-MM-dd") & Chr(39)},
                New String() {"@PeriodEnd", Chr(39) & CDate(dtEditEndTimeEval.EditValue).ToString("yyyy-MM-dd") & Chr(39)},
                New String() {"@EvalPeriodInterval", Chr(39) & GetEvalPeriodInterval() & Chr(39)},
                New String() {"@Objects", Chr(39) & selectedObjs & Chr(39)},
                New String() {"@Purpose", Chr(39) & "TopX" & Chr(39)},
                New String() {"@SelectedKPIIDs", "NULL"}
            }
            connectionString = GetSQL(7022, parray)(0)
            sqlParam = GetSQL(7022, parray)(1)
            sql_obj.Add("KPISetObjBased_" & CStr(cmbKPISetEval.SelectedItem.ToString))
            sql_all.Add(sqlParam)

            'query for threshold set data
            If cmbThresholdSetEval.SelectedIndex <> 0 Then
                sqlParam = Nothing
                parray = Nothing
                parray = {
                    New String() {"@IOS_Tech", Chr(39) & Me._strNetwork & Chr(39)},
                    New String() {"@TargetType", Chr(39) & cmbObjectTreeEval.SelectedItem.ToString & Chr(39)},
                    New String() {"@KPISetID", CInt(TryCast(cmbKPISetEval.SelectedItem, clsComboBoxItem).Value)},
                    New String() {"@PeriodStart", Chr(39) & CDate(dtEditStartTimeEval.EditValue).ToString("yyyy-MM-dd") & Chr(39)},
                    New String() {"@PeriodEnd", Chr(39) & CDate(dtEditEndTimeEval.EditValue).ToString("yyyy-MM-dd") & Chr(39)},
                    New String() {"@Objects", Chr(39) & selectedObjs & Chr(39)},
                    New String() {"@EvalPeriodInterval", Chr(39) & GetEvalPeriodInterval() & Chr(39)},
                    New String() {"@ThresholdSetID", CInt(TryCast(cmbThresholdSetEval.SelectedItem, clsComboBoxItem).Value)}
                }
                connectionString = GetSQL(7023, parray)(0)
                sqlParam = GetSQL(7023, parray)(1)
                sql_obj.Add("ThresholdSetObjBased_" & CStr(cmbThresholdSetEval.SelectedItem.ToString))
                sql_all.Add(sqlParam)
            End If

            If sql_all.Count = 0 Then
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "No SQL to Fire")
                btnApplyEval.PerformClick()
                Exit Sub
            End If

            Threads_Fired_Eval = 0
            dsEvalObj = New DataSet
            ds_list_evalobj.Clear()
            t_list_eval.Clear()
            mm.ReleaseMemory()

            'Launching evaluate threads
            '****************************************
            For Each sql2exec As String In sql_all
                Dim eval_t As New Thread_Stats
                eval_t.connstring = connectionString
                eval_t.sql_total = sql2exec
                eval_t.ds_name = sql_obj(Threads_Fired_Eval)
                AddHandler eval_t.ThreadComplete, AddressOf Process_EvalObj_ThreadEnd

                Dim thread_x As New Threading.Thread(AddressOf eval_t.GetData)
                thread_x.Start()

                t_list_eval.Add(thread_x)
                Threads_Fired_Eval = Threads_Fired_Eval + 1
            Next

            lblObjTreeStatusEval.Text = "Query Started..."
            lblObjTreeStatusEval.ForeColor = Color.Black
            Application.DoEvents()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message & " - " & ex.StackTrace)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            lblObjTreeStatusEval.Text = "Failed...Try Again"
            lblObjTreeStatusEval.ForeColor = Color.Red
        End Try
    End Sub

    Private Sub Process_EvalObj_ThreadEnd(ds As System.Data.DataSet, ti As Threading.Thread)
        Try
            Dim threadcorrect As Boolean = False
            For Each tid In t_list_eval
                If tid.ManagedThreadId = ti.ManagedThreadId Then
                    threadcorrect = True
                End If
            Next
            If threadcorrect = False Then
                ds.Dispose()
                ds = Nothing
                Exit Sub
            End If
            SyncLock dsEvalObj
                If Not ds Is Nothing Then
                    If ds.Tables.Count > 0 Then
                        ds_list_evalobj.Add(ds)
                    End If
                End If
            End SyncLock
            Me.BeginInvoke(Me.Call_ProcessEvalObjectInvoked)
        Catch
        End Try
    End Sub

    Private Sub Process_EvaluateObject_Invoked()
        Application.DoEvents()
        Try
            For Each t As Threading.Thread In t_list_eval
                If t.ThreadState = Threading.ThreadState.AbortRequested Then
                    Exit Sub
                End If
            Next t
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            lblObjTreeStatusEval.ForeColor = Color.Red
            lblObjTreeStatusEval.Text = "Threads Error..." & Threads_Fired_Eval
        End Try

        SyncLock lblObjTreeStatusEval
            Threads_Fired_Eval = Threads_Fired_Eval - 1
            If Not lblObjTreeStatusEval.Text.Contains("Abort") And Threads_Fired_Eval > -1 Then
                lblObjTreeStatusEval.Text = "Threads To Complete..." & Threads_Fired_Eval
            End If
        End SyncLock

        Try
            If Threads_Fired_Eval = 0 Then
                Threads_Fired_Eval = -99
                Application.DoEvents()
                If ds_list_evalobj.Count > 0 Then

                    For Each ds As DataSet In ds_list_evalobj
                        dsEvalObj.Tables.Add(ds.Tables(0).Copy)
                        dsEvalObj.Tables(dsEvalObj.Tables.Count - 1).TableName = ds.DataSetName
                    Next

                    dtThresholdSetForKPIObj = Nothing
                    If tsmi_ShowProbCellsOnly.Checked Then
                        ShowEvalObjectBasedProbCellsOnly()
                    Else
                        AssignDataToObjectResultsGrid(dsEvalObj)
                    End If

                    lblObjTreeStatusEval.Text = "Query Success: " & DateDiff(DateInterval.Second, timerEvalObj, Now()) & "s"
                    lblObjTreeStatusEval.ForeColor = Color.Black
                Else
                    lblObjTreeStatusEval.Text = "No Data Retrieved !"
                    lblObjTreeStatusEval.ForeColor = Color.Red
                End If
                Me.AccCtrlEval.Enabled = True
                Me.btnApplyEval.Text = "Apply"
                ucProgPnlEval.StopProgress()
                Application.DoEvents()
            End If
            mm.ReleaseMemory()
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & " - " & ex.StackTrace)
            lblObjTreeStatusEval.ForeColor = Color.Red
            lblObjTreeStatusEval.Text = "Error Merging Threads..." & Threads_Fired_Eval
            mm.ReleaseMemory()
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & "," & " Target Type: " & cmbObjectTreeEval.Text & "," & " Counter Type: " & UserTrackingStatsCounterType & " " & DateDiff(DateInterval.Second, timerEval, Now()) & "s")
    End Sub

