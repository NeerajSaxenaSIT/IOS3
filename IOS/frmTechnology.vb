    Public Sub flpSourceBtn_SetChecked(tech As String, obj As String)
        Try
            Dim flp As FlowLayoutPanel
            If tech.ToLower.Contains("topx") Then
                flp = flpCounterTypeTopX
                For Each vb As IOS.Library.IOSToggleButton In flp.Controls
                    If vb.Text = obj Then
                        vb.ToggleState = CheckState.Checked
                    ElseIf obj = "PLMN" Then
                        Exit For
                    Else
                        vb.ToggleState = CheckState.Unchecked
                    End If
                Next
            Else

                flp = flpCounterTypeStats
                For Each vb As IOS.Library.IOSToggleButton In flp.Controls
                    If vb.Text = obj Then
                        vb.ToggleState = CheckState.Checked
                        flpSourceBtn_ToggleChanges(vb, Nothing)
                        Exit For
                    End If
                Next
            End If
        Catch
        End Try
    End Sub

    Public Sub flpSourceBtn_SetChecked(tech As String, hiearchy As Integer)
        Try
            If hiearchy < 0 Then
                hiearchy = 0
            End If
            If tech.ToLower.Contains("topx") Then
                For Each vb As IOS.Library.IOSToggleButton In flpCounterTypeTopX.Controls
                    If vb.Name = CType(flpCounterTypeTopX.Controls(hiearchy), IOS.Library.IOSToggleButton).Name Then
                        vb.ToggleState = CheckState.Checked
                    Else
                        vb.ToggleState = CheckState.Unchecked
                    End If
                Next
            Else
                For Each vb As IOS.Library.IOSToggleButton In flpCounterTypeStats.Controls
                    If vb.Name = CType(flpCounterTypeTopX.Controls(hiearchy), IOS.Library.IOSToggleButton).Name Then
                        vb.ToggleState = CheckState.Checked
                        Exit For
                    End If
                Next
            End If
        Catch
        End Try
    End Sub

