    Private Sub tlvFiltersTopX_AfterLabelEdit(sender As Object, e As LidorSystems.IntegralUI.ObjectEditEventArgs) Handles tlvFiltersTopX.AfterLabelEdit
        Try
            Dim tlv As TreeListView = DirectCast(sender, TreeListView)
            If TypeOf e.[Object] Is TreeListViewSubItem Then
                Dim node As TreeListViewSubItem = DirectCast(e.[Object], TreeListViewSubItem)
                If e.Label IsNot Nothing Then
                    If node.Index = 0 Then
                        e.Cancel = True
                        XtraMessageBox.Show("Not allowed to change KPI name!", "Node Label Edit")
                    ElseIf node.Index = 1 Then
                        If Not e.Label.IndexOfAny(New Char() {">"c, "<"c, "="c}) >= 0 Then
                            ' Cancel the label edit action, inform the user, and
                            ' place the node in edit mode again.

                            e.Cancel = True
                            XtraMessageBox.Show("The valid characters are '<','>', '='", "Node Label Edit")
                            node.BeginEdit()
                        End If
                    ElseIf node.Index = 2 Then
                        If Not IsNumeric(e.Label) Then
                            e.Cancel = True
                            XtraMessageBox.Show("Invalid input, use numerics!", "Node Label Edit")
                            node.BeginEdit()
                        End If
                    End If
                End If
            End If
            tlv.ResumeUpdate()
        Catch
        End Try
    End Sub

    Private Sub tlvFiltersTopX_DragDrop(sender As Object, e As DragEventArgs) Handles tlvFiltersTopX.DragDrop
        Try
            If e.Data.GetDataPresent(GetType(clsComboBoxItem)) Then
                If (e.Effect = DragDropEffects.Copy) Or (e.Effect = DragDropEffects.Move) Then
                    Dim tlv As TreeListView = DirectCast(sender, TreeListView)

                    Dim item As Object = CType(e.Data.GetData(GetType(clsComboBoxItem)), System.Object)
                    tlv_TopX_Add(tlv, item)
                End If
            End If
        Catch ex As Exception
        End Try
    End Sub

    Private Sub tlvFiltersTopX_DragOver(sender As Object, e As DragEventArgs) Handles tlvFiltersTopX.DragOver
        Try
            Const KEY_CTRL As Integer = 8
            If Not (e.Data.GetDataPresent(GetType(clsComboBoxItem))) Then
                e.Effect = DragDropEffects.None
            ElseIf (e.KeyState And KEY_CTRL) And (e.AllowedEffect And DragDropEffects.Copy) = DragDropEffects.Copy Then
                ' Copy.
                e.Effect = DragDropEffects.Copy
            ElseIf (e.AllowedEffect And DragDropEffects.Move) = DragDropEffects.Move Then
                ' Move.
                e.Effect = DragDropEffects.Move
            End If
        Catch ex As Exception
        End Try
    End Sub

    Private Sub tlvFiltersTopX_KeyDown(sender As Object, e As KeyEventArgs) Handles tlvFiltersTopX.KeyDown
        Try
            If e.KeyCode = Keys.Delete Then
                Dim tlv As TreeListView = DirectCast(sender, TreeListView)
                Dim node As TreeListViewNode = tlv.SelectedNode
                If Not node Is Nothing Then
                    tlv.Nodes.RemoveAt(node.Index)
                End If
            End If
        Catch
        End Try
    End Sub

    Private Sub tlv_TopX_Add(ByRef tlv As TreeListView, item As clsComboBoxItem)
        Try
            tlv.LabelEdit = True
            Dim newnode As TreeListViewNode = New TreeListViewNode(item.Text)
            newnode.Tag = item.Value
            Dim si1 As TreeListViewSubItem = New TreeListViewSubItem(item.Text)
            newnode.SubItems.Add(si1)
            Dim si2 As TreeListViewSubItem = New TreeListViewSubItem("<")

            newnode.SubItems.Add(si2)
            Dim si3 As TreeListViewSubItem = New TreeListViewSubItem("100")

            newnode.SubItems.Add(si3)
            tlv.Nodes.Add(newnode)

            tlv.Columns(0).Width = 150
            tlv.ResumeUpdate()
            tlv.Refresh()
        Catch ex As Exception
        End Try
    End Sub

