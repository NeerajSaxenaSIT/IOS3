    Private Function GetResolutionStats() As String
        Dim resolution As String = Nothing
        If rdoRawStats.Checked Then
            resolution = "Raw"
        ElseIf rdoHourlyStats.Checked Then
            resolution = "Hourly"
        ElseIf rdoDailyStats.Checked Then
            resolution = "Daily"
        ElseIf rdoDailyBHStats.Checked Then
            resolution = "BH"
        ElseIf rdoWeeklyStats.Checked Then
            resolution = "Weekly"
        ElseIf rdoDailyBH2Stats.Checked Then
            resolution = "BHPS"
        ElseIf rdoMonthlyStats.Checked Then
            resolution = "Monthly"
        End If
        Return resolution
    End Function

