    Private Sub GetSqlFromChart(tech As String, chartname As String)
        Dim conn_el As Odbc.OdbcConnection = New Odbc.OdbcConnection(connStrIOSServer)
        Try
            conn_el.ConnectionTimeout = 5
            conn_el.Open()
            Dim sql_all As System.Collections.Specialized.StringCollection = New System.Collections.Specialized.StringCollection()
            Dim sql_crosstabobj As New List(Of String)

            Dim comm_Element As Odbc.OdbcCommand = New Odbc.OdbcCommand(clsSQLCommands.GetChartConfigReaderQuery(connStrIOSServer, tech, chartname), conn_el)
            Dim dr As Odbc.OdbcDataReader = comm_Element.ExecuteReader
            Dim sourcetable As String = ""
            'Dim aliastable As String = ""
            Dim joinobjects As String = ""
            While dr.Read
                sourcetable = nZ(dr.GetValue(0).ToString.Trim, "")
                joinobjects = nZ(dr.GetValue(1).ToString.Trim, "")
                sql_crosstabobj.Add(nZ(dr.GetValue(2), "").ToString.Trim)
                Select Case tech.ToLower
                    Case _strNetwork.ToLower
                        sql_all.Add(SQL_Construct(nZ(dr.GetValue(3), ""), sourcetable, chartname, nZ(dr.GetValue(2), "")))
                End Select
            End While

            Dim allsql As String = ""
            For Each sqlstr As String In sql_all
                allsql = allsql + sqlstr + vbCrLf + vbCrLf + vbCrLf
            Next
            Clipboard.SetText(allsql)
            comm_Element.Dispose()
            sql_all = Nothing
        Catch
        Finally
            conn_el.Close()
            conn_el.Dispose()
        End Try
    End Sub

    Private Sub tsmi_ChartHideTitle_Click(sender As Object, e As EventArgs) Handles tsmi_ChartHideTitle.Click
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Dim ch As Chart = cm_Chart_Sourcecontrol
        Dim tabc As XtraTabControl = Nothing
        Dim objectcharted As String = Nothing

        Try
            Dim tech As String = ch.Tag
            Select Case tech.ToLower
                Case _strNetwork.ToLower
                    objectcharted = ObjectsCharted
                    tabc = CType(tcTabControlHighStats.SelectedTabPage.Controls(0), XtraTabControl)
            End Select

            If ch.TitleBox.Label.Text <> " " Then
                objectcharted = " "
                tsmi_ChartHideTitle.Tag = "HIDE"
                tsmi_ChartHideTitle.Checked = True

                For Each tb As XtraTabPage In tabc.TabPages
                    If tb.Controls.Count > 0 Then
                        For Each nc As Chart In tb.Controls(0).Controls
                            nc.TitleBox.Label.AutoWrap = True
                            nc.TitleBox.Label.Text = objectcharted
                            nc.RefreshChart()
                        Next
                    End If
                Next
            Else
                If tsmi_ObjectAggregationOnOff.Checked = False Then

                    For Each tb As XtraTabPage In tabc.TabPages
                        If tb.Text.ToString.ToUpper = "*CLUSTER*" Then
                            For Each nc As Chart In tb.Controls(0).Controls
                                nc.TitleBox.Label.Text = "Objects: " & ObjectsCharted
                                nc.RefreshChart()
                            Next
                        Else
                            If tb.Controls.Count > 0 Then
                                For Each nc As Chart In tb.Controls(0).Controls
                                    nc.TitleBox.Label.Text = "Objects: " & nc.EmptyElementText
                                    nc.RefreshChart()
                                Next
                            End If
                        End If
                    Next

                    tsmi_ChartHideTitle.Tag = "SHOW"
                    tsmi_ChartHideTitle.Checked = False
                Else
                    Dim strAllObjs() As String = objectcharted.Split(",")
                    If strAllObjs.Count > 10 Then
                        Dim showObjs As String = ""
                        For iCntr = 0 To strAllObjs.Count - 1
                            If iCntr < 10 Then
                                showObjs += strAllObjs(iCntr) & ","
                            End If
                        Next
                        showObjs = showObjs + " . . . ."
                        objectcharted = "Objects: " & showObjs
                    End If

                    tsmi_ChartHideTitle.Tag = "SHOW"
                    tsmi_ChartHideTitle.Checked = False

                    For Each tb As XtraTabPage In tabc.TabPages
                        If tb.Controls.Count > 0 Then
                            For Each nc As Chart In tb.Controls(0).Controls
                                nc.TitleBox.Label.AutoWrap = True
                                nc.TitleBox.Label.Text = objectcharted
                                nc.RefreshChart()
                            Next
                        End If
                    Next

                End If
            End If

        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
    End Sub

