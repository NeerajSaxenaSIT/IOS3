    Private Sub Chart_Click_Process(ByRef mychart As Chart, ByRef dsStats As DataSet, ByRef dtObjectTime As DataTable, ByRef dsObjectTimeStored As DataSet, ByRef dtCompareGroupBy As DataTable, ByRef dataGrid_ChartsTech As GridControl, SuperRadioButton_HourTech As RadioButton)
        Dim SeriesList() As String = Nothing
        Dim i As Integer = 1
        ReDim Preserve SeriesList(0)
        If mychart.Type = ChartType.Scatter Then
            SeriesList(0) = mychart.XAxis.Label.Text
        Else
            SeriesList(0) = "Date"
        End If

        If (xtcPSFilterStats.SelectedTabPage.Text.ToLower = "days") Then
            If rdoDailyBHStats.Checked = True Or rdoDailyBH2Stats.Checked = True Then
                ReDim Preserve SeriesList(1)
                SeriesList(1) = "BusyHour"
                i = 2
            End If
        End If

        For Each s As Series In mychart.SeriesCollection
            If Not s.Name.StartsWith("PeriodCalc_") Then
                ReDim Preserve SeriesList(i)
                SeriesList(i) = s.Name
                i = i + 1
            End If
        Next

        If HiddenSeriesCollectionStats.ContainsKey(mychart.Name) Then
            For Each kvp As KeyValuePair(Of String, String) In HiddenSeriesCollectionStats
                ReDim Preserve SeriesList(i)
                SeriesList(i) = HiddenSeriesCollectionStats(kvp.Key)
                i = i + 1
            Next
        End If

        If mychart.Name.ToUpper.Contains("OBJECTTIME") Then
            Try
                Dim kpi As String = Replace(mychart.Name, "ObjectTime", "")

                If Not dtObjectTime Is Nothing Then
                    dtObjectTime.Dispose()
                    dtObjectTime = Nothing
                End If
                dtObjectTime = New DataTable
                dtObjectTime = dsObjectTimeStored.Tables(kpi).Copy

                'dataGrid_ChartsTech.DataSource = dtObjectTime
                IOSDevExpressGrid.PopulateDataInGrid(dataGrid_ChartsTech, dataGrid_ChartsTech.DefaultView, dtObjectTime, "ALL")
                dataGrid_ChartsTech.Refresh()

                Dim p As System.Drawing.Point = chartDrawingPoint
                Dim str1 As String = p.X.ToString() + "," + p.Y.ToString()
                Dim xval As [Object] = mychart.XAxis.GetValueAtX(str1)

                Dim minvaly As Double = DataTable_MinMax(dtObjectTime)(0)
                Dim maxvaly As Double = DataTable_MinMax(dtObjectTime)(1)

                ' Add axis markers at click positions.
                If Not (xval Is Nothing) Then
                    Dim mySC As SeriesCollection = mychart.SeriesCollection
                    Dim xvaldate As Date = CDate(xval)
                    xvaldate = DateAdd(DateInterval.Minute, xvaldate.Minute * -1, xvaldate)
                    xvaldate = DateAdd(DateInterval.Second, xvaldate.Second * -1, xvaldate)
                    Dim el As Element = getElementFromDate(xvaldate, mySC(0))

                    If Not el Is Nothing Then
                        'mychart.XAxis.Markers.Clear()
                        For Each ch As Chart In mychart.Parent.Controls
                            'ch.XAxis.Markers.Clear()
                            If ch.Name <> mychart.Name Then
                                ch.Refresh()
                            End If
                        Next
                        If SuperRadioButton_HourTech.Checked = True Then
                            For Each elm As Element In mySC(0).Elements
                                If elm.Name = xvaldate.ToString("dd/MM/yyyy HH:mm:ss") Then
                                    el = elm
                                End If
                            Next
                        End If

                        Dim chMarkerToRemove As AxisMarker = Nothing
                        For Each chMarker As AxisMarker In mychart.XAxis.Markers
                            If chMarker.Line.Color = Color.DarkSlateGray Then
                                chMarkerToRemove = chMarker
                                Exit For
                            End If
                        Next
                        If chMarkerToRemove IsNot Nothing Then
                            mychart.XAxis.Markers.Remove(chMarkerToRemove)
                        End If

                        mychart.XAxis.Markers.Add(New AxisMarker("", New Line(Color.DarkSlateGray, 4), CType(el.XDateTime, DateTime)))
                        mychart.Refresh()
                        ChartCluster2Map(CType(el.XDateTime, DateTime), mychart.Tag, minvaly, maxvaly, kpi, dtObjectTime)
                    End If
                End If
                Exit Sub
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            End Try
        ElseIf mychart.Name.ToUpper.Contains("COMPAREGROUPBY") Then
            IOSDevExpressGrid.PopulateDataInGrid(dataGrid_ChartsTech, dataGrid_ChartsTech.DefaultView, dtCompareGroupBy, "ALL")
            dataGrid_ChartsTech.Refresh()
            Exit Sub
            'ElseIf mychart.Name.ToUpper.Contains("HISTOGRAM") Then
            '    IOSDevExpressGrid.PopulateDataInGrid(gcHistogramData, gvHistogramData, dtEval_Histogram, "ALL")
            '    gcHistogramData.Refresh()
            '    Exit Sub
        ElseIf (xtcTechnology.SelectedTabPage.Text.ToUpper = "EVALUATE") AndAlso (mychart.Name.ToUpper.Contains("HISTOGRAM")) Then
            Dim tblName As String = mychart.Name.Replace("Histogram", "")
            Dim dt As DataTable = dsEval_Histogram.Tables(tblName)
            IOSDevExpressGrid.PopulateDataInGrid(gcHistogramData, gvHistogramData, dt, "ALL")
            gcHistogramData.Refresh()
            Exit Sub
        End If

        If Not mychart.Series.Data Is Nothing Then
            IOSDevExpressGrid.PopulateDataInGrid(dataGrid_ChartsTech, dataGrid_ChartsTech.DefaultView, CType(mychart.Series.Data, DataTable), "ALL")
        Else
            If chExtraLegendBoxClicked = True Then
                If dicPrdCalcData IsNot Nothing AndAlso dicPrdCalcData.ContainsKey(mychart.Name) Then
                    Dim dtTemp As DataTable = dicPrdCalcData(mychart.Name)
                    IOSDevExpressGrid.PopulateDataInGrid(dataGrid_ChartsTech, dataGrid_ChartsTech.DefaultView, dtTemp, "ALL")
                End If
            Else
                Dim dgv As DataView = Nothing
                If Not dsStats Is Nothing Then
                    dgv = GetMatchingTableViews(dsStats, SeriesList)
                    If dgv Is Nothing Then
                        For k As Integer = 0 To dsStats.Tables.Count - 1
                            If dsStats.Tables(k).Columns.Contains(SeriesList(1)) Then
                                dgv = dsStats.Tables(k).DefaultView
                                Exit For
                            End If
                        Next
                    End If
                End If

                If tsmi_ObjectAggregationOnOff.Checked = False Then
                    If dgv.Table.Columns.Contains(dgv.Table.TableName) Then
                        dgv.RowFilter = dgv.Table.TableName & "='" & mychart.Title.Split("'")(1) & "'"
                    Else
                        dgv.RowFilter = cmbObjectTreeStats.SelectedItem.ToString & "='" & mychart.Title.Split(":")(1).ToString.Replace("'", "").Trim & "'"
                    End If
                End If

                Dim dateFormat As String = Nothing
                If rdoRawStats.Checked Or SuperRadioButton_HourTech.Checked Then
                    dateFormat = "yyyy-MM-dd HH:mm:ss"
                Else
                    dateFormat = "yyyy-MM-dd HH:mm:ss"
                End If

                Try
                    IOSDevExpressGrid.PopulateDataInGrid(dataGrid_ChartsTech, dataGrid_ChartsTech.DefaultView, dgv.ToTable(True, SeriesList), "ALL",,, dateFormat)
                Catch
                End Try

                If showPrdCalcSeries = True AndAlso dicPrdCalcSeriesData IsNot Nothing Then
                    If dicPrdCalcSeriesData.ContainsKey(mychart.Name) Then
                        Dim dt As DataTable = dicPrdCalcSeriesData(mychart.Name)
                        IOSDevExpressGrid.PopulateDataInGrid(dataGrid_ChartsTech, dataGrid_ChartsTech.DefaultView, dt, "ALL",,, dateFormat)
                    End If
                End If

                If BreakKpi2CounterType = "CHART" Then
                    If dicBrkKpiCntrData IsNot Nothing AndAlso dicBrkKpiCntrData.ContainsKey(mychart.Name) Then
                        Dim dt As DataTable = dicBrkKpiCntrData(mychart.Name)
                        IOSDevExpressGrid.PopulateDataInGrid(dataGrid_ChartsTech, dataGrid_ChartsTech.DefaultView, dt, "ALL",,, dateFormat)
                    End If
                End If

                If Chart_Click_XVal.ToString("dd/MM/yyyy") <> "01/01/0001" Then
                    Dim gridRowHandle As Integer = CType(dataGrid_ChartsTech.DefaultView, GridView).LocateByValue("Date", Chart_Click_XVal)
                    CType(dataGrid_ChartsTech.DefaultView, GridView).SelectRow(gridRowHandle)
                    CType(dataGrid_ChartsTech.DefaultView, GridView).FocusedRowHandle = gridRowHandle
                End If
            End If
        End If
        dataGrid_ChartsTech.Refresh()
    End Sub

    Private Function GetMatchingTableViews(ByRef ds As DataSet, requiredColumns() As String) As DataView
        Dim matchingViews As DataView = Nothing
        For Each table As DataTable In ds.Tables
            Dim columnNames = table.Columns.Cast(Of DataColumn).Select(Function(c) c.ColumnName).ToArray()

            ' Check if all required columns exist in the table
            If requiredColumns.All(Function(col) columnNames.Contains(col)) Then
                matchingViews = table.DefaultView
            End If
        Next
        Return matchingViews
    End Function

    Private Sub Chart_MouseDown(sender As Object, e As MouseEventArgs)
        If tsmi_Chart_ZoomIn.Checked = True Then
            Dim myChart As Chart = CType(sender, Chart)
            Dim ChartAreaRect As System.Drawing.Rectangle = myChart.ChartArea.GetRectangle()
            If ChartAreaRect.Contains(e.X, e.Y) Then
                myChart.Cursor = Cursors.Cross
                Dim p As System.Drawing.Point = myChart.PointToClient(Cursor.Position)
                Dim strPoint As String = p.X.ToString() + "," + p.Y.ToString()
                Dim oney1 As Boolean = False
                Dim oney2 As Boolean = False
                Chart_Click_Yvalue1.Clear()
                Chart_Click_Xvalue.Clear()
                Chart_Click_Xvalue.Add(myChart.XAxis.GetValueAtX(strPoint))

                For Each s As Series In myChart.SeriesCollection
                    If s.YAxis.Orientation = Orientation.Left And oney1 = False Then
                        Chart_Click_Yvalue1.Add(s.YAxis.GetValueAtY(strPoint))
                        oney1 = True
                    End If
                Next
                For Each s As Series In myChart.SeriesCollection
                    If s.YAxis.Orientation = Orientation.Right And oney2 = False Then
                        Chart_Click_Yvalue1.Add(s.YAxis.GetValueAtY(strPoint))
                        oney2 = True
                    End If
                Next
                ChartZoomRect = New Rectangle(e.X, e.Y, 0, 0)
                myChart.Invalidate()
            End If
        Else
            Dim chartObj As Chart = CType(sender, Chart)
            cm_Chart_Sourcecontrol = chartObj
            If chartObj IsNot Nothing Then
                chartDrawingPoint = chartObj.PointToClient(Cursor.Position)
            End If
        End If
    End Sub

    Private Sub Chart_MouseUp(sender As Object, e As MouseEventArgs)
        If tsmi_Chart_ZoomIn.Checked = True And e.Button = MouseButtons.Left And Not ChartZoomRect.IsEmpty = True Then
            If ChartZoomRect.Width * ChartZoomRect.Height < 10 Then
                Exit Sub
            End If
            Dim myChart As Chart = CType(sender, Chart)
            ChartZoomRect = Nothing
            myChart.Invalidate()
            Dim p As System.Drawing.Point = myChart.PointToClient(Cursor.Position)
            Dim strPoint As String = p.X.ToString() + "," + p.Y.ToString()

            Dim oney1 As Boolean = False
            Dim oney2 As Boolean = False
            Dim y1 As Axis = New Axis()
            Dim y2 As Axis = New Axis()

            Chart_Click_Yvalue2.Clear()
            Chart_Click_Xvalue.Add(myChart.XAxis.GetValueAtX(strPoint))

            For Each s As Series In myChart.SeriesCollection
                If s.YAxis.Orientation = Orientation.Left And oney1 = False Then
                    Chart_Click_Yvalue2.Add(s.YAxis.GetValueAtY(strPoint))
                    oney1 = True
                    y1 = s.YAxis
                End If
            Next
            For Each s As Series In myChart.SeriesCollection
                If s.YAxis.Orientation = Orientation.Right And oney2 = False Then
                    Chart_Click_Yvalue2.Add(s.YAxis.GetValueAtY(strPoint))
                    oney2 = True
                    y2 = s.YAxis
                End If
            Next

            If Chart_Click_Yvalue1.Count = 1 Then
                y1.ScaleRange = New ScaleRange(Math.Min(Chart_Click_Yvalue1(0), Chart_Click_Yvalue2(0)), Math.Max(Chart_Click_Yvalue1(0), Chart_Click_Yvalue2(0)))
            ElseIf Chart_Click_Yvalue1.Count = 2 Then
                y1.ScaleRange = New ScaleRange(Math.Min(Chart_Click_Yvalue1(0), Chart_Click_Yvalue2(0)), Math.Max(Chart_Click_Yvalue1(0), Chart_Click_Yvalue2(0)))
                y2.ScaleRange = New ScaleRange(Math.Min(Chart_Click_Yvalue1(1), Chart_Click_Yvalue2(1)), Math.Max(Chart_Click_Yvalue1(1), Chart_Click_Yvalue2(1)))
            End If
            myChart.XAxis.ScaleRange = New ScaleRange(Chart_Click_Xvalue(0), Chart_Click_Xvalue(1))
            myChart.Cursor = Cursors.Default
        ElseIf e.Button = MouseButtons.Right Then
            Dim myChart As Chart = CType(sender, Chart)
            cm_Chart_Sourcecontrol = myChart

            Try
                Dim hitchart As HitTestInfo = myChart.HitTest(e.X, e.Y)
                If TypeOf hitchart.Object Is Element Then
                    cm_Chart_ElementClicked = CType(hitchart.Object, Element)
                    cm_Chart_SeriesClicked = hitchart.Series
                    'ElseIf TypeOf hitchart.Object Is ChartArea Then
                    '    cm_Chart_XAxisValue = CType(hitchart.Object, ChartArea).XAxis.GetValueAtX(e.X)
                    '    cm_Chart_ElementClicked = CType(hitchart.Object, ChartArea).Series.Element
                    '    cm_Chart_SeriesClicked = CType(hitchart.Object, ChartArea).Series
                End If
            Catch ex As Exception
                _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            End Try
            'If myChart.SeriesCollection.Count > 0 Then
            '    cmChart.Show(Cursor.Position)
            'End If
            If myChart IsNot Nothing Then
                chartDrawingPoint = New Point(e.X, e.Y)
            End If
            Dim hit As HitTestInfo = myChart.HitTest(e.X, e.Y)
            Dim ChartLegendRect As System.Drawing.Rectangle = myChart.LegendBox.GetRectangle()
            If ChartLegendRect.Contains(e.X, e.Y) Then
                If TypeOf hit.Object Is LegendEntry Then
                    chartLegendEntryName = CType(hit.Object, LegendEntry).Name
                    cmChartLegendBox.Show(Cursor.Position)
                End If
            Else
                If myChart.SeriesCollection.Count > 0 Then
                    cmChart.Show(Cursor.Position)
                End If
            End If
        End If
    End Sub

