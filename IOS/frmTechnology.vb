                        If chart_SeriesAutoScale(i) = False Then
                            yaxis2.Minimum = 0
                        End If
                    End If

                    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                    j = 0

                    For Each col As DataColumn In dt.Columns
                        ReDim Preserve chart_elements(j)
                        If col.ColumnName.ToUpper <> "KPINAME" Then
