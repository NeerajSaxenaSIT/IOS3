                            RemoveHandler ch.MouseUp, AddressOf Chart_TopX_MouseUp
                            RemoveHandler ch.MouseWheel, AddressOf Chart_TopX_OnMouseWheel
                            'RemoveHandler ch.MouseDown, AddressOf Chart_TopX_MouseDown
                            'RemoveHandler ch.MouseMove, AddressOf Chart_TopX_MouseMove

                            If Not ch.ContextMenuStrip Is Nothing Then
                                ch.ContextMenuStrip.Dispose()
                            End If
                            ch.ContextMenuStrip = Nothing
                            ch.SeriesCollection.Clear()
                            ch.Dispose()
                            ch = Nothing
                        End If
                    Next
