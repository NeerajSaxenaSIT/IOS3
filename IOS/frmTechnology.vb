    Private Sub ToolTipCtrlEval_GetActiveObjectInfo(sender As Object, e As DevExpress.Utils.ToolTipControllerGetActiveObjectInfoEventArgs) Handles ToolTipCtrlEval.GetActiveObjectInfo
        Try
            If e.Info Is Nothing AndAlso e.SelectedControl Is gcEvalTimeBased Then
                Dim view As GridView = TryCast(gcEvalTimeBased.FocusedView, GridView)
                Dim info As GridHitInfo = view.CalcHitInfo(e.ControlMousePosition)
                If info.InRowCell Then

                    Dim cellInfo As String = Nothing
                    Dim cellKey As String = info.RowHandle.ToString() & " - " & info.Column.ToString()

                    If Not dtThresholdSetForKPI Is Nothing Then
                        Dim drThreshold As DataRow = Nothing
                        Dim clrTrans As Integer = 120
                        Dim colsNoColoring() As String = {"CategoryField", "Tech", "SQLKPIID", "KPIName", "Category"}

                        Dim kpiSqlID As Integer = IIf(IsDBNull(gvEvalTimeBased.GetRowCellValue(info.RowHandle, "SQLKPIID")), 0, gvEvalTimeBased.GetRowCellValue(info.RowHandle, "SQLKPIID"))
                        If kpiSqlID <> 0 Then
                            drThreshold = gvThresholdData.GetDataRow(gvThresholdData.LocateByValue("SQLKPIID", kpiSqlID))
                        End If

                        'for vendor kpi(s)
                        Dim kpiName As String = Nothing
                        Dim commonKpiName As String = Nothing
                        If drThreshold Is Nothing Then
                            If gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString.ToUpper.Contains("ERICSSON") Then
                                kpiName = gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString
                                commonKpiName = kpiName.Substring(0, kpiName.IndexOf("_ERICSSON"))
                                drThreshold = gvThresholdData.GetDataRow(gvThresholdData.LocateByValue("KPIName", commonKpiName))
                            ElseIf gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString.ToUpper.Contains("HUAWEI") Then
                                kpiName = gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString
                                commonKpiName = kpiName.Substring(0, kpiName.IndexOf("_HUAWEI"))
                                drThreshold = gvThresholdData.GetDataRow(gvThresholdData.LocateByValue("KPIName", commonKpiName))
                            ElseIf gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString.ToUpper.Contains("NOKIA") Then
                                kpiName = gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString
                                commonKpiName = kpiName.Substring(0, kpiName.IndexOf("_NOKIA"))
                                drThreshold = gvThresholdData.GetDataRow(gvThresholdData.LocateByValue("KPIName", commonKpiName))
                            ElseIf gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString.ToUpper.Contains("ZTE") Then
                                kpiName = gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString
                                commonKpiName = kpiName.Substring(0, kpiName.IndexOf("_ZTE"))
                                drThreshold = gvThresholdData.GetDataRow(gvThresholdData.LocateByValue("KPIName", commonKpiName))
                            Else
                                kpiName = gvEvalTimeBased.GetRowCellValue(info.RowHandle, "KPIName").ToString
                                drThreshold = CType(gcThresholdData.DataSource, DataTable).AsEnumerable().Where(Function(x) x.Field(Of String)("KPIName").Contains(kpiName))(0)
                            End If
                        End If

                        Dim stdCalc As Double = Nothing

                        If Not drThreshold Is Nothing Then
                            If Not IsDBNull(view.GetRowCellDisplayText(info.RowHandle, info.Column)) Then
                                If Not colsNoColoring.Contains(info.Column.FieldName) Then
                                    If Not IsDBNull(drThreshold("Operator")) Then
                                        If drThreshold("Operator") = "<" Or drThreshold("Operator") = "<=" Then
                                            stdCalc = (CDbl(drThreshold("ThresholdKPIValue")) - CDbl(view.GetRowCellDisplayText(info.RowHandle, info.Column))) / CDbl(drThreshold("ThresholdStd"))
                                        ElseIf drThreshold("Operator") = ">" Or drThreshold("Operator") = ">=" Then
                                            stdCalc = (CDbl(view.GetRowCellDisplayText(info.RowHandle, info.Column)) - CDbl(drThreshold("ThresholdKPIValue"))) / CDbl(drThreshold("ThresholdStd"))
                                        End If

                                        cellInfo = "KPI Value: " & view.GetRowCellDisplayText(info.RowHandle, info.Column) & vbCrLf &
                                                   "Threshold KPI Value: " & drThreshold("ThresholdKPIValue").ToString & vbCrLf &
                                                   "Threshold Std: " & drThreshold("ThresholdStd").ToString & vbCrLf &
                                                   "Amount Of Std Deviation: " & Math.Round(stdCalc, 1)
                                        e.Info = New DevExpress.Utils.ToolTipControlInfo(cellKey, cellInfo)
                                    End If
                                End If
                            End If
                        End If
                    End If

                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

