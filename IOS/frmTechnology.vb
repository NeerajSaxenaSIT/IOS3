    Private Sub Process_Stats_Counters(ByRef ch As Chart)
        Try
            Dim connstring As String = Nothing
            'Constructing STATS SQL
            '***********************
            Dim aggr_from As String = ""
            Dim supportcode As Integer = 0
            Dim sql_all As System.Collections.Specialized.StringCollection = New System.Collections.Specialized.StringCollection()
            Dim sql_crosstabobj As New List(Of String)
            Dim sql_obj As New List(Of String)
            Dim sql_tables As String
            'get list of tables

            'get KPI sql
            Dim conn_el As Odbc.OdbcConnection = New Odbc.OdbcConnection(connStrIOSServer)
            conn_el.ConnectionTimeout = 5
            conn_el.Open()
            Dim sourcetable As String = ""
            Dim aliastable As String = ""
            Dim joinobjects As String = ""
            sql_tables = "Select Distinct COALESCE(TableName,'') AS TableName, COALESCE(TableAlias,'') AS TableAlias, COALESCE(ObjectTab,'') AS ObjectTab, COALESCE(CrossTabObj,'') AS CrossTabObj from [qry_KPItoCounters] where chartname = '" & ch.Name & "'  and techtab = " & Chr(39) & ch.Tag & Chr(39)

            Dim comm_Element As Odbc.OdbcCommand = New Odbc.OdbcCommand(sql_tables, conn_el)
            Dim dr As Odbc.OdbcDataReader = comm_Element.ExecuteReader

            While dr.Read
                sourcetable = nZ(dr.GetValue(0).ToString.Trim, "")
                sql_crosstabobj.Add(nZ(dr.GetValue(3), "").ToString.Trim)
                sql_obj.Add(nZ(dr.GetValue(2).ToString.Trim, ""))
                sql_all.Add(SQL_Construct_Counters(nZ(dr.GetValue(2).ToString.Trim, ""), sourcetable, ch.Name, nZ(dr.GetValue(3), "").ToString.Trim, ch.Tag))
            End While

            conn_el.Close()
            conn_el.Dispose()
            conn_el = Nothing
            'loop through all tables

            If sql_all.Count = 0 Then
                SetToTech_StatusLabel(ch.Tag, "Failed...No SQL", Color.Red)
                SetToTech_QueryStart(ch.Tag, 0)
                Exit Sub
            End If

            connstring = connectionString
            '  Notes_Get(strNetwork3G_1)

            Threads_Counters_Fired = 0
            dsStatsCounters = New DataSet
            dsStatsCounters.DataSetName = ch.Tag

            ds_list_Counters.Clear()
            t_list_Counters.Clear()

            'Launching counter stats threads
            '*****************************
            For Each sql_to_fire As String In sql_all
                Dim stats_Counters_t As New Thread_Stats
                stats_Counters_t.connstring = connstring
                stats_Counters_t.sql_total = sql_to_fire
                stats_Counters_t.ds_name = sql_obj(Threads_Counters_Fired) & "/" & sql_crosstabobj(Threads_Counters_Fired) & "/"
                AddHandler stats_Counters_t.ThreadComplete, AddressOf Process_Stats_Counters_ThreadEnd

                Dim thread_x = New Threading.Thread(AddressOf stats_Counters_t.GetData)
                thread_x.Start()
                t_list_Counters.Add(thread_x)
                Threads_Counters_Fired = Threads_Counters_Fired + 1
            Next

            SetToTech_StatusLabel(ch.Tag, "Query Started...", Color.Black)
        Catch ex As Exception
            SetToTech_StatusLabel(ch.Tag, "Failed...Try Again", Color.Black)
        End Try
    End Sub

