                    Next

                    For Each distinctTarget As DataRow In distinctDT.Rows

                        Dim deHisto As DataEngine = New DataEngine(dt.AsEnumerable().Where(Function(x) x.Field(Of String)(cmbObjectTreeStats.Text) = distinctTarget(cmbObjectTreeStats.Text)).CopyToDataTable())
                        deHisto.DataFields = String2DataFields({"SampleCount", "SamplePercentage"}, "BucketValue")

                        Dim scHisto As New SeriesCollection
                        scHisto = deHisto.GetSeries()

                        Dim xmIsPresent As Boolean = False
                        'check if axismarker is present for series
                        For Each xm As AxisMarker In ch.XAxis.Markers
                            If distinctTarget(cmbObjectTreeStats.Text).Contains(CDate(xm.Value).ToString("yyyyMMdd HHmm")) And tsmi_Chart_LaunchHistogramAggOrNoAgg.Checked = True Then
                                cl = xm.Line.Color
                                xmIsPresent = True
                            End If
                        Next

                        If xmIsPresent = False Then
                            cl = Color.FromArgb(255, rnd.Next(255), rnd.Next(255), rnd.Next(255))
                        End If

                        scHisto(0).Type = SeriesType.Bar
                        scHisto(0).YAxis = yaxis1pdf
                        scHisto(0).Name = distinctTarget(cmbObjectTreeStats.Text) + "-" + scHisto(0).Name
                        scHisto(0).DefaultElement.Color = cl

                        ch.ExtraChartAreas.Item(0).SeriesCollection.Add(scHisto(0))

                        scHisto(1).YAxis = yaxis2pdf
                        scHisto(1).Type = SeriesType.Line
                        scHisto(1).Line.Width = 3
                        scHisto(1).YAxis = yaxis2pdf
                        scHisto(1).DefaultElement.Color = Color.FromArgb(255, Math.Max(cl.R - 50, 0), Math.Max(cl.G - 50, 0), Math.Max(cl.B - 50, 0))
                        scHisto(1).EmptyElement.Mode = EmptyElementMode.Ignore
                        scHisto(1).Name = distinctTarget(cmbObjectTreeStats.Text) + "-" + scHisto(1).Name
                        ch.ExtraChartAreas.Item(0).SeriesCollection.Add(scHisto(1))


                        'Dim xValue As Object = scHisto(1).GetInterpolatedXValue(CDbl(10))

                        'If Not xValue Is Nothing Then
                        '    Dim s2 As Series = New Series()
                        '    Dim el As Element = New Element()
                        '    el.XValue = Math.Round(xValue, 2)
                        '    el.YValue = CDbl(10)

                        '    el.Marker.Color = Color.Red
                        '    s2.Elements.Add(el)
                        '    s2.YAxis = yaxis2pdf
                        '    ch.ExtraChartAreas.Item(0).SeriesCollection.Add(s2)
                        '    Dim an As Annotation = New Annotation()
                        '    an.Padding = 6
                        '    an.Label.Text = "<%YValue>" + "%: " + "<%XValue>"
                        '    'an.HeaderLabel.Text = "<%XValue,d>"
                        '    'an.HeaderLabel.Color = Color.White
                        '    'an.HeaderLabel.Font = New Font("arial", 8, FontStyle.Bold)
                        '    an.HeaderBackground.ShadingEffectMode = ShadingEffectMode.Two
                        '    an.HeaderBackground.Color = Color.Red
                        '    an.Background.Color = Color.White
                        '    ' an.Orientation = dotnetCHARTING.Orientation.
                        '    el.Annotation = an
                        '    'xval = el.XDateTime
                        'End If

                        'axis markers in case of dateselection
                        If tsmi_Chart_LaunchHistogramPeriodSelection.Checked = True And xmIsPresent = False Then

                            Dim am4 As New AxisMarker("", New Line(cl, 4), cm_Chart_MapKPI_Date)
                            am4.LegendEntry.Visible = False
                            am4.BringToFront = True
                            ch.XAxis.Markers.Add(am4)

                        End If
                    Next

                    ch.SeriesCollection.Clear()
                    ch.SeriesCollection.Add(sc)

                    'Try
                    '    Dim dataDistribution As Series = StatisticalEngine.DataDistribution(sc(0))
                    '    dataDistribution.YAxis = yaxis1
                    '    ch.ExtraChartAreas.Item(0).SeriesCollection.Add(dataDistribution)
                    'Catch ex As Exception
                    'End Try

                    HideChartScaleIfNoDataStats(ch, dt_new)

                    sc = Nothing
                    de = Nothing


                    ch.RefreshChart()
                    ch.Visible = True
                    Dim tn As TreeNode = New TreeNode()
                    tn.Text = charttitle
                    tn.Tag = ch.Name

                    ReDim chart_elements(0)
                    ReDim chart_elementsYAxis(0)
                    ReDim chart_Eltype(0)
                    ReDim chart_ElColor(0)
                    ReDim chart_YaxisScale(1)
                    ReDim chart_ElLineSize(0)

                    j = 0

                    Dim tp As DevExpress.XtraTab.XtraTabPage = CType(ch.Parent.Parent, DevExpress.XtraTab.XtraTabPage)
                    CType(tp.Parent, DevExpress.XtraTab.XtraTabControl).SelectedTabPage = tp
                    tp.Controls(0).Controls(ch.Name).Focus()
                End If
                Charts_ResizeWidth()

            Catch ex As Exception
                UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message & "-" & ex.StackTrace)
            End Try
        Next
        dt_chart.Dispose()
        ds_chart.Dispose()
        dt_chart = Nothing
        ds_chart = Nothing
        If Not dt Is Nothing Then
