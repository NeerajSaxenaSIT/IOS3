                                Exit Select
                        End Select

                        sc(i).DefaultElement.Color = chartSeriesClr(sc(i).Name)
                        sc(i).DefaultElement.Marker.Type = i + 1

                    Next

                    'Configure histogram chart area

                    'add computed column to dt for CDF

