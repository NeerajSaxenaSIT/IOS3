    Public Sub SetChartScaleAuto(ByRef chObject As dotnetCHARTING.WinForms.Chart, isAuto As Boolean)
        If (chartAxisScaleAdjust.Count > 0) Then
            If (chartAxisScaleAdjust.ContainsKey(chObject.TitleBox.HeaderLabel.Text.ToUpper)) Then
                chartAxisScaleAdjust(chObject.TitleBox.HeaderLabel.Text.ToUpper) = isAuto
            Else
                chartAxisScaleAdjust.Add(chObject.TitleBox.HeaderLabel.Text.ToUpper, isAuto)
            End If
        Else
            chartAxisScaleAdjust.Add(chObject.TitleBox.HeaderLabel.Text.ToUpper, isAuto)
        End If
    End Sub

    Public Function GetChartScaleOrgValues(ByRef chObject As dotnetCHARTING.WinForms.Chart) As String
        Dim chartScaleOrgVal As String = ""
        If (chartAxisOrgScaleVal.Count > 0) Then
            If (chartAxisOrgScaleVal.ContainsKey(chObject.TitleBox.HeaderLabel.Text.ToUpper)) Then
                For Each chName As KeyValuePair(Of String, String) In chartAxisOrgScaleVal
                    If (chName.Key.ToUpper = chObject.TitleBox.HeaderLabel.Text.ToUpper) Then
                        chartScaleOrgVal = chName.Value
                    End If
                Next
            End If
        End If
        Return chartScaleOrgVal
    End Function

    Public Sub SetChartScaleOrgValues(ByRef chObject As dotnetCHARTING.WinForms.Chart, ScaleValues As String)
        If (chartAxisOrgScaleVal.Count > 0) Then
            If (chartAxisOrgScaleVal.ContainsKey(chObject.TitleBox.HeaderLabel.Text.ToUpper) = False) Then
                chartAxisOrgScaleVal.Add(chObject.TitleBox.HeaderLabel.Text.ToUpper, ScaleValues)
            End If
        Else
            chartAxisOrgScaleVal.Add(chObject.TitleBox.HeaderLabel.Text.ToUpper, ScaleValues)
        End If
    End Sub

    Public Sub InitializeComponents()
        clsIOSImageList.GetKPIImages(imgListKPI)
        clsIOSImageList.SetImages(imgListObject, _baseTechnology)

        SourceObjectButtonConfiguration()
        IOS_ObjectConfig_Changes(_strNetwork)
        btnChangesUnHideStats.Text = "Hide"

        LoadCustomPeriodSelectionForUser()

        '============= TopX ================
        tvObjectsTreeTopX.SelectImageList = imgListObject
        tvObjectsTreeTopX.Tag = "TopX_" & _strNetwork
        tvKPITopX.SelectImageList = imgListKPI
        tvKPITopX.Tag = "TopX_" & _strNetwork

        txtSelectXTopX.Text = 20
        If ObjectTypesTopX.Tables(0).AsEnumerable().Where(Function(x) x.Field(Of String)("tech").ToUpper = _strNetwork.ToUpper).Count > 0 Then
            deStartTimeTopX.EditValue = DateSerial(Now().Year, Now().Month, Now.Day - 60)
            deEndTimeTopX.EditValue = DateSerial(Now().Year, Now().Month, Now.Day - 1)
            dateNavigatorTopX.EditValue = DateSerial(Now().Year, Now().Month, Now.Day - 1)
            ccPSDeltaTopX.EditValue = DateSerial(Now().Year, Now().Month, Now.Day - 1)
            BindComboWithObjectTree(ObjectTypesTopX.Tables(0), cmbObjectTreeTopX, _strNetwork)
            ''BindComboWithCounterTypeTopX(cmbCounterType, _strNetwork)
            BindKPITreeViewTopX(_strNetwork)
            rdoDailyTopX.Checked = True
        End If

        FiltersInitialize()
        SetCustomPeriodSelectionTopX("daily")

        '============= Stats ================
        tvObjectsTreeStats.SelectImageList = imgListObject
        tvObjectsTreeStats.Tag = _strNetwork
        tvKPIStats.SelectImageList = imgListKPI
        tvKPIStats.Tag = _strNetwork

        If ObjectTypesStats.Tables(0).AsEnumerable().Where(Function(x) x.Field(Of String)("tech").ToUpper = _strNetwork.ToUpper).Count > 0 Then
            dtEditStartTimeStats.EditValue = DateSerial(Now().Year, Now().Month, Now.Day - 60)
            dtEditEndTimeStats.EditValue = DateTime.Now()
            dateNavigatorStats.EditValue = DateTime.Now()
            BindComboWithObjectTree(ObjectTypesStats.Tables(0), cmbObjectTreeStats, _strNetwork)
            BindKPITreeViewStats(_strNetwork)
            rdoDailyStats.Checked = True
        End If

        'Select KPIs for toggled counter type only
        For Each tblBtn As IOS.Library.IOSToggleButton In flpCounterTypeStats.Controls
            If tblBtn.ToggleState = CheckState.Checked Then
                flpSourceBtn_ToggleChanges(tblBtn, Nothing)
            End If
        Next
        SetCustomPeriodSelectionStats("daily")
