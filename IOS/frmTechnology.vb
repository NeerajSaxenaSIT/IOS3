    Private Sub cmsSlideName_Click(sender As System.Object, e As System.EventArgs)
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Try
            Dim tsmiSlide As ToolStripMenuItem = CType(sender, ToolStripMenuItem)
            Dim slideId As Integer = Convert.ToInt32(tsmiSlide.Tag)
            Dim ch As Chart = CType(cm_Chart_Sourcecontrol, Chart)
            Dim objectNameGUI As String = Nothing
            Dim objectName As String = Nothing
            Dim resolution As String = Nothing
            Dim chartObjects As String = Nothing
            Dim predefinedTime As String = Nothing
            Dim manualStartTime As Date = Nothing
            Dim manualEndTime As Date = Nothing
            Dim counterType As String = Nothing
            Dim aggrTo As String = Nothing
            Dim tagID As String = Nothing
            Dim tags_Filter As String = Nothing
            Dim topXShowObjects As String = Nothing
            Dim targetType As String = Nothing
            Dim topXRowCount As Integer = Nothing
            Dim topXDeltaInterval As String = Nothing
            Dim reportType As String = dicReportIDType(CInt(tsmiSlide.OwnerItem.Tag))
            Dim objStyleID As Integer = IIf(reportType = "PowerPoint", 1, clsSQLCommands.GetObjectStyleIDForExcelReport(connStrIOSServer))

            If ch.TitleBox.Label.Text <> "" And Not ch.TitleBox.Label.Text.Contains("Objects") And ch.TitleBox.Label.Text <> " " Then
                objectNameGUI = ch.TitleBox.Label.Text.Replace("'", "''")
            Else
                objectNameGUI = ch.TitleBox.HeaderLabel.Text.Replace("'", "''")
            End If
            objectName = ch.Name
            ObjectsCharted = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "ObjectName", strTreeFilter).Substring(4).TrimEnd(")")

            If ch.Tag.ToString.Contains("TopX") Then
                aggrTo = cmbObjectTreeTopX.Text
                'tags_Filter = tvObjectsTreeTopX.GetChecked2String("TopX_" & _strNetwork, aggrTo, "ObjectID")
                If aggrTo = "TAGS" Then
                    For Each tln As TreeListNode In tvObjectsTreeTopX.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()
                        ObjectsCharted = ObjectsCharted + tln.Item(2) + ","
                        tagID = tagID + tln.Item(0) + ","
                    Next
                    tagID = "IN(" + tagID.TrimEnd(",") + ")"

                    aggrTo = "TAGS_" + tvObjectsTreeTopX.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()(0).Item(3)
                    If aggrTo.Contains("CM") Then
                        tags_Filter = tvObjectsTreeTopX.GetChecked2String("topx_" & _strNetwork, cmbObjectTreeTopX.Text, "TAGS_CM")
                    End If
                    If aggrTo.Contains("Region") Then
                        tags_Filter = tvObjectsTreeTopX.GetChecked2String(_strNetwork, "TAGS_Region", "ObjectName")
                    End If

                    chartObjects = chartObjects.Replace("'", "''")
                Else
                    chartObjects = tvObjectsTreeTopX.GetChecked2String("TopX_" & _strNetwork, cmbObjectTreeTopX.Text, "ObjectID")
                    chartObjects = chartObjects.Replace("IN (", "").Replace(")", "")
                    chartObjects = "'" & chartObjects.Replace("','", "'',''") & "'"
                End If

                resolution = GetResolutionTopx()
                predefinedTime = cmbPredefTimeTopX.SelectedItem.ToString
                manualStartTime = deStartTimeTopX.EditValue
                manualEndTime = deEndTimeTopX.EditValue
                topXShowObjects = flpSourceBtn_GetChecked("topx_" & _strNetwork, flpCounterTypeTopX)(0).SourceButtonText
                targetType = cmbObjectTreeTopX.SelectedItem.ToString
                topXRowCount = txtSelectXTopX.Text.Trim
                topXDeltaInterval = txtDeltaIntervalTopX.Text.Trim
                Me.reportChartPurpose = "TopX"
            Else
                aggrTo = cmbObjectTreeStats.Text
                If aggrTo = "TAGS" Then
                    For Each tln As TreeListNode In tvObjectsTreeStats.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()
                        ObjectsCharted = ObjectsCharted + tln.Item(2) + ","
                        tagID = tagID + tln.Item(0) + ","
                    Next
                    tagID = "IN(" + tagID.TrimEnd(",") + ")"
                    ObjectsCharted = ObjectsCharted.TrimEnd(",")

                    aggrTo = "TAGS_" + tvObjectsTreeStats.GetAllCheckedNodes().Where(Function(nd) nd.Level = 2).ToList()(0).Item(3)
                    If aggrTo.Contains("CM") Then
                        tags_Filter = tvObjectsTreeStats.GetChecked2String(_strNetwork, cmbObjectTreeStats.Text, "TAGS_CM", strTreeFilter)
                    End If
                    If aggrTo.Contains("Region") Then
                        tags_Filter = tvObjectsTreeStats.GetChecked2String(_strNetwork, "TAGS_Region", "ObjectName", strTreeFilter)
                    End If

                    chartObjects = ObjectsCharted.Replace("'", "''")
                Else
                    chartObjects = "'" & ObjectsCharted.Replace("','", "'',''") & "'"
                End If

                resolution = GetResolutionStats()
                predefinedTime = cmbPredefTimeStats.SelectedItem.ToString
                manualStartTime = dtEditStartTimeStats.EditValue
                manualEndTime = dtEditEndTimeStats.EditValue
                counterType = tcTabControlHighStats.SelectedTabPage.Text
                targetType = cmbObjectTreeStats.SelectedItem.ToString
                If Me.reportChartPurpose <> "ObjectTime" Then
                    Me.reportChartPurpose = "Charts"
                End If
            End If

            If ch.SeriesCollection.Count > 0 Then
                frmReportEdit.ObjectAddToSlide(slideId, objectName, objStyleID, ch.Annotations(0).Label.Text, objectNameGUI, targetType, predefinedTime, manualStartTime, manualEndTime, resolution, chartObjects, topXShowObjects,
                                               topXDeltaInterval, counterType, aggrTo, tagID, tags_Filter, Me.reportChartPurpose, topXRowCount, reportType)
                frmReportEdit.RefreshReportData()
                frmReportEdit.BindReport_Treelist()
                frmReportEdit.ExpandTree(objectNameGUI, tsmiSlide.Tag)
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
