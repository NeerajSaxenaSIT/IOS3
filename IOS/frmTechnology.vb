            Dim userName As String = Environment.UserName.ToString
            Dim resolution As String = GetResolutionStats()
            Dim deltaResolution As Long = Nothing
            If resolution.ToLower = "hourly" Or resolution.ToLower = "raw" Then
                deltaResolution = DateDiff(DateInterval.Hour, CDate(dtEditStartTimeStats.EditValue), CDate(dtEditEndTimeStats.EditValue))
            ElseIf resolution.ToLower = "daily" Or resolution.ToLower = "bh" Or resolution.ToLower = "bhps" Then
                deltaResolution = DateDiff(DateInterval.Day, CDate(dtEditStartTimeStats.EditValue), CDate(dtEditEndTimeStats.EditValue))
            ElseIf resolution.ToLower = "weekly" Then
                deltaResolution = DateDiff(DateInterval.Weekday, CDate(dtEditStartTimeStats.EditValue), CDate(dtEditEndTimeStats.EditValue))
            ElseIf resolution.ToLower = "monthly" Then
                deltaResolution = DateDiff(DateInterval.Month, CDate(dtEditStartTimeStats.EditValue), CDate(dtEditEndTimeStats.EditValue))
            End If

            Dim sqlParam As String = Nothing
            Dim connString As String = Nothing

            Dim parray()() As String = {
                New String() {"@UserName", Chr(39) & userName & Chr(39)},
                New String() {"@SettingType", Chr(39) & "STATS" & Chr(39)},
                New String() {"@PSResolution", Chr(39) & resolution & Chr(39)},
                New String() {"@DeltaResolution", deltaResolution}
            }

            sqlParam = GetSQL(8820, parray)(1)
            connString = GetSQL(8820, parray)(0)
            DataAccessorODBC.ExecuteNonQuery(connString, sqlParam,, iQryTimeOut)
            LoadCustomPeriodSelectionForUser()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
    End Sub

    Private Sub SetCustomPeriodSelectionStats(resolution As String)
        Try
            If dtCustPerodSelection IsNot Nothing Then
                If dtCustPerodSelection.Rows.Count > 0 Then

                    Dim drPS As DataRow = dtCustPerodSelection.AsEnumerable().Where(Function(x) x.Field(Of String)("SettingType") = "STATS" AndAlso x.Field(Of String)("PSResolution").ToLower = resolution.ToLower)(0)

                    If drPS IsNot Nothing Then
                        If drPS("PSResolution").ToString.ToLower = "hourly" Or drPS("PSResolution").ToString.ToLower = "raw" Then

                            dtEditEndTimeStats.EditValue = New DateTime(Now().Year, Now().Month, Now.Day, Now().Hour + 1, 0, 0)
                            dtEditStartTimeStats.EditValue = DateAdd(DateInterval.Hour, -CInt(drPS("DeltaResolution")), dtEditEndTimeStats.EditValue)

                            dtEditStartTimeStats.Properties.DisplayFormat.FormatString = "dd/MM/yyyy HH:mm"
                            dtEditStartTimeStats.Properties.EditFormat.FormatString = "dd/MM/yyyy HH:mm"
                            dtEditStartTimeStats.Properties.EditMask = "dd/MM/yyyy HH:mm"

                            dtEditEndTimeStats.Properties.DisplayFormat.FormatString = "dd/MM/yyyy HH:mm"
                            dtEditEndTimeStats.Properties.EditFormat.FormatString = "dd/MM/yyyy HH:mm"
                            dtEditEndTimeStats.Properties.EditMask = "dd/MM/yyyy HH:mm"

                            cmbPredefTimeStats.SelectedIndex = 0

                        ElseIf drPS("PSResolution").ToString.ToLower = "daily" Or drPS("PSResolution").ToString.ToLower = "bh" Or drPS("PSResolution").ToString.ToLower = "bhps" Or
                               drPS("PSResolution").ToString.ToLower = "weekly" Or drPS("PSResolution").ToString.ToLower = "monthly" Then

                            dtEditStartTimeStats.Properties.DisplayFormat.FormatString = "dd/MM/yyyy"
                            dtEditStartTimeStats.Properties.EditFormat.FormatString = "dd/MM/yyyy"
                            dtEditStartTimeStats.Properties.EditMask = "dd/MM/yyyy"

                            dtEditEndTimeStats.Properties.DisplayFormat.FormatString = "dd/MM/yyyy"
                            dtEditEndTimeStats.Properties.EditFormat.FormatString = "dd/MM/yyyy"
                            dtEditEndTimeStats.Properties.EditMask = "dd/MM/yyyy"

                            If drPS("PSResolution").ToString.ToLower = "daily" Or drPS("PSResolution").ToString.ToLower = "bh" Or drPS("PSResolution").ToString.ToLower = "bhps" Then
                                dtEditEndTimeStats.EditValue = New DateTime(Now().Year, Now().Month, Now.Day, 0, 0, 0)
                                dtEditStartTimeStats.EditValue = Today.AddDays(-CInt(drPS("DeltaResolution")))
                            ElseIf drPS("PSResolution").ToString.ToLower = "weekly" Then
                                dtEditEndTimeStats.EditValue = New DateTime(Now().Year, Now().Month, Now.Day, 0, 0, 0)
                                dtEditStartTimeStats.EditValue = Today.AddDays(-CInt(drPS("DeltaResolution")))
                            ElseIf drPS("PSResolution").ToString.ToLower = "monthly" Then
                                dtEditStartTimeStats.EditValue = Today.AddMonths(-CInt(drPS("DeltaResolution")))
                                dtEditEndTimeStats.EditValue = New DateTime(Now().Year, Now().Month, Now.Day, 0, 0, 0)
                            End If

                        End If
                    End If
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

