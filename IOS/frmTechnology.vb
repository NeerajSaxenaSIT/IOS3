    Private Sub flpSourceBtn_Click(sender As Object, e As System.EventArgs)
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
        Dim isTopX As Boolean = False
        Try
            Dim vbtn As IOS.Library.IOSToggleButton = CType(sender, IOS.Library.IOSToggleButton)
            Dim flp As FlowLayoutPanel = vbtn.Parent
            vbtn.ChangeToggleState()
            For Each vb As IOS.Library.IOSToggleButton In flp.Controls
                If vbtn.Name <> vb.Name Then
                    If flp.Name.ToString.Contains("TopX") Then
                        vb.ToggleState = CheckState.Unchecked
                        isTopX = True
                    ElseIf flp.Name.ToString.Contains("Eval") Then
                        vb.ToggleState = CheckState.Unchecked
                    End If
                End If
            Next
            flpSourceBtn_ToggleChanges(vbtn, Nothing)
        Catch ex As Exception
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        If isTopX Then
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "TopX " & Network & " " & DateDiff(DateInterval.Second, timerTopX, Now()) & "s")
        Else
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", Network & " " & DateDiff(DateInterval.Second, timer, Now()) & "s")
        End If
    End Sub

    Public Sub flpSourceBtn_ToggleChanges(sender As Object, e As System.EventArgs)
        Try
            Dim vbtn As IOS.Library.IOSToggleButton = CType(sender, IOS.Library.IOSToggleButton)
            Dim flp As FlowLayoutPanel = vbtn.Parent

            If Not vbtn.Name.Contains("TopX") Then
                Dim nd As TreeListNode = tvKPIStats.FindNodeByFieldValue("ObjectName", vbtn.Text)
                If nd IsNot Nothing Then
                    If nd.Checked <> CBool(vbtn.ToggleState) Then
                        tvKPIStats.ExecuteBeforeCheckNode(nd)
                        nd.Checked = vbtn.ToggleState
