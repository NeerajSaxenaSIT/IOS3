    Private Sub Chart_TopX_OnMouseWheel(sender As Object, e As System.Windows.Forms.MouseEventArgs)
        Try
            Dim ch As Chart = CType(sender, Chart)
            Dim tlp As TableLayoutPanel = CType(ch.Parent, TableLayoutPanel)
            Dim tp As XtraTabPage = CType(tlp.Parent, XtraTabPage)

            Dim scrollValue As Integer = tp.VerticalScroll.Value
            Dim largeChange As Integer = tp.VerticalScroll.LargeChange
            If e.Delta < 0 Then
                tp.VerticalScroll.Value += tp.VerticalScroll.LargeChange
            ElseIf scrollValue < largeChange Then
                tp.VerticalScroll.Value = 0
            Else
                tp.VerticalScroll.Value -= largeChange
            End If
            tp.Refresh()
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
    End Sub

    Private Sub Chart_TopX_Click(sender As Object, e As MouseEventArgs)
        Try
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info")
            If e.Button = MouseButtons.Left Then
                Dim ch As Chart = CType(sender, Chart)
                Dim hitchart As HitTestInfo = ch.HitTest(e.X, e.Y)

                If TypeOf hitchart.Object Is Annotation Then
                    Dim tech As String = ch.Tag.ToString
                    Dim seriesInvisible As New List(Of String)

                    Dim an As Annotation = CType(hitchart.Object, Annotation)
                    If an.Background.Color = Color.Orange Then
                        an.Background.Color = Color.LightGray
                    Else
                        an.Background.Color = Color.Orange
                    End If

                    seriesInvisible = GetTopX_DeltaSeriesInvisible(ch)

                    If ExtraLegendEntryCollectionTopX.ContainsKey(ch.Name) Then
                        ExtraLegendEntryCollectionTopX.Remove(ch.Name)
                    End If
                    If DefaultSeriesCollectionTopX.ContainsKey(ch.Name) Then
                        DefaultSeriesCollectionTopX.Remove(ch.Name)
                    End If
                    ch.LegendBox.ExtraEntries.Clear()

                    AssignDataToTopX_Delta(dsTopX, tech, ch.Name, seriesInvisible)
                    ch.RefreshChart()
                End If
                Dim ChartLegendRect As System.Drawing.Rectangle = ch.LegendBox.GetRectangle()
                If ChartLegendRect.Contains(e.X, e.Y) Then
                    If TypeOf hitchart.Object Is LegendEntry Then
                        Dim chartLegendEntry As Object = CType(hitchart.Object, dotnetCHARTING.WinForms.LegendEntry)
                        ShowHideChartSeries(ch, chartLegendEntry.Name, True)
                    End If
                End If
            End If
        Catch ex As Exception
            _logger.SetError(System.Reflection.MethodBase.GetCurrentMethod().Name & " - " & ex.Message)
            UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Error", ex.Message)
        End Try
        UserActionTracking(System.Reflection.MethodBase.GetCurrentMethod().Name, "Info", "TopX " & Network & " " & DateDiff(DateInterval.Second, timerTopX, Now()) & "s")
    End Sub

