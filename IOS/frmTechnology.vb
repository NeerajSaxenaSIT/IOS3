    Private Sub dateNavigatorEval_CustomDrawDayNumberCell(sender As Object, e As Calendar.CustomDrawDayNumberCellEventArgs) Handles dateNavigatorEval.CustomDrawDayNumberCell
        Dim isDisabledDate As Boolean = True

        If (e.Date >= dtEditStartTimeEval.EditValue And e.Date <= dtEditEndTimeEval.EditValue) Or (e.Date.ToString("yyyyMMdd") = CDate(dtEditEndTimeEval.EditValue).ToString("yyyyMMdd")) Then
            If cmbPredefinedFilterEval.SelectedIndex > 0 Then
                If cmbPredefinedFilterEval.SelectedItem.ToString = e.Date.DayOfWeek.ToString Then
                    isDisabledDate = False
                ElseIf cmbPredefinedFilterEval.SelectedItem.ToString = "Weekdays" Then
                    If e.Date.DayOfWeek = DayOfWeek.Saturday Or e.Date.DayOfWeek = DayOfWeek.Sunday Then
                        isDisabledDate = True
                    Else
                        isDisabledDate = False
                    End If
                ElseIf cmbPredefinedFilterEval.SelectedItem.ToString = "Weekends" Then
                    If e.Date.DayOfWeek <> DayOfWeek.Saturday And e.Date.DayOfWeek <> DayOfWeek.Sunday Then
                        isDisabledDate = True
                    Else
                        isDisabledDate = False
                    End If
                End If
            Else
                isDisabledDate = False
            End If
        End If

        If isDisabledDate Then
            e.State = DevExpress.Utils.Drawing.ObjectState.Disabled
            e.Graphics.DrawString(e.Date.Day.ToString(), e.Style.Font, Brushes.Gray, New Point(e.ContentBounds.Location.X, e.ContentBounds.Location.Y))
            e.Handled = True
        Else
            e.Handled = False
        End If

        If e.Disabled = False And e.Holiday = False And e.Inactive = False And e.Selected = False And e.Today = False Then
            clr = e.Style.ForeColor
        End If
        If e.Holiday = True And e.Disabled = False And e.Inactive = False And clr <> Color.Empty Then
            e.Style.ForeColor = clr
        End If

        For Each dt As DateRange In preSelectedFilterPeriodEval
            If e.Date >= dt.StartDate AndAlso e.Date <= dt.EndDate Then
                e.Style.BackColor = Color.SkyBlue
            End If
        Next

    End Sub

