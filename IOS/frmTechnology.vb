    Public Sub FindNodeTreeviewStats(nd As String, Optional follow As Boolean = True)
        Try
            Dim tn() As TreeListNode = tvObjectsTreeStats.FindNodes(Function(x) x.Item("ObjectName") = nd)
            Dim i As Integer = 0
            For i = 0 To tn.Length - 1
                If tn(i).Checked = False Then
                    tn(i).Checked = True
                    If follow = True Then
                        tvObjectsTreeStats.SelectNode(tn(i))
                        tvObjectsTreeStats.FocusedNode = tn(i)
                    End If
                End If
            Next i
        Catch ex As Exception
            'do nothing
        End Try
    End Sub

    Private Sub gvKPINotesStats_RowCellStyle(sender As Object, e As RowCellStyleEventArgs) Handles gvKPINotesStats.RowCellStyle
        Try
            Dim _view As GridView = TryCast(sender, GridView)

            If e.Column.AbsoluteIndex = 1 Then
                e.Column.AppearanceCell.TextOptions.WordWrap = True
                e.Column.AppearanceHeader.TextOptions.WordWrap = True
                If (e.CellValue.ToString().Contains(vbLf)) Then
                    Dim countRows As Integer = e.CellValue.ToString().Split(vbLf).Count()
                    _view.SetRowExpanded(e.RowHandle, True)
                    _view.RowHeight = 20 * countRows
                End If
            End If

            If e.Column.AbsoluteIndex = 3 Then
                If (_view.GetRowCellValue(e.RowHandle, _view.Columns(5)).ToString().Contains("Sibling")) Then
                    e.Appearance.BackColor = Color.Orange
                    e.Appearance.BackColor2 = Color.White
                ElseIf (_view.GetRowCellValue(e.RowHandle, _view.Columns(5)).ToString().Contains("Parent")) Then
                    e.Appearance.BackColor = Color.Yellow
                    e.Appearance.BackColor2 = Color.White
                End If
            End If
        Catch ex As Exception
        End Try
    End Sub

